::courtlistener ns
meta {
    ctx: {
        "courtlistener.api-token": {required: false},
        "courtlistener.base-url": {required: false, secret: false}
    },
    doc: """
    The Free Law Project CourtListener REST API v4
    (`https://www.courtlistener.com/api/rest/v4`): search across case law
    and RECAP (PACER) records, dockets, docket entries, opinions and
    clusters by id, and the court list.

    **Auth**: `Authorization: Token <token>`, from a free CourtListener
    account. Set `courtlistener.api-token` or pass `{api-token: ...}` per
    call. Every call here needs a token except `courts` and `court`.

    **Rate limits**: by default 5 requests per minute, 50 per hour and 125
    per day per account, on rolling windows that all apply at once. A
    Free Law Project membership raises them. A 429 carries `retry-after`
    in the `HttpError`.

    **Paging**: responses carry `count`, `next` and `previous`, where
    `next` holds a `cursor` or `page` parameter. `next-params` reads it
    and `collect` follows it, always against the configured `base-url`.
    """
}

::api ::courtlistener::api

// Errors are returned, not consumed: consuming an Err would halt the run.
with-token
meta {no-doc: true}
fn (opts: Map, f: Fn): Any {
  cfg ::api/resolve(opts)
  cond {
    is-err(cfg) => { cfg }
    => {
      token ::api/require-api-token(cfg)
      if(is-err(token), token, f(cfg, {Authorization: auth-header(token)}))
    }
  }
}

auth-header
meta {
    doc: """
    `Token <token>`, the `Authorization` value CourtListener expects (pure).

    **Example**

    ```hot
    token ::hot::ctx/get("courtlistener.api-token")
    headers {Authorization: ::courtlistener/auth-header(token)}
    ```
    """
}
fn (token: Str): Str {
  `Token ${token}`
}

cl-get
meta {no-doc: true}
fn (path: Str, params: Map, opts: Map): Any {
  with-token(opts, (cfg, headers) {
    ::api/get-json(`${cfg.base-url}${path}${::api/query-string(params)}`, headers)
  })
}

cl-get-or-null
meta {no-doc: true}
fn (path: Str, params: Map, opts: Map): Any {
  with-token(opts, (cfg, headers) {
    ::api/get-json-or-null(`${cfg.base-url}${path}${::api/query-string(params)}`, headers)
  })
}

field-list
meta {no-doc: true}
fn (v: Any): Str? {
  cond {
    is-vec(v) => { join(v, ",") }
    => { v }
  }
}

refine-params
meta {
    doc: """
    The query refinement parameters from `opts` (pure): `fields` and
    `omit` (a Vec or a comma-separated Str, `__` for nested fields),
    `order-by`, `cursor` and `page`. Unset values stay null and drop out
    of the query string.

    **Example**

    ```hot
    ::courtlistener/refine-params({fields: ["id", "case_name"]}).fields  // "id,case_name"
    ::courtlistener/refine-params({order-by: "id"}).order_by  // "id"
    ```
    """
}
fn (opts: Map): Map {
  {
    fields: field-list(get(opts, "fields")),
    omit: field-list(get(opts, "omit")),
    order_by: get(opts, "order-by"),
    cursor: get(opts, "cursor"),
    page: get(opts, "page")
  }
}

list-params
meta {no-doc: true}
fn (filters: Map?, opts: Map): Map {
  {...or(filters, {}), ...refine-params(opts)}
}

resource-id
meta {
    doc: """
    The numeric id at the end of a v4 resource URL, as an Int, or null
    (pure). Clusters, opinions and docket entries link their parents by
    URL.

    **Example**

    ```hot
    ::courtlistener/resource-id("https://www.courtlistener.com/api/rest/v4/dockets/4214664/")  // 4214664
    ```
    """
}
fn (url: Any): Int? {
  m if(is-str(url), ::hot::regex/capture(url, "/(\\d+)/?$"), null)
  if(is-null(m), null, Int(m.groups[0]))
}

// ---------------------------------------------------------------------------
// Search
// ---------------------------------------------------------------------------

search-params
meta {
    doc: """
    Query parameters for the Search API (pure): `q`, `type` (`opts.type`,
    default `"o"`), `order_by`, `filed_after`, `filed_before`, `highlight`
    (`opts.highlight` true gives `on`) and `cursor`. `opts.params` adds any
    other parameter the search front end sends.

    **Example**

    ```hot
    ::courtlistener/search-params("privacy", {}).type  // "o"
    ::courtlistener/search-params("privacy", {highlight: true}).highlight  // "on"
    ::courtlistener/search-params("privacy", {params: {court: "ca9"}}).court  // "ca9"
    ```
    """
}
fn (q: Str, opts: Map): Map {
  {
    q: q,
    type: or(get(opts, "type"), "o"),
    order_by: get(opts, "order-by"),
    filed_after: get(opts, "filed-after"),
    filed_before: get(opts, "filed-before"),
    highlight: if(eq(get(opts, "highlight"), true), "on", null),
    cursor: get(opts, "cursor"),
    ...or(get(opts, "params"), {})
  }
}

search
meta {
    doc: """
    Search CourtListener (`/search/`). `opts.type` picks the index: `o`
    case law (the default), `r` federal cases with up to three nested
    documents, `rd` federal filing documents, `d` federal cases only, `p`
    judges, `oa` oral arguments. Returns the page: `count`, `next`,
    `previous` and `results`. Filter with fielded terms in `q`, such as
    `court_id:scotus` and `dateFiled:[2026-01-01 TO 2026-06-30]`.

    **Example**

    ```hot
    page ::courtlistener/search("\"data breach\" court_id:ca9", {order-by: "dateFiled desc"})
    first(page.results).caseName
    ```
    """
}
fn
(q: Str): Map {
  search(q, {})
},
(q: Str, opts: Map): Map {
  cl-get("/search/", search-params(q, opts), opts)
}

search-opinions
meta {
    doc: """
    Search case law (`type=o`): opinion clusters with their nested opinions.

    **Example**

    ```hot
    page ::courtlistener/search-opinions("\"fair use\" court_id:scotus", {order-by: "dateFiled desc"})
    map(page.results, %.caseName)
    ```
    """
}
fn
(q: Str): Map {
  search-opinions(q, {})
},
(q: Str, opts: Map): Map {
  search(q, {...opts, type: "o"})
}

search-recap
meta {
    doc: """
    Search RECAP (`type=r`): federal cases with up to three nested
    documents. `more_docs` is true on a result with more matches than that.

    **Example**

    ```hot
    page ::courtlistener/search-recap("antitrust court_id:dcd", {filed-after: "2026-01-01"})
    map(page.results, %.caseName)
    ```
    """
}
fn
(q: Str): Map {
  search-recap(q, {})
},
(q: Str, opts: Map): Map {
  search(q, {...opts, type: "r"})
}

search-dockets
meta {
    doc: """
    Search federal cases only (`type=d`), without filing metadata. Above
    2,000 results `count` is an estimate, within about 6%.

    **Example**

    ```hot
    page ::courtlistener/search-dockets("Google court_id:cand")
    page.count
    ```
    """
}
fn
(q: Str): Map {
  search-dockets(q, {})
},
(q: Str, opts: Map): Map {
  search(q, {...opts, type: "d"})
}

search-documents
meta {
    doc: """
    Search federal filing documents from PACER (`type=rd`), without docket
    metadata.

    **Example**

    ```hot
    page ::courtlistener/search-documents("motion to dismiss court_id:nysd")
    map(page.results, %.description)
    ```
    """
}
fn
(q: Str): Map {
  search-documents(q, {})
},
(q: Str, opts: Map): Map {
  search(q, {...opts, type: "rd"})
}

// ---------------------------------------------------------------------------
// Dockets
// ---------------------------------------------------------------------------

docket
meta {
    doc: """
    One docket by id, or null when there is none. `opts.fields` and
    `opts.omit` trim the record.

    **Example**

    ```hot
    d ::courtlistener/docket(4214664, {fields: ["id", "case_name", "court"]})
    if(is-null(d), "no such docket", d.case_name)
    ```
    """
}
fn
(id: Any): Map? {
  docket(id, {})
},
(id: Any, opts: Map): Map? {
  cl-get-or-null(`/dockets/${::api/path-segment(id)}/`, list-params({}, opts), opts)
}

dockets
meta {
    doc: """
    One page of dockets matching `filters`, a Map of API filters. Docket
    numbers are not unique, so pair `docket_number` with `court`.

    **Example**

    ```hot
    page ::courtlistener/dockets({court: "dcd", docket_number: "1:16-cv-00745"})
    first(page.results).case_name
    ```
    """
}
fn
(filters: Map): Map {
  dockets(filters, {})
},
(filters: Map, opts: Map): Map {
  cl-get("/dockets/", list-params(filters, opts), opts)
}

docket-entries
meta {
    doc: """
    One page of the entries on a docket (`/docket-entries/?docket=`).
    `opts.filters` adds API filters, such as
    `{date_filed__gte: "2026-01-01"}`. The Free Law Project lists some
    APIs as available to select users only; a 403 here means this
    account lacks access.

    **Example**

    ```hot
    page ::courtlistener/docket-entries(4214664, {filters: {date_filed__gte: "2026-01-01"}, order-by: "date_filed"})
    map(page.results, %.description)
    ```
    """
}
fn
(docket-id: Any): Map {
  docket-entries(docket-id, {})
},
(docket-id: Any, opts: Map): Map {
  cl-get("/docket-entries/", list-params({docket: docket-id, ...or(get(opts, "filters"), {})}, opts), opts)
}

// ---------------------------------------------------------------------------
// Case law
// ---------------------------------------------------------------------------

cluster
meta {
    doc: """
    One opinion cluster by id, or null when there is none. The id in a
    CourtListener opinion URL is a cluster id. `sub_opinions` links the
    cluster's opinions and `docket` its parent.

    **Example**

    ```hot
    ::cl ::courtlistener
    c ::cl/cluster(2812209)
    if(is-null(c), null, ::cl/resource-id(c.docket))
    ```
    """
}
fn
(id: Any): Map? {
  cluster(id, {})
},
(id: Any, opts: Map): Map? {
  cl-get-or-null(`/clusters/${::api/path-segment(id)}/`, list-params({}, opts), opts)
}

opinion
meta {
    doc: """
    One opinion by id, or null when there is none. Opinion ids do not match
    cluster ids. Prefer `html_with_citations` for the text.

    **Example**

    ```hot
    o ::courtlistener/opinion(3197342, {fields: ["id", "html_with_citations"]})
    if(is-null(o), null, o.html_with_citations)
    ```
    """
}
fn
(id: Any): Map? {
  opinion(id, {})
},
(id: Any, opts: Map): Map? {
  cl-get-or-null(`/opinions/${::api/path-segment(id)}/`, list-params({}, opts), opts)
}

// ---------------------------------------------------------------------------
// Courts (no token needed)
// ---------------------------------------------------------------------------

public-get
meta {no-doc: true}
fn (path: Str, params: Map, opts: Map): Any {
  cfg ::api/resolve(opts)
  cond {
    is-err(cfg) => { cfg }
    => {
      headers if(::api/given(cfg.api-token), {Authorization: auth-header(cfg.api-token)}, {})
      ::api/get-json-or-null(`${cfg.base-url}${path}${::api/query-string(params)}`, headers)
    }
  }
}

courts
meta {
    doc: """
    One page of courts and jurisdictions, with their ids. Works without a
    token, and sends one when set.

    **Example**

    ```hot
    page ::courtlistener/courts({filters: {jurisdiction: "F"}})
    map(page.results, %.id)
    ```
    """
}
fn
(): Map {
  courts({})
},
(opts: Map): Map {
  public-get("/courts/", list-params(get(opts, "filters"), opts), opts)
}

court
meta {
    doc: """
    One court by id (`"scotus"`, `"ca9"`), or null when there is none. Works
    without a token, and sends one when set.

    **Example**

    ```hot
    ninth ::courtlistener/court("ca9")
    if(is-null(ninth), null, ninth.full_name)
    ```
    """
}
fn
(id: Str): Map? {
  court(id, {})
},
(id: Str, opts: Map): Map? {
  public-get(`/courts/${::api/path-segment(id)}/`, list-params({}, opts), opts)
}

// ---------------------------------------------------------------------------
// Pagination
// ---------------------------------------------------------------------------

next-params
meta {
    doc: """
    The opts that fetch the page after `page`, from its `next` URL (pure):
    `{cursor: ...}`, `{page: n}`, or null on the last page. Only the
    parameter is read, so a next call goes to the configured `base-url`
    and the token never follows a URL from a response.

    **Example**

    ```hot
    ::courtlistener/next-params({next: "https://www.courtlistener.com/api/rest/v4/search/?cursor=abc&type=o"})  // {cursor: "abc"}
    ::courtlistener/next-params({next: "https://www.courtlistener.com/api/rest/v4/dockets/?page=3"})  // {page: 3}
    ::courtlistener/next-params({next: null})  // null
    ```
    """
}
fn (page: Any): Map? {
  next get(or(page, {}), "next")
  m if(::api/given(next), ::hot::regex/capture(next, "\\?(.*)$"), null)
  query if(is-null(m), {}, ::hot::uri/decode-query(m.groups[0]))
  cursor get(query, "cursor")
  number get(query, "page")
  cond {
    ::api/given(cursor) => { {cursor: cursor} }
    ::api/given(number) => { {page: Int(number)} }
    => { null }
  }
}

collect-pages
meta {no-doc: true}
fn (fetch: Fn, opts: Map, limit: Int, acc: Vec): Any {
  page fetch(opts)
  cond {
    is-err(page) => { page }
    => {
      items or(get(page, "results"), [])
      combined concat(acc, items)
      next next-params(page)
      cond {
        gte(length(combined), limit) => { slice(combined, 0, limit) }
        is-empty(items) => { combined }
        is-null(next) => { combined }
        => { collect-pages(fetch, {...opts, ...next}, limit, combined) }
      }
    }
  }
}

collect
meta {
    doc: """
    Follow pages until `limit` items or the last page. `fetch` takes
    `opts` (with `cursor` or `page` set) and returns one page. An Err on
    any page, such as a 429, is returned in place of the items.

    The default limit of 5 requests a minute applies to every page, so
    keep `limit` small or raise the account's limits.

    **Example**

    ```hot
    entries ::courtlistener/collect((o) { ::courtlistener/docket-entries(4214664, o) }, {order-by: "id"}, 40)
    ```
    """
}
fn (fetch: Fn, opts: Map, limit: Int): Any {
  collect-pages(fetch, opts, limit, [])
}
