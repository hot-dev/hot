::whatsapp::core ns
meta {
    doc: """Shared configuration: the Graph API host and version. Calls go to `https://graph.facebook.com/{version}`, where the version is `api-version` in a call's `opts`, else the `whatsapp.api.version` context variable, otherwise `DEFAULT_API_VERSION`."""
}

GRAPH_HOST "https://graph.facebook.com"

// Meta's latest Graph API version as of Nov 2026 (released 2026-07-29).
// Each version is supported for about two years; override per project
// with the `whatsapp.api.version` context variable.
DEFAULT_API_VERSION "v26.0"

normalize-version
meta {
    doc: """Normalize a Graph API version string to the `vNN.N` path form (`"26.0"` and `"v26.0"` both give `"v26.0"`). Exposed for testing."""
}
fn (version: Str): Str {
  trimmed trim(version)
  if(starts-with(trimmed, "v"), trimmed, `v${trimmed}`)
}

api-version
meta {
    ctx: {"whatsapp.api.version": {required: false, secret: false}},
    doc: """
    The Graph API version for a call: `api-version` in `opts`, then the
    `whatsapp.api.version` context variable (e.g. `"v25.0"`), otherwise
    `DEFAULT_API_VERSION`.
    """
}
fn
(): Str {
  api-version({})
},
(opts: Map): Str {
  from-opts or(get(opts, "api-version"), "")
  configured if(is-blank(from-opts), or(::hot::ctx/get("whatsapp.api.version"), ""), from-opts)
  if(is-blank(configured), DEFAULT_API_VERSION, normalize-version(configured))
}

base-url
meta {
    doc: """The versioned Graph API base URL, e.g. `https://graph.facebook.com/v26.0`."""
}
fn
(): Str {
  base-url({})
},
(opts: Map): Str {
  `${GRAPH_HOST}/${api-version(opts)}`
}
