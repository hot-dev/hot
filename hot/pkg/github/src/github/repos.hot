::github::repos ns

::api ::github::api
::b64 ::hot::base64
::uri ::hot::uri
query-string ::hot::uri/query-string

// Percent-encode a repository content path per segment: each segment is a
// URI component, but the / separators must survive as path structure.
encode-path
meta {no-doc: true}
fn (path: Str): Str {
  join(map(split(path, "/"), (segment) { ::uri/encode(segment) }), "/")
}

get-repo
meta {
    doc: """
    GET /repos/{owner}/{repo} - Repository metadata (default branch,
    visibility, topics, counts).

    **Example**

    ```hot
    repo ::github::repos/get-repo("acme", "api")
    repo.default_branch
    ```
    """
}
fn
(owner: Str, repo: Str): Map {
  get-repo(owner, repo, {})
},
(owner: Str, repo: Str, opts: Map): Map {
  ::api/json("GET", `/repos/${owner}/${repo}`, {}, "", opts)
}

list-repos
meta {
    doc: """
    GET /users/{owner}/repos - List a user's repositories. `params`
    supports `type`, `sort`, `per_page`, `page`. Returns a single page
    (GitHub default 30, max 100); pass `page` to paginate. For an
    organization's repositories (including private-repo visibility and
    org `type` filters) use `list-org-repos`.

    **Example**

    ```hot
    repos ::github::repos/list-repos("octocat", {sort: "updated", per_page: 10})
    map(repos, %.full_name)
    ```
    """
}
fn
(owner: Str): Vec {
  ::api/json("GET", `/users/${owner}/repos`)
},
(owner: Str, params: Map): Vec {
  list-repos(owner, params, {})
},
(owner: Str, params: Map, opts: Map): Vec {
  ::api/json("GET", `/users/${owner}/repos${query-string(params)}`, {}, "", opts)
}

list-org-repos
meta {
    doc: """
    GET /orgs/{org}/repos - List an organization's repositories. `params`
    supports `type` ("all"/"public"/"private"/"forks"/"sources"/"member"),
    `sort`, `per_page`, `page`. Returns a single page (GitHub default 30,
    max 100); pass `page` to paginate.

    **Example**

    ```hot
    repos ::github::repos/list-org-repos("acme", {type: "private", per_page: 100})
    map(repos, %.name)
    ```
    """
}
fn
(org: Str): Vec {
  ::api/json("GET", `/orgs/${org}/repos`)
},
(org: Str, params: Map): Vec {
  list-org-repos(org, params, {})
},
(org: Str, params: Map, opts: Map): Vec {
  ::api/json("GET", `/orgs/${org}/repos${query-string(params)}`, {}, "", opts)
}

list-branches
meta {
    doc: """
    GET /repos/{owner}/{repo}/branches - List branches. `params` supports
    `per_page`, `page`. Returns a single page (GitHub default 30, max 100);
    pass `page` to paginate.

    **Example**

    ```hot
    branches ::github::repos/list-branches("acme", "api", {per_page: 100})
    map(branches, %.name)
    ```
    """
}
fn
(owner: Str, repo: Str): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/branches`)
},
(owner: Str, repo: Str, params: Map): Vec {
  list-branches(owner, repo, params, {})
},
(owner: Str, repo: Str, params: Map, opts: Map): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/branches${query-string(params)}`, {}, "", opts)
}

list-commits
meta {
    doc: """
    GET /repos/{owner}/{repo}/commits - List commits, newest first. `params`
    supports `sha` (branch), `path`, `author`, `since`, `until`, `per_page`,
    `page`. Returns a single page (GitHub default 30, max 100); pass `page`
    to paginate.

    **Example**

    ```hot
    commits ::github::repos/list-commits("acme", "api", {sha: "main", path: "src", per_page: 20})
    map(commits, %.sha)
    ```
    """
}
fn
(owner: Str, repo: Str): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/commits`)
},
(owner: Str, repo: Str, params: Map): Vec {
  list-commits(owner, repo, params, {})
},
(owner: Str, repo: Str, params: Map, opts: Map): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/commits${query-string(params)}`, {}, "", opts)
}

decode-content
meta {
    doc: """
    Decode a contents-API response (`{content: base64-with-newlines,
    encoding: "base64"}`) into the file text. Exposed for testing;
    `get-content` applies it.

    **Example**

    ```hot
    ::github::repos/decode-content({content: "aGVsbG8=\n", encoding: "base64"})  // "hello"
    ```
    """
}
fn (resource: Map): Str {
  cond {
    eq(get(resource, "encoding"), "base64") => {
      Str(::b64/decode(join(split(resource.content, "\n"), "")))
    }
    => { get(resource, "content", "") }
  }
}

// Shared body of get-content: `query` is "" or an encoded "?ref=..." suffix.
fetch-content
meta {no-doc: true}
fn
(owner: Str, repo: Str, path: Str, query: Str): Map {
  fetch-content(owner, repo, path, query, {})
},
(owner: Str, repo: Str, path: Str, query: Str, opts: Map): Map {
  resource ::api/json("GET", `/repos/${owner}/${repo}/contents/${encode-path(path)}${query}`, {}, "", opts)
  cond {
    // Already an Err from the transport — pass it through as-is (feeding
    // an Err back into err() would trip the strict-argument halt).
    is-err(resource) => { resource }
    // The contents endpoint returns a Vec when the path is a directory.
    is-vec(resource) => {
      err(`'${path}' is a directory, not a file; get-content only fetches files`)
    }
    => { {path: resource.path, sha: resource.sha, content: decode-content(resource)} }
  }
}

get-content
meta {
    doc: """
    GET /repos/{owner}/{repo}/contents/{path} - Fetch a file and decode
    its content. Returns `{path, sha, content}` where `content` is the
    decoded text — the `sha` is what `put-content` needs to update it.
    Pass a `ref` (branch/tag/sha) with the 4-arity Str form. Errs when
    `path` is a directory.

    **Example**

    ```hot
    file ::github::repos/get-content("acme", "api", "README.md")
    file.content

    // From a branch, tag or SHA
    tagged ::github::repos/get-content("acme", "api", "VERSION", "v1.2.0")
    tagged.sha
    ```
    """
}
fn
(owner: Str, repo: Str, path: Str): Map {
  fetch-content(owner, repo, path, "")
},
(owner: Str, repo: Str, path: Str, opts: Map): Map {
  fetch-content(owner, repo, path, "", opts)
},
(owner: Str, repo: Str, path: Str, ref: Str): Map {
  get-content(owner, repo, path, ref, {})
},
(owner: Str, repo: Str, path: Str, ref: Str, opts: Map): Map {
  fetch-content(owner, repo, path, `?ref=${::uri/encode(ref)}`, opts)
}

put-content
meta {
    doc: """
    PUT /repos/{owner}/{repo}/contents/{path} - Create or update a file
    with a commit. `options`: `message` (required), `content` (required,
    plain text — encoded automatically), `sha` (required when updating),
    `branch`.

    **Example**

    ```hot
    existing ::github::repos/get-content("acme", "api", "VERSION")
    ::github::repos/put-content("acme", "api", "VERSION", {
      message: "Bump version",
      content: "2.0.0",
      sha: existing.sha
    })
    ```
    """
}
fn
(owner: Str, repo: Str, path: Str, options: Map): Map {
  put-content(owner, repo, path, options, {})
},
(owner: Str, repo: Str, path: Str, options: Map, opts: Map): Map {
  body filter-vals({
    message: options.message,
    // base64/encode takes Bytes; content arrives as text
    content: ::b64/encode(Bytes(get(options, "content", ""))),
    sha: get(options, "sha"),
    branch: get(options, "branch")
  }, is-some)
  ::api/json("PUT", `/repos/${owner}/${repo}/contents/${encode-path(path)}`, {}, body, opts)
}
