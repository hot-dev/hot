::name-screening::text ns
meta {
    doc: """
    Name normalization for screening: case folding, a transliteration
    table for Latin diacritics, Cyrillic and Greek, punctuation removal,
    honorific and corporate-suffix stripping, tokenization, and the
    blocking keys the cached index is built on.

    hot-std has no Unicode normalization (NFD/NFKD), so diacritics are
    folded with the explicit character table `FOLDS` below (Latin
    diacritics and ligatures, Cyrillic, Greek). Scripts outside those (Arabic, Chinese, ...) are kept
    as-is: such tokens still match exactly, but not fuzzily against a
    Latin spelling.
    """
}

::re ::hot::regex

// ---------------------------------------------------------------------------
// Transliteration tables (applied after `lowercase`)
// ---------------------------------------------------------------------------

// Character -> ASCII replacement, applied after `lowercase`: Latin
// letters with diacritics and ligatures, Russian/Ukrainian/Belarusian
// Cyrillic (a simplified BGN/PCGN-style romanization; the lists use several
// systems and fuzzy matching absorbs the difference), and Greek. Only the
// distinct non-ASCII characters of a string are looked up, one native
// replace each.
FOLDS {
  "à": "a", "á": "a", "â": "a", "ã": "a", "ä": "a", "å": "a", "ā": "a", "ă": "a",
  "ą": "a", "ǎ": "a", "ǟ": "a", "ǡ": "a", "ǻ": "a", "ȁ": "a", "ȃ": "a", "ȧ": "a",
  "ạ": "a", "ả": "a", "ấ": "a", "ầ": "a", "ẩ": "a", "ẫ": "a", "ậ": "a", "ắ": "a",
  "ằ": "a", "ẳ": "a", "ẵ": "a", "ặ": "a", "ç": "c", "ć": "c", "ĉ": "c", "ċ": "c",
  "č": "c", "ď": "d", "đ": "d", "ð": "d", "è": "e", "é": "e", "ê": "e", "ë": "e",
  "ē": "e", "ĕ": "e", "ė": "e", "ę": "e", "ě": "e", "ȅ": "e", "ȇ": "e", "ẹ": "e",
  "ẻ": "e", "ẽ": "e", "ế": "e", "ề": "e", "ể": "e", "ễ": "e", "ệ": "e", "ĝ": "g",
  "ğ": "g", "ġ": "g", "ģ": "g", "ǧ": "g", "ĥ": "h", "ħ": "h", "ì": "i", "í": "i",
  "î": "i", "ï": "i", "ĩ": "i", "ī": "i", "ĭ": "i", "į": "i", "ı": "i", "ǐ": "i",
  "ȉ": "i", "ȋ": "i", "ỉ": "i", "ị": "i", "ĵ": "j", "ķ": "k", "ǩ": "k", "ĺ": "l",
  "ļ": "l", "ľ": "l", "ŀ": "l", "ł": "l", "ñ": "n", "ń": "n", "ņ": "n", "ň": "n",
  "ŉ": "n", "ǹ": "n", "ò": "o", "ó": "o", "ô": "o", "õ": "o", "ö": "o", "ø": "o",
  "ō": "o", "ŏ": "o", "ő": "o", "ơ": "o", "ǒ": "o", "ǫ": "o", "ǭ": "o", "ȍ": "o",
  "ȏ": "o", "ọ": "o", "ỏ": "o", "ố": "o", "ồ": "o", "ổ": "o", "ỗ": "o", "ộ": "o",
  "ớ": "o", "ờ": "o", "ở": "o", "ỡ": "o", "ợ": "o", "ŕ": "r", "ŗ": "r", "ř": "r",
  "ś": "s", "ŝ": "s", "ş": "s", "š": "s", "ș": "s", "ţ": "t", "ť": "t", "ŧ": "t",
  "ț": "t", "ù": "u", "ú": "u", "û": "u", "ü": "u", "ũ": "u", "ū": "u", "ŭ": "u",
  "ů": "u", "ű": "u", "ų": "u", "ư": "u", "ǔ": "u", "ǖ": "u", "ǘ": "u", "ǚ": "u",
  "ǜ": "u", "ụ": "u", "ủ": "u", "ứ": "u", "ừ": "u", "ử": "u", "ữ": "u", "ự": "u",
  "ŵ": "w", "ý": "y", "ÿ": "y", "ŷ": "y", "ỳ": "y", "ỵ": "y", "ỷ": "y", "ỹ": "y",
  "ź": "z", "ż": "z", "ž": "z", "ß": "ss", "æ": "ae", "œ": "oe", "þ": "th", "ĳ": "ij",
  "щ": "shch", "ж": "zh", "х": "kh", "ц": "ts", "ч": "ch", "ш": "sh", "ю": "yu", "я": "ya",
  "ї": "yi", "є": "ye", "ё": "e", "а": "a", "б": "b", "в": "v", "г": "g", "ґ": "g",
  "д": "d", "е": "e", "з": "z", "и": "i", "і": "i", "й": "y", "к": "k", "л": "l",
  "м": "m", "н": "n", "о": "o", "п": "p", "р": "r", "с": "s", "т": "t", "у": "u",
  "ў": "u", "ф": "f", "ы": "y", "э": "e", "ъ": "", "ь": "", "θ": "th", "χ": "ch",
  "ψ": "ps", "α": "a", "ά": "a", "β": "v", "γ": "g", "δ": "d", "ε": "e", "έ": "e",
  "ζ": "z", "η": "i", "ή": "i", "ι": "i", "ί": "i", "ϊ": "i", "ΐ": "i", "κ": "k",
  "λ": "l", "μ": "m", "ν": "n", "ξ": "x", "ο": "o", "ό": "o", "π": "p", "ρ": "r",
  "σ": "s", "ς": "s", "τ": "t", "υ": "y", "ύ": "y", "ϋ": "y", "ΰ": "y", "φ": "f",
  "ω": "o", "ώ": "o"
}

// SUFFIX_WORDS_RE: legal-form tokens dropped from entity names (after punctuation
// removal, so "S.A." is "sa" and "L.L.C." is "llc"), including the words of
// spelled-out forms ("Open Joint Stock Company", "Limited Liability
// Company", "Aktsionernoe Obshchestvo"). HONORIFIC_WORDS_RE:
// honorifics dropped from individual names. Only whole tokens are dropped,
// and never when nothing else would remain.
//
// Both are whole-word regexes applied to the cleaned name in one pass.
SUFFIX_WORDS_RE "\\b(?:llc|ltd|limited|inc|incorporated|corp|corporation|co|company|plc|llp|lp|gmbh|mbh|ag|kg|sa|sas|sarl|srl|spa|sl|bv|nv|ab|as|asa|oy|oyj|aps|kft|zrt|sro|doo|ad|jsc|pjsc|ojsc|cjsc|ooo|oao|zao|pao|ao|tov|pte|pty|bhd|sdn|fze|fzco|fzc|fzllc|wll|lda|ltda|sac|cia|kk|the|joint|stock|open|closed|public|private|liability|aktsionernoe|aktsionernoye|obshchestvo|obschestvo|zakrytoe|otkrytoe|publichnoe|tovarystvo|sp|z|oo)\\b"
HONORIFIC_WORDS_RE "\\b(?:mr|mrs|ms|miss|dr|prof|sir|dame|sheikh|shaykh)\\b"

// ---------------------------------------------------------------------------
// Folding
// ---------------------------------------------------------------------------

fold
meta {
    doc: """
    Case-fold and transliterate: `lowercase`, then Latin diacritics,
    ligatures (`ß` → `ss`, `æ` → `ae`), Cyrillic and Greek to ASCII
    letters. Pure-ASCII input only pays for the `lowercase`.

    **Example**

    ```hot
    ::name-screening::text/fold("Ğülşen Müller")  // "gulsen muller"
    ::name-screening::text/fold("Путин")          // "putin"
    ```
    """
}
fn (s: Str): Str {
  lower lowercase(s)
  cond {
    not(::re/is-match(lower, "[^\\x00-\\x7F]")) => { lower }
    => {
      wide distinct(map(::re/find-all(lower, "[^\\x00-\\x7F]"), (m) { m.match }))
      reduce(wide, (acc, c) {
        to get(FOLDS, c)
        if(is-null(to), acc, ::hot::str/replace(acc, c, to))
      }, lower)
    }
  }
}

clean
meta {
    doc: """
    Fold, then drop apostrophes and dots (`O'Neil` → `oneil`, `S.A.` →
    `sa`) and turn every other non-letter, non-digit run into one space.
    """
}
fn (s: Str): Str {
  fold(s)
    |> ::re/replace-all("['’‘`ʿʾ.]", "")
    |> ::re/replace-all("[^\\p{L}\\p{N}]+", " ")
    |> trim()
}

tokens
meta {
    doc: """
    The normalized tokens of a name (see `clean`). `strip-suffixes`
    true drops corporate legal forms (for entities, vessels and
    aircraft); false drops honorifics (for individuals). Either way a
    name is never reduced to nothing.

    **Example**

    ```hot
    ::name-screening::text/tokens("Acme Trading Co., Ltd.", true)  // ["acme", "trading"]
    ::name-screening::text/tokens("AL ZAWAHIRI, Dr. Ayman", false) // ["al", "zawahiri", "ayman"]
    ```
    """
}
fn (name: Str, strip-suffixes: Bool): Vec<Str> {
  // Native regex passes only: a lambda per token costs far more in Hot.
  all clean(name)
  drop if(strip-suffixes, SUFFIX_WORDS_RE, HONORIFIC_WORDS_RE)
  kept trim(::re/replace-all(::re/replace-all(all, drop, ""), " +", " "))
  use if(is-empty(kept), all, kept)
  if(is-empty(use), [], split(use, " "))
}

normalize
meta {
    doc: """The normalized form of a name as one string: `tokens` joined by single spaces."""
}
fn (name: Str, strip-suffixes: Bool): Str {
  join(tokens(name, strip-suffixes), " ")
}

strips-suffixes
meta {
    doc: """True for kinds whose names carry legal forms: everything except `"individual"`."""
}
fn (kind: Str?): Bool {
  ne(kind, "individual")
}

// ---------------------------------------------------------------------------
// Blocking keys
// ---------------------------------------------------------------------------

skeleton
meta {
    doc: """
    A coarse phonetic key for one token, used only to find candidates:
    common digraphs and letters folded (`ck`/`kh`/`ch`/`c`/`q`→`k`,
    `ph`→`f`, `sh`/`z`→`s`, `th`→`t`, `dh`→`d`, `ou`→`u`, `w`→`v`,
    `j`→`y`), vowels
    after the first letter removed and doubled letters collapsed. So
    `mohammed`, `muhamad` and `mohamad` share `mhmd`. Tokens that are
    not ASCII letters are returned unchanged.
    """
}
fn (token: Str): Str {
  cond {
    not(::re/is-match(token, "^[a-z]+$")) => { token }
    => {
      mapped token
        |> ::re/replace-all("ck|kh|ch|[cq]", "k")
        |> ::re/replace-all("ph", "f")
        |> ::re/replace-all("sh|z", "s")
        |> ::re/replace-all("th", "t")
        |> ::re/replace-all("dh", "d")
        |> ::re/replace-all("ou", "u")
        |> ::re/replace-all("w", "v")
        |> ::re/replace-all("j", "y")
      head slice(mapped, 0, 1)
      tail ::re/replace-all(slice(mapped, 1, length(mapped)), "[aeiouy]", "")
      collapse-repeats(`${head}${tail}`)
    }
  }
}

DOUBLED_RE "aa|bb|cc|dd|ee|ff|gg|hh|ii|jj|kk|ll|mm|nn|oo|pp|qq|rr|ss|tt|uu|vv|ww|xx|yy|zz"

collapse-repeats
meta {
    doc: """Collapse runs of the same ASCII letter to one: `"mmd"` → `"md"`."""
}
fn (s: Str): Str {
  doubled distinct(map(::re/find-all(s, DOUBLED_RE), (m) { slice(m.match, 0, 1) }))
  reduce(doubled, (acc, c) { ::re/replace-all(acc, `${::re/escape(c)}+`, c) }, s)
}

// Name particles that are written both joined and apart ("al zawahiri" /
// "alzawahiri", "abdul rahman" / "abdulrahman").
PARTICLE_RE "^(?:al|el|ul|ad|ar|as|an|at|az|bin|ibn|bint|abu|abd|abdul|abdel|abdal|abdu|van|von|der|den|de|del|della|da|di|du|le|la|mc|mac|st)$"

is-particle fn (t: Str): Bool {
  ::re/is-match(t, PARTICLE_RE)
}

merge-particles
meta {
    doc: """Join each name particle (`al`, `abu`, `abdul`, `van`, ...) to the token after it: `["al", "zawahiri"]` → `["alzawahiri"]`."""
}
fn (toks: Vec<Str>): Vec<Str> {
  out reduce(toks, (acc, t) {
    cond {
      acc.pending => { {pending: is-particle(t), toks: concat(butlast(acc.toks), [`${last(acc.toks)}${t}`])} }
      => { {pending: is-particle(t), toks: concat(acc.toks, [t])} }
    }
  }, {pending: false, toks: []})
  out.toks
}

key-tokens
meta {
    doc: """The tokens of one name that get blocking keys: those longer than two characters, or all of them when the name has nothing longer."""
}
fn (toks: Vec<Str>): Vec<Str> {
  joined join(toks, " ")
  long trim(::re/replace-all(::re/replace-all(` ${joined} `, "(?: \\S{1,2})+ ", " "), " +", " "))
  cond {
    not(is-empty(long)) => { split(long, " ") }
    is-empty(joined) => { [] }
    => { toks }
  }
}

token-keys
meta {
    doc: """The blocking keys of one token: `s:<skeleton>`, plus `p:<first four letters>` for tokens of five or more characters."""
}
fn (token: Str): Vec<Str> {
  sk [`s:${skeleton(token)}`]
  if(gte(length(token), 5), concat(sk, [`p:${slice(token, 0, 4)}`]), sk)
}

blocking-keys
meta {
    doc: """
    The index keys for one name's tokens (`token-keys` of each
    `key-tokens`), sorted and distinct.

    **Example**

    ```hot
    ::name-screening::text/blocking-keys(["al", "zawahiri", "ayman"])
    // ["p:ayma", "p:zawa", "s:amn", "s:svhr"]
    ```
    """
}
fn (toks: Vec<Str>): Vec<Str> {
  sort(distinct(mapcat(key-tokens(toks), token-keys)))
}

// ---------------------------------------------------------------------------
// Characters
// ---------------------------------------------------------------------------

chars
meta {
    doc: """The characters of `s` as a Vec of one-character strings."""
}
fn (s: Str): Vec<Str> {
  filter(split(s, ""), (c) { not(is-empty(c)) })
}
