::shopify::api ns
meta {
    ctx: {
        "shopify.shop": {required: false, secret: false},
        "shopify.access.token": {required: false},
        "shopify.api.version": {required: false, secret: false}
    },
    doc: """
    Transport for the Shopify GraphQL Admin API: shop and URL building,
    the `graphql` escape hatch, error unwrapping (GraphQL `errors`,
    throttling, mutation `userErrors`) and cursor pagination helpers
    shared by the curated namespaces.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then the `shopify.*` context variables, then the defaults. A
    per-call token is masked in call records and never written to ctx, so
    one run can act for many shops.

    - `access-token`: the Admin API access token for this call
    - `shop`: the shop for this call. It needs an `access-token` in the
      same `opts`: `shopify.access.token` is never sent to a per-call shop.
    - `api-version`: the Admin API version for this call

    An `access-token` or `shop` that is present but blank or null is an
    Err naming the key, never a fallback to context.
    """
}

::ctx ::hot::ctx

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

// ---------------------------------------------------------------------------
// Error shapes
// ---------------------------------------------------------------------------

HttpError
meta {
    doc: """A non-2xx HTTP response from the Admin API (401 bad token, 402 frozen shop, 404 unknown shop or version, 429, 5xx)."""
}
type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: or(response.headers, {}),
    body: response.body
  })
}

GraphQLError
meta {
    doc: """
    A 200 response whose body carries top-level GraphQL `errors`. `data`
    holds any partial data, `cost` the `extensions.cost` block. When
    Shopify throttled the request (`extensions.code` `THROTTLED`),
    `throttled` is true and `retry-after-ms` estimates how long the
    bucket needs to refill enough for the requested cost.
    """
}
type {
    errors: Vec,
    data: Any,
    cost: Map?,
    throttled: Bool,
    retry-after-ms: Int?
}

UserErrors
meta {
    doc: """A mutation that ran but was rejected: `user-errors` is the payload's `userErrors` list (each `{field, message, code?}`), `payload` the full mutation payload."""
}
type {
    mutation: Str,
    user-errors: Vec,
    payload: Any
}

// ---------------------------------------------------------------------------
// Shop, version and URL
// ---------------------------------------------------------------------------

normalize-shop
meta {
    doc: """
    Reduce a shop reference to its bare handle: `acme`,
    `acme.myshopify.com`, `https://acme.myshopify.com/admin` all give
    `acme`. Errs on anything else (custom storefront domains don't serve
    the Admin API).
    """
}
fn (shop: Str): Str {
  lowered lowercase(trim(shop))
  no-scheme cond {
    starts-with(lowered, "https://") => { slice(lowered, 8) }
    starts-with(lowered, "http://") => { slice(lowered, 7) }
    => { lowered }
  }

  host first(split(no-scheme, "/"))
  handle cond {
    ends-with(host, ".myshopify.com") => { slice(host, 0, sub(length(host), 14)) }
    => { host }
  }

  cond {
    ::hot::regex/is-match(handle, "^[a-z0-9][a-z0-9-]*$") => { handle }
    => {
      err(`shopify: '${shop}' is not a shop handle or *.myshopify.com domain (custom domains don't serve the Admin API)`)
    }
  }
}

api-version
meta {
    doc: """The Admin API version in use: the `shopify.api.version` context variable when set, otherwise `::shopify/API_VERSION`."""
}
fn (): Str {
  configured or(::ctx/get("shopify.api.version"), "")
  if(is-empty(configured), ::shopify/API_VERSION, configured)
}

graphql-url
meta {
    doc: """The GraphQL Admin endpoint for a shop (handle or myshopify domain) and API version (`YYYY-MM` or `unstable`). Exposed for testing."""
}
fn
(shop: Str): Str {
  graphql-url(shop, api-version())
},
(shop: Str, version: Str): Str {
  handle normalize-shop(shop)
  cond {
    is-err(handle) => { handle }
    not(or(::hot::regex/is-match(version, "^[0-9]{4}-[0-9]{2}$"), eq(version, "unstable"))) => {
      err(`shopify: API version '${version}' must look like 2026-10 (or be "unstable")`)
    }
    => { `https://${handle}.myshopify.com/admin/api/${version}/graphql.json` }
  }
}

// ---------------------------------------------------------------------------
// Credentials
// ---------------------------------------------------------------------------

non-blank fn (value: Any): Str? {
  if(is-str(value), if(is-empty(trim(value)), null, trim(value)), null)
}

blank-option
meta {
    doc: """The first of `names` that `opts` has with a blank or null value, else null."""
}
fn (opts: Map, names: Vec): Str? {
  find-first(names, (name) { and(in(name, keys(opts)), is-null(non-blank(get(opts, name)))) })
}

resolve-from
meta {
    doc: """
    The one resolver, pure: `{access-token, url, api-version}` for a call
    from `opts` first, then `ctx-values` (a Map of context variables), then
    defaults. An Err when the shop or token is not set, when `access-token`
    or `shop` is in `opts` but blank or null, when `opts` has `shop` without
    `access-token`, or when the shop or version is malformed. Exposed for
    testing; `resolve` feeds it the context.
    """
}
fn (opts: Map, ctx-values: Map): Map {
  blank blank-option(opts, ["access-token", "shop"])
  opts-token non-blank(get(opts, "access-token"))
  opts-shop non-blank(get(opts, "shop"))
  token or(opts-token, non-blank(get(ctx-values, "shopify.access.token")))
  shop or(opts-shop, non-blank(get(ctx-values, "shopify.shop")))
  version or(non-blank(get(opts, "api-version")), non-blank(get(ctx-values, "shopify.api.version")), ::shopify/API_VERSION)
  cond {
    is-some(blank) => {
      err(`shopify: ${blank} is in the call's opts but is blank or null. Pass a value, or leave ${blank} out.`)
    }

    and(is-some(opts-shop), is-null(opts-token)) => {
      err("shopify: shop is in the call's opts without access-token. Pass access-token with it. shopify.access.token is never sent to a per-call shop.")
    }

    is-null(shop) => { err("shopify: shopify.shop is not set. Add it in Context Variables, or pass {shop: ..., access-token: ...} in the call's opts.") }
    is-null(token) => { err("shopify: shopify.access.token is not set. Add it in Context Variables, or pass {access-token: ...} in the call's opts.") }
    => {
      url graphql-url(shop, version)
      if(is-err(url), url, {access-token: token, url: url, api-version: version})
    }
  }
}

resolve
meta {
    ctx: {
        "shopify.shop": {required: false, secret: false},
        "shopify.access.token": {required: false},
        "shopify.api.version": {required: false, secret: false}
    },
    doc: """
    Credentials and settings for one call (see `resolve-from`). The token
    is masked in this run's call records, and nothing from `opts` is
    written to ctx.

    **Example**

    ```hot
    ::shopify::api/resolve({shop: "acme", access-token: "shpat_tenant"}).url
    // "https://acme.myshopify.com/admin/api/2026-10/graphql.json"
    ```
    """
}
fn (opts: Map): Map {
  // First, so even the records of the calls below are masked.
  ::ctx/mark-secret(opts.access-token)
  resolved resolve-from(opts, {
    "shopify.shop": ::ctx/get("shopify.shop"),
    "shopify.access.token": ::ctx/get("shopify.access.token"),
    "shopify.api.version": ::ctx/get("shopify.api.version")
  })
  cond {
    is-err(resolved) => { resolved }
    => { {...resolved, access-token: ::ctx/mark-secret(resolved.access-token)} }
  }
}

// ---------------------------------------------------------------------------
// Response handling
// ---------------------------------------------------------------------------

is-throttled-error fn (error: Map): Bool {
  eq(get-in(error, ["extensions", "code"]), "THROTTLED")
}

throttle-wait-ms
meta {
    doc: """
    Estimate milliseconds until the cost bucket can afford the request,
    from an `extensions.cost` block: `(requestedQueryCost -
    currentlyAvailable) / restoreRate`, at least Shopify's recommended
    one second. Exposed for testing.
    """
}
fn (cost: Map?): Int {
  c or(cost, {})
  requested or(get(c, "requestedQueryCost"), 0)
  available or(get-in(c, ["throttleStatus", "currentlyAvailable"]), 0)
  rate or(get-in(c, ["throttleStatus", "restoreRate"]), 0)
  deficit max(0, sub(requested, available))
  cond {
    lte(rate, 0) => { 1000 }
    => { max(1000, Int(ceil(div(mul(deficit, 1000), rate)))) }
  }
}

parse-graphql-response
meta {
    doc: """Unwrap a GraphQL response body: `data` when there are no errors, otherwise an Err carrying `GraphQLError`. Exposed for testing; `graphql` applies it."""
}
fn (body: Any): Any {
  errors or(get-in(body, ["errors"]), [])
  cost get-in(body, ["extensions", "cost"])
  throttled some(errors, is-throttled-error)
  cond {
    is-empty(errors) => { get-in(body, ["data"]) }
    => {
      err(GraphQLError({
        errors: errors,
        data: get-in(body, ["data"]),
        cost: cost,
        throttled: throttled,
        retry-after-ms: if(throttled, throttle-wait-ms(cost), null)
      }))
    }
  }
}

mutation-payload
meta {
    doc: """
    Pull one mutation's payload out of `data` and turn a non-empty
    `userErrors` list into an Err carrying `UserErrors`. Pass
    `errors-key` for mutations that report errors under another name
    (e.g. `orderCancelUserErrors`). Exposed for testing.
    """
}
fn
(data: Any, field: Str): Any {
  mutation-payload(data, field, "userErrors")
},
(data: Any, field: Str, errors-key: Str): Any {
  payload get-in(data, [field])
  user-errors or(get-in(payload, [errors-key]), [])
  cond {
    is-empty(user-errors) => { payload }
    => { err(UserErrors({mutation: field, user-errors: user-errors, payload: payload})) }
  }
}

// ---------------------------------------------------------------------------
// GraphQL
// ---------------------------------------------------------------------------

build-request
meta {
    doc: """The outgoing `HttpRequest` from resolved settings (see `resolve`). Pure; exposed for testing."""
}
fn (query: Str, variables: Map, resolved: Map): HttpRequest {
  HttpRequest({
    method: "POST",
    url: resolved.url,
    headers: {
      X-Shopify-Access-Token: resolved.access-token,
      Content-Type: "application/json",
      Accept: "application/json"
    },
    body: to-json({query: query, variables: untype(variables)})
  })
}

graphql
meta {
    doc: """
    Execute a GraphQL query or mutation against the Admin API. Returns
    `data`, or an Err carrying `GraphQLError` (GraphQL errors, including
    throttling) or `HttpError` (non-2xx).

    Throttled requests are not retried in-process (Hot has no sleep);
    read `retry-after-ms` from the Err, or let a handler's `retry`
    metadata back off.

    **Example**

    ```hot
    out ::shopify::api/graphql("query { shop { name currencyCode } }")
    out.shop.name

    // For another shop
    tenant {shop: "acme", access-token: "shpat_tenant"}
    out ::shopify::api/graphql("query { shop { name } }", {}, tenant)
    ```
    """
}
fn
(query: Str): Any {
  graphql(query, {})
},
(query: Str, variables: Map): Any {
  graphql(query, variables, {})
},
// 3-arity: per-call credentials and settings (see `resolve`)
(query: Str, variables: Map, opts: Map): Any {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => {
      response ::hot::http/request(build-request(query, variables, resolved))
      cond {
        is-err(response) => { response }
        not(is-ok-response(response)) => { err(HttpError(response)) }
        => { parse-graphql-response(response.body) }
      }
    }
  }
},
// 4-arity: explicit shop (handle or myshopify domain) + access token
(query: Str, variables: Map, shop: Str, access-token: Str): Any {
  graphql(query, variables, {shop: shop, access-token: access-token})
}

mutate
meta {
    doc: """Run a mutation and return its payload (`data[field]`), with `userErrors` (or `errors-key`) turned into an Err carrying `UserErrors`. An Err from the request comes back as is."""
}
fn
(query: Str, variables: Map, field: Str): Any {
  mutate(query, variables, field, "userErrors", {})
},
(query: Str, variables: Map, field: Str, errors-key: Str): Any {
  mutate(query, variables, field, errors-key, {})
},
(query: Str, variables: Map, field: Str, opts: Map): Any {
  mutate(query, variables, field, "userErrors", opts)
},
(query: Str, variables: Map, field: Str, errors-key: Str, opts: Map): Any {
  data graphql(query, variables, opts)
  cond {
    is-err(data) => { data }
    => { mutation-payload(data, field, errors-key) }
  }
}

// ---------------------------------------------------------------------------
// Pagination
// ---------------------------------------------------------------------------

page-size fn (requested: Any): Int {
  size or(requested, ::shopify/DEFAULT_PAGE_SIZE)
  max(1, min(size, ::shopify/MAX_PAGE_SIZE))
}

connection-variables
meta {
    doc: """
    Build connection variables from list options: `first` (default 50,
    capped at 250), `after`, `query`, `sortKey`, `reverse`. Unset options
    are omitted. Exposed for testing.
    """
}
fn (options: Map): Map {
  filter-vals({
    first: page-size(get(options, "first")),
    after: get(options, "after"),
    query: get(options, "query"),
    sortKey: get(options, "sortKey"),
    reverse: get(options, "reverse")
  }, is-some)
}

collect-pages fn (page-fn: Fn, options: Map, max-items: Int, acc: Vec): Vec {
  remaining sub(max-items, length(acc))
  page page-fn({...options, first: min(page-size(get(options, "first")), remaining)})
  cond {
    is-err(page) => { page }
    => {
      combined concat(acc, or(page.nodes, []))
      has-next and(get-in(page, ["pageInfo", "hasNextPage"]), is-some(get-in(page, ["pageInfo", "endCursor"])))
      cond {
        gte(length(combined), max-items) => { slice(combined, 0, max-items) }
        not(has-next) => { combined }
        => { collect-pages(page-fn, {...options, after: page.pageInfo.endCursor}, max-items, combined) }
      }
    }
  }
}

collect
meta {
    doc: """
    Follow a connection's cursors and gather up to `max-items` nodes.
    `page-fn` takes list options (with `first` and `after` filled in) and
    returns a connection `{nodes, pageInfo: {hasNextPage, endCursor}}`,
    which is what every `list-*` function here returns. An Err on any
    page comes back as that Err.

    **Example**

    ```hot
    paid ::shopify::api/collect(::shopify::orders/list-orders, {query: "financial_status:paid"}, 1000)
    ```
    """
}
fn (page-fn: Fn, options: Map, max-items: Int): Vec {
  cond {
    lte(max-items, 0) => { [] }
    => { collect-pages(page-fn, options, max-items, []) }
  }
}

quote-search-term
meta {
    doc: """Quote a value as an exact term for Shopify's search syntax (backslashes and quotes escaped, wrapped in double quotes) so operators or spaces in the value can't broaden the search. Exposed for testing."""
}
fn (value: Str): Str {
  no-backslash join(split(value, "\\"), "\\\\")
  escaped join(split(no-backslash, "\""), "\\\"")
  `"${escaped}"`
}
