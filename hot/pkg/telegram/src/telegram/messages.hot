SendPhotoRequest
meta {
    doc: """`photo` is a file_id, an HTTP URL Telegram fetches, or an `InputFile` (bytes, uploaded as multipart; up to 10 MB)."""
}
type {
  chat_id: Any,
  photo: Str | InputFile,
  caption: Str?,
  parse_mode: Str?,
  caption_entities: Vec<Map>?,
  show_caption_above_media: Bool?,
  has_spoiler: Bool?,
  disable_notification: Bool?,
  protect_content: Bool?,
  allow_paid_broadcast: Bool?,
  message_effect_id: Str?,
  reply_parameters: Map?,
  reply_markup: Map?,
  message_thread_id: Int?,
  direct_messages_topic_id: Int?,
  business_connection_id: Str?
}

send-photo
meta {
    doc: """
sendPhoto - Send a photo. `photo` can be a file_id (to resend), an HTTP URL, or an `InputFile` to upload bytes.

**Example**

```hot
::messages ::telegram::messages

response ::messages/send-photo(::messages/SendPhotoRequest({
  chat_id: 123456789,
  photo: "https://example.com/image.jpg",
  caption: "Check out this image!"
}))

// Upload bytes (multipart/form-data)
png ::hot::file/read-file-bytes("chart.png")
response ::messages/send-photo(::messages/SendPhotoRequest({
  chat_id: 123456789,
  photo: ::telegram::api/input-file(png, "chart.png", "image/png")
}))
```
"""
}
fn (request: SendPhotoRequest): Map {
  api-request("sendPhoto", untype(request))
}

