::hubspot::webhooks ns
meta {
    doc: """HubSpot v3 request signature verification: base64 HMAC-SHA256 of `method + decodedUri + body + timestamp` with your app's client secret, delivered as `X-HubSpot-Signature-v3` + `X-HubSpot-Request-Timestamp` (millisecond timestamp, 5-minute window). See https://developers.hubspot.com/docs/apps/developer-platform/build-apps/authentication/request-validation."""
}

::ctx ::hot::ctx
::hmac ::hot::hmac
::time ::hot::time

// HubSpot's v3 spec: before signing, decode exactly these percent-encoded
// characters in the URI (the literal `?` that starts the query string is
// already literal). Other escapes (e.g. %20, %26, %3D) stay encoded.
URI_DECODES [
  ["%3A", ":"], ["%2F", "/"], ["%3F", "?"], ["%40", "@"],
  ["%21", "!"], ["%24", "$"], ["%27", "'"], ["%28", "("],
  ["%29", ")"], ["%2A", "*"], ["%2C", ","], ["%3B", ";"]
]

MAX_AGE_SECONDS 300

normalize-uri
meta {
    doc: """
    The URI as HubSpot signs it: any `#fragment` dropped, and the twelve
    characters in HubSpot's v3 table (`: / ? @ ! $ ' ( ) * , ;`) decoded
    from their percent-escapes, in either hex case. Exposed for testing.

    **Example**

    ```hot
    ::hubspot::webhooks/normalize-uri("https://example.com/hook%3Fa%20b#top")  // "https://example.com/hook?a%20b"
    ```
    """
}
fn (uri: Str): Str {
  without-fragment first(split(uri, "#"))
  reduce(URI_DECODES, (acc, pair) {
    encoded first(pair)
    decoded last(pair)
    replace(replace(acc, encoded, decoded), lowercase(encoded), decoded)
  }, without-fragment)
}

build-base-string
meta {
    doc: """
    The v3 signed message: `method + normalize-uri(uri) + rawBody +
    timestamp`. A `Bytes` body (non-UTF-8, from `::hot::http/raw-body`)
    yields `Bytes`, so it is signed verbatim. Exposed for testing.

    **Example**

    ```hot
    ::hubspot::webhooks/build-base-string("POST", "https://example.com/hook", "{}", "1762000000000")  // "POSThttps://example.com/hook{}1762000000000"
    ```
    """
}
fn (method: Str, uri: Str, raw-body: Str | Bytes, timestamp: Str): Str | Bytes {
  prefix `${method}${normalize-uri(uri)}`
  cond {
    is-bytes(raw-body) => { concat(Bytes(prefix), raw-body, Bytes(timestamp)) }
    => { `${prefix}${raw-body}${timestamp}` }
  }
}

verify-request
meta {
    ctx: {"hubspot.client.secret": {required: false}},
    doc: """
    Verify a HubSpot v3 webhook request. `request` needs `method`,
    `original-url` (the URL HubSpot called, as delivered by the platform),
    `headers`, and the raw body (`body-raw`, or `body-bytes` when the body
    is not UTF-8; read through `::hot::http/raw-body`). Returns true when
    the signature matches (constant-time) and the millisecond timestamp is
    within 5 minutes. Uses the `hubspot.client.secret` context variable by
    default (failing when it is unset), or accepts an explicit secret — an
    empty explicit secret never verifies.

    HubSpot signs the exact URL configured in your app, query string
    included. The 3-arity form takes that URL explicitly for when the
    platform-reconstructed `original-url` differs from it — e.g. a
    rewriting proxy in front, or a plain `http://` endpoint behind an edge
    that doesn't set `x-forwarded-proto` (reconstruction defaults to
    `https`). The platform also withholds `original-url` on redelivery
    paths it cannot corroborate (it is never persisted with the webhook
    token intact), so re-verifying a replayed event needs the explicit-URL
    form too.

    **Example**

    ```hot
    hubspot-webhook
    meta {webhook: {service: "hubspot", path: "/hubspot/webhook"}}
    fn (request) {
      if(not(::hubspot::webhooks/verify-request(request)),
        ::hot::http/HttpResponse({status: 401, body: "invalid signature"}),
        ::hot::http/HttpResponse({status: 200, body: "ok"}))
    }
    ```
    """
}
fn
(request: Map): Bool {
  secret or(::ctx/get("hubspot.client.secret"), "")
  if(is-empty(secret),
    fail("hubspot.client.secret is not set. Add it in Context Variables to verify webhook requests.")
  )
  verify-request(request, secret)
},
(request: Map, client-secret: Str): Bool {
  verify-request(request, client-secret, or(get(request, "original-url", ""), ""))
},
// 3-arity: explicit URL override — must be the exact URL configured at HubSpot
(request: Map, client-secret: Str, url: Str): Bool {
  headers or(get(request, "headers"), {})
  signature or(get(headers, "x-hubspot-signature-v3", ""), "")
  timestamp or(get(headers, "x-hubspot-request-timestamp", ""), "")
  raw-body ::hot::http/raw-body(request)
  method uppercase(or(get(request, "method", "POST"), "POST"))

  cond {
    // An empty key would make every signature forgeable: fail closed.
    is-empty(client-secret) => { false }
    or(is-empty(signature), is-empty(timestamp)) => { false }
    is-empty(url) => { false }
    => {
      base build-base-string(method, url, raw-body, timestamp)
      cond {
        not(::hmac/hmac-verify-base64(::ctx/mark-secret(client-secret), base, signature, "sha256")) => { false }
        => {
          // Header is milliseconds; the shared tolerance check is seconds.
          parsed Int(timestamp)
          match parsed {
            Result.Err => { false }

            _ => { ::time/within-seconds-of-now(Int(floor(div(parsed, 1000))), MAX_AGE_SECONDS) }
          }
        }
      }
    }
  }
}
