::qwen::embeddings ns
meta {
    doc: """Qwen Embeddings API — generate vector embeddings via DashScope's OpenAI-compatible endpoint."""
}

HttpError ::openai::api/HttpError
is-ok-response ::hot::http/is-ok-response

// ============================================================================
// Types
// ============================================================================

EmbeddingRequest type {
    input: Any,
    model: Str,
    dimensions: Int?,
    encoding_format: Str?
}

Embedding type {
    object: Str,
    embedding: Vec<Dec>,
    index: Int
}

EmbeddingUsage type {
    prompt_tokens: Int,
    total_tokens: Int
}

EmbeddingResponse type {
    object: Str,
    data: Vec<Embedding>,
    model: Str,
    usage: EmbeddingUsage
}

// ============================================================================
// API Functions
// ============================================================================

create
meta {
    doc: """
    POST /embeddings — create embeddings for text using a Qwen embedding model.

    Returns an EmbeddingResponse with `data` containing embedding vectors and
    `usage` with token counts.

    **Supported models** (as of 2026):
    - `text-embedding-v4` — latest, supports dimensions 2048 / 1536 / 1024 (default) /
      768 / 512 / 256 / 128 / 64.
    - `qwen3.7-text-embedding` — Qwen3.7 text embeddings.
    - `text-embedding-v3` — previous generation.

    **Example — single text**

    ```hot
    response ::qwen::embeddings/create(::qwen::embeddings/EmbeddingRequest({
        input: "The quick brown fox jumps over the lazy dog",
        model: "text-embedding-v4"
    }))

    embedding response.data[0].embedding // => Vec<Dec> of 1024 dimensions
    response.usage.total_tokens           // => 10
    ```

    **Example — batch**

    ```hot
    response ::qwen::embeddings/create(::qwen::embeddings/EmbeddingRequest({
        input: ["Hello world", "Goodbye world"],
        model: "text-embedding-v4"
    }))

    length(response.data) // => 2
    ```

    **Example — custom dimensions**

    ```hot
    response ::qwen::embeddings/create(::qwen::embeddings/EmbeddingRequest({
        input: "Test text",
        model: "text-embedding-v4",
        dimensions: 256
    }))

    length(response.data[0].embedding) // => 256
    ```
    """
}
fn
(request: EmbeddingRequest): EmbeddingResponse | HttpError {
    create(request, {})
},
(request: EmbeddingRequest, opts: Map): EmbeddingResponse | HttpError {
    response ::qwen::api/request("POST", "/embeddings", {}, request-body(request), opts)
    cond {
        is-err(response) => { response }
        is-ok-response(response) => { EmbeddingResponse(response.body) }
        => { err(HttpError(response)) }
    }
}

request-body
meta {
    doc: """
    The JSON body for an `EmbeddingRequest`, with unset optional fields
    omitted. Pure; exposed for testing.

    **Example**

    ```hot
    ::qwen::embeddings/request-body(::qwen::embeddings/EmbeddingRequest({input: "Hello", model: "text-embedding-v4"}))
    // {input: "Hello", model: "text-embedding-v4"}
    ```
    """
}
fn (request: EmbeddingRequest): Map {
    filter-vals(untype(request), is-some)
}

// ============================================================================
// Convenience Functions
// ============================================================================

embed
meta {
    doc: """
    Simple embedding — returns the embedding vector for a single text. Defaults
    to `text-embedding-v4` at 1024 dimensions. API errors propagate as an Err.

    **Example**

    ```hot
    vector ::qwen::embeddings/embed("Hello world")
    // => Vec<Dec> with 1024 dimensions
    ```
    """
}
fn
(text: Str): Vec<Dec> {
    embed(text, "text-embedding-v4", {})
},
(text: Str, opts: Map): Vec<Dec> {
    embed(text, "text-embedding-v4", opts)
},
(text: Str, model: Str): Vec<Dec> {
    embed(text, model, {})
},
(text: Str, model: Str, opts: Map): Vec<Dec> {
    response create(EmbeddingRequest({
        input: text,
        model: model
    }), opts)

    // An Err (bad key, wrong region, ...) propagates instead of
    // collapsing into an empty vector.
    cond {
        is-err(response) => { response }
        is-empty(response.data) => { [] }
        => { response.data[0].embedding }
    }
}

embed-batch
meta {
    doc: """
    Embed multiple texts in a single request. Returns a Vec of embedding vectors
    aligned with the input order.

    **Example**

    ```hot
    vectors ::qwen::embeddings/embed-batch(["Hello", "World", "Test"], "text-embedding-v4")
    length(vectors) // => 3
    ```
    """
}
fn
(texts: Vec<Str>): Vec<Vec<Dec>> {
    embed-batch(texts, "text-embedding-v4", {})
},
(texts: Vec<Str>, opts: Map): Vec<Vec<Dec>> {
    embed-batch(texts, "text-embedding-v4", opts)
},
(texts: Vec<Str>, model: Str): Vec<Vec<Dec>> {
    embed-batch(texts, model, {})
},
(texts: Vec<Str>, model: Str, opts: Map): Vec<Vec<Dec>> {
    response create(EmbeddingRequest({
        input: texts,
        model: model
    }), opts)

    cond {
        is-err(response) => { response }
        => { map(response.data, %.embedding) }
    }
}

// ============================================================================
// Available Models
// ============================================================================

TEXT_EMBEDDING_V4 "text-embedding-v4"
QWEN3_7_TEXT_EMBEDDING "qwen3.7-text-embedding"
TEXT_EMBEDDING_V3 "text-embedding-v3"
