delete-named-range
meta {
    doc: """
    `deleteNamedRange` for every range with this name, in every tab unless
    `opts.tabIds`.

    **Example**

    ```hot
    ::google::docs::requests/delete-named-range("summary")  // {deleteNamedRange: {name: "summary"}}
    ```
    """
}
fn
(name: Str): Map {
  delete-named-range(name, {})
},
(name: Str, opts: Map): Map {
  {deleteNamedRange: ::docs/compact({name: name, tabsCriteria: tabs-criteria(opts)})}
}

replace-named-range
meta {
    doc: """
    `replaceNamedRangeContent`: replace the text of the named range, in
    every tab unless `opts.tabIds`.

    **Example**

    ```hot
    ::google::docs::requests/replace-named-range("summary", "All green")
    // {replaceNamedRangeContent: {namedRangeName: "summary", text: "All green"}}
    ```
    """
}
fn
(name: Str, text: Str): Map {
  replace-named-range(name, text, {})
},
(name: Str, text: Str, opts: Map): Map {
  {replaceNamedRangeContent: ::docs/compact({namedRangeName: name, text: text, tabsCriteria: tabs-criteria(opts)})}
}

create-header
meta {
    doc: """
    `createHeader` on the default section. The reply's
    `createHeader.headerId` is the `segmentId` for adding text to it.

    **Example**

    ```hot
    ::google::docs::requests/create-header()  // {createHeader: {type: "DEFAULT"}}
    ```
    """
}
fn (): Map {
  {createHeader: {type: "DEFAULT"}}
}

create-footer
meta {
