LookupRequest type {
  team_ids: Vec<Str>,
  last_message_activity_before: Int,
  max_member_count: Int?,
  cursor: Str?,
  limit: Int?
}

lookup
meta {
    doc: """
    admin.conversations.lookup - Find public channels whose last message is older than `last_message_activity_before` (Unix seconds), optionally with at most `max_member_count` members. Returns `channel_ids`; a starting point for archiving stale channels.

    Scope: `admin.conversations:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `lookup-all`.

    **Example**

    ```hot
    ::conversations ::slack::admin::conversations

    page ::conversations/lookup(::conversations/LookupRequest({
      team_ids: ["T0123ABCDEF"],
      last_message_activity_before: 1735689600,
      max_member_count: 5,
      limit: 100
    }))
    page.channel_ids
    ```
    """
}
fn
(request: LookupRequest): Map {
  lookup(request, {})
},
(request: LookupRequest, opts: Map): Map {
  ::api/call("admin.conversations.lookup", request, opts)
}

lookup-all
meta {
    doc: """
    Every `channel_ids` entry from `admin.conversations.lookup`, following
    `next_cursor` until the last page or `max-items` (default 1000).
    `request` sets the filters; its `cursor` is the starting point.

    **Example**

    ```hot
    ::conversations ::slack::admin::conversations

    stale ::conversations/lookup-all(::conversations/LookupRequest({team_ids: ["T0123ABCDEF"], last_message_activity_before: 1735689600}), 500)
    length(stale)
    ```
    """
}
fn
(request: LookupRequest): Vec {
  lookup-all(request, 1000)
},
(request: LookupRequest, max-items: Int): Vec {
  lookup-all(request, max-items, {})
},
(request: LookupRequest, max-items: Int, opts: Map): Vec {
  ::api/paginate("admin.conversations.lookup", request, "channel_ids", max-items, opts)
}

SearchRequest type {
  query: Str?,
  team_ids: Vec<Str>?,
  connected_team_ids: Vec<Str>?,
  search_channel_types: Vec<Str>?,
  sort: Str?,
  sort_dir: Str?,
  total_count_only: Bool?,
  cursor: Str?,
  limit: Int?
}

search
meta {
    doc: """
    admin.conversations.search - Search channels across the org. `search_channel_types` e.g. `["private", "exclude_archived"]`; `sort` is `relevant`, `name`, `member_count` or `created`.

    Scope: `admin.conversations:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `search-all`.

    **Example**

    ```hot
    ::conversations ::slack::admin::conversations

    page ::conversations/search(::conversations/SearchRequest({
      query: "incident",
      search_channel_types: ["private", "exclude_archived"],
      sort: "member_count",
      sort_dir: "desc",
      limit: 20
    }))
    map(page.conversations, %.name)
    ```
    """
}
fn
(): Map {
  search(SearchRequest({}))
},
(request: SearchRequest): Map {
  search(request, {})
},
(request: SearchRequest, opts: Map): Map {
  ::api/call("admin.conversations.search", request, opts)
}

search-all
meta {
    doc: """
    Every `conversations` entry from `admin.conversations.search`, following
    `next_cursor` until the last page or `max-items` (default 1000).
    `request` sets the filters; its `cursor` is the starting point.

    **Example**

    ```hot
    ::conversations ::slack::admin::conversations

    hits ::conversations/search-all(::conversations/SearchRequest({query: "incident"}), 200)
    map(hits, %.id)
    ```
    """
}
fn
(): Vec {
  search-all(SearchRequest({}), 1000)
},
(request: SearchRequest): Vec {
  search-all(request, 1000)
},
(request: SearchRequest, max-items: Int): Vec {
  search-all(request, max-items, {})
},
(request: SearchRequest, max-items: Int, opts: Map): Vec {
  ::api/paginate("admin.conversations.search", request, "conversations", max-items, opts)
}

