::notion::blocks ns

::api ::notion::api

get-children
meta {
    doc: """
    GET /blocks/{id}/children - A page's (or block's) content blocks.
    Returns `{results, has_more, next_cursor}`.

    **Example**

    ```hot
    content ::notion::blocks/get-children("59833787-2cf9-4fdf-8782-e53db20768a5")
    map(content.results, %.type)
    ```
    """
}
fn
(block-id: Str): Map {
  get-children(block-id, {})
},
(block-id: Str, opts: Map): Map {
  ::api/json("GET", `/blocks/${block-id}/children`, {}, "", opts)
}

append-children
meta {
    doc: """
    PATCH /blocks/{id}/children - Append blocks to a page or block (build
    them with the `::notion` helpers).

    **Example**

    ```hot
    ::notion::blocks/append-children("59833787-2cf9-4fdf-8782-e53db20768a5", [
      ::notion/to-do("Review the pinecone package"),
      ::notion/paragraph("Added by the standup agent.")
    ])
    ```
    """
}
fn
(block-id: Str, children: Vec): Map {
  append-children(block-id, children, {})
},
(block-id: Str, children: Vec, opts: Map): Map {
  ::api/json("PATCH", `/blocks/${block-id}/children`, {}, {children: children}, opts)
}

delete-block
meta {
    doc: """
    DELETE /blocks/{id} - Move a block to the trash.

    **Example**

    ```hot
    ::notion::blocks/delete-block("c02fc1d3-db8b-45c5-a222-27595b15aea7")
    ```
    """
}
fn
(block-id: Str): Map {
  delete-block(block-id, {})
},
(block-id: Str, opts: Map): Map {
  ::api/json("DELETE", `/blocks/${block-id}`, {}, "", opts)
}

search
meta {
    doc: """
    POST /search - Search everything shared with the integration. The
    2-arity form filters to `"page"` or `"database"` objects.

    **Example**

    ```hot
    hits ::notion::blocks/search("quarterly roadmap", "page")
    first(hits.results).url
    ```
    """
}
fn
(query: Str): Map {
  ::api/json("POST", "/search", {}, {query: query})
},
(query: Str, opts: Map): Map {
  ::api/json("POST", "/search", {}, {query: query}, opts)
},
(query: Str, object-type: Str): Map {
  search(query, object-type, {})
},
(query: Str, object-type: Str, opts: Map): Map {
  ::api/json("POST", "/search", {}, {
    query: query,
    filter: {property: "object", value: object-type}
  }, opts)
}
