disable-preview-branching
meta {
    doc: """
    Disable preview branching for a project. This deletes all existing
    preview branches.

    **Example**

    ```hot
    ::branches ::supabase::admin::branches

    ::branches/disable-preview-branching("my-project-ref")
    ```
    """
}
fn
(project-ref: Str): Map {
  disable-preview-branching(project-ref, {})
},
(project-ref: Str, opts: Map): Map {
  ::api/request("DELETE", `/projects/${project-ref}/branches`, {}, {}, opts)
}
