::name-screening::screen ns
meta {
    doc: """
    Name screening against the cached lists.

    **Never an automatic decision.** A result is `"possible-match"` or
    `"no-match"`, and every possible match needs a human reviewer:
    names are shared by many people, lists carry transliteration
    variants, and the score is a similarity, not a probability. A
    `"no-match"` only says no cached entry scored at or above the
    threshold on the lists searched, which `sources` names. A list that
    is not installed or not refreshed was not searched.

    **Scoring** (all deterministic):

    1. The query and every candidate name are normalized
       (`::name-screening::text/tokens`): case-folded, transliterated,
       punctuation removed, honorifics dropped for individuals and
       corporate suffixes for entities, vessels and aircraft.
    2. Name score: `::name-screening::similarity/name-similarity` against the
       primary name and every alias; the best one counts.
    3. Adjustments when the query gives them: date of birth +0.05 for
       the same full date, +0.02 for the same year (or a year inside a
       listed range), none within one year, -0.15 for a listed date of
       birth more than a year away; country +0.03 when it matches a
       nationality or address country, -0.05 when the entry lists
       countries and none matches. An entry without a date of birth or
       country is never penalized.
    4. The score is clamped to [0, 1]; matches at or above `threshold`
       (default 0.85) are returned, best first.
    """
}

::text ::name-screening::text
::sim ::name-screening::similarity
::index ::name-screening::index
::country ::name-screening::country
::entry ::name-screening::entry

DEFAULT_THRESHOLD 0.85
DEFAULT_LIMIT 10
DEFAULT_MAX_CANDIDATES 50

DOB_EXACT_BONUS 0.05
DOB_YEAR_BONUS 0.02
DOB_MISMATCH_PENALTY 0.15
COUNTRY_BONUS 0.03
COUNTRY_MISMATCH_PENALTY 0.05

REVIEW_NOTICE "Automated screening result. Every possible match must be reviewed by a person before any decision; a no-match only means no entry scored above the threshold on the lists searched. A list that is not installed or not refreshed was not searched."

Match
meta {
    doc: """
    One possible match.

    **Fields**
    - `status` — always `"possible-match"`: review it
    - `score` — the final score in [0, 1]
    - `name-score` — the name similarity before adjustments
    - `matched-name` — the listed name that scored best
    - `matched-field` — `"name"` (the primary name) or `"alias"`
    - `matched-fields` — every field that contributed: `"name"` or
      `"alias"`, plus `"dob"` and `"country"` when they matched
    - `explanation` — one line per contribution, for the reviewer
    - `entry` — the listed `Entry`
    """
}
type {
    status: Str,
    score: Dec,
    name-score: Dec,
    matched-name: Str,
    matched-field: Str,
    matched-fields: Vec<Str>,
    explanation: Vec<Str>,
    entry: Map
}

ScreenResult
meta {
    doc: """
    The answer to a `screen` call.

    **Fields**
    - `status` — `"possible-match"` when any match scored at or above
      the threshold, else `"no-match"`; never a final decision
    - `review-required` — true whenever `status` is `"possible-match"`
    - `notice` — the human-review notice, ending with the lists searched
    - `query` — the name and options screened
    - `threshold` — the threshold used
    - `matches` — `Match` records, best first
    - `sources` — the lists searched, per list: `{source, list, version,
      entries, fetched-at}`. Nothing else was searched
    - `not-searched` — source keys that were required but skipped with
      `allow-missing`
    - `warnings` — e.g. a list not refreshed for longer than
      `max-age-days`, or a call that did not name its `sources`
    - `candidates` — how many candidates were scored
    """
}
type {
    status: Str,
    review-required: Bool,
    notice: Str,
    query: Map,
    threshold: Dec,
    matches: Vec<Match>,
    sources: Vec<Map>,
    not-searched: Vec<Str>,
    warnings: Vec<Str>,
    candidates: Int
}

// ---------------------------------------------------------------------------
// Query
// ---------------------------------------------------------------------------

query-of
meta {
    doc: """
    Normalize a query: `{name, plain, stripped, keys, dob, years,
    country, kind}`. `plain` and `stripped` are the name's tokens without
    and with corporate suffixes removed; `keys` the blocking keys of
    both; `years` the `[from, to]` range of `dob`.
    """
}
fn (name: Str, opts: Map): Map {
  plain ::text/tokens(name, false)
  stripped ::text/tokens(name, true)
  dob if(::entry/present(get(opts, "dob")), ::entry/iso-date(Str(get(opts, "dob"))), null)
  country-in get(opts, "country")
  {
    name: name,
    plain: plain,
    stripped: stripped,
    keys: sort(distinct(concat(::text/blocking-keys(plain), ::text/blocking-keys(stripped)))),
    dob: dob,
    years: if(is-null(dob), null, ::entry/year-range(dob)),
    country: if(::entry/present(country-in), ::country/key(Str(country-in)), null),
    kind: get(opts, "kind")
  }
}

// ---------------------------------------------------------------------------
// Scoring
// ---------------------------------------------------------------------------

best-name
meta {
    doc: """The best `name-similarity` of the query tokens against a record's names: `{score, index}` (index 0 is the primary name)."""
}
fn (q: Vec<Str>, toks: Vec): Map {
  scored map-indexed(toks, (i, t) { {score: ::sim/name-similarity(q, t), index: i} })
  reduce(scored, (best, s) { if(gt(s.score, best.score), s, best) }, {score: 0.0, index: 0})
}

dob-adjustment
meta {
    doc: """`{delta, field, line}` for a query date of birth against an entry's dates of birth (see the namespace doc). Exposed for testing."""
}
fn (query-dob: Str?, query-years: Vec?, dobs: Vec<Str>): Map {
  ranges filter(map(dobs, ::entry/year-range), is-some)
  cond {
    or(is-null(query-dob), is-null(query-years)) => { {delta: 0.0, field: null, line: null} }
    is-empty(ranges) => { {delta: 0.0, field: null, line: "no date of birth listed"} }
    some(dobs, (d) { and(eq(d, query-dob), eq(length(query-dob), 10)) }) => {
      {delta: DOB_EXACT_BONUS, field: "dob", line: `date of birth ${query-dob} matches exactly`}
    }
    => {
      qf query-years[0]
      qt query-years[1]
      overlaps some(ranges, (r) { and(lte(r[0], qt), gte(r[1], qf)) })
      near some(ranges, (r) { and(lte(sub(r[0], 1), qt), gte(add(r[1], 1), qf)) })
      cond {
        overlaps => { {delta: DOB_YEAR_BONUS, field: "dob", line: `year of birth matches (${join(dobs, ", ")})`} }
        near => { {delta: 0.0, field: null, line: `year of birth within one year (${join(dobs, ", ")})`} }
        => { {delta: sub(0, DOB_MISMATCH_PENALTY), field: null, line: `date of birth differs (${join(dobs, ", ")})`} }
      }
    }
  }
}

country-adjustment
meta {
    doc: """`{delta, field, line}` for a query country key against an entry's country codes. Exposed for testing."""
}
fn (country: Str?, countries: Vec<Str>): Map {
  cond {
    or(is-null(country), is-empty(or(country, ""))) => { {delta: 0.0, field: null, line: null} }
    is-empty(countries) => { {delta: 0.0, field: null, line: "no country listed"} }
    some(countries, (c) { eq(c, country) }) => { {delta: COUNTRY_BONUS, field: "country", line: `country ${country} matches`} }
    => { {delta: sub(0, COUNTRY_MISMATCH_PENALTY), field: null, line: `country ${country} not among ${join(countries, ", ")}`} }
  }
}

clamp fn (x: Any): Dec {
  ::sim/round4(max(0.0, min(1.0, x)))
}

score-record
meta {
    doc: """
    Score one stored record (see `::name-screening::index/record`) against a
    normalized query (`query-of`). Returns a `Match` whatever the score;
    `screen` applies the threshold.
    """
}
fn (query: Map, rec: Map): Match {
  e rec.entry
  q if(::text/strips-suffixes(e.kind), query.stripped, query.plain)
  best best-name(q, rec.toks)
  names concat([e.name], e.aliases)
  field if(eq(best.index, 0), "name", "alias")
  matched get(names, best.index)
  dob dob-adjustment(query.dob, query.years, or(e.dobs, []))
  country country-adjustment(query.country, or(rec.countries, []))
  name-line `${field} "${matched}" similarity ${best.score}`
  Match({
    status: "possible-match",
    score: clamp(add(add(best.score, dob.delta), country.delta)),
    name-score: best.score,
    matched-name: matched,
    matched-field: field,
    matched-fields: filter([field, dob.field, country.field], is-some),
    explanation: filter([name-line, dob.line, country.line], is-some),
    entry: e
  })
}

kind-allowed fn (kind: Any, rec: Map): Bool {
  cond {
    is-null(kind) => { true }
    is-vec(kind) => { some(kind, (k) { eq(k, rec.entry.kind) }) }
    => { eq(kind, rec.entry.kind) }
  }
}

order-matches
meta {
    doc: """Sort matches best first; ties by source, then id, so results are deterministic."""
}
fn (matches: Vec): Vec {
  by-id sort-by(matches, (m) { `${m.entry.source}|${m.entry.id}` })
  sort-by(by-id, (m) { sub(0, m.score) })
}

// ---------------------------------------------------------------------------
// Screening
// ---------------------------------------------------------------------------

candidates-for
meta {
    doc: """
    The candidate records for one list: reads the buckets the query's
    keys fall in through `read-bucket` (a Fn taking a bucket key and
    returning the bucket Map or null), ranks ids with
    `::name-screening::index/rank-candidates`, and loads up to
    `max-candidates` records through `read-record` (a Fn taking a
    record key).
    """
}
fn (query: Map, read-bucket: Fn, read-record: Fn, max-candidates: Int): Vec {
  by-bucket group-by(query.keys, ::index/bucket-of)
  postings mapcat(keys(by-bucket), (b) {
    bucket or(read-bucket(b), {})
    map(get(by-bucket, b), (k) { [k, get(bucket, k, [])] })
  })
  ids ::index/rank-candidates(postings, max-candidates)
  filter(map(ids, (id) { read-record(::index/record-key(id)) }), is-some)
}

score-candidates
meta {
    doc: """Score candidate records against a query: applies the `kind` filter and the threshold, and orders the matches. Pure; exposed for testing."""
}
fn (query: Map, records: Vec, threshold: Any): Vec<Match> {
  allowed filter(records, (r) { kind-allowed(query.kind, r) })
  scored map(allowed, (r) { score-record(query, r) })
  order-matches(filter(scored, (m) { gte(m.score, threshold) }))
}

candidates-in
meta {
    doc: """`candidates-for` over an in-memory index from `::name-screening::index/build`, selecting the needed buckets and records in one pass each."""
}
fn (query: Map, idx: Map, max-candidates: Int): Vec {
  needed distinct(map(query.keys, ::index/bucket-of))
  buckets filter-keys(idx.buckets, (k) { in(k, needed) })
  postings map(query.keys, (k) { [k, get(get(buckets, ::index/bucket-of(k), {}), k, [])] })
  ids ::index/rank-candidates(postings, max-candidates)
  wanted map(ids, ::index/record-key)
  vals(filter-keys(idx.records, (k) { in(k, wanted) }))
}

screen-index
meta {
    doc: """
    Screen a name against in-memory indexes (pure): `indexes` maps a
    source key to an index from `::name-screening::index/build`. Useful for
    tests and for small custom lists; production screening reads the
    cache with `::name-screening/screen`. An Err when `indexes` is empty
    or an index holds no records, as a `"no-match"` would mean nothing.

    **Example**

    ```hot
    idx ::name-screening::index/build(entries)
    result ::name-screening::screen/screen-index({un: idx}, "Abid Hamid Mahmud", {dob: "1957"})
    result.status   // "possible-match" or "no-match"
    ```
    """
}
fn (indexes: Map, name: Str, opts: Map): ScreenResult {
  empty filter(keys(indexes), (s) { is-empty(get(get(indexes, s), "records")) })
  cond {
    is-empty(indexes) => { err("name-screening: no index to search") }
    not(is-empty(empty)) => { err(`name-screening: no records to search in ${join(empty, ", ")}`) }
    => {
      query query-of(name, opts)
      max-c or(get(opts, "max-candidates"), DEFAULT_MAX_CANDIDATES)
      records mapcat(vals(indexes), (idx) { candidates-in(query, idx, max-c) })
      sources map(keys(indexes), (s) { {source: s, entries: length(get(get(indexes, s), "records"))} })
      result(query, records, opts, sources, [], [])
    }
  }
}

notice-for
meta {
    doc: """`REVIEW_NOTICE` followed by the lists searched, so the notice says what a `"no-match"` covers wherever it is read."""
}
fn (sources: Vec): Str {
  `${REVIEW_NOTICE} Searched: ${join(map(sources, (s) { or(get(s, "list"), s.source) }), ", ")}.`
}

result
meta {
    doc: """Assemble a `ScreenResult` from scored candidates (pure)."""
}
fn (query: Map, records: Vec, opts: Map, sources: Vec, warnings: Vec, not-searched: Vec): ScreenResult {
  threshold or(get(opts, "threshold"), DEFAULT_THRESHOLD)
  limit or(get(opts, "limit"), DEFAULT_LIMIT)
  matches score-candidates(query, records, threshold)
  kept slice(matches, 0, min(limit, length(matches)))
  found not(is-empty(kept))
  ScreenResult({
    status: if(found, "possible-match", "no-match"),
    review-required: found,
    notice: notice-for(sources),
    query: filter-vals({name: query.name, dob: query.dob, country: query.country, kind: query.kind}, is-some),
    threshold: threshold,
    matches: kept,
    sources: sources,
    not-searched: not-searched,
    warnings: warnings,
    candidates: length(records)
  })
}
