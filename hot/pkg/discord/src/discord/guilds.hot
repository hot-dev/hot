    **Example**

    ```hot
    ::guilds ::discord::guilds

    ::guilds/modify-current-member(::guilds/ModifyCurrentMemberRequest({
      guild_id: "1000000000000000000",
      nick: "Deploy Bot",
      reason: "Clearer name"
    }))
    ```
    """
}
fn
(request: ModifyCurrentMemberRequest): Map {
  modify-current-member(request, {})
},
(request: ModifyCurrentMemberRequest, opts: Map): Map {
  ::api/call("PATCH", `/guilds/${seg(request.guild_id)}/members/@me`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  }, opts)
}

