  channel_id: Str,
  user_id: Str
}

remove-thread-member
meta {
    doc: """DELETE /channels/{channel_id}/thread-members/{user_id} - Remove a user from a thread. Needs MANAGE_THREADS, or to be the creator of a private thread."""
}
fn (request: RemoveThreadMemberRequest): Bool {
  ::api/call-ok("DELETE", `/channels/${seg(request.channel_id)}/thread-members/${seg(request.user_id)}`)
