::slack::admin::users ns
meta {
    doc: """
    `admin.users.*`: list, invite, assign and remove users; change roles
    (admin, owner, regular); manage guest expiration; and list, reset or
    invalidate sessions and session settings.

    **Example**

    ```hot
    ::users ::slack::admin::users

    // Sign a compromised account out everywhere
    ::users/session-reset(::users/SessionResetRequest({user_id: "U0123ABCDEF"}))

    // Deactivated users across the org
    gone ::users/list-all(::users/ListRequest({is_active: false}), 2000)
    ```
    """
}

::api ::slack::admin::api

ListRequest type {
  team_id: Str?,
  include_deactivated_user_workspaces: Bool?,
  is_active: Bool?,
  cursor: Str?,
  limit: Int?
}

list
meta {
    doc: """
    admin.users.list - List users (`users`). Pass `team_id` for one workspace, or omit it with an org token to list the whole org.

    Scope: `admin.users:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `list-all`.
    """
}
fn
(): Map {
  list(ListRequest({}))
},
(request: ListRequest): Map {
  list(request, {})
},
(request: ListRequest, opts: Map): Map {
  ::api/call("admin.users.list", request, opts)
}

list-all
meta {
    doc: """
    Every `users` entry from `admin.users.list`, following `next_cursor` until the last page or `max-items` (default 1000). `request` sets the filters; its `cursor` is the starting point.
    """
}
fn
(): Vec {
  list-all(ListRequest({}), 1000)
},
(request: ListRequest): Vec {
  list-all(request, 1000)
},
(request: ListRequest, max-items: Int): Vec {
  list-all(request, max-items, {})
},
(request: ListRequest, max-items: Int, opts: Map): Vec {
  ::api/paginate("admin.users.list", request, "users", max-items, opts)
}

InviteRequest type {
  team_id: Str,
  email: Str,
  channel_ids: Vec<Str>,
  real_name: Str?,
  custom_message: Str?,
  is_restricted: Bool?,
  is_ultra_restricted: Bool?,
  guest_expiration_ts: Str?,
  email_password_policy_enabled: Bool?,
  resend: Bool?
}

invite
meta {
    doc: """
    admin.users.invite - Invite someone to a workspace, joining `channel_ids`. `is_restricted` / `is_ultra_restricted` invite a multi- or single-channel guest; `guest_expiration_ts` sets a guest's expiry.

    Scope: `admin.users:write`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    """
}
fn
(request: InviteRequest): Map {
  invite(request, {})
},
(request: InviteRequest, opts: Map): Map {
  ::api/call("admin.users.invite", request, opts)
}

