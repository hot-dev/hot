::firecrawl::api ns
meta {
    ctx: {"firecrawl.api.key": {required: false}},
    doc: """
    Low-level Firecrawl HTTP client plus the pure helpers behind the
    job functions: body building, `next`-page following, and job
    status checks. Most code wants the functions in `::firecrawl` instead.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then the `firecrawl.api.key` context variable, then the
    defaults. Nothing from `opts` is written to ctx, so one run can act for
    many tenants and parallel flows don't share credentials. Credentials
    in `opts` are masked in call records. An `api-key` present but blank or
    null is an error, never a fallback to context.

    - `api-key`: the API key for this call
    - `base-url`: another API root, such as a self-hosted Firecrawl. It
      needs an `api-key` in the same `opts`: `firecrawl.api.key` is never
      sent to a per-call URL.
    """
}

::ctx ::hot::ctx
::uri ::hot::uri
::re ::hot::regex

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

// =============================================================================
// Errors
// =============================================================================

HttpError
meta {
    doc: """
    A non-2xx Firecrawl response. `message` is readable text built from
    Firecrawl's `{success: false, error, code?}` body; the raw body is
    kept in `body`.
    """
}
type {
    status: Int,
    message: Str,
    headers: Map,
    body: Any
}

error-message
meta {
    doc: """
    Readable text for a failed response: Firecrawl's `error` (or `message`)
    field when present, prefixed with the HTTP status. Exposed for testing.

    **Example**

    ```hot
    ::firecrawl::api/error-message(402, {success: false, error: "Insufficient credits"})  // "Firecrawl API error 402: Insufficient credits"
    ::firecrawl::api/error-message(500, null)  // "Firecrawl API error 500"
    ```
    """
}
fn (status: Int, body: Any): Str {
  detail cond {
    is-map(body) => { or(text-or-null(get(body, "error")), text-or-null(get(body, "message"))) }
    is-str(body) => { text-or-null(body) }
    => { null }
  }

  if(is-some(detail), `Firecrawl API error ${status}: ${detail}`, `Firecrawl API error ${status}`)
}

text-or-null
meta {no-doc: true}
fn (value: Any): Any {
  if(and(is-str(value), not(is-blank(value))), value, null)
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    message: error-message(response.status, response.body),
    headers: or(response.headers, {}),
    body: response.body
  })
}

// =============================================================================
// Credentials
// =============================================================================

non-blank
meta {no-doc: true}
fn (value: Any): Str? {
  if(is-str(value), if(is-blank(value), null, trim(value)), null)
}

resolve-from
meta {
    doc: """
    The one resolver, pure: `{api-key, base-url}` for a call from `opts`
    first, then `ctx-values` (a Map of context variables), then defaults. An
    Err when no API key is set, when `api-key` is in `opts` but blank or
    null (that never falls back to context), or when `opts` has `base-url`
    without `api-key`. Exposed for testing; `resolve` feeds it the context.

    **Example**

    ```hot
    ::api ::firecrawl::api

    ::api/resolve-from({}, {"firecrawl.api.key": "ctx-key"}).api-key  // "ctx-key"
    ::api/resolve-from({api-key: "tenant-key"}, {}).base-url  // "https://api.firecrawl.dev/v2"
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  opt-key non-blank(get(opts, "api-key"))
  opt-url non-blank(get(opts, "base-url"))
  api-key or(opt-key, non-blank(get(ctx-values, "firecrawl.api.key")))
  cond {
    and(in("api-key", keys(opts)), is-null(opt-key)) => {
      err("firecrawl: api-key is in the call's opts but is blank or null. Pass a value, or leave api-key out to use firecrawl.api.key.")
    }

    and(is-some(opt-url), is-null(opt-key)) => {
      err("firecrawl: base-url is in the call's opts without api-key. Pass api-key with it. Context credentials are never sent to a per-call URL.")
    }

    is-null(api-key) => { err("firecrawl: firecrawl.api.key is not set. Add it in Context Variables, or pass {api-key: ...} in the call's opts.") }
    => { {api-key: api-key, base-url: ::re/replace-all(or(opt-url, ::firecrawl/BASE_URL), "/+$", "")} }
  }
}

resolve
meta {
    ctx: {"firecrawl.api.key": {required: false}},
    doc: """
    Credentials and settings for one call (see `resolve-from`). An `api-key`
    from `opts` is masked in this run's records and never written to ctx.

    **Example**

    ```hot
    ::firecrawl::api/resolve({api-key: "fc-tenant-b"}).base-url  // "https://api.firecrawl.dev/v2"
    ```
    """
}
fn (opts: Map): Map {
  ::ctx/mark-secret(non-blank(get(opts, "api-key")))
  resolve-from(opts, {"firecrawl.api.key": ::ctx/get("firecrawl.api.key")})
}

// =============================================================================
// Requests
// =============================================================================

build-request
meta {
    doc: """
    The outgoing `HttpRequest` from resolved settings (see `resolve`). A
    `""` body sends no `Content-Type`. Pure; exposed for testing.

    **Example**

    ```hot
    req ::firecrawl::api/build-request("POST", "/scrape", {url: "https://example.com"}, {
      api-key: "tenant-key",
      base-url: "https://api.firecrawl.dev/v2"
    })
    req.url  // "https://api.firecrawl.dev/v2/scrape"
    req.body  // "{\"url\":\"https://example.com\"}"
    ```
    """
}
fn (method: Str, path: Str, body: Any, resolved: Map): HttpRequest {
  auth {Authorization: `Bearer ${resolved.api-key}`}
  HttpRequest({
    method,
    url: `${resolved.base-url}${path}`,
    headers: if(eq(body, ""), auth, {...auth, Content-Type: "application/json"}),
    body: if(eq(body, ""), "", to-json(untype(body)))
  })
}

request
meta {
    doc: """
    Make an authenticated Firecrawl request. `path` is relative to the
    v2 base URL; pass `""` as `body` for requests without one. Returns
    the decoded JSON body on 2xx, an Err carrying `HttpError` otherwise,
    or the transport Err.

    **Example**

    ```hot
    body ::firecrawl::api/request("POST", "/scrape", {url: "https://example.com", formats: ["markdown"]})
    body.data.markdown

    // Act for another tenant, with its key from context
    ::firecrawl::api/request("GET", "/crawl/active", "", {api-key: ::hot::ctx/get("tenant.firecrawl.key")})
    ```
    """
}
fn
(method: Str, path: Str, body: Any): Any {
  request(method, path, body, {})
},
// 4-arity: explicit API key override
(method: Str, path: Str, body: Any, api-key: Str?): Any {
  request(method, path, body, {api-key: api-key})
},
// 4-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, body: Any, opts: Map): Any {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => {
      response ::hot::http/request(build-request(method, path, body, resolved))
      cond {
        is-err(response) => { response }
        is-ok-response(response) => { response.body }
        => { err(HttpError(response)) }
      }
    }
  }
}

job-path
meta {
    doc: """
    `/<kind>/<id>` with the id URL-encoded, plus an optional suffix (e.g.
    `"/errors"`). Exposed for testing.

    **Example**

    ```hot
    ::firecrawl::api/job-path("crawl", "abc")  // "/crawl/abc"
    ::firecrawl::api/job-path("batch/scrape", "abc", "/errors")  // "/batch/scrape/abc/errors"
    ```
    """
}
fn
(kind: Str, id: Str): Str {
  job-path(kind, id, "")
},
(kind: Str, id: Str, suffix: Str): Str {
  `/${kind}/${::uri/encode(id)}${suffix}`
}

body-with
meta {
    doc: """
    Merge caller `options` with the required fields (required fields win)
    and drop null values, so unset options are omitted rather than sent as
    JSON null. Exposed for testing.

    **Example**

    ```hot
    ::firecrawl::api/body-with({url: "https://example.com"}, {limit: 5, url: "ignored", webhook: null})
    // {url: "https://example.com", limit: 5}
    ```
    """
}
fn (required: Map, options: Map): Map {
  filter-vals({...options, ...required}, is-some)
}

// =============================================================================
// Pagination: crawl and batch-scrape results arrive in ~10MB pages
// =============================================================================

// Upper bound on followed `next` pages, as a guard against a cursor loop.
MAX_PAGES 1000

next-path
meta {
    doc: """
    The path to request for a status response's `next` URL, relative to
    `base-url` (default the v2 base URL), or null when there is no next
    page. A `next` that points anywhere other than that API root is never
    followed, so the API key is only ever sent there. Exposed for testing.

    **Example**

    ```hot
    ::firecrawl::api/next-path("https://api.firecrawl.dev/v2/crawl/abc?skip=10")  // "/crawl/abc?skip=10"
    ::firecrawl::api/next-path("https://other.example/crawl/abc")  // null
    ```
    """
}
fn
(next: Any): Any {
  next-path(next, ::firecrawl/BASE_URL)
},
(next: Any, base-url: Str): Any {
  prefix `${base-url}/`
  cond {
    not(is-str(next)) => { null }
    starts-with(next, prefix) => { slice(next, sub(length(prefix), 1)) }
    => { null }
  }
}

collect-pages
meta {
    doc: """
    Follow `next` from a crawl or batch-scrape status page, calling
    `fetch(path)` for each further page, and return the latest page's
    status fields with `data` holding every page's documents. Stops on
    the last page, on a running job's repeated empty cursor (keeping
    `next` so you can resume), or on an Err from `fetch` (returned).
    `base-url` (default the v2 base URL) is the only root it follows.
    Exposed for testing.

    **Example**

    ```hot
    pages {"/crawl/abc?skip=1": {status: "completed", data: [{n: 2}]}}
    page-one {status: "scraping", data: [{n: 1}], next: "https://api.firecrawl.dev/v2/crawl/abc?skip=1"}
    out ::firecrawl::api/collect-pages(page-one, (path) { get(pages, path) })
    out.status  // "completed"
    out.data  // [{n: 1}, {n: 2}]
    ```
    """
}
fn
(page: Map, fetch: Fn): Map {
  collect-pages(page, fetch, ::firecrawl/BASE_URL)
},
(page: Map, fetch: Fn, base-url: Str): Map {
  collect-loop(page, or(get(page, "data"), []), fetch, 0, base-url)
}

collect-loop
meta {no-doc: true}
fn (page: Map, docs: Vec, fetch: Fn, count: Int, base-url: Str): Map {
  path next-path(get(page, "next"), base-url)
  cond {
    is-null(path) => { {...page, data: docs} }
    gte(count, MAX_PAGES) => { {...page, data: docs} }
    => {
      next-page fetch(path)
      cond {
        is-err(next-page) => { next-page }
        // A running job repeats its cursor on an empty page until more
        // documents finish; stop and leave `next` for a later call.
        and(is-empty(or(get(next-page, "data"), [])), eq(get(next-page, "next"), get(page, "next"))) => {
          {...next-page, data: docs}
        }
        => {
          collect-loop(next-page, concat(docs, or(get(next-page, "data"), [])), fetch, add(count, 1), base-url)
        }
      }
    }
  }
}

get-all-pages
meta {
    doc: """
    `GET` a status path and follow `next` across the pages, with the
    credentials and API root from `opts`.

    **Example**

    ```hot
    ::api ::firecrawl::api

    job ::api/get-all-pages(::api/job-path("crawl", "0b5e6c1a-3d2f-4a7e-9c11-2f8a6d4b7e90"), {})
    length(job.data)
    ```
    """
}
fn (path: Str, opts: Map): Map {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => {
      request("GET", path, "", opts)
        |> if-ok((page) { collect-pages(page, (next) { request("GET", next, "", opts) }, resolved.base-url) })
    }
  }
}

// =============================================================================
// Job status
// =============================================================================

is-terminal
meta {
    doc: """
    True for a job status that will not change again: "completed", "failed",
    or "cancelled". Exposed for testing.

    **Example**

    ```hot
    ::firecrawl::api/is-terminal("completed")  // true
    ::firecrawl::api/is-terminal("scraping")  // false
    ```
    """
}
fn (status: Any): Bool {
  in(status, ["completed", "failed", "cancelled"])
}
