::ai::agent::lifecycle ns
meta {
    doc: """
    Reusable scheduled lifecycle helpers for AI agents.

    These functions keep scheduling mechanics and error handling generic while
    concrete agents provide memory construction, authorization, and compaction
    policy.
    """
}

::runtime ::ai::agent::runtime
::agent-memory ::ai::agent::memory

AgentRuntime ::runtime/AgentRuntime
Session ::ai::session/Session
AgentMemory ::ai::memory/AgentMemory
ChatOptions ::ai::chat/ChatOptions
RetentionPolicy ::agent-memory/RetentionPolicy

LifecycleJob
meta { doc: "Result record from a lifecycle job applied to one session." }
type {
    session-id: Str,
    action: Str,
    ok: Bool,
    result: Any?,
    error: Str?,
}

job-ok
meta {
    doc: """
    Build a successful LifecycleJob result.

    **Example**

    ```hot
    ::lifecycle ::ai::agent::lifecycle

    job ::lifecycle/job-ok(::ai::session/Session({id: "s1"}), "compact", {kept: 3})
    job.ok  // true
    job.session-id  // "s1"
    ```
    """
}
fn (session: Session, action: Str, result: Any?): LifecycleJob {
    LifecycleJob({
        session-id: session.id,
        action: action,
        ok: true,
        result: result,
        error: null,
    })
}

job-error
meta {
    doc: """
    Build a failed LifecycleJob result and record it in the runtime error
    log.

    **Example**

    ```hot
    ::lifecycle ::ai::agent::lifecycle
    ::runtime ::ai::agent::runtime

    rt ::runtime/create-runtime("team-agent")
    job ::lifecycle/job-error(rt, ::ai::session/Session({id: "s1"}), "compact", "store unavailable")
    job.error
    ```
    """
}
fn (rt: AgentRuntime, session: Session, action: Str, error: Any): LifecycleJob {
    msg Str(error)
    ::runtime/record-error(rt, action, msg)
    LifecycleJob({
        session-id: session.id,
        action: action,
        ok: false,
        result: null,
        error: msg,
    })
}

run-session-job
meta {
    doc: """
    Run `handler(session)` for every registered session and collect a
    `LifecycleJob` per session.

    Per-session recovery: whether a handler halts via `fail()` /
    `cancel()` or returns a `Result.Err` value, the error is captured
    and recorded on `rt.errors-store`, and the slot becomes
    `LifecycleJob.ok = false`. The loop always processes every session
    and always returns a uniform `Vec<LifecycleJob>` — halts never
    escape `run-session-job`.

    **Example**

    ```hot
    ::lifecycle ::ai::agent::lifecycle
    ::runtime ::ai::agent::runtime

    rt ::runtime/create-runtime("team-agent")
    jobs ::lifecycle/run-session-job(rt, "daily-recap", (session) {
        `recap for ${session.id}`
    })
    // A handler failure becomes ok: false on that session's job.
    filter(jobs, (job) { not(job.ok) })
    ```
    """
}
fn (rt: AgentRuntime, action: Str, handler: Fn): Vec<LifecycleJob> {
    sessions ::runtime/list-registered-sessions(rt)
    map(sessions, (session) {
        // Supervision boundary: lifecycle handlers are arbitrary user
        // code, so this is a sanctioned halt-containment point — one
        // session's fail() is recorded as a failed LifecycleJob without
        // aborting the fan-out. Application code should not copy this
        // pattern; expected failures are Result.Err values.
        attempt ::hot::internal::exec/contain(handler, [session])
        cond {
            is-ok(attempt) => {
                result attempt
                LifecycleJob({
                    session-id: session.id,
                    action: action,
                    ok: true,
                    result: result,
                    error: null,
                })
            }
            => {
                failure if-err(attempt, (failure) { failure })
                job-error(rt, session, action, failure)
            }
        }
    })
}

compact-stale-sessions
meta {
    doc: """
    Run an app-provided compaction handler for all registered sessions.

    **Example**

    ```hot
    ::lifecycle ::ai::agent::lifecycle
    ::runtime ::ai::agent::runtime

    rt ::runtime/create-runtime("team-agent")
    jobs ::lifecycle/compact-stale-sessions(rt, (session) {
        {compacted: session.id}
    })
    length(jobs)
    ```
    """
}
fn (rt: AgentRuntime, handler: Fn): Vec<LifecycleJob> {
    run-session-job(rt, "compact-stale-sessions", handler)
}

prune-raw-memory
meta {
    doc: """
    Prune raw session memory older than `policy.raw-retention-secs`; returns
    deleted count.

    **Example**

    ```hot
    ::lifecycle ::ai::agent::lifecycle
    ::session ::ai::session

    mem ::ai::memory/create-memory(
        "team-agent",
        ::session/Session({id: "slack:C123"}),
        ::session/Identity({id: "u1", name: "Ada", meta: {}})
    )
    policy ::ai::agent::memory/RetentionPolicy({name: "30-days", raw-retention-secs: 2592000})
    deleted ::lifecycle/prune-raw-memory(mem, policy)
    `pruned ${deleted} records`
    ```
    """
}
fn (mem: AgentMemory, policy: RetentionPolicy): Int {
    retention or(policy.raw-retention-secs, 0)
    cond {
        lte(retention, 0) => { 0 }
        => {
            cutoff sub(::runtime/now-epoch-secs(), retention)
            ::ai::memory/forget-session-range(mem, 0, cutoff)
        }
    }
}

prune-sessions
meta {
    doc: """
    Run an app-provided memory factory and prune handler for all registered
    sessions.

    **Example**

    ```hot
    ::lifecycle ::ai::agent::lifecycle
    ::runtime ::ai::agent::runtime

    rt ::runtime/create-runtime("team-agent")
    policy ::ai::agent::memory/RetentionPolicy({name: "30-days", raw-retention-secs: 2592000})
    owner ::ai::session/Identity({id: "team-agent", name: "Team Agent", meta: {}})
    jobs ::lifecycle/prune-sessions(rt, policy, (session) {
        ::ai::memory/create-memory("team-agent", session, owner)
    })
    map(jobs, %.result)
    ```
    """
}
fn (rt: AgentRuntime, policy: RetentionPolicy, memory-for-session: Fn): Vec<LifecycleJob> {
    run-session-job(rt, "prune-raw-memory", (session) {
        mem memory-for-session(session)
        prune-raw-memory(mem, policy)
    })
}

schedule-descriptor
meta {
    doc: """
    Return a neutral descriptor agents can attach to scheduled lifecycle
    functions.

    **Example**

    ```hot
    descriptor ::ai::agent::lifecycle/schedule-descriptor("nightly-prune", "0 3 * * *", "prune-raw-memory")
    descriptor.cron  // "0 3 * * *"
    descriptor.action  // "prune-raw-memory"
    ```
    """
}
fn (name: Str, cron: Str, action: Str): Map {
    {
        name: name,
        cron: cron,
        action: action,
    }
}
