::stripe::customers ns
meta {
    doc: """Customers: create, retrieve, update, delete, list, and search. See https://docs.stripe.com/api/customers."""
}

api-call ::stripe::api/call
seg ::stripe::api/encode-id
RequestOptions ::stripe::api/RequestOptions

// ============================================================================
// Customers
// ============================================================================

CreateCustomerRequest type {
  name: Str?,
  email: Str?,
  phone: Str?,
  description: Str?,
  address: Map?,
  shipping: Map?,
  metadata: Map?,
  payment_method: Str?,
  invoice_settings: Map?,
  tax: Map?,
  tax_exempt: Str?,
  tax_id_data: Vec<Map>?,
  preferred_locales: Vec<Str>?,
  test_clock: Str?,
  expand: Vec<Str>?
}

create-customer
meta {
    doc: """
POST /v1/customers - Create a customer. Pass `RequestOptions({idempotency_key: ...})` to make a retried signup safe.

**Example**

```hot
::customers ::stripe::customers

customer ::customers/create-customer(::customers/CreateCustomerRequest({
  name: "Alice Smith",
  email: "alice@example.com",
  metadata: {user_id: "42"}
}))
customer.id  // => "cus_..."
```
"""
}
fn
(request: CreateCustomerRequest): Map {
  create-customer(request, RequestOptions({}))
},
(request: CreateCustomerRequest, options: RequestOptions): Map {
  api-call("POST", "/v1/customers", request, options)
}

get-customer
meta {
    doc: """GET /v1/customers/{customer} - Retrieve a customer by ID. Optional `params` such as `{expand: ["invoice_settings.default_payment_method"]}`. A deleted customer comes back as `{id, object: "customer", deleted: true}`."""
}
fn
(customer: Str): Map {
  get-customer(customer, {})
},
(customer: Str, params: Map): Map {
  api-call("GET", `/v1/customers/${seg(customer)}`, params)
}

UpdateCustomerRequest type {
  name: Str?,
  email: Str?,
  phone: Str?,
  description: Str?,
  address: Map?,
  shipping: Map?,
  metadata: Map?,
  default_source: Str?,
  invoice_settings: Map?,
  tax: Map?,
  tax_exempt: Str?,
  preferred_locales: Vec<Str>?,
  expand: Vec<Str>?
}

update-customer
meta {
    doc: """POST /v1/customers/{customer} - Update a customer. Only the fields you provide are changed. To set the default card for subscriptions and invoices, pass `invoice_settings: {default_payment_method: "pm_..."}`."""
}
fn
(customer: Str, request: UpdateCustomerRequest): Map {
  update-customer(customer, request, RequestOptions({}))
},
(customer: Str, request: UpdateCustomerRequest, options: RequestOptions): Map {
  api-call("POST", `/v1/customers/${seg(customer)}`, request, options)
}

delete-customer
meta {
    doc: """DELETE /v1/customers/{customer} - Permanently delete a customer. Cancels any active subscriptions. Returns `{id, object: "customer", deleted: true}`."""
}
fn (customer: Str): Map {
  api-call("DELETE", `/v1/customers/${seg(customer)}`)
}

ListCustomersRequest type {
  email: Str?,
  created: Any?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  test_clock: Str?,
  expand: Vec<Str>?
}

list-customers
meta {
    doc: """
GET /v1/customers - List customers, most recent first. Filter by `email` (exact, case-sensitive match) or `created`. Paginate with `limit` (1-100) and `starting_after`, or use `::stripe::api/list-all("/v1/customers", params)` to fetch every page.

**Example**

```hot
::customers ::stripe::customers

page ::customers/list-customers(::customers/ListCustomersRequest({limit: 10}))
page.data      // => [{id: "cus_...", ...}, ...]
page.has_more  // => true
```
"""
}
fn
(): Map {
  list-customers(ListCustomersRequest({}))
},
(request: ListCustomersRequest): Map {
  api-call("GET", "/v1/customers", request)
}

search-customers
meta {
    doc: """
GET /v1/customers/search - Search customers with Stripe's search query language, e.g. `email:"alice@example.com"` or `metadata["user_id"]:"42"`. Returns `{object: "search_result", data, has_more, next_page}`; pass `next_page` back as `page` in `params`. Search results can lag writes by about a minute. See https://docs.stripe.com/search#query-fields-for-customers.
"""
}
fn
(query: Str): Map {
  search-customers(query, {})
},
(query: Str, params: Map): Map {
  api-call("GET", "/v1/customers/search", {...params, query: query})
}
