::sumsub::sdk ns
meta {
    doc: """
    Hosted verification: short-lived access tokens for the WebSDK and
    MobileSDK, and shareable WebSDK links (permalinks) that open
    Sumsub's hosted verification page for one user.

    Use `create-access-token` when your frontend embeds the WebSDK (it
    calls back for a fresh token on expiry), and `create-websdk-link`
    when you want to send the user a URL (email, SMS, redirect).
    """
}

::api ::sumsub::api
::ctx ::hot::ctx

query ::sumsub::api/query

// Sumsub's defaults, stated here so callers can see them.
DEFAULT_TOKEN_TTL_SECONDS 600
DEFAULT_LINK_TTL_SECONDS 1800
MAX_LINK_TTL_SECONDS 2592000

mark-returned
meta {
    doc: """
    Mask the bearer credential at `key` of a response in call records and
    return the response unchanged. An Err passes through. Exposed for
    testing.

    **Example**

    ```hot
    response ::sumsub::api/request("POST", "/resources/accessTokens/sdk", {
      userId: "user-42",
      levelName: "basic-kyc-level"
    })
    out ::sumsub::sdk/mark-returned(response, "token")
    out.token
    ```
    """
}
fn (response: Result, key: Str): Any {
  cond {
    is-err(response) => { response }
    => {
      value if(is-map(response), get(response, key), null)
      if(is-str(value), ::ctx/mark-secret(value))
      response
    }
  }
}

access-token-request
meta {
    doc: """
    The spec for `POST /resources/accessTokens/sdk`. `options` takes
    `ttlInSecs` (Sumsub default 600), `applicantIdentifiers` (`{email,
    phone}`, prefilled in the SDK) and `externalActionId` (for applicant
    actions). Unset options are dropped. Exposed for testing.

    **Example**

    ```hot
    spec ::sumsub::sdk/access-token-request("user-42", "basic-kyc-level", {ttlInSecs: 1200})
    spec.path  // "/resources/accessTokens/sdk"
    spec.body  // {userId: "user-42", levelName: "basic-kyc-level", ttlInSecs: 1200}
    ```
    """
}
fn (user-id: Str, level-name: Str, options: Map): Map {
  {
    method: "POST",
    path: "/resources/accessTokens/sdk",
    body: ::api/compact({
      userId: user-id,
      levelName: level-name,
      ttlInSecs: get(options, "ttlInSecs"),
      applicantIdentifiers: get(options, "applicantIdentifiers"),
      externalActionId: get(options, "externalActionId")
    })
  }
}

create-access-token
meta {
    doc: """
    Generate a WebSDK/MobileSDK access token for your user (`userId` is
    your `externalUserId`; the applicant is created on first use).
    Returns `{token, userId}`. Tokens are bearer credentials for that
    user's verification: hand them only to that user's session. The token
    is masked in call records.

    **Example**

    ```hot
    out ::sumsub::sdk/create-access-token("user-42", "basic-kyc-level", {ttlInSecs: 1200})
    out.token
    ```
    """
}
fn
(user-id: Str, level-name: Str): Map {
  create-access-token(user-id, level-name, {}, {})
},
(user-id: Str, level-name: Str, options: Map): Map {
  create-access-token(user-id, level-name, options, {})
},
(user-id: Str, level-name: Str, options: Map, opts: Map): Map {
  mark-returned(::api/call(access-token-request(user-id, level-name, options), opts), "token")
}

LINK_QUERY_KEYS ["lang", "customizationName", "translationName", "source"]

websdk-link-request
meta {
    doc: """
    The spec for `POST /resources/sdkIntegrations/levels/-/websdkLink`.
    `options` takes body fields `userId` (your `externalUserId`),
    `ttlInSecs` (Sumsub default 1800, max 2592000), `externalActionId`,
    `applicantIdentifiers` (`{email, phone}`) and `redirect`
    (`{successUrl, rejectUrl, signKey?, allowedQueryParams?}`), and query
    options `lang`, `customizationName`, `translationName` and `source`.
    Unset options are dropped. Exposed for testing.

    **Example**

    ```hot
    spec ::sumsub::sdk/websdk-link-request("basic-kyc-level", {userId: "user-42", lang: "en"})
    spec.path  // "/resources/sdkIntegrations/levels/-/websdkLink?lang=en"
    spec.body  // {userId: "user-42", levelName: "basic-kyc-level"}
    ```
    """
}
fn (level-name: Str, options: Map): Map {
  opts untype(options)
  query-opts filter-keys(opts, (k) { in(k, LINK_QUERY_KEYS) })
  body-opts filter-keys(opts, (k) { not(in(k, LINK_QUERY_KEYS)) })
  {
    method: "POST",
    path: `/resources/sdkIntegrations/levels/-/websdkLink${query(query-opts)}`,
    body: ::api/compact({...body-opts, levelName: level-name})
  }
}

create-websdk-link
meta {
    doc: """
    Create a hosted verification link for one user. Returns `{url}`.
    Anyone holding the URL can continue that user's verification until it
    expires, so send it only to the user. The URL is masked in call
    records.

    **Example**

    ```hot
    link ::sumsub::sdk/create-websdk-link("basic-kyc-level", {
      userId: "user-42",
      ttlInSecs: 86400,
      lang: "en",
      redirect: {successUrl: "https://app.example.com/kyc/done"}
    })
    link.url
    ```
    """
}
fn
(level-name: Str, options: Map): Map {
  create-websdk-link(level-name, options, {})
},
(level-name: Str, options: Map, opts: Map): Map {
  sign-key get-in(untype(options), ["redirect", "signKey"])
  if(is-str(sign-key), ::ctx/mark-secret(sign-key))
  mark-returned(::api/call(websdk-link-request(level-name, options), opts), "url")
}
