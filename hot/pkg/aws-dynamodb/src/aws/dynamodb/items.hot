::aws::dynamodb::items ns

// DynamoDB item operations

HttpResponse ::hot::http/HttpResponse
is-ok-response ::hot::http/is-ok-response

resolve ::aws::core/resolve
send-signed ::aws::core/send-signed
service-url ::aws::core/service-url
AwsError ::aws::core/AwsError

// Put item response
PutItemResponse type {
    attributes: Map?,
    consumed_capacity: Map?
}

// Get item response
GetItemResponse type {
    item: Map?,
    consumed_capacity: Map?
}

// Delete item response
DeleteItemResponse type {
    attributes: Map?,
    consumed_capacity: Map?
}

// Update item response
UpdateItemResponse type {
    attributes: Map?,
    consumed_capacity: Map?
}

// Put an item into a DynamoDB table
put-item
meta {
    doc: """
    Put an item into a DynamoDB table. Item should use DynamoDB attribute value format.

    **Example**

    ```hot
    item {
        pk: {S: "user-123"},
        sk: {S: "profile"},
        name: {S: "Alice"},
        age: {N: "30"}
    }

    result ::aws::dynamodb::items/put-item("my-table", item)
    ```
    """
}
fn
(table_name: Str, item: Map, condition_expression: Str?, expression_attribute_values: Map, opts: Map): PutItemResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${service-url(resolved, "dynamodb")}/`

        request-body {
            TableName: table_name,
            Item: item
        }

        with-condition cond {
            is-null(condition_expression) => { request-body }
            => { {...request-body,
                ConditionExpression: condition_expression,
                ExpressionAttributeValues: expression_attribute_values} }
        }

        body to-json(with-condition)

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "DynamoDB_20120810.PutItem"
        }

        response send-signed("POST", url, "dynamodb", resolved, headers, body)

        cond {
            is-ok-response(response) => { PutItemResponse({
                attributes: response.body.Attributes,
                consumed_capacity: response.body.ConsumedCapacity
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(table_name: Str, item: Map, opts: Map): PutItemResponse | AwsError {
    put-item(table_name, item, null, null, opts)
},
(table_name: Str, item: Map, condition_expression: Str?, expression_attribute_values: Map): PutItemResponse | AwsError {
    put-item(table_name, item, condition_expression, expression_attribute_values, {})
},
(table_name: Str, item: Map): PutItemResponse | AwsError {
    put-item(table_name, item, null, null)
}

// Get an item from a DynamoDB table
get-item
meta {
    doc: """
    Get an item from a DynamoDB table by its primary key.

    **Example**

    ```hot
    key {pk: {S: "user-123"}, sk: {S: "profile"}}
    result ::aws::dynamodb::items/get-item("my-table", key)
    result.item.name.S  // => "Alice"
    result.item.age.N   // => "30"
    ```
    """
}
fn
(table_name: Str, key: Map, consistent_read: Bool, projection_expression: Str?, opts: Map): GetItemResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${service-url(resolved, "dynamodb")}/`

        request-body {
            TableName: table_name,
            Key: key,
            ConsistentRead: consistent_read
        }

        with-projection merge(request-body, filter-vals({
            ProjectionExpression: projection_expression
        }, is-some))

        body to-json(with-projection)

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "DynamoDB_20120810.GetItem"
        }

        response send-signed("POST", url, "dynamodb", resolved, headers, body)

        cond {
            is-ok-response(response) => { GetItemResponse({
                item: response.body.Item,
                consumed_capacity: response.body.ConsumedCapacity
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(table_name: Str, key: Map, consistent_read: Bool, opts: Map): GetItemResponse | AwsError {
    get-item(table_name, key, consistent_read, null, opts)
},
(table_name: Str, key: Map, opts: Map): GetItemResponse | AwsError {
    get-item(table_name, key, false, null, opts)
},
(table_name: Str, key: Map, consistent_read: Bool, projection_expression: Str?): GetItemResponse | AwsError {
    get-item(table_name, key, consistent_read, projection_expression, {})
},
(table_name: Str, key: Map, consistent_read: Bool): GetItemResponse | AwsError {
    get-item(table_name, key, consistent_read, null)
},
(table_name: Str, key: Map): GetItemResponse | AwsError {
    get-item(table_name, key, false, null)
}

// Delete an item from a DynamoDB table
delete-item
meta {
    doc: """
    Delete an item from a DynamoDB table by its primary key.

    **Example**

    ```hot
    key {pk: {S: "user-123"}, sk: {S: "profile"}}
    ::aws::dynamodb::items/delete-item("my-table", key)
    ```
    """
}
fn
(table_name: Str, key: Map, condition_expression: Str?, expression_attribute_values: Map, opts: Map): DeleteItemResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${service-url(resolved, "dynamodb")}/`

        request-body {
            TableName: table_name,
            Key: key
        }

        with-condition cond {
            is-null(condition_expression) => { request-body }
            => { {...request-body,
                ConditionExpression: condition_expression,
                ExpressionAttributeValues: expression_attribute_values} }
        }

        body to-json(with-condition)

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "DynamoDB_20120810.DeleteItem"
        }

        response send-signed("POST", url, "dynamodb", resolved, headers, body)

        cond {
            is-ok-response(response) => { DeleteItemResponse({
                attributes: response.body.Attributes,
                consumed_capacity: response.body.ConsumedCapacity
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(table_name: Str, key: Map, opts: Map): DeleteItemResponse | AwsError {
    delete-item(table_name, key, null, null, opts)
},
(table_name: Str, key: Map, condition_expression: Str?, expression_attribute_values: Map): DeleteItemResponse | AwsError {
    delete-item(table_name, key, condition_expression, expression_attribute_values, {})
},
(table_name: Str, key: Map): DeleteItemResponse | AwsError {
    delete-item(table_name, key, null, null)
}

// Update an item in a DynamoDB table
update-item
meta {
    doc: """
    Update an item in a DynamoDB table using update expressions.

    Returns the updated attributes (ALL_NEW).

    **Example**

    ```hot
    key {pk: {S: "user-123"}, sk: {S: "profile"}}
    result ::aws::dynamodb::items/update-item(
        "my-table",
        key,
        "SET hit_count = hit_count + :inc, updated_at = :now",
        {":inc": {N: "1"}, ":now": {S: "2026-02-16"}}
    )
    result.attributes.hit_count.N  // => "1"
    ```
    """
}
fn
(table_name: Str, key: Map, update_expression: Str, expression_attribute_values: Map, expression_attribute_names: Map, opts: Map): UpdateItemResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${service-url(resolved, "dynamodb")}/`

        request-body {
            TableName: table_name,
            Key: key,
            UpdateExpression: update_expression,
            ExpressionAttributeValues: expression_attribute_values,
            ReturnValues: "ALL_NEW"
        }

        with-names merge(request-body, filter-vals({
            ExpressionAttributeNames: expression_attribute_names
        }, is-some))

        body to-json(with-names)

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "DynamoDB_20120810.UpdateItem"
        }

        response send-signed("POST", url, "dynamodb", resolved, headers, body)

        cond {
            is-ok-response(response) => { UpdateItemResponse({
                attributes: response.body.Attributes,
                consumed_capacity: response.body.ConsumedCapacity
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(table_name: Str, key: Map, update_expression: Str, expression_attribute_values: Map, expression_attribute_names: Map): UpdateItemResponse | AwsError {
    update-item(table_name, key, update_expression, expression_attribute_values, expression_attribute_names, {})
},
(table_name: Str, key: Map, update_expression: Str, expression_attribute_values: Map): UpdateItemResponse | AwsError {
    update-item(table_name, key, update_expression, expression_attribute_values, null)
}
