::cal-com ns
meta {
    doc: """
    Cal.com API v2 bindings: event types, availability (schedules and
    slots), bookings through their whole lifecycle, the authenticated
    profile, and webhooks with signature verification. The scheduling
    half of a sales or assistant agent: find a lead, log it to the CRM,
    book the meeting.

    - `::cal-com::event-types` creates, lists, updates and deletes event types
    - `::cal-com::slots` finds bookable start times
    - `::cal-com::bookings` creates, lists (paged and filtered), confirms,
      declines, cancels, reschedules and marks no-shows
    - `::cal-com::schedules` manages working hours and date overrides
    - `::cal-com::users` reads and updates the API key's own profile
    - `::cal-com::webhooks` verifies `X-Cal-Signature-256` and manages
      user-level and event-type webhooks
    - `::cal-com::api/request` is the escape hatch for anything else

    **Setup**: context variable `cal-com.api.key` (`cal_...` from
    Settings → Developer → API keys). Works with cal.com cloud and
    self-hosted instances (`cal-com.url` overrides the base URL). Cal.com
    v2 versions each endpoint family separately; every call pins the
    matching `cal-api-version` header (see the `VERSION_*` constants), so
    a self-hosted instance must be recent enough to serve them.

    Every API-calling function also takes a trailing `opts` Map for
    per-call credentials and settings; see `::cal-com::api`.

    **Quick start**

    ```hot
    ::types ::cal-com::event-types
    ::slots ::cal-com::slots
    ::bookings ::cal-com::bookings

    event-type first(::types/list-event-types())

    open ::slots/get-slots(event-type.id, "2026-07-10", "2026-07-14", "America/Chicago")

    booking ::bookings/create-booking({
      eventTypeId: event-type.id,
      start: "2026-07-10T15:00:00Z",
      attendee: {name: "Ada Lovelace", email: "ada@example.com", timeZone: "America/Chicago"}
    })
    ```
    """
}

DEFAULT_BASE_URL "https://api.cal.com/v2"

// Cal.com v2 versions each endpoint family independently via the
// cal-api-version header. Without it (or with another family's value)
// an endpoint falls back to a legacy response shape. Current values are
// documented per endpoint at https://cal.com/docs/api-reference/v2 and in
// the OpenAPI spec (docs/api-reference/v2/openapi.json in calcom/cal.com).
// Webhooks, /me and other unversioned families take no header.
VERSION_EVENT_TYPES "2024-06-14"
VERSION_SLOTS "2024-09-04"
VERSION_BOOKINGS "2024-08-13"
VERSION_SCHEDULES "2024-06-11"
