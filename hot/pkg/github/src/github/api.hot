::github::api ns
meta {
    ctx: {"github.token": {required: false}},
    doc: """
    Transport for the GitHub REST API.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then the `github.token` context variable, then the defaults.
    Nothing from `opts` is written to ctx, so one run can act for many
    tenants and parallel flows don't share credentials.

    - `token`: a PAT or installation token for this call
    - `app-id`, `private-key`, `installation-id`: act as a GitHub App
      installation. The token is minted once and cached for the run by
      `::github::app/cached-installation-token`.
    - `base-url`: another API root, such as GitHub Enterprise Server's
      `https://ghe.example.com/api/v3`. It needs a credential in the same
      `opts`: `github.token` is never sent to a per-call URL.
    - `api-version`: the `X-GitHub-Api-Version` for this call

    When `opts` has a `token` or App identity, `github.token` is ignored
    for that call. A token in `opts` wins over an App identity. One of
    those keys present but blank or null is an error, never a fallback to
    `github.token`.
    """
}

::ctx ::hot::ctx
::uri ::hot::uri
::re ::hot::regex

http-request ::hot::http/request
is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError type {
    status: Int,
    headers: Map,
    body: Any
}

GitHubResponse type {
    status: Int,
    headers: Map,
    data: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: or(response.headers, {}),
    body: response.body
  })
}

github-response
meta {no-doc: true}
fn (response: HttpResponse): GitHubResponse {
  GitHubResponse({
    status: response.status,
    headers: or(response.headers, {}),
    data: json-response-body(response)
  })
}

present
meta {
    doc: """
    `value` with surrounding whitespace removed when it's a Str, null when
    it's blank or null. Ids may be Ints and pass through.

    **Example**

    ```hot
    ::github::api/present("  acme  ")  // "acme"
    ::github::api/present("   ")  // null
    ::github::api/present(42)  // 42
    ```
    """
}
fn (value: Any): Any {
  cond {
    is-str(value) => {
      trimmed trim(value)
      if(is-empty(trimmed), null, trimmed)
    }
    => { value }
  }
}

CREDENTIAL_KEYS ["token", "app-id", "private-key", "installation-id"]

blank-credential
meta {
    doc: """
    The first of `names` that `opts` has but with a blank or null value,
    else null. Such a key is an error, never a fallback to context: a tenant
    whose key is missing must not run on the project's credentials.

    **Example**

    ```hot
    ::github::api/blank-credential({token: ""}, ["token", "app-id"])  // "token"
    ::github::api/blank-credential({token: "test-token"}, ["token", "app-id"])  // null
    ```
    """
}
fn (opts: Map, names: Vec): Str? {
  find-first(names, (name) { and(in(name, keys(opts)), is-null(present(get(opts, name)))) })
}

settings-from
meta {
    doc: """
    The non-credential settings of a call (pure): `{base-url, api-version}`
    from `opts`, else the package defaults. `base-url` loses any trailing
    slash.

    **Example**

    ```hot
    settings ::github::api/settings-from({base-url: "https://ghe.example.com/api/v3/"})
    settings.base-url  // "https://ghe.example.com/api/v3"
    settings.api-version  // "2026-03-10"
    ```
    """
}
fn (opts: Map): Map {
  base-url or(present(get(opts, "base-url")), ::github/BASE_URL)
  {
    base-url: ::re/replace-all(base-url, "/+$", ""),
    api-version: or(present(get(opts, "api-version")), ::github/API_VERSION)
  }
}

resolve-from
meta {
    doc: """
    The one resolver, pure: credentials and settings for a call from
    `opts` first, then `ctx-values` (a Map of context variables), then
    defaults. Returns `{token, base-url, api-version}`, or
    `{app: {app-id, private-key, installation-id}, base-url, api-version}`
    for a GitHub App identity that `resolve` still has to exchange for a
    token. An Err when there is no credential, the App identity is
    incomplete, a credential key in `opts` is blank or null, or `opts` has
    `base-url` without a credential. Exposed for testing; `resolve` feeds it the context.

    **Example**

    ```hot
    ::github::api/resolve-from({token: "test-token"}, {}).token  // "test-token"
    ::github::api/resolve-from({}, {"github.token": "ctx-token"}).token  // "ctx-token"
    is-err(::github::api/resolve-from({token: ""}, {"github.token": "ctx-token"}))  // true
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  token present(get(opts, "token"))
  app-id present(get(opts, "app-id"))
  private-key present(get(opts, "private-key"))
  installation-id present(get(opts, "installation-id"))
  ctx-token present(get(ctx-values, "github.token"))
  settings settings-from(opts)
  has-app or(is-some(app-id), is-some(private-key), is-some(installation-id))
  blank blank-credential(opts, CREDENTIAL_KEYS)
  cond {
    is-some(blank) => {
      err(`github: ${blank} is in the call's opts but is blank or null. Pass a value, or leave ${blank} out to use github.token.`)
    }

    is-some(token) => { {...settings, token: token} }
    and(has-app, or(is-null(app-id), is-null(private-key), is-null(installation-id))) => {
      err("github: a GitHub App identity needs app-id, private-key and installation-id in the call's opts.")
    }

    has-app => { {...settings, app: {app-id: app-id, private-key: private-key, installation-id: installation-id}} }
    is-some(present(get(opts, "base-url"))) => {
      err("github: base-url is in the call's opts without token (or app-id, private-key and installation-id). Pass a credential with it. Context credentials are never sent to a per-call URL.")
    }

    is-some(ctx-token) => { {...settings, token: ctx-token} }
    => { err("github: github.token is not set. Add it in Context Variables, or pass {token: ...} or {app-id, private-key, installation-id} in the call's opts.") }
  }
}

resolve
meta {
    ctx: {"github.token": {required: false}},
    doc: """
    Credentials and settings for one call (see `resolve-from`): returns
    `{token, base-url, api-version}` or an Err. A GitHub App identity in
    `opts` is exchanged for an installation token here, cached by a hash
    of the identity. `opts` values are never written to ctx. The token, the
    private key and a token minted from them are masked in the run's call
    records.

    **Example**

    ```hot
    ::github::api/resolve({token: "ghp_tenant_b"}).api-version  // "2026-03-10"
    ```
    """
}
fn (opts: Map): Map {
  ::ctx/mark-secret([opts.token, opts.private-key])
  resolved resolve-from(opts, {"github.token": ::ctx/get("github.token")})
  cond {
    is-err(resolved) => { resolved }
    is-some(get(resolved, "app")) => {
      token ::github::app/cached-installation-token(resolved.app, resolved)
      if(is-err(token), token, {base-url: resolved.base-url, api-version: resolved.api-version, token: token})
    }
    => { resolved }
  }
}

build-request
meta {
    doc: """
    The outgoing `HttpRequest` from resolved settings (see `resolve`).
    `additional-headers` win over the defaults, and a `""` body sends no
    `Content-Type`. Pure; exposed for testing.

    **Example**

    ```hot
    resolved {token: "test-token", base-url: "https://api.github.com", api-version: "2026-03-10"}
    req ::github::api/build-request("GET", "/user", {}, "", resolved)
    req.url  // "https://api.github.com/user"
    req.headers.Authorization  // "Bearer test-token"
    ```
    """
}
fn (method: Str, path: Str, additional-headers: Map, body: Any, resolved: Map): HttpRequest {
  default-headers {
    Authorization: `Bearer ${resolved.token}`,
    Accept: "application/vnd.github+json",
    X-GitHub-Api-Version: resolved.api-version,
    User-Agent: "hot-dev-github-pkg"
  }

  headers if(eq(body, ""), default-headers, {...default-headers, Content-Type: "application/json"})
  final-headers {...headers, ...additional-headers}

  encoded-body if(eq(body, ""), "", to-json(untype(body)))
  HttpRequest({
    method,
    url: `${resolved.base-url}${path}`,
    headers: final-headers,
    body: encoded-body
  })
}

request
meta {
    doc: """
    Make an authenticated request to the GitHub REST API. `path` is
    relative to api.github.com (e.g. `/repos/hot-dev/hot/issues`). Sends
    the standard `Accept`, `X-GitHub-Api-Version`, and `User-Agent`
    headers (GitHub rejects requests without a User-Agent).

    **Example**

    ```hot
    response ::github::api/request("GET", "/user")
    response.body.login

    // Per-call credentials
    other ::github::api/request("GET", "/user", {}, "", {token: "ghp_tenant_b"})
    ```
    """
}
fn
(method: Str, path: Str): HttpResponse {
  request(method, path, {}, "")
},
(method: Str, path: Str, additional-headers: Map): HttpResponse {
  request(method, path, additional-headers, "")
},
(method: Str, path: Str, additional-headers: Map, body: Any): HttpResponse {
  request(method, path, additional-headers, body, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any, token: Str): HttpResponse {
  ::ctx/mark-secret(token)
  ::hot::http/request(build-request(method, path, additional-headers, body, {...settings-from({}), token: token}))
},
// 5-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { ::hot::http/request(build-request(method, path, additional-headers, body, resolved)) }
  }
}

json-response-body
meta {no-doc: true}
fn (response: HttpResponse): Any {
  match response.status {
    204 | 205 => { null }
    => { response.body }
  }
}

json-response
meta {
    doc: """
    Like `json`, but preserve successful response metadata as
    `GitHubResponse({status, headers, data})`. Use this when an agent needs
    pagination links, request ids, or rate-limit headers.

    **Example**

    ```hot
    ::api ::github::api

    page ::api/json-response("GET", "/repos/acme/api/issues?per_page=100")
    length(page.data)
    get(page.headers, "x-ratelimit-remaining")

    // Walk to the following page, or null on the last one
    ::api/next-page(page)
    ```
    """
}
fn
(method: Str, path: Str): GitHubResponse {
  json-response(method, path, {}, "")
},
(method: Str, path: Str, additional-headers: Map, body: Any): GitHubResponse {
  response request(method, path, additional-headers, body)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { github-response(response) }
    => { err(HttpError(response)) }
  }
},
// 5-arity: explicit token override (App JWTs, installation tokens)
(method: Str, path: Str, additional-headers: Map, body: Any, token: Str): GitHubResponse {
  response request(method, path, additional-headers, body, token)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { github-response(response) }
    => { err(HttpError(response)) }
  }
},
// 5-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): GitHubResponse {
  response request(method, path, additional-headers, body, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { github-response(response) }
    => { err(HttpError(response)) }
  }
}

json
meta {
    doc: """
    Like `request`, but unwraps: returns the decoded JSON body on 2xx, null
    for a no-content response, or an Err carrying `HttpError`. The shape
    used by all github endpoint functions.

    **Example**

    ```hot
    me ::github::api/json("GET", "/user")
    me.login

    // A POST with a JSON body, for one tenant
    issue ::github::api/json("POST", "/repos/acme/api/issues", {}, {title: "Timeout"}, {token: ::hot::ctx/get("acme.github-token")})
    issue.number
    ```
    """
}
fn
(method: Str, path: Str): Any {
  json(method, path, {}, "")
},
(method: Str, path: Str, additional-headers: Map, body: Any): Any {
  response request(method, path, additional-headers, body)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { json-response-body(response) }
    => { err(HttpError(response)) }
  }
},
// 5-arity: explicit token override (App JWTs, installation tokens)
(method: Str, path: Str, additional-headers: Map, body: Any, token: Str): Any {
  response request(method, path, additional-headers, body, token)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { json-response-body(response) }
    => { err(HttpError(response)) }
  }
},
// 5-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): Any {
  response request(method, path, additional-headers, body, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { json-response-body(response) }
    => { err(HttpError(response)) }
  }
}

link-url
meta {
    doc: """
    Extract one relation URL (for example `"next"`) from a GitHub `link`
    response header. Returns null when the relation is absent.

    **Example**

    ```hot
    headers {link: `<https://api.github.com/repos/acme/api/issues?page=9>; rel="last"`}
    ::github::api/link-url(headers, "last")  // "https://api.github.com/repos/acme/api/issues?page=9"
    ::github::api/link-url(headers, "next")  // null
    ```
    """
}
fn (headers: Map, relation: Str): Str? {
  value or(get(headers, "link"), get(headers, "Link"), "")
  candidate find-first(
    split(value, ","),
    (part) { contains(part, `rel="${relation}"`) }
  )

  match candidate {
    Null => { null }
    Str => {
      first(split(trim(candidate), ">")) |> slice(1)
    }
  }
}

next-page-path
meta {
    doc: """
    Return the relative API path from a GitHub response's `rel="next"` link,
    or null on the final page. Rejects pagination links outside `base-url`
    (api.github.com by default).

    **Example**

    ```hot
    headers {link: `<https://api.github.com/repos/acme/api/issues?page=2>; rel="next"`}
    ::github::api/next-page-path(headers)  // "/repos/acme/api/issues?page=2"
    ::github::api/next-page-path({})  // null
    ```
    """
}
fn
(headers: Map): Str? {
  next-page-path(headers, ::github/BASE_URL)
},
(headers: Map, base-url: Str): Str? {
  url link-url(headers, "next")
  match url {
    Null => { null }
    Str => {
      if(
        starts-with(url, `${base-url}/`),
        slice(url, length(base-url)),
        err(`GitHub pagination link is outside ${base-url}: ${url}`)
      )
    }
  }
}

// `auth` is null (context), an explicit token Str, or an opts Map.
auth-base-url
meta {no-doc: true}
fn (auth: Any): Str {
  if(is-map(auth), settings-from(auth).base-url, ::github/BASE_URL)
}

fetch-page
meta {no-doc: true}
fn (path: Str, auth: Any): GitHubResponse {
  if(is-null(auth), json-response("GET", path), json-response("GET", path, {}, "", auth))
}

next-page-with-token
meta {no-doc: true}
fn (response: GitHubResponse, auth: Any): GitHubResponse? {
  path next-page-path(response.headers, auth-base-url(auth))
  cond {
    is-err(path) => { path }
    is-null(path) => { null }
    => { fetch-page(path, auth) }
  }
}

next-page
meta {
    doc: """
    Fetch the next page represented by a `GitHubResponse`, preserving the next
    response's metadata. Returns null when the supplied page is the last one.
    Pass an explicit token or the same `opts` Map as the second argument when
    the first page used one. A pagination link outside the API root is an Err.

    **Example**

    ```hot
    ::api ::github::api

    first-page ::api/json-response("GET", "/repos/acme/api/pulls?per_page=100")
    second-page ::api/next-page(first-page)
    if(is-null(second-page), [], second-page.data)
    ```
    """
}
fn
(response: GitHubResponse): GitHubResponse? {
  next-page-with-token(response, null)
},
(response: GitHubResponse, token: Str): GitHubResponse? {
  next-page-with-token(response, token)
},
(response: GitHubResponse, opts: Map): GitHubResponse? {
  next-page-with-token(response, opts)
}

collect-list-pages
meta {no-doc: true}
fn (path: Str, accumulated: Vec, auth: Any): Vec {
  page fetch-page(path, auth)
  cond {
    is-err(page) => { page }
    => {
      items match page.data {
        Null => { [] }
        Vec => { page.data }
        => { err("GitHub paginate-list expected a Vec response body") }
      }

      combined concat(accumulated, items)
      next next-page-path(page.headers, auth-base-url(auth))

      cond {
        is-err(next) => { next }
        is-null(next) => { combined }
        => { collect-list-pages(next, combined, auth) }
      }
    }
  }
}

paginate-list
meta {
    doc: """
    Fetch every page for an endpoint whose body is a Vec. Pagination follows
    GitHub's `link` header serially. Prefer manual `json-response`/`next-page`
    when the result may be very large. Pass an explicit token or an `opts` Map
    as the second argument for a per-call identity.

    **Example**

    ```hot
    issues ::github::api/paginate-list("/repos/acme/api/issues?state=all&per_page=100")
    length(issues)

    // For one tenant
    pulls ::github::api/paginate-list("/repos/acme/api/pulls?per_page=100", {token: ::hot::ctx/get("acme.github-token")})
    map(pulls, %.number)
    ```
    """
}
fn
(path: Str): Vec {
  collect-list-pages(path, [], null)
},
(path: Str, token: Str): Vec {
  collect-list-pages(path, [], token)
},
(path: Str, opts: Map): Vec {
  collect-list-pages(path, [], opts)
}

collect-key-pages
meta {no-doc: true}
fn (path: Str, key: Str, accumulated: Vec, auth: Any): Vec {
  page fetch-page(path, auth)
  cond {
    is-err(page) => { page }
    => {
      items get(page.data, key, [])
      checked match items {
        Vec => { items }
        => { err(`GitHub paginate-key expected '${key}' to be a Vec`) }
      }

      combined concat(accumulated, checked)
      next next-page-path(page.headers, auth-base-url(auth))

      cond {
        is-err(next) => { next }
        is-null(next) => { combined }
        => { collect-key-pages(next, key, combined, auth) }
      }
    }
  }
}

paginate-key
meta {
    doc: """
    Fetch every page for an endpoint whose item Vec is nested under `key`,
    such as `"check_runs"` or `"items"`. Pass an explicit token or an `opts`
    Map as the third argument for a per-call identity.

    **Example**

    ```hot
    checks ::github::api/paginate-key("/repos/acme/api/commits/main/check-runs?per_page=100", "check_runs")
    map(checks, %.name)
    ```
    """
}
fn
(path: Str, key: Str): Vec {
  collect-key-pages(path, key, [], null)
},
(path: Str, key: Str, token: Str): Vec {
  collect-key-pages(path, key, [], token)
},
(path: Str, key: Str, opts: Map): Vec {
  collect-key-pages(path, key, [], opts)
}

response-body
meta {
    doc: """
    Return a response's decoded body, falling back to its wire bytes when the
    transport has no decoded body. Text logs remain Str values while binary
    archives remain Bytes.

    **Example**

    ```hot
    response ::hot::http/HttpResponse({status: 200, headers: {}, body: "log text"})
    ::github::api/response-body(response)  // "log text"
    ```
    """
}
fn (response: HttpResponse): Any {
  match response.body {
    Null => { response.body-bytes }
    => { response.body }
  }
}

download
meta {
    doc: """
    Make an authenticated GET request for a GitHub download endpoint.
    Returns the downloaded text or Bytes on 2xx, and an Err carrying
    `HttpError` otherwise. The HTTP transport follows GitHub's temporary
    redirect for Actions logs and artifacts.

    **Example**

    ```hot
    log ::github::api/download("/repos/acme/api/actions/jobs/9876543210/logs")
    length(log)
    ```
    """
}
fn
(path: Str): Any {
  download(path, {})
},
(path: Str, opts: Map): Any {
  response request("GET", path, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response-body(response) }
    => { err(HttpError(response)) }
  }
}
