::documents::text ns
meta {
    doc: """
    How `read-text` turns a `Document` into text (pure): format names,
    text detection by MIME type and extension, and `plan`, which picks
    the provider's native export, conversion or extraction, a plain
    download, or `unsupported`.
    """
}

::gcontent ::google::drive::content
TextResult ::documents/TextResult

FORMATS ["auto", "text", "markdown", "pdf"]
PDF_MIME "application/pdf"
HTML_MIME "text/html"
DEFAULT_MIME "application/octet-stream"

// OneDrive converts sources up to 2 MB (::microsoft::onedrive/MAX_CONVERT_BYTES).
MAX_CONVERT_BYTES 2097152

TEXT_MIMES ["application/json", "application/xml", "application/javascript", "application/x-javascript", "application/x-ndjson", "application/x-yaml", "application/yaml", "application/sql", "application/csv", "image/svg+xml"]

TEXT_EXTENSIONS ["txt", "text", "md", "markdown", "csv", "tsv", "json", "jsonl", "ndjson", "xml", "yaml", "yml", "html", "htm", "log", "ini", "toml", "sql", "svg", "js", "ts", "py", "rb", "go", "rs", "java", "sh", "css", "tex", "rst", "adoc", "org", "vtt", "srt"]

FORMAT_BY_EXTENSION {
    md: "markdown",
    markdown: "markdown",
    csv: "csv",
    tsv: "csv",
    html: "html",
    htm: "html",
    json: "json",
    jsonl: "json",
    ndjson: "json",
    svg: "svg"
}

FORMAT_BY_MIME {
    "text/markdown": "markdown",
    "text/x-markdown": "markdown",
    "text/csv": "csv",
    "application/csv": "csv",
    "text/tab-separated-values": "csv",
    "text/html": "html",
    "application/json": "json",
    "application/x-ndjson": "json",
    "image/svg+xml": "svg"
}

EXTRACTION_HINT "extract the text with hot.dev/pandoc (Office, HTML, EPUB), hot.dev/libreoffice (legacy Office), or hot.dev/tesseract (scans and images)"

// ---------------------------------------------------------------------------
// MIME and text detection
// ---------------------------------------------------------------------------

base-mime
meta {
    doc: """A Content-Type without parameters, lower-cased (`"text/plain; charset=utf-8"` is `"text/plain"`), or null (pure)."""
}
fn (content-type: Any): Str? {
  cond {
    not(is-str(content-type)) => { null }
    is-empty(trim(content-type)) => { null }
    => { lowercase(trim(first(split(content-type, ";")))) }
  }
}

extension
meta {
    doc: """The lower-cased extension of a name or path without the dot (`"Q3 Plan.DOCX"` is `"docx"`), or `""` (pure)."""
}
fn (name: Any): Str {
  n if(is-str(name), last(split(name, "/")), "")
  parts split(n, ".")
  cond {
    lt(length(parts), 2) => { "" }
    and(eq(first(parts), ""), eq(length(parts), 2)) => { "" }
    => { lowercase(last(parts)) }
  }
}

mime-from-name
meta {
    doc: """The MIME type for a file name from its extension, `application/octet-stream` when unknown (pure)."""
}
fn (name: Any): Str {
  ext extension(name)
  found if(eq(ext, ""), null, ::hot::mime/from-ext(ext))
  if(is-str(found), found, DEFAULT_MIME)
}

is-textual-mime
meta {
    doc: """True for text MIME types: `text/*`, JSON, XML, YAML, SQL, CSV, SVG, `+json` and `+xml` (pure)."""
}
fn (mime-type: Any): Bool {
  m or(base-mime(mime-type), "")
  or(starts-with(m, "text/"), in(m, TEXT_MIMES), ends-with(m, "+json"), ends-with(m, "+xml"))
}

is-textual
meta {
    doc: """True when a file is text by MIME type or by extension (pure). Providers often store `.md`, `.csv` and `.json` as `application/octet-stream`."""
}
fn (mime-type: Any, name: Any): Bool {
  or(is-textual-mime(mime-type), in(extension(name), TEXT_EXTENSIONS))
}

is-pdf
meta {doc: """True for a PDF by MIME type or `.pdf` extension (pure)."""}
fn (mime-type: Any, name: Any): Bool {
  or(eq(base-mime(mime-type), PDF_MIME), eq(extension(name), "pdf"))
}

text-format
meta {
    doc: """The format name of a text file (pure): `markdown`, `csv`, `html`, `json`, `svg`, else `text`."""
}
fn (mime-type: Any, name: Any): Str {
  by-mime get(FORMAT_BY_MIME, or(base-mime(mime-type), ""))
  by-ext get(FORMAT_BY_EXTENSION, extension(name))
  or(by-mime, by-ext, "text")
}

normalize-format
meta {
    doc: """A `read-text` format, lower-cased and trimmed (pure): null or `""` is `"auto"`; `md` is `markdown`, `txt` / `plain` are `text`. Anything else is an Err listing the formats."""
}
fn (format: Any): Str {
  f if(is-str(format), lowercase(trim(format)), "")
  g cond {
    eq(f, "") => { "auto" }
    eq(f, "md") => { "markdown" }
    in(f, ["txt", "plain", "plain_text"]) => { "text" }
    => { f }
  }

  if(in(g, FORMATS), g, err(`documents: unknown read-text format "${format}"; use ${join(FORMATS, ", ")}`))
}

// ---------------------------------------------------------------------------
// Planning (pure)
// ---------------------------------------------------------------------------

Plan
meta {
    doc: """
    How `read-text` reads one document.

    - `action` - `"export"`, `"download"`, `"convert"`, `"extracted-text"`,
      `"unsupported"` or `"error"`
    - `format` - the format the result will have (`text`, `markdown`,
      `csv`, `html`, `json`, `svg`, `pdf`), null when not `ok`
    - `export` - for `export`: the Google export MIME type or the Dropbox
      export format; for `convert`: the OneDrive format (`pdf`, `html`)
    - `reason` - for `unsupported` / `error`
    """
}
type {
    action: Str,
    format: Str?,
    export: Str?,
    reason: Str?
}

unsupported fn (reason: Str): Plan {
  Plan({action: "unsupported", format: null, export: null, reason: reason})
}

// The Google export format name for a native type and a read-text format.
GOOGLE_TEXT_FORMATS {
    "application/vnd.google-apps.document": {auto: "markdown", markdown: "markdown", text: "text", pdf: "pdf"},
    "application/vnd.google-apps.spreadsheet": {auto: "csv", markdown: "csv", text: "csv", pdf: "pdf"},
    "application/vnd.google-apps.presentation": {auto: "text", markdown: "text", text: "text", pdf: "pdf"},
    "application/vnd.google-apps.drawing": {auto: "svg", pdf: "pdf"},
    "application/vnd.google-apps.script": {auto: "json", text: "json"}
}

google-native-plan fn (doc: Map, format: Str): Plan {
  name get(or(get(GOOGLE_TEXT_FORMATS, doc.mime-type), {}), format)
  mime if(is-null(name), null, ::gcontent/export-mime-type(doc.mime-type, name))
  cond {
    is-null(name) => { unsupported(`Google cannot export ${doc.mime-type} as ${format}`) }
    is-err(mime) => { unsupported(err-message(mime)) }
    => { Plan({action: "export", format: name, export: mime, reason: null}) }
  }
}

// Dropbox export names for Paper (and other export-only files).
dropbox-export-name fn (format: Str, options: Vec): Str? {
  pick (wanted) { find-first(wanted, (w) { in(w, options) }) }
  cond {
    eq(format, "pdf") => { pick(["pdf"]) }
    eq(format, "text") => { pick(["plain_text", "markdown", "html"]) }
    => { pick(["markdown", "plain_text", "html"]) }
  }
}

DROPBOX_FORMATS {markdown: "markdown", plain_text: "text", html: "html", pdf: "pdf"}

dropbox-native-plan fn (doc: Map, format: Str): Plan {
  info get(doc.raw, "export_info")
  given if(is-map(info), or(get(info, "export_options"), []), [])
  // Paper docs export as markdown and html even when export_options is absent.
  options if(is-empty(given), ["markdown", "html"], given)
  name dropbox-export-name(format, options)
  cond {
    is-null(name) => { unsupported(`Dropbox cannot export ${doc.name} as ${format} (offers ${join(options, ", ")})`) }
    => { Plan({action: "export", format: or(get(DROPBOX_FORMATS, name), name), export: name, reason: null}) }
  }
}

binary-reason fn (doc: Map): Str {
  `${doc.name} is ${doc.mime-type} with no native text from ${doc.provider}; ${EXTRACTION_HINT}`
}

plan
meta {
    doc: """
    Decide how to read `doc` (a `Document`) in `format` (pure):

    1. Folders, and formats outside `auto`/`text`/`markdown`/`pdf`, are `error`.
    2. `pdf`: a stored PDF downloads; Google-native documents export to
       PDF; OneDrive converts Office, ODF, RTF, HTML, Markdown, EML/MSG,
       TIFF and Loop files up to 2 MB; Paper exports when Dropbox offers
       `pdf`; anything else is `unsupported`.
    3. Text formats: Google-native documents export (Docs `markdown` or
       `text`, Sheets `csv` of the first sheet, Slides `text`, Drawings
       `svg`, Apps Script `json`); Paper exports (`markdown`, or
       `plain_text` for `text` when offered); text files download; OneDrive
       Loop/Whiteboard files up to 2 MB convert to HTML; other Box files
       use Box's `extracted_text`; anything else is `unsupported`.

    ```hot
    ::documents::text/plan(doc, "auto").action   // "export", "download", ...
    ```
    """
}
fn (doc: Map, format: Str): Plan {
  provider doc.provider
  convertible in(PDF_MIME, or(doc.export-formats, []))
  html-convertible in(HTML_MIME, or(doc.export-formats, []))
  small lte(or(doc.size, 0), MAX_CONVERT_BYTES)
  textual is-textual(doc.mime-type, doc.name)
  cond {
    not(in(format, FORMATS)) => { Plan({action: "error", format: null, export: null, reason: `unknown format "${format}"`}) }
    eq(doc.kind, "folder") => { Plan({action: "error", format: null, export: null, reason: `${doc.name} is a folder; list it instead`}) }
    eq(format, "pdf") => {
      cond {
        and(not(doc.is-native), is-pdf(doc.mime-type, doc.name)) => { Plan({action: "download", format: "pdf", export: null, reason: null}) }
        and(eq(provider, "google-drive"), doc.is-native) => { google-native-plan(doc, "pdf") }
        and(eq(provider, "dropbox"), doc.is-native) => { dropbox-native-plan(doc, "pdf") }
        and(eq(provider, "onedrive"), convertible, small) => { Plan({action: "convert", format: "pdf", export: "pdf", reason: null}) }
        and(eq(provider, "onedrive"), convertible) => { unsupported(`${doc.name} is over the 2 MB OneDrive conversion limit; download it and convert it with hot.dev/libreoffice`) }
        => { unsupported(`${doc.name} (${doc.mime-type}) has no PDF form at ${provider}; convert it with hot.dev/libreoffice or hot.dev/pandoc`) }
      }
    }

    and(eq(provider, "google-drive"), doc.is-native) => { google-native-plan(doc, format) }
    and(eq(provider, "dropbox"), doc.is-native) => { dropbox-native-plan(doc, format) }
    textual => { Plan({action: "download", format: text-format(doc.mime-type, doc.name), export: null, reason: null}) }
    and(eq(provider, "onedrive"), html-convertible, small) => { Plan({action: "convert", format: "html", export: "html", reason: null}) }
    eq(provider, "box") => { Plan({action: "extracted-text", format: "text", export: null, reason: null}) }
    => { unsupported(binary-reason(doc)) }
  }
}

// ---------------------------------------------------------------------------
// Results (pure)
// ---------------------------------------------------------------------------

ok-result
meta {
    doc: """An `ok` `TextResult` from produced bytes (pure): `text` is the UTF-8 decoding for text formats; for `pdf` the bytes are kept in `bytes` and `text` is null."""
}
fn (doc: Any, bytes: Bytes, format: Str, mime-type: Any, method: Str): TextResult {
  pdf eq(format, "pdf")
  TextResult({
    status: "ok",
    text: if(pdf, null, Str(bytes)),
    bytes: if(pdf, bytes, null),
    format: format,
    mime-type: or(base-mime(mime-type), if(pdf, PDF_MIME, "text/plain")),
    method: method,
    reason: null,
    document: doc
  })
}

text-result
meta {
    doc: """An `ok` `TextResult` holding text that is already decoded (pure), e.g. Box extracted text."""
}
fn (doc: Any, text: Str, format: Str, method: Str): TextResult {
  TextResult({status: "ok", text: text, bytes: null, format: format, mime-type: "text/plain", method: method, reason: null, document: doc})
}

not-ok-result
meta {
    doc: """A `pending` or `unsupported` `TextResult` for `doc` (pure), carrying the file's MIME type and the reason."""
}
fn (doc: Any, status: Str, reason: Str?): TextResult {
  TextResult({
    status: status,
    text: null,
    bytes: null,
    format: null,
    mime-type: if(is-some(doc), get(doc, "mime-type"), null),
    method: if(eq(status, "pending"), "extracted-text", null),
    reason: reason,
    document: doc
  })
}

plan-error
meta {doc: """The Err for a plan whose action is `error` (pure)."""}
fn (plan: Map): Any {
  err(`documents: ${plan.reason}`)
}
