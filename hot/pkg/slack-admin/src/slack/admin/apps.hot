::slack::admin::apps ns
meta {
    doc: """
    `admin.apps.*`: approve, restrict or uninstall apps; review install
    requests; read app activity logs; and read or set app configuration.
    Approve/restrict take either `app_id` or `request_id`, scoped by
    `team_id` (workspace) or `enterprise_id` (org).

    **Example**

    ```hot
    ::apps ::slack::admin::apps

    pending ::apps/requests-list(::apps/RequestsListRequest({team_id: "T0123ABCDEF"}))
    ::apps/approve(::apps/ApproveRequest({request_id: first(pending.app_requests).id, team_id: "T0123ABCDEF"}))
    ```
    """
}

::api ::slack::admin::api

ApproveRequest type {
  app_id: Str?,
  request_id: Str?,
  team_id: Str?,
  enterprise_id: Str?
}

approve
meta {
    doc: """
    admin.apps.approve - Approve an app (by `app_id`) or an install request (by `request_id`).

    Scope: `admin.apps:write`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.

    **Example**

    ```hot
    ::apps ::slack::admin::apps

    ::apps/approve(::apps/ApproveRequest({app_id: "A0123ABCDEF", team_id: "T0123ABCDEF"}))

    // Approve a pending install request
    ::apps/approve(::apps/ApproveRequest({request_id: "Ar0123ABCDEF", team_id: "T0123ABCDEF"}))
    ```
    """
}
fn
(): Map {
  approve(ApproveRequest({}))
},
(request: ApproveRequest): Map {
  approve(request, {})
},
(request: ApproveRequest, opts: Map): Map {
  ::api/call("admin.apps.approve", request, opts)
}

