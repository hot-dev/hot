::sanctions::cache ns
meta {
    doc: """
    The list cache in `::hot::store`.

    **Layout**: one metadata store (named by `sanctions.store`, default
    `"sanctions"`) with a `meta:<source>` record per list, and one data
    store per list version, `<store>:<source>:<version hash>`, holding
    the index from `::sanctions::index/build`: `e:<id>` records and
    `b:<hh>` buckets. A refresh writes the new version's store
    completely, then switches `meta:<source>` to it, then destroys the
    previous version's store, so readers never see a half-written list.

    **Refreshing**: `refresh-lists` is meant to run from a schedule
    (daily). Each list is checked cheaply first (OFAC's SHA-256 file
    listing, the UK ETag, the EU Last-Modified, the UN body hash) and
    only re-indexed when it changed.

    **Sizes**: about 19,500 OFAC SDN records, 6,400 UK, 6,300 EU, 1,000
    UN and a few hundred OFAC Consolidated, roughly 1 KB each, plus 256
    buckets per list. Screening never downloads anything.
    """
}

::store ::hot::store
::cfg ::sanctions::config
::index ::sanctions::index
::time ::hot::time

SOURCES ["ofac-sdn", "ofac-cons", "uk", "eu", "un"]

LIST_NAMES {
  ofac-sdn: "OFAC SDN List",
  ofac-cons: "OFAC Consolidated (non-SDN) List",
  uk: "UK Sanctions List",
  eu: "EU Consolidated Financial Sanctions List",
  un: "UN Security Council Consolidated List"
}

WRITE_BATCH 500

is-source
meta {
    doc: """True for a known source key."""
}
fn (source: Any): Bool {
  some(SOURCES, (s) { eq(s, source) })
}

check-sources
meta {
    doc: """The requested sources (all when null or empty), or an Err naming an unknown one."""
}
fn (sources: Any): Vec<Str> {
  wanted cond {
    is-null(sources) => { SOURCES }
    is-str(sources) => { [sources] }
    is-empty(sources) => { SOURCES }
    => { sources }
  }

  unknown filter(wanted, (s) { not(is-source(s)) })
  cond {
    is-empty(unknown) => { wanted }
    => { err(`sanctions: unknown source ${join(map(unknown, Str), ", ")}; use ${join(SOURCES, ", ")}`) }
  }
}

meta-store fn (cfg: Map): Map {
  ::store/Map({name: cfg.store})
}

data-store-name
meta {
    doc: """The data store name for one version of a list: `<store>:<source>:<first 12 hex digits of SHA-256(version)>`."""
}
fn (store: Str, source: Str, version: Str): Str {
  `${store}:${source}:${slice(::hot::hash/sha256(version), 0, 12)}`
}

now-ms fn (): Int {
  ::time/epoch-millis(::time/now())
}

meta-of
meta {
    doc: """The cached metadata for one list (`{source, list, version, store, entries, keys, fetched-at, fetched-at-ms, checked-at}`), or null when it was never refreshed."""
}
fn
(source: Str): Map? {
  meta-of(source, {})
},
(source: Str, opts: Map): Map? {
  ::store/get(meta-store(::cfg/resolve(opts)), `meta:${source}`)
}

status
meta {
    doc: """
    The cache status of every list: a Vec of metadata records, with
    `{source, list, cached: false}` for a list never refreshed.

    **Example**

    ```hot
    ::sanctions::cache/status()
    ```
    """
}
fn
(): Vec<Map> {
  status({})
},
(opts: Map): Vec<Map> {
  ms meta-store(::cfg/resolve(opts))
  map(SOURCES, (s) {
    m ::store/get(ms, `meta:${s}`)
    if(is-null(m), {source: s, list: get(LIST_NAMES, s), cached: false}, {...m, cached: true})
  })
}

fetch-source
meta {
    doc: """Download and parse one list: `{source, version, entries, unchanged}` (see each source namespace's `fetch`)."""
}
fn (source: Str, known-version: Str?): Map {
  cond {
    or(eq(source, "ofac-sdn"), eq(source, "ofac-cons")) => { ::sanctions::ofac/fetch(source, known-version) }
    eq(source, "uk") => { ::sanctions::uk/fetch(known-version) }
    eq(source, "eu") => { ::sanctions::eu/fetch(known-version) }
    eq(source, "un") => { ::sanctions::un/fetch(known-version) }
    => { err(`sanctions: unknown source ${source}`) }
  }
}

write-pairs fn (store: Map, pairs: Vec): Int {
  batches partition(pairs, WRITE_BATCH)
  reduce(batches, (n, batch) {
    add(n, ::store/put-many(store, zipmap(map(batch, first), map(batch, last))))
  }, 0)
}

refresh-source
meta {
    doc: """
    Refresh one list: check whether it changed, and if so download,
    parse, index and store the new version, then drop the old one.
    Returns `{source, status, version, entries, ms}` where `status` is
    `"updated"` or `"unchanged"`. Errors (a download failure, an EU file
    over `http.max-response-bytes`) are returned as an Err and leave the
    cached version in place.
    """
}
fn
(source: Str): Map {
  refresh-source(source, {})
},
(source: Str, opts: Map): Map {
  cfg ::cfg/resolve(opts)
  ms meta-store(cfg)
  meta-key `meta:${source}`
  current ::store/get(ms, meta-key)
  known if(is-null(current), null, current.version)
  force eq(get(opts, "force"), true)
  started now-ms()
  fetched fetch-source(source, if(force, null, known))
  cond {
    is-err(fetched) => { fetched }
    fetched.unchanged => {
      ::store/put(ms, meta-key, {...current, checked-at: Str(::time/now()), checked-at-ms: now-ms()})
      {source: source, status: "unchanged", version: fetched.version, entries: current.entries, ms: sub(now-ms(), started)}
    }
    => {
      idx ::index/build(fetched.entries)
      name data-store-name(cfg.store, source, fetched.version)
      data ::store/Map({name: name})
      ::store/clear(data)
      write-pairs(data, idx.pairs)
      stamp Str(::time/now())
      ::store/put(ms, meta-key, filter-vals({
        source: source,
        list: get(LIST_NAMES, source),
        version: fetched.version,
        published: get(fetched, "published"),
        store: name,
        entries: idx.entry-count,
        keys: idx.key-count,
        fetched-at: stamp,
        fetched-at-ms: now-ms(),
        checked-at: stamp,
        checked-at-ms: now-ms()
      }, is-some))
      old if(is-null(current), null, current.store)
      if(and(is-some(old), ne(old, name)), ::store/destroy(::store/Map({name: old})), false)
      {source: source, status: "updated", version: fetched.version, entries: idx.entry-count, ms: sub(now-ms(), started)}
    }
  }
}

refresh-lists
meta {
    doc: """
    Refresh every list (or `opts.sources`), one after another. A list
    that fails does not stop the others: its row has `status: "error"`
    and an `error` message, and its previous version stays cached.
    `opts.force: true` re-indexes even unchanged lists. A failure that
    halts the run (a store write error, for example) still stops it; the
    schedule's `retry` policy covers those.

    Meant for a daily schedule; see the README. The EU list needs
    `http.max-response-bytes` of at least 32 MiB.

    **Example**

    ```hot
    ::sanctions::cache/refresh-lists()
    ::sanctions::cache/refresh-lists({sources: ["ofac-sdn", "un"]})
    ```
    """
}
fn
(): Vec<Map> {
  refresh-lists({})
},
(opts: Map): Vec<Map> {
  sources check-sources(get(opts, "sources"))
  cond {
    is-err(sources) => { sources }
    => {
      results map(sources, (s) { refresh-source(s, opts) }, OnErr.Preserve)
      map(range(0, length(sources)), (i) { summarize(get(sources, i), get(results, i)) }, OnErr.Preserve)
    }
  }
}

summarize fn (source: Str, r: Result): Map {
  cond {
    is-err(r) => { {source: source, status: "error", error: err-message(r)} }
    => { r }
  }
}

// ---------------------------------------------------------------------------
// Readers
// ---------------------------------------------------------------------------

stale-warning fn (m: Map, max-age-days: Int): Str? {
  age-ms sub(now-ms(), or(get(m, "checked-at-ms"), 0))
  limit mul(max-age-days, 86400000)
  if(gt(age-ms, limit), `${m.list} was last refreshed ${or(get(m, "checked-at"), "never")}, more than ${max-age-days} days ago`, null)
}

open-sources
meta {
    doc: """
    The cached lists to screen: `{lists, sources, warnings}` where each
    list is `{source, store}`. An Err when a requested list was never
    refreshed (screening it would silently find nothing), unless
    `opts.allow-missing` is true.
    """
}
fn (opts: Map): Map {
  cfg ::cfg/resolve(opts)
  ms meta-store(cfg)
  wanted check-sources(get(opts, "sources"))
  cond {
    is-err(wanted) => { wanted }
    => { open-lists(ms, cfg, wanted, opts) }
  }
}

open-lists fn (ms: Map, cfg: Map, wanted: Vec, opts: Map): Map {
  metas map(wanted, (s) { {source: s, meta: ::store/get(ms, `meta:${s}`)} })
  missing map(filter(metas, (m) { is-null(m.meta) }), (m) { m.source })
  present filter(metas, (m) { is-some(m.meta) })
  cond {
    and(not(is-empty(missing)), ne(get(opts, "allow-missing"), true)) => {
      err(`sanctions: no cached data for ${join(missing, ", ")}; run ::sanctions::cache/refresh-lists first`)
    }
    => {
      {
        lists: map(present, (m) { {source: m.source, store: m.meta.store} }),
        sources: map(present, (m) {
          filter-vals({source: m.source, list: m.meta.list, version: m.meta.version, entries: m.meta.entries, fetched-at: m.meta.fetched-at, checked-at: get(m.meta, "checked-at")}, is-some)
        }),
        warnings: concat(
          filter(map(present, (m) { stale-warning(m.meta, cfg.max-age-days) }), is-some),
          map(missing, (s) { `${get(LIST_NAMES, s)} is not cached and was not searched` })
        )
      }
    }
  }
}
