::documents::box ns
meta {
    doc: """
    The Box implementation of the `::documents` verbs, over
    `hot.dev/box`. Source: `{provider: "box", folder-id?, opts}`
    (default `"0"`, the root). `opts.as-user` acts as a managed user.

    **Changes** come from the user's event stream (`stream_type=changes`),
    which covers the whole account. With a `folder-id` other than `"0"`,
    only items under that folder are returned (by `path_collection`), and
    items moved out of it are reported in `deleted-ids`; trash events are
    always reported, since a trashed item's path no longer says where it was.
    """
}

::source ::documents::source
::cursor ::documents::cursor
::adapters ::documents::adapters
::text ::documents::text
::bx ::box
::folders ::box::folders
::bfiles ::box::files
::bsearch ::box::search
::content ::box::content
::up ::box::upload
::events ::box::events
Page ::documents/Page
ChangeSet ::documents/ChangeSet

PROVIDER "box"
MAX_PAGE_SIZE 1000

// Item fields for listings and search: the package defaults plus path_collection, for Document.path.
fields fn (): Str {
  `${::bx/ITEM_FIELDS},path_collection`
}

// Box user events that leave an item in place (upsert) or remove it.
UPSERT_EVENTS ["ITEM_CREATE", "ITEM_UPLOAD", "ITEM_MOVE", "ITEM_COPY", "ITEM_RENAME", "ITEM_UNDELETE_VIA_TRASH", "ITEM_MAKE_CURRENT_VERSION", "ITEM_MODIFY"]
REMOVE_EVENTS ["ITEM_TRASH", "ITEM_DELETE"]

to-document fn (source: Map, item: Map): Any {
  ::adapters/from-box(source, ::bx/to-doc-file(item))
}

root-of fn (source: Map): Str {
  Str(or(get(source, "folder-id"), ::bx/ROOT_FOLDER_ID))
}

// ---------------------------------------------------------------------------
// Pure builders
// ---------------------------------------------------------------------------

to-page
meta {
    doc: """A Box folder-items page (marker paging) as a `::documents/Page` (pure); `next_marker` becomes the cursor."""
}
fn (source: Map, folder: Str, page: Map): Page {
  docs map(filter(or(page.entries, []), is-map), (i) { to-document(source, i) })
  c ::cursor/list-cursor(PROVIDER, page.next_marker, folder)
  Page({documents: docs, cursor: c, has-more: is-some(c)})
}

is-under
meta {
    doc: """True when a Box item is `folder-id` itself, a direct child (`parent.id`), or has it in `path_collection` (pure). Everything is under `"0"`."""
}
fn (item: Map, folder-id: Str): Bool {
  parent get(item, "parent")
  pc get(item, "path_collection")
  ancestors if(and(is-map(pc), is-vec(get(pc, "entries"))), map(pc.entries, (e) { Str(or(get(e, "id"), "")) }), [])
  or(
    eq(folder-id, ::bx/ROOT_FOLDER_ID),
    eq(Str(or(get(item, "id"), "")), folder-id),
    and(is-map(parent), eq(Str(or(get(parent, "id"), "")), folder-id)),
    in(folder-id, ancestors)
  )
}

event-changes
meta {
    doc: """
    Fold Box events into `{upserts: {id: item}, deleted: {id: true}}`
    (pure), latest event per item id winning. Only `file` and `folder`
    sources count; other event types (previews, downloads, comments, ...)
    are ignored. Upserts outside `folder-id` become deletions.
    """
}
fn (events: Vec, folder-id: Str): Map {
  reduce(events, (acc, e) {
    src if(is-map(e), get(e, "source"), null)
    kind if(is-map(src), get(src, "type"), null)
    etype if(is-map(e), get(e, "event_type"), null)
    id if(is-map(src), Str(or(get(src, "id"), "")), "")
    cond {
      or(not(in(kind, ["file", "folder"])), eq(id, "")) => { acc }
      in(etype, REMOVE_EVENTS) => { {upserts: filter-keys(acc.upserts, (k) { ne(k, id) }), deleted: assoc(acc.deleted, id, true)} }
      and(in(etype, UPSERT_EVENTS), is-under(src, folder-id)) => {
        {upserts: assoc(acc.upserts, id, src), deleted: filter-keys(acc.deleted, (k) { ne(k, id) })}
      }

      in(etype, UPSERT_EVENTS) => { {upserts: filter-keys(acc.upserts, (k) { ne(k, id) }), deleted: assoc(acc.deleted, id, true)} }
      => { acc }
    }
  }, {upserts: {}, deleted: {}})
}

to-change-set
meta {
    doc: """A box `EventSet` as a `::documents/ChangeSet` (pure). `has-more` is true when `max-pages` stopped the read before the end of the stream."""
}
fn (source: Map, set: Map): ChangeSet {
  folded event-changes(or(set.events, []), root-of(source))
  next ::cursor/change-cursor(PROVIDER, set.next-stream-position)
  cond {
    is-err(next) => { next }
    => {
      ChangeSet({
        documents: map(vals(folded.upserts), (i) { to-document(source, i) }),
        deleted-ids: keys(folded.deleted),
        deleted-paths: [],
        next-cursor: next,
        reset-required: false,
        has-more: not(eq(set.complete, true))
      })
    }
  }
}

text-from-extraction
meta {
    doc: """A `TextResult` from a box `ExtractedText` (pure): `success` with text is `ok`, `pending` / `none` is `pending`, anything else `unsupported`."""
}
fn (doc: Any, status: Map): Any {
  cond {
    and(eq(status.ready, true), is-str(status.text)) => { ::text/text-result(doc, status.text, "text", "extracted-text") }
    in(status.state, ["pending", "none"]) => { ::text/not-ok-result(doc, "pending", "Box is still extracting the text; call read-text again later") }
    => { ::text/not-ok-result(doc, "unsupported", `Box has no extracted text for this file (${status.state}); ${::text/EXTRACTION_HINT}`) }
  }
}

// ---------------------------------------------------------------------------
// Verbs
// ---------------------------------------------------------------------------

list fn (source: Map, folder: Str?, opts: Map): Page {
  popts ::source/provider-opts(source, opts)
  given get(opts, "cursor")
  c if(is-null(given), null, ::cursor/decode-for(given, PROVIDER, "list"))
  cond {
    is-err(c) => { c }
    => {
      target Str(or(if(is-map(c), c.f, null), folder, root-of(source)))
      size ::source/page-size(opts, ::documents/DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE)
      marker if(is-map(c), Str(c.v), null)
      params filter-vals({fields: fields(), ...popts, limit: size, marker: marker}, is-some)
      page ::folders/list-items(target, params)
      if(is-err(page), page, to-page(source, target, page))
    }
  }
}

search fn (source: Map, query: Str, limit: Int, opts: Map): Vec {
  root root-of(source)
  popts {fields: fields(), ...::source/provider-opts(source, opts)}
  scoped if(or(eq(root, ::bx/ROOT_FOLDER_ID), is-some(get(popts, "ancestor_folder_ids"))), popts, {...popts, ancestor_folder_ids: [root]})
  found ::bsearch/search-all(query, scoped, limit)
  if(is-err(found), found, map(filter(found, is-map), (i) { to-document(source, i) }))
}

is-not-found fn (result: Result): Bool {
  e if(is-err(result), err-value(result), null)
  // err-value is a typed HttpError (not is-map), so read the field with get.
  and(is-some(e), not(is-str(e)), eq(get(e, "status"), 404))
}

get-doc fn (source: Map, id: Str, opts: Map): Any {
  popts ::source/provider-opts(source, opts)
  file ::bfiles/get-file(id, popts)
  // Box ids are typed: a folder id is a 404 on /files, so try /folders next.
  found if(is-not-found(file), ::folders/get-folder(id, popts), file)
  if(is-err(found), found, to-document(source, found))
}

download fn (source: Map, id: Str, opts: Map): Any {
  popts ::source/provider-opts(source, opts)
  file ::bfiles/get-file(id, popts)
  doc if(is-err(file), file, to-document(source, file))
  cond {
    is-err(doc) => { doc }
    => {
      content ::content/download-file(id, {...popts, name: doc.name})
      if(is-err(content), content, ::adapters/to-content(source, {...untype(content), name: doc.name}, ::adapters/from-box, doc))
    }
  }
}

read-text fn (source: Map, id: Str, format: Str, opts: Map): Any {
  popts ::source/provider-opts(source, opts)
  found get-doc(source, id, opts)
  cond {
    is-err(found) => { found }
    => {
      doc found
      plan ::text/plan(doc, format)
      cond {
        eq(plan.action, "error") => { ::text/plan-error(plan) }
        eq(plan.action, "unsupported") => { ::text/not-ok-result(doc, "unsupported", plan.reason) }
        eq(plan.action, "extracted-text") => {
          status ::content/extracted-text(id, popts)
          if(is-err(status), status, text-from-extraction(doc, status))
        }
        => {
          content ::content/download-file(id, {...popts, name: doc.name})
          if(is-err(content), content, ::text/ok-result(doc, content.bytes, plan.format, or(content.mime-type, doc.mime-type), "download"))
        }
      }
    }
  }
}

upload fn (source: Map, parent: Str?, name: Str, bytes: Bytes, mime-type: Str, opts: Map): Any {
  file ::up/upload-file(name, bytes, Str(or(parent, root-of(source))), ::source/provider-opts(source, opts))
  if(is-err(file), file, to-document(source, file))
}

start-cursor fn (source: Map, opts: Map): Any {
  pos ::events/current-position(::source/provider-opts(source, opts))
  if(is-err(pos), pos, ::cursor/change-cursor(PROVIDER, pos))
}

changes fn (source: Map, cursor: Str, opts: Map): Any {
  c ::cursor/decode-for(cursor, PROVIDER, "changes")
  max-pages get(opts, "max-pages")
  cond {
    is-err(c) => { c }
    => {
      popts filter-vals({...::source/provider-opts(source, opts), stream_type: "changes", max-pages: max-pages}, is-some)
      set ::events/sync-events(Str(c.v), popts)
      if(is-err(set), set, to-change-set(source, set))
    }
  }
}
