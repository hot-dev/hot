files-remote-add
meta {
    doc: """
    POST /files.remote.add - Add a remote file. Register an external file
    with Slack by providing an `external_id`, `external_url`, and `title`.

    **Example**

    ```hot
    response ::slack::files/files-remote-add(::slack::files/FilesRemoteAddRequest({
      external_id: "report-42",
      external_url: "https://example.com/reports/42",
      title: "Q3 report"
    }))
    response.file.id
    ```
    """
}
fn
(request: FilesRemoteAddRequest): FilesRemoteAddResponse {
  files-remote-add(request, {})
},
(request: FilesRemoteAddRequest, opts: Map): FilesRemoteAddResponse {
  response api-request("POST", `${::slack::core/BASE_URL}/files.remote.add`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { FilesRemoteAddResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

