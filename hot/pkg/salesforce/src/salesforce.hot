::salesforce ns
meta {
    doc: """
    Salesforce bindings over the REST API: sObject CRUD and external-id
    upserts, SOQL (with auto-paging), SOSL search, describe, sObject
    collections and composite requests, Bulk API 2.0 ingest and query
    jobs, and org limits.

    **Setup**: set ONE auth flow in context. See `::salesforce::auth`
    for the full matrix; in short:

    | Flow | Context variables |
    |---|---|
    | Access token | `salesforce.access.token` + `salesforce.instance.url` |
    | Refresh token | `salesforce.client-id` + `salesforce.refresh-token` (+ `salesforce.client-secret` for confidential apps) |
    | JWT bearer | `salesforce.client-id` + `salesforce.username` + `salesforce.private.key` |
    | Client credentials | `salesforce.client-id` + `salesforce.client-secret` + `salesforce.my-domain.url` |

    `salesforce.sandbox` ("true") switches the login host and JWT
    audience to `test.salesforce.com`. Sessions are cached for the rest
    of the run and re-minted once on `401 INVALID_SESSION_ID`.

    **Quick start**

    ```hot
    ::sobjects ::salesforce::sobjects
    ::query ::salesforce::query

    lead ::sobjects/create-record("Lead", {
      LastName: "Lovelace",
      Company: "Analytical Engines",
      Email: "ada@example.com"
    })

    hot-leads ::query/soql-records(`SELECT Id, Name, Email FROM Lead WHERE Company = ${::query/literal("Analytical Engines")}`)
    map(hot-leads, (r) { r.Name })
    ```
    """
}

DEFAULT_API_VERSION
meta {
    doc: """The REST API version used when `salesforce.api.version` is unset: v68.0 (Winter '27). Override per org with the context variable."""
}
"v68.0"

LOGIN_URL "https://login.salesforce.com"
TEST_URL "https://test.salesforce.com"
