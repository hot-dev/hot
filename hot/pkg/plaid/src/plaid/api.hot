::plaid::api ns
meta {
    ctx: {
        "plaid.client-id": {required: false},
        "plaid.secret": {required: false},
        "plaid.env": {required: false, secret: false},
        "plaid.version": {required: false, secret: false}
    },
    doc: """
    Transport for the Plaid API: environment selection, the credentialed
    `post` escape hatch, request-body building that drops unset fields,
    and Plaid's error object unwrapped into `HttpError`.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then the `plaid.*` context variables, then the defaults. They
    are masked in call records and never written to ctx, so one run can
    act for many Plaid clients.

    - `client-id`, `secret`: the credentials for this call, always together
    - `environment`: `"sandbox"` or `"production"` for this call
    - `plaid-version`: the `Plaid-Version` for this call

    A key that is present but blank or null is an Err naming it, never a
    fallback to context.

    Item `access_token`s, and the tokens Plaid mints, are masked in call
    records too.
    """
}

::ctx ::hot::ctx

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------

HttpError
meta {
    doc: """
    A non-2xx Plaid response. `status`, `headers` and `body` as in the
    sibling packages, plus Plaid's error object lifted to the top:
    `error_type` (e.g. `ITEM_ERROR`, `INVALID_REQUEST`, `RATE_LIMIT_EXCEEDED`),
    `error_code` (e.g. `ITEM_LOGIN_REQUIRED`), `error_message`,
    `display_message` (safe to show end users, often null), `request_id`
    (quote it to Plaid support), `documentation_url` and
    `suggested_action`.
    """
}
type {
    status: Int,
    headers: Map,
    body: Any,
    error_type: Str?,
    error_code: Str?,
    error_message: Str?,
    display_message: Str?,
    request_id: Str?,
    documentation_url: Str?,
    suggested_action: Str?
}

plaid-field fn (body: Any, key: Str): Any {
  if(is-map(body), get(body, key), null)
}

HttpResponse -> HttpError
meta {
    doc: """Coerce a non-2xx response into an `HttpError`, lifting Plaid's error fields out of the body."""
}
fn (response: HttpResponse): HttpError {
  body response.body
  HttpError({
    status: response.status,
    headers: or(response.headers, {}),
    body: body,
    error_type: plaid-field(body, "error_type"),
    error_code: plaid-field(body, "error_code"),
    error_message: plaid-field(body, "error_message"),
    display_message: plaid-field(body, "display_message"),
    request_id: plaid-field(body, "request_id"),
    documentation_url: plaid-field(body, "documentation_url"),
    suggested_action: plaid-field(body, "suggested_action")
  })
}

is-error-code
meta {
    doc: """True when `e` is a Plaid `HttpError` with this `error_code` (e.g. `"ITEM_LOGIN_REQUIRED"`, `"TRANSACTIONS_SYNC_MUTATION_DURING_PAGINATION"`)."""
}
fn (e: Any, code: Str): Bool {
  cond {
    or(is-null(e), is-str(e)) => { false }
    => { eq(get-in(e, ["error_code"]), code) }
  }
}

// ---------------------------------------------------------------------------
// Environment and version
// ---------------------------------------------------------------------------

env-base-url
meta {
    doc: """The base URL for a Plaid environment: `"sandbox"` or `"production"`. Anything else errs (including the decommissioned `"development"`). Exposed for testing."""
}
fn (env: Str): Str {
  name lowercase(trim(env))
  url get(::plaid/ENVIRONMENTS, name)
  cond {
    is-some(url) => { url }
    eq(name, "development") => {
      err("plaid: the development environment was decommissioned in June 2024; use \"sandbox\" or \"production\"")
    }
    => { err(`plaid: unknown environment '${env}'; use "sandbox" or "production"`) }
  }
}

current-env
meta {
    doc: """The configured environment name: `plaid.env`, or `"sandbox"` when unset or empty."""
}
fn (): Str {
  configured or(::ctx/get("plaid.env"), "")
  if(is-empty(configured), ::plaid/DEFAULT_ENV, configured)
}

plaid-version
meta {
    doc: """The `Plaid-Version` header value: `plaid.version`, or `::plaid/PLAID_VERSION`."""
}
fn (): Str {
  configured or(::ctx/get("plaid.version"), "")
  if(is-empty(configured), ::plaid/PLAID_VERSION, configured)
}

// ---------------------------------------------------------------------------
// Bodies
// ---------------------------------------------------------------------------

compact
meta {
    doc: """Drop null-valued keys from a request body. An `options` sub-object that is null or empty is dropped too, so Plaid never sees `"options": null`. Exposed for testing."""
}
fn (body: Map): Map {
  kept filter-vals(body, is-some)
  options get(kept, "options")
  cond {
    and(is-map(options), is-empty(options)) => { filter-keys(kept, (k) { ne(k, "options") }) }
    => { kept }
  }
}

with-credentials
meta {
    doc: """The full request body: `client_id` and `secret` first, then the (compacted) body. Exposed for testing."""
}
fn (body: Map, client-id: Str, secret: Str): Map {
  {client_id: client-id, secret: secret, ...compact(body)}
}

// ---------------------------------------------------------------------------
// Credentials
// ---------------------------------------------------------------------------

// Keys that may not be present and blank. `environment` is here too: a
// tenant's missing value must not silently pick the project's environment.
REQUIRED_WHEN_PRESENT ["client-id", "secret", "environment"]

// Body fields that are credentials: the Item's access token, and the tokens
// Plaid mints.
TOKEN_FIELDS ["access_token", "public_token", "link_token"]

non-blank fn (value: Any): Str? {
  if(is-str(value), if(is-empty(trim(value)), null, trim(value)), null)
}

blank-option
meta {
    doc: """The first of `names` that `opts` has with a blank or null value, else null."""
}
fn (opts: Map, names: Vec): Str? {
  find-first(names, (name) { and(in(name, keys(opts)), is-null(non-blank(get(opts, name)))) })
}

resolve-from
meta {
    doc: """
    The one resolver, pure: `{client-id, secret, base-url, plaid-version}`
    for a call from `opts` first, then `ctx-values` (a Map of context
    variables), then defaults. An Err when a credential is not set, when
    `client-id`, `secret` or `environment` is in `opts` but blank or null,
    when `opts` has only one of `client-id` and `secret` (a tenant's id
    must not go out with the project's secret), or when the environment
    is unknown. Exposed for testing; `resolve` feeds it the context.
    """
}
fn (opts: Map, ctx-values: Map): Map {
  blank blank-option(opts, REQUIRED_WHEN_PRESENT)
  opts-id non-blank(get(opts, "client-id"))
  opts-secret non-blank(get(opts, "secret"))
  client-id or(opts-id, non-blank(get(ctx-values, "plaid.client-id")))
  secret or(opts-secret, non-blank(get(ctx-values, "plaid.secret")))
  env or(non-blank(get(opts, "environment")), non-blank(get(ctx-values, "plaid.env")), ::plaid/DEFAULT_ENV)
  url env-base-url(env)
  cond {
    is-some(blank) => {
      err(`plaid: ${blank} is in the call's opts but is blank or null. Pass a value, or leave ${blank} out.`)
    }

    and(is-some(opts-id), is-null(opts-secret)) => { err("plaid: client-id is in the call's opts without secret. Pass both.") }
    and(is-some(opts-secret), is-null(opts-id)) => { err("plaid: secret is in the call's opts without client-id. Pass both.") }
    or(is-null(client-id), is-null(secret)) => {
      err("plaid: plaid.client-id and plaid.secret are not set. Add them in Context Variables, or pass {client-id: ..., secret: ...} in the call's opts.")
    }

    is-err(url) => { url }
    => {
      {
        client-id: client-id,
        secret: secret,
        base-url: url,
        plaid-version: or(non-blank(get(opts, "plaid-version")), non-blank(get(ctx-values, "plaid.version")), ::plaid/PLAID_VERSION)
      }
    }
  }
}

resolve
meta {
    ctx: {
        "plaid.client-id": {required: false},
        "plaid.secret": {required: false},
        "plaid.env": {required: false, secret: false},
        "plaid.version": {required: false, secret: false}
    },
    doc: """
    Credentials and settings for one call (see `resolve-from`). The
    credentials are masked in this run's call records, and nothing from
    `opts` is written to ctx.

    **Example**

    ```hot
    ::plaid::api/resolve({client-id: "tenant-id", secret: "tenant-secret", environment: "production"}).base-url
    // "https://production.plaid.com"
    ```
    """
}
fn (opts: Map): Map {
  mark-credentials(opts)
  resolved resolve-from(opts, {
    "plaid.client-id": ::ctx/get("plaid.client-id"),
    "plaid.secret": ::ctx/get("plaid.secret"),
    "plaid.env": ::ctx/get("plaid.env"),
    "plaid.version": ::ctx/get("plaid.version")
  })
  cond {
    is-err(resolved) => { resolved }
    => {
      {
        ...resolved,
        client-id: ::ctx/mark-secret(resolved.client-id),
        secret: ::ctx/mark-secret(resolved.secret)
      }
    }
  }
}

mark-credentials
meta {
    doc: """Mask the credentials in `opts` in this run's call records. Called first wherever `opts` arrives, so the records of the calls after it are masked too. Returns null."""
}
fn (opts: Map): Any {
  ::ctx/mark-secret([opts.client-id, opts.secret])
  null
}

mark-tokens
meta {
    doc: """Mask a request or response body's `access_token`, `public_token` and `link_token` in this run's call records. Returns the body unchanged."""
}
fn (body: Any): Any {
  if(is-map(body), ::ctx/mark-secret(filter-keys(body, in(%, TOKEN_FIELDS))))
  body
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

build-request
meta {
    doc: """The outgoing `HttpRequest` from resolved settings (see `resolve`), with the credentials in the JSON body. Pure; exposed for testing."""
}
fn (path: Str, body: Map, resolved: Map): HttpRequest {
  HttpRequest({
    method: "POST",
    url: `${resolved.base-url}${path}`,
    headers: {
      Content-Type: "application/json",
      Plaid-Version: resolved.plaid-version,
      User-Agent: "hot-dev-plaid-pkg"
    },
    body: to-json(untype(with-credentials(body, resolved.client-id, resolved.secret)))
  })
}

post
meta {
    doc: """
    POST a Plaid endpoint with credentials injected into the body and the
    `Plaid-Version` header set. Returns the decoded JSON body on 2xx, or
    an Err carrying `HttpError`. The escape hatch for endpoints not
    wrapped by this package.

    **Example**

    ```hot
    out ::plaid::api/post("/categories/get", {})

    // For another Plaid client
    out ::plaid::api/post("/categories/get", {}, {client-id: "tenant-id", secret: "tenant-secret"})
    ```
    """
}
fn
(path: Str, body: Map): Any {
  post(path, body, {})
},
// 3-arity: per-call credentials and settings (see `resolve`)
(path: Str, body: Map, opts: Map): Any {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => {
      mark-tokens(body)
      response ::hot::http/request(build-request(path, body, resolved))
      cond {
        is-err(response) => { response }
        is-ok-response(response) => { mark-tokens(response.body) }
        => { err(HttpError(response)) }
      }
    }
  }
},
// 4-arity: explicit credentials (environment still from `plaid.env`)
(path: Str, body: Map, client-id: Str, secret: Str): Any {
  post(path, body, {client-id: client-id, secret: secret})
},
// 5-arity: explicit credentials and environment ("sandbox" or "production")
(path: Str, body: Map, client-id: Str, secret: Str, env: Str): Any {
  post(path, body, {client-id: client-id, secret: secret, environment: env})
}
