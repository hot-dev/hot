GetThreadMemberRequest type {
  channel_id: Str,
  user_id: Str,
  with_member: Bool?
}

get-thread-member
meta {
    doc: """GET /channels/{channel_id}/thread-members/{user_id} - One thread member; `with_member: true` adds the guild member object."""
}
fn (request: GetThreadMemberRequest): Map {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/thread-members/${seg(request.user_id)}`, {
    query: {with_member: request.with_member}
  })
}

ListThreadMembersRequest type {
  channel_id: Str,
  with_member: Bool?,
  after: Str?,
  limit: Int?
}

list-thread-members
meta {
    doc: """GET /channels/{channel_id}/thread-members - Thread members (up to `limit`, 1-100). Page with `after` (a user id) when `with_member` is true. Needs the GUILD_MEMBERS intent."""
}
fn (request: ListThreadMembersRequest): Vec<Map> {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/thread-members`, {
    query: {with_member: request.with_member, after: request.after, limit: request.limit}
  })
}

ListActiveThreadsRequest type {
  guild_id: Str
}

list-active-threads
meta {
    doc: """GET /guilds/{guild_id}/threads/active - Every active thread in a guild the bot can see. Returns `{threads, members}`."""
}
fn (request: ListActiveThreadsRequest): Map {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/threads/active`)
}

ListArchivedThreadsRequest type {
  channel_id: Str,
  before: Str?,
  limit: Int?
}

list-public-archived-threads
meta {
    doc: """GET /channels/{channel_id}/threads/archived/public - Archived public threads, newest first. `before` is an ISO8601 timestamp. Returns `{threads, members, has_more}`. Needs READ_MESSAGE_HISTORY."""
}
fn (request: ListArchivedThreadsRequest): Map {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/threads/archived/public`, {
    query: {before: request.before, limit: request.limit}
  })
}

list-private-archived-threads
meta {
    doc: """GET /channels/{channel_id}/threads/archived/private - Archived private threads. `before` is an ISO8601 timestamp. Returns `{threads, members, has_more}`. Needs READ_MESSAGE_HISTORY and MANAGE_THREADS."""
}
fn (request: ListArchivedThreadsRequest): Map {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/threads/archived/private`, {
    query: {before: request.before, limit: request.limit}
  })
}
