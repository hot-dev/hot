config-set
meta {
    doc: """
    admin.apps.config.set - Set app configuration. `domain_restrictions: {urls?, emails?}`; `workflow_auth_strategy`: `builder_choice` or `end_user_only`.

    Scope: `admin.apps:write`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.

    **Example**

    ```hot
    ::apps ::slack::admin::apps

    ::apps/config-set(::apps/ConfigSetRequest({
      app_id: "A0123ABCDEF",
      domain_restrictions: {urls: ["https://example.com"]},
      workflow_auth_strategy: "end_user_only"
    }))
    ```
    """
}
fn
(request: ConfigSetRequest): Map {
  config-set(request, {})
},
(request: ConfigSetRequest, opts: Map): Map {
  ::api/call("admin.apps.config.set", request, opts)
}
