files-remote-share
meta {
    doc: """
    GET /files.remote.share - Share a remote file into a channel. Pass a
    comma-separated list of channel IDs in `channels`.

    **Example**

    ```hot
    response ::slack::files/files-remote-share(::slack::files/FilesRemoteShareRequest({
      external_id: "report-42",
      channels: "C1234567,C2345678"
    }))
    response.file.id
    ```
    """
}
fn
(request: FilesRemoteShareRequest): FilesRemoteShareResponse {
  files-remote-share(request, {})
},
(request: FilesRemoteShareRequest, opts: Map): FilesRemoteShareResponse {
  response api-request("GET", `${::slack::core/BASE_URL}/files.remote.share?file=${or(request.file, "")}&external_id=${or(request.external_id, "")}&channels=${request.channels}`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { FilesRemoteShareResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

