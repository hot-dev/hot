::elevenlabs::history ns
meta {
    doc: """ElevenLabs generation history: list past generations, download their audio, and delete them."""
}

::api ::elevenlabs::api

list-history
meta {
    ctx: {"elevenlabs.api.key": {required: true}},
    doc: """
    GET /v1/history: past generations, newest first. Returns `{history:
    [...], has_more, last_history_item_id}`; each item has
    `history_item_id`, `voice_id`, `model_id`, `text`, `date_unix`,
    `source`, ... `options` are query params: `page_size` (default
    100, max 1000), `start_after_history_item_id` (pass the previous
    page's `last_history_item_id`), `voice_id`, `model_id`, `search`,
    `source` ("TTS" or "STS"), `date_before_unix`, `date_after_unix`,
    `sort_direction`.

    **Example**

    ```hot
    recent ::elevenlabs::history/list-history({page_size: 10, source: "TTS"})
    map(recent.history, (h) { h.text })
    ```
    """
}
fn
(): Map {
  list-history({})
},
(options: Map): Map {
  ::api/json("GET", `/v1/history${::api/query-string(options)}`)
}

get-history-item
meta {
    ctx: {"elevenlabs.api.key": {required: true}},
    doc: """GET /v1/history/{history_item_id}: one generation's metadata."""
}
fn (history-item-id: Str): Map {
  ::api/json("GET", `/v1/history/${::api/path-segment(history-item-id)}`)
}

get-history-audio
meta {
    ctx: {"elevenlabs.api.key": {required: true}},
    doc: """GET /v1/history/{history_item_id}/audio: the generation's audio as `Bytes`."""
}
fn (history-item-id: Str): Bytes {
  ::api/bytes("GET", `/v1/history/${::api/path-segment(history-item-id)}/audio`)
}

delete-history-item
meta {
    ctx: {"elevenlabs.api.key": {required: true}},
    doc: """DELETE /v1/history/{history_item_id}: delete a generation. Returns `{status: "ok"}`."""
}
fn (history-item-id: Str): Map {
  ::api/json("DELETE", `/v1/history/${::api/path-segment(history-item-id)}`)
}
