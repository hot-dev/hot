get-upgrade-status
meta {
    doc: """
    Get the current database upgrade status.

    **Example**

    ```hot
    ::databases ::supabase::admin::databases

    upgrade ::databases/get-upgrade-status("my-project-ref")
    upgrade.databaseUpgradeStatus
    ```
    """
}
fn
(project-ref: Str): Map {
  get-upgrade-status(project-ref, {})
},
(project-ref: Str, opts: Map): Map {
  ::api/request("GET", `/projects/${project-ref}/upgrade/status`, {}, {}, opts)
}

list-available-versions
meta {
    doc: """
    List available Postgres versions for upgrade.

    **Example**

    ```hot
    ::databases ::supabase::admin::databases

    eligibility ::databases/list-available-versions("my-project-ref")
    eligibility.target_upgrade_versions
    ```
    """
}
fn
(project-ref: Str): Map {
  list-available-versions(project-ref, {})
},
(project-ref: Str, opts: Map): Map {
  ::api/request("GET", upgrade-eligibility-path(project-ref), {}, {}, opts)
}
