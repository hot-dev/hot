::deepgram::test::opts ns
meta ["test"]

// Hermetic: no network and no deepgram.* context.

::dg ::deepgram
::api ::deepgram::api
::cb ::deepgram::callbacks

OFFLINE {api-key: "tenant-key", base-url: "http://127.0.0.1:1"}

// Nothing listens on port 1, so a call fails at the socket, with the URL
// in the error. That error proves the call got past the credential check
// and used this `opts`, without any network traffic.
reaches fn (result: Result): Bool {
    and(is-err(result), contains(err-message(result), "127.0.0.1:1"))
}

test-resolve-opts-override-ctx
meta ["test"] fn () {
    r ::api/resolve-from({api-key: "opt-key", base-url: "https://proxy.example/dg/", callback-secret: "opt-secret"},
        {"deepgram.api.key": "ctx-key", "deepgram.callback.secret": "ctx-secret"})
    assert-eq("opt-key", r.api-key)
    assert-eq("https://proxy.example/dg", r.base-url, "the trailing slash goes")
    assert-eq("opt-secret", r.callback-secret)
}

test-resolve-ctx-used-when-opts-empty
meta ["test"] fn () {
    r ::api/resolve-from({}, {"deepgram.api.key": "ctx-key", "deepgram.callback.secret": "ctx-secret"})
    assert-eq("ctx-key", r.api-key)
    assert-eq("https://api.deepgram.com", r.base-url)
    assert-eq("ctx-secret", r.callback-secret)
}

test-resolve-missing-credential-is-a-clear-error
meta ["test"] fn () {
    out ::api/resolve-from({}, {})
    assert(is-err(out))
    assert(contains(err-message(out), "deepgram.api.key"))
}

test-resolve-returns-marked-values-unchanged
meta ["test"] fn () {
    r ::api/resolve({api-key: "call-key-value", callback-secret: "call-secret-value"})
    assert-eq("call-key-value", r.api-key)
    assert-eq("call-secret-value", r.callback-secret)
}

test-resolve-never-writes-ctx
meta ["test"] fn () {
    before ::hot::ctx/get("deepgram.api.key")
    assert-eq("call-key", ::api/resolve({api-key: "call-key"}).api-key)
    assert(reaches(::dg/list-models(OFFLINE)))
    assert-eq(before, ::hot::ctx/get("deepgram.api.key"))
}

test-blank-credential-in-opts-is-an-error
meta ["test"] fn () {
    ctx {"deepgram.api.key": "ctx-key", "deepgram.callback.secret": "ctx-secret"}
    results map([{api-key: ""}, {api-key: "   "}, {api-key: null}], (o) {
        out ::api/resolve-from(o, ctx)
        assert(is-err(out), "never falls back to deepgram.api.key")
        assert(contains(err-message(out), "api-key"))
        true
    })
    assert-eq(3, length(results))
    assert(contains(err-message(::api/resolve-from({api-key: "k", callback-secret: ""}, ctx)), "callback-secret"))
    assert(is-err(::dg/speak("hi", {}, {api-key: ""})), "the error reaches the caller")
}

test-base-url-without-credential-is-an-error
meta ["test"] fn () {
    out ::api/resolve-from({base-url: "https://collector.example"}, {"deepgram.api.key": "ctx_secret_key"})
    assert(is-err(out), "the context key must not go to a per-call URL")
    assert(contains(err-message(out), "base-url"))
    assert(contains(err-message(out), "api-key"))
    assert(not(contains(err-message(out), "ctx_secret_key")), "the key stays out of messages")
    assert-eq("https://collector.example", ::api/resolve-from({base-url: "https://collector.example", api-key: "tenant"}, {"deepgram.api.key": "ctx_secret_key"}).base-url)
    assert-eq("ctx_secret_key", ::api/resolve-from({base-url: ""}, {"deepgram.api.key": "ctx_secret_key"}).api-key, "a blank base-url is the default root")
}

test-base-url-without-credential-sends-nothing
meta ["test"] fn () {
    before ::hot::ctx/get("deepgram.api.key")
    ::hot::ctx/set-secret("deepgram.api.key", "ctx_secret_key")
    assert-eq("ctx_secret_key", ::api/resolve({}).api-key, "control: the live context key is set")
    out ::dg/transcribe-url("https://example.com/a.wav", {}, {base-url: "http://127.0.0.1:1"})
    assert(is-err(out))
    assert(contains(err-message(out), "base-url"))
    assert(not(reaches(out)), "no request was attempted: the failure isn't the socket")
    assert(reaches(::dg/transcribe-url("https://example.com/a.wav", {}, OFFLINE)), "control: with a credential it reaches the socket")
    ::hot::ctx/set-secret("deepgram.api.key", before)
}

test-per-call-url-keeps-the-context-callback-secret-out
meta ["test"] fn () {
    ctx {"deepgram.api.key": "ctx-key", "deepgram.callback.secret": "ctx-secret"}
    assert(is-null(::api/resolve-from(OFFLINE, ctx).callback-secret))
    assert-eq("own-secret", ::api/resolve-from({...OFFLINE, callback-secret: "own-secret"}, ctx).callback-secret)
}

test-build-request
meta ["test"] fn () {
    bare ::api/build-request("GET", "/v1/models", "", "", ::api/resolve-from({api-key: "a"}, {}))
    assert-eq("https://api.deepgram.com/v1/models", bare.url)
    assert-eq("Token a", bare.headers.Authorization)
    assert(is-null(get(bare.headers, "Content-Type")))
    posted ::api/build-request("POST", "/v1/listen", "audio/wav", "x", {api-key: "b", base-url: "https://proxy.example"})
    assert-eq("https://proxy.example/v1/listen", posted.url)
    assert-eq("audio/wav", get(posted.headers, "Content-Type"))
}

test-with-callback-uses-the-resolved-secret
meta ["test"] fn () {
    params ::dg/with-callback({extra: {job: "7"}}, "https://example.com/hook", "s3cret")
    assert-eq(["job:7", "callback_secret:s3cret"], params.extra)
    assert(is-null(::dg/with-callback({}, "https://example.com/hook", null).extra))
}

test-opts-reach-every-function
meta ["test"] fn () {
    audio Bytes("x")
    assert(reaches(::api/json("GET", "/v1/models", "", "", OFFLINE)))
    assert(reaches(::api/bytes("GET", "/v1/models", "", "", OFFLINE)))
    assert(reaches(::api/request("GET", "/v1/models", "", "", OFFLINE)))
    assert(reaches(::dg/transcribe-url("https://example.com/a.wav", {}, OFFLINE)))
    assert(reaches(::dg/transcribe-audio(audio, {}, OFFLINE)))
    assert(reaches(::dg/transcribe-audio(audio, {}, "audio/wav", OFFLINE)))
    assert(reaches(::dg/transcribe-url-async("https://example.com/a.wav", "https://example.com/hook", {}, OFFLINE)))
    assert(reaches(::dg/transcribe-audio-async(audio, "https://example.com/hook", {}, OFFLINE)))
    assert(reaches(::dg/speak("hi", {}, OFFLINE)))
    assert(reaches(::dg/speak-flux("hi", "flux-alexis-en", {}, OFFLINE)))
    assert(reaches(::dg/list-models(OFFLINE)))
    assert(reaches(::dg/list-models(true, OFFLINE)))
}

test-explicit-key-arity-still-works
meta ["test"] fn () {
    out ::api/request("GET", "/v1/models", "", "", "")
    assert(is-err(out), "a blank explicit key is an error")
    assert(contains(err-message(out), "api-key"))
}

test-existing-arity-reads-ctx
meta ["test"] fn () {
    before ::hot::ctx/get("deepgram.api.key")
    ::hot::ctx/set("deepgram.api.key", "")
    out ::dg/speak("hi")
    assert(is-err(out))
    assert(contains(err-message(out), "deepgram.api.key"))
    ::hot::ctx/set("deepgram.api.key", before)
}

test-verifier-marks-and-keeps-working
meta ["test"] fn () {
    body `{"metadata":{"extra":{"callback_secret":"a-callback-secret"}}}`
    request {headers: {}, body-raw: body}
    assert(::cb/verify-callback(request, "a-callback-secret"))
    assert(not(::cb/verify-callback(request, null)), "a null secret never verifies")
    assert(not(::cb/verify-callback(request, "   ")), "a blank secret never verifies")
    assert(not(::cb/verify-basic-auth({headers: {authorization: "Basic Og=="}}, null, null)), "null credentials never verify")
}
