::intercom::tickets ns
meta {
    ctx: {"intercom.token": {required: false}},
    doc: """
    Tickets: list ticket types, create, read, update, and search with
    `starting_after` paging. A ticket's type decides its
    `ticket_attributes` (default `_default_title_` and
    `_default_description_`, plus any custom attributes the type defines).
    """
}

::api ::intercom::api

list-ticket-types
meta {
    doc: """
    GET /ticket_types - The workspace's ticket types (including archived
    ones) with their attributes: `{type: "list", data: [...]}`.

    **Example**

    ```hot
    types ::intercom::tickets/list-ticket-types()
    map(types.data, %.name)
    ```
    """
}
fn
(): Any {
  list-ticket-types({})
},
(opts: Map): Any {
  ::api/request("GET", "/ticket_types", "", opts)
}

get-ticket-type
meta {
    doc: """
    GET /ticket_types/{id} - One ticket type with its attribute definitions.

    **Example**

    ```hot
    type-info ::intercom::tickets/get-ticket-type("1234")
    type-info.name
    ```
    """
}
fn
(id: Str): Any {
  get-ticket-type(id, {})
},
(id: Str, opts: Map): Any {
  ::api/request("GET", `/ticket_types/${::api/path-segment(id)}`, "", opts)
}

build-create-body
meta {
    doc: """
    Build the create body: `ticket_type_id`, `contacts` (`[{id}]`,
    `[{external_id}]` or `[{email}]`), plus `options` (`ticket_attributes`,
    `company_id`, `conversation_to_link_id`, `assignment:
    {admin_assignee_id, team_assignee_id}`, `created_at`). Unset options are
    omitted. Exposed for testing.

    **Example**

    ```hot
    ::intercom::tickets/build-create-body("1234", [{email: "ada@example.com"}], {company_id: "acme-42"})
    // {company_id: "acme-42", ticket_type_id: "1234", contacts: [{email: "ada@example.com"}]}
    ```
    """
}
fn (ticket-type-id: Str, contacts: Vec, options: Map): Map {
  ::api/compact({...options, ticket_type_id: ticket-type-id, contacts: contacts})
}

create-ticket
meta {
    doc: """
    POST /tickets - Create a ticket.

    **Example**

    ```hot
    ::intercom::tickets/create-ticket("1234", [{email: "ada@example.com"}], {
      ticket_attributes: {_default_title_: "Export fails", _default_description_: "CSV export times out after 30s."}
    })
    ```
    """
}
fn
(ticket-type-id: Str, contacts: Vec): Any {
  create-ticket(ticket-type-id, contacts, {})
},
(ticket-type-id: Str, contacts: Vec, options: Map): Any {
  create-ticket(ticket-type-id, contacts, options, {})
},
(ticket-type-id: Str, contacts: Vec, options: Map, opts: Map): Any {
  ::api/request("POST", "/tickets", build-create-body(ticket-type-id, contacts, options), opts)
}

get-ticket
meta {
    doc: """
    GET /tickets/{id} - One ticket.

    **Example**

    ```hot
    ticket ::intercom::tickets/get-ticket("6031")
    ticket.ticket_attributes
    ```
    """
}
fn
(id: Str): Any {
  get-ticket(id, {})
},
(id: Str, opts: Map): Any {
  ::api/request("GET", `/tickets/${::api/path-segment(id)}`, "", opts)
}

update-ticket
meta {
    doc: """
    PUT /tickets/{id} - Update `ticket_attributes`, `ticket_state_id`,
    `open`, `is_shared`, `snoozed_until`, `company_id`, or assignment
    (`admin_id` performing it plus `assignee_id`). Unset fields are omitted.

    **Example**

    ```hot
    ::intercom::tickets/update-ticket("6031", {
      ticket_attributes: {_default_title_: "Export fails on large files"},
      open: true
    })
    ```
    """
}
fn
(id: Str, changes: Map): Any {
  update-ticket(id, changes, {})
},
(id: Str, changes: Map, opts: Map): Any {
  ::api/request("PUT", `/tickets/${::api/path-segment(id)}`, ::api/compact(changes), opts)
}

list-ticket-states
meta {
    doc: """
    GET /ticket_states - The workspace's ticket states (ids for
    `update-ticket`'s `ticket_state_id`).

    **Example**

    ```hot
    states ::intercom::tickets/list-ticket-states()
    map(states.data, %.id)
    ```
    """
}
fn
(): Any {
  list-ticket-states({})
},
(opts: Map): Any {
  ::api/request("GET", "/ticket_states", "", opts)
}

search-tickets
meta {
    doc: """
    POST /tickets/search - One page of tickets matching a query (`{field,
    operator, value}` or an `AND`/`OR` combinator over fields like `state`,
    `ticket_type_id`, `admin_assignee_id`, `created_at`). `options`:
    `per_page`, `starting_after`. Returns `{tickets, pages, total_count}`.

    **Example**

    ```hot
    page ::intercom::tickets/search-tickets({field: "ticket_type_id", operator: "=", value: "1234"}, {per_page: 50})
    length(page.tickets)
    ```
    """
}
fn
(query: Map): Any {
  search-tickets(query, {})
},
(query: Map, options: Map): Any {
  search-tickets(query, options, {})
},
(query: Map, options: Map, opts: Map): Any {
  ::api/request("POST", "/tickets/search", ::api/build-search-body(query, options), opts)
}

search-all-tickets
meta {
    doc: """
    Run `search-tickets` across pages until `limit` tickets or the last
    page. Returns a Vec.

    **Example**

    ```hot
    tickets ::intercom::tickets/search-all-tickets({field: "ticket_type_id", operator: "=", value: "1234"}, 500)
    length(tickets)
    ```
    """
}
fn
(query: Map, limit: Int): Vec {
  search-all-tickets(query, limit, {})
},
(query: Map, limit: Int, opts: Map): Vec {
  ::api/collect-pages(
    (cursor) { search-tickets(query, {per_page: ::api/page-size(limit), starting_after: cursor}, opts) },
    "tickets", null, limit, []
  )
}
