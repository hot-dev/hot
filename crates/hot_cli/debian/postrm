#!/bin/sh
set -e

# postrm script for hot

# postinst writes these completions, so dpkg doesn't know about them. On an
# upgrade, postinst writes them again.
case "$1" in
  remove|purge)
    rm -f /usr/share/zsh/vendor-completions/_hot \
      /etc/bash_completion.d/hot \
      /usr/share/fish/vendor_completions.d/hot.fish \
      /usr/local/share/fish/vendor_completions.d/hot.fish
    ;;
esac

exit 0
