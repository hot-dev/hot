retrieve-list-broadcasts
meta {
    doc: """
    Retrieve all broadcasts in your Resend account, including draft,
    scheduled, and sent.

    **Example**

    ```hot
    broadcasts ::resend::broadcasts/retrieve-list-broadcasts(::resend::broadcasts/GETBroadcastsRequest({}))
    map(broadcasts.data, %.status)
    ```
    """
}
fn
(request: GETBroadcastsRequest): GETBroadcastsResponse {
  retrieve-list-broadcasts(request, {})
},
(request: GETBroadcastsRequest, opts: Map): GETBroadcastsResponse {
  response api-request("GET", `${::resend/BASE_URL}/broadcasts`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { GETBroadcastsResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

