::increase::transactions ns
meta {
    doc: """
    The ledger of an account: Transactions (settled, immutable movements
    of money), Pending Transactions (holds and in-flight transfers, which
    reduce the available balance) and Declined Transactions (attempts
    Increase refused, such as a declined card authorization or a
    returned inbound ACH). Amounts are in the minor unit (cents); each
    object's `source` says what produced it.
    """
}

::api ::increase::api
seg ::increase::api/seg

list-transactions
meta {
    doc: """
    GET /transactions: one page of Transactions, newest first. Filters:
    `account_id`, `route_id` (an account number or card id),
    `"category.in"` (e.g. `["ach_transfer_intention", "card_settlement"]`),
    `created_at: {after, before, on_or_after, on_or_before}`, `limit`,
    `cursor`.

    **Example**

    ```hot
    recent ::increase::transactions/list-transactions({account_id: "account_in71c4amph0vgo2qllky", limit: 25})
    ```
    """
}
fn
(): Map {
  list-transactions({})
},
(params: Map): Map {
  list-transactions(params, {})
},
(params: Map, opts: Map): Map {
  ::api/list-page("/transactions", params, opts)
}

get-transaction
meta {
    doc: """
    GET /transactions/{transaction_id}: retrieve a Transaction.

    **Example**

    ```hot
    transaction ::increase::transactions/get-transaction("transaction_uyrp7fld2ium70oa7oi")
    transaction.amount
    transaction.source
    ```
    """
}
fn
(transaction-id: Str): Map {
  get-transaction(transaction-id, {})
},
(transaction-id: Str, opts: Map): Map {
  ::api/call("GET", `/transactions/${seg(transaction-id)}`, {}, opts)
}

list-pending-transactions
meta {
    doc: """
    GET /pending_transactions: one page of Pending Transactions. Filters:
    `account_id`, `route_id`, `"category.in"`, `"status.in"` (`pending`,
    `complete`), `created_at`, `limit`, `cursor`.

    **Example**

    ```hot
    page ::increase::transactions/list-pending-transactions({account_id: "account_in71c4amph0vgo2qllky", "status.in": ["pending"]})
    map(page.data, %.id)
    ```
    """
}
fn
(): Map {
  list-pending-transactions({})
},
(params: Map): Map {
  list-pending-transactions(params, {})
},
(params: Map, opts: Map): Map {
  ::api/list-page("/pending_transactions", params, opts)
}

get-pending-transaction
meta {
    doc: """
    GET /pending_transactions/{pending_transaction_id}: retrieve a Pending
    Transaction.

    **Example**

    ```hot
    pending ::increase::transactions/get-pending-transaction("pending_transaction_k1sfetcau2qbvjbzgju4")
    pending.status
    pending.amount
    ```
    """
}
fn
(pending-transaction-id: Str): Map {
  get-pending-transaction(pending-transaction-id, {})
},
(pending-transaction-id: Str, opts: Map): Map {
  ::api/call("GET", `/pending_transactions/${seg(pending-transaction-id)}`, {}, opts)
}

