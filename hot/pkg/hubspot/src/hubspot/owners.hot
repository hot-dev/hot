::hubspot::owners ns
meta {
    doc: """Owners: the HubSpot users (and queues) that records can be assigned to via `hubspot_owner_id`."""
}

::api ::hubspot::api
crm-path ::hubspot::api/crm-path
segment ::hubspot::api/segment
query-string ::hubspot::api/query-string

list-owners
meta {
    doc: """
    GET /crm/owners/{version} - One page of owners: `{results: [{id, email,
    firstName, lastName, userId, type, teams, archived}], paging?}`.
    `params`: `email` (exact match), `limit` (max 500), `after`, `archived`.

    **Example**

    ```hot
    page ::hubspot::owners/list-owners({limit: 100})
    map(page.results, %.email)
    ```
    """
}
fn
(): Map {
  list-owners({})
},
(params: Map): Map {
  list-owners(params, {})
},
(params: Map, opts: Map): Map {
  ::api/json("GET", crm-path("owners", query-string(params), opts), opts)
}

get-owner
meta {
    doc: """
    GET /crm/owners/{version}/{ownerId} - One owner by owner id. The 2-arity
    form looks up by `"userId"` instead (`id-property` is `"id"` or
    `"userId"`).

    **Example**

    ```hot
    owner ::hubspot::owners/get-owner("123")
    owner.email

    // By user id
    ::hubspot::owners/get-owner("456", "userId")
    ```
    """
}
fn
(owner-id: Str): Map {
  get-owner(owner-id, {})
},
(owner-id: Str, opts: Map): Map {
  ::api/json("GET", crm-path("owners", `/${segment(owner-id)}`, opts), opts)
},
(owner-id: Str, id-property: Str): Map {
  get-owner(owner-id, id-property, {})
},
(owner-id: Str, id-property: Str, opts: Map): Map {
  ::api/json("GET", crm-path("owners", `/${segment(owner-id)}${query-string({idProperty: id-property})}`, opts), opts)
}

find-owner-by-email
meta {
    doc: """
    The owner with this email, or null. Use its `id` as a record's `hubspot_owner_id`.

    **Example**

    ```hot
    owner ::hubspot::owners/find-owner-by-email("rep@example.com")
    if(is-some(owner), ::hubspot::contacts/update-contact("12345", {hubspot_owner_id: owner.id}), null)
    ```
    """
}
fn
(email: Str): Any {
  find-owner-by-email(email, {})
},
(email: Str, opts: Map): Any {
  page list-owners({email: email, limit: 1}, opts)
  cond {
    is-err(page) => { page }
    is-empty(or(get(page, "results"), [])) => { null }
    => { first(page.results) }
  }
}
