::hubspot::companies ns

::objects ::hubspot::objects

create-company
meta {
    doc: """
    Create a company from a properties Map (`name`, `domain`, `industry`,
    ...).

    **Example**

    ```hot
    company ::hubspot::companies/create-company({name: "Acme", domain: "acme.com"})
    company.id

    // Another portal's token for this call
    ::hubspot::companies/create-company({name: "Acme"}, {token: ::hot::ctx/get("tenant.hubspot.token")})
    ```
    """
}
fn
(properties: Map): Map {
  create-company(properties, {})
},
(properties: Map, opts: Map): Map {
  ::objects/create-object("companies", properties, opts)
}

get-company
meta {
    doc: """
    Fetch a company by id; the 2-arity form selects `properties`.

    **Example**

    ```hot
    company ::hubspot::companies/get-company("12345", ["name", "domain"])
    company.properties.name
    ```
    """
}
fn
(id: Str): Map {
  get-company(id, {})
},
(id: Str, opts: Map): Map {
  ::objects/get-object("companies", id, opts)
},
(id: Str, properties: Vec): Map {
  get-company(id, properties, {})
},
(id: Str, properties: Vec, opts: Map): Map {
  ::objects/get-object("companies", id, properties, {}, opts)
}

update-company
meta {
    doc: """
    Update a company's properties.

    **Example**

    ```hot
    ::hubspot::companies/update-company("12345", {industry: "COMPUTER_SOFTWARE"})
    ```
    """
}
fn
(id: Str, properties: Map): Map {
  update-company(id, properties, {})
},
(id: Str, properties: Map, opts: Map): Map {
  ::objects/update-object("companies", id, properties, opts)
}

find-by-domain
meta {
    doc: """
    Search for a company by exact domain. Returns the company or null.

    **Example**

    ```hot
    company ::hubspot::companies/find-by-domain("acme.com")
    if(is-some(company), company.id, null)
    ```
    """
}
fn
(domain: Str): Any {
  find-by-domain(domain, {})
},
(domain: Str, opts: Map): Any {
  out ::objects/search-objects("companies", {
    filters: [{propertyName: "domain", operator: "EQ", value: domain}],
    limit: 1
  }, opts)
  cond {
    is-err(out) => { out }
    is-empty(out.results) => { null }
    => { first(out.results) }
  }
}

search-companies
meta {
    doc: """
    Search companies — see `::hubspot::objects/build-search-body` for the
    options.

    **Example**

    ```hot
    out ::hubspot::companies/search-companies({
      filters: [{propertyName: "industry", operator: "EQ", value: "COMPUTER_SOFTWARE"}],
      properties: ["name", "domain"],
      limit: 50
    })
    map(out.results, %.id)
    ```
    """
}
fn
(options: Map): Map {
  search-companies(options, {})
},
(options: Map, opts: Map): Map {
  ::objects/search-objects("companies", options, opts)
}

archive-company
meta {
    doc: """
    Archive a company (recycle bin, restorable for 90 days).

    **Example**

    ```hot
    ::hubspot::companies/archive-company("12345")
    ```
    """
}
fn
(id: Str): Any {
  archive-company(id, {})
},
(id: Str, opts: Map): Any {
  ::objects/archive-object("companies", id, opts)
}
