// ============================================================================
// Dialog
// ============================================================================

DialogOpenRequest type {
  dialog: Str,
  trigger_id: Str
}

DialogOpenResponse type {
  ok: Bool?,
  error: Str?
}


dialog-open
meta {
    doc: """
    GET /dialog.open - Open a dialog with a user. Requires a valid
    `trigger_id` from an interactive event. The `dialog` parameter is a
    JSON-encoded dialog definition.

    **Example**

    ```hot
    dialog to-json({
      callback_id: "feedback",
      title: "Feedback",
      elements: [{type: "text", label: "Comment", name: "comment"}]
    })

    response ::slack::misc/dialog-open(::slack::misc/DialogOpenRequest({
      dialog: dialog,
      trigger_id: "13345224609.738474920.8088930838d88f008e0"
    }))
    response.ok
    ```
    """
}
fn
(request: DialogOpenRequest): DialogOpenResponse {
  dialog-open(request, {})
},
(request: DialogOpenRequest, opts: Map): DialogOpenResponse {
  response api-request("GET", ::slack::api/with-query(`${::slack::core/BASE_URL}/dialog.open`, {dialog: request.dialog, trigger_id: request.trigger_id}), {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { DialogOpenResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

