remove-existing-broadcast-that-is-draft-status
meta {
    doc: """
    Remove an existing broadcast. Only broadcasts in draft status can be
    deleted.

    **Example**

    ```hot
    result ::resend::broadcasts/remove-existing-broadcast-that-is-draft-status(::resend::broadcasts/DELETEBroadcastsIdRequest({id: "49a3999c-0ce1-4ea6-ab68-afcd6dc2e794"}))
    result.deleted
    ```
    """
}
fn
(request: DELETEBroadcastsIdRequest): DELETEBroadcastsIdResponse {
  remove-existing-broadcast-that-is-draft-status(request, {})
},
(request: DELETEBroadcastsIdRequest, opts: Map): DELETEBroadcastsIdResponse {
  response api-request("DELETE", `${::resend/BASE_URL}/broadcasts/${request.id}`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { DELETEBroadcastsIdResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

POSTBroadcastsIdSendRequest type {
    scheduled_at: Str?
}

POSTBroadcastsIdSendResponse type {
    id: Str?
}


send-or-schedule-broadcast
meta {
    doc: """
    Send a broadcast immediately or schedule it for later delivery via
    scheduled_at.

    **Example**

    ```hot
    // Send now
    ::resend::broadcasts/send-or-schedule-broadcast("49a3999c-0ce1-4ea6-ab68-afcd6dc2e794", ::resend::broadcasts/POSTBroadcastsIdSendRequest({}))

    // Or schedule it
    scheduled ::resend::broadcasts/send-or-schedule-broadcast("49a3999c-0ce1-4ea6-ab68-afcd6dc2e794", ::resend::broadcasts/POSTBroadcastsIdSendRequest({
        scheduled_at: "2026-12-01T09:00:00Z"
    }))
    scheduled.id
    ```
    """
}
fn
(id: Str, request: POSTBroadcastsIdSendRequest): POSTBroadcastsIdSendResponse {
  send-or-schedule-broadcast(id, request, {})
},
(id: Str, request: POSTBroadcastsIdSendRequest, opts: Map): POSTBroadcastsIdSendResponse {
  response api-request("POST", `${::resend/BASE_URL}/broadcasts/${id}/send`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { POSTBroadcastsIdSendResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
