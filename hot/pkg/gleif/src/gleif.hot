}

direct-parent-exception
meta {
    doc: """Why no direct parent is reported (`attributes.reason`, e.g. `NATURAL_PERSONS`, `NON_CONSOLIDATING`), or null."""
}
fn
(lei: Str): Map? {
  direct-parent-exception(lei, {})
},
(lei: Str, opts: Map): Map? {
  out get-or-null(`${lei-path(lei)}/direct-parent-reporting-exception`, opts)
  if(is-null(out), null, get(out, "data"))
}

ultimate-parent-exception
meta {
    doc: """Why no ultimate parent is reported, or null."""
}
fn
(lei: Str): Map? {
  ultimate-parent-exception(lei, {})
},
(lei: Str, opts: Map): Map? {
  out get-or-null(`${lei-path(lei)}/ultimate-parent-reporting-exception`, opts)
  if(is-null(out), null, get(out, "data"))
}

direct-children
meta {
    doc: """One page of the entities directly consolidated by `lei` (LEI records)."""
}
fn
(lei: Str): Map {
  direct-children(lei, {})
},
(lei: Str, opts: Map): Map {
  gleif-get(`${lei-path(lei)}/direct-children`, page-params(opts), opts)
}

ultimate-children
meta {
    doc: """One page of the entities ultimately consolidated by `lei` (LEI records)."""
}
fn
(lei: Str): Map {
  ultimate-children(lei, {})
},
(lei: Str, opts: Map): Map {
  gleif-get(`${lei-path(lei)}/ultimate-children`, page-params(opts), opts)
}

// ---------------------------------------------------------------------------
// Pagination
// ---------------------------------------------------------------------------

next-page
meta {
    doc: """The page number after `page` from `meta.pagination` (`currentPage` < `lastPage`), or null on the last page (pure)."""
}
fn (page: Any): Int? {
  p get-in(or(page, {}), ["meta", "pagination"])
  current get(or(p, {}), "currentPage")
  last-page get(or(p, {}), "lastPage")
  cond {
    or(is-null(current), is-null(last-page)) => { null }
    lt(current, last-page) => { add(current, 1) }
    => { null }
  }
}

collect-pages fn (fetch: Fn, page-number: Int?, limit: Int, acc: Vec): Vec {
  page fetch(page-number)
  items or(get(page, "data"), [])
  combined concat(acc, items)
  next next-page(page)
  cond {
    gte(length(combined), limit) => { slice(combined, 0, limit) }
    is-empty(items) => { combined }
    is-null(next) => { combined }
    => { collect-pages(fetch, next, limit, combined) }
  }
}

collect
meta {
    doc: """
    Follow pages of a paginated GLEIF call until `limit` items or the
    last page. `fetch` takes `opts` (with `page` and `page-size` set)
    and returns one page.

    **Example**

    ```hot
    ::gleif ::gleif
    kids ::gleif/collect((o) { ::gleif/direct-children("HWUPKR0MPOU8FGXBT394", o) }, {}, 500)
    ```
    """
}
fn (fetch: Fn, opts: Map, limit: Int): Vec {
  size min(MAX_PAGE_SIZE, max(1, limit))
  collect-pages((n) { fetch({...opts, page-size: size, page: or(n, 1)}) }, null, limit, [])
}
