StartThreadFromMessageRequest type {
  channel_id: Str,
  message_id: Str,
  name: Str,
  auto_archive_duration: Int?,
  rate_limit_per_user: Int?,
  reason: Str?
}

start-thread-from-message
meta {
    doc: """
    POST /channels/{channel_id}/messages/{message_id}/threads - Start a
    thread on an existing message. `auto_archive_duration` is 60, 1440, 4320
    or 10080 minutes.

    **Example**

    ```hot
    ::channels ::discord::channels

    thread ::channels/start-thread-from-message(::channels/StartThreadFromMessageRequest({
      channel_id: "1100000000000000000",
      message_id: "1200000000000000000",
      name: "Deploy discussion",
      auto_archive_duration: 1440
    }))
    thread.id
    ```
    """
}
fn
(request: StartThreadFromMessageRequest): Map {
  start-thread-from-message(request, {})
},
(request: StartThreadFromMessageRequest, opts: Map): Map {
  ::api/call("POST", `/channels/${seg(request.channel_id)}/messages/${seg(request.message_id)}/threads`, {
    body: ::api/body(request, ["channel_id", "message_id"]),
    reason: request.reason
  }, opts)
}

StartThreadWithoutMessageRequest type {
  channel_id: Str,
  name: Str,
  auto_archive_duration: Int?,
  type: Int?,
  invitable: Bool?,
  rate_limit_per_user: Int?,
  reason: Str?
}

start-thread-without-message
meta {
    doc: """
    POST /channels/{channel_id}/threads - Start a thread with no starter
    message. `type` 11 = public, 12 = private (the default is private, so
    set it).

    **Example**

    ```hot
    ::channels ::discord::channels

    thread ::channels/start-thread-without-message(::channels/StartThreadWithoutMessageRequest({
      channel_id: "1100000000000000000",
      name: "Launch checklist",
      type: 11,
      auto_archive_duration: 4320
    }))
    thread.id
    ```
    """
}
fn
(request: StartThreadWithoutMessageRequest): Map {
  start-thread-without-message(request, {})
},
(request: StartThreadWithoutMessageRequest, opts: Map): Map {
  ::api/call("POST", `/channels/${seg(request.channel_id)}/threads`, {
    body: ::api/body(request, ["channel_id"]),
    reason: request.reason
  }, opts)
}

StartForumThreadRequest type {
  channel_id: Str,
  name: Str,
  message: Map,
  auto_archive_duration: Int?,
  rate_limit_per_user: Int?,
  applied_tags: Vec<Str>?,
  files: Vec<::discord::api/FileUpload>?,
  reason: Str?
}

start-forum-thread
meta {
    doc: """
    POST /channels/{channel_id}/threads - Create a post in a forum or
    media channel. `message` is the first message
    (`{content?, embeds?, components?, allowed_mentions?, sticker_ids?, attachments?, flags?}`);
    `applied_tags` are forum tag ids. `files` are uploaded with it.

    **Example**

    ```hot
    ::channels ::discord::channels

    post ::channels/start-forum-thread(::channels/StartForumThreadRequest({
      channel_id: "1500000000000000000",
      name: "Weekly sync notes",
      message: {content: "Agenda in the thread"}
    }))
    ```
    """
}
fn
(request: StartForumThreadRequest): Map {
  start-forum-thread(request, {})
},
(request: StartForumThreadRequest, opts: Map): Map {
  files or(request.files, [])
  payload ::api/body(request, ["channel_id"])
  message cond {
    and(not(is-empty(files)), is-null(get(request.message, "attachments"))) => {
      assoc(request.message, "attachments", ::api/attachments-for(files))
    }
    => { request.message }
  }

  ::api/call("POST", `/channels/${seg(request.channel_id)}/threads`, {
    body: assoc(payload, "message", message),
    files: files,
    reason: request.reason
  }, opts)
}

