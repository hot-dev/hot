::documents ns
meta {
    doc: """
    Provider-neutral document access for workflows and AI agents: list,
    search, get, download, read as text, upload, and follow changes in
    Google Drive, OneDrive and SharePoint libraries, Dropbox, Box and
    Amazon S3 through one `Document` record and one set of verbs.

    Every call takes a **source descriptor** naming the provider, the
    scope (drive, folder, bucket, ...) and per-source `opts` that pass
    straight through to the provider package (credentials there override
    context for that call, so one run can serve many tenants):

    ```hot
    drive {provider: "google-drive"}
    team {provider: "onedrive", drive: {site: "contoso.sharepoint.com,1111,2222"}, opts: {token: tenant-token}}
    dbx {provider: "dropbox", root: "/Contracts"}
    box {provider: "box", folder-id: "12345"}
    bucket {provider: "s3", bucket: "acme-docs", prefix: "inbox/", opts: {region: "eu-west-1"}}
    ```

    **Namespaces**

    - `::documents` - the types and the verbs below
    - `::documents::source` - descriptor normalising and the opts resolver
    - `::documents::adapters` - one `DocFile -> Document` adapter per provider
    - `::documents::text` - `read-text` format planning and text detection
    - `::documents::cursor` - opaque page and change cursors
    - `::documents::capabilities` - what each provider supports
    - `::documents::webhooks` - turn any provider's notification into "changed"
    - `::documents::google`, `::documents::onedrive`, `::documents::dropbox`,
      `::documents::box`, `::documents::s3` - the per-provider implementations

    **Quick start**

    ```hot
    src {provider: "google-drive"}
    page ::documents/list(src, null, {page-size: 20})
    doc first(page.documents)
    text ::documents/read-text(src, doc.id, "auto")
    text.status   // "ok", "pending" or "unsupported"
    ```
    """
}

::source ::documents::source

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

Document
meta {
    doc: """
    One file or folder in any provider.

    **Fields**
    - `provider` - `"google-drive"`, `"onedrive"`, `"dropbox"`, `"box"` or `"s3"`
    - `source` - the scope it came from, without credentials (e.g.
      `{provider: "onedrive", drive-id: "b!..."}`, `{provider: "s3", bucket: "acme"}`)
    - `id` - the id to pass back to `get`, `download`, `read-text` (Drive and
      Box ids, OneDrive item ids, Dropbox `id:...`, S3 keys)
    - `name`, `path` - the display path when the provider has one (Dropbox,
      OneDrive, Box with `path_collection`, S3), else null (Drive)
    - `parents` - parent folder ids (Dropbox: the parent path; S3: the parent prefix)
    - `kind` - `"file"` or `"folder"`
    - `mime-type` - never empty for files (from the extension when the provider has none)
    - `is-native` - a document with no bytes of its own that must be exported
      (Google Docs/Sheets/Slides, Dropbox Paper)
    - `export-formats` - MIME types the provider can export or convert it to
    - `size` - bytes, or null (folders, native documents)
    - `created`, `modified` - RFC 3339 timestamps (null when the provider has none)
    - `version` - an opaque etag/rev: changes whenever the item changes
    - `hashes` - content hashes by algorithm: `md5`, `sha1`, `sha256`,
      `quickXorHash`, `crc32`, `dropbox-content-hash` (only those the provider gave)
    - `web-url` - the browser link, or null
    - `deleted` - trashed or deleted
    - `raw` - the provider's resource as returned
    """
}
type {
    provider: Str,
    source: Map,
    id: Str,
    name: Str,
    path: Str?,
    parents: Vec,
    kind: Str,
    mime-type: Str,
    is-native: Bool,
    export-formats: Vec,
    size: Int?,
    created: Str?,
    modified: Str?,
    version: Str?,
    hashes: Map,
    web-url: Str?,
    deleted: Bool,
    raw: Map
}

Page
meta {
    doc: """
    One page of a listing: `documents`, and `cursor` (an opaque Str to
    pass back as `opts.cursor` for the next page, null on the last page).
    `has-more` is true when `cursor` is set.
    """
}
type {
    documents: Vec,
    cursor: Str?,
    has-more: Bool
}

FileContent
meta {
    doc: """
    Downloaded content. `bytes` is always the exact response body
    (binary safe); `text` is its UTF-8 decoding when the content is
    textual, else null.

    **Fields**
    - `document-id`, `name`, `mime-type`, `size` (`length(bytes)`)
    - `bytes`, `text`
    - `method` - how it was fetched: `download`, `range`, `chunked`,
      `export`, `export-link`, `convert`, `extracted-text`
    - `document` - the `Document`, when the provider returned its metadata
    """
}
type {
    document-id: Str,
    name: Str?,
    mime-type: Str?,
    size: Int,
    bytes: Bytes,
    text: Str?,
    method: Str,
    document: Document?
}

TextResult
meta {
    doc: """
    The result of `read-text`. It never waits: check `status`.

    - `status` - `"ok"` (text or PDF bytes are here), `"pending"` (the
      provider is still extracting text, e.g. Box: call again later from a
      schedule or a retry), or `"unsupported"` (no native text for this
      file: route `mime-type` to an extraction tool such as
      `hot.dev/pandoc`, `hot.dev/libreoffice` or `hot.dev/tesseract`)
    - `text` - the text (`ok` with a text format)
    - `bytes` - the PDF bytes (`ok` with format `pdf`)
    - `format` - what was produced: `text`, `markdown`, `csv`, `html`,
      `json`, `svg` or `pdf`
    - `mime-type` - of the produced content, or of the file when not `ok`
    - `method` - `export`, `download`, `convert` or `extracted-text`
    - `reason` - why it is `pending` or `unsupported`
    - `document` - the `Document`
    """
}
type {
    status: Str,
    text: Str?,
    bytes: Bytes?,
    format: Str?,
    mime-type: Str?,
    method: Str?,
    reason: Str?,
    document: Document?
}

ChangeSet
meta {
    doc: """
    What changed since a change cursor (`changes`).

    - `documents` - created or updated files and folders (latest state per id)
    - `deleted-ids` - ids removed, trashed or moved out of scope. **Dropbox**
      reports deletions by path only, so its entries are lower-cased paths
      (also in `deleted-paths`); deleting a folder removes everything under it.
    - `deleted-paths` - lower-cased paths of deletions (Dropbox), else empty
    - `next-cursor` - store it and pass it to the next `changes` call
    - `reset-required` - the provider invalidated the old cursor and
      `documents` is a fresh **full** listing: replace your mirror with it
      (delete local ids not in it) instead of merging (OneDrive 410 resync,
      Dropbox cursor reset)
    - `has-more` - more changes are waiting (Box stopped at `max-pages`):
      call `changes` again with `next-cursor` straight away
    """
}
type {
    documents: Vec,
    deleted-ids: Vec,
    deleted-paths: Vec,
    next-cursor: Str,
    reset-required: Bool,
    has-more: Bool
}

// ---------------------------------------------------------------------------
// Verbs
// ---------------------------------------------------------------------------

DEFAULT_PAGE_SIZE 100
DEFAULT_SEARCH_LIMIT 50
MAX_LIST_PAGES 1000

unknown-provider fn (provider: Str): Any {
  err(`documents: unknown provider "${provider}"`)
}

list
meta {
    doc: """
    One page of a folder's direct children as a `Page`. `folder` is a
    folder id (Drive, OneDrive, Box), a path (Dropbox, OneDrive `/path`)
    or a key prefix ending in `/` (S3); null means the source's root
    (Drive `root` or the shared drive, OneDrive `root`, Dropbox `root`,
    Box `folder-id` or `"0"`, S3 `prefix`).

    Options: `cursor` (from the previous page; `folder` is then taken
    from the cursor), `page-size` (default 100; providers may return
    fewer), plus provider options and credentials.

    ```hot
    src {provider: "box", folder-id: "12345"}
    first-page ::documents/list(src)
    next ::documents/list(src, null, {cursor: first-page.cursor})
    ```
    """
}
fn
(source: Any): Page {
  list(source, null, {})
},
(source: Any, folder: Str?): Page {
  list(source, folder, {})
},
(source: Any, folder: Str?, opts: Map): Page {
  src ::source/resolve(source)
  cond {
    is-err(src) => { src }
    eq(src.provider, "google-drive") => { ::documents::google/list(src, folder, opts) }
    eq(src.provider, "onedrive") => { ::documents::onedrive/list(src, folder, opts) }
    eq(src.provider, "dropbox") => { ::documents::dropbox/list(src, folder, opts) }
    eq(src.provider, "box") => { ::documents::box/list(src, folder, opts) }
    eq(src.provider, "s3") => { ::documents::s3/list(src, folder, opts) }
    => { unknown-provider(src.provider) }
  }
}

list-loop fn (source: Map, folder: Str?, opts: Map, limit: Int?, cursor: Str?, acc: Vec, pages: Int): Vec {
  page list(source, folder, if(is-null(cursor), opts, {...opts, cursor: cursor}))
  cond {
    is-err(page) => { page }
    => {
      all concat(acc, page.documents)
      cond {
        and(is-some(limit), gte(length(all), or(limit, 0))) => { slice(all, 0, limit) }
        is-null(page.cursor) => { all }
        gte(pages, MAX_LIST_PAGES) => { all }
        => { list-loop(source, folder, opts, limit, page.cursor, all, add(pages, 1)) }
      }
    }
  }
}

list-all
meta {
    doc: """
    Every direct child of `folder` (all pages), or at most `limit`
    Documents (null for no limit; stops after 1000 pages either way).
    Options as for `list`.

    ```hot
    docs ::documents/list-all({provider: "dropbox", root: "/Contracts"}, null, 500)
    files filter(docs, (d) { eq(d.kind, "file") })
    ```
    """
}
fn
(source: Any): Vec {
  list-all(source, null, null, {})
},
(source: Any, folder: Str?): Vec {
  list-all(source, folder, null, {})
},
(source: Any, folder: Str?, limit: Int?): Vec {
  list-all(source, folder, limit, {})
},
(source: Any, folder: Str?, limit: Int?, opts: Map): Vec {
  src ::source/resolve(source)
  if(is-err(src), src, list-loop(src, folder, opts, limit, ::hot::coll/get(opts, "cursor"), [], 1))
}

search
meta {
    doc: """
    Search with the provider's native search and return matching
    Documents (a Vec, at most `opts.limit`, default 50). Coverage differs:

    - Google Drive: `fullText contains` (name, description, content), not trashed;
      within `drive-id` when the source has one
    - OneDrive / SharePoint: Graph `search(q=...)` over names, metadata and
      content from the drive root (or `opts.folder`)
    - Dropbox: `search_v2` over names and content (content search needs a
      paid plan), under `root`; the index lags a few minutes
    - Box: `/search` over names, descriptions, content and tags, under
      `folder-id`; 6 searches per second per user
    - S3: no native search, so this returns an Err (list a prefix instead)

    Provider options pass through (e.g. Box `file_extensions`, Dropbox
    `file_categories`).

    ```hot
    hits ::documents/search({provider: "onedrive"}, "quarterly report", {limit: 10})
    ```
    """
}
fn
(source: Any, query: Str): Vec {
  search(source, query, {})
},
(source: Any, query: Str, opts: Map): Vec {
  src ::source/resolve(source)
  limit or(::hot::coll/get(opts, "limit"), DEFAULT_SEARCH_LIMIT)
  cond {
    is-err(src) => { src }
    eq(src.provider, "google-drive") => { ::documents::google/search(src, query, limit, opts) }
    eq(src.provider, "onedrive") => { ::documents::onedrive/search(src, query, limit, opts) }
    eq(src.provider, "dropbox") => { ::documents::dropbox/search(src, query, limit, opts) }
    eq(src.provider, "box") => { ::documents::box/search(src, query, limit, opts) }
    eq(src.provider, "s3") => { err("documents: S3 has no search; list a key prefix with ::documents/list instead") }
    => { unknown-provider(src.provider) }
  }
}

get-document
meta {
    doc: """
    Metadata for one file or folder as a `Document`. `id` is an id, or a
    path where the provider supports path addressing (OneDrive `/path`,
    Dropbox `/path`, S3 key). Also available as `get`.

    ```hot
    doc ::documents/get({provider: "dropbox"}, "/Reports/Q3.pdf")
    doc.hashes   // {dropbox-content-hash: "..."}
    ```
    """
}
fn
(source: Any, id: Str): Document {
  get-document(source, id, {})
},
(source: Any, id: Str, opts: Map): Document {
  src ::source/resolve(source)
  cond {
    is-err(src) => { src }
    eq(src.provider, "google-drive") => { ::documents::google/get-doc(src, id, opts) }
    eq(src.provider, "onedrive") => { ::documents::onedrive/get-doc(src, id, opts) }
    eq(src.provider, "dropbox") => { ::documents::dropbox/get-doc(src, id, opts) }
    eq(src.provider, "box") => { ::documents::box/get-doc(src, id, opts) }
    eq(src.provider, "s3") => { ::documents::s3/get-doc(src, id, opts) }
    => { unknown-provider(src.provider) }
  }
}

get ::documents/get-document

download
meta {
    doc: """
    Download a file's stored bytes as a `FileContent` (binary safe;
    providers switch to Range-chunked downloads past the response cap
    where they support it). Native documents (Google Docs, Paper) have no
    bytes: use `read-text`.

    ```hot
    pdf ::documents/download({provider: "box"}, "987654321")
    pdf.bytes
    ```
    """
}
fn
(source: Any, id: Str): FileContent {
  download(source, id, {})
},
(source: Any, id: Str, opts: Map): FileContent {
  src ::source/resolve(source)
  cond {
    is-err(src) => { src }
    eq(src.provider, "google-drive") => { ::documents::google/download(src, id, opts) }
    eq(src.provider, "onedrive") => { ::documents::onedrive/download(src, id, opts) }
    eq(src.provider, "dropbox") => { ::documents::dropbox/download(src, id, opts) }
    eq(src.provider, "box") => { ::documents::box/download(src, id, opts) }
    eq(src.provider, "s3") => { ::documents::s3/download(src, id, opts) }
    => { unknown-provider(src.provider) }
  }
}

read-text
meta {
    doc: """
    Read a file as text (or PDF) using the provider's native export or
    extraction, as a `TextResult`. Never waits. `format`:

    - `"auto"` (default) - the most useful text: Google Docs as Markdown,
      Sheets as CSV, Slides as text; Dropbox Paper as Markdown; Box
      extracted text; text files (`text/*`, JSON, CSV, Markdown, ...) as stored
    - `"text"` / `"markdown"` - prefer that form where the provider offers
      both (Google Docs, Paper); other text files come back as stored
    - `"pdf"` - PDF bytes: stored PDFs, Google exports, OneDrive conversion
      (source at most 2 MB), Paper when offered

    Binary files without a native text form return
    `{status: "unsupported", mime-type}` so you can route them to an
    extraction tool. See `::documents::text/plan` for the exact choice.

    ```hot
    r ::documents/read-text(src, id, "auto")
    cond {
      eq(r.status, "ok") => { index(r.text) }
      eq(r.status, "pending") => { send("docs:retry-later", {id: id}) }
      => { send("docs:extract", {id: id, mime-type: r.mime-type}) }
    }
    ```
    """
}
fn
(source: Any, id: Str): TextResult {
  read-text(source, id, "auto", {})
},
(source: Any, id: Str, format: Str?): TextResult {
  read-text(source, id, format, {})
},
(source: Any, id: Str, format: Str?, opts: Map): TextResult {
  src ::source/resolve(source)
  fmt ::documents::text/normalize-format(format)
  cond {
    is-err(src) => { src }
    is-err(fmt) => { fmt }
    eq(src.provider, "google-drive") => { ::documents::google/read-text(src, id, fmt, opts) }
    eq(src.provider, "onedrive") => { ::documents::onedrive/read-text(src, id, fmt, opts) }
    eq(src.provider, "dropbox") => { ::documents::dropbox/read-text(src, id, fmt, opts) }
    eq(src.provider, "box") => { ::documents::box/read-text(src, id, fmt, opts) }
    eq(src.provider, "s3") => { ::documents::s3/read-text(src, id, fmt, opts) }
    => { unknown-provider(src.provider) }
  }
}

upload
meta {
    doc: """
    Upload `bytes` (Bytes or Str) as `name` into `parent` (a folder id,
    Dropbox or OneDrive path, or S3 prefix; null for the source's root)
    and return the new `Document`. Chunked and resumable uploads are
    chosen by the provider package. `opts.mime-type` sets the type
    (default from the name); provider options pass through (Dropbox
    `mode`, OneDrive `conflict`, Box `content-modified-at`, ...).

    ```hot
    doc ::documents/upload({provider: "onedrive"}, "/Reports", "q3.csv", "region,total\\nwest,42\\n", {})
    ```
    """
}
fn
(source: Any, parent: Str?, name: Str, bytes: Any): Document {
  upload(source, parent, name, bytes, {})
},
(source: Any, parent: Str?, name: Str, bytes: Any, opts: Map): Document {
  src ::source/resolve(source)
  data if(is-bytes(bytes), bytes, Bytes(Str(or(bytes, ""))))
  mime or(::hot::coll/get(opts, "mime-type"), ::documents::text/mime-from-name(name))
  cond {
    is-err(src) => { src }
    eq(src.provider, "google-drive") => { ::documents::google/upload(src, parent, name, data, mime, opts) }
    eq(src.provider, "onedrive") => { ::documents::onedrive/upload(src, parent, name, data, mime, opts) }
    eq(src.provider, "dropbox") => { ::documents::dropbox/upload(src, parent, name, data, mime, opts) }
    eq(src.provider, "box") => { ::documents::box/upload(src, parent, name, data, mime, opts) }
    eq(src.provider, "s3") => { ::documents::s3/upload(src, parent, name, data, mime, opts) }
    => { unknown-provider(src.provider) }
  }
}

start-cursor
meta {
    doc: """
    A change cursor for "changes from now on" (an opaque Str), without
    listing anything (S3 lists nothing either: the cursor is a
    modified-after watermark five minutes in the past). Store it and pass
    it to `changes`.

    ```hot
    cursor ::documents/start-cursor({provider: "google-drive"})
    ```
    """
}
fn
(source: Any): Str {
  start-cursor(source, {})
},
(source: Any, opts: Map): Str {
  src ::source/resolve(source)
  cond {
    is-err(src) => { src }
    eq(src.provider, "google-drive") => { ::documents::google/start-cursor(src, opts) }
    eq(src.provider, "onedrive") => { ::documents::onedrive/start-cursor(src, opts) }
    eq(src.provider, "dropbox") => { ::documents::dropbox/start-cursor(src, opts) }
    eq(src.provider, "box") => { ::documents::box/start-cursor(src, opts) }
    eq(src.provider, "s3") => { ::documents::s3/start-cursor(src, opts) }
    => { unknown-provider(src.provider) }
  }
}

changes
meta {
    doc: """
    Everything that changed since `cursor`, as a `ChangeSet`, from the
    provider's own change feed: Drive `changes`, OneDrive `delta`,
    Dropbox `list_folder/continue`, the Box event stream
    (`stream_type=changes`). S3 has no change feed: the prefix is listed
    and objects modified after the cursor's watermark are returned
    (deletions are not seen; use S3 Event Notifications for those).

    Options: `max-pages` (Box and S3), plus provider options and credentials.

    ```hot
    set ::documents/changes(src, saved-cursor)
    map(set.documents, upsert)
    map(set.deleted-ids, remove)
    saved-cursor set.next-cursor
    ```
    """
}
fn
(source: Any, cursor: Str): ChangeSet {
  changes(source, cursor, {})
},
(source: Any, cursor: Str, opts: Map): ChangeSet {
  src ::source/resolve(source)
  cond {
    is-err(src) => { src }
    eq(src.provider, "google-drive") => { ::documents::google/changes(src, cursor, opts) }
    eq(src.provider, "onedrive") => { ::documents::onedrive/changes(src, cursor, opts) }
    eq(src.provider, "dropbox") => { ::documents::dropbox/changes(src, cursor, opts) }
    eq(src.provider, "box") => { ::documents::box/changes(src, cursor, opts) }
    eq(src.provider, "s3") => { ::documents::s3/changes(src, cursor, opts) }
    => { unknown-provider(src.provider) }
  }
}

// ---------------------------------------------------------------------------
// Shortcuts
// ---------------------------------------------------------------------------

capabilities ::documents::capabilities/capabilities
normalize-webhook ::documents::webhooks/normalize
