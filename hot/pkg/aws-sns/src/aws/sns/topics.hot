// List tags for a topic
list-tags-for-resource
meta {
    doc: """
    List tags for an SNS topic.

    **Example**

    ```hot
    result ::aws::sns::topics/list-tags-for-resource(topic-arn)
    result.tags
    // => [{Key: "Environment", Value: "production"}, {Key: "Application", Value: "my-app"}]
    ```
    """
}
fn
(resource_arn: Str, opts: Map): Map | AwsError {
    if-ok(resolve(opts), (resolved) {
        body to-json({
            ResourceArn: resource_arn
        })

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.ListTagsForResource"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { { tags: if(is-null(response.body.Tags), [], response.body.Tags) } }
            => { AwsError(response) }
        }
    })
},
(resource_arn: Str): Map | AwsError {
    list-tags-for-resource(resource_arn, {})
