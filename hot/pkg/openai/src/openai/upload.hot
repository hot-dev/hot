::openai::upload ns

api-request ::openai::api/request
HttpError ::openai::api/HttpError
is-ok-response ::hot::http/is-ok-response

UploadCertificateRequest type {
    name: Str?,
    content: Str
}

CertificateObjectType type open "certificate" | "organization.certificate" | "organization.project.certificate"

Certificate type {
    object: CertificateObjectType,
    id: Str,
    name: Str?,
    created_at: Int,
    certificate_details: Map,
    active: Bool?
}

UploadCertificateRequest type {
    name: Str?,
    content: Str
}

UploadCertificateResponse type {
    object: CertificateObjectType,
    id: Str,
    name: Str?,
    created_at: Int,
    certificate_details: Map,
    active: Bool?
}


upload-certificate
meta {
    doc: """
    POST /organization/certificates - Upload a TLS certificate for the
    organization.

    **Example**

    ```hot
    admin {api-key: ::hot::ctx/get("openai.admin.key")}
    cert ::openai::upload/upload-certificate(::openai::upload/UploadCertificateRequest({
      name: "Production cert",
      content: "-----BEGIN CERTIFICATE-----\nMIIB...\n-----END CERTIFICATE-----"
    }), admin)
    cert.id
    ```
    """
}
fn
(request: UploadCertificateRequest): UploadCertificateResponse {
  upload-certificate(request, {})
},
(request: UploadCertificateRequest, opts: Map): UploadCertificateResponse {
  response api-request("POST", "/organization/certificates", {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { UploadCertificateResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
