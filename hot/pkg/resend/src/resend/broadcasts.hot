create-broadcast
meta {
    doc: """
    Create a new broadcast draft targeting a specific audience. Must be sent
    separately via send-or-schedule-broadcast.

    **Example**

    ```hot
    draft ::resend::broadcasts/create-broadcast(::resend::broadcasts/POSTBroadcastsRequest({
        name: "November update",
        audience_id: "78261eea-8f8b-4381-83c6-79fa7120f1cf",
        from: "news@example.com",
        subject: "What shipped in November",
        html: "<p>Hello.</p>"
    }))
    draft.id
    ```
    """
}
fn
(request: POSTBroadcastsRequest): POSTBroadcastsResponse {
  create-broadcast(request, {})
},
(request: POSTBroadcastsRequest, opts: Map): POSTBroadcastsResponse {
  response api-request("POST", `${::resend/BASE_URL}/broadcasts`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { POSTBroadcastsResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

