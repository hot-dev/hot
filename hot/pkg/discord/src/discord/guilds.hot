ListGuildMembersRequest type {
  guild_id: Str,
  limit: Int?,
  after: Str?
}

list-guild-members
meta {
    doc: """
    GET /guilds/{guild_id}/members - Up to `limit` (1-1000, default 1)
    members ordered by user id; page with `after`, or use
    `list-all-guild-members`. Needs the privileged GUILD_MEMBERS intent.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    members ::guilds/list-guild-members(::guilds/ListGuildMembersRequest({
      guild_id: "1000000000000000000",
      limit: 100
    }))
    map(members, %.user.username)
    ```
    """
}
fn
(request: ListGuildMembersRequest): Vec<Map> {
  list-guild-members(request, {})
},
(request: ListGuildMembersRequest, opts: Map): Vec<Map> {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/members`, {query: {limit: request.limit, after: request.after}}, opts)
}

list-all-guild-members
meta {
    doc: """
    Every member of a guild (up to `max-items`, default 10000), paging
    1000 at a time with `after`. Needs the GUILD_MEMBERS intent.

    **Example**

    ```hot
    members ::discord::guilds/list-all-guild-members("1000000000000000000", 5000)
    bots filter(members, (m) { m.user.bot })
    ```
    """
}
fn
(guild-id: Str): Vec<Map> {
  list-all-guild-members(guild-id, 10000)
},
(guild-id: Str, max-items: Int): Vec<Map> {
  list-all-guild-members(guild-id, max-items, {})
},
(guild-id: Str, max-items: Int, opts: Map): Vec<Map> {
  ::api/paginate(
    (after) { list-guild-members(ListGuildMembersRequest({guild_id: guild-id, limit: 1000, after: after}), opts) },
    (page) { last(page).user.id },
    1000,
    max-items
  )
}

