::supabase::admin::databases ns

::api ::supabase::admin::api

Backup type {
  id: Str?,
  status: Str?,
  created_at: Str?
}

Migration type {
  version: Str?,
  name: Str?,
  inserted_at: Str?
}

pooler-path
meta {no-doc: true}
fn (project-ref: Str): Str {
  `/projects/${project-ref}/config/database/pooler`
}

upgrade-eligibility-path
meta {no-doc: true}
fn (project-ref: Str): Str {
  `/projects/${project-ref}/upgrade/eligibility`
}

// ============================================================================
// Database Configuration
// ============================================================================

get-postgres-config
meta {
    doc: """
Get the Postgres configuration for a project (statement_timeout, max_connections, etc.).

**Example**

```hot
::databases ::supabase::admin::databases

config ::databases/get-postgres-config("my-project-ref")
```
"""
}
fn
(project-ref: Str): Map {
  get-postgres-config(project-ref, {})
},
(project-ref: Str, opts: Map): Map {
  ::api/request("GET", `/projects/${project-ref}/config/database/postgres`, {}, {}, opts)
}

update-postgres-config
meta {
    doc: """
    Update Postgres configuration. Pass a Map of config fields (e.g.
    `{statement_timeout: "30s", max_connections: 200}`).

    **Example**

    ```hot
    ::databases ::supabase::admin::databases

    ::databases/update-postgres-config("my-project-ref", {
      statement_timeout: "30s",
      max_connections: 200
    })
    ```
    """
}
fn
(project-ref: Str, config: Map): Map {
  update-postgres-config(project-ref, config, {})
},
(project-ref: Str, config: Map, opts: Map): Map {
  ::api/request("PUT", `/projects/${project-ref}/config/database/postgres`, {}, config, opts)
}

get-pooler-config
meta {
    doc: """
    Get the current Supavisor connection pooler configuration.

    **Example**

    ```hot
    ::databases ::supabase::admin::databases

    poolers ::databases/get-pooler-config("my-project-ref")
    map(poolers, %.pool_mode)
    ```
    """
}
fn
(project-ref: Str): Vec<Map> {
  get-pooler-config(project-ref, {})
},
(project-ref: Str, opts: Map): Vec<Map> {
  ::api/request("GET", pooler-path(project-ref), {}, {}, opts)
}

update-pooler-config
meta {
    doc: """
    Update the Supavisor connection pooler configuration.

    **Example**

    ```hot
    ::databases ::supabase::admin::databases

    ::databases/update-pooler-config("my-project-ref", {default_pool_size: 20})
    ```
    """
}
fn
(project-ref: Str, config: Map): Map {
  update-pooler-config(project-ref, config, {})
},
(project-ref: Str, config: Map, opts: Map): Map {
  ::api/request("PATCH", pooler-path(project-ref), {}, config, opts)
}

// ============================================================================
// Backups
// ============================================================================

list-backups
meta {
    doc: """
List database backups for a project.

**Example**

```hot
::databases ::supabase::admin::databases

backups ::databases/list-backups("my-project-ref")
// => [{id: "...", status: "COMPLETED", created_at: "...", ...}, ...]
```
"""
}
fn
(project-ref: Str): Vec<Backup> {
  list-backups(project-ref, {})
},
(project-ref: Str, opts: Map): Vec<Backup> {
  ::api/request("GET", `/projects/${project-ref}/database/backups`, {}, {}, opts)
}

// ============================================================================
// Migrations
// ============================================================================

list-migrations
meta {
    doc: """
    List database migrations that have been run on a project.

    **Example**

    ```hot
    ::databases ::supabase::admin::databases

    migrations ::databases/list-migrations("my-project-ref")
    map(migrations, %.version)
    ```
    """
}
fn
(project-ref: Str): Vec<Migration> {
  list-migrations(project-ref, {})
},
(project-ref: Str, opts: Map): Vec<Migration> {
  ::api/request("GET", `/projects/${project-ref}/database/migrations`, {}, {}, opts)
}

// ============================================================================
// Query
// ============================================================================

RunQueryRequest type {
  project_ref: Str,
  query: Str
}

run-query
meta {
    doc: """
Run a SQL query against a project's database. Requires a Personal Access Token with appropriate permissions.

**Example**

```hot
::databases ::supabase::admin::databases

result ::databases/run-query(::databases/RunQueryRequest({
  project_ref: "my-project-ref",
  query: "SELECT count(*) FROM auth.users"
}))
```
"""
}
fn
(request: RunQueryRequest): Any {
  run-query(request, {})
},
(request: RunQueryRequest, opts: Map): Any {
  ::api/request("POST", `/projects/${request.project_ref}/database/query`, {}, {query: request.query}, opts)
}

