create
meta {
    doc: """
    admin.conversations.create - Create a channel. Pass `team_id` for a single workspace, or `org_wide: true` for an org-wide channel. Returns `channel_id`.

    Scope: `admin.conversations:write`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.

    **Example**

    ```hot
    ::conversations ::slack::admin::conversations

    res ::conversations/create(::conversations/CreateRequest({name: "incident-1234", is_private: true, team_id: "T0123ABCDEF"}))
    res.channel_id

    // Across the whole organization
    ::conversations/create(::conversations/CreateRequest({name: "announcements", is_private: false, org_wide: true, description: "Company news"}))
    ```
    """
}
fn
(request: CreateRequest): Map {
