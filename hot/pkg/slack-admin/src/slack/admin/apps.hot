activities-list
meta {
    doc: """
    admin.apps.activities.list - Read app activity logs (`activities`). Filter by `component_type` (`events_api`, `workflows`, `functions`, `tables`), `min_log_level`, and a time range in epoch microseconds.

    Scope: `admin.app_activities:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `activities-list-all`.

    **Example**

    ```hot
    ::apps ::slack::admin::apps

    page ::apps/activities-list(::apps/ActivitiesListRequest({
      app_id: "A0123ABCDEF",
      component_type: "workflows",
      min_log_level: "warn",
      limit: 100
    }))
    page.activities
    ```
    """
}
fn
(): Map {
  activities-list(ActivitiesListRequest({}))
},
(request: ActivitiesListRequest): Map {
  activities-list(request, {})
},
(request: ActivitiesListRequest, opts: Map): Map {
  ::api/call("admin.apps.activities.list", request, opts)
}

activities-list-all
meta {
    doc: """
    Every `activities` entry from `admin.apps.activities.list`, following
    `next_cursor` until the last page or `max-items` (default 1000).
    `request` sets the filters; its `cursor` is the starting point.

    **Example**

    ```hot
    ::apps ::slack::admin::apps

    errors ::apps/activities-list-all(::apps/ActivitiesListRequest({app_id: "A0123ABCDEF", min_log_level: "error"}), 2000)
    length(errors)
    ```
    """
}
fn
(): Vec {
  activities-list-all(ActivitiesListRequest({}), 1000)
},
(request: ActivitiesListRequest): Vec {
  activities-list-all(request, 1000)
},
(request: ActivitiesListRequest, max-items: Int): Vec {
  activities-list-all(request, max-items, {})
},
(request: ActivitiesListRequest, max-items: Int, opts: Map): Vec {
  ::api/paginate("admin.apps.activities.list", request, "activities", max-items, opts)
}

