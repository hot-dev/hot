::supabase::functions ns

::api ::supabase::api
::uri ::hot::uri

InvokeResponse type {
  status: Int,
  headers: Map,
  body: Any
}

InvokeFunctionRequest type {
  name: Str,
  body: Any?,
  headers: Map?,
  region: Str?,
  access-token: Str?,
  service: Bool?
}

function-path
meta {no-doc: true}
fn (name: Str): Str {
  `/functions/v1/${::uri/encode(name)}`
}

invoke-headers
meta {no-doc: true}
fn (request: InvokeFunctionRequest): Map {
  headers or(request.headers, {})
  headers |> assoc-some("x-region", request.region)
}

invoke-response-from-http
meta {no-doc: true}
fn (response: ::api/HttpResponse): InvokeResponse {
  InvokeResponse({
    status: response.status,
    headers: response.headers,
    body: response.body
  })
}

invoke-http-response
meta {
    doc: """
    Invoke an Edge Function and return the full `HttpResponse`.
    Authenticates with the service role key when `service` is true, else
    `access-token` when set, else the anon key. A non-2xx status is not an
    Err: check `status`.

    **Example**

    ```hot
    ::functions ::supabase::functions

    response ::functions/invoke-http-response(::functions/InvokeFunctionRequest({
      name: "process-order",
      body: {order_id: "abc-123"}
    }))
    response.status
    response.body
    ```
    """
}
fn
(request: InvokeFunctionRequest): ::api/HttpResponse {
  invoke-http-response(request, {})
},
(request: InvokeFunctionRequest, opts: Map): ::api/HttpResponse {
  cond {
    and(is-some(request.service), request.service) => {
      ::api/request-raw-service("POST", function-path(request.name), invoke-headers(request), or(request.body, {}), opts)
    }

    is-some(request.access-token) => {
      ::api/request-raw-as("POST", function-path(request.name), invoke-headers(request), or(request.body, {}), request.access-token, opts)
    }
    => {
      ::api/request-raw("POST", function-path(request.name), invoke-headers(request), or(request.body, {}), opts)
    }
  }
}

invoke
meta {
    doc: """
Invoke a Supabase Edge Function by name. The function receives the JSON body and any additional headers. Set `region` to run in a specific region (e.g. "us-east-1").

**Example**

```hot
::functions ::supabase::functions

// Simple invocation
result ::functions/invoke(::functions/InvokeFunctionRequest({
  name: "hello-world"
}))

// With body and headers
result ::functions/invoke(::functions/InvokeFunctionRequest({
  name: "process-order",
  body: {order_id: "abc-123", action: "confirm"},
  headers: {"x-custom-header": "value"}
}))
```
"""
}
fn
(request: InvokeFunctionRequest): Any {
  invoke(request, {})
},
(request: InvokeFunctionRequest, opts: Map): Any {
  ::api/body-or-error(invoke-http-response(request, opts))
}

invoke-response
meta {
    doc: """
    Like `invoke`, but returns an `InvokeResponse` with `status`, `headers`
    and `body`. A non-2xx status is an Err carrying an `HttpError`.

    **Example**

    ```hot
    ::functions ::supabase::functions

    response ::functions/invoke-response(::functions/InvokeFunctionRequest({
      name: "process-order",
      body: {order_id: "abc-123"},
      region: "us-east-1"
    }))
    response.headers
    response.body
    ```
    """
}
fn
(request: InvokeFunctionRequest): InvokeResponse {
  invoke-response(request, {})
},
(request: InvokeFunctionRequest, opts: Map): InvokeResponse {
  response invoke-http-response(request, opts)
  cond {
    is-err(response) => { response }
    not(::api/is-ok-response(response)) => { err(::api/HttpError(response)) }
    => { invoke-response-from-http(response) }
  }
}

invoke-as
meta {
    doc: """
    Like `invoke`, but as a signed-in user. `access-token` is the Bearer
    token, so row level security applies as that user.

    **Example**

    ```hot
    ::functions ::supabase::functions

    token ::hot::ctx/get("supabase.user.token")
    ::functions/invoke-as(::functions/InvokeFunctionRequest({name: "hello-world"}), token)
    ```
    """
}
fn
(request: InvokeFunctionRequest, access-token: Str): Any {
  invoke-as(request, access-token, {})
},
(request: InvokeFunctionRequest, access-token: Str, opts: Map): Any {
  invoke({...untype(request), access-token: access-token}, opts)
}

invoke-service
meta {
    doc: """
    Like `invoke`, with the service role key. Server-side only.

    **Example**

    ```hot
    ::functions ::supabase::functions

    ::functions/invoke-service(::functions/InvokeFunctionRequest({name: "nightly-cleanup"}))
    ```
    """
}
fn
(request: InvokeFunctionRequest): Any {
  invoke-service(request, {})
},
(request: InvokeFunctionRequest, opts: Map): Any {
  invoke({...untype(request), service: true}, opts)
}
