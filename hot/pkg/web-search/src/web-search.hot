::web-search ns
meta {
    doc: """
    Web search for agents and apps.

    Four providers behind one normalized call: set a key for any of
    Tavily, Brave, Exa, or Firecrawl, and `::web-search/search` uses
    it. Choose one explicitly with the `provider` option (or the
    `web-search.provider` context variable), fall back to the next
    configured provider on failure with `fallback: true`, and filter by
    `freshness` and domains, mapped to each provider's own parameters.
    Each provider module also exposes its native API
    (`::web-search::tavily`, `::web-search::brave`, `::web-search::exa`,
    `::web-search::firecrawl`). Keys can also come per call: see
    `::web-search::api`.

    **Quick start**

    ```hot
    results ::web-search/search("PostgreSQL 18 release notes", 5, {freshness: "month"})
    map(results, (r) { `${r.title} - ${r.url}` })
    ```

    Normalized results are `Vec<SearchResult>`, best match first.
    """
}

::ctx ::hot::ctx
::api ::web-search::api

SearchResult
meta {
    doc: """One normalized search hit: `title`, `url`, `content` (snippet or page text, plain text), `score` (provider relevance, 0-1, when the provider reports one: Tavily does, Brave and Firecrawl do not, Exa only sometimes)."""
}
type {
  title: Str,
  url: Str,
  content: Str?,
  score: Dec?
}

// Default provider order: the first configured one is used.
PROVIDERS ["tavily", "brave", "exa", "firecrawl"]

PROVIDER_KEYS {
  tavily: "tavily.api.key",
  brave: "brave.api.key",
  exa: "exa.api.key",
  firecrawl: "firecrawl.api.key"
}

FRESHNESS ["day", "week", "month", "year"]

DEFAULT_MAX_RESULTS 10

is-configured
meta {
    doc: """True when `provider`'s API key is set in context."""
}
fn (provider: Str): Bool {
  key get(PROVIDER_KEYS, provider)
  and(is-some(key), not(is-empty(or(::ctx/get(key), ""))))
}

configured-providers
meta {
    doc: """The providers with an API key set in context, in default order."""
}
fn (): Vec {
  filter(PROVIDERS, (p) { is-configured(p) })
}

configured-provider
meta {
    doc: """The provider `search` uses by default: `web-search.provider` from context when set, otherwise the first configured of "tavily", "brave", "exa", "firecrawl"; null when no key is set."""
}
fn (): Any {
  preferred ::ctx/get("web-search.provider")
  if(and(is-str(preferred), not(is-blank(preferred))), preferred, first(configured-providers()))
}

provider-order
meta {
    doc: """
    The providers `search` tries, in order. `preferred` (the
    `provider` option, else the `web-search.provider` context value;
    null for none) goes first; without one, the first configured
    provider does. With `fallback`, the other configured providers
    follow in default order. Errs for an unknown provider, or when
    nothing is configured. Exposed for testing.
    """
}
fn (preferred: Any, fallback: Bool, configured: Vec): Vec {
  cond {
    and(is-some(preferred), not(in(preferred, PROVIDERS))) => {
      err(`web-search: unknown provider "${preferred}". Use one of: ${join(PROVIDERS, ", ")}.`)
    }

    and(is-null(preferred), is-empty(configured)) => {
      err("web-search: no provider configured. Set tavily.api.key, brave.api.key, exa.api.key, or firecrawl.api.key in Context Variables, or pass tavily-api-key, brave-api-key, exa-api-key, or firecrawl-api-key in the call's options.")
    }
    => {
      head or(preferred, first(configured))
      rest filter(configured, (p) { ne(p, head) })
      if(fallback, [head, ...rest], [head])
    }
  }
}

search-order
meta {
    doc: """
    The providers a `search` call tries, in order, from its `options`, its
    resolved `credentials` (see `::web-search::api/resolve`), and the
    `web-search.provider` context value. With per-call credentials only
    those providers are candidates: `fallback` adds no others, the context
    default applies only when it is one of them, and a `provider` without
    a credential in the call is an Err. Exposed for testing.
    """
}
fn (options: Map, credentials: Map, default-provider: Any): Vec {
  configured filter(PROVIDERS, (p) { is-some(get(credentials.keys, p)) })
  requested text-or-null(get(options, "provider"))
  default text-or-null(default-provider)
  preferred cond {
    is-some(requested) => { requested }
    and(credentials.per-call, not(in(default, configured))) => { null }
    => { default }
  }

  order provider-order(preferred, eq(get(options, "fallback"), true), configured)
  cond {
    is-err(order) => { order }
    and(credentials.per-call, not(in(first(order), configured))) => { err(::api/missing-per-call(first(order))) }
    => { order }
  }
}

text-or-null fn (value: Any): Str? {
  if(and(is-str(value), not(is-blank(value))), value, null)
}

search-filters
meta {
    doc: """The provider-neutral filters from `search` options: `freshness` ("day", "week", "month", "year"), `include-domains`, `exclude-domains` (Vecs of hostnames). Errs for an unknown freshness. Exposed for testing."""
}
fn (options: Map): Map {
  freshness get(options, "freshness")
  cond {
    and(is-some(freshness), not(in(freshness, FRESHNESS))) => {
      err(`web-search: unknown freshness "${freshness}". Use one of: ${join(FRESHNESS, ", ")}.`)
    }
    => {
      filter-vals({
        freshness: freshness,
        include-domains: non-empty(get(options, "include-domains")),
        exclude-domains: non-empty(get(options, "exclude-domains"))
      }, is-some)
    }
  }
}

non-empty fn (v: Any): Any {
  if(and(is-vec(v), not(is-empty(v))), v, null)
}

search-with
meta {
    doc: """Run the normalized search on one named provider, failing clearly when its key is not set. `opts` may carry the provider's key (see `::web-search::api`)."""
}
fn
(provider: Str, query: Str, max-results: Int, filters: Map): Vec {
  search-with(provider, query, max-results, filters, {})
},
(provider: Str, query: Str, max-results: Int, filters: Map, opts: Map): Vec {
  cond {
    eq(provider, "tavily") => { ::web-search::tavily/search-normalized(query, max-results, filters, opts) }
    eq(provider, "brave") => { ::web-search::brave/search-normalized(query, max-results, filters, opts) }
    eq(provider, "exa") => { ::web-search::exa/search-normalized(query, max-results, filters, opts) }
    => { ::web-search::firecrawl/search-normalized(query, max-results, filters, opts) }
  }
}

search
meta {
    ctx: {
        "tavily.api.key": {required: false},
        "brave.api.key": {required: false},
        "exa.api.key": {required: false},
        "firecrawl.api.key": {required: false},
        "web-search.provider": {required: false, secret: false}
    },
    doc: """
    Search the web and return normalized `Vec<SearchResult>`, best
    first. `max-results` defaults to 10 and is clamped to each
    provider's limit (Tavily and Brave 20, Exa and Firecrawl 100).

    `options`:
    - `provider`: "tavily", "brave", "exa", or "firecrawl" (default:
      `web-search.provider` from context, else the first configured)
    - `fallback`: true to try the other configured providers, in
      order, when one fails (default false)
    - `freshness`: "day", "week", "month", or "year"
    - `include-domains` / `exclude-domains`: Vecs of hostnames
    - `tavily-api-key`, `brave-api-key`, `exa-api-key`, `firecrawl-api-key`:
      the provider's key for this call, masked in call records. With any
      of these, only those providers are candidates: context keys are not
      used, not even by `fallback`.

    Returns an Err when no provider is configured, the chosen one is
    not, a credential option is blank or null, or every attempted
    provider fails. With fallback, that Err carries `{message, errors:
    [{provider, error}]}`.

    **Example**

    ```hot
    results ::web-search/search("hot.dev release notes", 5, {
      provider: "brave",
      fallback: true,
      freshness: "week",
      include-domains: ["hot.dev"]
    })
    first(results).url

    // Per-call credentials: one run can act for many tenants
    ::web-search/search("hot.dev release notes", 5, {
      fallback: true,
      tavily-api-key: "tvly-tenant-b",
      brave-api-key: "tenant-b-token"
    })
    ```
    """
}
fn
(query: Str): Vec<SearchResult> {
  search(query, DEFAULT_MAX_RESULTS, {})
},
(query: Str, max-results: Int): Vec<SearchResult> {
  search(query, max-results, {})
},
(query: Str, options: Map): Vec<SearchResult> {
  search(query, or(get(options, "max-results"), DEFAULT_MAX_RESULTS), options)
},
(query: Str, max-results: Int, options: Map): Vec<SearchResult> {
  credentials ::api/resolve(options)
  cond {
    is-err(credentials) => { credentials }
    => {
      order search-order(options, credentials, ::ctx/get("web-search.provider"))
      filters search-filters(options)
      cond {
        is-err(order) => { order }
        is-err(filters) => { filters }
        eq(length(order), 1) => { search-with(first(order), query, max-results, filters, options) }
        => { try-in-order(order, query, max-results, filters, options, []) }
      }
    }
  }
}

try-in-order fn (providers: Vec, query: Str, max-results: Int, filters: Map, opts: Map, errors: Vec): Vec {
  cond {
    is-empty(providers) => {
      err({
        message: `web-search: every provider failed (${join(map(errors, (e) { e.provider }), ", ")})`,
        errors: errors
      })
    }
    => {
      provider first(providers)
      out search-with(provider, query, max-results, filters, opts)
      if(is-err(out),
        try-in-order(rest(providers), query, max-results, filters, opts,
          [...errors, {provider: provider, error: if-err(out, (e) { e })}]),
        out)
    }
  }
}
