::aws::ses::email ns

// SES Email operations using SES v2 API

HttpResponse ::hot::http/HttpResponse
is-ok-response ::hot::http/is-ok-response

resolve ::aws::core/resolve
send-signed ::aws::core/send-signed
service-url ::aws::core/service-url
AwsError ::aws::core/AwsError

// Email destination type
Destination type {
    to_addresses: Vec<Str>,
    cc_addresses: Vec<Str>?,
    bcc_addresses: Vec<Str>?
}

// Simple email body
Body type {
    text: Str?,
    html: Str?
}

// Simple email message
Message type {
    subject: Str,
    body: Body
}

// Email content wrapper
EmailContent type {
    simple: Message?,
    raw: Str?,
    template: TemplateContent?
}

// Template content for templated emails
TemplateContent type {
    template_name: Str,
    template_data: Map
}

// Send email request
SendEmailRequest type {
    from_email_address: Str,
    destination: Destination,
    content: EmailContent,
    reply_to_addresses: Vec<Str>?,
    configuration_set_name: Str?
}

// Send email response
SendEmailResponse type {
    message_id: Str?
}

// Raw message data for the API: a Base64 blob
raw-message-data
meta {
    doc: """The `RawMessage.Data` value for a MIME message: SES requires the entire message Base64 encoded. A message that is already Base64 (a MIME message has `:` and spaces, so it can't be mistaken for one) passes through."""
}
fn (raw_message: Str): Str {
    cond {
        ::hot::regex/is-match(raw_message, "^[A-Za-z0-9+/\\r\\n]+={0,2}\\s*$") => { raw_message }
        => { ::hot::base64/encode(raw_message) }
    }
}

// The JSON body for SendEmail
send-email-body
meta {
    doc: """The SendEmail request body for a `SendEmailRequest`. Exposed for testing."""
}
fn (request: SendEmailRequest): Map {
    simple request.content.simple
    raw request.content.raw
    template request.content.template
    non-blank (value: Str?) { if(or(is-null(value), eq(value, "")), null, {Data: value}) }

    // Exactly one kind of content; unset parts are left out, not sent as null
    content cond {
        is-some(simple) => {
            {
                Simple: {
                    Subject: {Data: simple.subject},
                    Body: filter-vals({
                        Text: non-blank(simple.body.text),
                        Html: non-blank(simple.body.html)
                    }, is-some)
                }
            }
        }

        is-some(raw) => { {Raw: {Data: raw-message-data(raw)}} }
        is-some(template) => { {Template: {TemplateName: template.template_name, TemplateData: to-json(template.template_data)}} }
        => { {} }
    }

    filter-vals({
        FromEmailAddress: request.from_email_address,
        Destination: {
            ToAddresses: request.destination.to_addresses,
            CcAddresses: or(request.destination.cc_addresses, []),
            BccAddresses: or(request.destination.bcc_addresses, [])
        },
        Content: content,
        ReplyToAddresses: or(request.reply_to_addresses, []),
        ConfigurationSetName: request.configuration_set_name
    }, is-some)
}

// Send a simple email
send-email
meta {
    doc: """
    Send an email via AWS SES v2 API using a full SendEmailRequest.

    For simple emails, prefer the `send-simple-email` convenience function.

    **Example**

    ```hot
    destination Destination({to_addresses: ["user@example.com"], cc_addresses: null, bcc_addresses: null})
    body Body({text: "Hello!", html: "<h1>Hello!</h1>"})
    message Message({subject: "Test Subject", body: body})
    content EmailContent({simple: message, raw: null, template: null})
    request SendEmailRequest({
        from_email_address: "sender@example.com",
        destination: destination,
        content: content,
        reply_to_addresses: null,
        configuration_set_name: null
    })
    result ::aws::ses::email/send-email(request)
    result.message_id  // => "010001234567890-abcdef..."
    ```
    """
}
fn
(request: SendEmailRequest, opts: Map): SendEmailResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${service-url(resolved, "email")}/v2/email/outbound-emails`

        // Build the request body
        body to-json(send-email-body(request))

        headers {
            "Content-Type": "application/json"
        }

        response send-signed("POST", url, "ses", resolved, headers, body)

        cond {
            is-ok-response(response) => { SendEmailResponse({
                message_id: response.body.MessageId
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(request: SendEmailRequest): SendEmailResponse | AwsError {
    send-email(request, {})
}

// Convenience function to send a simple email
send-simple-email
meta {
    doc: """
    Send a simple email with just from, to, subject, and body.

    **Example**

    ```hot
    result ::aws::ses::email/send-simple-email(
        "sender@example.com",
        ["user@example.com"],
        "Welcome!",
        "Hello from Hot!",
        "<h1>Hello from Hot!</h1>"
    )
    result.message_id  // => "010001234567890-abcdef..."

    // Text-only email (no HTML)
    result ::aws::ses::email/send-simple-email(
        "sender@example.com",
        ["user@example.com"],
        "Alert",
        "Something happened"
    )
    ```
    """
}
fn
(from: Str, to: Vec<Str>, subject: Str, body_text: Str, body_html: Str?, opts: Map): SendEmailResponse | AwsError {
    send-email(SendEmailRequest({
        from_email_address: from,
        destination: Destination({
            to_addresses: to,
            cc_addresses: null,
            bcc_addresses: null
        }),
        content: EmailContent({
            simple: Message({
                subject: subject,
                body: Body({
                    text: body_text,
                    html: body_html
                })
            }),
            raw: null,
            template: null
        }),
        reply_to_addresses: null,
        configuration_set_name: null
    }), opts)
},
(from: Str, to: Vec<Str>, subject: Str, body_text: Str, opts: Map): SendEmailResponse | AwsError {
    send-simple-email(from, to, subject, body_text, "", opts)
},
(from: Str, to: Vec<Str>, subject: Str, body_text: Str, body_html: Str?): SendEmailResponse | AwsError {
    send-email(SendEmailRequest({
        from_email_address: from,
        destination: Destination({
            to_addresses: to,
            cc_addresses: null,
            bcc_addresses: null
        }),
        content: EmailContent({
            simple: Message({
                subject: subject,
                body: Body({
                    text: body_text,
                    html: body_html
                })
            }),
            raw: null,
            template: null
        }),
        reply_to_addresses: null,
        configuration_set_name: null
    }))
},
(from: Str, to: Vec<Str>, subject: Str, body_text: Str): SendEmailResponse | AwsError {
    send-simple-email(from, to, subject, body_text, "")
}

// Send a raw email (for complex MIME messages)
send-raw-email
meta {
    doc: """
    Send a raw MIME email via AWS SES.

    Use this for complex email formats like multipart messages with attachments.

    **Example**

    ```hot
    raw-message "From: sender@example.com\nTo: user@example.com\nSubject: Test\n\nBody"
    result ::aws::ses::email/send-raw-email(raw-message)
    ```
    """
}
fn
(raw_message: Str, opts: Map): SendEmailResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${service-url(resolved, "email")}/v2/email/outbound-emails`

        body to-json({
            Content: {
                Raw: {
                    Data: raw-message-data(raw_message)
                }
            }
        })

        headers {
            "Content-Type": "application/json"
        }

        response send-signed("POST", url, "ses", resolved, headers, body)

        cond {
            is-ok-response(response) => { SendEmailResponse({
                message_id: response.body.MessageId
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(raw_message: Str): SendEmailResponse | AwsError {
    send-raw-email(raw_message, {})
}

// Send a templated email
send-templated-email
meta {
    doc: """
    Send an email using an SES template.

    **Example**

    ```hot
    result ::aws::ses::email/send-templated-email(
        "sender@example.com",
        ["user@example.com"],
        "WelcomeTemplate",
        {name: "Alice", company: "Acme"}
    )
    result.message_id  // => "010001234567890-abcdef..."
    ```
    """
}
fn
(from: Str, to: Vec<Str>, template_name: Str, template_data: Map, opts: Map): SendEmailResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${service-url(resolved, "email")}/v2/email/outbound-emails`

        body to-json({
            FromEmailAddress: from,
            Destination: {
                ToAddresses: to
            },
            Content: {
                Template: {
                    TemplateName: template_name,
                    TemplateData: to-json(template_data)
                }
            }
        })

        headers {
            "Content-Type": "application/json"
        }

        response send-signed("POST", url, "ses", resolved, headers, body)

        cond {
            is-ok-response(response) => { SendEmailResponse({
                message_id: response.body.MessageId
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(from: Str, to: Vec<Str>, template_name: Str, template_data: Map): SendEmailResponse | AwsError {
    send-templated-email(from, to, template_name, template_data, {})
}
