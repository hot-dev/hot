::regulations-gov::integration::ctx ns

::env ::hot::env

// Placeholder settings for the regulations-gov integration suite. Unset
// environment variables are skipped entirely, so absent credentials behave
// exactly as if never configured.
::hot::ctx/set(filter-vals({
    "regulations-gov.api-key": ::env/get("REGULATIONS_GOV_API_KEY", ""),
    "regulations-gov.base-url": ::env/get("REGULATIONS_GOV_BASE_URL", ""),
}, (v) { not(is-empty(v)) }))

configured
meta {doc: """True when REGULATIONS_GOV_API_KEY is set."""}
fn (): Bool {
    is-some(::hot::ctx/get("regulations-gov.api-key"))
}

skip
meta {doc: """Record a skip and pass."""}
fn (why: Str): Bool {
    println(`regulations-gov integration: ${why} - skipping`)
    assert(true, `skipped: ${why}`)
}
