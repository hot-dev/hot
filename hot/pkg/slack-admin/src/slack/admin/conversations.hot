BulkArchiveRequest type {
  channel_ids: Vec<Str>
}

bulk-archive
meta {
    doc: """
    admin.conversations.bulkArchive - Archive up to 100 channels in one background job. Returns `bulk_action_id`; channels that could not be queued are in `not_added`.

    Scope: `admin.conversations:write`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.

    **Example**

    ```hot
    ::conversations ::slack::admin::conversations

    res ::conversations/bulk-archive(::conversations/BulkArchiveRequest({channel_ids: ["C0123ABCDEF", "C0456GHIJKL"]}))
    res.bulk_action_id
    res.not_added
    ```
    """
}
fn
(request: BulkArchiveRequest): Map {
  bulk-archive(request, {})
},
(request: BulkArchiveRequest, opts: Map): Map {
  ::api/call("admin.conversations.bulkArchive", request, opts)
}

