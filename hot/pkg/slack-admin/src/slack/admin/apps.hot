ApprovedListRequest type {
  team_id: Str?,
  enterprise_id: Str?,
  certified: Bool?,
  cursor: Str?,
  limit: Int?
}

approved-list
meta {
    doc: """
    admin.apps.approved.list - List approved apps (`approved_apps`).

    Scope: `admin.apps:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `approved-list-all`.

    **Example**

    ```hot
    ::apps ::slack::admin::apps

    page ::apps/approved-list(::apps/ApprovedListRequest({team_id: "T0123ABCDEF", limit: 100}))
    page.approved_apps
    page.response_metadata.next_cursor
    ```
    """
}
fn
(): Map {
  approved-list(ApprovedListRequest({}))
},
(request: ApprovedListRequest): Map {
  approved-list(request, {})
},
(request: ApprovedListRequest, opts: Map): Map {
  ::api/call("admin.apps.approved.list", request, opts)
}

approved-list-all
meta {
    doc: """
    Every `approved_apps` entry from `admin.apps.approved.list`, following
    `next_cursor` until the last page or `max-items` (default 1000).
    `request` sets the filters; its `cursor` is the starting point.

    **Example**

    ```hot
    ::apps ::slack::admin::apps

    apps ::apps/approved-list-all(::apps/ApprovedListRequest({team_id: "T0123ABCDEF"}), 500)
    length(apps)
    ```
    """
}
fn
(): Vec {
  approved-list-all(ApprovedListRequest({}), 1000)
},
(request: ApprovedListRequest): Vec {
  approved-list-all(request, 1000)
},
(request: ApprovedListRequest, max-items: Int): Vec {
  approved-list-all(request, max-items, {})
},
(request: ApprovedListRequest, max-items: Int, opts: Map): Vec {
  ::api/paginate("admin.apps.approved.list", request, "approved_apps", max-items, opts)
}

