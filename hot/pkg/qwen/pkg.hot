::hot::pkg ns

hot.pkg.qwen {
  name: "hot.dev/qwen",
  version: "1.0.6",
  hot-min-version: "3.0.2",
  description: "Qwen (Alibaba Cloud Model Studio / DashScope) bindings for Hot, built on hot.dev/openai: Chat Completions with thinking, web search and streaming, Models and Embeddings, region selection (Singapore, US, Beijing, Hong Kong, Frankfurt, Tokyo, workspace domains), and a hot-ai provider for the agent run loop.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["ai"],
  deps: {
    "hot.dev/hot-ai": "1.9.2",
    "hot.dev/openai": "1.3.3"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
