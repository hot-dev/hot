::github::artifacts ns

::api ::github::api
::actions ::github::actions

artifact-path
meta {no-doc: true}
fn (owner: Str, repo: Str, artifact-id: Any): Str {
  ::actions/actions-path(owner, repo, `/artifacts/${artifact-id}`)
}

list-artifacts
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/artifacts - Repository Actions
    artifacts. `params` supports `name`, `per_page`, and `page`.

    **Example**

    ```hot
    result ::github::artifacts/list-artifacts("acme", "api", {name: "coverage"})
    map(result.artifacts, %.id)
    ```
    """
}
fn
(owner: Str, repo: Str): Map {
  ::api/json("GET", ::actions/actions-path(owner, repo, "/artifacts"))
},
(owner: Str, repo: Str, params: Map): Map {
  list-artifacts(owner, repo, params, {})
},
(owner: Str, repo: Str, params: Map, opts: Map): Map {
  ::api/json(
    "GET",
    ::actions/actions-path(owner, repo, "/artifacts") |> ::actions/with-query(params)
  , {}, "", opts)
}

list-workflow-run-artifacts
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/runs/{run_id}/artifacts - Artifacts
    produced by one workflow run. `params` supports `name`, `per_page`,
    and `page`.

    **Example**

    ```hot
    result ::github::artifacts/list-workflow-run-artifacts("acme", "api", 1234567890)
    map(result.artifacts, %.name)
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any): Map {
  ::api/json("GET", `${::actions/run-path(owner, repo, run-id)}/artifacts`)
},
(owner: Str, repo: Str, run-id: Any, params: Map): Map {
  list-workflow-run-artifacts(owner, repo, run-id, params, {})
},
(owner: Str, repo: Str, run-id: Any, params: Map, opts: Map): Map {
  ::api/json(
    "GET",
    `${::actions/run-path(owner, repo, run-id)}/artifacts`
    |> ::actions/with-query(params)
  , {}, "", opts)
}

get-artifact
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/artifacts/{artifact_id} - Get artifact
    metadata.

    **Example**

    ```hot
    artifact ::github::artifacts/get-artifact("acme", "api", 555)
    artifact.size_in_bytes
    ```
    """
}
fn
(owner: Str, repo: Str, artifact-id: Any): Map {
  get-artifact(owner, repo, artifact-id, {})
},
(owner: Str, repo: Str, artifact-id: Any, opts: Map): Map {
  ::api/json("GET", artifact-path(owner, repo, artifact-id), {}, "", opts)
}

download-artifact
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/artifacts/{artifact_id}/zip -
    Download an artifact ZIP archive as Bytes.

    **Example**

    ```hot
    archive ::github::artifacts/download-artifact("acme", "api", 555)
    ::hot::zip/entries(archive)
    ```
    """
}
fn
(owner: Str, repo: Str, artifact-id: Any): Any {
  download-artifact(owner, repo, artifact-id, {})
},
(owner: Str, repo: Str, artifact-id: Any, opts: Map): Any {
  ::api/download(`${artifact-path(owner, repo, artifact-id)}/zip`, opts)
}

delete-artifact
meta {
    doc: """
    DELETE /repos/{owner}/{repo}/actions/artifacts/{artifact_id} - Delete an
    artifact.

    **Example**

    ```hot
    ::github::artifacts/delete-artifact("acme", "api", 555)
    ```
    """
}
fn
(owner: Str, repo: Str, artifact-id: Any): Any {
  delete-artifact(owner, repo, artifact-id, {})
},
(owner: Str, repo: Str, artifact-id: Any, opts: Map): Any {
  ::api/json("DELETE", artifact-path(owner, repo, artifact-id), {}, "", opts)
}
