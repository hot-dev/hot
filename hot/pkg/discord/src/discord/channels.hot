  channel_id: Str,
  webhook_channel_id: Str,
  reason: Str?
}

follow-announcement-channel
meta {
    doc: """POST /channels/{channel_id}/followers - Follow an Announcement channel into `webhook_channel_id`. Needs MANAGE_WEBHOOKS in the target channel."""
}
fn (request: FollowAnnouncementChannelRequest): Map {
  ::api/call("POST", `/channels/${seg(request.channel_id)}/followers`, {
    body: {webhook_channel_id: request.webhook_channel_id},
    reason: request.reason
  })
}

TriggerTypingIndicatorRequest type {
  channel_id: Str
}

trigger-typing-indicator
meta {
    doc: """POST /channels/{channel_id}/typing - Show "typing..." for about 10 seconds or until the bot sends a message."""
}
fn (request: TriggerTypingIndicatorRequest): Bool {
  ::api/call-ok("POST", `/channels/${seg(request.channel_id)}/typing`)
}

// ============================================================================
// Guild channels
// ============================================================================

GetGuildChannelsRequest type {
  guild_id: Str
}

get-guild-channels
meta {
    doc: """
    GET /guilds/{guild_id}/channels - Every channel in a guild (threads excluded; see `list-active-threads`).

    **Example**

    ```hot
    ::channels ::discord::channels

    channels ::channels/get-guild-channels(::channels/GetGuildChannelsRequest({guild_id: "1000000000000000000"}))
    text-channels filter(channels, (c) { eq(c.type, 0) })
    ```
    """
}
fn (request: GetGuildChannelsRequest): Vec<Map> {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/channels`)
}

CreateGuildChannelRequest type {
  guild_id: Str,
  name: Str,
  type: Int?,
  topic: Str?,
  bitrate: Int?,
  user_limit: Int?,
  rate_limit_per_user: Int?,
  position: Int?,
  permission_overwrites: Vec<Map>?,
  parent_id: Str?,
  nsfw: Bool?,
  rtc_region: Str?,
  video_quality_mode: Int?,
  default_auto_archive_duration: Int?,
  default_reaction_emoji: Map?,
  available_tags: Vec<Map>?,
  default_sort_order: Int?,
  default_forum_layout: Int?,
  default_thread_rate_limit_per_user: Int?,
  flags: Int?,
  reason: Str?
}

create-guild-channel
meta {
    doc: """
    POST /guilds/{guild_id}/channels - Create a channel. `type`: 0 text,
    2 voice, 4 category, 5 announcement, 13 stage, 15 forum, 16 media.
    Needs MANAGE_CHANNELS.

    **Example**

    ```hot
    ::channels ::discord::channels

    ::channels/create-guild-channel(::channels/CreateGuildChannelRequest({
      guild_id: "1000000000000000000",
      name: "incident-2026-11-01",
      type: 0,
      parent_id: "1400000000000000000",
      reason: "Incident channel"
    }))
    ```
    """
}
fn (request: CreateGuildChannelRequest): Map {
  ::api/call("POST", `/guilds/${seg(request.guild_id)}/channels`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  })
}

ModifyGuildChannelPositionsRequest type {
  guild_id: Str,
  positions: Vec<Map>,
  reason: Str?
}

modify-guild-channel-positions
meta {
    doc: """PATCH /guilds/{guild_id}/channels - Reorder channels. `positions` is `[{id, position?, lock_permissions?, parent_id?}]`. Needs MANAGE_CHANNELS."""
}
fn (request: ModifyGuildChannelPositionsRequest): Bool {
  ::api/call-ok("PATCH", `/guilds/${seg(request.guild_id)}/channels`, {
    body: map(request.positions, (p) { ::api/body(p, []) }),
    reason: request.reason
  })
}

// ============================================================================
// Threads
// ============================================================================

StartThreadFromMessageRequest type {
  channel_id: Str,
  message_id: Str,
  name: Str,
  auto_archive_duration: Int?,
  rate_limit_per_user: Int?,
  reason: Str?
}

start-thread-from-message
meta {
    doc: """POST /channels/{channel_id}/messages/{message_id}/threads - Start a thread on an existing message. `auto_archive_duration` is 60, 1440, 4320 or 10080 minutes."""
}
fn (request: StartThreadFromMessageRequest): Map {
  ::api/call("POST", `/channels/${seg(request.channel_id)}/messages/${seg(request.message_id)}/threads`, {
    body: ::api/body(request, ["channel_id", "message_id"]),
    reason: request.reason
  })
}

StartThreadWithoutMessageRequest type {
  channel_id: Str,
  name: Str,
  auto_archive_duration: Int?,
  type: Int?,
  invitable: Bool?,
  rate_limit_per_user: Int?,
  reason: Str?
}

start-thread-without-message
meta {
    doc: """POST /channels/{channel_id}/threads - Start a thread with no starter message. `type` 11 = public, 12 = private (the default is private, so set it)."""
}
fn (request: StartThreadWithoutMessageRequest): Map {
  ::api/call("POST", `/channels/${seg(request.channel_id)}/threads`, {
    body: ::api/body(request, ["channel_id"]),
    reason: request.reason
  })
}

StartForumThreadRequest type {
  channel_id: Str,
  name: Str,
  message: Map,
  auto_archive_duration: Int?,
  rate_limit_per_user: Int?,
  applied_tags: Vec<Str>?,
  files: Vec<::discord::api/FileUpload>?,
  reason: Str?
}

start-forum-thread
meta {
    doc: """
    POST /channels/{channel_id}/threads - Create a post in a forum or
    media channel. `message` is the first message
    (`{content?, embeds?, components?, allowed_mentions?, sticker_ids?, attachments?, flags?}`);
    `applied_tags` are forum tag ids. `files` are uploaded with it.

    **Example**

    ```hot
    ::channels ::discord::channels

    post ::channels/start-forum-thread(::channels/StartForumThreadRequest({
      channel_id: "1500000000000000000",
      name: "Weekly sync notes",
      message: {content: "Agenda in the thread"}
    }))
    ```
    """
}
fn (request: StartForumThreadRequest): Map {
  files or(request.files, [])
  payload ::api/body(request, ["channel_id"])
  message cond {
    and(not(is-empty(files)), is-null(get(request.message, "attachments"))) => {
      assoc(request.message, "attachments", ::api/attachments-for(files))
    }
    => { request.message }
  }

  ::api/call("POST", `/channels/${seg(request.channel_id)}/threads`, {
    body: assoc(payload, "message", message),
    files: files,
    reason: request.reason
  })
}

JoinThreadRequest type {
  channel_id: Str
}

join-thread
meta {
    doc: """PUT /channels/{channel_id}/thread-members/@me - Join a thread (it must not be archived)."""
}
fn (request: JoinThreadRequest): Bool {
