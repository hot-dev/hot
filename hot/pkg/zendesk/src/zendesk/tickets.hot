::zendesk::tickets ns
meta {
    ctx: {"zendesk.subdomain": {required: false, secret: false}},
    doc: """
    Tickets: create, read, update, comment, merge and tag; list with
    cursor pagination; ticket fields; satisfaction ratings; and the
    cursor-based incremental ticket export for syncing changes.
    """
}

::api ::zendesk::api

// ---------------------------------------------------------------------------
// Tickets
// ---------------------------------------------------------------------------

list-tickets
meta {
    doc: """
    GET /tickets - One cursor page of tickets: `{tickets, meta:
    {has_more, after_cursor}, links}`. `options`: `page_size` (max 100),
    `after` (the previous page's cursor, via
    `::zendesk::api/next-after`), `sort` (`id`, `updated_at`,
    `created_at`, `status`, ...; prefix `-` for descending),
    `external_id`. Use `list-all-tickets` to collect several pages.

    **Example**

    ```hot
    page ::zendesk::tickets/list-tickets({page_size: 50, sort: "-updated_at"})
    next-page ::zendesk::tickets/list-tickets({page_size: 50, after: ::zendesk::api/next-after(page)})
    map(page.tickets, %.subject)
    ```
    """
}
fn
(): Any {
  list-tickets({})
},
(options: Map): Any {
  list-tickets(options, {})
},
(options: Map, opts: Map): Any {
  ::api/list-page("/tickets", options, opts)
}

list-all-tickets
meta {
    doc: """
    Collect up to `limit` tickets across cursor pages. Returns a Vec. For
    syncing every ticket that changed, prefer `export-tickets`.

    **Example**

    ```hot
    tickets ::zendesk::tickets/list-all-tickets(500, {sort: "-updated_at"})
    length(tickets)
    ```
    """
}
fn
(limit: Int): Vec {
  list-all-tickets(limit, {})
},
(limit: Int, options: Map): Vec {
  list-all-tickets(limit, options, {})
},
(limit: Int, options: Map, opts: Map): Vec {
  ::api/collect("/tickets", "tickets", options, limit, opts)
}

get-ticket
meta {
    doc: """
    GET /tickets/{id} - One ticket: `{ticket}`.

    **Example**

    ```hot
    out ::zendesk::tickets/get-ticket(35436)
    out.ticket.status
    ```
    """
}
fn
(id: Any): Any {
  get-ticket(id, {})
},
(id: Any, opts: Map): Any {
  ::api/request("GET", `/tickets/${::api/path-segment(id)}`, "", opts)
}

show-many-tickets
meta {
    doc: """
    GET /tickets/show_many?ids= - Up to 100 tickets by id in one call:
    `{tickets}`.

    **Example**

    ```hot
    out ::zendesk::tickets/show-many-tickets([35436, 35437])
    map(out.tickets, %.id)
    ```
    """
}
fn
(ids: Vec): Any {
  show-many-tickets(ids, {})
},
(ids: Vec, opts: Map): Any {
  ::api/request("GET", `/tickets/show_many${::api/query-string({ids: ids})}`, "", opts)
}

build-create-body
meta {
    doc: """
    Build the create body `{ticket: {subject, comment: {body},
    ...options}}`. Unset options are omitted. Exposed for testing.

    **Example**

    ```hot
    ::zendesk::tickets/build-create-body("Login down", "500s on /login", {priority: "urgent"})  // {ticket: {priority: "urgent", subject: "Login down", comment: {body: "500s on /login"}}}
    ```
    """
}
fn (subject: Str, body: Str, options: Map): Map {
  {ticket: ::api/compact({...options, subject: subject, comment: {body: body}})}
}

create-ticket
meta {
    doc: """
    POST /tickets - Open a ticket. `options`: `priority`
    ("low"/"normal"/"high"/"urgent"), `type`
    ("problem"/"incident"/"question"/"task"), `status`, `tags` (Vec),
    `requester` (`{name, email}`) or `requester_id`, `assignee_id`,
    `group_id`, `organization_id`, `custom_fields` (`[{id, value}]`),
    `external_id`. Returns `{ticket, audit}`.

    **Example**

    ```hot
    out ::zendesk::tickets/create-ticket("Login page down", "Customers report 500s on /login.", {
      priority: "urgent",
      type: "incident",
      requester: {name: "Ada Lovelace", email: "ada@example.com"},
      tags: ["login", "outage"]
    })
    out.ticket.id
    ```
    """
}
fn
(subject: Str, body: Str): Any {
  create-ticket(subject, body, {})
},
(subject: Str, body: Str, options: Map): Any {
  create-ticket(subject, body, options, {})
},
(subject: Str, body: Str, options: Map, opts: Map): Any {
  ::api/request("POST", "/tickets", build-create-body(subject, body, options), opts)
}

update-ticket
meta {
    doc: """
    PUT /tickets/{id} - Update ticket fields (`status`, `priority`,
    `assignee_id`, `group_id`, `tags` (replaces), `custom_fields`,
    `comment`, ...). Unset fields are omitted. Add `safe_update: true` and
    `updated_stamp` to fail with 409 on a concurrent change.

    **Example**

    ```hot
    out ::zendesk::tickets/update-ticket(35436, {status: "pending", priority: "high"})
    out.ticket.status
    ```
    """
}
fn
(id: Any, changes: Map): Any {
  update-ticket(id, changes, {})
},
(id: Any, changes: Map, opts: Map): Any {
  ::api/request("PUT", `/tickets/${::api/path-segment(id)}`, {ticket: ::api/compact(changes)}, opts)
}

delete-ticket
meta {
    doc: """
    DELETE /tickets/{id} - Move a ticket to Deleted tickets (recoverable for
    30 days). Returns null.

    **Example**

    ```hot
    ::zendesk::tickets/delete-ticket(35436)
    ```
    """
}
fn
(id: Any): Any {
  delete-ticket(id, {})
},
(id: Any, opts: Map): Any {
  ::api/request("DELETE", `/tickets/${::api/path-segment(id)}`, "", opts)
}

// ---------------------------------------------------------------------------
// Comments
// ---------------------------------------------------------------------------

build-comment-body
meta {
    doc: """
    Comment update body `{ticket: {comment: {body, public, ...options}}}`.
    `options`: `author_id`, `html_body` (sent instead of the plain body when
    set), `uploads` (attachment tokens). Exposed for testing.

    **Example**

    ```hot
    ::zendesk::tickets/build-comment-body("Thanks", true, {})  // {ticket: {comment: {body: "Thanks", public: true}}}
    ::zendesk::tickets/build-comment-body("Thanks", false, {html_body: "<p>Thanks</p>"})  // {ticket: {comment: {html_body: "<p>Thanks</p>", public: false}}}
    ```
    """
}
fn (body: Str, public: Bool, options: Map): Map {
  text if(is-some(get(options, "html_body")), null, body)
  {ticket: {comment: ::api/compact({...options, body: text, public: public})}}
}

add-comment
meta {
    doc: """
    PUT /tickets/{id} with a comment - Add a public reply (`public: true`)
    or internal note (`public: false`). `options`: `author_id`, `html_body`,
    `uploads`; plus ticket changes to apply in the same update via
    `update-ticket`.

    **Example**

    ```hot
    ::zendesk::tickets/add-comment(35436, "We rolled back the deploy.", true)
    ::zendesk::tickets/add-comment(35436, "Rollback finished at 14:05.", false, {author_id: 1900000001})
    ```
    """
}
fn
(id: Any, body: Str, public: Bool): Any {
  add-comment(id, body, public, {})
},
(id: Any, body: Str, public: Bool, options: Map): Any {
  add-comment(id, body, public, options, {})
},
(id: Any, body: Str, public: Bool, options: Map, opts: Map): Any {
  ::api/request("PUT", `/tickets/${::api/path-segment(id)}`, build-comment-body(body, public, options), opts)
}

list-comments
meta {
    doc: """
    GET /tickets/{id}/comments - One cursor page of a ticket's comments,
    oldest first: `{comments, meta, links}`. `options`: `page_size` (max
    100), `after`, `sort` ("created_at" or "-created_at"), `include`
    ("users"), `include_inline_images`.

    **Example**

    ```hot
    page ::zendesk::tickets/list-comments(35436, {page_size: 50, sort: "-created_at"})
    map(page.comments, %.body)
    ```
    """
}
fn
(id: Any): Any {
  list-comments(id, {})
},
(id: Any, options: Map): Any {
  list-comments(id, options, {})
},
(id: Any, options: Map, opts: Map): Any {
  ::api/list-page(`/tickets/${::api/path-segment(id)}/comments`, options, opts)
}

list-all-comments
meta {
    doc: """
    Collect a ticket's whole conversation (up to `limit` comments) across
    cursor pages. Returns a Vec.

    **Example**

    ```hot
    comments ::zendesk::tickets/list-all-comments(35436, 200)
    length(comments)
    ```
    """
}
fn
(id: Any, limit: Int): Vec {
  list-all-comments(id, limit, {})
},
(id: Any, limit: Int, options: Map): Vec {
  list-all-comments(id, limit, options, {})
},
(id: Any, limit: Int, options: Map, opts: Map): Vec {
  ::api/collect(`/tickets/${::api/path-segment(id)}/comments`, "comments", options, limit, opts)
}

// ---------------------------------------------------------------------------
// Merge and tags
// ---------------------------------------------------------------------------

build-merge-body
meta {
    doc: """
    Merge body: `ids` (source tickets) plus `options` (`target_comment`,
    `source_comment`, `target_comment_is_public`,
    `source_comment_is_public`). Unset options are omitted. Exposed for
    testing.

    **Example**

    ```hot
    ::zendesk::tickets/build-merge-body([123, 456], {target_comment: "Merged"})  // {target_comment: "Merged", ids: [123, 456]}
    ```
    """
}
fn (source-ids: Vec, options: Map): Map {
  ::api/compact({...options, ids: source-ids})
}

merge-tickets
meta {
    doc: """
    POST /tickets/{id}/merge - Merge `source-ids` into the target
    ticket. The work runs as a background job: returns `{job_status}`;
    poll `GET /job_statuses/{id}` with `::zendesk::api/request`.
    Zendesk recommends a private comment on both sides.

    **Example**

    ```hot
    ::zendesk::tickets/merge-tickets(111, [123, 456], {
      target_comment: "Combining duplicates #123 and #456",
      source_comment: "Closing in favor of #111"
    })
    ```
    """
}
fn
(target-id: Any, source-ids: Vec): Any {
  merge-tickets(target-id, source-ids, {})
},
(target-id: Any, source-ids: Vec, options: Map): Any {
  merge-tickets(target-id, source-ids, options, {})
},
(target-id: Any, source-ids: Vec, options: Map, opts: Map): Any {
  ::api/request("POST", `/tickets/${::api/path-segment(target-id)}/merge`, build-merge-body(source-ids, options), opts)
}

