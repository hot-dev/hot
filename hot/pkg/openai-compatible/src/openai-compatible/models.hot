::openai-compatible::models ns

::compat ::openai::compatible
::api    ::openai::api

CompatibleProvider ::compat/CompatibleProvider

list-models
meta {
    doc: """
    GET /models: the models the provider exposes, as the decoded body
    (`{data: [{id, ...}]}`), or an Err carrying `HttpError`.

    **Example**

    ```hot
    page ::openai-compatible::models/list-models(::openai-compatible/ollama())
    map(page.data, (m) { m.id })
    ```
    """
}
fn
(p: CompatibleProvider): Map {
    list-models(p, {})
},
(p: CompatibleProvider, opts: Map): Map {
    ::compat/list-models(p, opts)
}

model-path
meta {
    doc: """
    The `/models/{id}` path with the routing prefix stripped and the id
    URL-encoded (OpenRouter-style ids contain `/`).

    **Example**

    ```hot
    p ::openai-compatible/configure(::openai-compatible/OPENROUTER, "k")
    ::openai-compatible::models/model-path(p, "openrouter/openai/gpt-5.2")  // => "/models/openai%2Fgpt-5.2"
    ```
    """
}
fn (p: CompatibleProvider, model: Str): Str {
    `/models/${::hot::uri/encode(::compat/strip-model-prefix(model, p.model-prefix))}`
}

get-model
meta {
    doc: """GET /models/{model}: one model's metadata, or an Err carrying `HttpError`. Not every provider implements it."""
}
fn
(p: CompatibleProvider, model: Str): Map {
    get-model(p, model, {})
},
(p: CompatibleProvider, model: Str, opts: Map): Map {
    ep ::compat/resolve(p, opts)
    cond {
        is-err(ep) => { ep }
        => { ::api/endpoint-response(::api/endpoint-request(ep, "GET", model-path(p, model))) }
    }
}
