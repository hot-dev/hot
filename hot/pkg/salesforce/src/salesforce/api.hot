::salesforce::api ns
meta {
    doc: """
    Authenticated requests against the org's `instance_url`. Every
    module in this package goes through `json` (or `send` for CSV); use
    them directly for any REST resource without a wrapper.

    Non-2xx responses come back as an Err carrying `HttpError`, whose
    `message` flattens Salesforce's `[{message, errorCode, fields}]`
    error array (or an OAuth `{error, error_description}` body) into one
    readable line, with `error-code` set to the first code.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then the `salesforce.*` context variables, then the defaults.
    Per-call credentials are masked in call records and only the minted
    session is cached, keyed by a hash of them, so one run can act for
    many orgs. `::salesforce::auth` lists the keys; `api-version` picks
    the REST API version for the call.
    """
}

::auth ::salesforce::auth
::ctx ::hot::ctx
::uri ::hot::uri

http-request ::hot::http/request
is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError
meta {
    doc: """A non-2xx Salesforce response: `status`, `headers`, the decoded `body`, a readable `message` (see `error-message`), and the first `error-code` (e.g. `INVALID_FIELD`, `INVALID_SESSION_ID`)."""
}
type {
    status: Int,
    headers: Map,
    body: Any,
    message: Str,
    error-code: Str?
}

HttpResponse -> HttpError
meta {
    doc: """Coerce a response into an `HttpError`, deriving `message` and `error-code` from its body."""
}
fn (response: HttpResponse): HttpError {
  body response.body
  HttpError({
    status: response.status,
    headers: or(response.headers, {}),
    body: body,
    message: error-message(response.status, body),
    error-code: error-code(body)
  })
}

// ---------------------------------------------------------------------------
// Error parsing (pure, exposed for testing)
// ---------------------------------------------------------------------------

format-error-entry
meta {no-doc: true}
fn (entry: Any): Str {
  cond {
    not(is-map(entry)) => { Str(entry) }
    => {
      code get(entry, "errorCode", get(entry, "statusCode"))
      message Str(get(entry, "message", ""))
      fields get(entry, "fields", [])
      with-code if(is-blank-value(code), message, `${code}: ${message}`)
      cond {
        and(is-vec(fields), not(is-empty(fields))) => { `${with-code} (fields: ${join(map(fields, (f) { Str(f) }), ", ")})` }
        => { with-code }
      }
    }
  }
}

is-blank-value
meta {no-doc: true}
fn (value: Any): Bool {
  or(is-null(value), and(is-str(value), is-blank(value)))
}

error-code
meta {
    doc: """
    The first Salesforce error code in an error body (`errorCode` of the
    first array entry, or the OAuth `error`), or null. Exposed for testing.

    **Example**

    ```hot
    ::salesforce::api/error-code([{errorCode: "INVALID_FIELD", message: "No such column"}])  // "INVALID_FIELD"
    ::salesforce::api/error-code({error: "invalid_grant"})  // "invalid_grant"
    ```
    """
}
fn (body: Any): Any {
  cond {
    and(is-vec(body), not(is-empty(body)), is-map(first(body))) => { get(first(body), "errorCode", get(first(body), "statusCode")) }
    is-map(body) => { get(body, "errorCode", get(body, "error")) }
    => { null }
  }
}

error-message
meta {
    doc: """
    Flatten a Salesforce error body into one line, prefixed with the
    HTTP status: `salesforce 400: INVALID_FIELD: No such column 'Foo'
    (fields: Foo)`. Handles the REST error array, OAuth
    `{error, error_description}` bodies, and plain text. Exposed for
    testing.

    **Example**

    ```hot
    ::salesforce::api/error-message(400, [{errorCode: "INVALID_FIELD", message: "No such column 'Foo'", fields: ["Foo"]}])
    // "salesforce 400: INVALID_FIELD: No such column 'Foo' (fields: Foo)"
    ```
    """
}
fn (status: Int, body: Any): Str {
  detail cond {
    is-null(body) => { "" }
    and(is-vec(body), is-empty(body)) => { "" }
    is-vec(body) => { join(map(body, format-error-entry), "; ") }
    and(is-map(body), is-some(get(body, "error"))) => {
      description get(body, "error_description")
      if(is-blank-value(description), Str(body.error), `${body.error}: ${description}`)
    }

    is-map(body) => { format-error-entry(body) }
    => { trim(Str(body)) }
  }

  if(is-empty(detail), `salesforce ${status}`, `salesforce ${status}: ${detail}`)
}

is-invalid-session
meta {
    doc: """
    True for a 401 response, which Salesforce returns with
    `INVALID_SESSION_ID` when a session has expired or been revoked. Exposed
    for testing.

    **Example**

    ```hot
    ::salesforce::api/is-invalid-session({status: 401})  // true
    ::salesforce::api/is-invalid-session({status: 200})  // false
    ```
    """
}
fn (response: Any): Bool {
  fields untype(response)
  and(is-map(fields), eq(get(fields, "status"), 401))
}

// ---------------------------------------------------------------------------
// URL building (pure, exposed for testing)
// ---------------------------------------------------------------------------

api-version
meta {
    ctx: {"salesforce.api.version": {required: false, secret: false}},
    doc: """
    The REST API version: `api-version` in `opts`, then
    `salesforce.api.version` ("66.0" and "v66.0" both work), else
    `::salesforce/DEFAULT_API_VERSION`.

    **Example**

    ```hot
    ::salesforce::api/api-version({api-version: "62.0"})  // "v62.0"
    ```
    """
}
fn
(): Str {
  api-version({})
},
(opts: Map): Str {
  ::auth/mark-credentials(opts)
  per-call get(opts, "api-version")
  normalize-version(if(is-blank-value(per-call), ::ctx/get("salesforce.api.version"), per-call))
}

normalize-version
meta {
    doc: """
    `"66.0"`/`"v66.0"`/`66` → `"v66.0"`; null or blank → the default
    version. Exposed for testing.

    **Example**

    ```hot
    ::salesforce::api/normalize-version("66.0")  // "v66.0"
    ::salesforce::api/normalize-version(66)  // "v66.0"
    ```
    """
}
fn (version: Any): Str {
  cond {
    is-blank-value(version) => { ::salesforce/DEFAULT_API_VERSION }
    => {
      raw trim(Str(version))
      bare if(starts-with(raw, "v"), slice(raw, 1), raw)
      if(contains(bare, "."), `v${bare}`, `v${bare}.0`)
    }
  }
}

data-path
meta {
    doc: """
    Prefix a REST resource with the data API root: `/sobjects/Lead` →
    `/services/data/v68.0/sobjects/Lead`. Paths that already start with
    `/services/` (e.g. a `nextRecordsUrl`) pass through unchanged. The
    2-arity form takes the version explicitly. Exposed for testing.

    **Example**

    ```hot
    ::salesforce::api/data-path("/sobjects/Lead", "v66.0")  // "/services/data/v66.0/sobjects/Lead"
    ::salesforce::api/data-path("/services/data/v60.0/limits", "v66.0")  // "/services/data/v60.0/limits"
    ```
    """
}
fn
(path: Str): Str {
  data-path(path, api-version())
},
(path: Str, version: Str): Str {
  cond {
    starts-with(path, "/services/") => { path }
    => { `/services/data/${normalize-version(version)}${path}` }
  }
}

build-url
meta {
    doc: """
    The absolute URL for a resource on an instance:
    `build-url("https://acme.my.salesforce.com/", "/limits")`. Exposed for
    testing.

    **Example**

    ```hot
    ::salesforce::api/build-url("https://acme.my.salesforce.com/", "/limits", "v66.0")  // "https://acme.my.salesforce.com/services/data/v66.0/limits"
    ```
    """
}
fn
(instance-url: Str, path: Str): Str {
  `${::auth/normalize-url(instance-url)}${data-path(path)}`
},
(instance-url: Str, path: Str, version: Str): Str {
  `${::auth/normalize-url(instance-url)}${data-path(path, version)}`
}

query-string
meta {
    doc: """
    Build `?a=1&b=2` from a Map, dropping null values; Vec values are joined
    with commas. Returns "" when nothing is left. Exposed for testing.

    **Example**

    ```hot
    ::salesforce::api/query-string({a: 1, b: null})  // "?a=1"
    ::salesforce::api/query-string({a: null})  // ""
    ```
    """
}
fn (params: Map): Str {
  flattened map-vals(filter-vals(params, is-some), (v) { if(is-vec(v), join(map(v, (x) { Str(x) }), ","), v) })
  cond {
    is-empty(flattened) => { "" }
    => { ::uri/query-string(flattened) }
  }
}

segment
meta {
    doc: """
    URL-encode one path segment (a record id, an external id value). Exposed
    for testing.

    **Example**

    ```hot
    ::salesforce::api/segment("a b/c")  // "a%20b%2Fc"
    ```
    """
}
fn (value: Any): Str {
  ::uri/encode(Str(value))
}

build-headers
meta {
    doc: """
    Request headers for a session. `options`: `content-type` (defaults
    to JSON when a body is sent), `accept` (defaults to JSON), `headers`
    (extra headers, e.g. `Sforce-Query-Options`). Exposed for testing.

    **Example**

    ```hot
    ::salesforce::api/build-headers("TOKEN", false, {})  // {Authorization: "Bearer TOKEN", Accept: "application/json"}
    ::salesforce::api/build-headers("TOKEN", true, {content-type: "text/csv"}).Content-Type  // "text/csv"
    ```
    """
}
fn (token: Str, has-body: Bool, options: Map): Map {
  base {
    Authorization: `Bearer ${token}`,
    Accept: or(get(options, "accept"), "application/json")
  }

  with-type if(has-body, {...base, Content-Type: or(get(options, "content-type"), "application/json")}, base)
  {...with-type, ...or(get(options, "headers"), {})}
}

encode-body
meta {no-doc: true}
fn (body: Any): Str {
  cond {
    is-null(body) => { "" }
    is-str(body) => { body }
    => { to-json(untype(body)) }
  }
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

resolve
meta {
    ctx: {"salesforce.api.version": {required: false, secret: false}},
    doc: """
    The session and settings for one call: `{token, instance-url, flow,
    expires-at, api-version}` from `opts` first, then context, then
    defaults (see `::salesforce::auth/resolve-config`), or an Err. A
    credential in `opts` that is blank or null, or `instance-url` or
    `my-domain-url` without one, is an Err. Credentials from `opts` are
    masked in call records and never written to ctx.

    **Example**

    ```hot
    ::salesforce::api/resolve({access-token: "00D...", instance-url: "https://acme.my.salesforce.com"}).api-version
    // "v68.0"
    ```
    """
}
fn (opts: Map): Map {
  session ::auth/session(opts)
  cond {
    is-err(session) => { session }
    => { {...session, api-version: api-version(opts)} }
  }
}

build-request
meta {
    doc: """
    The outgoing `HttpRequest` from a resolved session (see `resolve`).
    Pure; exposed for testing.

    **Example**

    ```hot
    session {token: "TOKEN", instance-url: "https://acme.my.salesforce.com", api-version: "v66.0"}
    ::salesforce::api/build-request("GET", "/limits", null, {}, session).url
    // "https://acme.my.salesforce.com/services/data/v66.0/limits"
    ```
    """
}
fn (method: Str, path: Str, body: Any, options: Map, session: Map): HttpRequest {
  has-body and(is-some(body), not(eq(body, "")))
  HttpRequest({
    method,
    url: build-url(session.instance-url, path, session.api-version),
    headers: build-headers(session.token, has-body, options),
    body: if(has-body, encode-body(body), "")
  })
}

send
meta {
    doc: """
    Make an authenticated request and return the raw `HttpResponse`
    (any status). `body` is JSON-encoded unless it is already a Str (CSV
    for Bulk uploads); pass null or "" for none. `options`:
    `content-type`, `accept`, `headers`. On a 401 from a minted session,
    drops the cached session, mints a new one, and retries once. The
    5-arity form takes per-call credentials (see `resolve`), or a session
    from `::salesforce::auth/session`, which is used as is with no retry.

    **Example**

    ```hot
    // The raw response, at any status
    response ::salesforce::api/send("GET", "/sobjects/Lead/00Q000000000001", null, {})
    if(eq(response.status, 404), null, response.body.Email)

    // For another org
    tenant {access-token: ::hot::ctx/get("tenant.salesforce.token"), instance-url: "https://tenant.my.salesforce.com"}
    ::salesforce::api/send("GET", "/limits", null, {}, tenant)
    ```
    """
}
fn
(method: Str, path: Str, body: Any, options: Map): HttpResponse {
  send(method, path, body, options, {})
},
(method: Str, path: Str, body: Any, options: Map, opts: Map): HttpResponse {
  session resolve(opts)
  cond {
    is-err(session) => { session }
    => {
      response http-request(build-request(method, path, body, options, session))
      cond {
        is-err(response) => { response }
        and(is-invalid-session(response), ne(session.flow, "access-token")) => {
          ::auth/invalidate(opts)
          retry-session resolve(opts)
          cond {
            is-err(retry-session) => { retry-session }
            => { http-request(build-request(method, path, body, options, retry-session)) }
          }
        }
        => { response }
      }
    }
  }
}

unwrap
meta {
    doc: """
    The decoded body of a 2xx response (null for 204), or an Err carrying
    `HttpError`. Exposed for testing.

    **Example**

    ```hot
    ::salesforce::api/unwrap(::hot::http/HttpResponse({status: 200, headers: {}, body: {id: "001"}}))  // {id: "001"}
    ::salesforce::api/unwrap(::hot::http/HttpResponse({status: 204, headers: {}, body: null}))  // null
    ```
    """
}
fn (response: Result): Any {
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { if(eq(response.status, 204), null, response.body) }
    => { err(HttpError(response)) }
  }
}

json
meta {
    doc: """
    Make an authenticated JSON request and unwrap the response. `path`
    is relative to the data API root (e.g. `/sobjects/Lead`), or a full
    `/services/...` path. Salesforce returns 204 for updates and deletes:
    those yield null. The 4-arity form takes per-call credentials (see
    `resolve`). A session (`{token, instance-url}`, e.g. from
    `::salesforce::auth/session()` or managed by the caller) works too,
    and skips the cache and retry.

    **Example**

    ```hot
    limits ::salesforce::api/json("GET", "/limits")
    limits.DailyApiRequests.Remaining

    // For another org
    tenant {refresh-token: "5Aep...", client-id: "3MVG..."}
    limits ::salesforce::api/json("GET", "/limits", null, tenant)
    ```
    """
}
fn
(method: Str, path: Str): Any {
  json(method, path, null)
},
(method: Str, path: Str, body: Any): Any {
  json(method, path, body, {})
},
(method: Str, path: Str, body: Any, opts: Map): Any {
  unwrap(send(method, path, body, {}, opts))
}
