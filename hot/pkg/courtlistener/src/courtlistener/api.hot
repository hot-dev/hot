::courtlistener::api ns
meta {
    ctx: {
        "courtlistener.api-token": {required: false},
        "courtlistener.base-url": {required: false, secret: false}
    },
    doc: """
    Transport for CourtListener: the settings resolver (per-call `opts`
    first, then context variables, then defaults), a typed `HttpError`,
    JSON GETs, and query-string building that drops unset values.

    | opts key | Context variable | Default |
    |---|---|---|
    | `api-token` | `courtlistener.api-token` | none: token-gated calls fail without it |
    | `base-url` | `courtlistener.base-url` | `https://www.courtlistener.com/api/rest/v4` |

    **Per-call credentials.** `api-token` in `opts` is masked in call
    records and never written to context, so parallel flows and tenants
    in one run don't see each other's tokens. Present but blank or null,
    it is an error, never a fallback to context. A per-call `base-url`
    needs an `api-token` in the same `opts`: the context token is never
    sent to a per-call URL.
    """
}

::ctx ::hot::ctx
::uri ::hot::uri
::re ::hot::regex

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

SOURCE "courtlistener"
BASE_URL "https://www.courtlistener.com/api/rest/v4"
PACKAGE_AGENT "hot-dev-courtlistener-pkg/0.1 (+https://hot.dev)"

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

given
meta {
    doc: """True for a non-null value that is not a blank string."""
}
fn (v: Any): Bool {
  match v {
    Null => { false }
    Str => { not(is-empty(trim(v))) }
    _ => { true }
  }
}

pick fn (opts: Map, key: Str, ctx-key: Str, default: Any): Any {
  from-opts get(opts, key)
  from-ctx ::ctx/get(ctx-key)
  cond {
    given(from-opts) => { from-opts }
    given(from-ctx) => { from-ctx }
    => { default }
  }
}

strip-slash fn (url: Str): Str {
  ::re/replace-all(url, "/+$", "")
}

resolve
meta {
    doc: """
    Resolve settings for one call: `{api-token, base-url}`. Values in
    `opts` win over context; an `api-token` in `opts` is used for that
    call only and comes back unchanged. An Err when `api-token` is in
    `opts` but blank or null, or when `opts` has a `base-url` without
    `api-token`.

    **Example**

    ```hot
    cfg ::courtlistener::api/resolve({api-token: tenant.cl-token})
    ```
    """
}
fn (opts: Map): Map {
  from-opts get(opts, "api-token")
  ::ctx/mark-secret(filter([from-opts], given))
  cond {
    and(in("api-token", keys(opts)), not(given(from-opts))) => {
      err("courtlistener: api-token is in the call's opts but is blank or null. Pass a value, or leave api-token out to use the context variable.")
    }

    and(given(get(opts, "base-url")), not(given(from-opts))) => {
      err("courtlistener: base-url is in the call's opts without api-token. Pass api-token with it. The context token is never sent to a per-call URL.")
    }
    => {
      {
        api-token: pick(opts, "api-token", "courtlistener.api-token", null),
        base-url: strip-slash(pick(opts, "base-url", "courtlistener.base-url", BASE_URL))
      }
    }
  }
}

require-api-token
meta {
    doc: """The API token from resolved settings, or an Err naming where to set it."""
}
fn (cfg: Map): Str {
  cond {
    given(cfg.api-token) => { cfg.api-token }
    => { err("courtlistener: no API token; set courtlistener.api-token or pass {api-token: ...}") }
  }
}

// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------

HttpError
meta {
    doc: """
    A failed CourtListener response. `source` is `"courtlistener"`;
    `url` the requested URL (the token goes in a header, never the URL);
    `retry-after` the parsed `Retry-After` seconds on 429s; `message` a
    one-line summary that never includes credentials. `status` is
    normally non-2xx, but it is 200 when the site answered with something
    other than JSON (see `decode-body`).
    """
}
type {
    source: Str,
    status: Int,
    url: Str,
    headers: Map,
    body: Any,
    retry-after: Int?,
    message: Str
}

body-detail fn (body: Any): Str? {
  cond {
    is-str(body) => { if(gt(length(body), 200), `${slice(body, 0, 200)}…`, body) }
    is-map(body) => {
      // CourtListener (Django REST Framework): {detail}
      or(get(body, "detail"), get(body, "error"), get(body, "message"))
    }
    => { null }
  }
}

retry-after fn (headers: Map): Int? {
  v get(headers, "retry-after")
  cond {
    is-null(v) => { null }
    ::re/is-match(trim(Str(v)), "^\\d+$") => { Int(trim(Str(v))) }
    => { null }
  }
}

http-error
meta {
    doc: """Build an `HttpError` from a non-2xx response. Exposed for testing; every request uses it."""
}
fn (response: HttpResponse, url: Str): HttpError {
  headers or(response.headers, {})
  detail body-detail(response.body)
  HttpError({
    source: SOURCE,
    status: response.status,
    url: url,
    headers: headers,
    body: response.body,
    retry-after: retry-after(headers),
    message: if(is-some(detail), `${SOURCE}: HTTP ${response.status}: ${detail}`, `${SOURCE}: HTTP ${response.status} for ${url}`)
  })
}

not-json-error
meta {
    doc: """An `HttpError` for a 2xx response that is not JSON, such as a maintenance page, which would otherwise read as an empty page. Exposed for testing."""
}
fn (response: HttpResponse, url: Str): HttpError {
  HttpError({
    source: SOURCE,
    status: response.status,
    url: url,
    headers: or(response.headers, {}),
    body: null,
    retry-after: null,
    message: `${SOURCE}: expected JSON from ${url}, got something else (usually an HTML page)`
  })
}

is-not-found
meta {
    doc: """True when `e` is an `HttpError` with status 404."""
}
fn (e: Any): Bool {
  and(is-map(e), eq(get(e, "status"), 404))
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

query-string
meta {
    doc: """Build a `?a=1&b=2` suffix from a Map, dropping null and blank values (pure); `""` when nothing remains."""
}
fn (params: Map): Str {
  ::uri/query-string(filter-vals(params, given))
}

path-segment
meta {
    doc: """Percent-encode one path segment."""
}
fn (value: Any): Str {
  ::uri/encode(Str(value))
}

request
meta {
    doc: """
    GET (or another method) a CourtListener URL with `headers`, returning
    the `HttpResponse` on 2xx or an Err carrying `HttpError`. A
    transport failure passes through as its own Err.
    """
}
fn (method: Str, url: Str, headers: Map): HttpResponse {
  response ::hot::http/request(HttpRequest({
    method,
    url,
    headers: {User-Agent: PACKAGE_AGENT, ...headers},
    body: ""
  }))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response }
    => { err(http-error(response, url)) }
  }
}

decode-body
meta {
    doc: """The decoded JSON of a 2xx response, or an Err carrying `HttpError` when the body is not JSON (pure). Exposed for testing."""
}
fn (response: HttpResponse, url: Str): Any {
  body response.body
  text if(is-str(body), trim(body), "")
  parsed if(or(::hot::str/starts-with(text, "{"), ::hot::str/starts-with(text, "[")), from-json(text), body)
  cond {
    is-err(parsed) => { err(not-json-error(response, url)) }
    or(is-map(parsed), is-vec(parsed)) => { parsed }
    => { err(not-json-error(response, url)) }
  }
}

get-json
meta {
    doc: """GET a JSON resource and return the decoded body, or an Err carrying `HttpError`."""
}
fn (url: Str, headers: Map): Any {
  response request("GET", url, {Accept: "application/json", ...headers})
  if(is-err(response), response, decode-body(response, url))
}

get-json-or-null
meta {
    doc: """`get-json`, but a 404 gives null (no such record) instead of an Err."""
}
fn (url: Str, headers: Map): Any {
  out get-json(url, headers)
  cond {
    and(is-err(out), is-not-found(err-value(out))) => { null }
    => { out }
  }
}
