::postmark::api ns
meta {
    doc: """Internal HTTP request utilities for Postmark API.""",
    ctx: {"postmark.server.token": {required: false}}
}

// Namespace alias for ctx module
::ctx ::hot::ctx

http-request ::hot::http/request
is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: response.headers,
    body: response.body
  })
}

is-blank
meta {no-doc: true}
fn (value: Any): Bool {
  cond {
    is-str(value) => { is-empty(trim(value)) }
    => { true }
  }
}

resolve-from
meta {
    doc: """
    The one resolver, pure: the credential for a call from `opts` first,
    then `ctx-values` (a Map of context variables). Returns `{server-token: ...}`, or
    an Err when there is none.

    A `server-token` key in `opts` always decides the call. If its value is null or
    blank that is an Err, never a fallback to context, so a tenant whose
    stored credential is missing can't silently run on the project's
    credential. Nothing is written to ctx. Exposed for testing; `resolve`
    feeds it the context.

    **Example**

    ```hot
    ::postmark::api/resolve-from({server-token: "tenant-b-credential"}, {})  // {server-token: "tenant-b-credential"}
    ::postmark::api/resolve-from({}, {"postmark.server.token": "project-credential"})  // {server-token: "project-credential"}

    // A blank credential in opts never falls back to context
    is-err(::postmark::api/resolve-from({server-token: ""}, {"postmark.server.token": "project-credential"}))  // true
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  cond {
    in("server-token", keys(opts)) => {
      value get(opts, "server-token")
      cond {
        is-blank(value) => { err("postmark: the server-token in this call's opts is empty. Context is not used in its place.") }
        => { {server-token: value} }
      }
    }

    is-blank(get(ctx-values, "postmark.server.token")) => { err("postmark: postmark.server.token is not set. Add your Server API Token in Context Variables, or pass {server-token: ...} in the call's opts.") }
    => { {server-token: get(ctx-values, "postmark.server.token")} }
  }
}

resolve
meta {
    ctx: {"postmark.server.token": {required: false}},
    doc: """
    The credential for one call: `opts` over the `postmark.server.token` context variable
    (see `resolve-from`). Per-call credentials stay in the call; nothing is
    written to ctx, so parallel flows and tenants never share them.
    A credential from `opts` is masked in the run's call records.

    **Example**

    ```hot
    ::postmark::api/resolve({server-token: "tenant-b-credential"}).server-token  // "tenant-b-credential"
    ```
    """
}
fn (opts: Map): Map {
  ::ctx/mark-secret(opts.server-token)
  resolve-from(opts, {"postmark.server.token": ::ctx/get("postmark.server.token")})
}

query-pairs
meta {no-doc: true}
fn (key: Str, value: Any): Vec<Str> {
  cond {
    is-null(value) => { [] }
    is-vec(value) => { reduce(value, (acc, item) { concat(acc, query-pairs(key, item)) }, []) }
    is-map(value) => { reduce(keys(value), (acc, k) { concat(acc, query-pairs(`${key}[${k}]`, get(value, k))) }, []) }
    => {
      text `${value}`
      if(is-empty(text), [], [`${key}=${::hot::uri/encode(text)}`])
    }
  }
}

with-query
meta {
    doc: """
    Add query parameters to a path (pure). Values are URL-encoded. A null or
    empty value is left out, a Vec repeats its key, and a Map becomes
    `key[name]=value` pairs.

    **Example**

    ```hot
    ::postmark::api/with-query("/messages/outbound", {limit: 20, after: null, order: "desc"})
    // "/messages/outbound?limit=20&order=desc"
    ::postmark::api/with-query("/messages/outbound", {q: "a&b #c"})
    // "/messages/outbound?q=a%26b%20%23c"
    ```
    """
}
fn (path: Str, params: Map): Str {
  pairs reduce(keys(params), (acc, k) { concat(acc, query-pairs(Str(k), get(params, k))) }, [])
  if(is-empty(pairs), path, `${path}?${join(pairs, "&")}`)
}

encode-body
meta {
    doc: """
    The wire form of a request body: `""` means no body at all, anything
    else is JSON. Exposed for testing.

    **Example**

    ```hot
    ::postmark::api/encode-body("")  // ""
    ::postmark::api/encode-body({Name: "Ada"})  // "{\"Name\":\"Ada\"}"
    ```
    """
}
fn (body: Any): Str {
  if(eq(body, ""), "", to-json(untype(body)))
}

request
meta {
    ctx: {"postmark.server.token": {required: false}},
    doc: """
    Make an HTTP request with pre-filled service headers. Additional headers
    can be provided to merge/override defaults. With no token from either
    place, the call returns an Err (see `resolve`).

    **Example**

    ```hot
    response ::postmark::api/request("GET", `${::postmark/BASE_URL}/server`)
    response.body.Name

    // One call on a tenant's server, with an extra header
    ::postmark::api/request("GET", `${::postmark/BASE_URL}/server`, {"X-Trace": "abc"}, "", {
        server-token: ::hot::ctx/get("tenant.postmark.token")
    })
    ```
    """
}
fn
(method: Str, url: Str, additional-headers: Map, body: Any): HttpResponse {
  request(method, url, additional-headers, body, {})
},
// 5-arity: per-call opts ({server-token}), then ctx
(method: Str, url: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { request(method, url, additional-headers, body, resolved.server-token) }
  }
},
// 5-arity: explicit server token override
(method: Str, url: Str, additional-headers: Map, body: Any, server-token: Str): HttpResponse {
  ::ctx/mark-secret(server-token)
  default-headers {
    "X-Postmark-Server-Token": server-token,
    Accept: "application/json"
  }

  // Add Content-Type for requests with bodies
  headers if(eq(body, ""), default-headers, merge(default-headers, {"Content-Type": "application/json"}))

  // Merge in any additional headers (they can override defaults)
  final-headers merge(headers, additional-headers)

  ::hot::http/request(HttpRequest({
    method: method,
    url: url,
    headers: final-headers,
    body: encode-body(body)
  }))
},
(method: Str, url: Str, additional-headers: Map): HttpResponse {
  request(method, url, additional-headers, "")
},
(method: Str, url: Str): HttpResponse {
  request(method, url, {}, "")
}
