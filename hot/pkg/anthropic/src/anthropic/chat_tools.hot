::anthropic::chat-tools ns
meta {
    doc: """
    Anthropic adapter that satisfies the `::ai::chat/run-loop` contract:

    ```
    chat-with-tools(
        model: Str,
        messages: Vec<::ai::chat/Message>,
        system: Str?,
        tools: Vec<::ai::tool/Tool>?
    ): ::ai::chat/ChatReply
    ```

    The function translates `::ai::chat/Message` records into
    Anthropic's content-block shape, calls
    `::anthropic::messages/post`, and normalizes the response into a
    `::ai::chat/ChatReply` so that `run-loop` does not need to know
    about Anthropic's wire format.

    **Per-call credentials.** Each entry point also takes a trailing
    `opts: Map` (`api-key`, `base-url`, `api-version`, see
    `::anthropic::api/resolve`). `chat-with-tools` and
    `chat-with-tools-stream` with `opts` match the `chat-opts-fn` and
    `chat-stream-opts-fn` slots of `::ai::chat/ChatOptions`, which hand them
    `ChatOptions.provider-opts`:

    ```hot
    opts ::ai::chat/ChatOptions({
        chat-opts-fn: ::anthropic::chat-tools/chat-with-tools,
        model: "claude-sonnet-4-5",
        provider-opts: {api-key: tenant-key}
    })
    answer ::ai::chat/run-loop(opts, "What is 17 + 25?")
    ```
    """
}

::messages ::anthropic::messages
::ai-chat  ::ai::chat
::ai-tool  ::ai::tool

HttpError          ::anthropic::api/HttpError
ReplyDelta         ::ai-chat/ReplyDelta
TextDelta          ::ai-chat/TextDelta
ToolUseStart       ::ai-chat/ToolUseStart
ToolUseInputDelta  ::ai-chat/ToolUseInputDelta
ToolUseEnd         ::ai-chat/ToolUseEnd
StreamStop         ::ai-chat/StreamStop

DEFAULT_MAX_TOKENS 1024

ChatRequestOptions
meta {
    doc: """
    Per-request output controls for Anthropic Messages.

    Claude Opus 5 has thinking enabled by default and counts thinking plus
    visible text against `max_tokens`, so callers selecting it should use a
    materially larger ceiling than the legacy 1024-token adapter default.

    `cache-control` turns on prompt caching, as Anthropic's own value:
    `{type: "ephemeral"}`, or `{type: "ephemeral", ttl: "1h"}`. It marks the
    system prompt, which caches the tools with it, and the conversation, whose
    mark moves forward each turn. A loop that sends its long skills and pack
    as the system prompt then reads them from the cache on every call. Keep
    what changes between calls out of the system prompt, since a change there
    misses the cache for everything after it.
    """
}
type {
    max-tokens: Int,
    effort: Str?,
    cache-control: Map?,
}

DEFAULT_REQUEST_OPTIONS ChatRequestOptions({
    max-tokens: DEFAULT_MAX_TOKENS,
    effort: null,
    cache-control: null,
})

mark-system-prompt
meta {
    no-doc: true,
    doc: """
    Internal: `request` with its system prompt as a block that holds
    `cache-control`. An empty prompt stays as it is: there's nothing to cache,
    and the API refuses an empty block.
    """
}
fn (request: Map, cache-control: Map): Map {
    system get(request, "system")
    cond {
        or(not(is-str(system)), is-empty(system)) => { request }
        => { assoc(request, "system", [{type: "text", text: system, cache_control: cache-control}]) }
    }
}

apply-request-options
meta {
    doc: """
    Apply output, effort and cache controls to an Anthropic request map.

    **Example**

    ```hot
    options ::anthropic::chat-tools/ChatRequestOptions({max-tokens: 4096, effort: "high", cache-control: {type: "ephemeral"}})
    request ::anthropic::chat-tools/apply-request-options({model: "claude-sonnet-4-5", system: "Be brief."}, options)
    request.max_tokens  // 4096
    request.output_config  // {effort: "high"}
    first(request.system).cache_control  // {type: "ephemeral"}
    ```
    """
}
fn (request: Map, options: ChatRequestOptions): Map {
    with-output assoc(request, "max_tokens", options.max-tokens)
    with-effort match options.effort {
        Null => { with-output }
        Str => { assoc(with-output, "output_config", {effort: options.effort}) }
    }

    match options.cache-control {
        Null => { with-effort }
        Map => {
            assoc(mark-system-prompt(with-effort, options.cache-control), "cache_control", options.cache-control)
        }
    }
}

// ============================================================================
// Outbound: ::ai::chat/Message -> Anthropic content blocks
// ============================================================================

to-tool-use-block
meta {
    doc: """
    Convert a `::ai::tool/ToolCall` into an Anthropic `tool_use` content
    block.

    **Example**

    ```hot
    call ::ai::tool/ToolCall({id: "toolu_1", name: "search", input: {q: "hot"}})
    ::anthropic::chat-tools/to-tool-use-block(call)  // {type: "tool_use", id: "toolu_1", name: "search", input: {q: "hot"}}
    ```
    """
}
fn (call: ::ai-tool/ToolCall): Map {
    {
        type: "tool_use",
        id: call.id,
        name: ::ai-tool/provider-name(call.name),
        input: call.input
    }
}

to-anthropic-message
meta {
    doc: """
    Convert a single normalized `::ai::chat/Message` into Anthropic's
    `InputMessage` shape. Tool results are emitted as `user` turns
    with a `tool_result` content block (Anthropic's wire convention).

    **Example**

    ```hot
    ::anthropic::chat-tools/to-anthropic-message(::ai::chat/user-message("Hi"))  // {role: "user", content: "Hi"}

    result ::ai::chat/Message({role: "tool", content: {sum: 42}, tool-call-id: "toolu_1"})
    first(::anthropic::chat-tools/to-anthropic-message(result).content).tool_use_id  // "toolu_1"
    ```
    """
}
fn cond (m: ::ai-chat/Message): Map {
    eq(m.role, "tool") => {
        {
            role: "user",
            content: [{
                type: "tool_result",
                tool_use_id: m.tool-call-id,
                content: to-json(untype(m.content))
            }]
        }
    }

    eq(m.role, "assistant") => {
        text ::ai-chat/message-text(m)
        text-block if(not(is-empty(text)), [{type: "text", text: text}], [])
        tool-blocks if(is-null(m.tool-calls), [], map(m.tool-calls, to-tool-use-block))
        {role: "assistant", content: concat(text-block, tool-blocks)}
    }
    => {
        {role: m.role, content: ::ai-chat/message-text(m)}
    }
}

to-anthropic-tool
meta {
    doc: """
    Convert a `::ai::tool/Tool` into Anthropic's `Tool` shape (rename
    `input-schema` to `input_schema`, keep `name` and `description`).

    **Example**

    ```hot
    tool ::ai::tool/Tool({
      name: "search",
      description: "Search the docs.",
      input-schema: {type: "object", properties: {q: {type: "string"}}},
      fn: (input) { [] }
    })
    ::anthropic::chat-tools/to-anthropic-tool(tool).name  // "search"
    ::anthropic::chat-tools/to-anthropic-tool(tool).input_schema.type  // "object"
    ```
    """
}
fn (t: ::ai-tool/Tool): Map {
    base {
        name: ::ai-tool/provider-name(t.name),
        input_schema: t.input-schema
    }

    if(is-null(t.description), base, assoc(base, "description", t.description))
}

// ============================================================================
// Inbound: Anthropic response -> ::ai::chat/ChatReply
// ============================================================================

block-text
meta {
    doc: """
    Text from a single content block, or empty string.

    **Example**

    ```hot
    ::anthropic::chat-tools/block-text({type: "text", text: "Hello"})  // "Hello"
    ::anthropic::chat-tools/block-text({type: "tool_use", id: "toolu_1", name: "search"})  // ""
    ```
    """
}
fn (b: Map): Str {
    if(eq(b.type, "text"), or(b.text, ""), "")
}

block-tool-call
meta {
    doc: """
    Convert a `tool_use` content block into a `::ai::tool/ToolCall`, or null
    otherwise.

    **Example**

    ```hot
    ::anthropic::chat-tools/block-tool-call({type: "tool_use", id: "toolu_1", name: "search", input: {q: "hot"}}).name  // "search"
    ::anthropic::chat-tools/block-tool-call({type: "text", text: "Hello"})  // null
    ```
    """
}
fn (b: Map): ::ai-tool/ToolCall? {
    cond {
        eq(b.type, "tool_use") => { ::ai-tool/ToolCall({id: b.id, name: b.name, input: or(b.input, {})}) }
        => { null }
    }
}

response-text
meta {
    doc: """
    Concatenate text content blocks from an Anthropic response.

    **Example**

    ```hot
    ::anthropic::chat-tools/response-text([{type: "text", text: "Hello "}, {type: "text", text: "world"}])  // "Hello world"
    ```
    """
}
fn (blocks: Vec): Str {
    join(map(blocks, block-text), "")
}

response-tool-calls
meta {
    doc: """
    Extract `::ai::tool/ToolCall` entries from a list of Anthropic content
    blocks.

    **Example**

    ```hot
    blocks [{type: "text", text: "Searching."}, {type: "tool_use", id: "toolu_1", name: "search", input: {q: "hot"}}]
    map(::anthropic::chat-tools/response-tool-calls(blocks), %.id)  // ["toolu_1"]
    ```
    """
}
fn (blocks: Vec): Vec<::ai-tool/ToolCall> {
    filter(
        map(blocks, block-tool-call),
        is-some
    )
}

prompt-usage
meta {
    no-doc: true,
    doc: """
    Internal: a reply's usage. Anthropic's `input_tokens` is only what the
    cache didn't cover, so `input-tokens` adds the cached tokens back: it
    counts the whole prompt, with a cache or without one, as it does for other
    providers. `cache-read-tokens` and `cache-write-tokens` are the parts of it
    the cache served and took.
    """
}
fn (uncached: Int, cache-read: Int, cache-write: Int, output: Int): Map {
    {
        input-tokens: add(uncached, add(cache-read, cache-write)),
        output-tokens: output,
        cache-read-tokens: cache-read,
        cache-write-tokens: cache-write
    }
}

response-usage
meta {
    doc: """
    Normalize Anthropic's usage shape into `{input-tokens, output-tokens,
    cache-read-tokens, cache-write-tokens}`.

    **Example**

    ```hot
    ::anthropic::chat-tools/response-usage({input_tokens: 10, cache_read_input_tokens: 90, output_tokens: 5})
    // {input-tokens: 100, output-tokens: 5, cache-read-tokens: 90, cache-write-tokens: 0}

    ::anthropic::chat-tools/response-usage(null)  // null
    ```
    """
}
fn (u: Any): Map? {
    cond {
        is-null(u) => { null }
        => {
            prompt-usage(
                or(get(u, "input_tokens"), 0),
                or(get(u, "cache_read_input_tokens"), 0),
                or(get(u, "cache_creation_input_tokens"), 0),
                or(get(u, "output_tokens"), 0),
            )
        }
    }
}

// ============================================================================
// Public entry point
// ============================================================================

chat-with-tools
meta {
    ai-provider: {
        variant: "Anthropic",
        detect-prefixes: ["claude"],
        display-name: "Anthropic",
        capabilities: ["tools", "streaming", "vision", "system-prompt"],
    },
    doc: """
    Tools-aware chat function compatible with `::ai::chat/run-loop`.

    Parameters

    - `model` — Anthropic model id (e.g. `"claude-sonnet-4-5"`).
    - `messages` — conversation history as `Vec<::ai::chat/Message>`.
    - `system` — optional system prompt.
    - `tools` — optional `Vec<::ai::tool/Tool>`. When non-null, tools
      are advertised to the model and `tool_use` responses become
      `ChatReply.tool-calls`.

    Returns a normalized `::ai::chat/ChatReply` regardless of the
    underlying response shape.

    **Example**

    ```hot
    ::tool ::ai::tool

    add fn (x: Int, y: Int): Int { add(x, y) }

    opts ::ai::chat/ChatOptions({
        chat-fn: ::anthropic::chat-tools/chat-with-tools,
        model: "claude-sonnet-4-5",
        tools: [::tool/from-fn(add)]
    })

    answer ::ai::chat/run-loop(opts, "What is 17 + 25?")
    ```
    """
}
fn (model: Str, messages: Vec<::ai-chat/Message>, system: Str?, tools: Vec<::ai-tool/Tool>?): ::ai-chat/ChatReply {
    chat-with-tools-options(model, messages, system, tools, DEFAULT_REQUEST_OPTIONS)
},
(model: Str, messages: Vec<::ai-chat/Message>, system: Str?, tools: Vec<::ai-tool/Tool>?, opts: Map): ::ai-chat/ChatReply {
    chat-with-tools-options(model, messages, system, tools, DEFAULT_REQUEST_OPTIONS, opts)
}

chat-with-tools-options
meta {
    doc: """
    `chat-with-tools` with an explicit output ceiling and Anthropic effort.
    Bind this function in a closure when a session needs model-specific
    controls while retaining the normalized four-argument chat contract.
    A trailing `opts` carries per-call credentials and settings.

    **Example**

    ```hot
    options ::anthropic::chat-tools/ChatRequestOptions({max-tokens: 4096, effort: "high"})

    reply ::anthropic::chat-tools/chat-with-tools-options(
      "claude-sonnet-4-5",
      [::ai::chat/user-message("Summarize the release notes.")],
      "Be brief.",
      null,
      options
    )
    reply.text
    reply.usage.output-tokens
    ```
    """
}
fn
(model: Str, messages: Vec<::ai-chat/Message>, system: Str?, tools: Vec<::ai-tool/Tool>?, options: ChatRequestOptions): ::ai-chat/ChatReply {
    chat-with-tools-options(model, messages, system, tools, options, {})
},
(model: Str, messages: Vec<::ai-chat/Message>, system: Str?, tools: Vec<::ai-tool/Tool>?, options: ChatRequestOptions, opts: Map): ::ai-chat/ChatReply {
    anth-messages map(messages, to-anthropic-message)
    anth-tools if(is-null(tools), null, map(tools, to-anthropic-tool))

    base {
        model: model,
        messages: anth-messages,
        max_tokens: options.max-tokens
    }

    with-system if(is-null(system), base, assoc(base, "system", system))
    with-effort apply-request-options(with-system, options)
    with-tools if(is-null(anth-tools), with-effort, assoc(with-effort, "tools", anth-tools))

    response ::messages/post(::messages/MessagesPostRequest(with-tools), opts)

    match response {
        Result.Err => { err(response) }
        Result.Ok => {
            blocks or(response.content, [])
            text response-text(blocks)
            calls response-tool-calls(blocks)
            stop or(response.stop_reason, "end_turn")

            ::ai-chat/ChatReply({
                text: if(is-empty(text), null, text),
                tool-calls: if(is-empty(calls), null, calls),
                stop-reason: stop,
                usage: response-usage(response.usage),
                raw: response
            })
        }
    }
}

// ============================================================================
// Token counting
// ============================================================================

::beta-messages ::anthropic::beta::messages

count-tokens
meta {
    doc: """
    Count the input tokens a `Vec<::ai::chat/Message>` would consume
    against `model`, using Anthropic's stable
    `/v1/messages/count_tokens` endpoint. Returns the exact count
    Anthropic would charge.

    Compatible with the `count-tokens-fn` slot on
    `::ai::chat/ChatOptions`:

    ```
    (messages: Vec<Message>, model: Str): Int
    ```

    System prompt and tools are not currently included by this
    helper — pass them via a custom wrapper if you need to model
    their cost. The caller's pre-call budget check should add the
    model's reserved overhead separately.

    Network calls cost nothing in API credits but they are not free
    in latency; cache the result when checking budget repeatedly
    against an unchanged history.

    The `count-tokens-fn` slot has no credentials argument. For a per-call
    key, bind the three-argument form in a closure:
    `(messages, model) { count-tokens(messages, model, {api-key: key}) }`.

    **Example**

    ```hot
    messages [::ai::chat/user-message("How many tokens is this?")]
    ::anthropic::chat-tools/count-tokens(messages, "claude-sonnet-4-5")

    // With a per-call key
    ::anthropic::chat-tools/count-tokens(messages, "claude-sonnet-4-5", {api-key: ::hot::ctx/get("tenant.anthropic-key")})
    ```
    """
}
fn
(messages: Vec<::ai-chat/Message>, model: Str): Int {
    count-tokens(messages, model, {})
},
(messages: Vec<::ai-chat/Message>, model: Str, opts: Map): Int {
    anth-messages map(messages, to-anthropic-message)
    request ::beta-messages/BetaMessagesCountTokensPostRequest({
        model: model,
        messages: anth-messages
    })
    response ::beta-messages/count-tokens-post(request, opts)
    response.input_tokens
}

// ============================================================================
// Streaming
// ============================================================================

EMPTY_STATE {
    text-blocks: {},
    tool-blocks: {},
    block-order: [],
    stop-reason: null,
    usage-input: 0,
    usage-cache-read: 0,
    usage-cache-write: 0,
    usage-output: 0
}

handle-content-block-start
meta {
    no-doc: true,
    doc: """Internal: dispatch a `content_block_start` SSE event into ReplyDelta + state."""
}
fn (state: Map, idx: Int, block: Map, on-delta: Fn): Map {
    cond {
        eq(block.type, "text") => {
            assoc-in(state, ["text-blocks", idx], "")
        }

        eq(block.type, "tool_use") => {
            id or(block.id, "")
            name or(block.name, "")
            on-delta(ReplyDelta.ToolUseStart(ToolUseStart({id: id, name: name})))
            assoc-in(
                assoc-in(state, ["tool-blocks", idx], {id: id, name: name, input-json: ""}),
                ["block-order"],
                concat(or(state.block-order, []), [idx])
            )
        }
        => { state }
    }
}

handle-content-block-delta
meta {
    no-doc: true,
    doc: """Internal: dispatch a `content_block_delta` SSE event into ReplyDelta + state."""
}
fn (state: Map, idx: Int, delta: Map, on-delta: Fn): Map {
    cond {
        eq(delta.type, "text_delta") => {
            text or(delta.text, "")
            on-delta(ReplyDelta.TextDelta(TextDelta({text: text})))
            current or(get-in(state, ["text-blocks", idx]), "")
            assoc-in(state, ["text-blocks", idx], concat(current, text))
        }

        eq(delta.type, "input_json_delta") => {
            partial or(delta.partial_json, "")
            tool-block or(get-in(state, ["tool-blocks", idx]), {id: "", name: "", input-json: ""})
            on-delta(ReplyDelta.ToolUseInputDelta(ToolUseInputDelta({id: tool-block.id, partial-input-json: partial})))
            assoc-in(
                state,
                ["tool-blocks", idx],
                {...tool-block, input-json: concat(or(tool-block.input-json, ""), partial)}
            )
        }
        => { state }
    }
}

handle-content-block-stop
meta {
    no-doc: true,
    doc: """Internal: dispatch a `content_block_stop` SSE event into ReplyDelta + state."""
}
fn (state: Map, idx: Int, on-delta: Fn): Map {
    tool-block get-in(state, ["tool-blocks", idx])
    cond {
        is-some(tool-block) => {
            on-delta(ReplyDelta.ToolUseEnd(ToolUseEnd({id: tool-block.id})))
            state
        }
        => { state }
    }
}

handle-message-delta
meta {
    no-doc: true,
    doc: """Internal: capture stop_reason and output token usage from a `message_delta` event."""
}
fn (state: Map, data: Map): Map {
    delta or(data.delta, {})
    usage or(data.usage, {})
    {
        ...state,
        stop-reason: or(delta.stop_reason, state.stop-reason),
        usage-output: add(or(state.usage-output, 0), or(usage.output_tokens, 0))
    }
}

handle-message-start
meta {
    no-doc: true,
    doc: """Internal: capture initial input usage from a `message_start` event."""
}
fn (state: Map, data: Map): Map {
    msg or(data.message, {})
    usage or(msg.usage, {})
    {
        ...state,
        usage-input: add(or(state.usage-input, 0), or(usage.input_tokens, 0)),
        usage-cache-read: add(or(state.usage-cache-read, 0), or(usage.cache_read_input_tokens, 0)),
        usage-cache-write: add(or(state.usage-cache-write, 0), or(usage.cache_creation_input_tokens, 0))
    }
}

handle-event
meta {
    no-doc: true,
    doc: """
    Internal: dispatch a single SSE event from Anthropic's
    `post-stream` into the appropriate ReplyDelta emissions and a
    new accumulator state.
    """
}
fn cond (state: Map, event: Map, on-delta: Fn): Map {
    eq(event.event, "message_start") => {
        handle-message-start(state, or(event.data, {}))
    }

    eq(event.event, "content_block_start") => {
        data or(event.data, {})
        handle-content-block-start(state, or(data.index, 0), or(data.content_block, {}), on-delta)
    }

    eq(event.event, "content_block_delta") => {
        data or(event.data, {})
        handle-content-block-delta(state, or(data.index, 0), or(data.delta, {}), on-delta)
    }

    eq(event.event, "content_block_stop") => {
        data or(event.data, {})
        handle-content-block-stop(state, or(data.index, 0), on-delta)
    }

    eq(event.event, "message_delta") => {
        handle-message-delta(state, or(event.data, {}))
    }
    => { state }
}

drain-stream
meta {
    no-doc: true,
    doc: """
    Internal: tail-recursively consume `iter`, accumulating ReplyDelta events
    into `state`. An `error` event ends it in an Err carrying `HttpError`. The
    call itself succeeded, so its `status` is 200, and its `body` holds the
    API's reason, as a refused call's does.
    """
}
fn cond (iter: Any, on-delta: Fn, state: Map): Map {
    => {
        n next(iter)
        cond {
            n.done => { state }
            eq(n.value.event, "error") => { err(HttpError({status: 200, headers: {}, body: n.value.data})) }
            => { drain-stream(iter, on-delta, handle-event(state, n.value, on-delta)) }
        }
    }
}

finalize-state
meta {
    no-doc: true,
    doc: """
    Internal: convert accumulated stream state into a `ChatReply`.
    Concatenates text blocks in index order, parses the buffered
    tool-input JSON for each tool block, and assembles the final
    usage map.
    """
}
fn (state: Map): ::ai-chat/ChatReply {
    text sort(keys(or(state.text-blocks, {})))
        |> map((k) { or(get-in(state, ["text-blocks", k]), "") })
        |> join("")

    tool-indices or(state.block-order, [])
    calls map(tool-indices, (idx) {
        block get-in(state, ["tool-blocks", idx])
        json-str or(block.input-json, "")
        parsed cond {
            is-empty(json-str) => { {} }
            => {
                decoded from-json(json-str)
                if(is-err(decoded), {}, decoded)
            }
        }

        ::ai-tool/ToolCall({id: block.id, name: block.name, input: parsed})
    })

    stop or(state.stop-reason, "end_turn")
    usage prompt-usage(
        or(state.usage-input, 0),
        or(state.usage-cache-read, 0),
        or(state.usage-cache-write, 0),
        or(state.usage-output, 0),
    )

    ::ai-chat/ChatReply({
        text: if(is-empty(text), null, text),
        tool-calls: if(is-empty(calls), null, calls),
        stop-reason: stop,
        usage: usage,
        raw: null
    })
}

chat-with-tools-stream
meta {
    doc: """
    Streaming counterpart to `chat-with-tools`, compatible with
    `::ai::chat/run-loop-stream`. Translates Anthropic SSE events
    into provider-agnostic `::ai::chat/ReplyDelta` events delivered
    via `on-delta`, and returns a fully-aggregated `ChatReply` once
    the stream terminates.

    Parameters

    - `model` — Anthropic model id.
    - `messages` — conversation history as `Vec<::ai::chat/Message>`.
    - `system` — optional system prompt.
    - `tools` — optional `Vec<::ai::tool/Tool>`.
    - `on-delta` — callback `(delta: ReplyDelta): Null` invoked for
      every event during streaming. Use `::ai::chat/noop-on-delta`
      if you only care about the final `ChatReply`.

    **Example**

    ```hot
    on-text (delta) {
        match delta {
            ::ai::chat/ReplyDelta.TextDelta => { print(delta.text) }
            => { null }
        }
    }

    reply ::anthropic::chat-tools/chat-with-tools-stream(
        "claude-sonnet-4-5",
        [::ai::chat/user-message("Hi")],
        null,
        null,
        on-text
    )
    ```

    Then `reply.text` holds the full assistant text, `reply.tool-calls`
    holds any parsed tool calls (with their input maps reconstructed
    from streamed JSON fragments), and `reply.usage` carries the
    provider-reported token totals.

    A refused call, or an `error` event partway through the stream, returns
    an Err carrying `::anthropic::api/HttpError`, whose `body` holds the API's
    reason. `on-delta` gets no `Stop` then.
    """
}
fn
(model: Str, messages: Vec<::ai-chat/Message>, system: Str?, tools: Vec<::ai-tool/Tool>?, on-delta: Fn): ::ai-chat/ChatReply {
    chat-with-tools-stream-options(
        model,
        messages,
        system,
        tools,
        on-delta,
        DEFAULT_REQUEST_OPTIONS
    )
},
(model: Str, messages: Vec<::ai-chat/Message>, system: Str?, tools: Vec<::ai-tool/Tool>?, on-delta: Fn, opts: Map): ::ai-chat/ChatReply {
    chat-with-tools-stream-options(
        model,
        messages,
        system,
        tools,
        on-delta,
        DEFAULT_REQUEST_OPTIONS,
        opts
    )
}

chat-with-tools-stream-options
meta {
    doc: """
    Streaming `chat-with-tools` with explicit output and effort controls.

    **Example**

    ```hot
    options ::anthropic::chat-tools/ChatRequestOptions({max-tokens: 4096, effort: "high"})

    reply ::anthropic::chat-tools/chat-with-tools-stream-options(
      "claude-sonnet-4-5",
      [::ai::chat/user-message("Summarize the release notes.")],
      "Be brief.",
      null,
      ::ai::chat/noop-on-delta,
      options
    )
    reply.text
    ```
    """
}
fn
(model: Str, messages: Vec<::ai-chat/Message>, system: Str?, tools: Vec<::ai-tool/Tool>?, on-delta: Fn, options: ChatRequestOptions): ::ai-chat/ChatReply {
    chat-with-tools-stream-options(model, messages, system, tools, on-delta, options, {})
},
(model: Str, messages: Vec<::ai-chat/Message>, system: Str?, tools: Vec<::ai-tool/Tool>?, on-delta: Fn, options: ChatRequestOptions, opts: Map): ::ai-chat/ChatReply {
    anth-messages map(messages, to-anthropic-message)
    anth-tools if(is-null(tools), null, map(tools, to-anthropic-tool))

    base {
        model: model,
        messages: anth-messages,
        max_tokens: options.max-tokens
    }

    with-system if(is-null(system), base, assoc(base, "system", system))
    with-effort apply-request-options(with-system, options)
    with-tools if(is-null(anth-tools), with-effort, assoc(with-effort, "tools", anth-tools))

    ::messages/post-stream(::messages/MessagesPostRequest(with-tools), opts)
        |> if-ok((response) { drain-stream(response.body, on-delta, EMPTY_STATE) })
        |> if-ok((final-state) {
            reply finalize-state(final-state)
            on-delta(ReplyDelta.Stop(StreamStop({reason: reply.stop-reason, usage: reply.usage})))
            reply
        })
}
