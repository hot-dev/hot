::opensanctions::http ns
meta {
    doc: """
    Requests to OpenSanctions: one `request` function and a typed
    `HttpError`.
    """
}

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

USER_AGENT "hot-dev-opensanctions-pkg/0.1 (+https://hot.dev)"

HttpError
meta {
    doc: """A non-2xx response from OpenSanctions. `url` is the requested URL (without credentials); `message` is a one-line summary."""
}
type {
    status: Int,
    url: Str,
    headers: Map,
    body: Any,
    message: Str
}

body-snippet
meta {no-doc: true}
fn (body: Any): Str {
  text match body {
    Null => { "" }
    Str => { body }
    Bytes => { "" }
    _ => { to-json(body) }
  }

  if(gt(length(text), 200), `${slice(text, 0, 200)}…`, text)
}

http-error
meta {
    doc: """
    Build an `HttpError` from a non-2xx response. Exposed for testing; every
    request uses it.

    **Example**

    ```hot
    url "https://example.test/x"
    response ::hot::http/HttpResponse({status: 404, headers: {}, body: "not here"})
    e ::opensanctions::http/http-error(response, url)
    e.status  // 404
    e.message  // "HTTP 404 from https://example.test/x: not here"
    ```
    """
}
fn (response: HttpResponse, url: Str): HttpError {
  snippet body-snippet(response.body)
  HttpError({
    status: response.status,
    url: url,
    headers: or(response.headers, {}),
    body: response.body,
    message: if(is-empty(snippet), `HTTP ${response.status} from ${url}`, `HTTP ${response.status} from ${url}: ${snippet}`)
  })
}

request
meta {
    doc: """
    One request with the package User-Agent. Returns the `HttpResponse` on
    2xx, or an Err carrying `HttpError` (transport failures pass through as
    their own Err).

    **Example**

    ```hot
    ::os ::opensanctions

    key ::hot::ctx/get("opensanctions.api-key")
    response ::opensanctions::http/request(
      "POST",
      ::os/match-url("https://api.opensanctions.org", "default", {limit: 5}),
      ::os/match-headers(key),
      to-json(::os/match-body("Acme Trading", {}))
    )
    response.body.responses.q.results
    ```
    """
}
fn (method: Str, url: Str, headers: Map, body: Any): HttpResponse {
  response ::hot::http/request(HttpRequest({
    method,
    url,
    headers: {User-Agent: USER_AGENT, ...headers},
    body
  }))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response }
    => { err(http-error(response, url)) }
  }
}
