::hot::pkg ns

hot.pkg.box {
  name: "hot.dev/box",
  version: "0.1.0",
  hot-min-version: "3.0.0",
  description: "Box Platform API v2.0 bindings for Hot: Client Credentials, JWT server auth and OAuth 2.0 with a store-backed keeper for Box's single-use refresh tokens; folder listing with marker paging, search, binary-safe downloads with Range chunking, multipart and chunked upload sessions, extracted-text representations, shared links, collaborations, versions, the Events API and admin logs, and webhooks v2 with signature verification.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["box", "documents", "files", "storage", "content"],
  deps: {
    "hot.dev/jwt": {
      local: "../jwt",
      git: "https://github.com/hot-dev/hot",
      path: "hot/pkg/jwt"
    },
    "hot.dev/oauth2": {
      local: "../oauth2",
      git: "https://github.com/hot-dev/hot",
      path: "hot/pkg/oauth2"
    }
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
