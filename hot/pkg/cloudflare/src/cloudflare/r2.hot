::cloudflare::r2 ns
meta {
    doc: """
    R2 bucket management over the Cloudflare API: list, create, get, and
    delete buckets. Object reads and writes use R2's S3-compatible API —
    use the `aws-s3` package against
    `https://{account_id}.r2.cloudflarestorage.com` (region `auto`) with an
    R2 access key pair.
    """,
    ctx: {"cloudflare.token": {required: true}, "cloudflare.account.id": {required: true}}
}

::api ::cloudflare::api

ListPage ::cloudflare::api/ListPage

bucket-suffix fn (name: Str): Str {
  `/r2/buckets/${::api/seg(name)}`
}

jurisdiction-headers
meta {
    doc: """The `cf-r2-jurisdiction` header for a jurisdiction (`"eu"`, `"fedramp"`, …), or no header for null/`"default"`. Exposed for testing."""
}
fn (jurisdiction: Str?): Map {
  cond {
    is-null(jurisdiction) => { {} }
    eq(jurisdiction, "default") => { {} }
    => { {cf-r2-jurisdiction: jurisdiction} }
  }
}

send-json fn (method: Str, suffix: Str, body: Any, jurisdiction: Str?): Any {
  path ::api/account-path(suffix)
  headers jurisdiction-headers(jurisdiction)
  cond {
    is-err(path) => { path }
    => {
      response cond {
        eq(body, "") => { ::api/send(method, path, headers, "") }
        => { ::api/send(method, path, {...headers, Content-Type: "application/json"}, to-json(untype(body))) }
      }

      cond {
        is-err(response) => { response }
        => { or(response.body, {}) }
      }
    }
  }
}

list-buckets
meta {
    doc: """
    GET /accounts/{account_id}/r2/buckets - One page of buckets.
    `params`: `name_contains`, `start_after`, `per_page` (1–1000),
    `cursor`, `order` (`name`), `direction`, and `jurisdiction` (sent as
    the `cf-r2-jurisdiction` header). Returns a `ListPage` whose `result`
    is the bucket list.
    """
}
fn
(): ListPage {
  list-buckets({})
},
(params: Map): ListPage {
  jurisdiction get(params, "jurisdiction")
  query-params filter-keys(params, (k) { ne(k, "jurisdiction") })
  envelope send-json("GET", `/r2/buckets${::api/query(query-params)}`, "", jurisdiction)
  cond {
    is-err(envelope) => { envelope }
    => { ::api/to-page(envelope, "buckets") }
  }
}

list-all-buckets
meta {
    doc: """Every bucket matching `params`, following cursors up to `max` buckets (default 10000)."""
}
fn
(): Vec {
  list-all-buckets({})
},
(params: Map): Vec {
  list-all-buckets(params, ::api/DEFAULT_MAX_ITEMS)
},
(params: Map, max: Int): Vec {
  ::api/collect-cursor(list-buckets, {per_page: 1000, ...params}, max)
}

create-bucket-body
meta {
    doc: """The create body: `{name, locationHint?, storageClass?}` from `opts` (`location_hint`/`locationHint`, `storage_class`/`storageClass`). Exposed for testing."""
}
fn (name: Str, opts: Map): Map {
  {name: name}
    |> assoc-some("locationHint", or(get(opts, "locationHint"), get(opts, "location_hint")))
    |> assoc-some("storageClass", or(get(opts, "storageClass"), get(opts, "storage_class")))
}

create-bucket
meta {
    doc: """
    POST /accounts/{account_id}/r2/buckets - Create a bucket. `opts`:
    `location_hint` (`apac`, `eeur`, `enam`, `weur`, `wnam`, `oc`),
    `storage_class` (`Standard`, `InfrequentAccess`), `jurisdiction`.

    **Example**

    ```hot
    ::cloudflare::r2/create-bucket("exports", {location_hint: "enam"})
    ```
    """
}
fn
(name: Str): Map {
  create-bucket(name, {})
},
(name: Str, opts: Map): Map {
  envelope send-json("POST", "/r2/buckets", create-bucket-body(name, opts), get(opts, "jurisdiction"))
  cond {
    is-err(envelope) => { envelope }
    => { get(envelope, "result") }
  }
}

get-bucket
meta {
    doc: """GET /accounts/{account_id}/r2/buckets/{name} - One bucket: `{name, creation_date, location, storage_class, jurisdiction}`."""
}
fn
(name: Str): Map {
  get-bucket(name, null)
},
(name: Str, jurisdiction: Str?): Map {
  envelope send-json("GET", bucket-suffix(name), "", jurisdiction)
  cond {
    is-err(envelope) => { envelope }
    => { get(envelope, "result") }
  }
}

delete-bucket
meta {
    doc: """DELETE /accounts/{account_id}/r2/buckets/{name} - Delete an empty bucket (R2 refuses a bucket that still holds objects)."""
}
fn
(name: Str): Any {
  delete-bucket(name, null)
},
(name: Str, jurisdiction: Str?): Any {
  envelope send-json("DELETE", bucket-suffix(name), "", jurisdiction)
  cond {
    is-err(envelope) => { envelope }
    => { get(envelope, "result") }
  }
}

s3-endpoint
meta {
    doc: """The S3-compatible endpoint for object I/O with `aws-s3`: `https://{account_id}.r2.cloudflarestorage.com` (`.eu.` / `.fedramp.` inserted for those jurisdictions)."""
}
fn
(account-id: Str): Str {
  s3-endpoint(account-id, null)
},
(account-id: Str, jurisdiction: Str?): Str {
  cond {
    is-null(jurisdiction) => { `https://${account-id}.r2.cloudflarestorage.com` }
    eq(jurisdiction, "default") => { `https://${account-id}.r2.cloudflarestorage.com` }
    => { `https://${account-id}.${jurisdiction}.r2.cloudflarestorage.com` }
  }
}
