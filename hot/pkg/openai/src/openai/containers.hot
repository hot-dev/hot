create-container
meta {
    doc: """
    POST /containers - Create a new container for storing files.

    **Example**

    ```hot
    container ::openai::containers/create-container(::openai::containers/CreateContainerRequest({
      name: "analysis",
      file_ids: ["file-abc123"]
    }))
    container.id
    ```
    """
}
fn
(request: CreateContainerRequest): CreateContainerResponse {
  create-container(request, {})
},
(request: CreateContainerRequest, opts: Map): CreateContainerResponse {
  response api-request("POST", "/containers", {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { CreateContainerResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

