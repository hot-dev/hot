::hot::pkg ns

hot.pkg.microsoft-excel {
  name: "hot.dev/microsoft-excel",
  version: "0.1.0",
  hot-min-version: "3.0.2",
  description: "Excel workbook bindings for Hot over Microsoft Graph: worksheets, cell ranges (values, formulas, used range, clear), tables and rows, rows as records, workbook sessions and recalculation, for workbooks in OneDrive and SharePoint.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["documents"],
  deps: {
    "hot.dev/microsoft-graph": "0.1.1",
    "hot.dev/microsoft-onedrive": "0.1.1"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
