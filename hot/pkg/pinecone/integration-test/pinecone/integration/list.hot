::pinecone::integration ns
meta ["test"]

// Requires PINECONE_API_KEY; skips without it. Read-only: lists the
// project's indexes.
// Run with: hot test --project pkg-integration-pinecone

::ctx ::pinecone::integration::ctx

test-list-indexes
meta ["test"] fn () {
    cond {
        not(::ctx/configured()) => { ::ctx/skip(::ctx/UNCONFIGURED) }
        => {
            out ::pinecone::indexes/list-indexes()
            assert(is-vec(out.indexes), "should return an indexes array")
        }
    }
}
