::slack::test::opts ns
meta ["test"]

// Hermetic. These tests never send an HTTP request: a credential with a
// newline is not a legal header value, so the HTTP client refuses to build
// the request. An error from ::hot::http/request therefore proves that the
// credential got through the function to the client, and the "not set" error
// proves the function went through the resolver. A host-name lookup can still
// happen first; when it fails, the error comes from the same place.

::api ::slack::api
::apps ::slack::apps
::calls ::slack::calls
::channels ::slack::channels
::files ::slack::files
::messaging ::slack::messaging
::misc ::slack::misc
::users ::slack::users

CTX_KEY "slack.api.key"
UNSENDABLE "opts\ncredential"

// One valid call to every function that calls the API, without its opts.
every-call fn (): Vec {
  [
    {f: ::apps/apps-permissions-info, args: []},
    {f: ::apps/apps-permissions-request, args: [::apps/AppsPermissionsRequestRequest({scopes: "x", trigger_id: "x"})]},
