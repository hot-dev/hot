list-media
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """GET /Accounts/{AccountSid}/Messages/{MessageSid}/Media.json - List media resources attached to a message (e.g. inbound MMS images). Each entry's `sid` and `content_type` feed `get-media-content`."""
}
fn
(request: ListMediaRequest): ListMediaResponse {
  list-media(request, {})
},
(request: ListMediaRequest, opts: Map): ListMediaResponse {
  resolve(opts) |> if-ok((client) { list-media(client, request) })
},
(client: Client, request: ListMediaRequest): ListMediaResponse {
  query ::twilio::api/query-string({
    PageSize: request.PageSize,
    Page: request.Page,
    PageToken: request.PageToken
  })
  response api-request(client, "GET", `${account-url(client)}/Messages/${::uri/encode(request.message_sid)}/Media.json${query}`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ListMediaResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

GetMediaContentRequest type {
  message_sid: Str,
  sid: Str
}

get-media-content
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
GET /Accounts/{AccountSid}/Messages/{MessageSid}/Media/{Sid} - Download a media file (the URI without `.json`). Returns the raw `Bytes`; the type is the media entry's `content_type`.

**Example**

```hot
::messages ::twilio::messages

media ::messages/list-media(::messages/ListMediaRequest({message_sid: "MM123"}))
image ::messages/get-media-content(::messages/GetMediaContentRequest({
  message_sid: "MM123",
  sid: first(media.media_list).sid
}))
```
"""
}
fn
(request: GetMediaContentRequest): Bytes {
  get-media-content(request, {})
},
(request: GetMediaContentRequest, opts: Map): Bytes {
  resolve(opts) |> if-ok((client) { get-media-content(client, request) })
},
(client: Client, request: GetMediaContentRequest): Bytes {
  response api-request(client, "GET", `${account-url(client)}/Messages/${::uri/encode(request.message_sid)}/Media/${::uri/encode(request.sid)}`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body-bytes }
    => { err(HttpError(response)) }
  }
}
