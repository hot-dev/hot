::discord::guilds ns
meta {
    doc: """
    Guilds: settings, members (list, search, modify, timeout, kick),
    roles, bans (single and bulk), custom emoji, prune, the audit log, and
    invites.

    Moderation and modify calls accept `reason`, recorded in the guild
    audit log (sent as the URL-encoded `X-Audit-Log-Reason` header).
    """
}

::api ::discord::api

seg ::discord::api/seg

// ============================================================================
// Guild
// ============================================================================

GetGuildRequest type {
  guild_id: Str,
  with_counts: Bool?
}

get-guild
meta {
    doc: """
    GET /guilds/{guild_id} - A guild. `with_counts: true` adds
    `approximate_member_count` and `approximate_presence_count`.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    guild ::guilds/get-guild(::guilds/GetGuildRequest({guild_id: "1000000000000000000", with_counts: true}))
    guild.approximate_member_count
    ```
    """
}
fn (request: GetGuildRequest): Map {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}`, {query: {with_counts: request.with_counts}})
}

GetGuildPreviewRequest type {
  guild_id: Str
}

get-guild-preview
meta {
    doc: """GET /guilds/{guild_id}/preview - Public preview of a guild the bot is in or a discoverable guild: name, icon, emojis, features and counts."""
}
fn (request: GetGuildPreviewRequest): Map {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/preview`)
}

ModifyGuildRequest type {
  guild_id: Str,
  name: Str?,
  verification_level: Int?,
  default_message_notifications: Int?,
  explicit_content_filter: Int?,
  afk_channel_id: Str?,
  afk_timeout: Int?,
  icon: Str?,
  splash: Str?,
  discovery_splash: Str?,
  banner: Str?,
  system_channel_id: Str?,
  system_channel_flags: Int?,
  rules_channel_id: Str?,
  public_updates_channel_id: Str?,
  safety_alerts_channel_id: Str?,
  preferred_locale: Str?,
  features: Vec<Str>?,
  description: Str?,
  premium_progress_bar_enabled: Bool?,
  reason: Str?,
  clear: Vec<Str>?
}

modify-guild
meta {
    doc: """
    PATCH /guilds/{guild_id} - Change guild settings. Only fields you set
    are sent, so the icon, splash, banner and channel ids stay as they are
    unless you name them. To remove one, list it in `clear`, e.g.
    `clear: ["icon", "afk_channel_id"]`. Needs MANAGE_GUILD.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    ::guilds/modify-guild(::guilds/ModifyGuildRequest({
      guild_id: "1000000000000000000",
      description: "Home of the Hot community",
      reason: "Refresh description"
    }))
    ```
    """
}
fn (request: ModifyGuildRequest): Map {
  ::api/call("PATCH", `/guilds/${seg(request.guild_id)}`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  })
}

// ============================================================================
// Members
// ============================================================================

GetGuildMemberRequest type {
  guild_id: Str,
  user_id: Str
}

get-guild-member
meta {
    doc: """
    GET /guilds/{guild_id}/members/{user_id} - A guild member (user, nick, roles, joined_at, timeout).

    **Example**

    ```hot
    ::guilds ::discord::guilds

    member ::guilds/get-guild-member(::guilds/GetGuildMemberRequest({
      guild_id: "1000000000000000000",
      user_id: "1300000000000000000"
    }))
    member.roles
    ```
    """
}
fn (request: GetGuildMemberRequest): Map {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/members/${seg(request.user_id)}`)
}

ListGuildMembersRequest type {
  guild_id: Str,
  limit: Int?,
  after: Str?
}

list-guild-members
meta {
    doc: """GET /guilds/{guild_id}/members - Up to `limit` (1-1000, default 1) members ordered by user id; page with `after`, or use `list-all-guild-members`. Needs the privileged GUILD_MEMBERS intent."""
}
fn (request: ListGuildMembersRequest): Vec<Map> {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/members`, {query: {limit: request.limit, after: request.after}})
}

list-all-guild-members
meta {
    doc: """
    Every member of a guild (up to `max-items`, default 10000), paging
    1000 at a time with `after`. Needs the GUILD_MEMBERS intent.

    **Example**

    ```hot
    members ::discord::guilds/list-all-guild-members("1000000000000000000", 5000)
    bots filter(members, (m) { m.user.bot })
    ```
    """
}
fn
(guild-id: Str): Vec<Map> {
  list-all-guild-members(guild-id, 10000)
},
(guild-id: Str, max-items: Int): Vec<Map> {
  ::api/paginate(
    (after) { list-guild-members(ListGuildMembersRequest({guild_id: guild-id, limit: 1000, after: after})) },
    (page) { last(page).user.id },
    1000,
    max-items
  )
}

SearchGuildMembersRequest type {
  guild_id: Str,
  query: Str,
  limit: Int?
}

search-guild-members
meta {
    doc: """
    GET /guilds/{guild_id}/members/search - Members whose username or
    nickname starts with `query` (up to `limit`, 1-1000, default 1).

    **Example**

    ```hot
    ::guilds ::discord::guilds

    hits ::guilds/search-guild-members(::guilds/SearchGuildMembersRequest({
      guild_id: "1000000000000000000",
      query: "ada",
      limit: 10
    }))
    ```
    """
}
fn (request: SearchGuildMembersRequest): Vec<Map> {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/members/search`, {query: {query: request.query, limit: request.limit}})
}

ModifyGuildMemberRequest type {
  guild_id: Str,
  user_id: Str,
  nick: Str?,
  roles: Vec<Str>?,
  mute: Bool?,
  deaf: Bool?,
  channel_id: Str?,
  communication_disabled_until: Str?,
  flags: Int?,
  reason: Str?,
  clear: Vec<Str>?
}

modify-guild-member
meta {
    doc: """
    PATCH /guilds/{guild_id}/members/{user_id} - Change a member. Only the
    fields you set are sent, so setting `nick` leaves roles, voice state
    and timeouts alone.

    - `roles` replaces the member's whole role list (use
      `add-guild-member-role` to add one).
    - `communication_disabled_until` (ISO8601, up to 28 days ahead) times
      a member out; `clear: ["communication_disabled_until"]` lifts it.
    - `channel_id` moves the member between voice channels;
      `clear: ["channel_id"]` disconnects them from voice.
    - `clear: ["nick"]` resets the nickname.

    Needs MANAGE_NICKNAMES, MANAGE_ROLES, MUTE_MEMBERS, DEAFEN_MEMBERS,
    MOVE_MEMBERS or MODERATE_MEMBERS depending on the field.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    // Time out for an hour, with an audit-log reason
    ::guilds/modify-guild-member(::guilds/ModifyGuildMemberRequest({
      guild_id: "1000000000000000000",
      user_id: "1300000000000000000",
      communication_disabled_until: "2026-11-01T18:00:00Z",
      reason: "Spam in #general"
    }))

    // Lift the timeout
    ::guilds/modify-guild-member(::guilds/ModifyGuildMemberRequest({
      guild_id: "1000000000000000000",
      user_id: "1300000000000000000",
      clear: ["communication_disabled_until"]
    }))
    ```
    """
}
fn (request: ModifyGuildMemberRequest): Map {
  ::api/call("PATCH", `/guilds/${seg(request.guild_id)}/members/${seg(request.user_id)}`, {
    body: ::api/body(request, ["guild_id", "user_id"]),
    reason: request.reason
  })
}

ModifyCurrentMemberRequest type {
  guild_id: Str,
  nick: Str?,
  avatar: Str?,
  banner: Str?,
  bio: Str?,
  reason: Str?,
  clear: Vec<Str>?
}

modify-current-member
meta {
    doc: """PATCH /guilds/{guild_id}/members/@me - Change the bot's own per-guild `nick`, `avatar`, `banner` (data URIs) or `bio`. Only fields you set are sent; list fields in `clear` to reset them."""
}
fn (request: ModifyCurrentMemberRequest): Map {
  ::api/call("PATCH", `/guilds/${seg(request.guild_id)}/members/@me`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  })
}

AddGuildMemberRoleRequest type {
  guild_id: Str,
  user_id: Str,
  role_id: Str,
  reason: Str?
}

RemoveGuildMemberRoleRequest type {
  guild_id: Str,
  user_id: Str,
  role_id: Str,
  reason: Str?
}

add-guild-member-role
meta {
    doc: """PUT /guilds/{guild_id}/members/{user_id}/roles/{role_id} - Give a member a role. Needs MANAGE_ROLES."""
}
fn (request: AddGuildMemberRoleRequest): Bool {
  ::api/call-ok("PUT", `/guilds/${seg(request.guild_id)}/members/${seg(request.user_id)}/roles/${seg(request.role_id)}`, {reason: request.reason})
}

remove-guild-member-role
meta {
    doc: """DELETE /guilds/{guild_id}/members/{user_id}/roles/{role_id} - Take a role from a member. Needs MANAGE_ROLES."""
}
fn (request: RemoveGuildMemberRoleRequest): Bool {
  ::api/call-ok("DELETE", `/guilds/${seg(request.guild_id)}/members/${seg(request.user_id)}/roles/${seg(request.role_id)}`, {reason: request.reason})
}

RemoveGuildMemberRequest type {
  guild_id: Str,
  user_id: Str,
  reason: Str?
}

remove-guild-member
meta {
    doc: """DELETE /guilds/{guild_id}/members/{user_id} - Kick a member. Needs KICK_MEMBERS."""
}
fn (request: RemoveGuildMemberRequest): Bool {
  ::api/call-ok("DELETE", `/guilds/${seg(request.guild_id)}/members/${seg(request.user_id)}`, {reason: request.reason})
