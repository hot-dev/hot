::openai::validate ns

api-request ::openai::api/request
HttpError ::openai::api/HttpError
is-ok-response ::hot::http/is-ok-response

ValidateGraderResponse type {
    grader: Map?
}

ValidateGraderRequest type {
    grader: Map
}

ValidateGraderRequest type {
    grader: Map
}

ValidateGraderResponse type {
    grader: Map?
}


validate-grader
meta {
    doc: """
    POST /fine_tuning/alpha/graders/validate - Validate a grader
    configuration before using it in fine-tuning.

    **Example**

    ```hot
    result ::openai::validate/validate-grader(::openai::validate/ValidateGraderRequest({
      grader: {type: "string_check", name: "Exact", input: "{{sample.output_text}}", operation: "eq", reference: "yes"}
    }))
    result.grader
    ```
    """
}
fn
(request: ValidateGraderRequest): ValidateGraderResponse {
  validate-grader(request, {})
},
(request: ValidateGraderRequest, opts: Map): ValidateGraderResponse {
  response api-request("POST", "/fine_tuning/alpha/graders/validate", {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ValidateGraderResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
