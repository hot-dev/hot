groq
meta {
    doc: """
    Groq with the `groq.api.key` ctx key.

    **Example**

    ```hot
    ::oc ::openai-compatible

    ::openai-compatible::chat/chat(::oc/groq(), "llama-3.3-70b-versatile", "Say hi")

    // Another tenant's key, for one call
    ::oc/groq({api-key: ::hot::ctx/get("tenant.groq.key")})
    ```
    """,
    ctx: {"groq.api.key": {required: false}}
}
fn
(): CompatibleProvider {
