  list-thread-members(request, {})
},
(request: ListThreadMembersRequest, opts: Map): Vec<Map> {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/thread-members`, {
    query: {with_member: request.with_member, after: request.after, limit: request.limit}
  }, opts)
