::benchmarks ns
meta {doc: "Hot language benchmarks"}

// Aliases for convenience
now ::hot::time/now
epoch-nanos ::hot::time/epoch-nanos

::records ::benchmarks::records
::apijson ::benchmarks::apijson
::money ::benchmarks::money
::words ::benchmarks::words
::lambdas ::benchmarks::lambdas


// ============================================================================
// BENCHMARK 1: Fibonacci
// ============================================================================

// Recursive fibonacci (naive)
fib-recursive fn (n: Int): Int {
    if(lte(n, 1), n, add(fib-recursive(sub(n, 1)), fib-recursive(sub(n, 2))))
}

// Iterative fibonacci using reduce
fib-iterative fn (n: Int): Int {
    if(lte(n, 1), n, {
        result reduce(range(2, add(n, 1)), (acc, _i) {
            [acc[1], add(acc[0], acc[1])]
        }, [0, 1])
        result[1]
    })
}

// ============================================================================
// BENCHMARK 2: Collection Operations
// ============================================================================

// Sum of squares of even numbers in a range
sum-even-squares fn (n: Int): Int {
    range(1, add(n, 1))
    |> filter((x) { is-zero(mod(x, 2)) })
    |> map((x) { mul(x, x) })
    |> reduce((acc, x) { add(acc, x) }, 0)
}

// Map-filter-reduce chain
collection-benchmark fn (n: Int): Int {
    range(1, add(n, 1))
    |> map((x) { mul(x, 3) })
    |> filter((x) { gt(x, 100) })
    |> map((x) { add(x, 1) })
    |> reduce((acc, x) { add(acc, x) }, 0)
}

// ============================================================================
// BENCHMARK 3: String Operations
// ============================================================================

// Build a string through concatenation
string-concat-benchmark fn (n: Int): Str {
    reduce(range(n), (acc, i) {
        concat(acc, `item-${i}-`)
    }, "")
}

// ============================================================================
// BENCHMARK 4: JSON Processing
// ============================================================================

// Create, serialize, and parse JSON objects
json-benchmark fn (n: Int): Int {
    // Create an array of objects
    data map(range(n), (i) {
        {
            id: i,
            name: `User ${i}`,
            active: is-zero(mod(i, 2)),
            scores: [mul(i, 10), mul(i, 20), mul(i, 30)]
        }
    })
    // Serialize to JSON
    json-str to-json(data)
    // Parse back
    parsed from-json(json-str)
    // Return length to verify
    length(parsed)
}

// ============================================================================
// BENCHMARK 5: Prime Numbers (Sieve of Eratosthenes)
// ============================================================================

// Simple trial division for finding primes
is-prime fn (n: Int): Bool {
    cond {
        lte(n, 1) => false
        lte(n, 3) => true
        is-zero(mod(n, 2)) => false
        => {
            // Check odd divisors up to sqrt(n)
            limit add(Int(pow(Dec(n), 0.5)), 1)
            divisors range(3, limit, 2)
            not(some(divisors, (d) { is-zero(mod(n, d)) }))
        }
    }
}

// Count primes up to n
count-primes fn (n: Int): Int {
    range(2, add(n, 1))
    |> filter(is-prime)
    |> length()
}

// ============================================================================
// BENCHMARK 6: JIT Lazy/Flow Safety Shapes
// ============================================================================

ignore-lazy fn (pred: Bool, lazy value: Int): Int {
    if(pred, 1, 2)
}

lazy-if-branch fn (n: Int): Int {
    reduce(range(n), (acc, i) {
        add(acc, if(is-zero(mod(i, 2)), 1, 2))
    }, 0)
}

lazy-generic-ignore fn (n: Int): Int {
    reduce(range(n), (acc, i) {
        add(acc, ignore-lazy(is-zero(mod(i, 2)), fib-recursive(20)))
    }, 0)
}

cond-skip-expensive fn (n: Int): Int {
    reduce(range(n), (acc, i) {
        selected cond {
            lt(i, 0) => { fib-recursive(20) }
            => { 1 }
        }

        add(acc, selected)
    }, 0)
}

owned-lazy-branch fn (n: Int): Int {
    reduce(range(n), (acc, i) {
        picked if(is-zero(mod(i, 2)), {
            id: i,
            name: `item-${i}`,
            tags: ["even", "jit"],
        }, {
            id: i,
            name: `item-${i}`,
            tags: ["odd", "jit"],
        })
        add(acc, length(picked.tags))
    }, 0)
}

hotlib-json-roundtrip fn (n: Int): Int {
    data map(range(n), (i) {
        {
            id: i,
            name: `Item ${i}`,
            active: is-zero(mod(i, 2)),
        }
    })
    parsed from-json(to-json(data))
    length(parsed)
}

// ============================================================================
// BENCHMARK 7: Deep Recursion
// ============================================================================

// Tail recursion through if(): exercises TCO in the interpreter and the
// JIT's mid-loop compilation of hot tail loops into native loops.
// Regression guard: before the vm-jit-perf work this crashed the process
// with a native stack overflow (JIT off) or ran for minutes (JIT on).
sum-to-tail fn (i: Int, acc: Int): Int {
    if(lte(i, 0), acc, sum-to-tail(sub(i, 1), add(acc, i)))
}

// Non-tail self-recursion through cond: exercises the re-entrant register
// save/restore. Regression guard: before the vm-jit-perf work this returned
// a wrong result (register clobbering), so the printed result matters as
// much as the timing. fib-cond(20) = 6765.
fib-cond fn (n: Int): Int {
    cond {
        lte(n, 1) => n
        => add(fib-cond(sub(n, 1)), fib-cond(sub(n, 2)))
    }
}

// ============================================================================
// BENCHMARK 8: Pipelines After JIT Tier-Up
// ============================================================================

// The shape of sum-even-squares, in a function of its own so its calls are
// counted from zero: `compile-sum-even-squares` compiles it, and its timed
// calls only ever run compiled code.
compiled-sum-even-squares fn (n: Int): Int {
    range(1, add(n, 1))
    |> filter((x) { is-zero(mod(x, 2)) })
    |> map((x) { mul(x, x) })
    |> reduce((acc, x) { add(acc, x) }, 0)
}

// Compile it, then time it. A pipeline that stops being fused once its function
// is compiled shows up here about 10x slower than sum-even-squares above.
compile-sum-even-squares fn (): Int {
    reduce(range(150), (_acc, _i) { compiled-sum-even-squares(10) }, 0)
}

// ============================================================================
// HARNESS
// ============================================================================

// Every runner (bench.hot, bench.py, bench.js, bench.ts) times a benchmark the
// same way, with the same counts:
//   cold: the first call, alone.
//   warm: after `warmup` calls in all, the median of 5 samples, where a sample
//         is the mean time of `iterations` calls.
// Times are whole nanoseconds. run-all.py reads these lines.
sample-count 5

elapsed-since fn (start: Int): Int {
    sub(epoch-nanos(now()), start)
}

measure fn (name: Str, warmup: Int, iterations: Int, f: Fn): Map {
    start epoch-nanos(now())
    result f()
    cold elapsed-since(start)
    reduce(range(max(sub(warmup, 1), 0)), (_acc, _i) { f() }, null)
    samples map(range(sample-count), (_s) {
        sample-start epoch-nanos(now())
        reduce(range(iterations), (_acc, _i) { f() }, null)
        floor(div(elapsed-since(sample-start), iterations))
    })
    sorted sort(samples)
    warm get(sorted, floor(div(sample-count, 2)))
    println(`${name}: cold=${cold}ns warm=${warm}ns (result: ${result})`)
    {name: name, cold: cold, warm: warm, result: result}
}

// ============================================================================
// BENCHMARK RUNNER
// ============================================================================

run-benchmarks fn (): Null {
    // Inputs built once, outside the timings.
    api-payload ::apijson/make-payload(1500)
    text ::words/make-text(50000)

    println("=== Hot Language Benchmarks ===")
    println("")

    results [
        // Fibonacci
        measure("fib-recursive(25)", 2, 3, () { fib-recursive(25) }),
        measure("fib-iterative(70)", 100, 200, () { fib-iterative(70) }),

        // Collection operations
        measure("sum-even-squares(10000)", 20, 50, () { sum-even-squares(10000) }),
        measure("collection-benchmark(10000)", 20, 50, () { collection-benchmark(10000) }),

        // String operations
        measure("string-concat(1000)", 20, 50, () { length(string-concat-benchmark(1000)) }),

        // JSON processing
        measure("json-benchmark(1000)", 5, 10, () { json-benchmark(1000) }),

        // Prime numbers
        measure("count-primes(1000)", 1, 2, () { count-primes(1000) }),

        // Records, realistic JSON, decimal money, Map counting, lambdas
        measure("records-reshape(2000)", 5, 10, () { ::records/records-reshape(2000) }),
        measure("json-api-roundtrip(1500)", 3, 5, () { ::apijson/json-api-roundtrip(api-payload) }),
        measure("money-dec(10000)", 3, 5, () { ::money/money-dec(10000) }),
        measure("word-count(50000)", 3, 5, () { ::words/word-count(text) }),
        measure("closure-capture(10000)", 10, 20, () { ::lambdas/closure-capture(10000) }),
        measure("fn-as-value(10000)", 10, 20, () { ::lambdas/fn-as-value(10000) }),
        measure("nested-hof(100)", 10, 20, () { ::lambdas/nested-hof(100) }),

        // Hot-only: typed records (see bench-records.hot)
        measure("records-typed(2000)", 5, 10, () { ::records/records-typed(2000) }),

        // Hot-only: JIT lazy/flow safety shapes
        measure("lazy-if-branch(5000)", 5, 10, () { lazy-if-branch(5000) }),
        measure("lazy-generic-ignore(1000)", 3, 5, () { lazy-generic-ignore(1000) }),
        measure("cond-skip-expensive(1000)", 10, 20, () { cond-skip-expensive(1000) }),
        measure("owned-lazy-branch(1000)", 5, 10, () { owned-lazy-branch(1000) }),
        measure("hotlib-json-roundtrip(200)", 10, 20, () { hotlib-json-roundtrip(200) }),

        // Hot-only: past the JIT threshold (see section 8). Its cold time
        // includes the compile.
        measure("compile-sum-even-squares", 1, 1, () { compile-sum-even-squares() }),
        measure("compiled-sum-even-squares(10000)", 20, 50, () { compiled-sum-even-squares(10000) }),

        // Hot-only: deep recursion (see section 7)
        measure("sum-to-tail(1000000)", 2, 3, () { sum-to-tail(1000000, 0) }),
        measure("fib-cond(20)", 5, 10, () { fib-cond(20) })
    ]

    println("")
    println("=== Benchmarks Complete ===")
    null
}

// Main entry point - execute when file is loaded
run-benchmarks()
