CreateGuildRoleRequest type {
  guild_id: Str,
  name: Str?,
  permissions: Str?,
  color: Int?,
  colors: Map?,
  hoist: Bool?,
  icon: Str?,
  unicode_emoji: Str?,
  mentionable: Bool?,
  reason: Str?
}

create-guild-role
meta {
    doc: """
    POST /guilds/{guild_id}/roles - Create a role. `permissions` is a bit
    set as a string; `colors: {primary_color, secondary_color?, tertiary_color?}`
    supersedes the older `color`. Needs MANAGE_ROLES.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    role ::guilds/create-guild-role(::guilds/CreateGuildRoleRequest({
      guild_id: "1000000000000000000",
      name: "On call",
      colors: {primary_color: 15105570},
      mentionable: true
    }))
    ```
    """
}
fn (request: CreateGuildRoleRequest): Map {
  ::api/call("POST", `/guilds/${seg(request.guild_id)}/roles`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  })
}

ModifyGuildRoleRequest type {
  guild_id: Str,
  role_id: Str,
  name: Str?,
  permissions: Str?,
  color: Int?,
  colors: Map?,
  hoist: Bool?,
  icon: Str?,
  unicode_emoji: Str?,
  mentionable: Bool?,
  reason: Str?,
  clear: Vec<Str>?
}

modify-guild-role
meta {
    doc: """PATCH /guilds/{guild_id}/roles/{role_id} - Change a role. Only fields you set are sent; `clear: ["icon"]` removes the role icon. Needs MANAGE_ROLES."""
}
fn (request: ModifyGuildRoleRequest): Map {
  ::api/call("PATCH", `/guilds/${seg(request.guild_id)}/roles/${seg(request.role_id)}`, {
    body: ::api/body(request, ["guild_id", "role_id"]),
    reason: request.reason
  })
}

ModifyGuildRolePositionsRequest type {
  guild_id: Str,
  positions: Vec<Map>,
  reason: Str?
}

modify-guild-role-positions
meta {
    doc: """PATCH /guilds/{guild_id}/roles - Reorder roles. `positions` is `[{id, position}]`. Returns every role. Needs MANAGE_ROLES."""
}
fn (request: ModifyGuildRolePositionsRequest): Vec<Map> {
  ::api/call("PATCH", `/guilds/${seg(request.guild_id)}/roles`, {
    body: map(request.positions, (p) { ::api/body(p, []) }),
    reason: request.reason
  })
}

