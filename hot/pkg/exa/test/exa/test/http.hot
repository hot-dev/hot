::exa::test::http ns
meta ["test"]

::http ::exa::http

test-error-messages
meta ["test"] fn () {
    assert-eq("Exa API error 400: Invalid request", ::http/error-message(400, {requestId: "r1", error: "Invalid request"}))
    assert-eq("Exa API error 500: Server error", ::http/error-message(500, {message: "Server error"}))
    assert-eq("Exa API error 503", ::http/error-message(503, null))
}

test-http-error-from-response
meta ["test"] fn () {
    e ::http/http-error(::hot::http/HttpResponse({status: 429, body: {error: "Rate limit exceeded"}}))
    assert-eq(429, e.status)
    assert-eq("Exa API error 429: Rate limit exceeded", e.message)
}
