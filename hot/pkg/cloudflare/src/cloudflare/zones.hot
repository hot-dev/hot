::cloudflare::zones ns
meta {
    doc: """Cloudflare zones: list (paged or all), look up by name, get by id.""",
    ctx: {"cloudflare.token": {required: false}}
}

::api ::cloudflare::api

ListPage ::cloudflare::api/ListPage

list-zones
meta {
    doc: """
    GET /zones - One page of zones. `params` are the API's query
    parameters: `name`, `status` (`active`, `pending`, …), `account.id`
    (as `{account: {id: "..."}}` or `"account.id"`), `page`, `per_page`
    (5–50, default 20), `order`, `direction`, `match`. Returns a
    `ListPage` (`.result`, `.result_info`).

    **Example**

    ```hot
    page ::cloudflare::zones/list-zones({status: "active", per_page: 50})
    map(page.result, %.name)
    ```
    """
}
fn
(): ListPage {
  list-zones({})
},
(params: Map): ListPage {
  list-zones(params, {})
},
(params: Map, opts: Map): ListPage {
  ::api/json-page(`/zones${::api/query(params)}`, "", opts)
}

list-all-zones
meta {
    doc: """
    Every zone matching `params`, following pages (50 per request) up to
    `max` items (default 10000).

    **Example**

    ```hot
    map(::cloudflare::zones/list-all-zones({status: "active"}, 500), %.name)
    ```
    """
}
fn
(): Vec {
  list-all-zones({})
},
(params: Map): Vec {
  list-all-zones(params, ::api/DEFAULT_MAX_ITEMS)
},
(params: Map, max: Int): Vec {
  list-all-zones(params, max, {})
},
(params: Map, opts: Map): Vec {
  list-all-zones(params, ::api/DEFAULT_MAX_ITEMS, opts)
},
(params: Map, max: Int, opts: Map): Vec {
  ::api/collect-pages((p) { list-zones(p, opts) }, {per_page: 50, ...params}, max)
}

find-zone
meta {
    doc: """
    The zone whose name is exactly `name` (e.g. `"example.com"`), or null
    when the token can't see one.

    **Example**

    ```hot
    zone ::cloudflare::zones/find-zone("example.com")
    if(is-some(zone), zone.id, "not found")
    ```
    """
}
fn
(name: Str): Map? {
  find-zone(name, {})
},
(name: Str, opts: Map): Map? {
  page list-zones({name: name}, opts)
  cond {
    is-err(page) => { page }
    is-empty(page.result) => { null }
    => { first(page.result) }
  }
}

get-zone
meta {
    doc: """
    GET /zones/{zone_id} - One zone: name, status, name servers, plan.

    **Example**

    ```hot
    zone ::cloudflare::zones/get-zone("023e105f4ecef8ad9ca31a8372d0c353")
    zone.name_servers
    ```
    """
}
fn
(zone-id: Str): Map {
  get-zone(zone-id, {})
},
(zone-id: Str, opts: Map): Map {
  ::api/json("GET", `/zones/${::api/seg(zone-id)}`, "", opts)
}
