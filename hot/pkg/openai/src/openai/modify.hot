modify-certificate
meta {
    doc: """
    POST /organization/certificates/{certificate_id} - Update the name of a
    certificate.

    **Example**

    ```hot
    cert ::openai::modify/modify-certificate("cert_abc123", ::openai::modify/ModifyCertificateRequest({
      name: "Production cert"
    }))
    cert.name
    ```
    """
}
