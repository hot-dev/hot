::discord::stickers ns
meta {
    doc: """Stickers: read standard and guild stickers, and create, modify or delete guild stickers."""
}

::api ::discord::api

seg ::discord::api/seg

GetStickerRequest type {
  sticker_id: Str
}

get-sticker
meta {
    doc: """
    GET /stickers/{sticker_id} - Any sticker by id.

    **Example**

    ```hot
    ::stickers ::discord::stickers

    sticker ::stickers/get-sticker(::stickers/GetStickerRequest({sticker_id: "2200000000000000000"}))
    sticker.name
    ```
    """
}
fn
(request: GetStickerRequest): Map {
  get-sticker(request, {})
},
(request: GetStickerRequest, opts: Map): Map {
  ::api/call("GET", `/stickers/${seg(request.sticker_id)}`, {}, opts)
}

list-sticker-packs
meta {
    doc: """
    GET /sticker-packs - Discord's standard sticker packs. Returns
    `{sticker_packs}`.

    **Example**

    ```hot
    packs ::discord::stickers/list-sticker-packs()
    map(packs.sticker_packs, %.name)
    ```
    """
}
fn
(): Map {
  list-sticker-packs({})
},
(opts: Map): Map {
  ::api/call("GET", "/sticker-packs", {}, opts)
}

ListGuildStickersRequest type {
  guild_id: Str
}

list-guild-stickers
meta {
    doc: """
    GET /guilds/{guild_id}/stickers - The guild's custom stickers.

    **Example**

    ```hot
    ::stickers ::discord::stickers

    stickers ::stickers/list-guild-stickers(::stickers/ListGuildStickersRequest({guild_id: "1000000000000000000"}), {token: ::hot::ctx/get("tenant-b.discord.bot.token")})
    map(stickers, %.name)
    ```
    """
}
fn
(request: ListGuildStickersRequest): Vec<Map> {
  list-guild-stickers(request, {})
},
(request: ListGuildStickersRequest, opts: Map): Vec<Map> {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/stickers`, {}, opts)
}

GetGuildStickerRequest type {
  guild_id: Str,
  sticker_id: Str
}

get-guild-sticker
meta {
    doc: """
    GET /guilds/{guild_id}/stickers/{sticker_id} - One guild sticker.

    **Example**

    ```hot
    ::stickers ::discord::stickers

    sticker ::stickers/get-guild-sticker(::stickers/GetGuildStickerRequest({
      guild_id: "1000000000000000000",
      sticker_id: "2200000000000000000"
    }))
    sticker.tags
    ```
    """
}
fn
(request: GetGuildStickerRequest): Map {
  get-guild-sticker(request, {})
},
(request: GetGuildStickerRequest, opts: Map): Map {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/stickers/${seg(request.sticker_id)}`, {}, opts)
}

CreateGuildStickerRequest type {
  guild_id: Str,
  name: Str,
  tags: Str,
  file: ::discord::api/FileUpload,
  description: Str?,
  reason: Str?
}

create-guild-sticker
meta {
    doc: """
    POST /guilds/{guild_id}/stickers - Upload a sticker (PNG, APNG, GIF or
    Lottie JSON, max 512 KiB) as multipart/form-data. `name` 2-30
    characters, `tags` an autocomplete word (a Unicode emoji name).
    Needs CREATE_GUILD_EXPRESSIONS.

    **Example**

    ```hot
    ::stickers ::discord::stickers

    ::stickers/create-guild-sticker(::stickers/CreateGuildStickerRequest({
      guild_id: "1000000000000000000",
      name: "shipit",
      tags: "rocket",
      file: {filename: "shipit.png", content: ::hot::file/read-file-bytes("shipit.png")}
    }))
    ```
    """
}
fn
(request: CreateGuildStickerRequest): Map {
  create-guild-sticker(request, {})
},
(request: CreateGuildStickerRequest, opts: Map): Map {
  ::api/call("POST", `/guilds/${seg(request.guild_id)}/stickers`, {
    form: {
      fields: {name: request.name, description: or(request.description, ""), tags: request.tags},
      file_field: "file",
      file: untype(request.file)
    },
    reason: request.reason
  }, opts)
}

ModifyGuildStickerRequest type {
  guild_id: Str,
  sticker_id: Str,
  name: Str?,
  description: Str?,
  tags: Str?,
  reason: Str?,
  clear: Vec<Str>?
}

modify-guild-sticker
meta {
    doc: """
    PATCH /guilds/{guild_id}/stickers/{sticker_id} - Change a sticker's
    name, description or tags. Only fields you set are sent. Needs
    MANAGE_GUILD_EXPRESSIONS.

    **Example**

    ```hot
    ::stickers ::discord::stickers

    ::stickers/modify-guild-sticker(::stickers/ModifyGuildStickerRequest({
      guild_id: "1000000000000000000",
      sticker_id: "2200000000000000000",
      name: "ship_it",
      tags: "rocket"
    }))
    ```
    """
}
fn
(request: ModifyGuildStickerRequest): Map {
  modify-guild-sticker(request, {})
},
(request: ModifyGuildStickerRequest, opts: Map): Map {
  ::api/call("PATCH", `/guilds/${seg(request.guild_id)}/stickers/${seg(request.sticker_id)}`, {
    body: ::api/body(request, ["guild_id", "sticker_id"]),
    reason: request.reason
  }, opts)
}

DeleteGuildStickerRequest type {
  guild_id: Str,
  sticker_id: Str,
  reason: Str?
}

delete-guild-sticker
meta {
    doc: """
    DELETE /guilds/{guild_id}/stickers/{sticker_id} - Delete a sticker.
    Needs MANAGE_GUILD_EXPRESSIONS.

    **Example**

    ```hot
    ::stickers ::discord::stickers

    ::stickers/delete-guild-sticker(::stickers/DeleteGuildStickerRequest({
      guild_id: "1000000000000000000",
      sticker_id: "2200000000000000000",
      reason: "Retired"
    }))
    ```
    """
}
fn
(request: DeleteGuildStickerRequest): Bool {
  delete-guild-sticker(request, {})
},
(request: DeleteGuildStickerRequest, opts: Map): Bool {
  ::api/call-ok("DELETE", `/guilds/${seg(request.guild_id)}/stickers/${seg(request.sticker_id)}`, {reason: request.reason}, opts)
}
