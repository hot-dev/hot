::aws::sns::topics ns

// SNS Topic operations

HttpResponse ::hot::http/HttpResponse
is-ok-response ::hot::http/is-ok-response

resolve ::aws::core/resolve
send-signed ::aws::core/send-signed
service-url ::aws::core/service-url
AwsError ::aws::core/AwsError

// Topic type
Topic type {
    topic_arn: Str
}

// Create topic response
CreateTopicResponse type {
    topic_arn: Str?
}

// List topics response
ListTopicsResponse type {
    topics: Vec<Topic>,
    next_token: Str?
}

// Get topic attributes response
GetTopicAttributesResponse type {
    attributes: Map
}

// Create a new SNS topic
create-topic
meta {
    doc: """
    Create a new SNS topic.

    Attributes can include DisplayName, Policy, DeliveryPolicy, FifoTopic, and
    ContentBasedDeduplication.

    **Example**

    ```hot
    // Simple topic
    result ::aws::sns::topics/create-topic("my-notifications")
    result.topic_arn  // => "arn:aws:sns:us-east-1:123456:my-notifications"

    // Topic with display name
    result ::aws::sns::topics/create-topic("alerts", {DisplayName: "My Alerts"})
    ```
    """
}
fn
(name: Str, attributes: Map, tags: Vec<Map>?, opts: Map): CreateTopicResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        request-body {
            Name: name
        }

        with-attributes cond {
            is-empty(attributes) => { request-body }
            => { merge(request-body, { Attributes: attributes }) }
        }

        with-tags merge(with-attributes, filter-vals({
            Tags: tags
        }, is-some))

        body to-json(with-tags)

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.CreateTopic"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { CreateTopicResponse({
                topic_arn: response.body.TopicArn
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(name: Str, attributes: Map, opts: Map): CreateTopicResponse | AwsError {
    create-topic(name, attributes, null, opts)
},
(name: Str, attributes: Map, tags: Vec<Map>?): CreateTopicResponse | AwsError {
    create-topic(name, attributes, tags, {})
},
(name: Str, attributes: Map): CreateTopicResponse | AwsError {
    create-topic(name, attributes, null)
},
(name: Str): CreateTopicResponse | AwsError {
    create-topic(name, {}, null)
}

// Delete an SNS topic
delete-topic
meta {
    doc: """
    Delete an SNS topic by its ARN.

    **Example**

    ```hot
    ::aws::sns::topics/delete-topic("arn:aws:sns:us-east-1:123456:my-topic")
    ```
    """
}
fn
(topic_arn: Str, opts: Map): Map | AwsError {
    if-ok(resolve(opts), (resolved) {
        body to-json({
            TopicArn: topic_arn
        })

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.DeleteTopic"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { { success: true } }
            => { AwsError(response) }
        }
    })
},
(topic_arn: Str): Map | AwsError {
    delete-topic(topic_arn, {})
}

// List all SNS topics
list-topics
meta {
    doc: """
    List all SNS topics. Supports pagination via next_token.

    **Example**

    ```hot
    result ::aws::sns::topics/list-topics()
    topic-arns map(result.topics, %.topic_arn)
    // => ["arn:aws:sns:us-east-1:123456:topic-1", "arn:aws:sns:us-east-1:123456:topic-2"]
    ```
    """
}
fn
(next_token: Str?, opts: Map): ListTopicsResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        request-body {}

        with-token merge(request-body, filter-vals({
            NextToken: next_token
        }, is-some))

        body to-json(with-token)

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.ListTopics"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { ListTopicsResponse({
                topics: if(is-null(response.body.Topics), [], map(response.body.Topics, Topic({ topic_arn: %.TopicArn }))),
                next_token: response.body.NextToken
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(opts: Map): ListTopicsResponse | AwsError {
    list-topics(null, opts)
},
(next_token: Str?): ListTopicsResponse | AwsError {
    list-topics(next_token, {})
},
(): ListTopicsResponse | AwsError {
    list-topics(null)
}

