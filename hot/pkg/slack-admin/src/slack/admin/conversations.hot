get-teams
meta {
    doc: """
    admin.conversations.getTeams - List the workspaces a channel is connected to (`team_ids`).

    Scope: `admin.conversations:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `get-teams-all`.
    """
}
fn (request: GetTeamsRequest): Map {
  ::api/call("admin.conversations.getTeams", request)
}

get-teams-all
meta {
    doc: """
    Every `team_ids` entry from `admin.conversations.getTeams`, following `next_cursor` until the last page or `max-items` (default 1000). `request` sets the filters; its `cursor` is the starting point.
    """
}
fn
(request: GetTeamsRequest): Vec {
  get-teams-all(request, 1000)
},
(request: GetTeamsRequest, max-items: Int): Vec {
  ::api/paginate("admin.conversations.getTeams", request, "team_ids", max-items)
}

