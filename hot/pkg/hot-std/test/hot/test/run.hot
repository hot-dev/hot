::hot::test::run ns
meta ["test"]

test-is-inline-run
meta ["test"] fn () {
    // `hot test` runs directly, as `hot run` does, not from an event or a
    // schedule.
    assert(is-inline-run(), "is-inline-run() under hot test")
}

test-info-retries-are-zero-in-a-direct-run
meta ["test"] fn () {
    // Hot retries handlers and schedules, not a run started directly.
    run info().run
    assert-eq(0, run.max-retries, "max-retries")
    assert-eq(0, run.retry-delay, "retry-delay")
}
