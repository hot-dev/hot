::hubspot::notes ns
meta {
    doc: """Notes — HubSpot's activity log entries, attached to contacts, companies, deals, or tickets. The agent-facing "log this to the CRM" surface; `::hubspot::engagements` covers tasks, calls, meetings, and emails."""
}

::api ::hubspot::api
::engagements ::hubspot::engagements

note-association-type-id
meta {
    doc: """
    The HUBSPOT_DEFINED association type id linking a note to a record type
    (contacts 202, companies 190, deals 214, tickets 228). Exposed for
    testing.

    **Example**

    ```hot
    ::hubspot::notes/note-association-type-id("deals")  // 214
    ```
    """
}
fn (object-type: Str): Int {
  ::engagements/association-type-id("notes", object-type)
}

build-note-body
meta {
    doc: """
    Build the create-note payload for a note attached to a record. Exposed
    for testing; `log-note` uses it.

    **Example**

    ```hot
    ::hubspot::notes/build-note-body("contacts", "123", "Called.", 1762000000000).properties
    // {hs_note_body: "Called.", hs_timestamp: 1762000000000}
    ```
    """
}
fn (object-type: Str, record-id: Str, body: Str, timestamp-ms: Int): Map {
  ::engagements/build-activity-body("notes", {hs_note_body: body}, [{type: object-type, id: record-id}], timestamp-ms)
}

log-note
meta {
    doc: """
    POST /crm/objects/{version}/notes - Attach a note to a contact,
    company, deal, or ticket, timestamped now.

    **Example**

    ```hot
    ::hubspot::notes/log-note("contacts", "12345", "Demo went well; sending pricing.")
    ```
    """
}
fn
(object-type: Str, record-id: Str, body: Str): Map {
  log-note(object-type, record-id, body, {})
},
(object-type: Str, record-id: Str, body: Str, opts: Map): Map {
  ::engagements/create-note({hs_note_body: body}, [{type: object-type, id: record-id}], opts)
}
