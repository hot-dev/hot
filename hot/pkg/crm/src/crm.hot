::crm ns
meta {
    doc: """
    CRM-agnostic operations for agents and workflows: contacts,
    companies, deals, and activities against HubSpot, Salesforce, or
    Attio through one normalized surface.

    **Provider selection**: per call with `options.provider`, else the
    `crm.provider` context variable, else the first configured of
    HubSpot (`hubspot.token`), Salesforce (a complete
    `::salesforce::auth` flow), Attio (`attio.api.key`). Every
    normalized value carries `provider` and the provider's `raw`
    payload; the provider-native packages remain available for anything
    beyond this surface.

    **Per-call credentials**: `options` also takes a section per provider,
    passed as that package's `opts`: `hubspot: {token: ...}`, `salesforce:
    {access-token: ..., instance-url: ...}`, `attio: {api-key: ...}`. They
    are masked in call records and never written to ctx, so one run can
    act for many accounts. The section of the provider in use applies;
    without `provider`, the first section in hubspot, salesforce, attio
    order picks it. A section that is not a Map is an Err, and so are
    `opts` its package refuses (see `::hubspot::api/resolve`,
    `::salesforce::api/resolve` and `::attio::api/resolve`), never a
    fallback to context.

    **Quick start**

    ```hot
    ::crm ::crm

    contact ::crm/upsert-contact({
      email: "ada@example.com",
      first-name: "Ada",
      last-name: "Lovelace"
    })

    ::crm/log-activity(contact, "Demo call went well; wants pricing for 50 seats.")

    existing ::crm/find-contact("ada@example.com", {provider: "hubspot"})

    // For another account
    tenant {hubspot: {token: "pat-tenant-b"}}
    theirs ::crm/find-contact("ada@example.com", tenant)
    ::crm/log-activity(theirs, "Called back.", tenant)
    ```
    """
}

::ctx ::hot::ctx

PROVIDERS ["hubspot", "salesforce", "attio"]

// ============================================================================
// Normalized types
// ============================================================================

Contact
meta {
    doc: """A normalized CRM contact: `id` (provider record id), `email`, `first-name`, `last-name`, `phone`, `company-id` (the linked company/account record id, when known), `provider` ("hubspot"/"salesforce"/"attio"), and `raw` (the provider payload)."""
}
type {
  id: Str,
  email: Str?,
  first-name: Str?,
  last-name: Str?,
  phone: Str?,
  company-id: Str?,
  provider: Str,
  raw: Any?
}

Company
meta {
    doc: """A normalized CRM company (a Salesforce Account): `id`, `name`, `domain` (normalized, e.g. `acme.com`), `provider`, `raw`."""
}
type {
  id: Str,
  name: Str?,
  domain: Str?,
  provider: Str,
  raw: Any?
}

Deal
meta {
    doc: """A normalized deal (a Salesforce Opportunity): `id`, `name`, `stage` (the provider's stage value: a HubSpot stage id, a Salesforce StageName, an Attio status title), `amount`, `close-date` (`YYYY-MM-DD`; Attio has none), `company-id` (when known), `provider`, `raw`."""
}
type {
  id: Str,
  name: Str?,
  stage: Str?,
  amount: Any?,
  close-date: Str?,
  company-id: Str?,
  provider: Str,
  raw: Any?
}

Activity
meta {
    doc: """A normalized activity on a contact (a HubSpot note, a Salesforce Task, an Attio note): `id`, `subject`, `body`, `occurred-at` (provider timestamp, when known), `provider`, `raw`."""
}
type {
  id: Str,
  subject: Str?,
  body: Str?,
  occurred-at: Any?,
  provider: Str,
  raw: Any?
}

// ============================================================================
// Shared pure helpers
// ============================================================================

is-blank-value fn (value: Any): Bool {
  or(is-null(value), and(is-str(value), is-blank(value)))
}

cut-at fn (value: Str, marker: Str): Str {
  first(split(value, marker))
}

strip-prefix fn (value: Str, prefix: Str): Str {
  if(starts-with(value, prefix), slice(value, length(prefix)), value)
}

normalize-domain
meta {
    doc: """
    Reduce a domain or website to its bare host for matching:
    lowercase, no scheme, no `www.`, no port, path, query, or trailing
    dot. `https://www.Acme.com/about` → `acme.com`. Null or blank stays
    null. Exposed for testing.
    """
}
fn (value: Any): Any {
  cond {
    is-blank-value(value) => { null }
    => {
      lowered lowercase(trim(Str(value)))
      no-scheme strip-prefix(strip-prefix(lowered, "https://"), "http://")
      host cut-at(cut-at(cut-at(cut-at(cut-at(no-scheme, "/"), "?"), "#"), ":"), " ")
      bare strip-prefix(host, "www.")
      trimmed if(ends-with(bare, "."), slice(bare, 0, sub(length(bare), 1)), bare)
      if(is-empty(trimmed), null, trimmed)
    }
  }
}

full-name
meta {
    doc: """Join first and last name, skipping blanks. Exposed for testing."""
}
fn (first-name: Any, last-name: Any): Str {
  trim(join(filter([or(first-name, ""), or(last-name, "")], (p) { not(is-blank(p)) }), " "))
}

// ============================================================================
// Provider selection
// ============================================================================

select-provider
meta {
    doc: """
    The provider-selection rule as a pure function. `preferred` (from
    `options.provider` or `crm.provider`) wins when set and must be one
    of hubspot, salesforce, attio (else an Err). Otherwise the first
    provider marked true in `available` (`{hubspot, salesforce, attio}`
    Bools), in that order, or null when none is. Exposed for testing.
    """
}
fn (preferred: Any, available: Map): Any {
  cond {
    not(is-blank-value(preferred)) => {
      name lowercase(trim(Str(preferred)))
      if(in(name, PROVIDERS), name, err(`crm: unknown provider '${preferred}' (use hubspot, salesforce, or attio)`))
    }

    Bool(get(available, "hubspot", false)) => { "hubspot" }
    Bool(get(available, "salesforce", false)) => { "salesforce" }
    Bool(get(available, "attio", false)) => { "attio" }
    => { null }
  }
}

available-providers
meta {
    ctx: {
        "hubspot.token": {required: false},
        "attio.api.key": {required: false}
    },
    doc: """Which providers have credentials in context: `{hubspot, salesforce, attio}` Bools. Salesforce counts only when a complete auth flow is configured (`::salesforce::auth/is-configured`), so a bare `salesforce.client-id` does not select it."""
}
fn (): Map {
  {
    hubspot: not(is-blank-value(::ctx/get("hubspot.token"))),
    salesforce: ::salesforce::auth/is-configured(),
    attio: not(is-blank-value(::ctx/get("attio.api.key")))
  }
}

configured-provider
meta {
    ctx: {"crm.provider": {required: false, secret: false}},
    doc: """The provider the context selects: `crm.provider` when set, else the first configured of hubspot, salesforce, attio; null when none is."""
}
fn (): Any {
  select-provider(::ctx/get("crm.provider"), available-providers())
}

mark-credentials
meta {
    doc: """Mask the credentials in `options`' provider sections in this run's call records. Called first wherever `options` arrives, so the records of the calls after it are masked too. Returns null."""
}
fn (options: Map): Any {
  ::ctx/mark-secret([
    options.hubspot.token,
    options.salesforce.token,
    options.salesforce.access-token,
    options.salesforce.refresh-token,
    options.salesforce.client-id,
    options.salesforce.client-secret,
    options.salesforce.private-key,
    options.attio.api-key
  ])
  null
}

provider-opts
meta {
    doc: """The provider's section of `options`, passed to its package as `opts`; `{}` when there is none. Exposed for testing."""
}
fn (options: Map, provider: Str): Map {
  or(get(options, provider), {})
}

check-section
meta {
    doc: """
    `provider` when its section of `options` can be used, else an Err for
    a section that is present but not a Map. That never falls back to
    context, so a tenant's missing credentials never run on the project's.
    Exposed for testing.
    """
}
fn (options: Map, provider: Str): Str {
  mark-credentials(options)
  section get(options, provider)
  cond {
    and(in(provider, keys(options)), not(is-map(section))) => {
      err(`crm: ${provider} is in the call's options but is not a Map of credentials. Pass a Map, or leave ${provider} out to use context.`)
    }
    => { provider }
  }
}

resolve-provider
meta {
    doc: """The provider for one call: `options.provider` when set, else the first provider section in `options`, else `configured-provider()`. An Err when nothing is configured, the name is unknown, or the provider's section can't be used (see `check-section`)."""
}
fn (options: Map): Str {
  mark-credentials(options)
  explicit get(options, "provider")
  section find-first(PROVIDERS, (name) { in(name, keys(options)) })
  chosen cond {
    not(is-blank-value(explicit)) => { select-provider(explicit, {}) }
    is-some(section) => { section }
    => { configured-provider() }
  }

  cond {
    is-err(chosen) => { chosen }
    is-null(chosen) => { no-provider() }
    => { check-section(options, chosen) }
  }
}

no-provider fn (): Any {
  err("crm: no CRM configured. Set hubspot.token, a salesforce.* auth flow, or attio.api.key in Context Variables (and crm.provider to choose between several).")
}

require-field fn (fields: Map, key: Str, what: Str): Any {
  cond {
    is-blank-value(get(fields, key)) => { err(`crm: ${what} needs '${key}'`) }
    => { null }
  }
}

// ============================================================================
// Contacts
// ============================================================================

upsert-contact
meta {
    doc: """
    Create or update a contact by email. `fields`: `email` (required),
    `first-name`, `last-name`, `phone`, `company` (a company name),
    `company-id` (a provider company/account id; wins over `company`).
    Only the fields you pass are written. Returns a `Contact`.

    - HubSpot: one batch upsert keyed on email (no search lag); `company`
      sets the contact's company text property and `company-id`
      associates the company record.
    - Salesforce: `company` links the Account with that exact Name,
      creating it when none exists; `LastName` (required by Salesforce)
      defaults to "Unknown" only when creating a contact.
    - Attio: `company` links the company record with that exact name,
      creating it when none exists. Attio stores a name as one value, so
      when only one of first/last name is given the other is kept from
      the existing record.
    """
}
fn
(fields: Map): Contact {
  upsert-contact(fields, {})
},
(fields: Map, options: Map): Contact {
  provider resolve-provider(options)
  missing require-field(fields, "email", "upsert-contact")
  cond {
    is-err(provider) => { provider }
    is-err(missing) => { missing }
    eq(provider, "hubspot") => { ::crm::hubspot/upsert-contact(fields, provider-opts(options, provider)) }
    eq(provider, "salesforce") => { ::crm::salesforce/upsert-contact(fields, provider-opts(options, provider)) }
    => { ::crm::attio/upsert-contact(fields, provider-opts(options, provider)) }
  }
}

find-contact
meta {
    doc: """Find a contact by exact email. Returns a `Contact` or null. HubSpot looks the email up directly (no search lag)."""
}
fn
(email: Str): Any {
  find-contact(email, {})
},
(email: Str, options: Map): Any {
  provider resolve-provider(options)
  cond {
    is-err(provider) => { provider }
    eq(provider, "hubspot") => { ::crm::hubspot/find-contact(email, provider-opts(options, provider)) }
    eq(provider, "salesforce") => { ::crm::salesforce/find-contact(email, provider-opts(options, provider)) }
    => { ::crm::attio/find-contact(email, provider-opts(options, provider)) }
  }
}

resolve-contact fn (contact: Any, options: Map): Any {
  resolved cond {
    is-str(contact) => { find-contact(contact, options) }
    => { contact }
  }

  cond {
    is-err(resolved) => { resolved }
    is-null(resolved) => { err(`crm: no contact found for '${contact}'`) }
    => { resolved }
  }
}

// ============================================================================
// Activities
// ============================================================================

log-activity
meta {
    doc: """
    Log an activity on a contact: a HubSpot note, a Salesforce completed
    Task, or an Attio note. `contact` is a `Contact` (its `provider` is
    used) or an email. `options`: `subject` (a HubSpot note's first
    line, a Task's Subject, an Attio note's title; default "Note"),
    `provider`. Returns an `Activity`.
    """
}
fn
(contact: Any, body: Str): Activity {
  log-activity(contact, body, {})
},
(contact: Any, body: Str, options: Map): Activity {
  resolved resolve-contact(contact, options)
  cond {
    is-err(resolved) => { resolved }
    => {
      provider check-section(options, resolved.provider)
      cond {
        is-err(provider) => { provider }
        eq(provider, "hubspot") => { ::crm::hubspot/log-activity(resolved.id, body, options, provider-opts(options, provider)) }
        eq(provider, "salesforce") => { ::crm::salesforce/log-activity(resolved.id, body, options, provider-opts(options, provider)) }
        eq(provider, "attio") => { ::crm::attio/log-activity(resolved.id, body, options, provider-opts(options, provider)) }
        => { err(`crm: unknown provider '${provider}' on contact`) }
      }
    }
  }
}

list-activities
meta {
    doc: """The activities on a contact, newest first: HubSpot notes, Salesforce Tasks, Attio notes. `contact` is a `Contact` or an email. `options`: `limit` (default 20), `provider`. Returns a Vec of `Activity`."""
}
fn
(contact: Any): Vec {
  list-activities(contact, {})
},
(contact: Any, options: Map): Vec {
  resolved resolve-contact(contact, options)
  limit or(get(options, "limit"), 20)
  cond {
    is-err(resolved) => { resolved }
    => {
      provider check-section(options, resolved.provider)
      cond {
        is-err(provider) => { provider }
        eq(provider, "hubspot") => { ::crm::hubspot/list-activities(resolved.id, limit, provider-opts(options, provider)) }
        eq(provider, "salesforce") => { ::crm::salesforce/list-activities(resolved.id, limit, provider-opts(options, provider)) }
        eq(provider, "attio") => { ::crm::attio/list-activities(resolved.id, limit, provider-opts(options, provider)) }
        => { err(`crm: unknown provider '${provider}' on contact`) }
      }
    }
  }
}

// ============================================================================
// Companies
// ============================================================================

upsert-company
meta {
    doc: """
    Create or update a company by domain. `fields`: `domain` (required;
    normalized, so `https://www.acme.com/` and `acme.com` match), `name`.
    Returns a `Company`.

    - Salesforce matches Accounts whose `Website` normalizes to the same
      domain (`acme.com`, `www.acme.com`, `https://acme.com/`), or an exact
      match on a custom field named by `crm.salesforce.domain-field`
      (e.g. `Domain__c`) when set.
    - HubSpot matches on the `domain` property through search, which can
      lag a few seconds behind writes.
    - Attio asserts on the unique `domains` attribute.
    """
}
fn
(fields: Map): Company {
  upsert-company(fields, {})
},
(fields: Map, options: Map): Company {
  provider resolve-provider(options)
  domain normalize-domain(get(fields, "domain"))
  normalized {...fields, domain: domain}
  cond {
    is-err(provider) => { provider }
    is-null(domain) => { err("crm: upsert-company needs 'domain'") }
    eq(provider, "hubspot") => { ::crm::hubspot/upsert-company(normalized, provider-opts(options, provider)) }
    eq(provider, "salesforce") => { ::crm::salesforce/upsert-company(normalized, provider-opts(options, provider)) }
    => { ::crm::attio/upsert-company(normalized, provider-opts(options, provider)) }
  }
}

find-company
meta {
    doc: """Find a company by domain (normalized as in `upsert-company`). Returns a `Company` or null."""
}
fn
(domain: Str): Any {
  find-company(domain, {})
},
(domain: Str, options: Map): Any {
  provider resolve-provider(options)
  normalized normalize-domain(domain)
  cond {
    is-err(provider) => { provider }
    is-null(normalized) => { null }
    eq(provider, "hubspot") => { ::crm::hubspot/find-company(normalized, provider-opts(options, provider)) }
    eq(provider, "salesforce") => { ::crm::salesforce/find-company(normalized, provider-opts(options, provider)) }
    => { ::crm::attio/find-company(normalized, provider-opts(options, provider)) }
  }
}

// ============================================================================
// Deals
// ============================================================================

find-deals
meta {
    doc: """
    Find deals. `filter`: `name` (exact), `stage`, `company-id`,
    `contact-id`, `limit` (default 20). Unset keys do not filter.
    Returns a Vec of `Deal`, newest first. HubSpot search can lag a few
    seconds behind writes.
    """
}
fn
(criteria: Map): Vec {
  find-deals(criteria, {})
},
(criteria: Map, options: Map): Vec {
  provider resolve-provider(options)
  cond {
    is-err(provider) => { provider }
    eq(provider, "hubspot") => { ::crm::hubspot/find-deals(criteria, provider-opts(options, provider)) }
    eq(provider, "salesforce") => { ::crm::salesforce/find-deals(criteria, provider-opts(options, provider)) }
    => { ::crm::attio/find-deals(criteria, provider-opts(options, provider)) }
  }
}

create-deal fn (provider: Str, fields: Map, options: Map): Deal {
  cond {
    eq(provider, "hubspot") => { ::crm::hubspot/create-deal(fields, provider-opts(options, provider)) }
    eq(provider, "salesforce") => { ::crm::salesforce/create-deal(fields, provider-opts(options, provider)) }
    => { ::crm::attio/create-deal(fields, provider-opts(options, provider)) }
  }
}

update-deal fn (provider: Str, id: Str, fields: Map, options: Map): Deal {
  cond {
    eq(provider, "hubspot") => { ::crm::hubspot/update-deal(id, fields, provider-opts(options, provider)) }
    eq(provider, "salesforce") => { ::crm::salesforce/update-deal(id, fields, provider-opts(options, provider)) }
    => { ::crm::attio/update-deal(id, fields, provider-opts(options, provider)) }
  }
}

upsert-deal
meta {
    doc: """
    Create or update a deal. `fields`: `id` (update that deal), `name`,
    `stage`, `amount`, `close-date` (`YYYY-MM-DD`), `company-id`,
    `contact-id`, plus `pipeline` (HubSpot) and `owner` (Attio: the
    owner's workspace-member email; required to create, or set
    `crm.attio.deal-owner`). Without `id` the deal is matched by exact
    `name` (within `company-id` when given): no match creates one, one
    match updates it, several is an Err. Returns a `Deal`.

    Creating needs `name` and `stage` everywhere, and `close-date` on
    Salesforce. `stage` is the provider's own value: a HubSpot stage id
    (resolve labels with `::hubspot::pipelines/find-stage`), a
    Salesforce StageName, an Attio status title.

    **Example**

    ```hot
    company ::crm/upsert-company({domain: "acme.com", name: "Acme"})
    deal ::crm/upsert-deal({
      name: "Acme expansion",
      stage: "Prospecting",
      amount: 24000,
      close-date: "2026-12-31",
      company-id: company.id
    })
    ::crm/move-stage(deal, "Negotiation/Review")
    ```
    """
}
fn
(fields: Map): Deal {
  upsert-deal(fields, {})
},
(fields: Map, options: Map): Deal {
  provider resolve-provider(options)
  id get(fields, "id")
  cond {
    is-err(provider) => { provider }
    not(is-blank-value(id)) => { update-deal(provider, Str(id), fields, options) }
    is-blank-value(get(fields, "name")) => { err("crm: upsert-deal needs 'id' or 'name'") }
    => {
      matches find-deals(filter-vals({name: fields.name, company-id: get(fields, "company-id"), limit: 2}, is-some), {...options, provider: provider})
      cond {
        is-err(matches) => { matches }
        is-empty(matches) => { create-deal(provider, fields, options) }
        eq(length(matches), 1) => { update-deal(provider, first(matches).id, fields, options) }
        => { err(`crm: several deals are named '${fields.name}'; pass 'id' to pick one`) }
      }
    }
  }
}

move-stage
meta {
    doc: """Move a deal to another stage. `deal` is a `Deal` (its `provider` is used) or a deal id (with `options.provider` or the configured provider). Returns the updated `Deal`."""
}
fn
(deal: Any, stage: Str): Deal {
  move-stage(deal, stage, {})
},
(deal: Any, stage: Str, options: Map): Deal {
  provider cond {
    is-str(deal) => { resolve-provider(options) }
    => { check-section(options, deal.provider) }
  }

  id cond {
    is-str(deal) => { deal }
    => { deal.id }
  }

  cond {
    is-err(provider) => { provider }
    eq(provider, "hubspot") => { ::crm::hubspot/move-stage(id, stage, provider-opts(options, provider)) }
    eq(provider, "salesforce") => { ::crm::salesforce/move-stage(id, stage, provider-opts(options, provider)) }
    => { ::crm::attio/move-stage(id, stage, provider-opts(options, provider)) }
  }
}
