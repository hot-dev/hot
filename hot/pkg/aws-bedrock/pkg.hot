::hot::pkg ns

hot.pkg.aws-bedrock {
  name: "hot.dev/aws-bedrock",
  version: "1.4.0",
  hot-min-version: "3.0.2",
  description: "AWS Bedrock API bindings for foundation model inference (Claude, Titan, Llama, Mistral, and more), with a hot-ai tool-calling adapter over Converse.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["cloud", "ai"],
  deps: {
    "hot.dev/hot-std": {},
    "hot.dev/aws-core": "1.3.1",
    "hot.dev/aws-eventstream": "1.2.3",
    "hot.dev/hot-ai": "1.11.0"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
