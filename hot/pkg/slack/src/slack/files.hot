files-upload
meta {
    doc: """
    POST /files.upload - Upload a file. Provide `content` for text-based
    uploads or `file` for binary files. Optionally share to channels and add
    an initial comment.

    **Example**

    ```hot
    response ::slack::files/files-upload(::slack::files/FilesUploadRequest({
      channels: "C1234567",
      content: "name,total\nacme,42\n",
      filename: "totals.csv",
      title: "Totals",
      initial_comment: "Latest totals"
    }))
    response.file.id
    ```
    """
}
fn
(request: FilesUploadRequest): FilesUploadResponse {
  files-upload(request, {})
},
(request: FilesUploadRequest, opts: Map): FilesUploadResponse {
  response api-request("POST", `${::slack::core/BASE_URL}/files.upload`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { FilesUploadResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

