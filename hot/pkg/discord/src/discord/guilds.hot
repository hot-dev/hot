GetGuildBansRequest type {
  guild_id: Str,
  limit: Int?,
  before: Str?,
  after: Str?
}

get-guild-bans
meta {
    doc: """GET /guilds/{guild_id}/bans - Bans (`{user, reason}`), up to `limit` (1-1000). Page with `before`/`after` user ids, or use `get-all-guild-bans`. Needs BAN_MEMBERS."""
}
fn (request: GetGuildBansRequest): Vec<Map> {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/bans`, {
    query: {limit: request.limit, before: request.before, after: request.after}
  })
}

get-all-guild-bans
meta {
    doc: """Every ban in a guild (up to `max-items`, default 10000), paging 1000 at a time with `after`."""
}
fn
(guild-id: Str): Vec<Map> {
  get-all-guild-bans(guild-id, 10000)
},
(guild-id: Str, max-items: Int): Vec<Map> {
  ::api/paginate(
    (after) { get-guild-bans(GetGuildBansRequest({guild_id: guild-id, limit: 1000, after: after})) },
    (page) { last(page).user.id },
    1000,
    max-items
  )
}

