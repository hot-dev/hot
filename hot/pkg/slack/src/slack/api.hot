::slack::api ns

// Namespace alias for ctx module
::ctx ::hot::ctx
::regex ::hot::regex

http-request ::hot::http/request
is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: response.headers,
    body: response.body
  })
}

query-pairs
meta {no-doc: true}
fn (key: Str, value: Any): Vec<Str> {
  cond {
    is-null(value) => { [] }
    // Slack takes a list as comma-separated values, and anything structured as JSON.
    and(is-vec(value), all(value, (item) { or(is-str(item), is-int(item)) })) => {
      query-pairs(key, join(map(value, (item) { `${item}` }), ","))
    }

    or(is-vec(value), is-map(value)) => { query-pairs(key, to-json(value)) }
    => {
      text `${value}`
      if(is-empty(text), [], [`${key}=${::hot::uri/encode(text)}`])
    }
  }
}

with-query
meta {
    doc: """
    Add query parameters to a URL (pure). Values are URL-encoded. A null or
    empty value is left out, a Vec of strings or numbers is comma-separated,
    and any other Vec or Map is sent as JSON.

    **Example**

    ```hot
    ::slack::api/with-query("https://slack.com/api/users.list", {limit: 20, cursor: null})
    // "https://slack.com/api/users.list?limit=20"
    ::slack::api/with-query("https://slack.com/api/search.messages", {query: "in:#general a&b"})
    // "https://slack.com/api/search.messages?query=in%3A%23general%20a%26b"
    ```
    """
}
fn (path: Str, params: Map): Str {
  pairs reduce(keys(params), (acc, k) { concat(acc, query-pairs(Str(k), get(params, k))) }, [])
  if(is-empty(pairs), path, `${path}?${join(pairs, "&")}`)
}

sanitize-url
meta {
    doc: """
    Remove legacy token query params and normalize URL separators. Strips
    any `token=` query parameters to ensure authentication is only sent via
    the Authorization header.

    **Example**

    ```hot
    ::slack::api/sanitize-url("https://slack.com/api/users.list?token=abc&limit=5")  // "https://slack.com/api/users.list?limit=5"

    ::slack::api/sanitize-url("https://slack.com/api/auth.test?token=abc")  // "https://slack.com/api/auth.test"
    ```
    """
}
fn (url: Str): Str {
  // Slack bearer auth is sent in Authorization header. Some endpoints still
  // include token= in query builders; strip it to avoid invalid_auth responses.
  url
      |> ::regex/replace-all("([?&])token=[^&]*&", "$1")
      |> ::regex/replace-all("[?&]token=[^&]*$", "")
      |> ::regex/replace-all("\\?&", "?")
      |> ::regex/replace-all("[?&]$", "")
}

is-blank
meta {no-doc: true}
fn (value: Any): Bool {
  cond {
    is-str(value) => { is-empty(trim(value)) }
    => { true }
  }
}

resolve-from
meta {
    doc: """
    The one resolver, pure: the credential for a call from `opts` first,
    then `ctx-values` (a Map of context variables). Returns `{api-key: ...}`, or
    an Err when there is none.

    A `api-key` key in `opts` always decides the call. If its value is null or
    blank that is an Err, never a fallback to context, so a tenant whose
    stored credential is missing can't silently run on the project's
    credential. Nothing is written to ctx. Exposed for testing; `resolve`
    feeds it the context.

    **Example**

    ```hot
    ::slack::api/resolve-from({}, {"slack.api.key": "project-key"})  // {api-key: "project-key"}
    ::slack::api/resolve-from({api-key: "tenant-key"}, {"slack.api.key": "project-key"})  // {api-key: "tenant-key"}

    // A blank key in opts never falls back to context
    is-err(::slack::api/resolve-from({api-key: ""}, {"slack.api.key": "project-key"}))  // true
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  cond {
    in("api-key", keys(opts)) => {
      value get(opts, "api-key")
      cond {
        is-blank(value) => { err("slack: the api-key in this call's opts is empty. Context is not used in its place.") }
        => { {api-key: value} }
      }
    }

    is-blank(get(ctx-values, "slack.api.key")) => { err("slack: slack.api.key is not set. Add your Slack token in Context Variables, or pass {api-key: ...} in the call's opts.") }
    => { {api-key: get(ctx-values, "slack.api.key")} }
  }
}

resolve
meta {
    ctx: {"slack.api.key": {required: false}},
    doc: """
    The credential for one call: `opts` over the `slack.api.key` context variable
    (see `resolve-from`). Per-call credentials stay in the call; nothing is
    written to ctx, so parallel flows and tenants never share them.
    A credential from `opts` is masked in the run's call records.

    **Example**

    ```hot
    ::slack::api/resolve({api-key: "tenant-b-credential"}).api-key  // "tenant-b-credential"
    ```
    """
}
fn (opts: Map): Map {
  ::ctx/mark-secret(opts.api-key)
  resolve-from(opts, {"slack.api.key": ::ctx/get("slack.api.key")})
}

request
meta {
    ctx: {"slack.api.key": {required: false}},
    doc: """
    Make an authenticated HTTP request to the Slack API. Automatically adds the Bearer token from the `slack.api.key` context variable and sets Content-Type for JSON bodies. Additional headers can be provided to merge/override defaults. With no key from either place, the call returns an Err (see `resolve`).

    **Example**

    ```hot
    ::api ::slack::api

    // Simple GET request
    response ::api/request("GET", "https://slack.com/api/auth.test")

    // POST with JSON body
    response ::api/request("POST", "https://slack.com/api/chat.postMessage", {}, {channel: "C1234", text: "Hello"})

    url "https://slack.com/api/chat.postMessage"
    body {channel: "C1234", text: "Hello"}
    api-key ::hot::ctx/get("tenant-b.slack.api.key")

    // With explicit API key override
    response ::api/request("POST", url, {}, body, api-key)

    // With per-call opts
    response ::api/request("POST", url, {}, body, {api-key: api-key})
    ```
    """
}
fn
(method: Str, url: Str): HttpResponse {
  request(method, url, {}, "")
},
(method: Str, url: Str, additional-headers: Map): HttpResponse {
  request(method, url, additional-headers, "")
},
// 4-arity: use ctx api key (default) — delegates to 5-arity
(method: Str, url: Str, additional-headers: Map, body: Any): HttpResponse {
  request(method, url, additional-headers, body, {})
},
// 5-arity: per-call opts ({api-key}), then ctx
(method: Str, url: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { request(method, url, additional-headers, body, resolved.api-key) }
  }
},
// 5-arity: explicit api key override
(method: Str, url: Str, additional-headers: Map, body: Any, api-key: Str): HttpResponse {
  ::ctx/mark-secret(api-key)
  final-url sanitize-url(url)
  default-headers {
    Authorization: `Bearer ${api-key}`
  }

  headers if(eq(body, ""), default-headers, merge(default-headers, {Content-Type: "application/json; charset=utf-8"}))
  final-headers merge(headers, additional-headers)

  encoded-body if(eq(body, ""), "", to-json(untype(body)))
  ::hot::http/request(HttpRequest({
    method: method,
    url: final-url,
    headers: final-headers,
    body: encoded-body
  }))
}
