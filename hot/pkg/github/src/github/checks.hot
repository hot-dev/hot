::github::checks ns

::api ::github::api
::uri ::hot::uri
query-string ::hot::uri/query-string

checks-path
meta {no-doc: true}
fn (owner: Str, repo: Str, suffix: Str): Str {
  `/repos/${owner}/${repo}${suffix}`
}

check-run-path
meta {no-doc: true}
fn (owner: Str, repo: Str, check-run-id: Any): Str {
  checks-path(owner, repo, `/check-runs/${check-run-id}`)
}

check-suite-path
meta {no-doc: true}
fn (owner: Str, repo: Str, check-suite-id: Any): Str {
  checks-path(owner, repo, `/check-suites/${check-suite-id}`)
}

ref-checks-path
meta {no-doc: true}
fn (owner: Str, repo: Str, ref: Str, resource: Str): Str {
  checks-path(owner, repo, `/commits/${::uri/encode(ref)}/${resource}`)
}

get-check-run
meta {
    doc: """
    GET /repos/{owner}/{repo}/check-runs/{check_run_id} - One check run and
    its structured output summary.

    **Example**

    ```hot
    check ::github::checks/get-check-run("acme", "api", 4242)
    check.output.summary
    ```
    """
}
fn
(owner: Str, repo: Str, check-run-id: Any): Map {
  get-check-run(owner, repo, check-run-id, {})
},
(owner: Str, repo: Str, check-run-id: Any, opts: Map): Map {
  ::api/json("GET", check-run-path(owner, repo, check-run-id), {}, "", opts)
}

list-check-runs-for-ref
meta {
    doc: """
    GET /repos/{owner}/{repo}/commits/{ref}/check-runs - Check runs from
    GitHub Actions and external CI for a SHA, branch, or tag. `params`
    supports `check_name`, `status`, `filter` ("latest"/"all"), `app_id`,
    `per_page`, and `page`.

    **Example**

    ```hot
    result ::github::checks/list-check-runs-for-ref("acme", "api", "main", {filter: "latest"})
    failed filter(result.check_runs, eq(%.conclusion, "failure"))
    map(failed, %.name)
    ```
    """
}
fn
(owner: Str, repo: Str, ref: Str): Map {
  ::api/json("GET", ref-checks-path(owner, repo, ref, "check-runs"))
},
(owner: Str, repo: Str, ref: Str, params: Map): Map {
  list-check-runs-for-ref(owner, repo, ref, params, {})
},
(owner: Str, repo: Str, ref: Str, params: Map, opts: Map): Map {
  path ref-checks-path(owner, repo, ref, "check-runs")
  ::api/json("GET", `${path}${query-string(params)}`, {}, "", opts)
}

list-check-run-annotations
meta {
    doc: """
    GET /repos/{owner}/{repo}/check-runs/{check_run_id}/annotations -
    Structured file, line, severity, and message evidence. `params` supports
    `per_page` and `page`.

    **Example**

    ```hot
    notes ::github::checks/list-check-run-annotations("acme", "api", 4242, {per_page: 50})
    map(notes, `${%.path}:${%.start_line} ${%.message}`)
    ```
    """
}
fn
(owner: Str, repo: Str, check-run-id: Any): Vec {
  ::api/json("GET", `${check-run-path(owner, repo, check-run-id)}/annotations`)
},
(owner: Str, repo: Str, check-run-id: Any, params: Map): Vec {
  list-check-run-annotations(owner, repo, check-run-id, params, {})
},
(owner: Str, repo: Str, check-run-id: Any, params: Map, opts: Map): Vec {
  ::api/json(
    "GET",
    `${check-run-path(owner, repo, check-run-id)}/annotations${query-string(params)}`
  , {}, "", opts)
}

get-check-suite
meta {
    doc: """
    GET /repos/{owner}/{repo}/check-suites/{check_suite_id} - One check
    suite.

    **Example**

    ```hot
    suite ::github::checks/get-check-suite("acme", "api", 777)
    suite.conclusion
    ```
    """
}
fn
(owner: Str, repo: Str, check-suite-id: Any): Map {
  get-check-suite(owner, repo, check-suite-id, {})
},
(owner: Str, repo: Str, check-suite-id: Any, opts: Map): Map {
  ::api/json("GET", check-suite-path(owner, repo, check-suite-id), {}, "", opts)
}

list-check-suites-for-ref
meta {
    doc: """
    GET /repos/{owner}/{repo}/commits/{ref}/check-suites - Check suites for
    a SHA, branch, or tag. `params` supports `app_id`, `check_name`,
    `per_page`, and `page`.

    **Example**

    ```hot
    result ::github::checks/list-check-suites-for-ref("acme", "api", "v1.2.0")
    map(result.check_suites, %.status)
    ```
    """
}
fn
(owner: Str, repo: Str, ref: Str): Map {
  ::api/json("GET", ref-checks-path(owner, repo, ref, "check-suites"))
},
(owner: Str, repo: Str, ref: Str, params: Map): Map {
  list-check-suites-for-ref(owner, repo, ref, params, {})
},
(owner: Str, repo: Str, ref: Str, params: Map, opts: Map): Map {
  path ref-checks-path(owner, repo, ref, "check-suites")
  ::api/json("GET", `${path}${query-string(params)}`, {}, "", opts)
}

list-check-runs-for-suite
meta {
    doc: """
    GET /repos/{owner}/{repo}/check-suites/{check_suite_id}/check-runs -
    Check runs in one suite. `params` supports `check_name`, `status`,
    `filter` ("latest"/"all"), `per_page`, and `page`.

    **Example**

    ```hot
    result ::github::checks/list-check-runs-for-suite("acme", "api", 777, {status: "completed"})
    map(result.check_runs, %.name)
    ```
    """
}
fn
(owner: Str, repo: Str, check-suite-id: Any): Map {
  ::api/json("GET", `${check-suite-path(owner, repo, check-suite-id)}/check-runs`)
},
(owner: Str, repo: Str, check-suite-id: Any, params: Map): Map {
  list-check-runs-for-suite(owner, repo, check-suite-id, params, {})
},
(owner: Str, repo: Str, check-suite-id: Any, params: Map, opts: Map): Map {
  ::api/json(
    "GET",
    `${check-suite-path(owner, repo, check-suite-id)}/check-runs${query-string(params)}`
  , {}, "", opts)
}
