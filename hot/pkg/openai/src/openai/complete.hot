::openai::complete ns

api-request ::openai::api/request
HttpError ::openai::api/HttpError
is-ok-response ::hot::http/is-ok-response

CompleteUploadRequest type {
    part_ids: Vec<Str>,
    md5: Str?
}

UploadStatus type open "pending" | "completed" | "cancelled" | "expired"

Upload type {
    id: Str,
    created_at: Int,
    filename: Str,
    bytes: Int,
    purpose: Str,
    status: UploadStatus,
    expires_at: Int,
    object: "upload",
    file: Any?
}

CompleteUploadRequest type {
    part_ids: Vec<Str>,
    md5: Str?
}

CompleteUploadResponse type {
    id: Str,
    created_at: Int,
    filename: Str,
    bytes: Int,
    purpose: Str,
    status: UploadStatus,
    expires_at: Int?,
    object: "upload",
    file: Any?
}


complete-upload
meta {
    doc: """POST /uploads/{upload_id}/complete - Complete a multi-part upload by providing the ordered list of part IDs."""
}
fn
(upload-id: Str, request: CompleteUploadRequest): CompleteUploadResponse {
  complete-upload(upload-id, request, {})
},
(upload-id: Str, request: CompleteUploadRequest, opts: Map): CompleteUploadResponse {
  response api-request("POST", `/uploads/${upload-id}/complete`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { CompleteUploadResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
