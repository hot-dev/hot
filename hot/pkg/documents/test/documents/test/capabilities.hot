::documents::test::capabilities ns
meta ["test"]

::caps ::documents::capabilities

KEYS ["provider", "name", "native-export", "conversion", "extracted-text", "read-text-formats", "search", "search-scope", "change-feed", "deletions-in-changes", "push-notifications", "push", "path-addressing", "max-simple-upload-bytes", "max-upload-bytes", "chunked-upload", "hashes", "notes"]

test-every-provider-has-every-key
meta ["test"] fn () {
    all-caps ::caps/capabilities()
    assert-eq(["box", "dropbox", "google-drive", "onedrive", "s3"], sort(keys(all-caps)))
    map(vals(all-caps), (c) {
        assert-eq(sort(KEYS), sort(keys(c)), `${c.provider} has exactly the documented keys`)
    })
}

test-lookups
meta ["test"] fn () {
    assert-eq("onedrive", ::caps/capabilities("sharepoint").provider, "aliases work")
    assert-eq(2097152, ::caps/capabilities("onedrive").conversion.max-source-bytes, "the Graph 2 MB conversion limit")
    assert-eq(4194304, ::caps/capabilities("onedrive").max-simple-upload-bytes)
    assert-eq(5242880, ::caps/capabilities("google-drive").max-simple-upload-bytes)
    assert-eq(["markdown", "html"], get(::caps/capabilities("dropbox").native-export, "application/vnd.dropbox.paper"))
    assert(in("markdown", get(::caps/capabilities("google").native-export, "application/vnd.google-apps.document")))
    assert-eq("box", ::caps/capabilities({provider: "box", folder-id: "1"}).provider, "a descriptor works too")
    assert(is-err(::caps/capabilities("ftp")))
}

test-supports
meta ["test"] fn () {
    assert(::caps/supports("box", "extracted-text"))
    assert(not(::caps/supports("dropbox", "extracted-text")))
    assert(not(::caps/supports("s3", "search")))
    assert(not(::caps/supports("s3", "push-notifications")))
    assert(::caps/supports("onedrive", "conversion"))
    assert(not(::caps/supports("box", "native-export")), "an empty Map is no support")
    assert(::caps/supports("dropbox", "path-addressing"))
    assert(not(::caps/supports("google-drive", "path-addressing")))
    assert(not(::caps/supports("ftp", "search")), "unknown providers support nothing")
    assert(not(::caps/supports("box", "teleport")))
    assert(::documents/capabilities("s3").deletions-in-changes |> not, "the top-level alias")
}
