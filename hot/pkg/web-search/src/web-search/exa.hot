::web-search::exa ns
meta {
    doc: """Exa: neural web search with page contents (https://docs.exa.ai). Context variable: `exa.api.key`, sent as `x-api-key`."""
}

::ctx ::hot::ctx
::http ::web-search::http
::time ::hot::time

HttpRequest ::hot::http/HttpRequest

BASE_URL "https://api.exa.ai"

// Exa's documented numResults range is 1-100.
MAX_RESULTS 100

// Page text requested per result by the normalized search, so
// `content` does not depend on Exa's defaults.
CONTENT_MAX_CHARACTERS 1000

post fn
(path: Str, body: Map): Any {
  post(path, body, ::ctx/get("exa.api.key"))
},
// 3-arity: explicit API key override
(path: Str, body: Map, api-key: Str): Any {
  ::http/send("exa", "Exa", HttpRequest({
    method: "POST",
    url: `${BASE_URL}${path}`,
    headers: {
      x-api-key: api-key,
      Content-Type: "application/json"
    },
    body: to-json(untype(filter-vals(body, is-some)))
  }))
}

search
meta {
    ctx: {"exa.api.key": {required: true}},
    doc: """
    POST /search - Exa search. `options`: `type` ("auto" default,
    "lite", "deep-lite", "deep"), `numResults` (1-100), `category`
    ("company", "news", "people", ...), `includeDomains`/
    `excludeDomains`, `startPublishedDate`/`endPublishedDate` (ISO
    8601), and `contents` (`{text: {maxCharacters: 2000}}`,
    `{highlights: true}`, `{summary: {}}`) to return page content
    inline. Null options are dropped.

    **Example**

    ```hot
    out ::web-search::exa/search("startups building sql runtimes", {
      numResults: 5,
      contents: {text: {maxCharacters: 2000}}
    })
    map(out.results, (r) { r.url })
    ```
    """
}
fn
(query: Str): Map {
  search(query, {})
},
(query: Str, options: Map): Map {
  post("/search", {...options, query: query})
}

get-contents
meta {
    ctx: {"exa.api.key": {required: true}},
    doc: """POST /contents - Clean page text for URLs (or Exa result ids). The 2-arity form takes contents options such as `{text: {maxCharacters: 5000}, highlights: true, maxAgeHours: 0}`. Returns `{results: [{url, title, text}], statuses}`."""
}
fn
(urls: Vec): Map {
  get-contents(urls, {text: true})
},
(urls: Vec, options: Map): Map {
  post("/contents", {...options, urls: urls})
}

find-similar
meta {
    ctx: {"exa.api.key": {required: true}},
    doc: """POST /findSimilar - Pages similar to a URL. `options`: `numResults`, `includeDomains`/`excludeDomains`, `excludeSourceDomain`, `startPublishedDate`, `contents`."""
}
fn
(url: Str): Map {
  find-similar(url, {})
},
(url: Str, options: Map): Map {
  post("/findSimilar", {...options, url: url})
}

FRESHNESS_DAYS {day: 1, week: 7, month: 31, year: 365}

published-since
meta {
    doc: """ISO 8601 `startPublishedDate` for a day/week/month/year `freshness`, measured back from `now-ms`, or null when unset. Exposed for testing."""
}
fn (freshness: Any, now-ms: Int): Any {
  days get(FRESHNESS_DAYS, or(freshness, ""))
  if(is-some(days), Str(::time/Instant(::time/Millisecond(sub(now-ms, mul(days, 86400000))))), null)
}

build-search-options
meta {
    doc: """Exa search options for the normalized `search`: `numResults` clamped to 1-100, `contents.text` capped at `CONTENT_MAX_CHARACTERS`, `startPublishedDate` for a freshness filter, and `includeDomains`/`excludeDomains`. Exposed for testing."""
}
fn (max-results: Int, filters: Map, now-ms: Int): Map {
  filter-vals({
    numResults: ::http/clamp(max-results, 1, MAX_RESULTS),
    contents: {text: {maxCharacters: CONTENT_MAX_CHARACTERS}},
    startPublishedDate: published-since(get(filters, "freshness"), now-ms),
    includeDomains: get(filters, "include-domains"),
    excludeDomains: get(filters, "exclude-domains")
  }, is-some)
}

normalize
meta {
    doc: """Normalize an Exa search response into `Vec<::web-search/SearchResult>`. `content` is the page text (or the first highlight when only highlights were requested); `score` is null unless Exa returns one. Exposed for testing."""
}
fn (body: Map): Vec {
  map(or(get(body, "results"), []), (r) {
    highlights or(get(r, "highlights"), [])
    ::web-search/SearchResult({
      title: or(get(r, "title"), ""),
      url: or(get(r, "url"), ""),
      content: or(get(r, "text"), if(is-empty(highlights), null, first(highlights))),
      score: get(r, "score")
    })
  })
}

search-normalized fn (query: Str, max-results: Int, filters: Map): Vec {
  now ::time/epoch-millis(::time/now())
  search(query, build-search-options(max-results, filters, now)) |> if-ok((body) { normalize(body) })
}
