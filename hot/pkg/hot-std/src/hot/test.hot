::hot::test ns
meta {
    doc: """
    Testing framework with assertions and test runners. A test can also fix
    the clock (`set-now`, `advance`), deliver events to their handlers
    (`deliver`) and fire due schedules (`run-due`).
    """
}

white ::hot::term/white
red ::hot::term/red
bright-green ::hot::term/bright-green
bright-yellow ::hot::term/bright-yellow
bright-red ::hot::term/bright-red
colors ::hot::term/colors

// debug helper
ptap
meta {
    doc: """
    Debug helper: print each item in `x` and return `x`.

    **Example**

    ```hot
    [1, 2, 3] |> ptap |> map(mul(%, 2))
    // Prints: 1, 2, 3
    // Returns: [2, 4, 6]
    ```
    """
}
fn (x) { map(x, println) x }

// DIAG: a local copy of mapcat used only by the test runner so that the
// runner doesn't sit on top of `mapcat`'s own activation when a test
// itself calls `mapcat`.
test-runner-mapcat fn (coll: Str | Vec | Map, f: Fn): Str | Vec | Map {
    coll
    |> map(f)
    |> reduce((acc, x) { concat(acc, x) }, [])
}

empty-test-counter {passed: 0, failed: 0, total: 0}

// Initialize test counters in context
init-test-counters
meta {doc: """Initialize test counters in context. Returns the fresh counters."""}
fn () {
    ::hot::ctx/set("test-counters", {
            assertions: empty-test-counter,
            tests: empty-test-counter,
            current-test: empty-test-counter,
            failed-tests: [],
            failed-assertions: [],
            no-assertion-tests: []
        })
}

get-test-counters
meta {doc: """Get test counters from context, initializing if missing."""}
fn () {
    existing ::hot::ctx/get("test-counters")
    if(existing, existing, init-test-counters())
}

set-test-counters
meta {doc: """Set test counters in context."""}
fn (counters) {
    ::hot::ctx/set("test-counters", counters)
}

// Increment `outcome` (and total) in each of the given counter sections
bump-counters fn (counters, sections: Vec<Str>, outcome: Str) {
    reduce(sections, (acc, section) {
        acc
        |> update-in([section, outcome], add(%, 1))
        |> update-in([section, "total"], add(%, 1))
    }, counters)
}

// Helper to increment a counter in context
assertion-passed
meta {doc: """Increment passed assertion counters."""}
fn () {
    set-test-counters(bump-counters(get-test-counters(), ["assertions", "current-test"], "passed"))
}

assertion-failed
meta {doc: """Increment failed assertion counters."""}
fn () {
    set-test-counters(bump-counters(get-test-counters(), ["assertions", "current-test"], "failed"))
}

assertion-failed-with-details
meta {doc: """Record a failed assertion with test name and description."""}
fn (test-name, assertion-description) {
    assertion-failed()

    counters get-test-counters()

    // Get source location for the current test using IDE-friendly format
    test-source ::hot::meta/source(test-name)
    location-str format-source-location(test-source)

    failed-assertion {
        test: test-name,
        location: location-str,
        assertion: assertion-description
    }

    new-counters {
        ...counters,
        failed-assertions: concat(counters.failed-assertions, [failed-assertion])
    }

    set-test-counters(new-counters)
}

test-passed
meta {doc: """Increment passed test counters."""}
fn () {
    set-test-counters(bump-counters(get-test-counters(), ["tests"], "passed"))
}

test-failed
meta {doc: """Record a failed test and store enhanced name."""}
fn (test-name) {
    // Store enhanced test name with IDE-friendly location format
    location-str format-source-location(::hot::meta/source(test-name))
    enhanced-test-name if(location-str, `${test-name} (${location-str})`, test-name)

    counters bump-counters(get-test-counters(), ["tests"], "failed")
    set-test-counters({
        ...counters,
        failed-tests: concat(counters.failed-tests, [enhanced-test-name])
    })
}

test-made-no-assertions
meta {doc: """Record a passing test that made no assertions."""}
fn (test-name) {
    counters get-test-counters()
    set-test-counters({
        ...counters,
        no-assertion-tests: concat(or(counters.no-assertion-tests, []), [test-name])
    })
}

current-test-reset
meta {doc: """Reset current test counters between tests."""}
fn () {
    counters get-test-counters()
    set-test-counters({...counters, current-test: empty-test-counter})
}

current-test-assertions-passed
meta {doc: """Return true if current test has zero failed assertions."""}
fn () {
    counters get-test-counters()
    is-zero(counters.current-test.failed)
}


assert-expected-got
meta {doc: """Format expected vs actual values."""}
fn (expected, actual) {
    `expected ${expected}, got ${actual}`
}

// Helper function to format source location in IDE-friendly format
format-source-location fn (source-info) {
    cond {
        and(source-info.file, source-info.line, source-info.column) => {
            `${source-info.file}:${source-info.line}:${source-info.column}`
        }

        and(source-info.file, source-info.line) => {
            `${source-info.file}:${source-info.line}`
        }

        source-info.file => {
            source-info.file
        }
        => { null }
    }
}

// Record a failed assertion (with test details when a test is running),
// print the failure line, and return false
record-failure fn (description: Str): Bool {
    current-test-name ::hot::ctx/get("current-test-name")
    cond {
        current-test-name => { assertion-failed-with-details(current-test-name, description) }
        => { assertion-failed() }
    }

    println(`    ${bright-red("✗")} ${description}`)
    false
}

// Test assertion helpers (use these in your test functions)
assert-eq
meta {
    core: true,
    doc: """
    Assert that `expected` equals `actual` (with optional description).

    **Example**

    ```hot
    test-math #["test"] fn () {
        assert-eq(4, add(2, 2), "2 + 2 should equal 4")
        assert-eq([1, 2], [1, 2])  // description auto-generated
    }
    ```
    """
}
fn
(lazy expected: Any, lazy actual: Any): Bool {
    // Evaluate lazy arguments
    expected-val do expected
    actual-val do actual
    assert-eq(expected-val, actual-val, assert-expected-got(expected-val, actual-val))
},
(lazy expected: Any, lazy actual: Any, description: Str): Bool {
    // Evaluate lazy arguments first
    expected-val do expected
    actual-val do actual

    // Check if either argument is an error Result - if so, fail with clear message
    cond {
        is-err(expected-val) => {
            record-failure(`${description}: expected argument returned error: ${err-value(expected-val)}`)
        }

        is-err(actual-val) => {
            record-failure(`${description}: actual argument returned error: ${err-value(actual-val)}`)
        }
        => {
            // Normal comparison
            passed eq(expected-val, actual-val)

            cond {
                passed => {
                    assertion-passed()
                    println(`    ${bright-green("✓")} ${description}`)
                }
                => {
                    record-failure(`${description}: ${assert-expected-got(expected-val, actual-val)}`)
                }
            }

            passed
        }
    }
}

assert
meta {
    core: true,
    doc: """
    Assert that `actual` is truthy (not null, not false, not an error Result).

    **Example**

    ```hot
    test-truthy #["test"] fn () {
        assert(gt(5, 3), "5 should be greater than 3")
        assert(contains("hello", "ell"))
        assert(response.id, "response should have an id")
    }
    ```
    """
}
fn
(lazy actual: Any): Bool {
    actual-val do actual
    assert(actual-val, `expected truthy value, got ${actual-val}`)
},
(lazy actual: Any, description: Str): Bool {
    actual-val do actual
    passed is-truthy(actual-val)

    cond {
        passed => {
            assertion-passed()
            println(`    ${bright-green("✓")} ${description}`)
        }
        => {
            record-failure(`${description}: expected truthy, got ${actual-val}`)
        }
    }

    passed
}

// ---- Clock and delivery ------------------------------------------------------
//
// A `hot test` run has a harness the runner resets before and after each
// test: the clock a test may fix, the events `send` keeps instead of
// publishing, and the schedules `hot:schedule:new` arms. These functions err
// in any other run.

set-now
meta {
    doc: """
    Fix this test's clock at `time`, an RFC 3339 string, `Instant` or
    `ZonedDateTime`, and return it as an `Instant`. `::hot::time/now`,
    `now-zoned` and the other "now" functions return it, in this test and in
    the handlers it delivers to, until the test sets, advances or clears it.
    Each test starts on the real clock.

    **Example**

    ```hot
    ::hot::test/set-now("2026-10-14T09:00:00Z")
    Str(::hot::time/now())  // "2026-10-14T09:00:00Z"
    ```
    """
}
fn (time: Str | ::hot::time/Instant | ::hot::time/ZonedDateTime): ::hot::time/Instant {
    call-lib(::hot::test/set-now, [time])
}

advance
meta {
    doc: """
    Move this test's clock by `duration` and return the new time. Years and
    months have no fixed length, so use weeks, days or smaller units. A zero
    duration is an error, since the clock would not move. A clock the test
    has not fixed is fixed at the real time first.

    **Example**

    ```hot
    ::hot::test/set-now("2026-10-14T09:00:00Z")
    ::hot::test/advance(::hot::time/hours(5))
    Str(::hot::time/now())  // "2026-10-14T14:00:00Z"
    ```
    """
}
fn (duration: ::hot::time/Duration): ::hot::time/Instant {
    call-lib(::hot::test/advance, [duration])
}

clear-now
meta {
    doc: """
    Return this test's clock to the real time.

    **Example**

    ```hot
    ::hot::test/set-now("2026-10-14T09:00:00Z")
    ::hot::test/clear-now()
    ::hot::time/now()  // the real time again
    ```
    """
}
fn (): Null {
    call-lib(::hot::test/clear-now, [])
}

// Stops a delivery or schedule loop that never settles.
max-test-deliveries 10000

// Each `on-event` handler's name by event type, found once per run. The
// harness lists them as the worker registers them, aliases included.
event-handlers fn (): Map {
    found ::hot::ctx/get("test-event-handlers")
    if(found, found, ::hot::ctx/set("test-event-handlers", call-lib(::hot::test/event-handlers, [])))
}

// A contained `cancel()`: the worker records the run as cancelled, not failed
is-cancellation fn (value: Any): Bool {
    or(is-type(value, ::hot::run/Cancellation), is-type(value, ::hot::task/Cancellation))
}

// Run `handler` on `event` as a worker would; a failure is a failed
// assertion, and a cancellation is not
run-handler fn (handler: Str, event: Map): Map {
    result ::hot::internal::exec/contain(handler, [{type: event.type, data: event.data}])
    cond {
        and(is-err(result), not(is-cancellation(err-value(result)))) => {
            record-failure(`${handler} failed on ${event.type}: ${::hot::type/err-message(err-value(result))}`)
        }
        => { null }
    }

    {type: event.type, fn: handler, result}
}

// Deliver one sent event. Schedule events arm and disarm the test's
// schedules, as the scheduler would, a relative time counting from the
// send; any other runs its handlers.
deliver-one fn (event: Map): Vec<Map> {
    cond {
        eq(event.type, "hot:schedule:new") => {
            sent-at get(event, "sent-at")
            armed call-lib(::hot::test/arm-schedule, [event.data, sent-at])
            cond {
                is-err(armed) => { record-failure(`hot:schedule:new: ${err-value(armed)}`) }
                => { null }
            }

            []
        }

        eq(event.type, "hot:schedule:cancel") => {
            cancelled call-lib(::hot::test/cancel-schedule, [event.data])
            cond {
                is-err(cancelled) => { record-failure(`hot:schedule:cancel: ${err-value(cancelled)}`) }
                => { null }
            }

            []
        }
        => { map(get(event-handlers(), event.type, []), run-handler(%, event)) }
    }
}

// Deliver the sent events, oldest first, then what their handlers send,
// until nothing is left, and return how many were delivered. Each run goes
// to the harness's run log, which the caller takes once.
deliver-sent fn (delivered: Int): Int {
    pending call-lib(::hot::test/take-sent, [])
    cond {
        is-empty(pending) => { delivered }

        gt(add(delivered, length(pending)), max-test-deliveries) => {
            record-failure(`deliver stopped after ${max-test-deliveries} events: handlers keep sending events`)
            delivered
        }
        => {
            // Bound first: call-lib evaluates a call in its arguments twice
            for-each(pending, (event) {
                runs deliver-one(event)
                call-lib(::hot::test/record-runs, [runs])
            })
            deliver-sent(add(delivered, length(pending)))
        }
    }
}

deliver
meta {
    doc: """
    Deliver `event`, a map with `type` and `data`, to its `on-event`
    handlers, run inside this test; then deliver the events they send, until
    none is left. With no argument, deliver the events sent so far.

    In a test, `send` keeps an event instead of publishing it, and nothing
    runs until the test delivers it. A delivered `hot:schedule:new` arms a
    schedule for `run-due`, with a relative time such as `"in 1 day"`
    counted from when it was sent, and `hot:schedule:cancel` disarms. A
    handler that fails counts as a failed assertion; one that cancels does
    not, and the other handlers still run. Retries do not apply. Returns one
    `{type, fn, result}` per handler run.

    **Example**

    ```hot
    runs ::hot::test/deliver({type: "order:placed", data: {id: "o-1"}})
    assert-eq(["::shop::orders/on-placed"], map(runs, %.fn))
    ```
    """
}
fn
(): Vec<Map> {
    deliver-sent(0)
    call-lib(::hot::test/take-runs, [])
},
(event: Map): Vec<Map> {
    // Outside a test, `send` would publish the event, and its real
    // handlers would run, before delivery failed.
    cond {
        call-lib(::hot::test/in-test-run, []) => {
            send(event.type, event.data)
            deliver()
        }
        => { err("::hot::test/deliver works only in a `hot test` run") }
    }
}

// Call a due schedule's function as the scheduler would; a failure is a
// failed assertion, and a cancellation is not
run-scheduled fn (due: Map): Map {
    result ::hot::internal::exec/contain(due.fn, due.args)
    cond {
        and(is-err(result), not(is-cancellation(err-value(result)))) => {
            record-failure(`scheduled ${due.fn} failed: ${::hot::type/err-message(err-value(result))}`)
        }
        => { null }
    }

    {type: "hot:schedule", fn: due.fn, at: due.at, result}
}

// Fire schedules due by `until`, soonest first, each at its due time, and
// return how many fired; `fixed` is the clock to return to afterwards (null
// for the real time). Runs go to the harness's run log.
fire-due fn (until: ::hot::time/Instant, fixed: ::hot::time/Instant?, fired: Int): Int {
    due call-lib(::hot::test/take-due, [until])
    cond {
        is-null(due) => { fired }

        gte(fired, max-test-deliveries) => {
            record-failure(`run-due stopped after ${max-test-deliveries} scheduled calls`)
            fired
        }
        => {
            set-now(due.at)
            called run-scheduled(due)
            call-lib(::hot::test/record-runs, [[called]])
            deliver-sent(0)
            if(is-null(fixed), clear-now(), set-now(fixed))
            fire-due(until, fixed, add(fired, 1))
        }
    }
}

run-due
meta {
    doc: """
    Fire each armed schedule due by this test's clock, soonest first, and
    deliver the events it sends. Each call runs with the clock at its due
    time, as the scheduler would have run it; afterwards the clock is back
    where the test left it. A recurring schedule fires once for each
    occurrence that is due. A call that fails counts as a failed assertion.
    Returns one `{type, fn, result}` per call and handler run; a scheduled
    call has type `"hot:schedule"` and its due time in `at`.

    `run-due` first delivers the events sent so far, so a schedule sent
    before the clock moved is armed from the time it was sent.

    **Example**

    ```hot
    ::hot::test/set-now("2026-10-14T09:00:00Z")
    send("hot:schedule:new", {fn: "::app::steps/check-due", args: ["s-1"], schedule: "in 1 day"})
    ::hot::test/advance(::hot::time/days(2))
    ::hot::test/run-due()  // calls check-due("s-1") at 2026-10-15T09:00:00Z
    ```
    """
}
fn (): Vec<Map> {
    deliver-sent(0)
    fire-due(::hot::time/now(), call-lib(::hot::test/fixed-now, []), 0)
    call-lib(::hot::test/take-runs, [])
}

schedules
meta {
    doc: """
    The schedules armed in this test and not yet fired, soonest first, each
    `{id, fn, args, at}`.

    **Example**

    ```hot
    ::hot::test/deliver()
    first(::hot::test/schedules()).fn  // "::app::steps/check-due"
    ```
    """
}
fn (): Vec<Map> {
    call-lib(::hot::test/schedules, [])
}

print-test-header
meta {doc: """Print header for the test run and record start time."""}
fn (tests) {
    println(`${red("hot test runner")}`)
    // Use the imported length function instead of direct hotlib call
    test-count length(tests)
    println(`\nrunning ${test-count} tests\n`)
    // Record start time (epoch millis) for total duration measurement
    start-ms ::hot::time/epoch-millis(::hot::time/now())
    ::hot::ctx/set("test-run-start-ms", start-ms)
}

call-with-capture
meta {
    doc: """Call function `f` with stdout capture, discarding captured output. Halts (fail()/runtime errors) are contained and returned as an Err so one test cannot abort the run."""
}
fn (f) {
    stdout ::hot::io/capture-stdout()
    result ::hot::internal::exec/contain(f)

    // Discard captured content instead of releasing it
    // This prevents the output from being displayed while maintaining stream redirection
    ::hot::io/discard(stdout)
    result
}

run-test
meta {
    core: true,
    doc: """
    Run a single test function with optional output capture.

    **Example**

    ```hot
    // Typically called by run-tests, not directly
    run-test(my-test-fn, true)  // true = capture output
    ```
    """
}
fn (f, capture-output) {
    current-test-reset()
    call-lib(::hot::test/reset, [])

    // Ensure f is a string (convert function reference to string if needed)
    f-str Str(f)

    // Set current test name in context for assertion tracking
    ::hot::ctx/set("current-test-name", f-str)

    cond {
        capture-output => { print(`${pad-end(f-str, 54)} ... `) }
        => { println(`${pad-end(f-str, 58)} ...`) }
    }

    // Contain halts at the per-test boundary: a fail() or hard runtime
    // error inside one test surfaces as that test's Err result instead of
    // aborting the whole run.
    result cond {
        capture-output => { call-with-capture(f-str) }
        => { ::hot::internal::exec/contain(f-str, []) }
    }

    // The next test, and the summary's duration, start on the real clock
    call-lib(::hot::test/reset, [])

    // Check if test had any execution errors (real engine/compiler errors)
    test-had-execution-error is-err(result)
    did-pass cond {
        test-had-execution-error => {
        // For actual execution errors, print the error details. Contained
        // halts carry a structured payload (a map with msg, or a typed
        // Failure); err-message understands both and falls back to the
        // string form.
        message ::hot::type/err-message(err-value(result))

        println(`    ${::hot::term/bright-red("✗")} Test execution error: ${message}`)
        false
    }
        => {
        current-test-assertions-passed()
    }
    }

    // Update test counters
    cond {
        did-pass => {
        test-passed()
        // A test with no assertions passes without checking anything, which
        // usually means a mistake such as `assert (…)`, a binding, not a call.
        cond {
            is-zero(get-test-counters().current-test.total) => { test-made-no-assertions(f-str) }
            => { false }
        }

        cond {
            capture-output => { println(`${bright-green(pad-start("ok", 4))}`) }
            => { println(`... ${bright-green(pad-start("ok", 48))}\n`) }
        }
    }
        => {
        test-failed(f-str)
        cond {
            capture-output => { println(`${::hot::term/bright-red(pad-start("fail", 4))}`) }
            => { println(`... ${::hot::term/bright-red(pad-start("fail", 48))}`) }
        }
    }
    }

    did-pass
}

// Print summary of test results
print-test-summary
meta {doc: """Print a summary of test results including failures and duration."""}
fn () {
    counters get-test-counters()
    tests-total counters.tests.total
    tests-passed counters.tests.passed
    tests-failed counters.tests.failed
    assertions-total counters.assertions.total
    assertions-passed counters.assertions.passed
    assertions-failed counters.assertions.failed
    failed-tests counters.failed-tests
    failed-assertions counters.failed-assertions

    // Print failed tests and detailed assertion failures if any
    cond {
        gt(tests-failed, 0) => {
            println(`\nfailed tests:\n`)
            map(failed-tests, println(`  ${::hot::term/bright-red(%)}`))

            // Print detailed assertion failures if we have them
            cond {
                not(is-empty(failed-assertions)) => {
                    println(`\nfailed assertions:\n`)
                    map(failed-assertions, (assertion-failure) {
                            // Display in IDE-friendly format: test-name at file:line:column
                            location-display cond {
                                assertion-failure.location => { ` at ${assertion-failure.location}` }
                                => { "" }
                            }

                            println(`  ${::hot::term/bright-red(assertion-failure.test)}${location-display}`)
                            println(`    ${assertion-failure.assertion}`)
                            println("")
                        })
                }
                => { false }
            }
        }
        => { false }
    }

    cond {
        is-zero(tests-failed) => {
            print(`\nassertions: `)
            print(`${bright-green(pad-start(Str(assertions-passed), 6))} ${bright-green("passed")}`)
            print(`${pad-start(Str(assertions-failed), 6)} ${white("failed")}`)
            println(`${pad-start(Str(assertions-total), 9)} total`)
            print(`     tests: `)
            print(`${bright-green(pad-start(Str(tests-passed), 6))} ${bright-green("passed")}`)
            print(`${pad-start(Str(tests-failed), 6)} ${white("failed")}`)
            println(`${pad-start(Str(tests-total), 9)} total`)
        }
        => {
            print(`\nassertions:`)
            print(`${pad-start(Str(assertions-passed), 6)} ${white("passed")}`)
            print(`${::hot::term/bright-red(pad-start(Str(assertions-failed), 6))} ${::hot::term/bright-red("failed")}`)
            println(`${pad-start(Str(assertions-total), 9)} total`)
            print(`     tests:`)
            print(`${pad-start(Str(tests-passed), 6)} ${white("passed")}`)
            print(`${::hot::term/bright-red(pad-start(Str(tests-failed), 6))} ${::hot::term/bright-red("failed")}`)
            println(`${pad-start(Str(tests-total), 9)} total`)
        }
    }

    no-assertion-tests or(counters.no-assertion-tests, [])
    cond {
        not(is-empty(no-assertion-tests)) => {
            println(`\n${bright-yellow("warning:")} ${length(no-assertion-tests)} tests made no assertions:`)
            map(no-assertion-tests, println(`  ${bright-yellow(%)}`))
        }
        => { false }
    }

    cond {
        is-zero(tests-total) => { println(`\n${bright-yellow("no tests ran.\n")}`) }
        is-zero(tests-failed) => { println(`\n${bright-green("all tests passed!\n")}`) }
        => { println(`\n${::hot::term/bright-red(tests-failed)} tests failed.\n`) }
    }

    // Print total duration
    end-ms ::hot::time/epoch-millis(::hot::time/now())
    start-ms ::hot::ctx/get("test-run-start-ms")
    cond {
        start-ms => { println(`duration: ${::hot::math/div(::hot::math/sub(end-ms, start-ms), 1000)}s`) }
        => { false }
    }

}

is-test
meta {
    doc: """
    Return true if function `f` is marked as a test via metadata.

    **Example**

    ```hot
    my-test #["test"] fn () { assert(true) }
    other-fn fn () { "not a test" }

    is-test(my-test)   // true
    is-test(other-fn)  // false
    ```
    """
}
fn (f) {
    // Use the Rust hotlib implementation to avoid variable scoping issues
    call-lib(::hot::test/is-test, [f])
}

print-no-tests-warning
meta {
    doc: """
    Notice that discovery found nothing.

    A run that exercised zero tests proved nothing, and reporting it as
    success launders every possible discovery failure — wrong test.paths, a
    pattern that matches nothing, a stale compile cache dropping test
    namespaces — into a green build. The runner returns a distinct sentinel,
    and the CLI decides whether to fail or honor test.allow-empty.
    """
}
fn (pattern) {
    println("")
    println(`${bright-yellow("! zero tests were discovered — nothing ran")}`)
    cond {
        is-null(pattern) => { null }
        => { println(`  the pattern "${pattern}" matched no tests`) }
    }

    println("  If this project should contain tests, discovery failed and this run proved nothing.")
    println("  Check test.paths for the project; a stale build cache can also drop")
    println("  test namespaces silently — touch a source file and re-run.")
    println("  To permit empty runs: set hot.project.<name>.test.allow-empty true")
    println("")
}

all-tests-passed
meta {doc: """Return true if all tests passed - helper to avoid scoping issues."""}
fn () {
    counters get-test-counters()
    tests-failed counters.tests.failed
    is-zero(tests-failed)
}

run-tests
meta {
    doc: """
    Discover and run all test functions; return true if all passed.

    **Example**

    ```hot
    // Run all tests with output capture
    run-tests(true)

    // Run all tests showing full output
    run-tests(false)
    ```
    """
}
fn (capture-output) {
    init-test-counters()
    ::hot::ctx/set("test-capture-output", capture-output)

    test-results namespaces()
    |> test-runner-mapcat(functions-in-namespace(%))
    |> filter(is-test(%))
    |> (tests) { print-test-header(tests) tests}
    |> map(run-test(%, ::hot::ctx/get("test-capture-output")))

    print-test-summary()

    // A failure in the runner machinery itself (not inside a test) must
    // fail the run loudly — a silent early exit here would report green
    // for tests that never ran.
    cond {
        is-err(test-results) => {
            println(`${::hot::term/bright-red("✗")} Test runner failed: ${err-value(test-results)}`)
            false
        }
        => {
            final-counters get-test-counters()
            cond {
                // Zero discovered is not a pass. Return a distinct sentinel —
                // not `false` — so the CLI can tell "tests failed" apart from
                // "nothing ran" and exit accordingly.
                is-zero(final-counters.tests.total) => {
                    print-no-tests-warning(null)
                    "no-tests-discovered"
                }
                => { is-zero(final-counters.tests.failed) }
            }
        }
    }
}

run-matching-tests
meta {
    doc: """
    Run tests whose names contain `pattern`; return true if all passed.

    **Example**

    ```hot
    // Run only tests with "math" in the name
    run-matching-tests("math", true)

    // Run tests matching "coll" with full output
    run-matching-tests("coll", false)
    ```
    """
}
fn (pattern, capture-output) {
    init-test-counters()
    ::hot::ctx/set("test-capture-output", capture-output)

    test-results namespaces()
    |> test-runner-mapcat(functions-in-namespace(%))
    |> filter(and(is-test(%), contains(`${%}`, pattern)))
    |> (tests) { print-test-header(tests) tests}
    |> map(run-test(%, ::hot::ctx/get("test-capture-output")))

    print-test-summary()

    // A failure in the runner machinery itself (not inside a test) must
    // fail the run loudly — a silent early exit here would report green
    // for tests that never ran.
    cond {
        is-err(test-results) => {
            println(`${::hot::term/bright-red("✗")} Test runner failed: ${err-value(test-results)}`)
            false
        }
        => {
            final-counters get-test-counters()
            cond {
                is-zero(final-counters.tests.total) => {
                    print-no-tests-warning(pattern)
                    "no-tests-discovered"
                }
                => { is-zero(final-counters.tests.failed) }
            }
        }
    }
}
