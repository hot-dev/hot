::ofac::integration::ctx ns

::env ::hot::env

// Live smoke tests read the public SLS file listing and the small
// Consolidated list, so they only run when OFAC_LIVE=1.

live
meta {doc: """True when OFAC_LIVE=1: the live tests may run."""}
fn (): Bool {
    eq(::env/get("OFAC_LIVE", ""), "1")
}

skip
meta {doc: """Record a skip and pass."""}
fn (why: Str): Bool {
    println(`ofac integration: ${why} - skipping`)
    assert(true, `skipped: ${why}`)
}
