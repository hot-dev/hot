}

create-guild-emoji
meta {
    doc: """
    POST /guilds/{guild_id}/emojis - Create a custom emoji. `image` is a
    data URI (max 256 KiB); `roles` limits who may use it. Needs
    CREATE_GUILD_EXPRESSIONS.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    emoji ::guilds/create-guild-emoji(::guilds/CreateGuildEmojiRequest({
      guild_id: "1000000000000000000",
      name: "shipit",
      image: `data:image/png;base64,${::hot::base64/encode(::hot::file/read-file-bytes("shipit.png"))}`
    }))
    emoji.id
    ```
    """
}
fn
(request: CreateGuildEmojiRequest): Map {
  create-guild-emoji(request, {})
},
(request: CreateGuildEmojiRequest, opts: Map): Map {
  ::api/call("POST", `/guilds/${seg(request.guild_id)}/emojis`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  }, opts)
}

