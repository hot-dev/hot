::cloudflare::r2 ns
meta {
    doc: """
    R2 bucket management over the Cloudflare API: list, create, get, and
    delete buckets. Object reads and writes use R2's S3-compatible API —
    use the `aws-s3` package against
    `https://{account_id}.r2.cloudflarestorage.com` (region `auto`) with an
    R2 access key pair.
    """,
    ctx: {"cloudflare.token": {required: false}, "cloudflare.account.id": {required: false, secret: false}}
}

::api ::cloudflare::api

ListPage ::cloudflare::api/ListPage

bucket-suffix
meta {no-doc: true}
fn (name: Str): Str {
  `/r2/buckets/${::api/seg(name)}`
}

jurisdiction-headers
meta {
    doc: """
    The `cf-r2-jurisdiction` header for a jurisdiction (`"eu"`, `"fedramp"`,
    …), or no header for null/`"default"`. Exposed for testing.

    **Example**

    ```hot
    ::cloudflare::r2/jurisdiction-headers("eu")  // {cf-r2-jurisdiction: "eu"}
    ::cloudflare::r2/jurisdiction-headers("default")  // {}
    ```
    """
}
fn (jurisdiction: Str?): Map {
  cond {
    is-null(jurisdiction) => { {} }
    eq(jurisdiction, "default") => { {} }
    => { {cf-r2-jurisdiction: jurisdiction} }
  }
}

send-json
meta {no-doc: true}
fn (method: Str, suffix: Str, body: Any, jurisdiction: Str?, opts: Map): Any {
  path ::api/account-path(suffix, opts)
  headers jurisdiction-headers(jurisdiction)
  cond {
    is-err(path) => { path }
    => {
      response cond {
        eq(body, "") => { ::api/send(method, path, headers, "", opts) }
        => { ::api/send(method, path, {...headers, Content-Type: "application/json"}, to-json(untype(body)), opts) }
      }

      cond {
        is-err(response) => { response }
        => { or(response.body, {}) }
      }
    }
  }
}

list-buckets
meta {
    doc: """
    GET /accounts/{account_id}/r2/buckets - One page of buckets.
    `params`: `name_contains`, `start_after`, `per_page` (1–1000),
    `cursor`, `order` (`name`), `direction`, and `jurisdiction` (sent as
    the `cf-r2-jurisdiction` header). Returns a `ListPage` whose `result`
    is the bucket list.

    **Example**

    ```hot
    page ::cloudflare::r2/list-buckets({name_contains: "export", per_page: 100})
    map(page.result, %.name)

    // EU buckets
    ::cloudflare::r2/list-buckets({jurisdiction: "eu"})
    ```
    """
}
fn
(): ListPage {
  list-buckets({})
},
(params: Map): ListPage {
  list-buckets(params, {})
},
(params: Map, opts: Map): ListPage {
  jurisdiction get(params, "jurisdiction")
  query-params filter-keys(params, (k) { ne(k, "jurisdiction") })
  envelope send-json("GET", `/r2/buckets${::api/query(query-params)}`, "", jurisdiction, opts)
  cond {
    is-err(envelope) => { envelope }
    => { ::api/to-page(envelope, "buckets") }
  }
}

list-all-buckets
meta {
    doc: """
    Every bucket matching `params`, following cursors up to `max` buckets
    (default 10000).

    **Example**

    ```hot
    map(::cloudflare::r2/list-all-buckets({name_contains: "export"}, 500), %.name)
    ```
    """
}
fn
(): Vec {
  list-all-buckets({})
},
(params: Map): Vec {
  list-all-buckets(params, ::api/DEFAULT_MAX_ITEMS)
},
(params: Map, max: Int): Vec {
  list-all-buckets(params, max, {})
},
(params: Map, opts: Map): Vec {
  list-all-buckets(params, ::api/DEFAULT_MAX_ITEMS, opts)
},
(params: Map, max: Int, opts: Map): Vec {
  ::api/collect-cursor((p) { list-buckets(p, opts) }, {per_page: 1000, ...params}, max)
}

create-bucket-body
meta {
    doc: """
    The create body: `{name, locationHint?, storageClass?}` from `options`
    (`location_hint`/`locationHint`, `storage_class`/`storageClass`).
    Exposed for testing.

    **Example**

    ```hot
    ::cloudflare::r2/create-bucket-body("exports", {location_hint: "enam"})  // {name: "exports", locationHint: "enam"}
    ```
    """
}
fn
(name: Str, options: Map): Map {
  {name: name}
    |> assoc-some("locationHint", or(get(options, "locationHint"), get(options, "location_hint")))
    |> assoc-some("storageClass", or(get(options, "storageClass"), get(options, "storage_class")))
}

create-bucket
meta {
    doc: """
    POST /accounts/{account_id}/r2/buckets - Create a bucket. `options`:
    `location_hint` (`apac`, `eeur`, `enam`, `weur`, `wnam`, `oc`),
    `storage_class` (`Standard`, `InfrequentAccess`), `jurisdiction`.

    **Example**

    ```hot
    ::cloudflare::r2/create-bucket("exports", {location_hint: "enam"})
    ```
    """
}
fn
(name: Str): Map {
  create-bucket(name, {})
},
(name: Str, options: Map): Map {
  create-bucket(name, options, {})
},
(name: Str, options: Map, opts: Map): Map {
  envelope send-json("POST", "/r2/buckets", create-bucket-body(name, options), get(options, "jurisdiction"), opts)
  cond {
    is-err(envelope) => { envelope }
    => { get(envelope, "result") }
  }
}

get-bucket
meta {
    doc: """
    GET /accounts/{account_id}/r2/buckets/{name} - One bucket: `{name,
    creation_date, location, storage_class, jurisdiction}`.

    **Example**

    ```hot
    bucket ::cloudflare::r2/get-bucket("exports")
    bucket.location

    ::cloudflare::r2/get-bucket("eu-exports", "eu")
    ```
    """
}
fn
(name: Str): Map {
  get-bucket(name, null)
},
(name: Str, jurisdiction: Str?): Map {
  get-bucket(name, jurisdiction, {})
},
(name: Str, opts: Map): Map {
  get-bucket(name, null, opts)
},
(name: Str, jurisdiction: Str?, opts: Map): Map {
  envelope send-json("GET", bucket-suffix(name), "", jurisdiction, opts)
  cond {
    is-err(envelope) => { envelope }
    => { get(envelope, "result") }
  }
}

delete-bucket
meta {
    doc: """
    DELETE /accounts/{account_id}/r2/buckets/{name} - Delete an empty bucket
    (R2 refuses a bucket that still holds objects).

    **Example**

    ```hot
    ::cloudflare::r2/delete-bucket("exports")
    ```
    """
}
fn
(name: Str): Any {
  delete-bucket(name, null)
},
(name: Str, jurisdiction: Str?): Any {
  delete-bucket(name, jurisdiction, {})
},
(name: Str, opts: Map): Any {
  delete-bucket(name, null, opts)
},
(name: Str, jurisdiction: Str?, opts: Map): Any {
  envelope send-json("DELETE", bucket-suffix(name), "", jurisdiction, opts)
  cond {
    is-err(envelope) => { envelope }
    => { get(envelope, "result") }
  }
}

s3-endpoint
meta {
    doc: """
    The S3-compatible endpoint for object I/O with `aws-s3`:
    `https://{account_id}.r2.cloudflarestorage.com` (`.eu.` / `.fedramp.`
    inserted for those jurisdictions).

    **Example**

    ```hot
    ::cloudflare::r2/s3-endpoint("acc123")  // "https://acc123.r2.cloudflarestorage.com"
    ::cloudflare::r2/s3-endpoint("acc123", "eu")  // "https://acc123.eu.r2.cloudflarestorage.com"
    ```
    """
}
fn
(account-id: Str): Str {
  s3-endpoint(account-id, null)
},
(account-id: Str, jurisdiction: Str?): Str {
  cond {
    is-null(jurisdiction) => { `https://${account-id}.r2.cloudflarestorage.com` }
    eq(jurisdiction, "default") => { `https://${account-id}.r2.cloudflarestorage.com` }
    => { `https://${account-id}.${jurisdiction}.r2.cloudflarestorage.com` }
  }
}
