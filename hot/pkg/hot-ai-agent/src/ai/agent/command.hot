::ai::agent::command ns
meta {
    doc: """
    Command helpers for chat-style agents.

    This module intentionally keeps command execution policy out of the
    primitive parser. Concrete agents decide whether a command replies
    inline, emits an event, calls a handler directly, or streams.
    """
}

Command
meta { doc: "Declarative command metadata for docs, help text, and dispatch tables." }
type {
    name: Str,
    aliases: Vec<Str>?,
    description: Str?,
    usage: Str?,
    route: Str?,
    is-async: Bool?,
    handler: Fn?,
    meta: Map?,
}

ParsedCommand
meta { doc: "Result of parsing a slash-style command from text." }
type {
    is-command: Bool,
    name: Str,
    arg: Str,
    raw: Str,
}

strip-bot-suffix
meta {no-doc: true}
fn (token: Str): Str {
    parts split(token, "@")
    first(parts)
}

parse
meta {
    doc: """
    Parse `/command rest of text` into `{is-command, name, arg, raw}`.
    The leading slash is removed, the command name is lowercased, and
    bot suffixes like `/ask@MyBot` become `ask`.

    **Example**

    ```hot
    ::command ::ai::agent::command

    parsed ::command/parse("/Ask@MyBot what now?")
    parsed.name  // "ask"
    parsed.arg  // "what now?"
    ::command/parse("hello").is-command  // false
    ```
    """
}
fn (text: Str): ParsedCommand {
    cleaned trim(or(text, ""))
    cond {
        not(starts-with(cleaned, "/")) => {
            ParsedCommand({
                is-command: false,
                name: "",
                arg: cleaned,
                raw: cleaned,
            })
        }
        => {
            parts split(cleaned, " ")
            token first(parts)
            without-slash slice(token, 1)
            name lowercase(strip-bot-suffix(without-slash))
            arg cond {
                lte(length(parts), 1) => { "" }
                => { parts |> rest |> join(" ") |> trim }
            }

            ParsedCommand({
                is-command: true,
                name: name,
                arg: arg,
                raw: cleaned,
            })
        }
    }
}

arg
meta {
    doc: """
    Return only the parsed command argument.

    **Example**

    ```hot
    ::ai::agent::command/arg("/remind tomorrow 9am")  // "tomorrow 9am"
    ```
    """
}
fn (text: Str): Str {
    parse(text).arg
}

matches
meta {
    doc: """
    True when parsed command `parsed` matches a command's name or aliases.

    **Example**

    ```hot
    ::command ::ai::agent::command

    cmd ::command/Command({name: "memory", aliases: ["mem"]})
    ::command/matches(::command/parse("/mem"), cmd)  // true
    ::command/matches(::command/parse("/forget"), cmd)  // false
    ```
    """
}
fn (parsed: ParsedCommand, command: Command): Bool {
    aliases or(command.aliases, [])
    or(eq(parsed.name, command.name), in(parsed.name, aliases))
}

find
meta {
    doc: """
    Find the first command matching parsed input, or null.

    **Example**

    ```hot
    ::command ::ai::agent::command

    commands [::command/Command({name: "help", aliases: ["h"]}), ::command/Command({name: "why"})]
    ::command/find(commands, ::command/parse("/h")).name  // "help"
    ::command/find(commands, ::command/parse("/nope"))  // null
    ```
    """
}
fn (commands: Vec<Command>, parsed: ParsedCommand): Command? {
    find-first(commands, (cmd) { matches(parsed, cmd) })
}

usage-line
meta {
    doc: """
    Render one command as a concise help line.

    **Example**

    ```hot
    ::command ::ai::agent::command

    ::command/usage-line(::command/Command({name: "why"}))  // "/why"
    ::command/usage-line(::command/Command({name: "why", description: "Explain the last answer."}))  // "/why — Explain the last answer."
    ```
    """
}
fn (command: Command): Str {
    usage or(command.usage, concat("/", command.name))
    desc or(command.description, "")
    cond {
        is-empty(desc) => { usage }
        => { `${usage} — ${desc}` }
    }
}
