::ai::agent::callbacks ns
meta {
    doc: """
    Outbound callback support for queued / asynchronous agent replies.

    The standard agent webhook contract has three reply modes:

    1. **`response`** — the agent computed an answer synchronously and
       returns it in the HTTP response.
    2. **`queued`** — the agent kicked off async work (memory recall,
       LLM call) and returns a placeholder. The transport client is
       expected to listen on the Hot run stream for the eventual
       answer, or...
    3. **`callback`** — same as `queued`, but the agent commits to
       POSTing the final answer to a `callback_url` provided by the
       caller. This is the right shape for Slack / Telegram / Discord
       integrations that don't speak Hot's run stream natively.

    This module is the agent-side helper for mode 3.

    Surface

    - `CallbackOptions` — `{url, signing-secret-env?, signing-header?,
       timeout-ms?, headers?}`.
    - `post-callback(payload, opts)` — POST `payload` (JSON-encoded)
       to an HTTPS `opts.url`, attaching an HMAC signature header when
       a signing secret is configured. Returns
       `{ok, status, error?, attempt-ms}`.
    - `from-body(body)` — extract a `CallbackOptions` from the
       webhook body's `callback_url` field, returning `null` when no
       callback was requested. `from-body(body, signing-secret-env)`
       also signs with the named env var. That name comes from your
       code, never from the body.

    Transports that want callback parity should:

    1. Pull a `CallbackOptions` from the inbound body via `from-body`.
    2. Reply synchronously with `mode: "queued"` and `callback: true`.
    3. Once the async work finishes, call `post-callback(answer, opts)`.
    """
}

::http ::hot::http
::hmac ::hot::hmac
::env  ::hot::env
::json ::hot::json
::time ::hot::time
::regex ::hot::regex

// A canonical dotted-quad IPv4 address.
IPV4_ADDRESS "^((25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])[.]){3}(25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9]?[0-9])$"

// IPv4 ranges that are not publicly routable: this network, RFC1918, CGNAT,
// loopback, link-local, IETF and documentation blocks, benchmarking,
// multicast and reserved.
NON_PUBLIC_IPV4 [
    "^(0|10|127)[.]",
    "^100[.](6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])[.]",
    "^169[.]254[.]",
    "^172[.](1[6-9]|2[0-9]|3[01])[.]",
    "^192[.]0[.][02][.]",
    "^192[.]88[.]99[.]",
    "^192[.]168[.]",
    "^198[.](1[89]|51[.]100)[.]",
    "^203[.]0[.]113[.]",
    "^(22[4-9]|2[3-5][0-9])[.]",
]

// Top-level labels used for names that only resolve inside a network.
INTERNAL_TLDS ["localhost", "local", "internal", "intranet", "lan", "home", "corp", "svc", "arpa"]

CallbackOptions
meta {
    doc: """
    Configuration for a callback POST.

    - `url` — destination URL.
    - `signing-secret-env` — env var holding the HMAC secret used to
      sign the JSON body.
    - `signing-secret` — literal secret (rare; prefer env).
    - `signing-header` — header name for the signature. Defaults to
      `x-hot-signature`. The value is `"sha256=<hex>"`.
    - `headers` — extra headers to send.
    - `timeout-ms` — reserved (HTTP timeout — currently advisory).
    """
}
type {
    url: Str,
    signing-secret-env: Str?,
    signing-secret: Str?,
    signing-header: Str?,
    headers: Map?,
    timeout-ms: Int?,
}

CallbackResult
meta {
    doc: """
    Outcome of a callback POST.

    - `ok` — true when the upstream returned a 2xx status.
    - `status` — HTTP status code (or `0` when the call never reached
      the server).
    - `error` — human-readable error string on failure.
    - `attempt-ms` — wall-clock time spent on the attempt.
    """
}
type {
    ok: Bool,
    status: Int,
    error: Str?,
    attempt-ms: Int,
}

resolve-secret
meta {
    no-doc: true,
    doc: "Internal: resolve a literal-or-env signing secret. Returns `null` when neither is set."
}
fn (literal: Str?, env-name: Str?): Str? {
    cond {
        not(is-null(literal)) => { literal }
        not(is-null(env-name)) => {
            v ::env/get(env-name, null)
            if(is-empty(or(v, "")), null, v)
        }
        => { null }
    }
}

build-headers
meta {
    no-doc: true,
    doc: "Internal: assemble the headers dictionary for a callback POST. Adds the signature header when a secret is configured."
}
fn (body-text: Str, opts: CallbackOptions): Map {
    base or(opts.headers, {})
    with-content-type assoc(base, "content-type", "application/json")
    secret resolve-secret(opts.signing-secret, opts.signing-secret-env)
    cond {
        is-null(secret) => { with-content-type }
        => {
            sig ::hmac/hmac-sha256(secret, body-text)
            header-name lowercase(or(opts.signing-header, "x-hot-signature"))
            assoc(with-content-type, header-name, `sha256=${sig}`)
        }
    }
}

is-url-allowed
meta {
    doc: """
    Return true when a callback URL is safe for the shared helper to
    call. The default policy is intentionally narrow, so untrusted
    webhook bodies cannot direct the worker at internal services.
    Callbacks must be HTTPS, carry no `user@` part or backslash, and name a public
    host: a dotted DNS name outside internal suffixes like `.internal`,
    or a publicly routable IPv4 address. IPv6 literals and numeric
    spellings of IPv4 (`2130706433`, `0x7f.0.0.1`, `127.1`) are refused.

    This checks the URL only. A public name that resolves to a private
    address still passes, so network egress rules remain the real
    boundary for workers that can reach internal services.

    **Example**

    ```hot
    ::callbacks ::ai::agent::callbacks

    ::callbacks/is-url-allowed("https://example.com/hook")  // true
    ::callbacks/is-url-allowed("http://example.com/hook")  // false
    ::callbacks/is-url-allowed("https://10.0.0.5/hook")  // false
    ::callbacks/is-url-allowed("https://x@127.0.0.1/hook")  // false
    ```
    """
}
fn (url: Str?): Bool {
    u lowercase(or(url, ""))
    cond {
        not(starts-with(u, "https://")) => { false }
        contains(u, "\\") => { false }
        => { not(is-private-callback-host(callback-host(u))) }
    }
}

callback-host
meta {
    no-doc: true,
    doc: "Internal: host of an already-lowercased HTTPS URL, or an empty string when the URL has a `user@` part."
}
fn (url: Str): Str {
    authority slice(url, length("https://"))
        |> replace("?", "/")
        |> replace("#", "/")
        |> split("/")
        |> first()
    if(contains(authority, "@"), "", first(split(authority, ":")))
}

is-private-callback-host
meta {
    no-doc: true,
    doc: "Internal: true unless `host` is a dotted DNS name with a public suffix or a publicly routable IPv4 address. Anything else is refused, including percent-encoded and non-ASCII spellings that a URL parser would normalize."
}
fn (host: Str): Bool {
    name if(ends-with(host, "."), slice(host, 0, sub(length(host), 1)), host)
    tld last(split(name, "."))
    cond {
        not(::regex/is-match(name, "^[a-z0-9_-]+([.][a-z0-9_-]+)+$")) => { true }
        ::regex/is-match(tld, "^([0-9]+|0x[0-9a-f]*)$") => {
            or(not(::regex/is-match(name, IPV4_ADDRESS)), some(NON_PUBLIC_IPV4, ::regex/is-match(name, %)))
        }
        => { in(tld, INTERNAL_TLDS) }
    }
}

post-callback
meta {
    doc: """
    POST `payload` to `opts.url` as JSON, optionally signing the body
    with HMAC-SHA256. Returns a `CallbackResult` capturing status and
    elapsed time so the agent can log / retry.

    `payload` may be any value — it's wrapped through
    `::hot::json/to-json` before transmission.

    **Example**

    ```hot
    ::callbacks ::ai::agent::callbacks

    opts ::callbacks/CallbackOptions({
        url: "https://example.com/agent/callback",
        signing-secret-env: "AGENT_CALLBACK_SECRET",
    })
    result ::callbacks/post-callback({text: "Done."}, opts)
    if(result.ok, `delivered in ${result.attempt-ms}ms`, result.error)
    ```
    """
}
fn (payload: Any, opts: CallbackOptions?): CallbackResult {
    cond {
        is-null(opts) => { CallbackResult({ok: false, status: 0, error: "no-callback-options", attempt-ms: 0}) }
        is-empty(or(opts.url, "")) => { CallbackResult({ok: false, status: 0, error: "no-callback-url", attempt-ms: 0}) }
        not(is-url-allowed(opts.url)) => { CallbackResult({ok: false, status: 0, error: "callback-url-not-allowed", attempt-ms: 0}) }
        => {
            body-text ::json/to-json(payload)
            headers build-headers(body-text, opts)
            started ::time/epoch-millis(::time/now())
            // request returns a Result.Err for transport failures;
            // branch on it directly (no halt boundary needed).
            attempt ::http/request(::http/HttpRequest({
                method: "POST",
                url: opts.url,
                headers: headers,
                body: body-text,
            }))
            elapsed sub(::time/epoch-millis(::time/now()), started)
            cond {
                is-err(attempt) => {
                    failure err-value(attempt)
                    CallbackResult({
                        ok: false,
                        status: 0,
                        error: Str(failure),
                        attempt-ms: elapsed,
                    })
                }
                => {
                    response attempt
                    status response.status
                    success and(gte(status, 200), lt(status, 300))
                    CallbackResult({
                        ok: success,
                        status: status,
                        error: if(success, null, `upstream-${status}`),
                        attempt-ms: elapsed,
                    })
                }
            }
        }
    }
}

from-body
meta {
    doc: """
    Build a `CallbackOptions` from a webhook body. Returns `null` when
    the caller didn't supply a callback URL. Recognized keys (both
    kebab-case and snake_case):

    - `callback_url` / `callback-url`
    - `callback_signing_header` / `callback-signing-header`

    To sign the callback, pass the env var name as `signing-secret-env`.
    The body cannot choose it: a caller who could name any env var would
    get that value used as an HMAC key on a POST to their own URL. A
    `callback_secret_env` key in the body is ignored.

    Convenience for transports that accept `callback_url` in the
    inbound payload directly. Non-HTTPS URLs are ignored; callers that
    need local development callbacks should use streams or construct
    their own stricter transport-local policy.

    **Example**

    ```hot
    ::callbacks ::ai::agent::callbacks

    opts ::callbacks/from-body({callback_url: "https://example.com/done"}, "CALLBACK_SECRET")
    opts.url  // "https://example.com/done"
    opts.signing-secret-env  // "CALLBACK_SECRET"
    ::callbacks/from-body({callback_url: "http://example.com/done"})  // null
    ```
    """
}
fn
(body: Map?): Any {
    from-body(body, null)
},
(body: Map?, signing-secret-env: Str?): Any {
    raw or(body, {})
    url or(get(raw, "callback_url"), get(raw, "callback-url"))
    cond {
        is-empty(or(url, "")) => { null }
        not(is-url-allowed(url)) => { null }
        => {
            CallbackOptions({
                url: url,
                signing-secret-env: signing-secret-env,
                signing-secret: null,
                signing-header: or(get(raw, "callback_signing_header"), get(raw, "callback-signing-header")),
                headers: get(raw, "callback_headers"),
                timeout-ms: get(raw, "callback_timeout_ms"),
            })
        }
    }
}
