::twilio::test::api ns
meta ["test"]

::api ::twilio::api

// ============================================================================
// form-encode
// ============================================================================

test-form-encode-basic
meta ["test"]
fn () {
    assert-eq("To=%2B15558675310&Body=hi%20there", ::api/form-encode({To: "+15558675310", Body: "hi there"}))
}

test-form-encode-omits-nulls
meta ["test"]
fn () {
    assert-eq("To=%2B15558675310", ::api/form-encode({To: "+15558675310", From: null, Body: null}))
}

test-form-encode-repeats-vec-params
meta ["test"]
fn () {
    // Twilio expects repeated parameters for list values (e.g. MMS MediaUrl)
    encoded ::api/form-encode({MediaUrl: ["https://a.com/1.jpg", "https://a.com/2.jpg"]})
    assert-eq("MediaUrl=https%3A%2F%2Fa.com%2F1.jpg&MediaUrl=https%3A%2F%2Fa.com%2F2.jpg", encoded)
}

test-form-encode-numeric-values
meta ["test"]
fn () {
    assert-eq("PageSize=20", ::api/form-encode({PageSize: 20}))
}

// ============================================================================
// query-string
// ============================================================================

test-query-string-basic
meta ["test"]
fn () {
    assert-eq("?PageSize=20&Page=2", ::api/query-string({PageSize: 20, Page: 2}))
}

test-query-string-omits-nulls
meta ["test"]
fn () {
    assert-eq("?PageSize=20", ::api/query-string({To: null, PageSize: 20}))
}

test-query-string-empty-when-all-null
meta ["test"]
fn () {
    assert-eq("", ::api/query-string({To: null, From: null}))
    assert-eq("", ::api/query-string({}))
}

test-query-string-encodes-phone-numbers
meta ["test"]
fn () {
    // "+" must be percent-encoded or Twilio decodes it as a space
    assert-eq("?To=%2B15558675310", ::api/query-string({To: "+15558675310"}))
}

// ============================================================================
// Credentials: explicit clients flow to both auth and the account URL
// ============================================================================

test-auth-token-client
meta ["test"]
fn () {
    c ::api/auth-token-client("AC123", "secret")
    // base64("AC123:secret")
    assert-eq("Basic QUMxMjM6c2VjcmV0", ::api/auth-header(c))
    assert-eq("https://api.twilio.com/2010-04-01/Accounts/AC123", ::api/account-url(c))
}

test-api-key-client-scopes-url-to-account-not-key
meta ["test"]
fn () {
    c ::api/api-key-client("AC123", "SK456", "keysecret")
    // base64("SK456:keysecret")
    assert-eq("Basic U0s0NTY6a2V5c2VjcmV0", ::api/auth-header(c))
    assert-eq("https://api.twilio.com/2010-04-01/Accounts/AC123", ::api/account-url(c))
}

test-client-from-ctx-prefers-api-key
meta ["test"]
fn () {
    ::hot::ctx/set({
        "twilio.account.sid": "ACctx",
        "twilio.auth.token": "tok",
        "twilio.api.key.sid": "SKctx",
        "twilio.api.key.secret": "sec"
    })
    c ::api/client-from-ctx()
    assert-eq("ACctx", c.account-sid)
    assert-eq("SKctx", c.username)
    assert-eq("sec", c.password)
}

test-client-from-ctx-auth-token
meta ["test"]
fn () {
    ::hot::ctx/set({
        "twilio.account.sid": "ACctx",
        "twilio.auth.token": "tok",
        "twilio.api.key.sid": "",
        "twilio.api.key.secret": ""
    })
    c ::api/client-from-ctx()
    assert-eq("ACctx", c.username)
    assert-eq("tok", c.password)
}

// ============================================================================
// Per-call credentials
// ============================================================================

CTX_VALUES {"twilio.account.sid": "ACctx", "twilio.auth.token": "ctx-token"}

err-text fn (out: Result): Str {
    if-err(out, (e) { e })
}

test-resolve-from-uses-ctx
meta ["test"]
fn () {
    c ::api/resolve-from({}, CTX_VALUES)
    assert-eq("ACctx", c.account-sid)
    assert-eq("ctx-token", c.password)
}

test-resolve-from-opts-win
meta ["test"]
fn () {
    token ::api/resolve-from({account-sid: "ACb", auth-token: " tenant-token "}, CTX_VALUES)
    assert-eq("ACb", token.username)
    assert-eq("tenant-token", token.password)

    key ::api/resolve-from({account-sid: "ACb", auth-token: "t", api-key-sid: "SKb", api-key-secret: "sec"}, CTX_VALUES)
    assert-eq("ACb", key.account-sid)
    assert-eq("SKb", key.username, "an API key wins")
    assert-eq("sec", key.password)
}

test-resolve-from-blank-credential-never-falls-back
meta ["test"]
fn () {
    for-each(["account-sid", "auth-token", "api-key-sid", "api-key-secret"], (key) {
        for-each(["", "  ", null], (blank) {
            out ::api/resolve-from(assoc({}, key, blank), CTX_VALUES)
            assert(is-err(out), "a blank credential is an Err, never ctx")
            assert(contains(err-text(out), key), "names the key")
        })
    })
}

test-resolve-from-per-call-account-needs-credentials
meta ["test"]
fn () {
    out ::api/resolve-from({account-sid: "ACb"}, CTX_VALUES)
    assert(is-err(out), "context credentials never go to a per-call account")
    assert(contains(err-text(out), "account-sid"))
    assert(contains(err-text(out), "auth-token"))
}

test-resolve-from-credentials-need-account
meta ["test"]
fn () {
    assert(contains(err-text(::api/resolve-from({auth-token: "t"}, CTX_VALUES)), "account-sid"))
    assert(contains(err-text(::api/resolve-from({api-key-sid: "SK", api-key-secret: "s"}, CTX_VALUES)), "account-sid"))
}

test-resolve-from-half-an-api-key
meta ["test"]
fn () {
    assert(contains(err-text(::api/resolve-from({account-sid: "ACb", api-key-sid: "SK"}, CTX_VALUES)), "api-key-secret"))
    assert(contains(err-text(::api/resolve-from({account-sid: "ACb", api-key-secret: "s"}, CTX_VALUES)), "api-key-sid"))
}

test-resolve-from-nothing-configured
meta ["test"]
fn () {
    assert(contains(err-text(::api/resolve-from({}, {})), "twilio.account.sid"))
    assert(is-err(::api/resolve-from({}, {"twilio.account.sid": "ACctx"})), "no credential")
}

test-resolve-opts-and-client-return-values-unchanged
meta ["test"]
fn () {
    from-opts ::api/resolve({account-sid: "ACb", auth-token: "tenant-auth-token"})
    assert-eq("tenant-auth-token", from-opts.password)

    client ::api/api-key-client("ACb", "SKb", "tenant-key-secret")
    assert-eq("tenant-key-secret", client.password)
    assert-eq(client, ::api/resolve(client), "a Client passes through")
}

test-opts-arity-errs-before-any-request
meta ["test"]
fn () {
    list ::twilio::messages/ListMessagesRequest({PageSize: 1})
    assert(is-err(::twilio::messages/list-messages(list, {auth-token: ""})))
    assert(is-err(::twilio::messages/list-messages({PageSize: 1}, {account-sid: "ACb"})), "a plain Map request reaches the opts arity")
    assert(is-err(::twilio::messages/list-all-messages(list, 5, {auth-token: null})))
    assert(is-err(::twilio::accounts/get-account({account-sid: " "})))
    assert(is-err(::twilio::verify/list-services({auth-token: ""})))
    assert(is-err(::api/request("GET", "https://api.twilio.com/x", {}, {}, {auth-token: ""})))
    assert(is-err(::api/next-page({next_page_uri: "/x"}, {auth-token: ""})))
    assert(is-err(::api/delete-request("https://api.twilio.com/x", {auth-token: ""})))
}

test-account-auth-token-marked-unchanged
meta ["test"]
fn () {
    body {sid: "AC1", auth_token: "account-auth-token"}
    assert-eq(body, ::twilio::accounts/mark-auth-token(body))
    assert-eq({sid: "AC1"}, ::twilio::accounts/mark-auth-token({sid: "AC1"}))
}

// ============================================================================
// Pagination
// ============================================================================

test-next-page-ref-2010
meta ["test"]
fn () {
    page {messages: [], next_page_uri: "/2010-04-01/Accounts/AC1/Messages.json?PageSize=50&Page=1&PageToken=PASM1"}
    assert-eq("/2010-04-01/Accounts/AC1/Messages.json?PageSize=50&Page=1&PageToken=PASM1", ::api/next-page-ref(page))
}

test-next-page-ref-v2-meta
meta ["test"]
fn () {
    page {services: [], meta: {next_page_url: "https://verify.twilio.com/v2/Services?PageSize=50&Page=1&PageToken=PA1"}}
    assert-eq("https://verify.twilio.com/v2/Services?PageSize=50&Page=1&PageToken=PA1", ::api/next-page-ref(page))
}

test-next-page-ref-last-page
meta ["test"]
fn () {
    assert(is-null(::api/next-page-ref({messages: [], next_page_uri: null})), "null next_page_uri is the last page")
    assert(is-null(::api/next-page-ref({services: [], meta: {next_page_url: null}})), "null next_page_url is the last page")
    assert(is-null(::api/next-page-ref({messages: []})), "absent link is the last page")
}

test-page-url-joins-paths-to-api-host
meta ["test"]
fn () {
    assert-eq("https://api.twilio.com/2010-04-01/Accounts/AC1/Calls.json?Page=1",
        ::api/page-url("/2010-04-01/Accounts/AC1/Calls.json?Page=1"))
}

test-page-url-only-follows-twilio-hosts
meta ["test"]
fn () {
    assert(::api/is-twilio-url("https://verify.twilio.com/v2/Services?Page=1"))
    assert(::api/is-twilio-url("https://api.twilio.com/2010-04-01/x"))
    assert(not(::api/is-twilio-url("https://api.twilio.com.evil.example/x")), "suffix trick")
    assert(not(::api/is-twilio-url("https://evil.example/#.twilio.com/")), "fragment trick")
    assert(not(::api/is-twilio-url("https://evil.example?x=.twilio.com/")), "query trick")
    assert(not(::api/is-twilio-url("https://user@api.twilio.com/")), "userinfo")
    assert(not(::api/is-twilio-url("http://api.twilio.com/x")), "plain http")
    assert(is-err(::api/page-url("https://evil.example/steal")), "non-Twilio URL is refused")
}
