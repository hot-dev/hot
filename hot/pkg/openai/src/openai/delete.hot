::openai::delete ns

api-request ::openai::api/request
HttpError ::openai::api/HttpError
is-ok-response ::hot::http/is-ok-response

DeleteFineTuningCheckpointPermissionResponse type {
    id: Str,
    object: "checkpoint.permission",
    deleted: Bool
}

DeleteAssistantResponse type {
    id: Str,
    deleted: Bool,
    object: "assistant.deleted"
}

DeleteVectorStoreFileResponse type {
    id: Str,
    deleted: Bool,
    object: "vector_store.file.deleted"
}

DeleteThreadResponse type {
    id: Str,
    deleted: Bool,
    object: "thread.deleted"
}

Error type {
    code: Str,
    message: Str,
    param: Str,
    type: Str
}

DeleteMessageResponse type {
    id: Str,
    deleted: Bool,
    object: "thread.message.deleted"
}

DeleteFileResponse type {
    id: Str,
    object: "file",
    deleted: Bool
}

DeleteVectorStoreResponse type {
    id: Str,
    deleted: Bool,
    object: "vector_store.deleted"
}

ChatCompletionDeleted type {
    object: "chat.completion.deleted",
    id: Str,
    deleted: Bool
}

DeleteModelResponse type {
    id: Str,
    deleted: Bool,
    object: Str
}

DeleteCertificateResponse type {
    object: Any,
    id: Str
}

DeleteAssistantRequest type {
  assistant-id: Str
}

DeleteAssistantResponse type {
    id: Str,
    deleted: Bool,
    object: "assistant.deleted"
}


delete-assistant
meta {doc: """DELETE /assistants/{assistant_id} - Permanently delete an assistant."""}
fn
(request: DeleteAssistantRequest): DeleteAssistantResponse {
  delete-assistant(request, {})
},
(request: DeleteAssistantRequest, opts: Map): DeleteAssistantResponse {
  response api-request("DELETE", `/assistants/${request.assistant-id}`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { DeleteAssistantResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

