::cloudflare::kv ns
meta {
    doc: """
    Workers KV over the Cloudflare API: namespaces, key listing (cursor
    paged), and values. KV stores raw bytes — `read` returns Bytes;
    `read-text` and `read-json` decode them. Values written through the
    API become visible at the edge within about 60 seconds.
    """,
    ctx: {"cloudflare.token": {required: true}, "cloudflare.account.id": {required: true}}
}

::api ::cloudflare::api

ListPage ::cloudflare::api/ListPage
HttpError ::cloudflare::api/HttpError

namespaces-suffix "/storage/kv/namespaces"

namespace-suffix fn (namespace-id: Str): Str {
  `${namespaces-suffix}/${::api/seg(namespace-id)}`
}

value-suffix fn (namespace-id: Str, key: Str): Str {
  `${namespace-suffix(namespace-id)}/values/${::api/seg(key)}`
}

// ---------------------------------------------------------------------------
// Namespaces
// ---------------------------------------------------------------------------

list-namespaces
meta {
    doc: """GET /accounts/{account_id}/storage/kv/namespaces - One page of namespaces (`page`, `per_page` up to 1000, `order`: `id`/`title`, `direction`). Returns a `ListPage`."""
}
fn
(): ListPage {
  list-namespaces({})
},
(params: Map): ListPage {
  ::api/account-page(`${namespaces-suffix}${::api/query(params)}`)
}

list-all-namespaces
meta {
    doc: """Every namespace, following pages (1000 per request) up to `max` items (default 10000)."""
}
fn
(): Vec {
  list-all-namespaces(::api/DEFAULT_MAX_ITEMS)
},
(max: Int): Vec {
  ::api/collect-pages(list-namespaces, {per_page: 1000}, max)
}

create-namespace
meta {
    doc: """POST /accounts/{account_id}/storage/kv/namespaces - Create a namespace titled `title`. Returns `{id, title, supports_url_encoding}`."""
}
fn (title: Str): Map {
  ::api/account-json("POST", namespaces-suffix, {title: title})
}

delete-namespace
meta {
    doc: """DELETE a namespace and every key in it."""
}
fn (namespace-id: Str): Any {
  ::api/account-json("DELETE", namespace-suffix(namespace-id))
}

// ---------------------------------------------------------------------------
// Keys
// ---------------------------------------------------------------------------

list-keys
meta {
    doc: """
    GET .../namespaces/{id}/keys - One page of keys (names, `expiration`,
    `metadata`; never values). `params`: `prefix`, `limit` (10–1000),
    `cursor` (from the previous page's `result_info.cursor`). Returns a
    `ListPage`; `::cloudflare::api/next-cursor(page.result_info)` is null
    on the last page.

    **Example**

    ```hot
    page ::cloudflare::kv/list-keys(namespace-id, {prefix: "session:", limit: 100})
    map(page.result, %.name)
    ```
    """
}
fn
(namespace-id: Str): ListPage {
  list-keys(namespace-id, {})
},
(namespace-id: Str, params: Map): ListPage {
  ::api/account-page(`${namespace-suffix(namespace-id)}/keys${::api/query(params)}`)
}

list-all-keys
meta {
    doc: """Every key matching `params` (usually `{prefix}`), following cursors (1000 per request) up to `max` keys (default 10000)."""
}
fn
(namespace-id: Str): Vec {
  list-all-keys(namespace-id, {})
},
(namespace-id: Str, params: Map): Vec {
  list-all-keys(namespace-id, params, ::api/DEFAULT_MAX_ITEMS)
},
(namespace-id: Str, params: Map, max: Int): Vec {
  ::api/collect-cursor((p) { list-keys(namespace-id, p) }, {limit: 1000, ...params}, max)
}

// ---------------------------------------------------------------------------
// Values
// ---------------------------------------------------------------------------

read
meta {
    doc: """
    GET .../values/{key} - A value's raw bytes. An absent key is an Err
    carrying `HttpError` with status 404 (see `is-not-found`).

    **Example**

    ```hot
    png ::cloudflare::kv/read(namespace-id, "avatar:42")
    ```
    """
}
fn (namespace-id: Str, key: Str): Bytes {
  path ::api/account-path(value-suffix(namespace-id, key))
  cond {
    is-err(path) => { path }
    => {
      response ::api/send("GET", path, {}, "")
      cond {
        is-err(response) => { response }
        => { or(response.body-bytes, Bytes("")) }
      }
    }
  }
}

read-text
meta {
    doc: """A value decoded as UTF-8 text."""
}
fn (namespace-id: Str, key: Str): Str {
  value read(namespace-id, key)
  cond {
    is-err(value) => { value }
    => { Str(value) }
  }
}

read-json
meta {
    doc: """A value parsed as JSON (an Err when it is not valid JSON)."""
}
fn (namespace-id: Str, key: Str): Any {
  text read-text(namespace-id, key)
  cond {
    is-err(text) => { text }
    => { ::hot::json/from-json(text) }
  }
}

read-metadata
meta {
    doc: """GET .../metadata/{key} - The JSON metadata stored with a key (null when none)."""
}
fn (namespace-id: Str, key: Str): Any {
  ::api/account-json("GET", `${namespace-suffix(namespace-id)}/metadata/${::api/seg(key)}`)
}

status-of fn (e: Any): Int? {
  cond {
    is-map(e) => { get(e, "status") }
    => { null }
  }
}

is-not-found
meta {
    doc: """True when `result` is an Err for a missing key (HTTP 404). Use it to tell "absent" from real failures after `read`."""
}
fn (result: Result): Bool {
  cond {
    is-err(result) => { if-err(result, (e) { status-of(e) |> eq(404) }) }
    => { false }
  }
}

write-query
meta {
    doc: """The `?expiration_ttl=…&expiration=…` suffix for a write; unset options are omitted. Exposed for testing."""
}
fn (opts: Map): Str {
  ::api/query({
    expiration_ttl: get(opts, "expiration_ttl"),
    expiration: get(opts, "expiration")
  })
}

write-parts
meta {
    doc: """The multipart parts for a write that carries metadata: the `value` part (Str or Bytes) and a JSON `metadata` part. Exposed for testing."""
}
fn (value: Any, metadata: Any): Vec {
  [
    {name: "value", value: value, content_type: "application/octet-stream"},
    {name: "metadata", value: to-json(untype(metadata)), content_type: "application/json"}
  ]
}

write
meta {
    doc: """
    PUT .../values/{key} - Store `value` (Str or Bytes; a Map/Vec is
    stored as JSON). `opts`:
    - `expiration_ttl` — seconds until the key expires (minimum 60)
    - `expiration` — absolute expiry, seconds since the epoch
    - `metadata` — JSON (up to 1024 bytes serialized) kept alongside the key

    A write without metadata sends the raw bytes; with metadata it uses
    the multipart form the API requires.

    **Example**

    ```hot
    ::cloudflare::kv/write(namespace-id, "flag:checkout-v2", "on")
    ::cloudflare::kv/write(namespace-id, "session:abc", session-json, {expiration_ttl: 3600, metadata: {user: "u_42"}})
    ```
    """
}
fn
(namespace-id: Str, key: Str, value: Any): Any {
  write(namespace-id, key, value, {})
},
(namespace-id: Str, key: Str, value: Any, opts: Map): Any {
  suffix `${value-suffix(namespace-id, key)}${write-query(opts)}`
  path ::api/account-path(suffix)
  metadata get(opts, "metadata")
  cond {
    is-err(path) => { path }
    is-some(metadata) => { ::api/send-multipart("PUT", path, write-parts(value, metadata)) }
    => {
      response ::api/send("PUT", path, {Content-Type: "application/octet-stream"}, ::api/as-bytes(value))
      cond {
        is-err(response) => { response }
        => { get(or(response.body, {}), "result") }
      }
    }
  }
}

delete-key
meta {
    doc: """DELETE .../values/{key} - Remove a key (succeeds for absent keys too)."""
}
fn (namespace-id: Str, key: Str): Any {
  ::api/account-json("DELETE", value-suffix(namespace-id, key))
}

write-bulk
meta {
    doc: """
    PUT .../bulk - Write up to 10,000 entries in one request. Each entry
    is `{key, value, expiration_ttl?, expiration?, metadata?, base64?}`;
    `value` must be a string (set `base64: true` and base64-encode binary
    values). Returns `{successful_key_count, unsuccessful_keys}`.
    """
}
fn (namespace-id: Str, entries: Vec): Map {
  ::api/account-json("PUT", `${namespace-suffix(namespace-id)}/bulk`, map(entries, (e) { filter-vals(untype(e), is-some) }))
}

delete-bulk
meta {
    doc: """POST .../bulk/delete - Delete up to 10,000 keys in one request."""
}
fn (namespace-id: Str, key-names: Vec<Str>): Map {
  ::api/account-json("POST", `${namespace-suffix(namespace-id)}/bulk/delete`, key-names)
}
