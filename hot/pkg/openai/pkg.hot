::hot::pkg ns

hot.pkg.openai {
  name: "hot.dev/openai",
  version: "1.3.1",
  hot-min-version: "3.0.2",
  description: "OpenAI API bindings for Hot: Chat Completions (with a hot-ai tools adapter), Responses, Models, Embeddings, Images, Audio, Moderations, Files, Batches, Vector Stores and more. A configurable base URL and explicit endpoints let the same adapter drive any OpenAI-compatible server (Ollama, vLLM, Groq, OpenRouter, ...).",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["ai", "llm", "openai"],
  deps: {
    "hot.dev/hot-ai": "1.9.0"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
