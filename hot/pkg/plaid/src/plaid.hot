::plaid ns
meta {
    doc: """
    Plaid bindings: bank account data for fintech builders. Covers the
    Link token flow, Items, accounts, real-time balance, Auth, Identity,
    transactions (sync, get, refresh, recurring), institutions,
    investments, liabilities, sandbox helpers and webhook verification.

    **Setup**: context variables
    - `plaid.client-id` and `plaid.secret`
    - `plaid.env`: `"sandbox"` (default) or `"production"`
    - `plaid.version`: optional, overrides the `Plaid-Version` header

    Plaid authenticates with the client id and secret in the request
    body; this package injects them. Every API-calling function also takes
    them per call in a trailing `opts` Map (see `::plaid::api`).

    **Quick start**

    ```hot
    ::link ::plaid::link
    ::transactions ::plaid::transactions

    // 1. Create a Link token; your frontend runs Plaid Link with it
    link ::link/create-link-token("user-42", "My App", {products: ["transactions"]})

    // 2. Exchange the public token Link returns for an access token
    tokens ::link/exchange-public-token("public-sandbox-123")

    // 3. Pull everything new since the stored cursor
    sync ::transactions/sync-all-transactions(tokens.access_token, null)
    ```
    """
}

// The Plaid API version sent as `Plaid-Version` (the only version since
// 2020; Plaid ships changes behind it without bumping it). Override with
// the `plaid.version` context variable.
PLAID_VERSION "2020-09-14"

// Plaid has two environments. "development" was decommissioned in June
// 2024 and is rejected rather than silently mapped.
ENVIRONMENTS {
  sandbox: "https://sandbox.plaid.com",
  production: "https://production.plaid.com"
}

DEFAULT_ENV "sandbox"
