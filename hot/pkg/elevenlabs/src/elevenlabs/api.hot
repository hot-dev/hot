::elevenlabs::api ns
meta {
    doc: """
    Internal HTTP plumbing for the ElevenLabs API: authenticated requests
    (`xi-api-key` header), query strings, multipart bodies, and the
    `HttpError` returned for non-2xx responses.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then the `elevenlabs.api.key` context variable, then the
    defaults. Nothing from `opts` is written to ctx, so one run can act for
    many tenants and parallel flows don't share credentials. Credentials
    in `opts` are masked in call records. An `api-key` present but blank or
    null is an error, never a fallback to context.

    - `api-key`: the API key for this call
    - `base-url`: another API root, such as a proxy. It needs an `api-key`
      in the same `opts`: `elevenlabs.api.key` is never sent to a per-call
      URL.
    """,
    ctx: {"elevenlabs.api.key": {required: false}}
}

::ctx ::hot::ctx
::uri ::hot::uri
::re ::hot::regex

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse
StreamingHttpResponse ::hot::http/StreamingHttpResponse

HttpError
meta {
    doc: """
    A non-2xx ElevenLabs response. `message` is a readable summary of
    ElevenLabs' error body (`detail.status`/`detail.message`, a plain
    `detail` string, or a validation-error list); `body` keeps the
    decoded payload.
    """
}
type {
    status: Int,
    headers: Map?,
    body: Any?,
    message: Str
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: response.headers,
    body: response.body,
    message: error-message(response.status, response.body)
  })
}

error-message
meta {
    doc: """Build a readable message from an ElevenLabs error status and body. Exposed for testing."""
}
fn (status: Int, body: Any): Str {
  detail if(is-map(body), get(body, "detail"), null)
  text cond {
    is-map(detail) => {
      code get(detail, "status")
      msg get(detail, "message")
      cond {
        and(is-some(code), is-some(msg)) => { `${code}: ${msg}` }
        => { or(msg, code) }
      }
    }

    is-str(detail) => { detail }
    is-vec(detail) => {
      msgs filter(map(detail, (d) { if(is-map(d), get(d, "msg"), null) }), is-some)
      if(is-empty(msgs), null, join(msgs, "; "))
    }

    is-str(body) => { if(is-blank(body), null, trim(body)) }
    => { null }
  }

  if(is-some(text), `ElevenLabs API error (HTTP ${status}): ${text}`, `ElevenLabs API error (HTTP ${status})`)
}

query-string
meta {
    doc: """
    Build a query-string suffix (`?a=1&b=2`, or `""` when nothing is
    set) from a Map. Null values are dropped, Bools render as
    `true`/`false`, Vec values repeat the key, and keys and values are
    percent-encoded.

    **Example**

    ```hot
    ::elevenlabs::api/query-string({page_size: 20, search: "narrator", voice_type: null})
    // "?page_size=20&search=narrator"
    ```
    """
}
fn (params: Map): Str {
  pairs reduce(params, (acc, entry) {
    key ::uri/encode(Str(first(entry)))
    value entry[1]
    cond {
      is-null(value) => { acc }
      is-vec(value) => {
        concat(acc, map(filter(value, is-some), (item) { `${key}=${::uri/encode(Str(item))}` }))
      }
      => { concat(acc, [`${key}=${::uri/encode(Str(value))}`]) }
    }
  }, [])
  if(is-empty(pairs), "", `?${join(pairs, "&")}`)
}

path-segment
meta {
    doc: """Percent-encode one path segment (a voice or history item id)."""
}
fn (value: Str): Str {
  ::uri/encode(value)
}

non-blank fn (value: Any): Str? {
  if(is-str(value), if(is-blank(value), null, trim(value)), null)
}

resolve-from
meta {
    doc: """The one resolver, pure: `{api-key, base-url}` for a call from `opts` first, then `ctx-values` (a Map of context variables), then defaults. An Err when no API key is set, when `api-key` is in `opts` but blank or null (that never falls back to context), or when `opts` has `base-url` without `api-key`. Exposed for testing; `resolve` feeds it the context."""
}
fn (opts: Map, ctx-values: Map): Map {
  opt-key non-blank(get(opts, "api-key"))
  opt-url non-blank(get(opts, "base-url"))
  api-key or(opt-key, non-blank(get(ctx-values, "elevenlabs.api.key")))
  cond {
    and(in("api-key", keys(opts)), is-null(opt-key)) => {
      err("elevenlabs: api-key is in the call's opts but is blank or null. Pass a value, or leave api-key out to use elevenlabs.api.key.")
    }

    and(is-some(opt-url), is-null(opt-key)) => {
      err("elevenlabs: base-url is in the call's opts without api-key. Pass api-key with it. Context credentials are never sent to a per-call URL.")
    }

    is-null(api-key) => { err("elevenlabs: elevenlabs.api.key is not set. Add it in Context Variables, or pass {api-key: ...} in the call's opts.") }
    => { {api-key: api-key, base-url: ::re/replace-all(or(opt-url, ::elevenlabs/BASE_URL), "/+$", "")} }
  }
}

resolve
meta {
    ctx: {"elevenlabs.api.key": {required: false}},
    doc: """
    Credentials and settings for one call (see `resolve-from`). An `api-key`
    from `opts` is masked in this run's records and never written to ctx.

    **Example**

    ```hot
    ::elevenlabs::api/resolve({api-key: "tenant-b-key"}).base-url  // "https://api.elevenlabs.io"
    ```
    """
}
fn (opts: Map): Map {
  ::ctx/mark-secret(non-blank(get(opts, "api-key")))
  resolve-from(opts, {"elevenlabs.api.key": ::ctx/get("elevenlabs.api.key")})
}

// ============================================================================
// Multipart
// ============================================================================

multipart-field
meta {
    doc: """One `multipart/form-data` text field as Bytes. Bools render as `true`/`false`; Maps and Vecs as JSON. Exposed for testing."""
}
fn (boundary: Str, name: Str, value: Any): Bytes {
  text cond {
    is-str(value) => { value }
    or(is-map(value), is-vec(value)) => { to-json(untype(value)) }
    => { Str(value) }
  }

  Bytes(`--${boundary}\r\nContent-Disposition: form-data; name="${name}"\r\n\r\n${text}\r\n`)
}

multipart-file
meta {
    doc: """One `multipart/form-data` file part as Bytes. The file bytes are concatenated verbatim, never interpolated into a string. Exposed for testing."""
}
fn (boundary: Str, name: Str, filename: Str, mime-type: Str, data: Bytes): Bytes {
  concat(
    Bytes(`--${boundary}\r\nContent-Disposition: form-data; name="${name}"; filename="${filename}"\r\nContent-Type: ${mime-type}\r\n\r\n`),
    data,
    Bytes("\r\n")
  )
}

multipart-close fn (boundary: Str): Bytes {
  Bytes(`--${boundary}--\r\n`)
}

// ============================================================================
// Requests
// ============================================================================

request
meta {
    doc: """
    Make an authenticated request to the ElevenLabs API. `path` is
    relative to the API root (e.g. `/v1/voices`). ElevenLabs
    authenticates with an `xi-api-key` header (not a Bearer token).
    A Map or typed record `body` is sent as JSON (unset optional fields
    omitted); `Bytes` are sent verbatim (set `Content-Type` in
    `additional-headers`); `""` sends no body. Returns the raw
    `HttpResponse`; `json` and `bytes` unwrap it.

    **Example**

    ```hot
    response ::elevenlabs::api/request("GET", "/v1/voices")
    response.body.voices
    ```
    """
}
fn
(method: Str, path: Str): HttpResponse {
  request(method, path, {}, "")
},
(method: Str, path: Str, additional-headers: Map): HttpResponse {
  request(method, path, additional-headers, "")
},
(method: Str, path: Str, additional-headers: Map, body: Any): HttpResponse {
  request(method, path, additional-headers, body, {})
},
// 5-arity: explicit API key override
(method: Str, path: Str, additional-headers: Map, body: Any, key: Str?): HttpResponse {
  request(method, path, additional-headers, body, {api-key: key})
},
// 5-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { ::hot::http/request(build-request(method, path, additional-headers, body, resolved)) }
  }
}

build-request
meta {
    doc: """The outgoing `HttpRequest` from resolved settings (see `resolve`). Pure; exposed for testing."""
}
fn (method: Str, path: Str, additional-headers: Map, body: Any, resolved: Map): HttpRequest {
  base-headers {xi-api-key: resolved.api-key}
  encoded match body {
    "" | Null => { {headers: base-headers, body: ""} }
    Bytes => { {headers: base-headers, body: body} }
    _ => { {headers: {...base-headers, Content-Type: "application/json"}, body: to-json(untype(body))} }
  }

  HttpRequest({
    method,
    url: `${resolved.base-url}${path}`,
    headers: {...encoded.headers, ...additional-headers},
    body: encoded.body
  })
}

json
meta {
    doc: """Like `request`, but returns the decoded JSON body on 2xx, or an Err carrying `HttpError`."""
}
fn
(method: Str, path: Str): Any {
  json(method, path, {}, "")
},
(method: Str, path: Str, body: Any): Any {
  json(method, path, {}, body)
},
(method: Str, path: Str, additional-headers: Map, body: Any): Any {
  json(method, path, additional-headers, body, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): Any {
  response request(method, path, additional-headers, body, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body }
    => { err(HttpError(response)) }
  }
}

bytes
meta {
    doc: """Like `request`, but returns the verbatim response `Bytes` on 2xx (for audio), or an Err carrying `HttpError`."""
}
fn
(method: Str, path: Str): Bytes {
  bytes(method, path, "")
},
(method: Str, path: Str, body: Any): Bytes {
  bytes(method, path, body, {})
},
(method: Str, path: Str, body: Any, opts: Map): Bytes {
  response request(method, path, {}, body, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body-bytes }
    => { err(HttpError(response)) }
  }
}

request-stream
meta {
    doc: """Make an authenticated streaming request with raw (binary chunk) framing, used for streaming audio endpoints."""
}
fn
(method: Str, path: Str, additional-headers: Map, body: Any): StreamingHttpResponse {
  request-stream(method, path, additional-headers, body, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any, key: Str?): StreamingHttpResponse {
  request-stream(method, path, additional-headers, body, {api-key: key})
},
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): StreamingHttpResponse {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => {
      ::hot::http/request-stream(build-request(method, path, {Content-Type: "application/json", ...additional-headers}, body, resolved), "raw")
    }
  }
}
