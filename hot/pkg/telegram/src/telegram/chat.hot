GetChatMemberRequest type {
  chat_id: Any,
  user_id: Int
}

get-chat-member
meta {
    doc: """
    getChatMember - Get information about a specific member of a chat.
    Returns their status (creator, administrator, member, restricted, left,
    kicked).

    **Example**

    ```hot
    ::chat ::telegram::chat

    member ::chat/get-chat-member(::chat/GetChatMemberRequest({
      chat_id: -1001234567890,
      user_id: 123456789
    }))
    member.status
    ```
    """
}
fn
(request: GetChatMemberRequest): Map {
  get-chat-member(request, {})
},
(request: GetChatMemberRequest, opts: Map): Map {
  api-request("getChatMember", untype(request), opts)
}

GetChatAdministratorsRequest type {
  chat_id: Any
}

get-chat-administrators
meta {
    doc: """
    getChatAdministrators - Get a list of administrators in a chat. Returns
    an array of ChatMember objects.

    **Example**

    ```hot
    ::chat ::telegram::chat

    admins ::chat/get-chat-administrators(::chat/GetChatAdministratorsRequest({
      chat_id: -1001234567890
    }))
    map(admins, %.user.id)
    ```
    """
}
fn
(request: GetChatAdministratorsRequest): Vec<Map> {
  get-chat-administrators(request, {})
},
(request: GetChatAdministratorsRequest, opts: Map): Vec<Map> {
  api-request("getChatAdministrators", untype(request), opts)
}

// ============================================================================
// Member Management
// ============================================================================

BanChatMemberRequest type {
  chat_id: Any,
  user_id: Int,
  until_date: Int?,
  revoke_messages: Bool?
}

ban-chat-member
meta {
    doc: """
    banChatMember - Ban a user from a group or channel. `until_date` is a
    Unix timestamp for a temporary ban (30 seconds to 366 days in the
    future). Set `revoke_messages: true` to delete all messages from the
    user.

    **Example**

    ```hot
    ::chat ::telegram::chat

    ::chat/ban-chat-member(::chat/BanChatMemberRequest({
      chat_id: -1001234567890,
      user_id: 123456789,
      revoke_messages: true
    }))
    ```
    """
}
fn
(request: BanChatMemberRequest): Bool {
  ban-chat-member(request, {})
},
(request: BanChatMemberRequest, opts: Map): Bool {
  api-request("banChatMember", untype(request), opts)
}

UnbanChatMemberRequest type {
  chat_id: Any,
  user_id: Int,
  only_if_banned: Bool?
}

unban-chat-member
meta {
    doc: """
    unbanChatMember - Unban a previously banned user. Set `only_if_banned:
    true` to avoid accidentally unbanning an active member (which would
    remove them).

    **Example**

    ```hot
    ::chat ::telegram::chat

    ::chat/unban-chat-member(::chat/UnbanChatMemberRequest({
      chat_id: -1001234567890,
      user_id: 123456789,
      only_if_banned: true
    }))
    ```
    """
}
fn
(request: UnbanChatMemberRequest): Bool {
  unban-chat-member(request, {})
},
(request: UnbanChatMemberRequest, opts: Map): Bool {
  api-request("unbanChatMember", untype(request), opts)
}

RestrictChatMemberRequest type {
  chat_id: Any,
  user_id: Int,
  permissions: Map,
  until_date: Int?,
  use_independent_chat_permissions: Bool?
}

restrict-chat-member
meta {
    doc: """
    restrictChatMember - Restrict a user in a supergroup. `permissions` is a
    ChatPermissions object controlling what the user can do (send messages,
    media, polls, etc.).

    **Example**

    ```hot
    ::chat ::telegram::chat

    ::chat/restrict-chat-member(::chat/RestrictChatMemberRequest({
      chat_id: -1001234567890,
      user_id: 123456789,
      permissions: {can_send_messages: false},
      until_date: 1798761600
    }))
    ```
    """
}
fn
(request: RestrictChatMemberRequest): Bool {
  restrict-chat-member(request, {})
},
(request: RestrictChatMemberRequest, opts: Map): Bool {
  api-request("restrictChatMember", untype(request), opts)
}

PromoteChatMemberRequest type {
  chat_id: Any,
  user_id: Int,
  is_anonymous: Bool?,
  can_manage_chat: Bool?,
  can_delete_messages: Bool?,
  can_manage_video_chats: Bool?,
  can_restrict_members: Bool?,
  can_promote_members: Bool?,
  can_change_info: Bool?,
  can_invite_users: Bool?,
  can_post_messages: Bool?,
  can_edit_messages: Bool?,
  can_pin_messages: Bool?,
  can_post_stories: Bool?,
  can_edit_stories: Bool?,
  can_delete_stories: Bool?,
  can_manage_topics: Bool?
}

promote-chat-member
meta {
    doc: """
    promoteChatMember - Promote or demote a user in a supergroup or channel.
    Pass the specific admin rights to grant. All rights default to false.

    **Example**

    ```hot
    ::chat ::telegram::chat

    ::chat/promote-chat-member(::chat/PromoteChatMemberRequest({
      chat_id: -1001234567890,
      user_id: 123456789,
      can_delete_messages: true,
      can_pin_messages: true
    }))
    ```
    """
}
fn
(request: PromoteChatMemberRequest): Bool {
  promote-chat-member(request, {})
},
(request: PromoteChatMemberRequest, opts: Map): Bool {
  api-request("promoteChatMember", untype(request), opts)
}

// ============================================================================
// Chat Settings
// ============================================================================

SetChatPermissionsRequest type {
  chat_id: Any,
  permissions: Map,
  use_independent_chat_permissions: Bool?
}

set-chat-permissions
meta {
    doc: """
setChatPermissions - Set the default permissions for all members of a group or supergroup. `permissions` is a ChatPermissions object (`can_send_messages`, `can_send_photos`, `can_send_polls`, `can_invite_users`, `can_pin_messages`, ...). The bot must be an administrator with `can_restrict_members`.

**Example**

```hot
::chat ::telegram::chat

// Read-only announcement group
::chat/set-chat-permissions(::chat/SetChatPermissionsRequest({
  chat_id: -1001234567890,
  permissions: {can_send_messages: false, can_send_polls: false, can_invite_users: true}
}))
```
"""
}
fn
(request: SetChatPermissionsRequest): Bool {
  set-chat-permissions(request, {})
},
(request: SetChatPermissionsRequest, opts: Map): Bool {
  api-request("setChatPermissions", untype(request), opts)
}

