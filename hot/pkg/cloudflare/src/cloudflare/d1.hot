::cloudflare::d1 ns
meta {
    doc: """
    Cloudflare D1 over the REST API: list databases and run SQL with
    bound parameters. The REST API suits admin jobs, migrations, and
    workflow reads; latency-sensitive traffic belongs in a Worker binding.
    """,
    ctx: {"cloudflare.token": {required: false}, "cloudflare.account.id": {required: false, secret: false}}
}

::api ::cloudflare::api

ListPage ::cloudflare::api/ListPage

list-databases
meta {
    doc: """
    GET /accounts/{account_id}/d1/database - One page of databases (`name`
    search, `page`, `per_page` 10–10000). Returns a `ListPage` of `{uuid,
    name, version, created_at}`.

    **Example**

    ```hot
    page ::cloudflare::d1/list-databases({name: "analytics", per_page: 50})
    map(page.result, %.uuid)
    ```
    """
}
fn
(): ListPage {
  list-databases({})
},
(params: Map): ListPage {
  list-databases(params, {})
},
(params: Map, opts: Map): ListPage {
  ::api/account-page(`/d1/database${::api/query(params)}`, "", opts)
}

list-all-databases
meta {
    doc: """
    Every database matching `params`, following pages up to `max` (default
    10000).

    **Example**

    ```hot
    map(::cloudflare::d1/list-all-databases({name: "analytics"}, 200), %.name)
    ```
    """
}
fn
(): Vec {
  list-all-databases({})
},
(params: Map): Vec {
  list-all-databases(params, ::api/DEFAULT_MAX_ITEMS)
},
(params: Map, max: Int): Vec {
  list-all-databases(params, max, {})
},
(params: Map, opts: Map): Vec {
  list-all-databases(params, ::api/DEFAULT_MAX_ITEMS, opts)
},
(params: Map, max: Int, opts: Map): Vec {
  ::api/collect-pages((p) { list-databases(p, opts) }, {per_page: 100, ...params}, max)
}

find-database
meta {
    doc: """
    The database named exactly `name`, or null.

    **Example**

    ```hot
    db ::cloudflare::d1/find-database("analytics")
    if(is-some(db), db.uuid, "no such database")
    ```
    """
}
fn
(name: Str): Map? {
  find-database(name, {})
},
(name: Str, opts: Map): Map? {
  matches list-all-databases({name: name}, opts)
  cond {
    is-err(matches) => { matches }
    => { find-first(matches, (db) { eq(db.name, name) }) }
  }
}

get-database
meta {
    doc: """
    GET /accounts/{account_id}/d1/database/{database_id} - One database,
    including `num_tables` and `file_size`.

    **Example**

    ```hot
    db ::cloudflare::d1/get-database("f4b1c7a0-8e3f-4b8a-9d3e-7f6a5c2e1b4d")
    db.num_tables
    ```
    """
}
fn
(database-id: Str): Map {
  get-database(database-id, {})
},
(database-id: Str, opts: Map): Map {
  ::api/account-json("GET", `/d1/database/${::api/seg(database-id)}`, "", opts)
}

query-body
meta {
    doc: """
    The query body `{sql, params?}`; params are sent as strings, as the API
    requires, and omitted when empty. Exposed for testing.

    **Example**

    ```hot
    ::cloudflare::d1/query-body("SELECT 1", [])  // {sql: "SELECT 1"}
    ::cloudflare::d1/query-body("SELECT ?", [1, null])  // {sql: "SELECT ?", params: ["1", null]}
    ```
    """
}
fn (sql: Str, params: Vec): Map {
  cond {
    is-empty(params) => { {sql: sql} }
    => { {sql: sql, params: map(params, (p) { if(is-null(p), p, Str(p)) })} }
  }
}

query
meta {
    doc: """
    POST /accounts/{account_id}/d1/database/{database_id}/query - Run
    SQL with `?` placeholders bound to `params`. Several `;`-separated
    statements run as a batch. Returns one result per statement:
    `[{results: [rows], success, meta: {changes, last_row_id, rows_read, rows_written, duration}}]`.

    **Example**

    ```hot
    db-id "f4b1c7a0-8e3f-4b8a-9d3e-7f6a5c2e1b4d"
    out ::cloudflare::d1/query(db-id, "SELECT id, email FROM users WHERE plan = ? LIMIT ?", ["pro", 50])
    first(out).results
    ```
    """
}
fn
(database-id: Str, sql: Str): Vec {
  query(database-id, sql, [])
},
(database-id: Str, sql: Str, params: Vec): Vec {
  query(database-id, sql, params, {})
},
(database-id: Str, sql: Str, opts: Map): Vec {
  query(database-id, sql, [], opts)
},
(database-id: Str, sql: Str, params: Vec, opts: Map): Vec {
  ::api/account-json("POST", `/d1/database/${::api/seg(database-id)}/query`, query-body(sql, params), opts)
}

rows
meta {
    doc: """
    Run a single statement and return just its rows.

    **Example**

    ```hot
    users ::cloudflare::d1/rows("f4b1c7a0-8e3f-4b8a-9d3e-7f6a5c2e1b4d", "SELECT id, email FROM users WHERE plan = ?", ["pro"])
    map(users, %.email)
    ```
    """
}
fn
(database-id: Str, sql: Str): Vec {
  rows(database-id, sql, [])
},
(database-id: Str, sql: Str, params: Vec): Vec {
  rows(database-id, sql, params, {})
},
(database-id: Str, sql: Str, opts: Map): Vec {
  rows(database-id, sql, [], opts)
},
(database-id: Str, sql: Str, params: Vec, opts: Map): Vec {
  out query(database-id, sql, params, opts)
  cond {
    is-err(out) => { out }
    is-empty(out) => { [] }
    => { or(first(out).results, []) }
  }
}
