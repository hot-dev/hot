::dropbox::oauth ns
meta {
    doc: """
    Dropbox OAuth 2 helpers, built on `hot.dev/oauth2`: the authorization
    code flow with PKCE and `token_access_type=offline` (so Dropbox
    returns a long-lived refresh token), code exchange, refresh and
    revocation.

    **Flow**

    1. Redirect the user to `authorize-url(...)` (offline access by
       default). Keep `state` and the PKCE verifier for the callback.
    2. In the callback, `exchange-code(...)` turns `?code=` into tokens:
       `access_token` (about 4 hours), `refresh_token`, `expires_in`,
       `scope`, `account_id`, `uid`, and `team_id` for team apps.
    3. Store `refresh_token` per user, then pass it per call as
       `{refresh-token, app-key, app-secret}` opts, or set the
       `dropbox.refresh.token` / `dropbox.app.key` / `dropbox.app.secret`
       context variables for a single-user app.

    ```hot
    ::oauth ::dropbox::oauth

    verifier ::oauth2/pkce-verifier()
    url ::oauth/authorize-url("abc123appkey", "https://app.example.com/oauth/dropbox", "csrf-123", {
      code-verifier: verifier,
      scope: ["files.metadata.read", "files.content.read"]
    })

    // callback handler:
    tokens ::oauth/exchange-code("abc123appkey", null, "code-from-query",
      "https://app.example.com/oauth/dropbox", {code-verifier: verifier})
    tokens.refresh_token
    ```
    """
}

::auth ::dropbox::auth
::oauth2 ::oauth2
::http ::hot::http

pkce-verifier ::oauth2/pkce-verifier
pkce-challenge ::oauth2/pkce-challenge

REVOKE_PATH "/auth/token/revoke"

scope-str
meta {
    doc: """
    A scope value as Dropbox wants it (space-separated): a Vec is joined, a
    Str is passed through with commas turned into spaces, null stays null.

    **Example**

    ```hot
    ::dropbox::oauth/scope-str(["files.content.read", "sharing.write"])  // "files.content.read sharing.write"
    ::dropbox::oauth/scope-str("files.content.read,sharing.write")  // "files.content.read sharing.write"
    ```
    """
}
fn (scope: Any): Str? {
  cond {
    is-null(scope) => { null }
    is-vec(scope) => { if(is-empty(scope), null, join(scope, " ")) }
    ::dropbox/is-blank(scope) => { null }
    => { join(filter(split(replace(Str(scope), ",", " "), " "), (s) { not(is-empty(s)) }), " ") }
  }
}

bool-param
meta {
    doc: """
    A Bool option as a query value: `"true"`, `"false"`, or null when unset.

    **Example**

    ```hot
    ::dropbox::oauth/bool-param(true)  // "true"
    ::dropbox::oauth/bool-param(null)  // null
    ```
    """
}
fn (value: Any): Str? {
  cond {
    is-null(value) => { null }
    eq(value, true) => { "true" }
    => { "false" }
  }
}

build-authorize-params
meta {
    doc: """
    The Dropbox-specific authorization parameters for `authorize-url`
    (pure). Options (all optional):

    - `token-access-type` - `"offline"` (default; returns a refresh
      token), `"online"` (access token only), or null to omit
    - `scope` - Vec or space/comma separated Str of scopes
      (`files.content.read`, `sharing.write`, ...); omitted means every
      scope the app has in the App Console
    - `include-granted-scopes` - `"user"` or `"team"` (incremental authorization)
    - `code-verifier` - a PKCE verifier; its S256 challenge is sent
    - `code-challenge` - a precomputed S256 challenge (instead of `code-verifier`)
    - `force-reapprove`, `force-reauthentication`, `disable-signup` - Bools
    - `require-role` - `"personal"` or `"work"`
    - `locale` - e.g. `"de"`
    - `extra` - any other parameters, merged last

    **Example**

    ```hot
    built ::dropbox::oauth/build-authorize-params({scope: ["files.content.read"], locale: "de"})
    built.params  // {token_access_type: "offline", scope: "files.content.read", locale: "de"}
    ```
    """
}
fn (opts: Map): Map {
  verifier get(opts, "code-verifier")
  challenge or(get(opts, "code-challenge"), if(::dropbox/is-blank(verifier), null, pkce-challenge(verifier)))
  access if(in("token-access-type", keys(opts)), get(opts, "token-access-type"), "offline")
  {
    params: filter-vals({
      token_access_type: access,
      scope: scope-str(get(opts, "scope")),
      include_granted_scopes: get(opts, "include-granted-scopes"),
      force_reapprove: bool-param(get(opts, "force-reapprove")),
      force_reauthentication: bool-param(get(opts, "force-reauthentication")),
      disable_signup: bool-param(get(opts, "disable-signup")),
      require_role: get(opts, "require-role"),
      locale: get(opts, "locale"),
      ...or(get(opts, "extra"), {})
    }, is-some),
    code-challenge: challenge
  }
}

authorize-url
meta {
    doc: """
    Build the Dropbox consent URL
    (`https://www.dropbox.com/oauth2/authorize`). `app-key` is the App
    Console key; `redirect-uri` must be registered there (null for the
    no-redirect flow, where Dropbox shows the code to the user); `state`
    is your CSRF token. See `build-authorize-params` for `opts`.

    ```hot
    url ::dropbox::oauth/authorize-url("abc123appkey", "https://app.example.com/oauth/dropbox", "csrf-123")
    ```
    """
}
fn
(app-key: Str, redirect-uri: Str?, state: Str?): Str {
  authorize-url(app-key, redirect-uri, state, {})
},
(app-key: Str, redirect-uri: Str?, state: Str?, opts: Map): Str {
  built build-authorize-params(opts)
  ::oauth2/authorize-url(filter-vals({
    authorize-url: ::dropbox/AUTHORIZE_URL,
    client-id: app-key,
    redirect-uri: if(::dropbox/is-blank(redirect-uri), null, redirect-uri),
    state: if(::dropbox/is-blank(state), null, state),
    code-challenge: built.code-challenge,
    extra: built.params
  }, is-some))
}

exchange-code
meta {
    doc: """
    Exchange an authorization code for tokens at
    `https://api.dropboxapi.com/oauth2/token`. Returns Dropbox's token
    response (`access_token`, `expires_in`, `token_type`, `refresh_token`
    when offline, `scope`, `account_id`, `uid`, `team_id`), or a
    `::dropbox::auth/TokenError`. The tokens are marked as secrets.
    `app-secret` may be null for a PKCE flow; `redirect-uri` must match the one sent to `authorize-url`
    (null when none was). `opts.code-verifier` completes a PKCE flow.

    **Example**

    ```hot
    redirect "https://app.example.com/oauth/dropbox"
    tokens ::dropbox::oauth/exchange-code("abc123appkey", ::hot::ctx/get("dropbox.app.secret"), "code-from-query", redirect)
    tokens.refresh_token

    // PKCE: no app secret, send the verifier from the authorize step
    pkce ::dropbox::oauth/exchange-code("abc123appkey", null, "code-from-query", redirect, {
      code-verifier: ::hot::ctx/get("oauth.pkce.verifier")
    })
    pkce.account_id
    ```
    """
}
fn
(app-key: Str, app-secret: Str?, code: Str, redirect-uri: Str?): Map {
  exchange-code(app-key, app-secret, code, redirect-uri, {})
},
(app-key: Str, app-secret: Str?, code: Str, redirect-uri: Str?, opts: Map): Map {
  ::auth/mark-values([app-secret, code])
  tokens ::oauth2/exchange-code(::dropbox/TOKEN_URL, filter-vals({
    client-id: app-key,
    client-secret: if(::dropbox/is-blank(app-secret), null, app-secret),
    code: code,
    redirect-uri: if(::dropbox/is-blank(redirect-uri), null, redirect-uri),
    code-verifier: get(opts, "code-verifier")
  }, is-some))
  if(is-err(tokens), err(::auth/token-error("dropbox: code exchange failed", err-value(tokens))), ::auth/mark-tokens(tokens))
}

refresh-access-token
meta {
    doc: """
    Exchange a refresh token for a fresh access token (no cache). Returns
    the token response or a `TokenError`; a revoked refresh token yields
    `error-code: "invalid_grant"`, so ask the user to connect again.

    **Example**

    ```hot
    tokens ::dropbox::oauth/refresh-access-token("abc123appkey", ::hot::ctx/get("dropbox.app.secret"), ::hot::ctx/get("dropbox.refresh.token"))
    tokens.access_token
    ```
    """
}
fn (app-key: Str, app-secret: Str?, refresh-token: Str): Map {
  ::auth/refresh-token-grant(app-key, if(::dropbox/is-blank(app-secret), null, app-secret), refresh-token)
}

revoke-token
meta {
    doc: """
    POST /2/auth/token/revoke - revoke an access token. Dropbox also
    disables the refresh token it came from and every other access token
    minted from it, so this is how an app disconnects a user. Pass a
    fresh access token (mint one with `refresh-access-token` when you
    only stored the refresh token). Returns true, or a `TokenError`.

    **Example**

    ```hot
    // Disconnect this user: revokes the refresh token too
    ::dropbox::oauth/revoke-token(::dropbox::auth/access-token())
    ```
    """
}
fn (access-token: Str): Bool {
  ::auth/mark-values([access-token])
  response ::http/request(::http/HttpRequest({
    method: "POST",
    url: `${::dropbox/API_URL}${REVOKE_PATH}`,
    headers: {Authorization: `Bearer ${access-token}`},
    body: ""
  }))
  cond {
    is-err(response) => { err(::auth/token-error("dropbox: token revocation failed", err-value(response))) }
    ::http/is-ok-response(response) => { true }
    => { err(::auth/token-error("dropbox: token revocation failed", {status: response.status, body: response.body})) }
  }
}

granted-scopes
meta {
    doc: """
    The scopes a token response says were granted (`scope` split on spaces).

    **Example**

    ```hot
    ::dropbox::oauth/granted-scopes({scope: "files.content.read sharing.write"})  // ["files.content.read", "sharing.write"]
    ```
    """
}
fn (tokens: Map): Vec {
  filter(split(or(tokens.scope, ""), " "), (s) { not(is-empty(s)) })
}

missing-scopes
meta {
    doc: """
    The `required` scopes (Vec or space/comma separated Str) that a token
    response did not grant. Empty when everything was granted.

    **Example**

    ```hot
    ::dropbox::oauth/missing-scopes({scope: "files.content.read"}, ["files.content.read", "sharing.write"])  // ["sharing.write"]
    ```
    """
}
fn (tokens: Map, required: Str | Vec): Vec {
  granted granted-scopes(tokens)
  wanted if(is-vec(required), required, split(or(scope-str(required), ""), " "))
  filter(wanted, (s) { and(not(is-empty(s)), not(in(s, granted))) })
}
