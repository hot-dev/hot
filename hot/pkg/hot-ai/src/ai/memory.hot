::ai::memory ns
meta {
    doc: "Session-scoped agent memory with three storage levels: session (shared conversation history), user (per-user persistent data), and KB (shared domain knowledge)."
}

::store   ::hot::store
::time    ::hot::time
::session ::ai::session

Session  ::session/Session
Identity ::session/Identity
Message  ::ai::message/Message
Role     ::ai::message/Role
EmbeddingOptions ::store/EmbeddingOptions

// ============================================================================
// AgentMemory — bundles the three scoped stores
// ============================================================================

AgentMemory
meta {
    doc: "Bundles three scoped stores for an agent + session + identity combination."
}
type {
    agent-name: Str,
    // Field types fully qualified to dodge the same alias-resolution
    // glitch as the constructors below — see the long comment in
    // `create-memory`.
    session-store: ::hot::store/Map,
    user-store: ::hot::store/Map,
    kb-store: ::hot::store/Map,
}

MemoryOptions
meta {
    doc: """
    Optional store configuration for `create-memory-with-options`.

    `embedding` is the default for session and KB memory stores.
    `session-embedding` and `kb-embedding` override that default for
    their specific stores. Pass `::hot::store/EmbeddingOptions.Default` for
    system defaults, `::hot::store/EmbeddingOptions.Off` to disable, or
    `::hot::store/Embedding({...})` for Hot-level providers.
    """
}
type {
    embedding: ::hot::store/EmbeddingOptions?,
    session-embedding: ::hot::store/EmbeddingOptions?,
    kb-embedding: ::hot::store/EmbeddingOptions?,
}

MemoryProvenance
meta { doc: "Evidence pointer for remembered, compacted, or graph-extracted memory." }
type {
    source: Str?,
    source-id: Str?,
    session-id: Str?,
    user-id: Str?,
    message-id: Str?,
    key: Str?,
    timestamp: Int?,
    score: Dec?,
    metadata: Map?,
}

MemoryRecord
meta { doc: "Stable export shape for one memory store entry." }
type {
    id: Str,
    kind: Str,
    content: Str?,
    timestamp: Int?,
    metadata: Map?,
    provenance: MemoryProvenance?,
}

MemoryFact
meta { doc: "Structured long-term fact extracted from raw memory or a capsule." }
type {
    id: Str,
    subject: Str,
    predicate: Str,
    object: Str,
    confidence: Dec?,
    provenance: Vec<MemoryProvenance>?,
    metadata: Map?,
}

MemoryDecision
meta { doc: "Structured decision extracted from team or personal memory." }
type {
    id: Str,
    decision: Str,
    owner: Str?,
    rationale: Str?,
    decided-at: Int?,
    confidence: Dec?,
    provenance: Vec<MemoryProvenance>?,
    metadata: Map?,
}

MemoryTask
meta { doc: "Structured task or commitment extracted from memory." }
type {
    id: Str,
    title: Str,
    owner: Str?,
    due-at: Int?,
    status: Str?,
    confidence: Dec?,
    provenance: Vec<MemoryProvenance>?,
    metadata: Map?,
}

MemoryCapsule
meta { doc: "Durable compacted summary of a source memory window." }
type {
    id: Str,
    summary: Str,
    start-ts: Int?,
    end-ts: Int?,
    source-ids: Vec<Str>,
    facts: Vec<MemoryFact>?,
    decisions: Vec<MemoryDecision>?,
    tasks: Vec<MemoryTask>?,
    open-questions: Vec<Str>?,
    provenance: Vec<MemoryProvenance>?,
    metadata: Map?,
}

MemoryNode
meta { doc: "Graph-RAG node persisted in a memory graph." }
type {
    id: Str,
    kind: Str,
    label: Str,
    summary: Str?,
    confidence: Dec?,
    provenance: Vec<MemoryProvenance>?,
    metadata: Map?,
}

MemoryEdge
meta { doc: "Graph-RAG edge persisted in a memory graph." }
type {
    id: Str,
    from: Str,
    to: Str,
    relation: Str,
    weight: Dec?,
    confidence: Dec?,
    provenance: Vec<MemoryProvenance>?,
    metadata: Map?,
}

Citation
meta { doc: "Normalized citation returned by retrieval and graph expansion." }
type {
    id: Str,
    label: Str?,
    excerpt: Str?,
    score: Dec?,
    provenance: MemoryProvenance?,
}

MemoryExport
meta { doc: "Portable export bundle for an AgentMemory scope." }
type {
    agent-name: Str,
    session: Vec<MemoryRecord>,
    user: Vec<MemoryRecord>,
    kb: Vec<MemoryRecord>,
    thread: Vec?,
    metadata: Map?,
}

create-memory
meta {
    doc: """
    Build an AgentMemory with all three scoped stores.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    mem.agent-name
    ```
    """
}
fn (agent-name: Str, session: Session, identity: Identity): AgentMemory {
    create-memory-with-options(agent-name, session, identity, null)
}

create-memory-with-options
meta {
    doc: """
    Build an AgentMemory, optionally overriding session/KB embedding
    configuration.

    **Example**

    ```hot
    ::mem ::ai::memory
    opts ::mem/MemoryOptions({embedding: ::hot::store/EmbeddingOptions.Off})
    mem ::mem/create-memory-with-options(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"}),
        opts
    )
    mem.session-store
    ```
    """
}
fn (agent-name: Str, session: Session, identity: Identity, opts: MemoryOptions?): AgentMemory {
    embedding cond {
        is-null(opts) => { EmbeddingOptions.Default }
        is-null(opts.embedding) => { EmbeddingOptions.Default }
        => { opts.embedding }
    }

    session-embedding cond {
        is-null(opts) => { embedding }
        is-null(opts.session-embedding) => { embedding }
        => { opts.session-embedding }
    }

    kb-embedding cond {
        is-null(opts) => { embedding }
        is-null(opts.kb-embedding) => { embedding }
        => { opts.kb-embedding }
    }

    // NOTE: The constructor calls below use the fully qualified
    // `::hot::store/Map(...)` form even though `::store ::hot::store`
    // is aliased at the top of this file. Hot's compiler does not
    // currently rewrite the alias for type-constructor calls in
    // certain dispatch contexts (likely because `Map` is also a core
    // generic type name), so `::store/Map(...)` slips through to the
    // VM and fails with `Qualified function '::store/Map' not found`.
    // Other `::store/...` calls in this file (put, get, search, …)
    // resolve correctly. Use the long form here until the compiler is
    // taught to disambiguate the type-named constructor.
    // user-store is keyed under (session, identity) — see
    // `::ai::session/session-user-key` for the rationale. Without that,
    // the same person showing up in two different sessions (e.g. a
    // Telegram group + a Slack channel) would share a single profile
    // store, which is almost never what callers want.
    AgentMemory({
        agent-name: agent-name,
        session-store: ::hot::store/Map({
            name: ::session/session-key(agent-name, session, "memory"),
            embedding: session-embedding,
        }),
        user-store: ::hot::store/Map({
            name: ::session/session-user-key(agent-name, session, identity, "profile"),
        }),
        kb-store: ::hot::store/Map({
            name: ::session/agent-key(agent-name, "kb"),
            embedding: kb-embedding,
        }),
    })
}

// ============================================================================
// Session memory — conversation history
// ============================================================================

remember
meta {
    doc: """
    Store a Message in session memory. Auto-generates a time-based key.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/remember(mem, ::ai::message/Message({
        id: "m1",
        content: "Order 42 never arrived.",
        sender: ::ai::session/Identity({id: "u1", name: "Ada"}),
        session: ::ai::session/Session({id: "slack:C123"}),
        timestamp: 1767225600,
        source: "slack"
    }))
    ```
    """
}
fn (mem: AgentMemory, message: Message): Any {
    key `${message.timestamp}:${message.id}`
    ::store/put(mem.session-store, key, {
        content: message.content,
        sender-id: message.sender.id,
        sender-name: or(message.sender.name, message.sender.id),
        source: message.source,
        timestamp: message.timestamp,
        metadata: message.metadata,
    })
}

recent
meta {
    doc: """
    Retrieve recent messages from session memory. Options: hours (default
    24), limit (default 100).

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    entries ::mem/recent(mem, {hours: 6, limit: 20})
    map(entries, %.value.content)
    ```
    """
}
fn (mem: AgentMemory, opts: Map?): Vec {
    hours get(or(opts, {}), "hours", 24)
    limit get(or(opts, {}), "limit", 100)
    // `::time/now` returns an `Instant` record; go through
    // `epoch-millis` because Hot has no `Instant -> Int` coercion.
    since sub(div(::time/epoch-millis(::time/now()), 1000), mul(hours, 3600))
    results ::store/filter(mem.session-store, (k, v) { gte(v.timestamp, since) })
    slice(results, 0, limit)
}

recall
meta {
    doc: """
    Semantic search over session memory. Options: limit (default 10),
    min-score (default 0.5).

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    hits ::mem/recall(mem, "missing order", {limit: 5, min-score: 0.7})
    map(hits, %.value.content)
    ```
    """
}
fn (mem: AgentMemory, query: Str, opts: Map?): Vec {
    search-opts {
        limit: get(or(opts, {}), "limit", 10),
        min-score: get(or(opts, {}), "min-score", 0.5),
    }

    ::store/search(mem.session-store, query, search-opts)
}

forget-session
meta {
    doc: """
    Clear all entries in session memory.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/forget-session(mem)
    ```
    """
}
fn (mem: AgentMemory): Bool {
    ::store/clear(mem.session-store)
}

memory-provenance
meta {
    doc: """
    Build provenance for a store entry returned by `::hot::store/list`,
    `filter`, or `search`.

    **Example**

    ```hot
    entry {key: "1767225600:m1", score: 0.92, value: {
        content: "Order 42 never arrived.",
        sender-id: "u1",
        source: "slack",
        timestamp: 1767225600,
        metadata: {message_id: "m1"}
    }}
    prov ::ai::memory/memory-provenance(entry, "session")
    prov.message-id  // "m1"
    prov.source  // "slack"
    prov.score  // 0.92
    ```
    """
}
fn (entry: Map, kind: Str): MemoryProvenance {
    v entry.value
    md or(v.metadata, {})
    MemoryProvenance({
        source: or(v.source, kind),
        source-id: or(get(md, "source_id"), get(md, "message_id"), entry.key),
        session-id: get(md, "session_id"),
        user-id: v.sender-id,
        message-id: get(md, "message_id"),
        key: entry.key,
        timestamp: v.timestamp,
        score: entry.score,
        metadata: md,
    })
}

entry-record
meta {
    doc: """
    Convert a store entry to a stable MemoryRecord export shape.

    **Example**

    ```hot
    entry {key: "1767225600:m1", score: 0.92, value: {
        content: "Order 42 never arrived.",
        sender-id: "u1",
        source: "slack",
        timestamp: 1767225600,
        metadata: {message_id: "m1"}
    }}
    record ::ai::memory/entry-record(entry, "session")
    record.id  // "1767225600:m1"
    record.content  // "Order 42 never arrived."
    ```
    """
}
fn (entry: Map, kind: Str): MemoryRecord {
    v entry.value
    MemoryRecord({
        id: entry.key,
        kind: kind,
        content: or(v.content, v.summary, v.label, to-json(v)),
        timestamp: v.timestamp,
        metadata: v.metadata,
        provenance: memory-provenance(entry, kind),
    })
}

list-session-records
meta {
    doc: """
    Export session memory entries as MemoryRecord values.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    map(::mem/list-session-records(mem), %.content)
    ```
    """
}
fn (mem: AgentMemory): Vec<MemoryRecord> {
    map(::store/list(mem.session-store), (entry) { entry-record(entry, "session") })
}

list-user-records
meta {
    doc: """
    Export user-profile entries as MemoryRecord values.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    map(::mem/list-user-records(mem), %.id)
    ```
    """
}
fn (mem: AgentMemory): Vec<MemoryRecord> {
    map(::store/list(mem.user-store), (entry) { entry-record(entry, "user") })
}

list-kb-records
meta {
    doc: """
    Export KB entries as MemoryRecord values.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    map(::mem/list-kb-records(mem), %.content)
    ```
    """
}
fn (mem: AgentMemory): Vec<MemoryRecord> {
    map(::store/list(mem.kb-store), (entry) { entry-record(entry, "kb") })
}

delete-entries
meta {
    doc: """
    Delete store entries and return the count deleted.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    stale ::hot::store/filter(mem.session-store, (k, v) { eq(v.source, "slack") })
    ::mem/delete-entries(mem.session-store, stale)
    ```
    """
}
fn (store: ::hot::store/Map, entries: Vec): Int {
    map(entries, (entry) { ::store/delete(store, entry.key) })
    length(entries)
}

forget-session-range
meta {
    doc: """
    Delete session memory entries whose `timestamp` is within the inclusive
    range.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/forget-session-range(mem, 1767225600, 1767312000)
    ```
    """
}
fn (mem: AgentMemory, start-ts: Int, end-ts: Int): Int {
    entries ::store/filter(mem.session-store, (k, v) {
        and(gte(or(v.timestamp, 0), start-ts), lte(or(v.timestamp, 0), end-ts))
    })
    delete-entries(mem.session-store, entries)
}

forget-session-where
meta {
    doc: """
    Delete session memory entries matching a predicate `(key, value) ->
    Bool`.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/forget-session-where(mem, (k, v) { eq(v.sender-id, "u1") })
    ```
    """
}
fn (mem: AgentMemory, predicate: Fn): Int {
    entries ::store/filter(mem.session-store, predicate)
    delete-entries(mem.session-store, entries)
}

forget-by-source-id
meta {
    doc: """
    Delete session memory entries with matching key, `metadata.source_id`,
    or `metadata.message_id`.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/forget-by-source-id(mem, "m1")
    ```
    """
}
fn (mem: AgentMemory, source-id: Str): Int {
    entries ::store/filter(mem.session-store, (k, v) {
        md or(v.metadata, {})
        or(eq(k, source-id), eq(Str(or(get(md, "source_id"), "")), source-id), eq(Str(or(get(md, "message_id"), "")), source-id))
    })
    delete-entries(mem.session-store, entries)
}

forget-user-key
meta {
    doc: """
    Delete one key from user memory.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/forget-user-key(mem, "timezone")
    ```
    """
}
fn (mem: AgentMemory, key: Str): Bool {
    ::store/delete(mem.user-store, key)
}

forget-kb-key
meta {
    doc: """
    Delete one key from the shared KB.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/forget-kb-key(mem, "refund-policy")
    ```
    """
}
fn (mem: AgentMemory, key: Str): Bool {
    ::store/delete(mem.kb-store, key)
}

export-memory
meta {
    doc: """
    Export session, user, and KB records for this memory scope.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    bundle ::mem/export-memory(mem)
    length(bundle.session)
    bundle.metadata.exported-at
    ```
    """
}
fn
(mem: AgentMemory): MemoryExport {
    export-memory(mem, null)
},
(mem: AgentMemory, t: Thread?): MemoryExport {
    thread-data if(is-null(t), [], ::store/list(t.store))
    MemoryExport({
        agent-name: mem.agent-name,
        session: list-session-records(mem),
        user: list-user-records(mem),
        kb: list-kb-records(mem),
        thread: thread-data,
        metadata: {exported-at: div(::time/epoch-millis(::time/now()), 1000)},
    })
}

// ============================================================================
// User memory — per-user persistent data
// ============================================================================

get-user-data
meta {
    doc: """
    Read a value from the user's persistent store.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/get-user-data(mem, "timezone")
    ```
    """
}
fn (mem: AgentMemory, key: Str): Any {
    ::store/get(mem.user-store, key)
}

set-user-data
meta {
    doc: """
    Write a value to the user's persistent store.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/set-user-data(mem, "timezone", "Europe/Paris")
    ```
    """
}
fn (mem: AgentMemory, key: Str, value: Any): Any {
    ::store/put(mem.user-store, key, value)
}

// ============================================================================
// Knowledge base — shared domain knowledge
// ============================================================================

learn
meta {
    doc: """
    Add an entry to the shared knowledge base. Auto-embedded for search.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/learn(mem, "refund-policy", {content: "Refunds take 5 business days."})
    ```
    """
}
fn (mem: AgentMemory, key: Str, content: Map): Any {
    ::store/put(mem.kb-store, key, content)
}

search-kb
meta {
    doc: """
    Semantic search over the shared knowledge base. Options: limit (default
    5).

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    hits ::mem/search-kb(mem, "refunds", {limit: 3})
    map(hits, %.value.content)
    ```
    """
}
fn (mem: AgentMemory, query: Str, opts: Map?): Vec {
    limit get(or(opts, {}), "limit", 5)
    ::store/search(mem.kb-store, query, {limit: limit})
}

// ============================================================================
// Per-user conversation threads (multi-turn /ask)
// ============================================================================

Thread
meta { doc: "A per-user conversation thread for multi-turn interactions." }
type {
    store: ::hot::store/Map,
    turn-limit: Int
}

thread
meta {
    doc: """
    Create or get a per-(session, user) thread store for multi-turn
    interactions. Options: `max-turns` (default 20).

    The thread is scoped to (session, identity) so the same user in a
    different session has an independent thread. Pass the same
    `session` you used to build `AgentMemory` so memory and thread
    stay aligned.

    **Example**

    ```hot
    ::mem ::ai::memory
    t ::mem/thread(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"}),
        {max-turns: 10}
    )
    t.turn-limit
    ```
    """
}
fn (agent-name: Str, session: Session, identity: Identity, opts: Map?): Thread {
    max-turns get(or(opts, {}), "max-turns", 20)
    Thread({
        // See note in create-memory about the fully qualified
        // ::hot::store/Map(...) — same compiler limitation applies.
        store: ::hot::store/Map({
            name: ::session/session-user-key(agent-name, session, identity, "thread"),
        }),
        turn-limit: max-turns,
    })
}

thread-add
meta {
    doc: """
    Append a message to a conversation thread.

    **Example**

    ```hot
    ::mem ::ai::memory
    t ::mem/thread(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"}),
        {max-turns: 10}
    )
    ::mem/thread-add(t, ::ai::message/Role.User, "Where is order 42?")
    ::mem/thread-add(t, ::ai::message/Role.Assistant, "It shipped on Monday.")
    ```
    """
}
fn (t: Thread, role: Role, content: Str): Any {
    // Same `::time/now -> Int` workaround as in `recent` above.
    key `${div(::time/epoch-millis(::time/now()), 1000)}:${Uuid()}`
    role-str match role {
        Role.User      => { "user" }
        Role.Assistant => { "assistant" }
        Role.System    => { "system" }
        Role.Tool      => { "tool" }
    }

    ::store/put(t.store, key, {role: role-str, content: content})

    // Prune if over turn-limit (each turn = 2 messages: user + assistant)
    max-messages mul(t.turn-limit, 2)
    count ::store/length(t.store)
    cond {
        gt(count, max-messages) => {
        excess sub(count, max-messages)
        to-remove ::store/slice(t.store, 0, excess)
        map(to-remove, (entry) { ::store/delete(t.store, entry.key) })
    }
    }
}

thread-history
meta {
    doc: """
    Get the recent thread history as ChatMessages. Options: limit (default
    all).

    **Example**

    ```hot
    ::mem ::ai::memory
    t ::mem/thread(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"}),
        {max-turns: 10}
    )
    // The last four messages, oldest first
    history ::mem/thread-history(t, {limit: 4})
    ::ai::message/format-chat-messages(history)
    ```
    """
}
fn (t: Thread, opts: Map?): Vec {
    entries ::store/list(t.store)
    limited cond {
        is-some(opts) => {
            lim get(opts, "limit", length(entries))
            tail-start max(sub(length(entries), lim), 0)
            slice(entries, tail-start)
        }
        => { entries }
    }

    map(limited, (entry) {
        ::ai::message/ChatMessage({
            role: match entry.value.role {
                "user"      => { Role.User }
                "assistant" => { Role.Assistant }
                "system"    => { Role.System }
                "tool"      => { Role.Tool }
                =>          { Role.User }
            },
            content: entry.value.content,
        })
    })
}

thread-clear
meta {
    doc: """
    Reset a conversation thread.

    **Example**

    ```hot
    ::mem ::ai::memory
    t ::mem/thread(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"}),
        {max-turns: 10}
    )
    ::mem/thread-clear(t)
    ```
    """
}
fn (t: Thread): Bool {
    ::store/clear(t.store)
}

// ============================================================================
// Capsules — durable compacted memory
// ============================================================================

capsule-key
meta {
    doc: """
    Return the KB key used for a memory capsule.

    **Example**

    ```hot
    ::ai::memory/capsule-key("2026-11-09")  // "capsule:2026-11-09"
    ```
    """
}
fn (id: Str): Str {
    `capsule:${id}`
}

capsule-from-window
meta {
    doc: """
    Build a MemoryCapsule from a summary and source store entries.

    **Example**

    ```hot
    entry {key: "1767225600:m1", score: 0.92, value: {
        content: "Order 42 never arrived.",
        sender-id: "u1",
        source: "slack",
        timestamp: 1767225600,
        metadata: {message_id: "m1"}
    }}
    capsule ::ai::memory/capsule-from-window("c1", "Ada reported a missing order.", [entry], null)
    capsule.source-ids  // ["m1"]
    capsule.start-ts  // 1767225600
    ```
    """
}
fn (id: Str, summary: Str, entries: Vec, opts: Map?): MemoryCapsule {
    timestamps map(entries, (entry) { or(entry.value.timestamp, 0) })
    source-ids map(entries, (entry) {
        md or(entry.value.metadata, {})
        or(get(md, "source_id"), get(md, "message_id"), entry.key)
    })
    provenance map(entries, (entry) { memory-provenance(entry, "session") })
    MemoryCapsule({
        id: id,
        summary: summary,
        start-ts: get(or(opts, {}), "start-ts", first(timestamps)),
        end-ts: get(or(opts, {}), "end-ts", last(timestamps)),
        source-ids: source-ids,
        facts: get(or(opts, {}), "facts", []),
        decisions: get(or(opts, {}), "decisions", []),
        tasks: get(or(opts, {}), "tasks", []),
        open-questions: get(or(opts, {}), "open-questions", []),
        provenance: provenance,
        metadata: get(or(opts, {}), "metadata", {}),
    })
}

store-capsule
meta {
    doc: """
    Persist a MemoryCapsule in the KB store with provenance and
    embedding-friendly content.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/store-capsule(mem, ::mem/MemoryCapsule({
        id: "c1",
        summary: "Ada reported a missing order.",
        source-ids: ["m1"]
    }))
    ```
    """
}
fn (mem: AgentMemory, capsule: MemoryCapsule): Any {
    ::store/put(mem.kb-store, capsule-key(capsule.id), {
        kind: "memory-capsule",
        id: capsule.id,
        content: capsule.summary,
        summary: capsule.summary,
        start-ts: capsule.start-ts,
        end-ts: capsule.end-ts,
        source-ids: capsule.source-ids,
        facts: capsule.facts,
        decisions: capsule.decisions,
        tasks: capsule.tasks,
        open-questions: capsule.open-questions,
        provenance: capsule.provenance,
        metadata: capsule.metadata,
    })
}

get-capsule
meta {
    doc: """
    Load a stored MemoryCapsule by id.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/get-capsule(mem, "c1").summary
    ```
    """
}
fn (mem: AgentMemory, id: Str): Any {
    ::store/get(mem.kb-store, capsule-key(id))
}

list-capsules
meta {
    doc: """
    List all memory capsule KB entries.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    map(::mem/list-capsules(mem), %.value.summary)
    ```
    """
}
fn (mem: AgentMemory): Vec {
    ::store/filter(mem.kb-store, (k, v) { eq(v.kind, "memory-capsule") })
}

recall-with-capsules
meta {
    doc: """
    Retrieve raw session memory plus compacted capsules for a query.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    result ::mem/recall-with-capsules(mem, "missing order", {limit: 5})
    length(result.raw)
    map(result.capsules, %.value.summary)
    ```
    """
}
fn (mem: AgentMemory, query: Str, opts: Map?): Map {
    limit get(or(opts, {}), "limit", 10)
    raw recall(mem, query, opts)
    capsules ::store/search(mem.kb-store, query, {limit: limit, kind: "memory-capsule"})
    {raw: raw, capsules: capsules}
}

// ============================================================================
// Graph memory — store-backed graph-RAG primitives
// ============================================================================

graph-node-key
meta {
    doc: """
    Return the KB key used for a graph node.

    **Example**

    ```hot
    ::ai::memory/graph-node-key("topic:refunds")  // "graph:node:topic:refunds"
    ```
    """
}
fn (id: Str): Str {
    `graph:node:${id}`
}

graph-edge-key
meta {
    doc: """
    Return the KB key used for a graph edge.

    **Example**

    ```hot
    ::ai::memory/graph-edge-key("e1")  // "graph:edge:e1"
    ```
    """
}
fn (id: Str): Str {
    `graph:edge:${id}`
}

candidate-node
meta {
    doc: """
    Build a graph node candidate with provenance and confidence.

    **Example**

    ```hot
    prov [::ai::memory/MemoryProvenance({source: "slack", message-id: "m1"})]
    node ::ai::memory/candidate-node("topic", "Late Refunds", prov, null)
    node.id  // "topic:late-refunds"
    node.confidence  // 0.7
    ```
    """
}
fn (kind: Str, label: Str, provenance: Vec<MemoryProvenance>, opts: Map?): MemoryNode {
    fallback-id `${kind}:${replace(lowercase(label), " ", "-")}`
    id get(or(opts, {}), "id", fallback-id)
    MemoryNode({
        id: id,
        kind: kind,
        label: label,
        summary: get(or(opts, {}), "summary", label),
        confidence: get(or(opts, {}), "confidence", 0.7),
        provenance: provenance,
        metadata: get(or(opts, {}), "metadata", {}),
    })
}

candidate-edge
meta {
    doc: """
    Build a graph edge candidate with provenance and confidence.

    **Example**

    ```hot
    prov [::ai::memory/MemoryProvenance({source: "slack", message-id: "m1"})]
    edge ::ai::memory/candidate-edge("person:ada", "reported", "topic:refunds", prov, {weight: 2.0})
    edge.id  // "person:ada:reported:topic:refunds"
    edge.weight  // 2.0
    ```
    """
}
fn (from: Str, relation: Str, to: Str, provenance: Vec<MemoryProvenance>, opts: Map?): MemoryEdge {
    id get(or(opts, {}), "id", `${from}:${relation}:${to}`)
    MemoryEdge({
        id: id,
        from: from,
        to: to,
        relation: relation,
        weight: get(or(opts, {}), "weight", 1.0),
        confidence: get(or(opts, {}), "confidence", 0.7),
        provenance: provenance,
        metadata: get(or(opts, {}), "metadata", {}),
    })
}

extract-graph-candidates
meta {
    doc: """
    Convert structured extraction output into graph node/edge candidates.
    Expected shape: `{nodes: [{kind,label,...}], edges: [{from,relation,to,...}]}`.

    **Example**

    ```hot
    prov [::ai::memory/MemoryProvenance({source: "slack", message-id: "m1"})]
    found ::ai::memory/extract-graph-candidates({
        nodes: [{kind: "person", label: "Ada"}],
        edges: [{from: "person:ada", relation: "reported", to: "topic:refunds"}]
    }, prov)
    map(found.nodes, %.id)  // ["person:ada"]
    map(found.edges, %.relation)  // ["reported"]
    ```
    """
}
fn (structured: Map, provenance: Vec<MemoryProvenance>): Map {
    nodes map(or(structured.nodes, []), (n) {
        candidate-node(or(n.kind, "topic"), n.label, provenance, n)
    })
    edges map(or(structured.edges, []), (e) {
        candidate-edge(e.from, e.relation, e.to, provenance, e)
    })
    {nodes: nodes, edges: edges}
}

store-graph-candidates
meta {
    doc: """
    Persist graph node and edge candidates into memory stores.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/store-graph-candidates(mem, ::mem/extract-graph-candidates({
        nodes: [{kind: "person", label: "Ada"}],
        edges: []
    }, []))
    ```
    """
}
fn (mem: AgentMemory, candidates: Map): Map {
    nodes or(candidates.nodes, [])
    edges or(candidates.edges, [])
    map(nodes, (node) { store-node(mem, node) })
    map(edges, (edge) { store-edge(mem, edge) })
    {nodes: length(nodes), edges: length(edges)}
}

store-node
meta {
    doc: """
    Persist a graph-RAG node in the KB store.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/store-node(mem, ::mem/candidate-node("topic", "Refunds", [], null))
    ```
    """
}
fn (mem: AgentMemory, node: MemoryNode): Any {
    ::store/put(mem.kb-store, graph-node-key(node.id), {
        kind: "graph-node",
        id: node.id,
        node-kind: node.kind,
        label: node.label,
        content: or(node.summary, node.label),
        summary: node.summary,
        confidence: node.confidence,
        provenance: node.provenance,
        metadata: node.metadata,
    })
}

store-edge
meta {
    doc: """
    Persist a graph-RAG edge in the KB store.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    ::mem/store-edge(mem, ::mem/candidate-edge("person:ada", "reported", "topic:refunds", [], null))
    ```
    """
}
fn (mem: AgentMemory, edge: MemoryEdge): Any {
    ::store/put(mem.kb-store, graph-edge-key(edge.id), {
        kind: "graph-edge",
        id: edge.id,
        from: edge.from,
        to: edge.to,
        relation: edge.relation,
        content: `${edge.from} ${edge.relation} ${edge.to}`,
        weight: edge.weight,
        confidence: edge.confidence,
        provenance: edge.provenance,
        metadata: edge.metadata,
    })
}

list-nodes
meta {
    doc: """
    List all graph-RAG nodes in this memory scope.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    map(::mem/list-nodes(mem), %.value.label)
    ```
    """
}
fn (mem: AgentMemory): Vec {
    ::store/filter(mem.kb-store, (k, v) { eq(v.kind, "graph-node") })
}

list-edges
meta {
    doc: """
    List all graph-RAG edges in this memory scope.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    map(::mem/list-edges(mem), %.value.relation)
    ```
    """
}
fn (mem: AgentMemory): Vec {
    ::store/filter(mem.kb-store, (k, v) { eq(v.kind, "graph-edge") })
}

neighbor-edges
meta {
    doc: """
    Find graph edges touching a node id.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    map(::mem/neighbor-edges(mem, "topic:refunds"), %.value.content)
    ```
    """
}
fn (mem: AgentMemory, node-id: Str): Vec {
    ::store/filter(mem.kb-store, (k, v) {
        and(eq(v.kind, "graph-edge"), or(eq(v.from, node-id), eq(v.to, node-id)))
    })
}

citation-from-result
meta {
    doc: """
    Build a normalized Citation from a search/list result.

    **Example**

    ```hot
    citation ::ai::memory/citation-from-result({
        key: "graph:node:topic:refunds",
        score: 0.9,
        value: {id: "topic:refunds", label: "Refunds", content: "How refunds work."}
    })
    citation.label  // "Refunds"
    citation.excerpt  // "How refunds work."
    ```
    """
}
fn (result: Map): Citation {
    v result.value
    Citation({
        id: or(v.id, result.key),
        label: or(v.label, v.kind),
        excerpt: or(v.content, v.summary),
        score: result.score,
        provenance: if(is-some(v.provenance), first(v.provenance), memory-provenance(result, or(v.kind, "memory"))),
    })
}

graph-expand
meta {
    doc: """
    Expand seed node ids into neighboring graph edges and citations.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    graph ::mem/graph-expand(mem, ["topic:refunds"])
    map(graph.citations, %.excerpt)
    ```
    """
}
fn (mem: AgentMemory, seed-node-ids: Vec): Map {
    edges flatten(map(seed-node-ids, (id) { neighbor-edges(mem, id) }))
    citations map(edges, citation-from-result)
    {edges: edges, citations: citations}
}

hybrid-recall
meta {
    doc: """
    Hybrid retrieval: vector recall over raw/capsule/graph text plus graph
    expansion from explicit seed node ids.

    **Example**

    ```hot
    ::mem ::ai::memory
    mem ::mem/create-memory(
        "support-bot",
        ::ai::session/Session({id: "slack:C123"}),
        ::ai::session/Identity({id: "u1", name: "Ada"})
    )
    result ::mem/hybrid-recall(mem, "refund delays", {limit: 5, seed-node-ids: ["topic:refunds"]})
    length(result.vector)
    map(result.citations, %.label)
    ```
    """
}
fn (mem: AgentMemory, query: Str, opts: Map?): Map {
    limit get(or(opts, {}), "limit", 10)
    vector concat(recall(mem, query, opts), ::store/search(mem.kb-store, query, {limit: limit}))
    seed-node-ids get(or(opts, {}), "seed-node-ids", [])
    graph graph-expand(mem, seed-node-ids)
    citations concat(map(vector, citation-from-result), graph.citations)
    {
        vector: vector,
        graph: graph,
        citations: citations,
    }
}
