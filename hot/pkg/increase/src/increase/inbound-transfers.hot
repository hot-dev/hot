// Inbound Real-Time Payments and FedNow
// ---------------------------------------------------------------------------

list-inbound-rtp-transfers
meta {
    doc: """
    GET /inbound_real_time_payments_transfers: one page of Inbound Real-Time
    Payments Transfers. Filters: `account_id`, `account_number_id`,
    `created_at`, `limit`, `cursor`.

    **Example**

    ```hot
    page ::increase::inbound-transfers/list-inbound-rtp-transfers({account_id: "account_in71c4amph0vgo2qllky", limit: 25})
    map(page.data, %.id)
    ```
    """
}
fn
(): Map {
  list-inbound-rtp-transfers({})
},
(params: Map): Map {
  list-inbound-rtp-transfers(params, {})
},
(params: Map, opts: Map): Map {
  ::api/list-page("/inbound_real_time_payments_transfers", params, opts)
}

get-inbound-rtp-transfer
meta {
    doc: """
    GET /inbound_real_time_payments_transfers/{id}: retrieve an Inbound
    Real-Time Payments Transfer.

    **Example**

    ```hot
    transfer ::increase::inbound-transfers/get-inbound-rtp-transfer("inbound_real_time_payments_transfer_shp8pcdyn3xqm9hk1zh2")
    transfer.status
    transfer.amount
    ```
    """
}
fn
(inbound-rtp-transfer-id: Str): Map {
  get-inbound-rtp-transfer(inbound-rtp-transfer-id, {})
},
(inbound-rtp-transfer-id: Str, opts: Map): Map {
  ::api/call("GET", `/inbound_real_time_payments_transfers/${seg(inbound-rtp-transfer-id)}`, {}, opts)
}

return-inbound-rtp-transfer
meta {
    doc: """
    POST /inbound_real_time_payments_transfers/{id}/return: return a
    received Real-Time Payment to its sender as a new outbound transfer.
    `params` may set `amount` (cents; default the full amount). Needs an
    `idempotency-key`.

    **Example**

    ```hot
    ::increase::inbound-transfers/return-inbound-rtp-transfer("inbound_real_time_payments_transfer_shp8pcdyn3xqm9hk1zh2", {amount: 500},
      {idempotency-key: "return-inbound-rtp-shp8pc"})
    ```
    """
}
fn (inbound-rtp-transfer-id: Str, params: Map, opts: Map): Map {
  ::api/move-money(`/inbound_real_time_payments_transfers/${seg(inbound-rtp-transfer-id)}/return`, params, [], false, opts, "return-inbound-rtp-transfer")
}

