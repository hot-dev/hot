::xai::api ns
meta {
    doc: """
    Transport for the xAI API: the bearer `Authorization` header, the base
    URLs, and the credential resolvers.

    **Per-call credentials.** Every typed function takes a trailing
    `opts: Map`, which wins over ctx for that call. Nothing is kept in ctx,
    so one run can serve many tenants and parallel flows don't share keys.

    - `api-key`: overrides `xai.api.key`.
    - `base-url`: overrides `xai.base.url`.
    - `management-api-key`: overrides `xai.management.api.key`, used by the
      `::xai::collections` management calls.
    - `management-base-url`: overrides `xai.management.base.url`.

    A base URL in `opts` needs its matching key in `opts` too: a ctx key is
    never sent to a per-call URL. A base URL and key both set in ctx work as
    usual.

    **Call records.** A key passed in `opts` is masked in the run's call
    records, including inside strings like `Bearer ${key}`. A key shorter than
    8 bytes is masked only as a whole value.
    """
}

// Namespace alias for ctx module
::ctx ::hot::ctx

http-request ::hot::http/request
http-request-stream ::hot::http/request-stream
is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse
StreamingHttpResponse ::hot::http/StreamingHttpResponse

HttpError type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: response.headers,
    body: response.body
  })
}

non-blank
meta {
    doc: """
    `value`, or null when it is null or a blank Str.

    **Example**

    ```hot
    ::api ::xai::api

    ::api/non-blank("  ")  // null
    ::api/non-blank("grok-3")  // "grok-3"
    ```
    """
}
fn (value: Any): Any {
  cond {
    is-str(value) => { if(is-empty(trim(value)), null, value) }
    => { value }
  }
}

normalize-base-url
meta {
    doc: """
    Normalize a base URL: trims whitespace, drops trailing slashes, and falls
    back to `default-url` (`::xai/BASE_URL` when not given) when the value is
    null or empty.

    **Example**

    ```hot
    ::xai::api/normalize-base-url("https://gateway.example.com/v1/")  // => "https://gateway.example.com/v1"
    ::xai::api/normalize-base-url(null)                               // => "https://api.x.ai/v1"
    ```
    """
}
fn
(url: Str?): Str {
  normalize-base-url(url, ::xai/BASE_URL)
},
(url: Str?, default-url: Str): Str {
  trimmed trim(or(url, ""))
  cond {
    is-empty(trimmed) => { default-url }
    ends-with(trimmed, "/") => { normalize-base-url(slice(trimmed, 0, sub(length(trimmed), 1)), default-url) }
    => { trimmed }
  }
}

resolve-from
meta {
    doc: """
    The resolver for the main API, pure: settings for a call from `opts`
    first, then `ctx-values` (a Map of context variables), then defaults.
    Returns `{api-key, base-url}`, or an Err when no API key is set, when `api-key` in `opts` is
    blank (never a fallback to ctx, so a tenant with a missing key can't run
    on the project's key), or when `opts` has a `base-url` but no `api-key`
    (the ctx key is never sent to a per-call URL). Exposed
    for testing; `resolve` feeds it the context.

    **Example**

    ```hot
    ::xai::api/resolve-from({api-key: "k"}, {}).base-url  // => "https://api.x.ai/v1"
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  pick (key, ctx-key) { or(non-blank(get(opts, key)), non-blank(get(ctx-values, ctx-key))) }
  has-explicit-key in("api-key", keys(opts))
  api-key if(has-explicit-key, non-blank(get(opts, "api-key")), non-blank(get(ctx-values, "xai.api.key")))
  cond {
    and(has-explicit-key, is-null(api-key)) => {
      err("xai: api-key in the call's opts is blank. Pass the key, or leave api-key out to use xai.api.key.")
    }

    and(not(has-explicit-key), not(is-null(non-blank(get(opts, "base-url"))))) => {
      err("xai: base-url in the call's opts needs api-key in opts too. The xai.api.key ctx key is never sent to a per-call base URL.")
    }

    is-null(api-key) => {
      err("xai: no API key. Set xai.api.key in Context Variables, or pass {api-key: ...} in the call's opts.")
    }
    => {
      {
        api-key: api-key,
        base-url: normalize-base-url(pick("base-url", "xai.base.url"))
      }
    }
  }
}

resolve
meta {
    doc: """
    Settings for one main API call: `opts` over ctx over defaults (see
    `resolve-from`). With an `api-key` in `opts`, the ctx key is not read, and a blank one is
    an Err rather than a fallback to ctx. Nothing is written to ctx, and the
    key from `opts` is masked in the run's call records.

    **Example**

    ```hot
    ::xai::api/resolve({api-key: "tenant-key"}).base-url  // => "https://api.x.ai/v1"
    ```
    """,
    ctx: {
        "xai.api.key": {required: false},
        "xai.base.url": {required: false, default: "https://api.x.ai/v1", secret: false}
    }
}
fn
(): Map {
  resolve({})
},
(opts: Map): Map {
  options or(opts, {})
  ::ctx/mark-secret(options.api-key)
  has-explicit-key in("api-key", keys(options))
  resolve-from(options, {
    "xai.api.key": if(has-explicit-key, null, ::ctx/get("xai.api.key")),
    "xai.base.url": ::ctx/get("xai.base.url")
  })
}

resolve-management-from
meta {
    doc: """
    `resolve-from` for the Management API: `management-api-key` and
    `management-base-url` from `opts`, then `ctx-values`, then defaults.
    Returns `{api-key, base-url}`, or an Err when no management key is set,
    when `management-api-key` in `opts` is blank, or when `opts` has a
    `management-base-url` but no `management-api-key`.
    An `api-key` in `opts` is not used here: the two keys are different
    credentials.

    **Example**

    ```hot
    ::xai::api/resolve-management-from({management-api-key: "k"}, {}).base-url  // => "https://management-api.x.ai"
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  pick (key, ctx-key) { or(non-blank(get(opts, key)), non-blank(get(ctx-values, ctx-key))) }
  has-explicit-key in("management-api-key", keys(opts))
  api-key if(has-explicit-key, non-blank(get(opts, "management-api-key")), non-blank(get(ctx-values, "xai.management.api.key")))
  cond {
    and(has-explicit-key, is-null(api-key)) => {
      err("xai: management-api-key in the call's opts is blank. Pass the key, or leave management-api-key out to use xai.management.api.key.")
    }

    and(not(has-explicit-key), not(is-null(non-blank(get(opts, "management-base-url"))))) => {
      err("xai: management-base-url in the call's opts needs management-api-key in opts too. The xai.management.api.key ctx key is never sent to a per-call base URL.")
    }

    is-null(api-key) => {
      err("xai: no Management API key. Set xai.management.api.key in Context Variables, or pass {management-api-key: ...} in the call's opts.")
    }
    => {
      {
        api-key: api-key,
        base-url: normalize-base-url(pick("management-base-url", "xai.management.base.url"), ::xai/MANAGEMENT_BASE_URL)
      }
    }
  }
}

resolve-management
meta {
    doc: """
    Settings for one Management API call (see `resolve-management-from`).
    With a `management-api-key` in `opts`, the ctx key is not read, and a blank
    one is an Err rather than a fallback to ctx. Nothing is written to ctx, and
    the key from `opts` is masked in the run's call records.

    **Example**

    ```hot
    ::api ::xai::api

    settings ::api/resolve-management({management-api-key: ::hot::ctx/get("tenant.xai.management.key")})
    settings.base-url
    ```
    """,
    ctx: {
        "xai.management.api.key": {required: false},
        "xai.management.base.url": {required: false, default: "https://management-api.x.ai", secret: false}
    }
}
fn (opts: Map): Map {
  options or(opts, {})
  ::ctx/mark-secret(options.management-api-key)
  has-explicit-key in("management-api-key", keys(options))
  resolve-management-from(options, {
    "xai.management.api.key": if(has-explicit-key, null, ::ctx/get("xai.management.api.key")),
    "xai.management.base.url": ::ctx/get("xai.management.base.url")
  })
}

base-url
meta {
    doc: """
    The base URL main API calls go to: `opts.base-url`, then the
    `xai.base.url` ctx variable, then `https://api.x.ai/v1`. Set it to route
    calls through a proxy or gateway.

    **Example**

    ```hot
    ::xai::api/base-url()                                        // => "https://api.x.ai/v1"
    ::xai::api/base-url({base-url: "https://gw.example.com/v1"}) // => "https://gw.example.com/v1"
    ```
    """,
    ctx: {"xai.base.url": {required: false, default: "https://api.x.ai/v1", secret: false}}
}
fn
(): Str {
  base-url({})
},
(opts: Map): Str {
  normalize-base-url(or(non-blank(get(or(opts, {}), "base-url")), ::ctx/get("xai.base.url")))
}

build-headers
meta {
    doc: """
    Request headers from resolved settings (see `resolve`), pure:
    `Authorization: Bearer`, and `Content-Type` when there is a body. Exposed
    for testing.

    **Example**

    ```hot
    ::api ::xai::api

    ::api/build-headers({api-key: "test-key"}, false)  // {Authorization: "Bearer test-key"}
    ::api/build-headers({api-key: "test-key"}, true).Content-Type  // "application/json"
    ```
    """
}
fn (resolved: Map, has-body: Bool): Map {
  auth {Authorization: `Bearer ${resolved.api-key}`}
  if(has-body, {...auth, Content-Type: "application/json"}, auth)
}

build-request
meta {
    doc: """
    The outgoing `HttpRequest` for resolved settings, pure. `additional-headers`
    override the defaults. An empty or null `body` sends no body at all.
    Exposed for testing.

    **Example**

    ```hot
    resolved ::xai::api/resolve-from({api-key: "k"}, {})
    req ::xai::api/build-request("GET", "https://api.x.ai/v1/models", {}, "", resolved)
    req.headers  // {Authorization: "Bearer k"}
    ```
    """
}
fn (method: Str, url: Str, additional-headers: Map, body: Any, resolved: Map): HttpRequest {
  match body {
    "" | Null => {
      HttpRequest({
        method,
        url,
        headers: {...build-headers(resolved, false), ...additional-headers}
      })
    }

    _ => {
      HttpRequest({
        method,
        url,
        headers: {...build-headers(resolved, true), ...additional-headers},
        body: to-json(untype(body))
      })
    }
  }
}

call
meta {
    doc: """
    Resolve `opts` and send a request to `path` under the resolved base URL.
    The typed functions in this package go through here.

    **Example**

    ```hot
    response ::xai::api/call("GET", "/models", {}, "", {api-key: "tenant-key"})
    ```
    """,
    ctx: {
        "xai.api.key": {required: false},
        "xai.base.url": {required: false, default: "https://api.x.ai/v1", secret: false}
    }
}
fn (method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  resolved resolve(opts)
  ::hot::http/request(build-request(method, `${resolved.base-url}${path}`, additional-headers, body, resolved))
}

call-stream
meta {
    doc: """
    Streaming counterpart to `call`. Returns a `StreamingHttpResponse` whose
    body is an iterator of parsed SSE or NDJSON events.

    **Example**

    ```hot
    ::api ::xai::api

    response ::api/call-stream("POST", "/responses", {}, {model: "grok-3", input: "Hello", stream: true}, "sse", {})
    for-each(response.body, (event) { println(event) })
    ```
    """,
    ctx: {
        "xai.api.key": {required: false},
        "xai.base.url": {required: false, default: "https://api.x.ai/v1", secret: false}
    }
}
fn (method: Str, path: Str, additional-headers: Map, body: Any, format: Str, opts: Map): StreamingHttpResponse {
  resolved resolve(opts)
  ::hot::http/request-stream(build-request(method, `${resolved.base-url}${path}`, additional-headers, body, resolved), format)
}

management-call
meta {
    doc: """
    `call` for the Management API: resolves `management-api-key` and
    `management-base-url` (see `resolve-management`).

    **Example**

    ```hot
    response ::xai::api/management-call("GET", "/v1/collections", {}, "", {management-api-key: "tenant-key"})
    ```
    """,
    ctx: {
        "xai.management.api.key": {required: false},
        "xai.management.base.url": {required: false, default: "https://management-api.x.ai", secret: false}
    }
}
fn (method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  resolved resolve-management(opts)
  ::hot::http/request(build-request(method, `${resolved.base-url}${path}`, additional-headers, body, resolved))
}

request
meta {
    doc: """
    Make an authenticated HTTP request to the xAI API.

    Automatically includes the Authorization header using the xai.api.key from context.
    Additional headers can be provided to merge/override defaults. When a body is provided,
    Content-Type is set to application/json and the body is serialized.

    Supports 2 to 5 arguments: (method, url), (method, url, headers),
    (method, url, headers, body), or (method, url, headers, body, api-key).
    The last argument can also be an `opts` Map (see `resolve`).

    **Example**

    ```hot
    // Simple GET request
    response ::xai::api/request("GET", "https://api.x.ai/v1/models")

    // POST with body
    response ::xai::api/request("POST", "https://api.x.ai/v1/responses", {}, {
        model: "grok-3-mini",
        input: "Hello"
    })
    ```
    """,
    ctx: {"xai.api.key": {required: false}}
}
fn
(method: Str, url: Str): HttpResponse {
  request(method, url, {}, "")
},
(method: Str, url: Str, additional-headers: Map): HttpResponse {
  request(method, url, additional-headers, "")
},
// 4-arity: use ctx api key (default)
(method: Str, url: Str, additional-headers: Map, body: Any): HttpResponse {
  request(method, url, additional-headers, body, {})
},
// 5-arity: explicit api key override
(method: Str, url: Str, additional-headers: Map, body: Any, api-key: Str): HttpResponse {
  request(method, url, additional-headers, body, {api-key: api-key})
},
// 5-arity: per-call opts; `url` is used as given
(method: Str, url: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  ::hot::http/request(build-request(method, url, additional-headers, body, resolve(opts)))
}

request-stream
meta {
    doc: """
    Make an authenticated streaming HTTP request to the xAI API.

    Returns a StreamingHttpResponse with an iterator body for processing SSE events.
    Automatically includes the Authorization header using the xai.api.key from context.

    Supports 4 to 6 arguments: (method, url, headers, body),
    (method, url, headers, body, format), or (method, url, headers, body, format, api-key).
    The last argument can also be an `opts` Map (see `resolve`).

    **Example**

    ```hot
    response ::xai::api/request-stream("POST", "https://api.x.ai/v1/responses", {}, {
        model: "grok-3-mini",
        input: "Hello",
        stream: true
    })

    events collect(response.body)
    // events is a Vec of SSE event objects
    ```
    """,
    ctx: {"xai.api.key": {required: false}}
}
fn
(method: Str, url: Str, additional-headers: Map, body: Any): StreamingHttpResponse {
  request-stream(method, url, additional-headers, body, "sse")
},
// 5-arity: use ctx api key (default)
(method: Str, url: Str, additional-headers: Map, body: Any, format: Str): StreamingHttpResponse {
  request-stream(method, url, additional-headers, body, format, {})
},
// 6-arity: explicit api key override
(method: Str, url: Str, additional-headers: Map, body: Any, format: Str, api-key: Str): StreamingHttpResponse {
  request-stream(method, url, additional-headers, body, format, {api-key: api-key})
},
// 6-arity: per-call opts; `url` is used as given
(method: Str, url: Str, additional-headers: Map, body: Any, format: Str, opts: Map): StreamingHttpResponse {
  ::hot::http/request-stream(build-request(method, url, additional-headers, body, resolve(opts)), format)
}
