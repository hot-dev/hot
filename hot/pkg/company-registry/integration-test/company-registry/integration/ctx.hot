::company-registry::integration::ctx ns

::env ::hot::env

// Placeholder settings for the company-registry integration suite. Unset
// environment variables are skipped entirely, so absent credentials behave
// exactly as if never configured. GLEIF needs no key but only runs with
// COMPANY_REGISTRY_LIVE=1, so CI without network stays hermetic.
::hot::ctx/set(filter-vals({
    "company-registry.sec.user-agent": ::env/get("SEC_USER_AGENT", ""),
    "company-registry.companies-house.api-key": ::env/get("COMPANIES_HOUSE_API_KEY", ""),
    "company-registry.companies-house.base-url": ::env/get("COMPANIES_HOUSE_BASE_URL", ""),
}, (v) { not(is-empty(v)) }))

live
meta {doc: """True when COMPANY_REGISTRY_LIVE=1 (GLEIF, which needs no key)."""}
fn (): Bool {
    eq(::env/get("COMPANY_REGISTRY_LIVE", ""), "1")
}

configured
meta {
    doc: """True when the settings `source` needs are present: `"gleif"`, `"sec"` (SEC_USER_AGENT) or `"companies-house"` (COMPANIES_HOUSE_API_KEY)."""
}
fn (source: Str): Bool {
    cond {
        eq(source, "gleif") => { live() }
        eq(source, "sec") => { is-some(::hot::ctx/get("company-registry.sec.user-agent")) }
        eq(source, "companies-house") => { is-some(::hot::ctx/get("company-registry.companies-house.api-key")) }
        => { false }
    }
}

skip
meta {doc: """Record a skip and pass."""}
fn (why: Str): Bool {
    println(`company-registry integration: ${why} - skipping`)
    assert(true, `skipped: ${why}`)
}
