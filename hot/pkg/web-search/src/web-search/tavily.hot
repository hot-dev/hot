::web-search::tavily ns
meta {
    doc: """Tavily: search built for LLM agents (https://docs.tavily.com). Context variable: `tavily.api.key` (`tvly-...`), or `tavily-api-key` in a call's trailing `opts` (see `::web-search::api`); sent as `Authorization: Bearer`."""
}

::api ::web-search::api
::http ::web-search::http

HttpRequest ::hot::http/HttpRequest

BASE_URL "https://api.tavily.com"

// Tavily's documented max_results range is 0-20.
MAX_RESULTS 20

build-request
meta {
    doc: """The outgoing `HttpRequest` for a key. Pure; exposed for testing."""
}
fn (path: Str, body: Map, api-key: Str): HttpRequest {
  HttpRequest({
    method: "POST",
    url: `${BASE_URL}${path}`,
    headers: {
      Authorization: `Bearer ${api-key}`,
      Content-Type: "application/json"
    },
    body: to-json(untype(filter-vals(body, is-some)))
  })
}

post fn
(path: Str, body: Map): Any {
  post(path, body, {})
},
// 3-arity: explicit API key override
(path: Str, body: Map, api-key: Str?): Any {
  post(path, body, {tavily-api-key: api-key})
},
// 3-arity: per-call credentials (see `::web-search::api`)
(path: Str, body: Map, opts: Map): Any {
  api-key ::api/api-key("tavily", opts)
  cond {
    is-err(api-key) => { api-key }
    => { ::http/send("tavily", "Tavily", build-request(path, body, api-key)) }
  }
}

search
meta {
    ctx: {"tavily.api.key": {required: false}},
    doc: """
    POST /search - Tavily search. `options`: `search_depth` ("basic",
    "advanced", "fast", "ultra-fast"), `topic` ("general", "news",
    "finance"), `max_results` (0-20), `time_range` ("day", "week",
    "month", "year"), `start_date`/`end_date` (YYYY-MM-DD),
    `include_domains`/`exclude_domains`, `include_answer` (LLM-written
    answer in `.answer`), `include_raw_content` ("markdown"/"text"),
    `country`, `include_usage`. Null options are dropped.

    **Example**

    ```hot
    out ::web-search::tavily/search("qdrant vs pinecone pricing", {include_answer: true, max_results: 5})
    out.answer
    map(out.results, (r) { r.url })
    ```
    """
}
fn
(query: Str): Map {
  search(query, {})
},
(query: Str, options: Map): Map {
  search(query, options, {})
},
(query: Str, options: Map, opts: Map): Map {
  post("/search", {...options, query: query}, opts)
}

extract
meta {
    ctx: {"tavily.api.key": {required: false}},
    doc: """POST /extract - Fetch and clean page content for up to 20 URLs. `options`: `extract_depth` ("basic"/"advanced"), `format` ("markdown"/"text"), `query` (rerank chunks by relevance), `include_images`, `timeout` (seconds). Returns `{results: [{url, raw_content}], failed_results: [{url, error}]}`; check both."""
}
fn
(urls: Vec): Map {
  extract(urls, {})
},
(urls: Vec, options: Map): Map {
  extract(urls, options, {})
},
(urls: Vec, options: Map, opts: Map): Map {
  post("/extract", {...options, urls: urls}, opts)
}

TIME_RANGES {day: "day", week: "week", month: "month", year: "year"}

build-search-options
meta {
    doc: """Tavily search options for the normalized `search`: `max_results` clamped to 1-20, plus `time_range` for a `freshness` filter and `include_domains`/`exclude_domains`. Unset filters are omitted. Exposed for testing."""
}
fn (max-results: Int, filters: Map): Map {
  filter-vals({
    max_results: ::http/clamp(max-results, 1, MAX_RESULTS),
    time_range: get(TIME_RANGES, or(get(filters, "freshness"), "")),
    include_domains: get(filters, "include-domains"),
    exclude_domains: get(filters, "exclude-domains")
  }, is-some)
}

normalize
meta {
    doc: """Normalize a Tavily search response into `Vec<::web-search/SearchResult>`. Exposed for testing."""
}
fn (body: Map): Vec {
  map(or(get(body, "results"), []), (r) {
    ::web-search/SearchResult({
      title: or(get(r, "title"), ""),
      url: or(get(r, "url"), ""),
      content: get(r, "content"),
      score: get(r, "score")
    })
  })
}

search-normalized fn (query: Str, max-results: Int, filters: Map, opts: Map): Vec {
  search(query, build-search-options(max-results, filters), opts) |> if-ok((body) { normalize(body) })
}
