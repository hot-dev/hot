::salesforce::test ns
meta ["test"]

::auth ::salesforce::auth
::api ::salesforce::api
::query ::salesforce::query
::search ::salesforce::search
::sobjects ::salesforce::sobjects
::composite ::salesforce::composite
::bulk ::salesforce::bulk
::org ::salesforce::org
::ctx ::hot::ctx

MY_DOMAIN "https://acme.my.salesforce.com"

clear-ctx fn (): Any {
  ::ctx/set({
    "salesforce.access.token": null,
    "salesforce.instance.url": null,
    "salesforce.client-id": null,
    "salesforce.client-secret": null,
    "salesforce.username": null,
    "salesforce.private.key": null,
    "salesforce.refresh-token": null,
    "salesforce.my-domain.url": null,
    "salesforce.sandbox": null,
    "salesforce.jwt.audience": null,
    "salesforce.auth.flow": null,
    "salesforce.session.ttl": null,
    "salesforce.api.version": null
  })
  ::auth/invalidate()
}

// ============================================================================
// Auth: audience and token host selection
// ============================================================================

test-jwt-claims
meta ["test"] fn () {
    claims ::auth/build-jwt-claims("3MVG9consumer", "ops@acme.com", "https://login.salesforce.com")
    assert-eq("3MVG9consumer", claims.iss)
    assert-eq("ops@acme.com", claims.sub)
    assert-eq("https://login.salesforce.com", claims.aud)
    assert(gt(claims.exp, ::jwt/now-seconds()), "expiry in the future")
    assert(lte(claims.exp, add(::jwt/now-seconds(), 180)), "expiry within Salesforce's 3-minute maximum")
}

test-jwt-audience
meta ["test"] fn () {
    assert-eq("https://login.salesforce.com", ::auth/jwt-audience(false, null), "production defaults to login")
    assert-eq("https://test.salesforce.com", ::auth/jwt-audience(true, null), "sandbox defaults to test")
    assert-eq("https://login.salesforce.com", ::auth/jwt-audience(false, ""), "blank override is ignored")
    assert-eq("https://acme.my.site.com/customers", ::auth/jwt-audience(false, "https://acme.my.site.com/customers/"), "Experience Cloud override, trailing slash dropped")
}

test-token-url-per-flow
meta ["test"] fn () {
    cc-missing ::auth/token-url("client-credentials", null, false)
    assert(is-err(cc-missing), "client credentials without My Domain is an error, not login.salesforce.com")
    assert-eq("https://acme.my.salesforce.com/services/oauth2/token", ::auth/token-url("client-credentials", MY_DOMAIN, false))
    assert-eq("https://acme.my.salesforce.com/services/oauth2/token", ::auth/token-url("client-credentials", "acme.my.salesforce.com/", true), "scheme defaulted, slash dropped, sandbox flag irrelevant")
    assert-eq("https://login.salesforce.com/services/oauth2/token", ::auth/token-url("jwt-bearer", null, false))
    assert-eq("https://test.salesforce.com/services/oauth2/token", ::auth/token-url("jwt-bearer", "", true))
    assert-eq("https://acme.my.salesforce.com/services/oauth2/token", ::auth/token-url("jwt-bearer", MY_DOMAIN, false), "JWT may post to My Domain")
    assert-eq("https://test.salesforce.com/services/oauth2/token", ::auth/token-url("refresh-token", null, true))
}

test-jwt-audience-independent-of-token-host
meta ["test"] fn () {
    // One config that posts to My Domain must still use login as aud.
    cfg {my-domain: MY_DOMAIN, sandbox: false, audience: null}
    assert-eq("https://acme.my.salesforce.com/services/oauth2/token", ::auth/token-url("jwt-bearer", cfg.my-domain, cfg.sandbox))
    assert-eq("https://login.salesforce.com", ::auth/jwt-audience(cfg.sandbox, cfg.audience))
}

test-is-truthy-and-normalize-url
meta ["test"] fn () {
    assert(::auth/is-truthy(true))
    assert(::auth/is-truthy("TRUE"))
    assert(::auth/is-truthy("1"))
    assert(not(::auth/is-truthy("false")))
    assert(not(::auth/is-truthy(null)))
    assert-eq("https://acme.my.salesforce.com", ::auth/normalize-url("  acme.my.salesforce.com// "))
    assert-eq("http://localhost:8080", ::auth/normalize-url("http://localhost:8080/"))
}

test-select-flow-order
meta ["test"] fn () {
    all {access-token: "t", refresh-token: "r", private-key: "k", client-secret: "s"}
    assert-eq("access-token", ::auth/select-flow(all))
    assert-eq("refresh-token", ::auth/select-flow({refresh-token: "r", private-key: "k", client-secret: "s"}))
    assert-eq("jwt-bearer", ::auth/select-flow({private-key: "k", client-secret: "s"}), "a JWT key wins over a client secret")
    assert-eq("client-credentials", ::auth/select-flow({client-secret: "s"}))
    assert-eq("client-credentials", ::auth/select-flow({...all, flow: "client-credentials"}), "explicit flow wins")
    assert(is-null(::auth/select-flow({client-id: "id"})), "a bare client id selects nothing")
    assert(is-null(::auth/select-flow({access-token: ""})), "blank values do not count")
    assert(is-err(::auth/select-flow({flow: "password"})), "unknown explicit flow is an error")
}

test-missing-for-flow
meta ["test"] fn () {
    assert-eq(["salesforce.instance.url"], ::auth/missing-for-flow("access-token", {access-token: "t"}))
    assert-eq(["salesforce.my-domain.url"], ::auth/missing-for-flow("client-credentials", {client-id: "c", client-secret: "s"}))
    assert-eq([], ::auth/missing-for-flow("jwt-bearer", {client-id: "c", username: "u", private-key: "k"}))
    assert-eq([], ::auth/missing-for-flow("refresh-token", {client-id: "c", refresh-token: "r"}), "client secret is optional for refresh")
}

test-exchange-reports-missing-settings
meta ["test"] fn () {
    out ::auth/exchange("client-credentials", {client-id: "c", client-secret: "s"})
    assert(is-err(out))
    match out {
        Result.Err => { assert(contains(Str(out), "salesforce.my-domain.url"), "error names the missing setting") }
        _ => { assert(false, "expected Err") }
    }
}

test-exchange-access-token-needs-no-network
meta ["test"] fn () {
    s ::auth/exchange("access-token", {access-token: "00Dtok", instance-url: "https://acme.my.salesforce.com/"})
    assert-eq("00Dtok", s.token)
    assert-eq("https://acme.my.salesforce.com", s.instance-url)
    assert-eq("access-token", s.flow)
}

// ============================================================================
// Auth: session caching
// ============================================================================

test-session-expiry
meta ["test"] fn () {
    assert-eq(1270, ::auth/session-expiry({expires_in: 300}, 1000, 900), "expires_in wins, minus 30s slack")
    assert-eq(1270, ::auth/session-expiry({expires_in: "300"}, 1000, 900), "string expires_in")
    assert-eq(1870, ::auth/session-expiry({access_token: "x"}, 1000, 900), "falls back to the ttl")
}

test-fingerprint-tracks-credentials
meta ["test"] fn () {
    a ::auth/fingerprint("jwt-bearer", {client-id: "c", username: "u", private-key: "k"})
    b ::auth/fingerprint("jwt-bearer", {client-id: "c", username: "other", private-key: "k"})
    c ::auth/fingerprint("jwt-bearer", {client-id: "c", username: "u", private-key: "k", sandbox: true})
    assert-eq(a, ::auth/fingerprint("jwt-bearer", {client-id: "c", username: "u", private-key: "k"}), "stable")
    assert(ne(a, b), "username changes the key")
    assert(ne(a, c), "sandbox flag changes the key")
}

test-cached-session
meta ["test"] fn () {
    s {token: "tok", instance-url: "https://x.my.salesforce.com", flow: "jwt-bearer"}
    cache {fingerprint: "fp", expires-at: 2000, session: s}
    assert-eq("tok", ::auth/cached-session(cache, "fp", 1000).token, "hit")
    assert(is-null(::auth/cached-session(cache, "other", 1000)), "other credentials miss")
    assert(is-null(::auth/cached-session(cache, "fp", 2000)), "expired misses")
    assert(is-null(::auth/cached-session(null, "fp", 1000)), "empty cache misses")
}

test-session-reuses-cache-without-network
meta ["test"] fn () {
    clear-ctx()
    ::ctx/set({
        "salesforce.client-id": "c",
        "salesforce.client-secret": "s",
        "salesforce.my-domain.url": MY_DOMAIN
    })
    key ::auth/fingerprint("client-credentials", ::auth/config())
    cached {token: "cached-tok", instance-url: MY_DOMAIN, flow: "client-credentials", expires-at: add(::jwt/now-seconds(), 600)}
    ::ctx/set-secret(::auth/CACHE_KEY, {fingerprint: key, expires-at: cached.expires-at, session: cached})
    s ::auth/session()
    assert-eq("cached-tok", s.token, "served from the run cache, no token exchange")
    assert(::auth/is-configured(), "client credentials + My Domain is a complete config")
    ::auth/invalidate()
    assert(is-null(::ctx/get(::auth/CACHE_KEY)), "invalidate clears the cache")
    clear-ctx()
}

test-session-without-credentials-errors
meta ["test"] fn () {
    clear-ctx()
    assert(is-err(::auth/session()), "nothing configured is an Err")
    assert(not(::auth/is-configured()))
    ::ctx/set({"salesforce.client-id": "c", "salesforce.client-secret": "s"})
    assert(not(::auth/is-configured()), "client credentials without My Domain are incomplete")
    clear-ctx()
}

// ============================================================================
// API: URLs, headers, errors
// ============================================================================

test-data-path-and-version
meta ["test"] fn () {
    assert-eq("/services/data/v68.0/sobjects/Lead", ::api/data-path("/sobjects/Lead", "v68.0"))
    assert-eq("/services/data/v66.0/limits", ::api/data-path("/limits", "66.0"))
    assert-eq("/services/data/v61.0/query/01gxx-2000", ::api/data-path("/services/data/v61.0/query/01gxx-2000", "v68.0"), "full paths pass through")
    assert-eq("v68.0", ::api/normalize-version(null))
    assert-eq("v66.0", ::api/normalize-version("v66.0"))
    assert-eq("v66.0", ::api/normalize-version(66))
}

test-api-version-from-ctx
meta ["test"] fn () {
    clear-ctx()
    assert-eq("/services/data/v68.0/limits", ::api/data-path("/limits"), "default version")
    ::ctx/set("salesforce.api.version", "64.0")
    assert-eq("/services/data/v64.0/limits", ::api/data-path("/limits"))
    clear-ctx()
}

test-build-url
meta ["test"] fn () {
    assert-eq("https://acme.my.salesforce.com/services/data/v68.0/limits", ::api/build-url("https://acme.my.salesforce.com/", "/limits", "v68.0"))
}

test-query-string-omits-nulls
meta ["test"] fn () {
    assert-eq("", ::api/query-string({a: null}))
    qs ::api/query-string({fields: ["Id", "Name"], skip: null})
    assert(starts-with(qs, "?fields="), "leading ?")
    assert(not(contains(qs, "skip")), "null params dropped")
    assert(contains(::hot::uri/decode(qs), "Id,Name"), "vec joined with commas")
}

test-build-headers
meta ["test"] fn () {
    h ::api/build-headers("tok", false, {})
    assert-eq("Bearer tok", h.Authorization)
    assert-eq("application/json", h.Accept)
    assert(not(in("Content-Type", keys(h))), "no content type without a body")
    csv ::api/build-headers("tok", true, {content-type: "text/csv", headers: {Sforce-Query-Options: "batchSize=500"}})
    assert-eq("text/csv", get(csv, "Content-Type"))
    assert-eq("batchSize=500", get(csv, "Sforce-Query-Options"))
}

test-error-message-rest-array
meta ["test"] fn () {
    body [{message: "No such column 'Foo' on entity 'Lead'", errorCode: "INVALID_FIELD", fields: ["Foo"]}]
    assert-eq("salesforce 400: INVALID_FIELD: No such column 'Foo' on entity 'Lead' (fields: Foo)", ::api/error-message(400, body))
    assert-eq("INVALID_FIELD", ::api/error-code(body))
    two [{message: "a", errorCode: "X"}, {message: "b", errorCode: "Y", fields: []}]
    assert-eq("salesforce 400: X: a; Y: b", ::api/error-message(400, two))
}

test-error-message-oauth-and-text
meta ["test"] fn () {
    oauth {error: "invalid_grant", error_description: "audience is invalid"}
    assert-eq("salesforce 400: invalid_grant: audience is invalid", ::api/error-message(400, oauth))
    assert-eq("invalid_grant", ::api/error-code(oauth))
    assert-eq("salesforce 503: Service Unavailable", ::api/error-message(503, "Service Unavailable\n"))
    assert-eq("salesforce 500", ::api/error-message(500, null))
    assert(is-null(::api/error-code("text")))
}

test-unwrap
meta ["test"] fn () {
    assert(is-null(::api/unwrap({status: 204, headers: {}, body: ""})), "204 is null")
    assert-eq({id: "001"}, ::api/unwrap({status: 201, headers: {}, body: {id: "001"}}))
    failed ::api/unwrap({status: 401, headers: {}, body: [{message: "Session expired or invalid", errorCode: "INVALID_SESSION_ID"}]})
    assert(is-err(failed), "non-2xx is an Err")
    match failed {
        Result.Err => {
            e failed
            assert-eq(401, e.status)
            assert-eq("INVALID_SESSION_ID", e.error-code)
            assert-eq("salesforce 401: INVALID_SESSION_ID: Session expired or invalid", e.message)
        }

        _ => { assert(false, "expected Err") }
    }

    assert(::api/is-invalid-session({status: 401}))
    assert(not(::api/is-invalid-session({status: 403})))
}

// ============================================================================
// SOQL
// ============================================================================

test-soql-escape
meta ["test"] fn () {
    assert-eq("O\\'Brien", ::query/escape("O'Brien"))
    assert-eq("a\\\\b", ::query/escape("a\\b"))
    assert-eq("say \\\"hi\\\"", ::query/escape("say \"hi\""))
    assert-eq("line\\nbreak\\ttab", ::query/escape("line\nbreak\ttab"))
    assert-eq("\\\\\\'", ::query/escape("\\'"), "backslash escaped before quote")
    assert-eq("plain", ::query/escape("plain"))
}

test-soql-escape-like
meta ["test"] fn () {
    assert-eq("50\\% off\\_now", ::query/escape-like("50% off_now"))
    assert-eq("O\\'B\\%", ::query/escape-like("O'B%"))
}

test-soql-literal
meta ["test"] fn () {
    assert-eq("'O\\'Brien'", ::query/literal("O'Brien"))
    assert-eq("42", ::query/literal(42))
    assert-eq("true", ::query/literal(true))
    assert-eq("null", ::query/literal(null))
    assert-eq("('001A', '001B')", ::query/literal(["001A", "001B"]))
}

test-query-path
meta ["test"] fn () {
    p ::query/query-path("SELECT Id FROM Lead", false)
    assert(starts-with(p, "/query?q="))
    assert-eq("SELECT Id FROM Lead", get(::hot::uri/decode-query(slice(p, 7)), "q"))
    assert(starts-with(::query/query-path("SELECT Id FROM Lead", true), "/queryAll?q="))
    assert-eq({}, ::query/query-headers({}), "no batch size, no header")
    assert-eq("batchSize=500", ::query/query-headers({batch-size: 500}).headers.Sforce-Query-Options)
}

test-collect-pages-stops-when-done
meta ["test"] fn () {
    page {totalSize: 2, done: true, records: [{Id: "1"}, {Id: "2"}]}
    assert-eq(3, length(::query/collect-pages(page, [{Id: "0"}], null)), "appends to the accumulator, no further fetch")
}

test-collect-pages-honours-max-records
meta ["test"] fn () {
    // done is false, but max-records is reached first: no next-page fetch.
    page {totalSize: 5000, done: false, nextRecordsUrl: "/services/data/v68.0/query/01g-2000", records: [{Id: "1"}, {Id: "2"}, {Id: "3"}]}
    out ::query/collect-pages(page, [], 2)
    assert-eq(2, length(out))
    assert-eq("2", out[1].Id)
}

test-next-page-rejects-foreign-urls
meta ["test"] fn () {
    assert(is-err(::query/next-page("https://evil.example.com/query")), "only /services/ paths are followed")
}

// ============================================================================
// SOSL
// ============================================================================

test-escape-sosl
meta ["test"] fn () {
    assert-eq("ada@example.com", ::search/escape-sosl("ada@example.com"), "@ and . are not reserved")
    assert-eq("C\\+\\+ \\(beta\\)", ::search/escape-sosl("C++ (beta)"))
    assert-eq("a\\\\b", ::search/escape-sosl("a\\b"))
    assert-eq("O\\'Brien\\-Smith", ::search/escape-sosl("O'Brien-Smith"))
}

test-build-sosl
meta ["test"] fn () {
    assert-eq("FIND {Lovelace} IN ALL FIELDS", ::search/build-sosl("Lovelace", {}), "unset options omitted")
    assert-eq(
        "FIND {ada} IN EMAIL FIELDS RETURNING Contact(Id, Email), Lead LIMIT 5",
        ::search/build-sosl("ada", {in: "email", returning: ["Contact(Id, Email)", "Lead"], limit: 5})
    )
}

// ============================================================================
// sObjects and composite
// ============================================================================

test-record-paths
meta ["test"] fn () {
    assert-eq("/sobjects/Contact", ::sobjects/record-path("Contact"))
    assert-eq("/sobjects/Contact/003xx", ::sobjects/record-path("Contact", "003xx"))
    assert-eq("/sobjects/Contact/Ext__c/a%2Fb%20c", ::sobjects/record-path("Contact", "Ext__c", "a/b c"), "external id value encoded")
}

test-collection-body
meta ["test"] fn () {
    body ::composite/build-collection-body("Contact", [{LastName: "A"}, {LastName: "B", attributes: {type: "Lead"}}], false)
    assert-eq(false, body.allOrNone)
    assert-eq("Contact", body.records[0].attributes.type)
    assert-eq("A", body.records[0].LastName)
    assert-eq("Lead", body.records[1].attributes.type, "existing attributes kept")
}

test-chunks
meta ["test"] fn () {
    many range(450)
    groups ::composite/chunks(many, 200, false)
    assert-eq(3, length(groups))
    assert-eq(50, length(last(groups)))
    assert(is-err(::composite/chunks(many, 200, true)), "all-or-none cannot span calls")
    assert-eq(1, length(::composite/chunks(range(200), 200, true)))
    assert-eq([], ::composite/chunks([], 200, false))
}

test-delete-path
meta ["test"] fn () {
    p ::hot::uri/decode(::composite/delete-path(["001A", "003B"], true))
    assert(starts-with(p, "/composite/sobjects?"))
    assert(contains(p, "ids=001A,003B"))
    assert(contains(p, "allOrNone=true"))
}

test-composite-body
meta ["test"] fn () {
    clear-ctx()
    sub ::composite/subrequest("POST", "/sobjects/Account", "acct", {Name: "Acme"})
    assert-eq("/services/data/v68.0/sobjects/Account", sub.url)
    assert-eq("acct", sub.referenceId)
    assert-eq("Acme", sub.body.Name)
    get-req ::composite/subrequest("GET", "/sobjects/Account/@{acct.id}", "read")
    assert(not(in("body", keys(get-req))), "no body key when none given")
    body ::composite/build-composite-body([sub, get-req], {all-or-none: true})
    assert-eq(true, body.allOrNone)
    assert(not(in("collateSubrequests", keys(body))), "unset collate omitted")
    assert-eq(2, length(body.compositeRequest))
    assert(is-err(::composite/build-composite-body(map(range(26), (i) { sub }), {})), "over 25 subrequests is an Err")
}

// ============================================================================
// Bulk API 2.0
// ============================================================================

test-ingest-job-body
meta ["test"] fn () {
    body ::bulk/build-ingest-job-body("Contact", "insert", {})
    assert-eq({object: "Contact", operation: "insert", contentType: "CSV"}, body, "unset options omitted")
    up ::bulk/build-ingest-job-body("Contact", "upsert", {external-id-field: "Ext__c", line-ending: "CRLF"})
    assert-eq("Ext__c", up.externalIdFieldName)
    assert-eq("CRLF", up.lineEnding)
    assert(is-err(::bulk/build-ingest-job-body("Contact", "upsert", {})), "upsert needs an external id field")
    assert(is-err(::bulk/build-ingest-job-body("Contact", "merge", {})), "unknown operation")
}

test-query-job-body
meta ["test"] fn () {
    assert-eq({operation: "query", query: "SELECT Id FROM Lead"}, ::bulk/build-query-job-body("SELECT Id FROM Lead", {}))
    assert-eq("queryAll", ::bulk/build-query-job-body("SELECT Id FROM Lead", {include-deleted: true}).operation)
}

test-csv
meta ["test"] fn () {
    assert-eq("plain", ::bulk/csv-cell("plain"))
    assert-eq("\"a,b\"", ::bulk/csv-cell("a,b"))
    assert-eq("\"say \"\"hi\"\"\"", ::bulk/csv-cell("say \"hi\""))
    assert-eq("\"two\nlines\"", ::bulk/csv-cell("two\nlines"))
    assert-eq("", ::bulk/csv-cell(null))
    assert-eq("true", ::bulk/csv-cell(true))
    csv ::bulk/to-csv([{LastName: "Lovelace", Email: "ada@example.com"}, {LastName: "O,Hara"}], ["LastName", "Email"])
    assert-eq("LastName,Email\nLovelace,ada@example.com\n\"O,Hara\",\n", csv)
}

test-results-path-and-locator
meta ["test"] fn () {
    assert-eq("/jobs/query/750xx/results", ::bulk/results-path("750xx", {}))
    p ::bulk/results-path("750xx", {locator: "MTAwMDA", max-records: 50000})
    assert(contains(p, "locator=MTAwMDA"))
    assert(contains(p, "maxRecords=50000"))
    assert(is-null(::bulk/parse-locator({"sforce-locator": "null"})), "the literal null ends paging")
    assert-eq("MTAwMDA", ::bulk/parse-locator({"sforce-locator": "MTAwMDA"}))
    assert(is-null(::bulk/parse-locator({})))
}

test-job-polling
meta ["test"] fn () {
    assert(::bulk/is-job-finished({state: "JobComplete"}))
    assert(::bulk/is-job-finished({state: "Failed"}))
    assert(not(::bulk/is-job-finished({state: "InProgress"})))
    assert(is-err(::bulk/poll({id: "750", state: "UploadComplete"})), "running job is an Err for task retry")
    assert-eq("JobComplete", ::bulk/poll({id: "750", state: "JobComplete"}).state)
}

// ============================================================================
// Org
// ============================================================================

test-api-usage
meta ["test"] fn () {
    assert-eq({used: 25, max: 15000}, ::org/api-usage("api-usage=25/15000"))
    assert-eq({used: 3, max: 100}, ::org/api-usage("per-app-api-usage=1/10(appName=x), api-usage=3/100"), "org usage, not per-app")
    assert(is-null(::org/api-usage("nothing here")))
    assert(is-null(::org/api-usage(null)))
}
