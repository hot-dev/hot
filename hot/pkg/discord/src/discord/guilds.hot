}

ModifyGuildRequest type {
  guild_id: Str,
  name: Str?,
  verification_level: Int?,
  default_message_notifications: Int?,
  explicit_content_filter: Int?,
  afk_channel_id: Str?,
  afk_timeout: Int?,
  icon: Str?,
  splash: Str?,
  discovery_splash: Str?,
  banner: Str?,
  system_channel_id: Str?,
  system_channel_flags: Int?,
  rules_channel_id: Str?,
  public_updates_channel_id: Str?,
  safety_alerts_channel_id: Str?,
  preferred_locale: Str?,
  features: Vec<Str>?,
  description: Str?,
  premium_progress_bar_enabled: Bool?,
  reason: Str?,
  clear: Vec<Str>?
}

modify-guild
meta {
    doc: """
    PATCH /guilds/{guild_id} - Change guild settings. Only fields you set
    are sent, so the icon, splash, banner and channel ids stay as they are
    unless you name them. To remove one, list it in `clear`, e.g.
    `clear: ["icon", "afk_channel_id"]`. Needs MANAGE_GUILD.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    ::guilds/modify-guild(::guilds/ModifyGuildRequest({
      guild_id: "1000000000000000000",
      description: "Home of the Hot community",
      reason: "Refresh description"
    }))
    ```
    """
}
fn
(request: ModifyGuildRequest): Map {
  modify-guild(request, {})
},
(request: ModifyGuildRequest, opts: Map): Map {
  ::api/call("PATCH", `/guilds/${seg(request.guild_id)}`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  }, opts)
}

