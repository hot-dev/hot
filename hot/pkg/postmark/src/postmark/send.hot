::postmark::send ns

api-request ::postmark::api/request
HttpError ::postmark::api/HttpError
is-ok-response ::hot::http/is-ok-response

// List of email attachments. Each attachment has Name, Content (base64), and ContentType.
AttachmentCollection type Vec<Map>

// List of custom email headers. Each header has Name and Value.
HeaderCollection type Vec<Map>

SendEmailRequest type {
    From: Str?,
    To: Str?,
    Cc: Str?,
    Bcc: Str?,
    Subject: Str?,
    Tag: Str?,
    HtmlBody: Str?,
    TextBody: Str?,
    ReplyTo: Str?,
    TrackOpens: Bool?,
    TrackLinks: "None" | "HtmlAndText" | "HtmlOnly" | "TextOnly"?,
    Headers: HeaderCollection?,
    Attachments: AttachmentCollection?
}

SendEmailResponse type {
    To: Str?,
    SubmittedAt: Str?,
    MessageID: Str?,
    ErrorCode: Int?,
    Message: Str?
}


send-single-email
meta {
    doc: """
    Send a single email via the Postmark API.

    **Example**

    ```hot
    response ::postmark::send/send-single-email(::postmark::send/SendEmailRequest({
        From: "sender@example.com",
        To: "recipient@example.com",
        Subject: "Welcome!",
        TextBody: "Plain text body.",
        HtmlBody: "<html><body><p>HTML body</p></body></html>"
    }))
    response.MessageID // => "unique-message-id"
    response.ErrorCode // => 0
    ```
    """
}
fn
(request: SendEmailRequest): SendEmailResponse {
  send-single-email(request, {})
},
(request: SendEmailRequest, opts: Map): SendEmailResponse {
  response api-request("POST", `${::postmark/BASE_URL}/email`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { SendEmailResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

// Convenience alias
email send-single-email

// Batch email request: array of individual email objects
SendEmailBatchRequest type Vec<Map>

// Batch email response: array of results for each email in the batch
SendEmailBatchResponse type Vec<Map>


send-batch-emails
meta {
    doc: """
    Send a batch of emails in a single API call.

    **Example**

    ```hot
    results ::postmark::send/send-batch-emails(::postmark::send/SendEmailBatchRequest([
        {From: "sender@example.com", To: "ada@example.com", Subject: "Hello", TextBody: "Hi Ada."},
        {From: "sender@example.com", To: "alan@example.com", Subject: "Hello", TextBody: "Hi Alan."}
    ]))

    // One result per message, in order
    first(results).MessageID

    // With a tenant's server token
    ::postmark::send/send-batch-emails([{From: "sender@example.com", To: "ada@example.com", Subject: "Hello", TextBody: "Hi Ada."}], {
        server-token: ::hot::ctx/get("tenant.postmark.token")
    })
    ```
    """
}
fn
(request: SendEmailBatchRequest): SendEmailBatchResponse {
  send-batch-emails(request, {})
},
(request: SendEmailBatchRequest, opts: Map): SendEmailBatchResponse {
  response api-request("POST", `${::postmark/BASE_URL}/email/batch`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { SendEmailBatchResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

EmailWithTemplateRequest type {
    TemplateId: Int,
    TemplateAlias: Str,
    TemplateModel: Map,
    InlineCss: Bool?,
    From: Str,
    To: Str,
    Cc: Str?,
    Bcc: Str?,
    Tag: Str?,
    ReplyTo: Str?,
    Headers: HeaderCollection?,
    TrackOpens: Bool?,
    TrackLinks: "None" | "HtmlAndText" | "HtmlOnly" | "TextOnly"?,
    Attachments: AttachmentCollection?
}

SendEmailWithTemplateRequest type {
    TemplateId: Int,
    TemplateAlias: Str,
    TemplateModel: Map,
    InlineCss: Bool?,
    From: Str,
    To: Str,
    Cc: Str?,
    Bcc: Str?,
    Tag: Str?,
    ReplyTo: Str?,
    Headers: HeaderCollection?,
    TrackOpens: Bool?,
    TrackLinks: "None" | "HtmlAndText" | "HtmlOnly" | "TextOnly"?,
    Attachments: AttachmentCollection?
}

SendEmailWithTemplateResponse type {
    To: Str?,
    SubmittedAt: Str?,
    MessageID: Str?,
    ErrorCode: Int?,
    Message: Str?
}


send-email-using-template
meta {
    doc: """
    Send an email using a pre-defined Postmark template, identified by
    TemplateId or TemplateAlias.

    **Example**

    ```hot
    // Name the template by TemplateAlias or TemplateId
    sent ::postmark::send/send-email-using-template({
        TemplateAlias: "welcome",
        TemplateModel: {name: "Ada"},
        From: "sender@example.com",
        To: "ada@example.com"
    })
    sent.MessageID
    ```
    """
}
fn
(request: SendEmailWithTemplateRequest): SendEmailWithTemplateResponse {
  send-email-using-template(request, {})
},
(request: SendEmailWithTemplateRequest, opts: Map): SendEmailWithTemplateResponse {
  response api-request("POST", `${::postmark/BASE_URL}/email/withTemplate`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { SendEmailWithTemplateResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

SendEmailTemplatedBatchRequest type {
    Messages: Vec<EmailWithTemplateRequest>?
}

SendEmailBatchWithTemplatesRequest type {
    Messages: Vec<EmailWithTemplateRequest>?
}

// Batch template email response: array of results for each templated email
SendEmailBatchWithTemplatesResponse type Vec<Map>


send-batch-email-using-templates
meta {
    doc: """
    Send a batch of emails using templates in a single API call.

    **Example**

    ```hot
    results ::postmark::send/send-batch-email-using-templates({Messages: [
        {TemplateAlias: "welcome", TemplateModel: {name: "Ada"}, From: "sender@example.com", To: "ada@example.com"},
        {TemplateAlias: "welcome", TemplateModel: {name: "Alan"}, From: "sender@example.com", To: "alan@example.com"}
    ]})

    // One result per message, in order
    first(results).MessageID
    ```
    """
}
fn
(request: SendEmailBatchWithTemplatesRequest): SendEmailBatchWithTemplatesResponse {
  send-batch-email-using-templates(request, {})
},
(request: SendEmailBatchWithTemplatesRequest, opts: Map): SendEmailBatchWithTemplatesResponse {
  response api-request("POST", `${::postmark/BASE_URL}/email/batchWithTemplates`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { SendEmailBatchWithTemplatesResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
