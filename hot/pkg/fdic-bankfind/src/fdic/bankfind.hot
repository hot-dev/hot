::fdic::bankfind ns
meta {
    ctx: {
        "fdic.bankfind.api-key": {required: false},
        "fdic.bankfind.base-url": {required: false, secret: false}
    },
    doc: """
    The FDIC BankFind Suite API (`https://api.fdic.gov/banks`, no key
    needed today): institutions, locations (branches), history (mergers
    and other structure changes), failures, quarterly financials, and
    yearly summaries.

    Every list function takes the API's own query in `opts`, and returns
    the API's page: `meta`, `data` and `totals`. `rows` unwraps `data`.

    | opts key | Parameter | Meaning |
    |---|---|---|
    | `filters` | `filters` | Elasticsearch query string, or a Map (see `filter-string`) |
    | `search` | `search` | Fuzzy name search, e.g. `"NAME:Island"` (`institutions`, `history`) |
    | `fields` | `fields` | Field names, a Vec or comma-separated Str, in UPPERCASE |
    | `sort-by`, `sort-order` | `sort_by`, `sort_order` | A field; `"ASC"` or `"DESC"` |
    | `limit`, `offset` | `limit`, `offset` | Default 10, maximum 10,000 |
    | `agg-by`, `agg-term-fields`, `agg-sum-fields`, `agg-limit` | `agg_*` | Aggregates (`history`, `failures`, `financials`, `summary`) |

    Lists page by `limit` and `offset`; `next-page` reads the next offset
    from `meta.total`, and `collect` follows it. FDIC publishes no rate
    limit. Dollar amounts are in thousands.

    Every function also takes `api-key` and `base-url` in `opts`.
    """
}

::api ::fdic::bankfind::api

MAX_LIMIT 10000
COLLECT_LIMIT 1000

// opts key -> API parameter, for parameters sent as given.
PARAMS {
  search: "search",
  sort-by: "sort_by",
  sort-order: "sort_order",
  offset: "offset",
  agg-by: "agg_by",
  agg-term-fields: "agg_term_fields",
  agg-sum-fields: "agg_sum_fields",
  agg-limit: "agg_limit"
}

fdic-get
meta {no-doc: true}
fn (path: Str, opts: Map): Any {
  cfg ::api/resolve(opts)
  // Returned, not consumed: consuming an Err would halt the run.
  cond {
    is-err(cfg) => { cfg }
    => {
      params {...list-params(opts), api_key: cfg.api-key}
      ::api/get-json(`${cfg.base-url}${path}${::api/query-string(params)}`, {})
    }
  }
}

// ---------------------------------------------------------------------------
// Filters and parameters (pure)
// ---------------------------------------------------------------------------

phrase
meta {
    doc: """
    `value` as a quoted filter phrase, with backslashes and double quotes
    escaped (pure), so outside text can't change the query.

    **Example**

    ```hot
    ::fdic::bankfind/phrase("Iowa")  // "\"Iowa\""
    ::fdic::bankfind/phrase("Bank \"A\"")  // "\"Bank \\\"A\\\"\""
    ```
    """
}
fn (value: Str): Str {
  escaped ::hot::str/replace(::hot::str/replace(value, "\\", "\\\\"), "\"", "\\\"")
  `"${escaped}"`
}

filter-value
meta {no-doc: true}
fn (value: Any): Str {
  cond {
    is-vec(value) => { `(${join(map(value, filter-value), ",")})` }
    is-str(value) => { phrase(value) }
    => { Str(value) }
  }
}

filter-string
meta {
    doc: """
    A filter expression from a Map of field to value, joined with `AND`
    (pure). A Str is quoted as a phrase, a number is left bare, and a Vec
    matches any of its values. Use a Str `filters` for ranges and `OR`.

    **Example**

    ```hot
    ::fdic::bankfind/filter-string({STALP: "IA", ACTIVE: 1})
    // "STALP:\"IA\" AND ACTIVE:1"
    ::fdic::bankfind/filter-string({STNAME: ["Iowa", "West Virginia"]})
    // "STNAME:(\"Iowa\",\"West Virginia\")"
    ```
    """
}
fn (filters: Map): Str {
  join(map(keys(filters), (k) { `${k}:${filter-value(get(filters, k))}` }), " AND ")
}

filter-text
meta {no-doc: true}
fn (filters: Any): Str? {
  cond {
    is-map(filters) => { if(is-empty(filters), null, filter-string(filters)) }
    => { filters }
  }
}

and-filters
meta {
    doc: """
    Combine two `filters` values, each a Str, Map or null, with `AND`
    (pure). A Str goes in parentheses so its own `OR` stays inside.

    **Example**

    ```hot
    ::fdic::bankfind/and-filters({ACTIVE: 1}, "STALP:\"IA\" OR STALP:\"NE\"")  // "(ACTIVE:1) AND (STALP:\"IA\" OR STALP:\"NE\")"
    ::fdic::bankfind/and-filters("ACTIVE:1", null)  // "ACTIVE:1"
    ```
    """
}
fn (a: Any, b: Any): Str? {
  parts filter(map([a, b], filter-text), ::api/given)
  cond {
    is-empty(parts) => { null }
    eq(length(parts), 1) => { first(parts) }
    => { join(map(parts, (p) { `(${p})` }), " AND ") }
  }
}

list-params
meta {
    doc: """
    The API parameters from `opts` (pure): `filters`, `fields` and `limit`
    (capped at 10,000) with the rest as given. See the namespace doc for the
    keys.

    **Example**

    ```hot
    params ::fdic::bankfind/list-params({fields: ["CERT", "NAME"], limit: 50000, sort-by: "ASSET"})
    params.fields  // "CERT,NAME"
    params.limit  // 10000
    params.sort_by  // "ASSET"
    ```
    """
}
fn (opts: Map): Map {
  fields get(opts, "fields")
  limit get(opts, "limit")
  given-params reduce(keys(PARAMS), (acc, k) {
    v get(opts, k)
    if(::api/given(v), assoc(acc, get(PARAMS, k), v), acc)
  }, {})
  {
    filters: filter-text(get(opts, "filters")),
    fields: if(is-vec(fields), join(fields, ","), fields),
    limit: if(is-some(limit), min(limit, MAX_LIMIT), null),
    ...given-params
  }
}

with-cert
meta {no-doc: true}
fn (cert: Any, defaults: Map, opts: Map): Map {
  {...defaults, ...opts, filters: and-filters({CERT: cert}, get(opts, "filters"))}
}

// ---------------------------------------------------------------------------
// Institutions and locations
// ---------------------------------------------------------------------------

institutions
meta {
    doc: """
    One page of financial institutions, active and inactive. Filter on
    `ACTIVE:1` for those open now.

    **Example**

    ```hot
    page ::fdic::bankfind/institutions({
      filters: {STALP: "IA", ACTIVE: 1},
      fields: ["CERT", "NAME", "CITY", "ASSET"],
      sort-by: "ASSET",
      sort-order: "DESC",
      limit: 25
    })
    first(::fdic::bankfind/rows(page)).NAME
    ```
    """
}
fn
(): Map {
  institutions({})
},
(opts: Map): Map {
  fdic-get("/institutions", opts)
}

institution
meta {
    doc: """
    One institution by FDIC certificate number, or null when there is none.

    **Example**

    ```hot
    bank ::fdic::bankfind/institution(628)
    bank.NAME

    // Only the fields you need
    ::fdic::bankfind/institution(628, {fields: ["NAME", "ASSET"]})
    ```
    """
}
fn
(cert: Any): Map? {
  institution(cert, {})
},
(cert: Any, opts: Map): Map? {
  first-row(institutions(with-cert(cert, {}, opts)))
}

locations
meta {
    doc: """
    One page of branches and other offices. `MAINOFF` is 1 for the main
    office.

    **Example**

    ```hot
    ::b ::fdic::bankfind
    page ::b/locations({filters: {STALP: "IA", MAINOFF: 1}, fields: "NAME,OFFNAME,CITY", limit: 25})
    map(::b/rows(page), (r) { r.CITY })
    ```
    """
}
fn
(): Map {
  locations({})
},
(opts: Map): Map {
  fdic-get("/locations", opts)
}

branches
meta {
    doc: """
    One page of an institution's offices by certificate number, sorted by
    office number.

    **Example**

    ```hot
    ::b ::fdic::bankfind
    page ::b/branches(628, {fields: "OFFNAME,CITY,STALP", limit: 50})
    ::b/total(page)
    ```
    """
}
fn
(cert: Any): Map {
  branches(cert, {})
},
(cert: Any, opts: Map): Map {
  locations(with-cert(cert, {sort-by: "OFFNUM", sort-order: "ASC"}, opts))
}

// ---------------------------------------------------------------------------
// History
// ---------------------------------------------------------------------------

history
meta {
    doc: """
    One page of structure change events. `CHANGECODE_DESC` names the
    event. Mergers carry `ACQ_CERT` (the acquirer), `OUT_CERT` (the
    institution absorbed) and `SUR_CERT` (the survivor), with their
    `*_INSTNAME`. `ORG_ROLE_CDE` is `FI` for the institution, `BR` for a
    branch.

    **Example**

    ```hot
    // What absorbed First Republic Bank?
    page ::fdic::bankfind/history({filters: {OUT_CERT: 59017, ORG_ROLE_CDE: "FI"}})
    first(::fdic::bankfind/rows(page)).ACQ_INSTNAME
    ```
    """
}
fn
(): Map {
  history({})
},
(opts: Map): Map {
  fdic-get("/history", opts)
}

institution-history
meta {
    doc: """
    One page of an institution's own events by certificate number, newest
    first: mergers, name and charter changes. It leaves out branch
    events, which are most of the rows for a large bank.

    **Example**

    ```hot
    ::b ::fdic::bankfind
    page ::b/institution-history(628, {limit: 20})
    map(::b/rows(page), (r) { r.CHANGECODE_DESC })
    ```
    """
}
fn
(cert: Any): Map {
  institution-history(cert, {})
},
(cert: Any, opts: Map): Map {
  own and-filters({ORG_ROLE_CDE: "FI"}, get(opts, "filters"))
  history(with-cert(cert, {sort-by: "EFFDATE", sort-order: "DESC"}, {...opts, filters: own}))
}

// ---------------------------------------------------------------------------
// Failures, financials and summary
// ---------------------------------------------------------------------------

failures
meta {
    doc: """
    One page of bank failures since 1934. `COST` is the estimated loss to
    the insurance fund, and `RESTYPE1` the resolution type. Filter by year
    with `FAILYR`, e.g. `{FAILYR: 2023}`.

    **Example**

    ```hot
    ::b ::fdic::bankfind
    page ::b/failures({filters: {FAILYR: 2023}, fields: ["NAME", "COST"], sort-by: "COST", sort-order: "DESC"})
    first(::b/rows(page)).NAME
    ```
    """
}
fn
(): Map {
  failures({})
},
(opts: Map): Map {
  fdic-get("/failures", opts)
}

failure
meta {
    doc: """
    An institution's failure record by certificate number, or null when it
    has none.

    **Example**

    ```hot
    f ::fdic::bankfind/failure(59017)
    if(is-null(f), "never failed", f.COST)
    ```
    """
}
fn
(cert: Any): Map? {
  failure(cert, {})
},
(cert: Any, opts: Map): Map? {
  first-row(failures(with-cert(cert, {}, opts)))
}

financials
meta {
    doc: """
    One page of quarterly financials. Name the `fields` you want: there
    are over 2,000, and `limit` drops to 500 when `fields` has more than
    250. `REPDTE` is the quarter end, as `YYYYMMDD`.

    **Example**

    ```hot
    page ::fdic::bankfind/financials({filters: {REPDTE: "20260630"}, fields: "CERT,ASSET,DEP,ROA", sort-by: "ASSET", sort-order: "DESC"})
    ```
    """
}
fn
(): Map {
  financials({})
},
(opts: Map): Map {
  fdic-get("/financials", opts)
}

institution-financials
meta {
    doc: """
    One page of an institution's quarters by certificate number, newest
    first.

    **Example**

    ```hot
    ::b ::fdic::bankfind
    page ::b/institution-financials(628, {fields: "REPDTE,ASSET,DEP", limit: 8})
    first(::b/rows(page)).ASSET
    ```
    """
}
fn
(cert: Any): Map {
  institution-financials(cert, {})
},
(cert: Any, opts: Map): Map {
  financials(with-cert(cert, {sort-by: "REPDTE", sort-order: "DESC"}, opts))
}

summary
meta {
    doc: """
    One page of aggregate financial and structure data by year, from 1934.
    Each row covers a state and year, split by `CB_SI` into commercial banks
    (`CB`) and savings institutions (`SI`).

    **Example**

    ```hot
    ::b ::fdic::bankfind
    page ::b/summary({filters: "STNAME:\"Iowa\" AND YEAR:2023", fields: "STNAME,YEAR,CB_SI,ASSET"})
    map(::b/rows(page), (r) { r.ASSET })
    ```
    """
}
fn
(): Map {
  summary({})
},
(opts: Map): Map {
  fdic-get("/summary", opts)
}

// ---------------------------------------------------------------------------
// Reading responses (pure)
// ---------------------------------------------------------------------------

rows
meta {
    doc: """
    The records in a page, unwrapped from the API's `{data: {...}, score}`
    (pure).

    **Example**

    ```hot
    ::fdic::bankfind/rows({data: [{data: {CERT: 628}, score: 1}]})  // [{CERT: 628}]
    ::fdic::bankfind/rows(null)  // []
    ```
    """
}
fn (page: Any): Vec<Map> {
  map(or(get(or(page, {}), "data"), []), (row) { get(row, "data") })
}

total
meta {
    doc: """
    How many records match the query, across all pages (pure). With `agg-by`
    it counts the records aggregated, not the rows returned.

    **Example**

    ```hot
    ::fdic::bankfind/total({meta: {total: 4}})  // 4
    ```
    """
}
fn (page: Any): Int? {
  get-in(or(page, {}), ["meta", "total"])
}

first-row
meta {no-doc: true}
fn (page: Result): Map? {
  // A Result parameter, so an Err arrives intact and is returned, not consumed.
  cond {
    is-err(page) => { page }
    => {
      found rows(page)
      if(is-empty(found), null, first(found))
    }
  }
}

// ---------------------------------------------------------------------------
// Pagination
// ---------------------------------------------------------------------------

next-page
meta {
    doc: """
    The offset after `page`, from the offset the API echoes in
    `meta.parameters`, the rows returned and `meta.total`; null on the last
    page (pure). Not for `agg-by` pages.

    **Example**

    ```hot
    first-page {meta: {total: 3, parameters: {offset: 0}}, data: [{data: {}}, {data: {}}]}
    ::fdic::bankfind/next-page(first-page)  // 2

    last-page {meta: {total: 3, parameters: {offset: 2}}, data: [{data: {}}]}
    ::fdic::bankfind/next-page(last-page)  // null
    ```
    """
}
fn (page: Any): Int? {
  offset Int(or(get-in(or(page, {}), ["meta", "parameters", "offset"]), 0))
  next add(offset, length(or(get(or(page, {}), "data"), [])))
  all total(page)
  cond {
    is-null(all) => { null }
    lt(next, all) => { if(gt(next, offset), next, null) }
    => { null }
  }
}

collect-pages
meta {no-doc: true}
fn (fetch: Fn, opts: Map, limit: Int, acc: Vec): Vec {
  page fetch(opts)
  cond {
    // Returned, not consumed: consuming an Err would halt the run.
    is-err(page) => { page }
    => {
      items rows(page)
      combined concat(acc, items)
      next next-page(page)
      cond {
        gte(length(combined), limit) => { slice(combined, 0, limit) }
        is-empty(items) => { combined }
        is-null(next) => { combined }
        => { collect-pages(fetch, {...opts, offset: next}, limit, combined) }
      }
    }
  }
}

collect
meta {
    doc: """
    Follow pages until `limit` records or the last page. `fetch` takes
    `opts` (with `limit` and `offset` set) and returns one page. `limit`
    in `opts` sets the page size, 1,000 by default, which keeps wide
    records under the response size cap. Sort on a field that orders
    every record, or a row can move between pages. An Err on any page is
    returned in place of the records.

    **Example**

    ```hot
    ::b ::fdic::bankfind
    all ::b/collect((o) { ::b/branches(628, o) }, {fields: "UNINUM,OFFNAME,CITY,STALP"}, 6000)
    ```
    """
}
fn (fetch: Fn, opts: Map, limit: Int): Vec {
  size min(min(or(get(opts, "limit"), COLLECT_LIMIT), MAX_LIMIT), max(1, limit))
  collect-pages(fetch, {...opts, limit: size}, limit, [])
}
