::hot::pkg ns

hot.pkg.un-sanctions {
  name: "hot.dev/un-sanctions",
  version: "0.1.0",
  hot-min-version: "3.0.2",
  description: "The UN Security Council Consolidated List for hot.dev/name-screening: downloads the free XML file, parses it into normalized Entry records and refreshes it into the screening cache, skipping an unchanged file by body hash.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["sanctions", "un", "compliance", "kyc", "aml", "screening"],
  deps: {
    "hot.dev/name-screening": "0.1.0"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
