::elevenlabs ns
meta {
    doc: """
    ElevenLabs API bindings: text-to-speech (full, with character
    timestamps, and streaming) in `::elevenlabs::tts`, Scribe
    speech-to-text in `::elevenlabs::stt`, sound effects in
    `::elevenlabs::sound`, voices, models, generation history, account
    info, and webhook verification in `::elevenlabs::webhooks`.

    Pairs with the messaging packages for voice agents: Telegram voice
    replies, phone agents (`ulaw_8000` output), narrated summaries.

    **Setup**: context variable `elevenlabs.api.key` (from
    https://elevenlabs.io/app/settings/api-keys).

    **Quick start**

    ```hot
    ::tts ::elevenlabs::tts
    ::stt ::elevenlabs::stt

    audio ::tts/text-to-speech(::elevenlabs/GEORGE_VOICE_ID, ::tts/TextToSpeechRequest({
      text: "Hello from Hot!",
      model_id: "eleven_multilingual_v2"
    }))
    // audio is Bytes (mp3 by default): write it, send it, play it
    ::hot::file/write-file-bytes("hello.mp3", audio)

    // ...and transcribe it back
    ::stt/transcript-text(::stt/speech-to-text(audio))
    ```
    """
}

BASE_URL "https://api.elevenlabs.io"

// Well-known premade voice IDs, so examples work out of the box.
GEORGE_VOICE_ID "JBFqnCBsd6RMkjVDRZzb"
RACHEL_VOICE_ID "21m00Tcm4TlvDq8ikWAM"
