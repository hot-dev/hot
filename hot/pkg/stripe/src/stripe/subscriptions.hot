::stripe::subscriptions ns
meta {
    doc: """Subscriptions and subscription items: create, change plans and quantities, pause, resume, cancel, list, and search. See https://docs.stripe.com/api/subscriptions."""
}

api-call ::stripe::api/call
seg ::stripe::api/encode-id
RequestOptions ::stripe::api/RequestOptions

// ============================================================================
// Subscriptions
// ============================================================================

CreateSubscriptionRequest type {
  customer: Str,
  items: Vec<Map>,
  currency: Str?,
  description: Str?,
  trial_period_days: Int?,
  trial_end: Any?,
  trial_from_plan: Bool?,
  trial_settings: Map?,
  default_payment_method: Str?,
  payment_behavior: Str?,
  payment_settings: Map?,
  proration_behavior: Str?,
  collection_method: Str?,
  days_until_due: Int?,
  cancel_at: Any?,
  cancel_at_period_end: Bool?,
  billing_cycle_anchor: Int?,
  billing_cycle_anchor_config: Map?,
  backdate_start_date: Int?,
  add_invoice_items: Vec<Map>?,
  default_tax_rates: Vec<Str>?,
  metadata: Map?,
  discounts: Vec<Map>?,
  automatic_tax: Map?,
  off_session: Bool?,
  expand: Vec<Str>?
}

create-subscription
meta {
    doc: """
POST /v1/subscriptions - Create a subscription for an existing customer. `items` is a list of `{price, quantity?}` maps. Apply a coupon or promotion code with `discounts: [{coupon: "..."}]` or `[{promotion_code: "promo_..."}]`.

With `payment_behavior: "default_incomplete"` the first invoice is left open for the customer to pay client-side; expand `latest_invoice.confirmation_secret` and hand its `client_secret` to Stripe.js. (`latest_invoice.payment_intent` no longer exists since API version 2025-03-31.basil.)

**Example**

```hot
::subs ::stripe::subscriptions

sub ::subs/create-subscription(::subs/CreateSubscriptionRequest({
  customer: "cus_...",
  items: [{price: "price_..."}],
  payment_behavior: "default_incomplete",
  payment_settings: {save_default_payment_method: "on_subscription"},
  expand: ["latest_invoice.confirmation_secret"]
}), ::stripe::api/RequestOptions({idempotency_key: "signup-42-sub"}))
sub.status                                          // => "incomplete"
sub.latest_invoice.confirmation_secret.client_secret  // => pass to Stripe.js
```
"""
}
fn
(request: CreateSubscriptionRequest): Map {
  create-subscription(request, RequestOptions({}))
},
(request: CreateSubscriptionRequest, options: RequestOptions): Map {
  api-call("POST", "/v1/subscriptions", request, options)
}

get-subscription
meta {
    doc: """GET /v1/subscriptions/{subscription} - Retrieve a subscription by ID. Optional `params` such as `{expand: ["latest_invoice", "default_payment_method"]}`. Billing periods are per item: read `items.data[0].current_period_end`."""
}
fn
(subscription: Str): Map {
  get-subscription(subscription, {})
},
(subscription: Str, params: Map): Map {
  api-call("GET", `/v1/subscriptions/${seg(subscription)}`, params)
}

UpdateSubscriptionRequest type {
  items: Vec<Map>?,
  description: Str?,
  cancel_at: Any?,
  cancel_at_period_end: Bool?,
  cancellation_details: Map?,
  proration_behavior: Str?,
  proration_date: Int?,
  billing_cycle_anchor: Map?,
  collection_method: Str?,
  days_until_due: Int?,
  default_payment_method: Str?,
  default_tax_rates: Vec<Str>?,
  trial_end: Any?,
  trial_from_plan: Bool?,
  metadata: Map?,
  discounts: Any?,
  payment_behavior: Str?,
  payment_settings: Map?,
  pause_collection: Any?,
  add_invoice_items: Vec<Map>?,
  automatic_tax: Map?,
  off_session: Bool?,
  expand: Vec<Str>?
}

update-subscription
meta {
    doc: """
POST /v1/subscriptions/{subscription} - Update a subscription. To change plans, pass `items` with the existing item `id` and the new `price`. Set `cancel_at_period_end: true` to schedule cancellation (and `false` to undo it). `pause_collection: {behavior: "void"}` stops collecting payment while keeping the subscription active; pass `pause_collection: ""` to clear it. `discounts: ""` removes all discounts. `billing_cycle_anchor: {type: "now"}` resets the billing cycle (since 2026-09-30.endive it is an object, not a string).

**Example**

```hot
::subs ::stripe::subscriptions

sub ::subs/get-subscription("sub_...")
::subs/update-subscription(sub.id, ::subs/UpdateSubscriptionRequest({
  items: [{id: sub.items.data[0].id, price: "price_pro"}],
  proration_behavior: "create_prorations"
}))
```
"""
}
fn
(subscription: Str, request: UpdateSubscriptionRequest): Map {
  update-subscription(subscription, request, RequestOptions({}))
},
(subscription: Str, request: UpdateSubscriptionRequest, options: RequestOptions): Map {
  api-call("POST", `/v1/subscriptions/${seg(subscription)}`, request, options)
}

CancelSubscriptionRequest type {
  invoice_now: Bool?,
  prorate: Bool?,
  cancellation_details: Map?,
  expand: Vec<Str>?
}

cancel-subscription
meta {
    doc: """
DELETE /v1/subscriptions/{subscription} - Cancel a subscription immediately. `invoice_now: true` bills pending usage and proration items now; `prorate: true` credits unused time; `cancellation_details: {comment, feedback}` records why (feedback is one of "customer_service", "low_quality", "missing_features", "other", "switched_service", "too_complex", "too_expensive", "unused"). To cancel at period end instead, use `update-subscription` with `cancel_at_period_end: true`.

**Example**

```hot
::subs ::stripe::subscriptions

::subs/cancel-subscription("sub_...", ::subs/CancelSubscriptionRequest({
  prorate: true,
  cancellation_details: {feedback: "too_expensive", comment: "Moving to annual billing elsewhere"}
}))
```
"""
}
fn
(subscription: Str): Map {
  cancel-subscription(subscription, CancelSubscriptionRequest({}))
},
(subscription: Str, request: CancelSubscriptionRequest): Map {
  api-call("DELETE", `/v1/subscriptions/${seg(subscription)}`, request)
}

ResumeSubscriptionRequest type {
  billing_cycle_anchor: Map?,
  payment_behavior: Str?,
  proration_behavior: Str?,
  proration_date: Int?,
  expand: Vec<Str>?
}

resume-subscription
meta {
    doc: """POST /v1/subscriptions/{subscription}/resume - Resume a subscription whose `status` is "paused" (one that ended a free trial without a payment method, or was paused with `pause-subscription`). This does not clear `pause_collection`; to restart collection on an active subscription, call `update-subscription` with `pause_collection: ""`. `billing_cycle_anchor` is `{type: "now"}` (default) or `{type: "unchanged"}`."""
}
fn
(subscription: Str): Map {
  resume-subscription(subscription, ResumeSubscriptionRequest({}), RequestOptions({}))
},
(subscription: Str, request: ResumeSubscriptionRequest): Map {
  resume-subscription(subscription, request, RequestOptions({}))
},
(subscription: Str, request: ResumeSubscriptionRequest, options: RequestOptions): Map {
  api-call("POST", `/v1/subscriptions/${seg(subscription)}/resume`, request, options)
}

PauseSubscriptionRequest type {
  type: Str?,
  bill_for: Map?,
  invoicing_behavior: Str?,
  expand: Vec<Str>?
}

pause-subscription
meta {
    doc: """POST /v1/subscriptions/{subscription}/pause - Pause a subscription (its `status` becomes "paused") until `resume-subscription` is called. `invoicing_behavior` is "pending_invoice_item" (default) or "invoice"; `bill_for` controls billing for outstanding usage and unused time. Distinct from `pause_collection`, which keeps the subscription active."""
}
fn
(subscription: Str): Map {
  pause-subscription(subscription, PauseSubscriptionRequest({}), RequestOptions({}))
},
(subscription: Str, request: PauseSubscriptionRequest): Map {
  pause-subscription(subscription, request, RequestOptions({}))
},
(subscription: Str, request: PauseSubscriptionRequest, options: RequestOptions): Map {
  api-call("POST", `/v1/subscriptions/${seg(subscription)}/pause`, request, options)
}

ListSubscriptionsRequest type {
  customer: Str?,
  price: Str?,
  status: Str?,
  collection_method: Str?,
  test_clock: Str?,
  created: Any?,
  current_period_end: Any?,
  current_period_start: Any?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-subscriptions
meta {
    doc: """GET /v1/subscriptions - List subscriptions. Filter by `customer`, `price`, or `status` ("active", "canceled", "trialing", "past_due", "paused", "unpaid", "incomplete", "incomplete_expired", "ended", or "all"). By default only non-canceled subscriptions are returned."""
}
fn
(): Map {
  list-subscriptions(ListSubscriptionsRequest({}))
},
(request: ListSubscriptionsRequest): Map {
  api-call("GET", "/v1/subscriptions", request)
}

search-subscriptions
meta {
    doc: """GET /v1/subscriptions/search - Search subscriptions with Stripe's search query language, e.g. `status:"active" AND metadata["plan"]:"pro"`. Pass `next_page` back as `page` in `params` to continue."""
}
fn
(query: Str): Map {
  search-subscriptions(query, {})
},
(query: Str, params: Map): Map {
  api-call("GET", "/v1/subscriptions/search", {...params, query: query})
}

// ============================================================================
// Subscription Items
// ============================================================================
// One item per price on a subscription. Add, re-price, or re-quantity a
// single item without resending the whole `items` list.

CreateSubscriptionItemRequest type {
  subscription: Str,
  price: Str?,
  price_data: Map?,
  quantity: Int?,
  discounts: Vec<Map>?,
  tax_rates: Vec<Str>?,
  metadata: Map?,
  payment_behavior: Str?,
  proration_behavior: Str?,
  proration_date: Int?,
  expand: Vec<Str>?
}

create-subscription-item
meta {
    doc: """
POST /v1/subscription_items - Add a price to an existing subscription.

**Example**

```hot
::subs ::stripe::subscriptions

::subs/create-subscription-item(::subs/CreateSubscriptionItemRequest({
  subscription: "sub_...",
  price: "price_addon",
  quantity: 3
}))
```
"""
}
fn
(request: CreateSubscriptionItemRequest): Map {
  create-subscription-item(request, RequestOptions({}))
},
(request: CreateSubscriptionItemRequest, options: RequestOptions): Map {
  api-call("POST", "/v1/subscription_items", request, options)
}

get-subscription-item
meta {
    doc: """GET /v1/subscription_items/{item} - Retrieve a subscription item by ID."""
}
fn (item: Str): Map {
  api-call("GET", `/v1/subscription_items/${seg(item)}`)
}

UpdateSubscriptionItemRequest type {
  price: Str?,
  price_data: Map?,
  quantity: Int?,
  discounts: Any?,
  tax_rates: Any?,
  metadata: Map?,
  off_session: Bool?,
  payment_behavior: Str?,
  proration_behavior: Str?,
  proration_date: Int?,
  expand: Vec<Str>?
}

update-subscription-item
meta {
    doc: """POST /v1/subscription_items/{item} - Change an item's price or quantity (e.g. seat count). `proration_behavior` is "create_prorations" (default), "always_invoice", or "none"."""
}
fn
(item: Str, request: UpdateSubscriptionItemRequest): Map {
  update-subscription-item(item, request, RequestOptions({}))
},
(item: Str, request: UpdateSubscriptionItemRequest, options: RequestOptions): Map {
  api-call("POST", `/v1/subscription_items/${seg(item)}`, request, options)
}

DeleteSubscriptionItemRequest type {
  clear_usage: Bool?,
  payment_behavior: Str?,
  proration_behavior: Str?,
  proration_date: Int?
}

delete-subscription-item
meta {
    doc: """DELETE /v1/subscription_items/{item} - Remove an item from its subscription. A subscription must keep at least one item; cancel the subscription instead to remove the last one."""
}
fn
(item: Str): Map {
  delete-subscription-item(item, DeleteSubscriptionItemRequest({}))
},
(item: Str, request: DeleteSubscriptionItemRequest): Map {
  api-call("DELETE", `/v1/subscription_items/${seg(item)}`, request)
}

ListSubscriptionItemsRequest type {
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-subscription-items
meta {
    doc: """GET /v1/subscription_items - List the items of a subscription."""
}
fn
(subscription: Str): Map {
  list-subscription-items(subscription, ListSubscriptionItemsRequest({}))
},
(subscription: Str, request: ListSubscriptionItemsRequest): Map {
  api-call("GET", "/v1/subscription_items", {...untype(request), subscription: subscription})
}
