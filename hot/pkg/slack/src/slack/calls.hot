    **Example**

    ```hot
    response ::slack::calls/calls-update(::slack::calls/CallsUpdateRequest({
      id: "R1234567",
      title: "Weekly sync (moved)"
    }))
    response.call.title
    ```
    """
}
fn
(request: CallsUpdateRequest): CallsUpdateResponse {
  calls-update(request, {})
},
(request: CallsUpdateRequest, opts: Map): CallsUpdateResponse {
  response api-request("POST", `${::slack::core/BASE_URL}/calls.update`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { CallsUpdateResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

// ============================================================================
// Call Participants
// ============================================================================

CallsParticipantsAddRequest type {
  id: Str,
  users: Vec<Map>
}

CallsParticipantsAddResponse type {
  ok: Bool?,
  error: Str?
}


calls-participants-add
meta {
    doc: """
    POST /calls.participants.add - Add new participants to a call. Each user
    in the `users` Vec should be a Map with a `slack_id` or `external_id`
    and `display_name`.

    **Example**

    ```hot
    response ::slack::calls/calls-participants-add(::slack::calls/CallsParticipantsAddRequest({
      id: "R1234567",
      users: [{slack_id: "U1234567"}, {external_id: "guest-1", display_name: "Sam"}]
    }))
    response.ok
    ```
    """
}
fn
(request: CallsParticipantsAddRequest): CallsParticipantsAddResponse {
  calls-participants-add(request, {})
},
(request: CallsParticipantsAddRequest, opts: Map): CallsParticipantsAddResponse {
  response api-request("POST", `${::slack::core/BASE_URL}/calls.participants.add`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { CallsParticipantsAddResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

CallsParticipantsRemoveRequest type {
  id: Str,
  users: Vec<Map>
}

CallsParticipantsRemoveResponse type {
  ok: Bool?,
  error: Str?
}


calls-participants-remove
meta {
    doc: """
    POST /calls.participants.remove - Remove participants from a call. Each
    user in the `users` Vec should be a Map with a `slack_id` or
    `external_id`.

    **Example**

    ```hot
    response ::slack::calls/calls-participants-remove(::slack::calls/CallsParticipantsRemoveRequest({
      id: "R1234567",
      users: [{slack_id: "U1234567"}]
    }))
    response.ok
    ```
    """
}
fn
(request: CallsParticipantsRemoveRequest): CallsParticipantsRemoveResponse {
  calls-participants-remove(request, {})
},
(request: CallsParticipantsRemoveRequest, opts: Map): CallsParticipantsRemoveResponse {
  response api-request("POST", `${::slack::core/BASE_URL}/calls.participants.remove`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { CallsParticipantsRemoveResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

// ============================================================================
// RTM
// ============================================================================

RtmConnectRequest type {
  batch_presence_aware: Bool?,
  presence_sub: Bool?
}

RtmConnectResponse type {
  ok: Bool?,
  error: Str?,
  url: Str?,
  team: Map?,
  self: Map?
}


rtm-connect
meta {
    doc: """
GET /rtm.connect - Start a Real Time Messaging session. Returns a WebSocket URL for receiving events in real time. Note: RTM may not be available for all token types (bot tokens may receive a `not_allowed_token_type` error).

**Example**

```hot
response ::slack::calls/rtm-connect(::slack::calls/RtmConnectRequest({}))
response.url   // => "wss://wss-primary.slack.com/websocket/..."
response.team  // => {id: "T1234", name: "My Team"}
response.self  // => {id: "U1234", name: "my-bot"}
```
"""
}
fn
(request: RtmConnectRequest): RtmConnectResponse {
  rtm-connect(request, {})
},
(request: RtmConnectRequest, opts: Map): RtmConnectResponse {
  response api-request("GET", ::slack::api/with-query(`${::slack::core/BASE_URL}/rtm.connect`, {batch_presence_aware: request.batch_presence_aware, presence_sub: request.presence_sub}), {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { RtmConnectResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
