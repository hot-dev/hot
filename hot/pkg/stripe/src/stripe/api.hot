::stripe::api ns
meta {
    ctx: {
        "stripe.api.key": {required: false},
        "stripe.api.version": {required: false, secret: false}
    },
    doc: """
    Authenticated access to the Stripe REST API: form encoding, the `Stripe-Version` / `Idempotency-Key` / `Stripe-Account` headers, error handling, and auto-pagination. The typed modules (`::stripe::customers`, `::stripe::payment-intents`, ...) are built on `call`; use it directly for any endpoint they don't cover.

    **Per-call credentials.** Every API-calling function takes an optional trailing options argument, a Map or a `RequestOptions`, resolved by `resolve`: options first, then the `stripe.*` context variables, then the defaults. Nothing from it is written to ctx, and a per-call key is masked in call records, so one run can act for many Stripe accounts.

    - `api-key`: the secret or restricted key for this call
    - `api-version`: the `Stripe-Version` for this call
    - `stripe-account`: the connected account to act for (Connect)
    - `idempotency-key`: the `Idempotency-Key` for this write

    An `api-key`, `stripe-account` or `idempotency-key` that is present but blank or null is an Err naming the key, never a fallback: a tenant whose key is missing must not run on the project's account, and a retry whose key is missing must not charge twice.
    """
}

// Namespace aliases
::ctx ::hot::ctx
::uri ::hot::uri

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError
meta {
    doc: """
    Represents an error response from the Stripe API. Wraps the HTTP status code, response headers, and error body returned by a failed request. Stripe's structured details (`type`, `code`, `message`, `param`, ...) are in `body.error`; see `::stripe/Error`.

    **Example**

    ```hot
    response ::stripe::api/request("GET", `${::stripe/BASE_URL}/v1/balance`)
    error ::stripe::api/HttpError(response)
    error.status  // => 401
    error.body.error.type  // => "invalid_request_error"
    ```
    """
}
type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError
meta {
    doc: """Coerce an HttpResponse into an HttpError. Automatically extracts status, headers, and body from the response."""
}
fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: response.headers,
    body: response.body
  })
}

// ============================================================================
// Request options
// ============================================================================

RequestOptions
meta {
    doc: """
    Per-request options, the typed form of the options Map every API-calling function takes last (see this namespace's doc). Field names match Stripe's official SDKs; in a plain Map use `api-key`, `api-version`, `stripe-account` and `idempotency-key`. The two forms mean the same thing.

    - `api_key`: the secret or restricted key for this call, instead of `stripe.api.key`.
    - `idempotency_key`: sent as `Idempotency-Key`. Stripe returns the stored result for a repeated key (within 24 hours) instead of performing the write again, so a retried create/confirm/capture/refund can never double-charge. Use a value tied to your own record, e.g. `order-42-charge`. Only POST requests use it.
    - `stripe_account`: sent as `Stripe-Account` to act on behalf of a connected account (Connect).
    - `stripe_version`: overrides the `Stripe-Version` for this call.

    **Example**

    ```hot
    ::pi ::stripe::payment-intents

    request ::pi/CreatePaymentIntentRequest({amount: 2000, currency: "usd"})

    ::pi/create-payment-intent(request, ::stripe::api/RequestOptions({idempotency_key: "order-42-payment"}))

    // The same call for another account, as a Map
    ::pi/create-payment-intent(request, {api-key: "sk_test_tenant", idempotency-key: "order-42-payment"})
    ```
    """
}
type {
    api_key: Str?,
    idempotency_key: Str?,
    stripe_account: Str?,
    stripe_version: Str?
}

// Each RequestOptions field's name in the options Map.
OPTION_KEYS {
  api_key: "api-key",
  idempotency_key: "idempotency-key",
  stripe_account: "stripe-account",
  stripe_version: "api-version"
}

// Keys that may not be present and blank: leaving out any of them changes
// who a call acts for, or whether a retry is safe.
REQUIRED_WHEN_PRESENT ["api-key", "stripe-account", "idempotency-key"]

to-opts
meta {
    doc: """
    The options Map for a `RequestOptions` or a Map. `RequestOptions` field names become their Map keys. An unset record field is simply absent; a Map key set to null stays present, so `resolve` can refuse it.

    **Example**

    ```hot
    ::stripe::api/to-opts(::stripe::api/RequestOptions({idempotency_key: "k1"}))
    // => {idempotency-key: "k1"}
    ```
    """
}
fn (options: RequestOptions | Map): Map {
  fields if(is-type(options, RequestOptions), filter-vals(untype(options), is-some(%)), options)
  map-keys(fields, (key) { get(OPTION_KEYS, key, key) })
}

non-blank
meta {no-doc: true}
fn (value: Any): Str? {
  if(is-str(value), if(is-empty(trim(value)), null, trim(value)), null)
}

blank-option
meta {
    doc: """
    The first of `names` that `opts` has with a blank or null value, else
    null.

    **Example**

    ```hot
    ::stripe::api/blank-option({stripe-account: " "}, ["api-key", "stripe-account"])  // "stripe-account"
    ::stripe::api/blank-option({stripe-account: "acct_123"}, ["api-key", "stripe-account"])  // null
    ```
    """
}
fn (opts: Map, names: Vec): Str? {
  find-first(names, (name) { and(in(name, keys(opts)), is-null(non-blank(get(opts, name)))) })
}

resolve-from
meta {
    doc: """
    The one resolver, pure: `{api-key, api-version}`, plus `stripe-account`
    and `idempotency-key` when set, from `options` first, then `ctx-values`
    (a Map of context variables), then `::stripe/API_VERSION`. An Err when
    no API key is set, or when `api-key`, `stripe-account` or
    `idempotency-key` is in `options` but blank or null. Exposed for
    testing; `resolve` feeds it the context.

    **Example**

    ```hot
    ctx-values {"stripe.api.key": "key-1"}

    ::stripe::api/resolve-from({stripe-account: "acct_123"}, ctx-values).api-key  // "key-1"
    ::stripe::api/resolve-from({stripe-account: "acct_123"}, ctx-values).stripe-account  // "acct_123"
    is-err(::stripe::api/resolve-from({stripe-account: ""}, ctx-values))  // true
    ```
    """
}
fn (options: RequestOptions | Map, ctx-values: Map): Map {
  opts to-opts(options)
  blank blank-option(opts, REQUIRED_WHEN_PRESENT)
  api-key or(non-blank(get(opts, "api-key")), non-blank(get(ctx-values, "stripe.api.key")))
  cond {
    is-some(blank) => {
      err(`stripe: ${blank} is in the call's options but is blank or null. Pass a value, or leave ${blank} out.`)
    }

    is-null(api-key) => { err("stripe: stripe.api.key is not set. Add it in Context Variables, or pass {api-key: ...} in the call's options.") }
    => {
      version or(non-blank(get(opts, "api-version")), non-blank(get(ctx-values, "stripe.api.version")), ::stripe/API_VERSION)
      settings {api-key: api-key, api-version: version}
      settings assoc-some(settings, "stripe-account", non-blank(get(opts, "stripe-account")))
      assoc-some(settings, "idempotency-key", non-blank(get(opts, "idempotency-key")))
    }
  }
}

resolve
meta {
    ctx: {
        "stripe.api.key": {required: false},
        "stripe.api.version": {required: false, secret: false}
    },
    doc: """
    Credentials and settings for one call (see `resolve-from`). The API key is masked in this run's call records, and nothing from `options` is written to ctx.

    **Example**

    ```hot
    ::stripe::api/resolve({api-key: "sk_test_tenant"}).api-version  // => "2026-10-28.endive"
    ```
    """
}
fn (options: RequestOptions | Map): Map {
  // First, so even the records of the calls below are masked.
  ::ctx/mark-secret([options.api-key, options.api_key])
  resolved resolve-from(options, {
    "stripe.api.key": ::ctx/get("stripe.api.key"),
    "stripe.api.version": ::ctx/get("stripe.api.version")
  })
  cond {
    is-err(resolved) => { resolved }
    => { {...resolved, api-key: ::ctx/mark-secret(resolved.api-key)} }
  }
}

api-version
meta {
    ctx: {"stripe.api.version": {required: false, secret: false}},
    doc: """
    The `Stripe-Version` sent when a call doesn't override it: the
    `stripe.api.version` context variable when set, otherwise
    `::stripe/API_VERSION`.

    **Example**

    ```hot
    // The version a call sends unless its options override it
    version ::stripe::api/api-version()
    ```
    """
}
fn (): Str {
  or(non-blank(::ctx/get("stripe.api.version")), ::stripe/API_VERSION)
}

option-headers
meta {
    doc: """
    The headers an options value adds to a request: `Idempotency-Key`, `Stripe-Account`, and `Stripe-Version` (only those that are set).

    **Example**

    ```hot
    ::stripe::api/option-headers(::stripe::api/RequestOptions({idempotency_key: "k1"}))
    // => {Idempotency-Key: "k1"}
    ```
    """
}
fn (options: RequestOptions | Map): Map {
  opts to-opts(options)
  filter-vals({
    Idempotency-Key: non-blank(get(opts, "idempotency-key")),
    Stripe-Account: non-blank(get(opts, "stripe-account")),
    Stripe-Version: non-blank(get(opts, "api-version"))
  }, is-some(%))
}

// ============================================================================
// Encoding
// ============================================================================

encode-pairs
meta {no-doc: true}
fn (key: Str, value: Any): Vec<Str> {
  cond {
    is-null(value) => { [] }
    is-map(value) => {
      reduce(keys(value), (acc, k) {
        concat(acc, encode-pairs(`${key}[${k}]`, get(value, k)))
      }, [])
    }

    is-vec(value) => {
      nested map-indexed(value, (i, item) { encode-pairs(`${key}[${i}]`, item) })
      reduce(nested, (acc, pairs) { concat(acc, pairs) }, [])
    }
    => {
      value-str `${value}`
      [`${::uri/encode(key)}=${::uri/encode(value-str)}`]
    }
  }
}

form-encode
meta {
    doc: """
    Encode a Map as `application/x-www-form-urlencoded` using Stripe's bracket syntax: nested maps become `metadata[order_id]=6735` and arrays become `expand[0]=customer`. Null values are omitted. Stripe does not accept JSON request bodies.

    **Example**

    ```hot
    ::stripe::api/form-encode({amount: 2000, currency: "usd", metadata: {order_id: "6735"}})
    // => "amount=2000&currency=usd&metadata%5Border_id%5D=6735"
    ```
    """
}
fn (data: Map): Str {
  parts reduce(keys(data), (acc, key) {
    concat(acc, encode-pairs(key, get(data, key)))
  }, [])
  join(parts, "&")
}

query-string
meta {
    doc: """
    Build a query string (`?limit=10&starting_after=cus_123`) from a Map.
    Null values are omitted; returns an empty string when no parameters
    remain. Uses the same bracket syntax as `form-encode`, so `expand:
    ["customer"]` becomes `expand[0]=customer`.

    **Example**

    ```hot
    ::stripe::api/query-string({limit: 10, email: null})  // "?limit=10"
    ::stripe::api/query-string({expand: ["customer"]})  // "?expand%5B0%5D=customer"
    ::stripe::api/query-string({})  // ""
    ```
    """
}
fn (params: Map): Str {
  encoded form-encode(untype(params))
  if(is-empty(encoded), "", `?${encoded}`)
}

encode-id
meta {
    doc: """
    Percent-encode an object ID for use as a URL path segment, so an ID
    taken from user input can't change which endpoint is called.

    **Example**

    ```hot
    ::stripe::api/encode-id("cus 1/2")  // "cus%201%2F2"
    ```
    """
}
fn (id: Str): Str {
  ::uri/encode(id)
}

// ============================================================================
// Requests
// ============================================================================

build-request
meta {
    doc: """
    Build (without sending) the `HttpRequest` for a Stripe call. GET and DELETE parameters go in the query string and POST parameters in a form-encoded body, as Stripe's SDKs do. Every request carries `Authorization` and `Stripe-Version`; `additional-headers` are merged last, so they can override either.

    **Example**

    ```hot
    req ::stripe::api/build-request("POST", `${::stripe/BASE_URL}/v1/customers`, {Idempotency-Key: "k1"}, {name: "Alice"}, "sk_test_123")
    req.headers.Stripe-Version  // => "2026-10-28.endive"
    req.body                    // => "name=Alice"
    ```
    """
}
fn
(method: Str, url: Str, additional-headers: Map, body: Any, api-key: Str): HttpRequest {
  build-request(method, url, additional-headers, body, {api-key: api-key, api-version: api-version()})
},
// 5-arity: resolved settings (see `resolve`)
(method: Str, url: Str, additional-headers: Map, body: Any, resolved: Map): HttpRequest {
  default-headers {
    Authorization: `Bearer ${resolved.api-key}`,
    Stripe-Version: resolved.api-version
  }

  encoded if(or(is-null(body), eq(body, "")), "", form-encode(untype(body)))
  in-query or(eq(uppercase(method), "GET"), eq(uppercase(method), "DELETE"))
  separator if(contains(url, "?"), "&", "?")
  final-url if(and(in-query, not(is-empty(encoded))), `${url}${separator}${encoded}`, url)
  encoded-body if(in-query, "", encoded)
  headers if(is-empty(encoded-body), default-headers, {...default-headers, Content-Type: "application/x-www-form-urlencoded"})

  HttpRequest({
    method,
    url: final-url,
    headers: {...headers, ...additional-headers},
    body: encoded-body
  })
}

request
meta {
    doc: """
    Make an authenticated HTTP request to the Stripe API and return the raw `HttpResponse`. Supports multiple arities for convenience.

    The API key comes from `stripe.api.key` by default, or from the 5-arity form: a key, or an options Map or `RequestOptions` (see `resolve`). `Stripe-Version` is always sent. Additional headers are merged over the defaults.

    A `url` outside `::stripe/BASE_URL` needs an `api-key` in the call: `stripe.api.key` is only ever sent to Stripe.

    Parameters are form-encoded with Stripe's bracket syntax (see `form-encode`): in the body for POST, in the query string for GET and DELETE.

    Prefer `call`, which also unwraps the body and turns non-2xx responses into `err(HttpError)`.

    **Example**

    ```hot
    // GET request — fetch balance
    response ::stripe::api/request("GET", `${::stripe/BASE_URL}/v1/balance`)
    response.status           // => 200
    response.body.available   // => [{amount: 1000, currency: "usd"}]

    // POST request — create a customer (body is form-encoded automatically)
    response ::stripe::api/request("POST", `${::stripe/BASE_URL}/v1/customers`, {}, {name: "Alice Smith"})

    // With an explicit API key
    response ::stripe::api/request("GET", `${::stripe/BASE_URL}/v1/balance`, {}, "", "sk_test_...")
    response ::stripe::api/request("GET", `${::stripe/BASE_URL}/v1/balance`, {}, "", {api-key: "sk_test_..."})
    ```
    """
}
fn
(method: Str, url: Str): HttpResponse {
  request(method, url, {}, "")
},
(method: Str, url: Str, additional-headers: Map): HttpResponse {
  request(method, url, additional-headers, "")
},
(method: Str, url: Str, additional-headers: Map, body: Any): HttpResponse {
  request(method, url, additional-headers, body, {})
},
// 5-arity: explicit api key
(method: Str, url: Str, additional-headers: Map, body: Any, api-key: Str): HttpResponse {
  request(method, url, additional-headers, body, {api-key: api-key})
},
// 5-arity: per-call credentials and settings (see `resolve`)
(method: Str, url: Str, additional-headers: Map, body: Any, options: RequestOptions | Map): HttpResponse {
  resolved resolve(options)
  cond {
    is-err(resolved) => { resolved }
    and(not(starts-with(url, `${::stripe/BASE_URL}/`)), is-null(get(to-opts(options), "api-key"))) => {
      err(`stripe: ${url} is not under ${::stripe/BASE_URL}, and the call has no api-key. Pass api-key with it. stripe.api.key is only sent to Stripe.`)
    }
    => {
      headers {...option-headers(resolved), ...additional-headers}
      ::hot::http/request(build-request(method, url, headers, body, resolved))
    }
  }
}

call
meta {
    doc: """
    Call a Stripe endpoint by path (relative to `::stripe/BASE_URL`) and return the decoded JSON body, or an Err carrying `HttpError` for non-2xx responses. `params` are sent as the query string for GET/DELETE and as the form body for POST; null values are omitted. `options` is a Map or `RequestOptions` with the call's key, version, Connect account and idempotency key (see `resolve`).

    **Example**

    ```hot
    // Endpoints without a typed wrapper
    clock ::stripe::api/call("POST", "/v1/test_helpers/test_clocks", {frozen_time: 1767225600})
    ::stripe::api/call("DELETE", `/v1/test_helpers/test_clocks/${clock.id}`)

    // With an idempotency key
    ::stripe::api/call("POST", "/v1/customers", {email: "alice@example.com"},
      ::stripe::api/RequestOptions({idempotency_key: "signup-alice"}))

    // For another account
    ::stripe::api/call("GET", "/v1/balance", "", {api-key: "sk_test_tenant"})
    ```
    """
}
fn
(method: Str, path: Str): Any {
  call(method, path, "", RequestOptions({}))
},
(method: Str, path: Str, params: Any): Any {
  call(method, path, params, RequestOptions({}))
},
(method: Str, path: Str, params: Any, options: RequestOptions | Map): Any {
  response request(method, `${::stripe/BASE_URL}${path}`, {}, params, options)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body }
    => { err(HttpError(response)) }
  }
}

// ============================================================================
// Pagination
// ============================================================================

next-page-params
meta {
    doc: """
    The params for the page after `page`, or null when `page` is the last one. List pages (`object: "list"`) continue with `starting_after` set to the last object's ID (or `ending_before` with the first, when paging backwards); search pages (`object: "search_result"`) continue with `page: next_page`.

    **Example**

    ```hot
    ::stripe::api/next-page-params({limit: 2}, {object: "list", has_more: true, data: [{id: "cus_1"}, {id: "cus_2"}]})
    // => {limit: 2, starting_after: "cus_2"}
    ```
    """
}
fn (params: Map, page: Map): Map? {
  data or(get(page, "data"), [])
  cond {
    not(eq(get(page, "has_more"), true)) => { null }
    is-empty(data) => { null }
    eq(get(page, "object"), "search_result") => {
      next get(page, "next_page")
      if(is-some(next), {...params, page: next}, null)
    }

    is-some(get(params, "ending_before")) => { {...params, ending_before: first(data).id} }
    => { {...params, starting_after: last(data).id} }
  }
}

collect-pages
meta {no-doc: true}
fn (path: Str, params: Map, max-items: Int, acc: Vec, options: RequestOptions | Map): Vec {
  page call("GET", path, params, options)
  cond {
    is-err(page) => { page }
    => {
      items concat(acc, or(page.data, []))
      next next-page-params(params, page)
      cond {
        and(gt(max-items, 0), gte(length(items), max-items)) => { take(items, max-items) }
        is-null(next) => { items }
        => { collect-pages(path, next, max-items, items, options) }
      }
    }
  }
}

list-all
meta {
    doc: """
    Auto-paginate a list or search endpoint: follows `has_more` (with `starting_after`, or `page` for `/search` endpoints) and returns every object as one Vec. `max-items` caps the total (default 1000; 0 means no cap). Pages are fetched 100 at a time unless `params.limit` says otherwise. An error on any page returns that page's Err.

    **Example**

    ```hot
    // Every active subscription for a customer
    subs ::stripe::api/list-all("/v1/subscriptions", {customer: "cus_...", status: "active"})

    // Search results, capped at 250
    hits ::stripe::api/list-all("/v1/customers/search", {query: `email:"alice@example.com"`}, 250)

    // For another account
    subs ::stripe::api/list-all("/v1/subscriptions", {}, 1000, {api-key: "sk_test_tenant"})
    ```
    """
}
fn
(path: Str): Vec {
  list-all(path, {}, 1000)
},
(path: Str, params: Map): Vec {
  list-all(path, params, 1000)
},
(path: Str, params: Map, max-items: Int): Vec {
  list-all(path, params, max-items, {})
},
(path: Str, params: Map, max-items: Int, options: RequestOptions | Map): Vec {
  p untype(params)
  collect-pages(path, {...p, limit: or(get(p, "limit"), 100)}, max-items, [], options)
}
