::openai::download ns

api-request ::openai::api/request
HttpError ::openai::api/HttpError
is-ok-response ::hot::http/is-ok-response

DownloadFileRequest type {
  file-id: Str
}

DownloadFileResponse type {
    value: Str
}


retrieve-file-content
meta {
    doc: """GET /files/{file_id}/content - Download the contents of an uploaded file."""
}
fn
(request: DownloadFileRequest): DownloadFileResponse {
  retrieve-file-content(request, {})
},
(request: DownloadFileRequest, opts: Map): DownloadFileResponse {
  response api-request("GET", `/files/${request.file-id}/content`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { DownloadFileResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
