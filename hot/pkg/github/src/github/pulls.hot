::github::pulls ns

::api ::github::api
query-string ::hot::uri/query-string

pull-path
meta {no-doc: true}
fn (owner: Str, repo: Str, number: Int): Str {
  `/repos/${owner}/${repo}/pulls/${number}`
}

review-path
meta {no-doc: true}
fn (owner: Str, repo: Str, number: Int, review-id: Any): Str {
  `${pull-path(owner, repo, number)}/reviews/${review-id}`
}

list-pulls
meta {
    doc: """
    GET /repos/{owner}/{repo}/pulls - List pull requests. `params` supports
    `state`, `head`, `base`, `sort`, `per_page`, `page`. Returns a single
    page (GitHub default 30, max 100); pass `page` to paginate.

    **Example**

    ```hot
    pulls ::github::pulls/list-pulls("acme", "api", {state: "open", base: "main"})
    map(pulls, %.number)
    ```
    """
}
fn
(owner: Str, repo: Str): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/pulls`)
},
(owner: Str, repo: Str, params: Map): Vec {
  list-pulls(owner, repo, params, {})
},
(owner: Str, repo: Str, params: Map, opts: Map): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/pulls${query-string(params)}`, {}, "", opts)
}

get-pull
meta {
    doc: """
    GET /repos/{owner}/{repo}/pulls/{number} - One pull request
    (mergeability, head/base, diff stats).

    **Example**

    ```hot
    pr ::github::pulls/get-pull("acme", "api", 68)
    pr.mergeable
    ```
    """
}
fn
(owner: Str, repo: Str, number: Int): Map {
  get-pull(owner, repo, number, {})
},
(owner: Str, repo: Str, number: Int, opts: Map): Map {
  ::api/json("GET", pull-path(owner, repo, number), {}, "", opts)
}

create-pull
meta {
    doc: """
    POST /repos/{owner}/{repo}/pulls - Open a pull request. `options`:
    `body`, `draft`, `maintainer_can_modify`.

    **Example**

    ```hot
    pr ::github::pulls/create-pull("acme", "api", "Add rate limiting", "feature/rate-limit", "main", {
      body: "Implements token-bucket limiting.",
      draft: true
    })
    pr.number
    ```
    """
}
fn
(owner: Str, repo: Str, title: Str, head: Str, base: Str): Map {
  create-pull(owner, repo, title, head, base, {})
},
(owner: Str, repo: Str, title: Str, head: Str, base: Str, options: Map): Map {
  create-pull(owner, repo, title, head, base, options, {})
},
(owner: Str, repo: Str, title: Str, head: Str, base: Str, options: Map, opts: Map): Map {
  ::api/json("POST", `/repos/${owner}/${repo}/pulls`, {}, {title: title, head: head, base: base, ...options}, opts)
}

update-pull
meta {
    doc: """
    PATCH /repos/{owner}/{repo}/pulls/{number} - Update a pull request.
    `changes` supports `title`, `body`, `state`, `base`, and
    `maintainer_can_modify`.

    **Example**

    ```hot
    ::github::pulls/update-pull("acme", "api", 68, {title: "Add rate limiting", state: "open"})
    ```
    """
}
fn
(owner: Str, repo: Str, number: Int, changes: Map): Map {
  update-pull(owner, repo, number, changes, {})
},
(owner: Str, repo: Str, number: Int, changes: Map, opts: Map): Map {
  ::api/json("PATCH", pull-path(owner, repo, number), {}, changes, opts)
}

list-files
meta {
    doc: """
    GET /repos/{owner}/{repo}/pulls/{number}/files - The files changed by a
    pull request (filename, status, additions/deletions, patch). `params`
    supports `per_page`, `page`. Returns a single page (GitHub default 30,
    max 100); pass `page` to paginate.

    **Example**

    ```hot
    changed ::github::pulls/list-files("acme", "api", 68, {per_page: 100})
    map(changed, %.filename)
    ```
    """
}
fn
(owner: Str, repo: Str, number: Int): Vec {
  ::api/json("GET", `${pull-path(owner, repo, number)}/files`)
},
(owner: Str, repo: Str, number: Int, params: Map): Vec {
  list-files(owner, repo, number, params, {})
},
(owner: Str, repo: Str, number: Int, params: Map, opts: Map): Vec {
  ::api/json("GET", `${pull-path(owner, repo, number)}/files${query-string(params)}`, {}, "", opts)
}

list-pull-commits
meta {
    doc: """
    GET /repos/{owner}/{repo}/pulls/{number}/commits - Commits in a pull
    request, in chronological order. `params` supports `per_page` and `page`.
    GitHub caps this endpoint at 250 commits.

    **Example**

    ```hot
    commits ::github::pulls/list-pull-commits("acme", "api", 68)
    map(commits, %.sha)
    ```
    """
}
fn
(owner: Str, repo: Str, number: Int): Vec {
  ::api/json("GET", `${pull-path(owner, repo, number)}/commits`)
},
(owner: Str, repo: Str, number: Int, params: Map): Vec {
  list-pull-commits(owner, repo, number, params, {})
},
(owner: Str, repo: Str, number: Int, params: Map, opts: Map): Vec {
  ::api/json("GET", `${pull-path(owner, repo, number)}/commits${query-string(params)}`, {}, "", opts)
}

