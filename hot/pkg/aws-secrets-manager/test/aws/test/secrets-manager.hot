::aws::test::secrets-manager ns
meta ["test"]

// Hermetic: no network, no aws.* context. A `transport` in opts stands in for the network.

::secrets ::aws::secrets-manager::secrets

HttpResponse ::hot::http/HttpResponse

// Every call is answered 418 with the signed request as the body.
echo fn (): Map {
    {
        "access-key-id": "AKIDOPTS",
        "secret-access-key": "opts-secret",
        region: "eu-west-1",
        transport: (req) { HttpResponse({status: 418, headers: {}, body: req}) }
    }
}

// The request a call would have sent.
sent fn (result: Result): Any {
    if(is-err(result), err-value(result).body, result.body)
}

// Every call is answered 200 with these headers and body.
answer fn (headers: Map, body: Any): Map {
    {
        "access-key-id": "AKIDOPTS",
        "secret-access-key": "opts-secret",
        region: "eu-west-1",
        transport: (req) { HttpResponse({status: 200, headers: headers, body: body, body-bytes: if(is-bytes(body), body, Bytes(""))}) }
    }
}

// Answered 200 with an AWS JSON body, which the runtime hands over as Bytes.
amz fn (body: Map): Map {
    answer({"content-type": "application/x-amz-json-1.0"}, Bytes(to-json(body)))
}

assert-missing-credentials fn (result: Result) {
    assert(is-err(result))
    assert(contains(err-value(result), "aws.access-key-id"))
}

assert-target fn (result: Result, target: Str) {
    request sent(result)
    assert-eq("https://secretsmanager.eu-west-1.amazonaws.com/", request.url)
    assert-eq(`secretsmanager.${target}`, get(request.headers, "X-Amz-Target"))
    auth get(request.headers, "Authorization")
    assert(contains(auth, "Credential=AKIDOPTS/"), auth)
    assert(contains(auth, "/eu-west-1/secretsmanager/aws4_request"), auth)
    assert(is-null(::hot::ctx/get("aws.access-key-id")), "no ctx writes")
}

test-opts-reach-the-request
meta ["test"] fn () {
    assert-target(::secrets/get-secret-value("s", echo()), "GetSecretValue")
    assert-target(::secrets/get-secret-value("s", "AWSPENDING", echo()), "GetSecretValue")
    assert-target(::secrets/get-secret-value("s", "v1", "AWSCURRENT", echo()), "GetSecretValue")
    assert-target(::secrets/create-secret("n", "v", echo()), "CreateSecret")
    assert-target(::secrets/create-secret("n", "v", "d", echo()), "CreateSecret")
    assert-target(::secrets/create-secret("n", "v", "d", null, null, echo()), "CreateSecret")
    assert-target(::secrets/put-secret-value("s", "v", echo()), "PutSecretValue")
    assert-target(::secrets/update-secret("s", "d", null, echo()), "UpdateSecret")
    assert-target(::secrets/delete-secret("s", echo()), "DeleteSecret")
    assert-target(::secrets/delete-secret("s", 7, echo()), "DeleteSecret")
    assert-target(::secrets/restore-secret("s", echo()), "RestoreSecret")
    assert-target(::secrets/describe-secret("s", echo()), "DescribeSecret")
    assert-target(::secrets/list-secrets(echo()), "ListSecrets")
    assert-target(::secrets/list-secrets(10, echo()), "ListSecrets")
    assert-target(::secrets/rotate-secret("s", echo()), "RotateSecret")
}

test-unset-optionals-arent-sent
meta ["test"] fn () {
    forced from-json(sent(::secrets/delete-secret("s", null, true, echo())).body)
    assert-eq(true, forced.ForceDeleteWithoutRecovery)
    assert(not(in("RecoveryWindowInDays", keys(forced))), "AWS refuses both together")

    body from-json(sent(::secrets/get-secret-value("s", null, "AWSCURRENT", echo())).body)
    assert-eq("AWSCURRENT", body.VersionStage)
    assert(not(in("VersionId", keys(body))))
}

test-existing-arities-read-ctx
meta ["test"] fn () {
    assert-missing-credentials(::secrets/get-secret-value("s"))
    assert-missing-credentials(::secrets/get-secret-value("s", "AWSPENDING"))
    assert-missing-credentials(::secrets/get-secret-value("s", null, "AWSCURRENT"))
    assert-missing-credentials(::secrets/list-secrets())
    assert-missing-credentials(::secrets/rotate-secret("s", "arn", {}))
}

test-amz-json-with-epoch-dates
meta ["test"] fn () {
    // AWS sends dates as epoch numbers; the types declare Str
    value ::secrets/get-secret-value("s", amz({ARN: "a", Name: "n", SecretString: "shh", VersionStages: ["AWSCURRENT"], CreatedDate: 1523477145.713}))
    assert-eq("shh", value.secret_string)
    assert-eq("1523477145.713", value.created_date)

    described ::secrets/describe-secret("s", amz({Name: "n", LastChangedDate: 1.5, DeletedDate: 2.5, CreatedDate: 3.5}))
    assert-eq("n", described.name)
    assert-eq("1.5", described.last_changed_date)

    listed ::secrets/list-secrets(amz({SecretList: [{Name: "n", CreatedDate: 3.5}], NextToken: "t"}))
    assert-eq("3.5", first(listed.secrets).created_date)
    assert-eq("t", listed.next_token)

    deleted ::secrets/delete-secret("s", amz({Name: "n", DeletionDate: 4.5}))
    assert-eq("4.5", deleted.deletion_date)
}

test-unsafe-region-never-reaches-the-request
meta ["test"] fn () {
    out ::secrets/describe-secret("s", {...echo(), region: "evil.example/"})
    assert(is-err(out), "it would be interpolated into the hostname")
    assert(not(contains(err-value(out), "evil.example")), "the value isn't echoed")
}
