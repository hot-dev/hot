::intercom::tags ns
meta {
    ctx: {
        "intercom.token": {required: false},
        "intercom.admin.id": {required: false, secret: false}
    },
    doc: """Tags: list, create or rename, delete, and tag or untag contacts and conversations. Tagging conversations is recorded as the admin in `intercom.admin.id`."""
}

::api ::intercom::api

list-tags
meta {
    doc: """
    GET /tags - Every tag in the workspace: `{type: "list", data: [...]}`.

    **Example**

    ```hot
    tags ::intercom::tags/list-tags()
    map(tags.data, %.name)
    ```
    """
}
fn
(): Any {
  list-tags({})
},
(opts: Map): Any {
  ::api/request("GET", "/tags", "", opts)
}

create-tag
meta {
    doc: """
    POST /tags - Create a tag by name, or return the existing tag with that
    name.

    **Example**

    ```hot
    tag ::intercom::tags/create-tag("vip")
    tag.id
    ```
    """
}
fn
(name: Str): Any {
  create-tag(name, {})
},
(name: Str, opts: Map): Any {
  ::api/request("POST", "/tags", {name: name}, opts)
}

rename-tag
meta {
    doc: """
    POST /tags with an `id` - Rename an existing tag.

    **Example**

    ```hot
    ::intercom::tags/rename-tag("7522907", "enterprise")
    ```
    """
}
fn
(id: Str, name: Str): Any {
  rename-tag(id, name, {})
},
(id: Str, name: Str, opts: Map): Any {
  ::api/request("POST", "/tags", {id: id, name: name}, opts)
}

get-tag
meta {
    doc: """
    GET /tags/{id} - One tag.

    **Example**

    ```hot
    tag ::intercom::tags/get-tag("7522907")
    tag.name
    ```
    """
}
fn
(id: Str): Any {
  get-tag(id, {})
},
(id: Str, opts: Map): Any {
  ::api/request("GET", `/tags/${::api/path-segment(id)}`, "", opts)
}

delete-tag
meta {
    doc: """
    DELETE /tags/{id} - Delete a tag. Intercom refuses while the tag is used
    by rules or messages.

    **Example**

    ```hot
    ::intercom::tags/delete-tag("7522907")
    ```
    """
}
fn
(id: Str): Any {
  delete-tag(id, {})
},
(id: Str, opts: Map): Any {
  ::api/request("DELETE", `/tags/${::api/path-segment(id)}`, "", opts)
}

tag-contact
meta {
    doc: """
    POST /contacts/{id}/tags - Apply a tag (by tag id) to a contact. Returns
    the tag.

    **Example**

    ```hot
    ::intercom::tags/tag-contact("6643703ffae7834d1792fd30", "7522907")
    ```
    """
}
fn
(contact-id: Str, tag-id: Str): Any {
  tag-contact(contact-id, tag-id, {})
},
(contact-id: Str, tag-id: Str, opts: Map): Any {
  ::api/request("POST", `/contacts/${::api/path-segment(contact-id)}/tags`, {id: tag-id}, opts)
}

untag-contact
meta {
    doc: """
    DELETE /contacts/{id}/tags/{tag_id} - Remove a tag from a contact.
    Returns the tag.

    **Example**

    ```hot
    ::intercom::tags/untag-contact("6643703ffae7834d1792fd30", "7522907")
    ```
    """
}
fn
(contact-id: Str, tag-id: Str): Any {
  untag-contact(contact-id, tag-id, {})
},
(contact-id: Str, tag-id: Str, opts: Map): Any {
  ::api/request("DELETE", `/contacts/${::api/path-segment(contact-id)}/tags/${::api/path-segment(tag-id)}`, "", opts)
}

tag-conversation
meta {
    ctx: {"intercom.admin.id": {required: false, secret: false}},
    doc: """
    POST /conversations/{id}/tags - Apply a tag (by tag id) to a
    conversation, as the configured admin.

    **Example**

    ```hot
    bug ::intercom::tags/create-tag("bug")
    ::intercom::tags/tag-conversation("215473041", bug.id)
    ```
    """
}
fn
(conversation-id: Str, tag-id: Str): Any {
  tag-conversation(conversation-id, tag-id, {})
},
(conversation-id: Str, tag-id: Str, opts: Map): Any {
  ::api/with-admin(opts, (admin) {
    ::api/request("POST", `/conversations/${::api/path-segment(conversation-id)}/tags`, {id: tag-id, admin_id: admin}, opts)
  })
}

untag-conversation
meta {
    ctx: {"intercom.admin.id": {required: false, secret: false}},
    doc: """
    DELETE /conversations/{id}/tags/{tag_id} - Remove a tag from a
    conversation, as the configured admin.

    **Example**

    ```hot
    ::intercom::tags/untag-conversation("215473041", "7522907")
    ```
    """
}
fn
(conversation-id: Str, tag-id: Str): Any {
  untag-conversation(conversation-id, tag-id, {})
},
(conversation-id: Str, tag-id: Str, opts: Map): Any {
  ::api/with-admin(opts, (admin) {
    ::api/request("DELETE", `/conversations/${::api/path-segment(conversation-id)}/tags/${::api/path-segment(tag-id)}`, {admin_id: admin}, opts)
  })
}
