::supabase::db ns

::api ::supabase::api
::uri ::hot::uri

CountMode type "exact" | "planned" | "estimated"

DbResponse type {
  status: Int,
  headers: Map,
  body: Any,
  count: Int?
}

enc
meta {no-doc: true}
fn (value: Any): Str {
  ::uri/encode(Str(value))
}

query-param
meta {no-doc: true}
fn (name: Str, value: Any): Str {
  if(is-some(value), `${enc(name)}=${enc(value)}`, "")
}

join-query
meta {no-doc: true}
fn (parts: Vec<Str>): Str {
  active filter(parts, not(is-empty(%)))
  join(active, "&")
}

append-query
meta {no-doc: true}
fn (path: Str, parts: Vec<Str>): Str {
  query join-query(parts)
  if(is-empty(query), path, `${path}?${query}`)
}

filters-query
meta {no-doc: true}
fn (filters: Vec<Str>?): Str {
  cond {
    is-null(filters) => { "" }
    is-empty(filters) => { "" }
    => { join(filters, "&") }
  }
}

read-headers
meta {no-doc: true}
fn (schema: Str?): Map {
  {} |> assoc-some("Accept-Profile", schema)
}

write-headers
meta {no-doc: true}
fn (schema: Str?): Map {
  {} |> assoc-some("Content-Profile", schema)
}

parse-count
meta {no-doc: true}
fn (headers: Map): Int? {
  raw or(get(headers, "content-range"), get(headers, "Content-Range"))
  cond {
    is-null(raw) => { null }
    not(contains(raw, "/")) => { null }
    => {
      total last(split(raw, "/"))
      if(eq(total, "*"), null, Int(total))
    }
  }
}

db-response
meta {no-doc: true}
fn (response: Result): DbResponse {
  cond {
    is-err(response) => { response }
    => {
      DbResponse({
        status: response.status,
        headers: response.headers,
        body: response.body,
        count: parse-count(response.headers)
      })
    }
  }
}

body-or-error
meta {no-doc: true}
fn (response: Result): Any {
  cond {
    is-err(response) => { response }
    not(::api/is-ok-response(response)) => { err(::api/HttpError(response)) }
    => { response.body }
  }
}

table-path
meta {no-doc: true}
fn (table: Str): Str {
  `/rest/v1/${enc(table)}`
}

rpc-path
meta {no-doc: true}
fn (fn-name: Str): Str {
  `/rest/v1/rpc/${enc(fn-name)}`
}

// ============================================================================
// Select (Read)
// ============================================================================

SelectRequest type {
  table: Str,
  select: Str?,
  filters: Vec<Str>?,
  order: Str?,
  limit: Int?,
  offset: Int?,
  count: CountMode?,
  schema: Str?,
  single: Bool?
}

select
meta {
    doc: """
Query rows from a table or view using PostgREST.

`select` specifies columns (default `*`). Use `filters` for WHERE clauses (build with `::supabase::filters`). `order` uses PostgREST format like `"created_at.desc"`. Set `count` to `"exact"`, `"planned"`, or `"estimated"` for row counts. Set `single: true` to return a single object instead of an array.

**Example**

```hot
::db ::supabase::db
::f ::supabase::filters

// Select all users
users ::db/select(::db/SelectRequest({table: "users"}))

// Filtered, ordered, paginated
users ::db/select(::db/SelectRequest({
  table: "users",
  select: "id,name,email,posts(title)",
  filters: [::f/gte("age", 18), ::f/eq("active", true)],
  order: "created_at.desc",
  limit: 10,
  offset: 0
}))

// Single row
user ::db/select(::db/SelectRequest({
  table: "users",
  filters: [::f/eq("id", "abc-123")],
  single: true
}))
```
"""
}
fn
(request: SelectRequest): Any {
  select(request, {})
},
(request: SelectRequest, opts: Map): Any {
  body-or-error(select-response(request, opts))
}

select-as
meta {
    doc: """
    Like `select`, but as a signed-in user. `access-token` is the Bearer
    token, so row level security applies as that user.

    **Example**

    ```hot
    ::db ::supabase::db

    token ::hot::ctx/get("supabase.user.token")
    orders ::db/select-as(::db/SelectRequest({table: "orders", limit: 20}), token)
    length(orders)
    ```
    """
}
fn
(request: SelectRequest, access-token: Str): Any {
  select-as(request, access-token, {})
},
(request: SelectRequest, access-token: Str, opts: Map): Any {
  body-or-error(select-response-as(request, access-token, opts))
}

select-service
meta {
    doc: """
    Like `select`, with the service role key, which bypasses row level
    security. Server-side only.

    **Example**

    ```hot
    ::db ::supabase::db

    orders ::db/select-service(::db/SelectRequest({table: "orders", limit: 20}))

    // Another project, for this call only
    tenant {url: "https://tenant-b.supabase.co", service-key: ::hot::ctx/get("tenant.service.key")}
    tenant-orders ::db/select-service(::db/SelectRequest({table: "orders", limit: 20}), tenant)
    ```
    """
}
fn
(request: SelectRequest): Any {
  select-service(request, {})
},
(request: SelectRequest, opts: Map): Any {
  body-or-error(select-response-service(request, opts))
}

select-response
meta {
    doc: """
    Like `select`, but returns a `DbResponse`: `status`, `headers`, `body`,
    and `count`, which is the total from the `Content-Range` header when the
    request sets `count`. A non-2xx status is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db
    ::f ::supabase::filters

    page ::db/select-response(::db/SelectRequest({
      table: "orders",
      filters: [::f/eq("status", "open")],
      count: "exact",
      limit: 20
    }))

    // Total matching rows, across all pages
    page.count
    page.body
    ```
    """
}
fn
(request: SelectRequest): DbResponse {
  select-response(request, {})
},
(request: SelectRequest, opts: Map): DbResponse {
  db-response(select-http-response(request, opts))
}

select-response-as
meta {
    doc: """
    Like `select-as`, but returns a `DbResponse` with `count`. See
    `select-response`.

    **Example**

    ```hot
    ::db ::supabase::db

    token ::hot::ctx/get("supabase.user.token")
    page ::db/select-response-as(::db/SelectRequest({table: "orders", count: "exact", limit: 20}), token)
    page.count
    page.body
    ```
    """
}
fn
(request: SelectRequest, access-token: Str): DbResponse {
  select-response-as(request, access-token, {})
},
(request: SelectRequest, access-token: Str, opts: Map): DbResponse {
  db-response(select-http-response-as(request, access-token, opts))
}

select-response-service
meta {
    doc: """
    Like `select-service`, but returns a `DbResponse` with `count`. See
    `select-response`.

    **Example**

    ```hot
    ::db ::supabase::db

    page ::db/select-response-service(::db/SelectRequest({table: "orders", count: "exact", limit: 20}))
    page.count
    page.body
    ```
    """
}
fn
(request: SelectRequest): DbResponse {
  select-response-service(request, {})
},
(request: SelectRequest, opts: Map): DbResponse {
  db-response(select-http-response-service(request, opts))
}

select-path
meta {no-doc: true}
fn (request: SelectRequest): Str {
  select-param or(request.select, "*")
  append-query(table-path(request.table), [
    query-param("select", select-param),
    filters-query(request.filters),
    query-param("order", request.order),
    query-param("limit", request.limit),
    query-param("offset", request.offset)
  ])
}

select-headers
meta {no-doc: true}
fn (request: SelectRequest): Map {
  prefer if(is-some(request.count), `count=${untype(request.count)}`, null)
  accept if(and(is-some(request.single), request.single), "application/vnd.pgrst.object+json", null)
  read-headers(request.schema)
    |> assoc-some("Prefer", prefer)
    |> assoc-some("Accept", accept)
}

select-http-response
meta {
    doc: """
    Like `select`, but returns the full `HttpResponse`. A non-2xx status is
    not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    response ::db/select-http-response(::db/SelectRequest({table: "orders", limit: 20}))
    response.status
    response.headers
    ```
    """
}
fn
(request: SelectRequest): ::api/HttpResponse {
  select-http-response(request, {})
},
(request: SelectRequest, opts: Map): ::api/HttpResponse {
  ::api/request-raw("GET", select-path(request), select-headers(request), {}, opts)
}

select-http-response-as
meta {
    doc: """
    Like `select-as`, but returns the full `HttpResponse`. A non-2xx status
    is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    token ::hot::ctx/get("supabase.user.token")
    response ::db/select-http-response-as(::db/SelectRequest({table: "orders", limit: 20}), token)
    response.status
    ```
    """
}
fn
(request: SelectRequest, access-token: Str): ::api/HttpResponse {
  select-http-response-as(request, access-token, {})
},
(request: SelectRequest, access-token: Str, opts: Map): ::api/HttpResponse {
  ::api/request-raw-as("GET", select-path(request), select-headers(request), {}, access-token, opts)
}

select-http-response-service
meta {
    doc: """
    Like `select-service`, but returns the full `HttpResponse`. A non-2xx
    status is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    response ::db/select-http-response-service(::db/SelectRequest({table: "orders", limit: 20}))
    response.status
    ```
    """
}
fn
(request: SelectRequest): ::api/HttpResponse {
  select-http-response-service(request, {})
},
(request: SelectRequest, opts: Map): ::api/HttpResponse {
  ::api/request-raw-service("GET", select-path(request), select-headers(request), {}, opts)
}

// ============================================================================
// Insert
// ============================================================================

InsertRequest type {
  table: Str,
  data: Any,
  return: Bool?,
  on-conflict: Str?,
  count: CountMode?,
  schema: Str?,
  missing-as-default: Bool?
}

insert
meta {
    doc: """
Insert one or more rows into a table. `data` can be a Map (single row) or Vec of Maps (multiple rows).

Set `return: true` to get the inserted rows back (default: true). Set `on-conflict` to a column name to handle conflicts (e.g. upsert).

**Example**

```hot
::db ::supabase::db

// Single row
row ::db/insert(::db/InsertRequest({
  table: "users",
  data: {name: "Alice", email: "alice@example.com"}
}))

// Multiple rows
rows ::db/insert(::db/InsertRequest({
  table: "users",
  data: [
    {name: "Alice", email: "alice@example.com"},
    {name: "Bob", email: "bob@example.com"}
  ]
}))
```
"""
}
fn
(request: InsertRequest): Any {
  insert(request, {})
},
(request: InsertRequest, opts: Map): Any {
  body-or-error(insert-response(request, opts))
}

insert-as
meta {
    doc: """
    Like `insert`, but as a signed-in user. `access-token` is the Bearer
    token, so row level security applies as that user.

    **Example**

    ```hot
    ::db ::supabase::db

    token ::hot::ctx/get("supabase.user.token")
    ::db/insert-as(::db/InsertRequest({table: "orders", data: {sku: "X1", qty: 2}}), token)
    ```
    """
}
fn
(request: InsertRequest, access-token: Str): Any {
  insert-as(request, access-token, {})
},
(request: InsertRequest, access-token: Str, opts: Map): Any {
  body-or-error(insert-response-as(request, access-token, opts))
}

insert-service
meta {
    doc: """
    Like `insert`, with the service role key, which bypasses row level
    security. Server-side only.

    **Example**

    ```hot
    ::db ::supabase::db

    ::db/insert-service(::db/InsertRequest({table: "orders", data: {sku: "X1", qty: 2}}))
    ```
    """
}
fn
(request: InsertRequest): Any {
  insert-service(request, {})
},
(request: InsertRequest, opts: Map): Any {
  body-or-error(insert-response-service(request, opts))
}

insert-response
meta {
    doc: """
    Like `insert`, but returns the full `HttpResponse`. A non-2xx status is
    not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    response ::db/insert-response(::db/InsertRequest({table: "orders", data: {sku: "X1", qty: 2}}))
    response.status
    response.body
    ```
    """
}
fn
(request: InsertRequest): ::api/HttpResponse {
  insert-response(request, {})
},
(request: InsertRequest, opts: Map): ::api/HttpResponse {
  ::api/request-raw("POST", insert-path(request), insert-headers(request), request.data, opts)
}

insert-response-as
meta {
    doc: """
    Like `insert-as`, but returns the full `HttpResponse`. A non-2xx status
    is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    token ::hot::ctx/get("supabase.user.token")
    response ::db/insert-response-as(::db/InsertRequest({table: "orders", data: {sku: "X1", qty: 2}}), token)
    response.status
    response.body
    ```
    """
}
fn
(request: InsertRequest, access-token: Str): ::api/HttpResponse {
  insert-response-as(request, access-token, {})
},
(request: InsertRequest, access-token: Str, opts: Map): ::api/HttpResponse {
  ::api/request-raw-as("POST", insert-path(request), insert-headers(request), request.data, access-token, opts)
}

insert-response-service
meta {
    doc: """
    Like `insert-service`, but returns the full `HttpResponse`. A non-2xx
    status is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    response ::db/insert-response-service(::db/InsertRequest({table: "orders", data: {sku: "X1", qty: 2}}))
    response.status
    response.body
    ```
    """
}
fn
(request: InsertRequest): ::api/HttpResponse {
  insert-response-service(request, {})
},
(request: InsertRequest, opts: Map): ::api/HttpResponse {
  ::api/request-raw-service("POST", insert-path(request), insert-headers(request), request.data, opts)
}

insert-path
meta {no-doc: true}
fn (request: InsertRequest): Str {
  append-query(table-path(request.table), [
    query-param("on_conflict", request.on-conflict)
  ])
}

insert-headers
meta {no-doc: true}
fn (request: InsertRequest): Map {
  should-return if(is-null(request.return), true, request.return)
  prefer-parts [
    if(should-return, "return=representation", "return=minimal")
  ]
  prefer-parts if(is-some(request.on-conflict), concat(prefer-parts, ["resolution=merge-duplicates"]), prefer-parts)
  prefer-parts if(is-some(request.count), concat(prefer-parts, [`count=${untype(request.count)}`]), prefer-parts)
  prefer-parts if(and(is-some(request.missing-as-default), request.missing-as-default), concat(prefer-parts, ["missing=default"]), prefer-parts)

  write-headers(request.schema)
    |> assoc("Prefer", join(prefer-parts, ", "))
}

// ============================================================================
// Update
// ============================================================================

UpdateRequest type {
  table: Str,
  data: Map,
  filters: Vec<Str>,
  return: Bool?,
  count: CountMode?,
  schema: Str?
}

update
meta {
    doc: """
Update rows matching the filters. `filters` is required to prevent accidental full-table updates.

**Example**

```hot
::db ::supabase::db
::f ::supabase::filters

updated ::db/update(::db/UpdateRequest({
  table: "users",
  data: {name: "Alice Smith"},
  filters: [::f/eq("id", "abc-123")]
}))
```
"""
}
fn
(request: UpdateRequest): Any {
  update(request, {})
},
(request: UpdateRequest, opts: Map): Any {
  body-or-error(update-response(request, opts))
}

update-as
meta {
    doc: """
    Like `update`, but as a signed-in user. `access-token` is the Bearer
    token, so row level security applies as that user.

    **Example**

    ```hot
    ::db ::supabase::db
    ::f ::supabase::filters

    token ::hot::ctx/get("supabase.user.token")
    ::db/update-as(::db/UpdateRequest({
      table: "orders",
      data: {status: "shipped"},
      filters: [::f/eq("id", 42)]
    }), token)
    ```
    """
}
fn
(request: UpdateRequest, access-token: Str): Any {
  update-as(request, access-token, {})
},
(request: UpdateRequest, access-token: Str, opts: Map): Any {
  body-or-error(update-response-as(request, access-token, opts))
}

update-service
meta {
    doc: """
    Like `update`, with the service role key, which bypasses row level
    security. Server-side only.

    **Example**

    ```hot
    ::db ::supabase::db
    ::f ::supabase::filters

    ::db/update-service(::db/UpdateRequest({
      table: "orders",
      data: {status: "shipped"},
      filters: [::f/eq("id", 42)]
    }))
    ```
    """
}
fn
(request: UpdateRequest): Any {
  update-service(request, {})
},
(request: UpdateRequest, opts: Map): Any {
  body-or-error(update-response-service(request, opts))
}

update-response
meta {
    doc: """
    Like `update`, but returns the full `HttpResponse`. A non-2xx status is
    not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db
    ::f ::supabase::filters

    response ::db/update-response(::db/UpdateRequest({
      table: "orders",
      data: {status: "shipped"},
      filters: [::f/eq("id", 42)]
    }))
    response.status
    response.body
    ```
    """
}
fn
(request: UpdateRequest): ::api/HttpResponse {
  update-response(request, {})
},
(request: UpdateRequest, opts: Map): ::api/HttpResponse {
  validate-filters(request.filters, "update")
  ::api/request-raw("PATCH", filtered-table-path(request.table, request.filters), mutation-headers(request.return, request.count, request.schema), request.data, opts)
}

update-response-as
meta {
    doc: """
    Like `update-as`, but returns the full `HttpResponse`. A non-2xx status
    is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db
    ::f ::supabase::filters

    token ::hot::ctx/get("supabase.user.token")
    response ::db/update-response-as(::db/UpdateRequest({
      table: "orders",
      data: {status: "shipped"},
      filters: [::f/eq("id", 42)]
    }), token)
    response.status
    response.body
    ```
    """
}
fn
(request: UpdateRequest, access-token: Str): ::api/HttpResponse {
  update-response-as(request, access-token, {})
},
(request: UpdateRequest, access-token: Str, opts: Map): ::api/HttpResponse {
  validate-filters(request.filters, "update")
  ::api/request-raw-as("PATCH", filtered-table-path(request.table, request.filters), mutation-headers(request.return, request.count, request.schema), request.data, access-token, opts)
}

update-response-service
meta {
    doc: """
    Like `update-service`, but returns the full `HttpResponse`. A non-2xx
    status is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db
    ::f ::supabase::filters

    response ::db/update-response-service(::db/UpdateRequest({
      table: "orders",
      data: {status: "shipped"},
      filters: [::f/eq("id", 42)]
    }))
    response.status
    response.body
    ```
    """
}
fn
(request: UpdateRequest): ::api/HttpResponse {
  update-response-service(request, {})
},
(request: UpdateRequest, opts: Map): ::api/HttpResponse {
  validate-filters(request.filters, "update")
  ::api/request-raw-service("PATCH", filtered-table-path(request.table, request.filters), mutation-headers(request.return, request.count, request.schema), request.data, opts)
}

validate-filters
meta {no-doc: true}
fn (filters: Vec<Str>, operation: Str): Bool {
  if(is-empty(filters), fail(`filters are required for ${operation} to prevent full-table ${operation}s`))
  true
}

filtered-table-path
meta {no-doc: true}
fn (table: Str, filters: Vec<Str>): Str {
  append-query(table-path(table), [filters-query(filters)])
}

mutation-headers
meta {no-doc: true}
fn (return-rows: Bool?, count: CountMode?, schema: Str?): Map {
  should-return if(is-null(return-rows), true, return-rows)
  prefer-parts [
    if(should-return, "return=representation", "return=minimal")
  ]
  prefer-parts if(is-some(count), concat(prefer-parts, [`count=${untype(count)}`]), prefer-parts)

  write-headers(schema)
    |> assoc("Prefer", join(prefer-parts, ", "))
}

delete-headers
meta {no-doc: true}
fn (return-rows: Bool?, count: CountMode?, schema: Str?): Map {
  should-return or(return-rows, false)
  prefer-parts [
    if(should-return, "return=representation", "return=minimal")
  ]
  prefer-parts if(is-some(count), concat(prefer-parts, [`count=${untype(count)}`]), prefer-parts)

  write-headers(schema)
    |> assoc("Prefer", join(prefer-parts, ", "))
}

