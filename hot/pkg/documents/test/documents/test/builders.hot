::documents::test::builders ns
meta ["test"]

// Pages and change sets built from fake provider responses (pure).

::fx ::documents::test::fixtures
::source ::documents::source
::cursor ::documents::cursor

test-google-list-params-and-page
meta ["test"] fn () {
    s ::source/resolve({provider: "google-drive", drive-id: "0AD", opts: {token: "t"}})
    p ::documents::google/list-params(s, "F1", null, 50, ::source/provider-opts(s, {}))
    assert-eq("'F1' in parents and trashed = false", p.q)
    assert-eq(50, p.pageSize)
    assert-eq("0AD", p.driveId)
    assert-eq("t", p.token, "credentials pass through to google-core")
    assert(not(in("pageToken", keys(p))), "no token on the first page: omitted, not null")
    page ::documents::google/to-page(s, "F1", {files: [::fx/DRIVE_FILE, ::fx/DRIVE_DOC], nextPageToken: "tok2"})
    assert-eq(2, length(page.documents))
    assert(page.has-more)
    c ::cursor/decode-for(page.cursor, "google-drive", "list")
    assert-eq("tok2", c.v)
    assert-eq("F1", c.f, "the folder rides along in the cursor")
    last ::documents::google/to-page(s, "F1", {files: []})
    assert(is-null(last.cursor))
    assert(not(last.has-more))
}

test-google-change-set
meta ["test"] fn () {
    s ::source/resolve("google-drive")
    set ::documents::google/to-change-set(s, {changes: ::fx/DRIVE_CHANGES, new-start-page-token: "99", pages: 1})
    assert-eq(["A v2"], map(set.documents, (d) { d.name }), "latest state per file; trashed and drive changes excluded")
    assert-eq(["b", "c"], sort(set.deleted-ids), "removed and trashed")
    assert-eq("99", ::cursor/decode-for(set.next-cursor, "google-drive", "changes").v)
    assert(not(set.reset-required))
}

test-onedrive-children-request-and-page
meta ["test"] fn () {
    s ::source/resolve({provider: "onedrive", drive: "b!xyz", opts: {token: "t"}})
    popts ::documents::onedrive/with-drive(s, {select: "id,name"})
    assert-eq("b!xyz", popts.drive)
    req ::documents::onedrive/children-request("/Shared Plans", 25, popts)
    assert-eq("/drives/b%21xyz/root:/Shared%20Plans:/children", req.path)
    assert-eq(25, req.opts.top)
    assert-eq("t", req.opts.token)
    assert(not(in("drive", keys(req.opts))), "drive never becomes a query parameter")
    override ::documents::onedrive/with-drive(s, {drive: "me"})
    assert-eq("me", override.drive, "a call's own drive wins")
    page ::documents::onedrive/to-page(s, "root", {items: [::fx/ONEDRIVE_FILE], next-link: "https://graph.microsoft.com/v1.0/drives/b!xyz/items/root/children?$skiptoken=X", delta-link: null})
    assert-eq(1, length(page.documents))
    assert-eq("https://graph.microsoft.com/v1.0/drives/b!xyz/items/root/children?$skiptoken=X", ::cursor/decode(page.cursor).v)
}

test-onedrive-change-set-and-resync
meta ["test"] fn () {
    s ::source/resolve("onedrive")
    delta ::microsoft::onedrive::delta/build-delta-set(::fx/ONEDRIVE_DELTA.items, ::fx/ONEDRIVE_DELTA.delta-link, 1, null)
    set ::documents::onedrive/to-change-set(s, delta)
    assert-eq(["a v2.txt"], map(set.documents, (d) { d.name }), "latest state per id; deleted items dropped")
    assert-eq(["2"], set.deleted-ids)
    assert(not(set.reset-required))
    resync ::documents::onedrive/to-change-set(s, ::microsoft::onedrive::delta/build-delta-set(::fx/ONEDRIVE_DELTA.items, ::fx/ONEDRIVE_DELTA.delta-link, 2, "resyncChangesApplyDifferences"))
    assert(resync.reset-required, "a 410 resync means: replace the mirror")
}

test-dropbox-page-and-changes
meta ["test"] fn () {
    s ::source/resolve({provider: "dropbox", root: "/Reports"})
    assert-eq("/Reports", ::documents::dropbox/root-of(s))
    assert-eq("/Reports/q3.csv", ::documents::dropbox/child-path(s, null, "q3.csv"))
    assert-eq("/Other/q3.csv", ::documents::dropbox/child-path(s, "Other/", "q3.csv"))
    assert-eq("/q3.csv", ::documents::dropbox/child-path(::source/resolve("dropbox"), null, "q3.csv"))
    more ::documents::dropbox/to-page(s, "/Reports", {entries: [::fx/DROPBOX_FILE, ::fx/DROPBOX_FOLDER], cursor: "AAF", has_more: true})
    assert-eq("AAF", ::cursor/decode(more.cursor).v)
    done ::documents::dropbox/to-page(s, "/Reports", {entries: [], cursor: "AAG", has_more: false})
    assert(is-null(done.cursor), "Dropbox always sends a cursor; it only becomes a page cursor with has_more")
    set ::documents::dropbox/to-change-set(s, {entries: [::fx/DROPBOX_FILE, ::fx/DROPBOX_DELETED], cursor: "AAH", pages: 1, reset: false})
    assert-eq(["Q3 Plan.pdf"], map(set.documents, (d) { d.name }))
    assert-eq(["/old.txt"], set.deleted-ids, "deletions are lower-cased paths")
    assert-eq(set.deleted-ids, set.deleted-paths)
    reset ::documents::dropbox/to-change-set(s, {entries: [::fx/DROPBOX_FILE], cursor: "AAI", pages: 1, reset: true})
    assert(reset.reset-required)
}

EVENTS [
    {event_id: "e1", event_type: "ITEM_UPLOAD", source: {type: "file", id: "1", name: "a.pdf", parent: {type: "folder", id: "111"}}},
    {event_id: "e2", event_type: "ITEM_PREVIEW", source: {type: "file", id: "2", name: "b.pdf", parent: {type: "folder", id: "111"}}},
    {event_id: "e3", event_type: "ITEM_TRASH", source: {type: "file", id: "3", name: "c.pdf"}},
    {event_id: "e4", event_type: "ITEM_MOVE", source: {type: "file", id: "4", name: "d.pdf", parent: {type: "folder", id: "999"}, path_collection: {entries: [{id: "0"}, {id: "999"}]}}},
    {event_id: "e5", event_type: "ITEM_RENAME", source: {type: "file", id: "1", name: "a2.pdf", parent: {type: "folder", id: "112"}, path_collection: {entries: [{id: "0"}, {id: "111"}, {id: "112"}]}}},
    {event_id: "e6", event_type: "COMMENT_CREATE", source: {type: "comment", id: "c1"}},
    {event_id: "e7", event_type: "ITEM_UNDELETE_VIA_TRASH", source: {type: "file", id: "3", name: "c.pdf", parent: {type: "folder", id: "111"}}}
]

test-box-events
meta ["test"] fn () {
    whole ::documents::box/event-changes(EVENTS, "0")
    assert-eq(["1", "3", "4"], sort(keys(whole.upserts)), "content events only; latest per id")
    assert-eq("a2.pdf", get(whole.upserts, "1").name)
    assert-eq({}, whole.deleted, "a restore after a trash is not a deletion")
    scoped ::documents::box/event-changes(EVENTS, "111")
    assert-eq(["1", "3"], sort(keys(scoped.upserts)), "nested under 111 by path_collection")
    assert-eq(["4"], keys(scoped.deleted), "moved outside the folder: report it as gone")
    trash ::documents::box/event-changes(slice(EVENTS, 0, 3), "111")
    assert-eq(["3"], keys(trash.deleted))
    s ::source/resolve({provider: "box", folder-id: "111"})
    set ::documents::box/to-change-set(s, {events: EVENTS, next-stream-position: 123456, pages: 1, complete: false})
    assert-eq(2, length(set.documents))
    assert-eq(["4"], set.deleted-ids)
    assert(set.has-more, "max-pages stopped the read")
    assert-eq(123456, ::cursor/decode(set.next-cursor).v)
    box-page ::documents::box/to-page(s, "111", {entries: [::fx/BOX_FILE], next_marker: "m2", limit: 100})
    assert-eq("m2", ::cursor/decode(box-page.cursor).v)
    assert(is-null(::documents::box/to-page(s, "111", {entries: [], next_marker: null}).cursor))
}

test-box-extracted-text-states
meta ["test"] fn () {
    doc ::documents::adapters/from-box(::source/resolve("box"), ::box/to-doc-file(::fx/BOX_DOCX))
    ok ::documents::box/text-from-extraction(doc, {state: "success", text: "hello", ready: true})
    assert-eq("ok", ok.status)
    assert-eq("hello", ok.text)
    assert-eq("extracted-text", ok.method)
    pending ::documents::box/text-from-extraction(doc, {state: "pending", text: null, ready: false})
    assert-eq("pending", pending.status, "never waits: says pending")
    assert-eq("pending", ::documents::box/text-from-extraction(doc, {state: "none", text: null, ready: false}).status)
    none ::documents::box/text-from-extraction(doc, {state: "unavailable", text: null, ready: false})
    assert-eq("unsupported", none.status)
    assert(contains(none.reason, "hot.dev/tesseract"))
}

test-box-not-found-detection
meta ["test"] fn () {
    assert(::documents::box/is-not-found(err({status: 404, message: "box: HTTP 404 not_found"})))
    assert(not(::documents::box/is-not-found(err({status: 403}))))
    assert(not(::documents::box/is-not-found(err("connection refused"))))
    assert(not(::documents::box/is-not-found({id: "1"})))
}
