::hot::cmp ns
meta {doc: """Comparison functions for equality and ordering."""}

eq
meta {
    core: true,
    doc: """
    Return true if all the values are equal. One value is equal to itself.

    **Example**

    ```hot
    eq(1, 1)           // true
    eq(1, 2)           // false
    eq("hi", "hi") // true
    eq([1, 2], [1, 2]) // true
    eq(1, 1, 1)        // true
    eq(1, 1, 2)        // false
    ```
    """
}
fn
(a: Any) { true },
(a: Any, b: Any) {
    call-lib(::hot::cmp/eq, [a, b])
},
(a: Any, b: Any, c: Any, ...rest: Any) {
    call-lib(::hot::cmp/eq, [a, b, c, ...rest])
}

ne
meta {
    core: true,
    doc: """
    Return true if the values aren't all equal, the opposite of `eq`. That
    isn't "all different": `ne(1, 2, 1)` is true though two of them match.

    **Example**

    ```hot
    ne(1, 2)           // true
    ne(1, 1)           // false
    ne("a", "b")   // true
    ne(1, 1, 2)        // true
    ne(1, 1, 1)        // false
    ```
    """
}
fn
(a: Any) { false },
(a: Any, b: Any) {
    not(eq(a, b))
},
(a: Any, b: Any, c: Any, ...rest: Any) {
    call-lib(::hot::cmp/ne, [a, b, c, ...rest])
}

gt
meta {
    core: true,
    doc: """
    Return true if each number is greater than the next, so `gt(...xs)` checks
    a whole Vec. One number has nothing to compare with, so it is true.

    **Example**

    ```hot
    gt(5, 3)     // true
    gt(3, 5)     // false
    gt(3, 3)     // false
    gt(2.5, 2)   // true
    gt(3, 2, 1)   // true
    gt(3, 3, 1)   // false
    ```
    """
}
fn
(a: Int | Dec) { true },
(a: Int | Dec, b: Int | Dec) {
    call-lib(::hot::cmp/gt, [a, b])
},
(a: Int | Dec, b: Int | Dec, c: Int | Dec, ...rest: Int | Dec) {
    call-lib(::hot::cmp/gt, [a, b, c, ...rest])
}


gte
meta {
    core: true,
    doc: """
    Return true if each number is greater than or equal to the next, so `gte(...xs)` checks
    a whole Vec. One number has nothing to compare with, so it is true.

    **Example**

    ```hot
    gte(5, 3)   // true
    gte(3, 3)   // true
    gte(2, 5)   // false
    gte(3, 3, 1)   // true
    gte(3, 1, 2)   // false
    ```
    """
}
fn
(a: Int | Dec) { true },
(a: Int | Dec, b: Int | Dec) {
    call-lib(::hot::cmp/gte, [a, b])
},
(a: Int | Dec, b: Int | Dec, c: Int | Dec, ...rest: Int | Dec) {
    call-lib(::hot::cmp/gte, [a, b, c, ...rest])
}


lt
meta {
    core: true,
    doc: """
    Return true if each number is less than the next, so `lt(...xs)` checks
    a whole Vec. One number has nothing to compare with, so it is true.

    **Example**

    ```hot
    lt(3, 5)   // true
    lt(5, 3)   // false
    lt(3, 3)   // false
    lt(1, 2, 3)   // true
    lt(1, 3, 2)   // false
    ```
    """
}
fn
(a: Int | Dec) { true },
(a: Int | Dec, b: Int | Dec) {
    call-lib(::hot::cmp/lt, [a, b])
},
(a: Int | Dec, b: Int | Dec, c: Int | Dec, ...rest: Int | Dec) {
    call-lib(::hot::cmp/lt, [a, b, c, ...rest])
}


lte
meta {
    core: true,
    doc: """
    Return true if each number is less than or equal to the next, so `lte(...xs)` checks
    a whole Vec. One number has nothing to compare with, so it is true.

    **Example**

    ```hot
    lte(3, 5)   // true
    lte(3, 3)   // true
    lte(5, 3)   // false
    lte(1, 1, 2)   // true
    lte(2, 1, 3)   // false
    ```
    """
}
fn
(a: Int | Dec) { true },
(a: Int | Dec, b: Int | Dec) {
    call-lib(::hot::cmp/lte, [a, b])
},
(a: Int | Dec, b: Int | Dec, c: Int | Dec, ...rest: Int | Dec) {
    call-lib(::hot::cmp/lte, [a, b, c, ...rest])
}


between
meta {
    core: true,
    doc: """
    Return true if `x` is between `low` and `high` (inclusive).

    **Example**

    ```hot
    between(5, 1, 10)    // true
    between(1, 1, 10)    // true (inclusive)
    between(10, 1, 10)   // true (inclusive)
    between(0, 1, 10)    // false
    between(3.14, 3.0, 4.0)  // true
    ```
    """
}
fn (x: Int | Dec, low: Int | Dec, high: Int | Dec): Bool {
    and(gte(x, low), lte(x, high))
}


in
meta {
    core: true,
    doc: """
    Return true if `value` is an element of `coll`.

    **Example**

    ```hot
    in(2, [1, 2, 3])       // true
    in(4, [1, 2, 3])       // false
    in("a", ["a", "b"])    // true
    in(1, [])              // false
    ```
    """
}
fn (value: Any, coll: Vec): Bool {
    some(coll, eq(%, value))
}
