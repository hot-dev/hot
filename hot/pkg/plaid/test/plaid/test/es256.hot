::plaid::test::es256 ns
meta ["test"]

// Real ES256 signature checks through ::jwt/verify-es256 (needs Hot 3.0.2+
// for the ::hot::crypto/ecdsa-p256-sha256-verify builtin). The vector was
// generated independently with OpenSSL: a P-256 key, the JWT header
// {"alg":"ES256","kid":KID,"typ":"JWT"} and claims {iat, request_body_sha256}
// over the body below.

::webhooks ::plaid::webhooks

KID "6c5516e1-92dc-479e-a8ff-5a51992e0001"
IAT 1793000000

TOKEN "eyJhbGciOiJFUzI1NiIsImtpZCI6IjZjNTUxNmUxLTkyZGMtNDc5ZS1hOGZmLTVhNTE5OTJlMDAwMSIsInR5cCI6IkpXVCJ9.eyJpYXQiOjE3OTMwMDAwMDAsInJlcXVlc3RfYm9keV9zaGEyNTYiOiIzODhmZWRiZGIwZjI5NTI3YzFlYjcwOTU1NjhmY2NkNTgwYjI2ZWQzNjkzNmZjNDkwMTc1MjJlOGZlZWM3NmJlIn0.dieklUH31lRr6rxX4ea_QLeUx2ZPxWUs1wERdNW6uDCBCQYIsqy9PNGIKCY0foLtk9MHagm3M53pUs8pxlfRZw"

JWK {
    kid: KID,
    alg: "ES256",
    crv: "P-256",
    kty: "EC",
    use: "sig",
    x: "d5MKhoIayQXVaq-QjIauGqFeNu6UtwQ3aK6CmKhzsus",
    y: "UyrTGfxgMqXwzWJPzPNz9k76y5iBi6V_-J1o8h_1e9I",
    created_at: 1792000000,
    expired_at: null
}

// The public key of a different P-256 key pair.
OTHER_JWK {...JWK, x: "37cfmxDtgcrDMZxKetVkosWMBqISZCBX4fdE7OD0I30", y: "7lYfhteZhAFWALi32oM8eyjc9o1Uv0WuKhHBV5agIKw"}

BODY join([
    "{",
    "  \"environment\": \"sandbox\",",
    "  \"item_id\": \"Ed6bjNrDLJfGvZWwnkQlfxwoNz54B5C97ejBr\",",
    "  \"new_transactions\": 3,",
    "  \"webhook_code\": \"SYNC_UPDATES_AVAILABLE\",",
    "  \"webhook_type\": \"TRANSACTIONS\"",
    "}"
], "\n")

request-with fn (token: Str, body: Str): Map {
    {headers: {plaid-verification: token}, body-raw: body}
}

test-es256-valid
meta ["test"] fn () {
    request request-with(TOKEN, BODY)
    assert(::webhooks/verify-webhook(request, JWK, {now: add(IAT, 60)}), "fresh, correctly signed webhook verifies")
    claims ::webhooks/check-webhook(request, JWK, {now: add(IAT, 60)})
    assert-eq(IAT, claims.iat)
}

test-es256-tampered
meta ["test"] fn () {
    tampered request-with(TOKEN, replace(BODY, "\"new_transactions\": 3", "\"new_transactions\": 300"))
    assert(not(::webhooks/verify-webhook(tampered, JWK, {now: add(IAT, 60)})), "tampered body fails")
}

test-es256-stale
meta ["test"] fn () {
    request request-with(TOKEN, BODY)
    assert(::webhooks/verify-webhook(request, JWK, {now: add(IAT, 300)}), "exactly five minutes old still verifies")
    assert(not(::webhooks/verify-webhook(request, JWK, {now: add(IAT, 301)})), "older than five minutes fails")
    assert(::webhooks/verify-webhook(request, JWK, {now: add(IAT, 330), leeway: 60}), "explicit leeway widens the window")
}

test-es256-wrong-key-or-forged
meta ["test"] fn () {
    request request-with(TOKEN, BODY)
    assert(not(::webhooks/verify-webhook(request, OTHER_JWK, {now: add(IAT, 60)})), "another key's signature fails")

    parts split(TOKEN, ".")
    forged-claims ::hot::base64/encode-url(to-json({iat: add(IAT, 1000), request_body_sha256: ::hot::hash/sha256("{}")}))
    forged `${parts[0]}.${forged-claims}.${parts[2]}`
    assert(not(::webhooks/verify-webhook(request-with(forged, "{}"), JWK, {now: add(IAT, 1000)})), "swapped claims fail the signature")
}

test-es256-missing-header
meta ["test"] fn () {
    assert(not(::webhooks/verify-webhook({headers: {}, body-raw: BODY}, JWK, {now: add(IAT, 60)})), "missing header fails")
}
