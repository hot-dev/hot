ListArchivedThreadsRequest type {
  channel_id: Str,
  before: Str?,
  limit: Int?
}

list-public-archived-threads
meta {
    doc: """
    GET /channels/{channel_id}/threads/archived/public - Archived public
    threads, newest first. `before` is an ISO8601 timestamp. Returns
    `{threads, members, has_more}`. Needs READ_MESSAGE_HISTORY.

    **Example**

    ```hot
    ::channels ::discord::channels

    archived ::channels/list-public-archived-threads(::channels/ListArchivedThreadsRequest({
      channel_id: "1100000000000000000",
      before: "2026-11-01T00:00:00Z",
      limit: 50
    }))
    archived.has_more
    ```
    """
}
fn
(request: ListArchivedThreadsRequest): Map {
  list-public-archived-threads(request, {})
},
(request: ListArchivedThreadsRequest, opts: Map): Map {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/threads/archived/public`, {
    query: {before: request.before, limit: request.limit}
  }, opts)
}

list-private-archived-threads
meta {
    doc: """
    GET /channels/{channel_id}/threads/archived/private - Archived private
    threads. `before` is an ISO8601 timestamp. Returns `{threads, members,
    has_more}`. Needs READ_MESSAGE_HISTORY and MANAGE_THREADS.

    **Example**

    ```hot
    ::channels ::discord::channels

    archived ::channels/list-private-archived-threads(::channels/ListArchivedThreadsRequest({
      channel_id: "1100000000000000000",
      limit: 50
    }))
    map(archived.threads, %.name)
    ```
    """
}
fn
(request: ListArchivedThreadsRequest): Map {
  list-private-archived-threads(request, {})
},
(request: ListArchivedThreadsRequest, opts: Map): Map {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/threads/archived/private`, {
    query: {before: request.before, limit: request.limit}
  }, opts)
}
