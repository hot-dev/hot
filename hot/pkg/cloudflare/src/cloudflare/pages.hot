::cloudflare::pages ns
meta {
    doc: """
    Cloudflare Pages: list projects and deployments, trigger a build of a
    Git-connected project, retry, and roll back. Direct Upload deploys
    (sending built files) are out of scope — use `wrangler pages deploy`.
    """,
    ctx: {"cloudflare.token": {required: false}, "cloudflare.account.id": {required: false, secret: false}}
}

::api ::cloudflare::api

ListPage ::cloudflare::api/ListPage

project-suffix
meta {no-doc: true}
fn (project: Str): Str {
  `/pages/projects/${::api/seg(project)}`
}

deployment-suffix
meta {no-doc: true}
fn (project: Str, deployment-id: Str): Str {
  `${project-suffix(project)}/deployments/${::api/seg(deployment-id)}`
}

list-projects
meta {
    doc: """
    GET /accounts/{account_id}/pages/projects - One page of projects
    (`page`, `per_page`). Returns a `ListPage`.

    **Example**

    ```hot
    page ::cloudflare::pages/list-projects({per_page: 25})
    map(page.result, %.name)
    ```
    """
}
fn
(): ListPage {
  list-projects({})
},
(params: Map): ListPage {
  list-projects(params, {})
},
(params: Map, opts: Map): ListPage {
  ::api/account-page(`/pages/projects${::api/query(params)}`, "", opts)
}

list-all-projects
meta {
    doc: """
    Every Pages project, following pages up to `max` (default 10000).

    **Example**

    ```hot
    map(::cloudflare::pages/list-all-projects(), %.name)
    ```
    """
}
fn
(): Vec {
  list-all-projects(::api/DEFAULT_MAX_ITEMS)
},
(max: Int): Vec {
  list-all-projects(max, {})
},
(opts: Map): Vec {
  list-all-projects(::api/DEFAULT_MAX_ITEMS, opts)
},
(max: Int, opts: Map): Vec {
  ::api/collect-pages((p) { list-projects(p, opts) }, {}, max)
}

get-project
meta {
    doc: """
    GET .../pages/projects/{name} - A project: subdomain, domains, source,
    build config, latest deployment.

    **Example**

    ```hot
    project ::cloudflare::pages/get-project("marketing-site")
    project.subdomain
    ```
    """
}
fn
(project: Str): Map {
  get-project(project, {})
},
(project: Str, opts: Map): Map {
  ::api/account-json("GET", project-suffix(project), "", opts)
}

list-deployments
meta {
    doc: """
    GET .../pages/projects/{name}/deployments - One page of a project's
    deployments, newest first. `params`: `env` (`production` or
    `preview`), `page`, `per_page`. Returns a `ListPage`.

    **Example**

    ```hot
    page ::cloudflare::pages/list-deployments("marketing-site", {env: "production", per_page: 5})
    map(page.result, %.url)
    ```
    """
}
fn
(project: Str): ListPage {
  list-deployments(project, {})
},
(project: Str, params: Map): ListPage {
  list-deployments(project, params, {})
},
(project: Str, params: Map, opts: Map): ListPage {
  ::api/account-page(`${project-suffix(project)}/deployments${::api/query(params)}`, "", opts)
}

get-deployment
meta {
    doc: """
    GET .../deployments/{id} - One deployment: `url`, `environment`,
    `latest_stage` (`{name, status}`), `deployment_trigger`.

    **Example**

    ```hot
    deployment ::cloudflare::pages/get-deployment("marketing-site", "f64788e9-fccd-4d4a-a28a-cb84f88f6fa2")
    deployment.latest_stage.status
    ```
    """
}
fn
(project: Str, deployment-id: Str): Map {
  get-deployment(project, deployment-id, {})
},
(project: Str, deployment-id: Str, opts: Map): Map {
  ::api/account-json("GET", deployment-suffix(project, deployment-id), "", opts)
}

deployment-parts
meta {
    doc: """
    The multipart fields for a Git build trigger: `branch` and the optional
    commit fields, omitted when unset. Exposed for testing.

    **Example**

    ```hot
    ::cloudflare::pages/deployment-parts({branch: "main"})  // [{name: "branch", value: "main"}]
    ::cloudflare::pages/deployment-parts({})  // []
    ```
    """
}
fn
(options: Map): Vec {
  fields ["branch", "commit_hash", "commit_message", "commit_dirty"]
  filter(fields, (f) { is-some(get(options, f)) })
    |> map((f) { {name: f, value: Str(get(options, f))} })
}

create-deployment
meta {
    doc: """
    POST .../pages/projects/{name}/deployments - Start a new build of a
    Git-connected project: the production branch by default, or
    `options.branch` (a preview branch). Returns the new deployment.

    **Example**

    ```hot
    deployment ::cloudflare::pages/create-deployment("marketing-site", {branch: "main"})
    deployment.id
    ```
    """
}
fn
(project: Str): Map {
  create-deployment(project, {})
},
(project: Str, options: Map): Map {
  create-deployment(project, options, {})
},
(project: Str, options: Map, opts: Map): Map {
  path ::api/account-path(`${project-suffix(project)}/deployments`, opts)
  cond {
    is-err(path) => { path }
    => { ::api/send-multipart("POST", path, deployment-parts(options), opts) }
  }
}

retry-deployment
meta {
    doc: """
    POST .../deployments/{id}/retry - Re-run a deployment's build.

    **Example**

    ```hot
    ::cloudflare::pages/retry-deployment("marketing-site", "f64788e9-fccd-4d4a-a28a-cb84f88f6fa2")
    ```
    """
}
fn
(project: Str, deployment-id: Str): Map {
  retry-deployment(project, deployment-id, {})
},
(project: Str, deployment-id: Str, opts: Map): Map {
  ::api/account-json("POST", `${deployment-suffix(project, deployment-id)}/retry`, {}, opts)
}

rollback-deployment
meta {
    doc: """
    POST .../deployments/{id}/rollback - Make an earlier successful
    production deployment live again.

    **Example**

    ```hot
    ::cloudflare::pages/rollback-deployment("marketing-site", "f64788e9-fccd-4d4a-a28a-cb84f88f6fa2")
    ```
    """
}
fn
(project: Str, deployment-id: Str): Map {
  rollback-deployment(project, deployment-id, {})
},
(project: Str, deployment-id: Str, opts: Map): Map {
  ::api/account-json("POST", `${deployment-suffix(project, deployment-id)}/rollback`, {}, opts)
}
