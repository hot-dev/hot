::persona::accounts ns
meta {
    doc: """
    Accounts: the long-lived record of one end user (or business) that
    inquiries, verifications and reports attach to. Look an account up by
    your own `reference-id`, read its consolidated `fields`, and merge
    duplicates.
    """
}

::api ::persona::api

seg ::persona::api/seg

create-account
meta {
    doc: """
    POST /accounts - Create an account. `attributes` (all optional):
    `reference-id` (your user id; a duplicate returns 409),
    `account-type-id` (`acttp_...`), `account-status`, `tags`, `fields`
    (template field keys and plain values; PII). `opts.meta` passes
    request meta, e.g. `{upsert-by: "reference-id"}`.

    **Example**

    ```hot
    ::persona::accounts/create-account({reference-id: "user-42", tags: ["beta"]})
    ```
    """
}
fn
(attributes: Map): Map {
  create-account(attributes, {}, {})
},
(attributes: Map, opts: Map): Map {
  create-account(attributes, opts, opts)
},
(attributes: Map, opts: Map, options: Map): Map {
  ::api/send("POST", "/accounts", {}, ::api/document(null, attributes, or(get(opts, "meta"), {})), options)
}

get-account
meta {
    doc: """
    GET /accounts/{id} - Retrieve an account. `opts` takes `include` and
    `fields` as in `::persona::inquiries/get-inquiry`.

    **Example**

    ```hot
    account ::persona::accounts/get-account("act_123")
    ::persona::api/attr(account, "reference-id")

    // Only the attributes you need
    ::persona::accounts/get-account("act_123", {fields: {account: ["reference-id", "tags"]}})
    ```
    """
}
fn
(account-id: Str): Map {
  get-account(account-id, {}, {})
},
(account-id: Str, opts: Map): Map {
  get-account(account-id, opts, opts)
},
(account-id: Str, opts: Map, options: Map): Map {
  ::api/send("GET", `/accounts/${seg(account-id)}`, ::api/read-query(opts), null, options)
}

list-accounts
meta {
    doc: """
    GET /accounts - One page of accounts. The only filter is `reference-id`;
    `opts` takes `page-size`, `after`, `before`.

    **Example**

    ```hot
    page ::persona::accounts/list-accounts({reference-id: "user-42"}, {page-size: 10})
    map(page.data, %.id)
    ```
    """
}
fn
(filters: Map): Map {
  list-accounts(filters, {}, {})
},
(filters: Map, opts: Map): Map {
  list-accounts(filters, opts, opts)
},
(filters: Map, opts: Map, options: Map): Map {
  ::api/list-page("/accounts", filters, opts, options)
}

find-by-reference-id
meta {
    doc: """
    The account (a resource, not a document) with this `reference-id`, or
    null when there is none.

    **Example**

    ```hot
    account ::persona::accounts/find-by-reference-id("user-42")
    if(is-null(account), "no account yet", account.id)
    ```
    """
}
fn
(reference-id: Str): Map? {
  find-by-reference-id(reference-id, {})
},
(reference-id: Str, options: Map): Map? {
  page list-accounts({reference-id: reference-id}, {page-size: 1}, options)
  cond {
    is-err(page) => { page }
    => {
      data or(get(page, "data"), [])
      if(is-empty(data), null, first(data))
    }
  }
}

update-account
meta {
    doc: """
    PATCH /accounts/{id} - Update `reference-id`, `account-status`, `tags`
    or `fields`.

    **Example**

    ```hot
    ::persona::accounts/update-account("act_123", {tags: ["vip"], fields: {name-first: "Jane"}})
    ```
    """
}
fn
(account-id: Str, attributes: Map): Map {
  update-account(account-id, attributes, {})
},
(account-id: Str, attributes: Map, options: Map): Map {
  ::api/send("PATCH", `/accounts/${seg(account-id)}`, {}, ::api/document(null, attributes, {}), options)
}

consolidate-accounts
meta {
    doc: """
    POST /accounts/{id}/consolidate - Merge `source-account-ids` into the
    account `account-id`. Their inquiries, verifications and reports move
    to the target (attributes don't), and each source is archived. A
    source can be consolidated only once.

    **Example**

    ```hot
    ::persona::accounts/consolidate-accounts("act_123", ["act_456", "act_789"])
    ```
    """
}
fn
(account-id: Str, source-account-ids: Vec<Str>): Map {
  consolidate-accounts(account-id, source-account-ids, {})
},
(account-id: Str, source-account-ids: Vec<Str>, options: Map): Map {
  ::api/send("POST", `/accounts/${seg(account-id)}/consolidate`, {}, ::api/meta-document({source-account-ids: source-account-ids}), options)
}

redact-account
meta {
    doc: """
    DELETE /accounts/{id} - Permanently remove the account's PII. Cannot be
    undone.

    **Example**

    ```hot
    ::persona::accounts/redact-account("act_123")
    ```
    """
}
fn
(account-id: Str): Map {
  redact-account(account-id, {})
},
(account-id: Str, options: Map): Map {
  ::api/send("DELETE", `/accounts/${seg(account-id)}`, {}, null, options)
}

add-tag
meta {
    doc: """
    POST /accounts/{id}/add-tag - Add a tag by name.

    **Example**

    ```hot
    ::persona::accounts/add-tag("act_123", "vip")
    ```
    """
}
fn
(account-id: Str, tag-name: Str): Map {
  add-tag(account-id, tag-name, {})
},
(account-id: Str, tag-name: Str, options: Map): Map {
  ::api/send("POST", `/accounts/${seg(account-id)}/add-tag`, {}, ::api/meta-document({tag-name: tag-name}), options)
}
