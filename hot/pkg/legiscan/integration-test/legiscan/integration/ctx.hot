::legiscan::integration::ctx ns

::env ::hot::env

// Placeholder settings for the legiscan integration suite. Unset environment
// variables are skipped entirely, so absent credentials behave exactly as if
// never configured.
::hot::ctx/set(filter-vals({
    "legiscan.api-key": ::env/get("LEGISCAN_API_KEY", ""),
    "legiscan.base-url": ::env/get("LEGISCAN_BASE_URL", ""),
}, (v) { not(is-empty(v)) }))

configured
meta {doc: """True when LEGISCAN_API_KEY is set."""}
fn (): Bool {
    is-some(::hot::ctx/get("legiscan.api-key"))
}

skip
meta {doc: """Record a skip and pass."""}
fn (why: Str): Bool {
    println(`legiscan integration: ${why} - skipping`)
    assert(true, `skipped: ${why}`)
}
