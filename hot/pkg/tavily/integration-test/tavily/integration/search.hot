::tavily::integration ns
meta ["test"]

// Requires TAVILY_API_KEY; skips without it. Read-only: one small search.
// Run with: hot test --project pkg-integration-tavily

::ctx ::tavily::integration::ctx

test-search
meta ["test"] fn () {
    cond {
        not(::ctx/configured()) => { ::ctx/skip(::ctx/UNCONFIGURED) }
        => {
            out ::tavily/search("hot.dev programming language", {max_results: 3})
            assert(not(is-err(out)), `search: ${if-err(out, (e) { err-message(e) })}`)
            assert(gt(length(out.results), 0), "should return results")
            assert(lte(length(out.results), 3), "respects max_results")
            assert(starts-with(first(out.results).url, "http"), "returns URLs")
        }
    }
}
