    ::usergroups/remove-channels(::usergroups/RemoveChannelsRequest({usergroup_id: "S0123ABCDEF", channel_ids: ["C0123ABCDEF"]}))
    ```
    """
}
fn
(request: RemoveChannelsRequest): Map {
  remove-channels(request, {})
},
(request: RemoveChannelsRequest, opts: Map): Map {
  ::api/call("admin.usergroups.removeChannels", request, opts)
}
