::supabase::admin::branches ns

::api ::supabase::admin::api

Branch type {
  id: Str,
  name: Str?,
  branch_name: Str?,
  git_branch: Str?,
  status: Str?,
  persistent: Bool?,
  reset_on_push: Bool?
}

branch-path
meta {no-doc: true}
fn (branch-id: Str): Str {
  `/branches/${branch-id}`
}

// ============================================================================
// Preview Branches
// ============================================================================

list-branches
meta {
    doc: """
List all preview branches for a project.

**Example**

```hot
::branches ::supabase::admin::branches

branches ::branches/list-branches("my-project-ref")
// => [{id: "...", name: "feat-auth", git_branch: "feat/auth", status: "RUNNING_MIGRATIONS", ...}, ...]
```
"""
}
fn
(project-ref: Str): Vec<Branch> {
  list-branches(project-ref, {})
},
(project-ref: Str, opts: Map): Vec<Branch> {
  ::api/request("GET", `/projects/${project-ref}/branches`, {}, {}, opts)
}

CreateBranchRequest type {
  project_ref: Str,
  branch_name: Str,
  git_branch: Str?,
  region: Str?
}

create-branch
meta {
    doc: """
Create a new preview branch. Preview branching must be enabled on the project.

**Example**

```hot
::branches ::supabase::admin::branches

branch ::branches/create-branch(::branches/CreateBranchRequest({
  project_ref: "my-project-ref",
  branch_name: "feat-auth",
  git_branch: "feat/auth"
}))
```
"""
}
fn
(request: CreateBranchRequest): Branch {
  create-branch(request, {})
},
(request: CreateBranchRequest, opts: Map): Branch {
  body {branch_name: request.branch_name}
    |> assoc-some("git_branch", request.git_branch)
    |> assoc-some("region", request.region)

  ::api/request("POST", `/projects/${request.project_ref}/branches`, {}, body, opts)
}

get-branch
meta {
    doc: """
    Get details for a specific branch by its ID.

    **Example**

    ```hot
    ::branches ::supabase::admin::branches

    branch ::branches/get-branch("branch-id-123")
    branch.status

    // Per-call credentials
    other ::branches/get-branch("branch-id-123", {access-token: ::hot::ctx/get("tenant_b.supabase.token")})
    ```
    """
}
fn
(branch-id: Str): Branch {
  get-branch(branch-id, {})
},
(branch-id: Str, opts: Map): Branch {
  ::api/request("GET", branch-path(branch-id), {}, {}, opts)
}

delete-branch
meta {
    doc: """
    Delete a preview branch.

    **Example**

    ```hot
    ::branches ::supabase::admin::branches

    ::branches/delete-branch("branch-id-123")
    ```
    """
}
fn
(branch-id: Str): Map {
  delete-branch(branch-id, {})
},
(branch-id: Str, opts: Map): Map {
  ::api/request("DELETE", `/branches/${branch-id}`, {}, {}, opts)
}

get-branch-config
meta {
    doc: """
    Get the database configuration for a branch.

    **Example**

    ```hot
    ::branches ::supabase::admin::branches

    config ::branches/get-branch-config("branch-id-123")
    config.db_host
    ```
    """
}
fn
(branch-id: Str): Map {
  get-branch-config(branch-id, {})
},
(branch-id: Str, opts: Map): Map {
  ::api/request("GET", branch-path(branch-id), {}, {}, opts)
}

UpdateBranchConfigRequest type {
  branch_id: Str,
  git_branch: Str?,
  reset_on_push: Bool?,
  persistent: Bool?,
  status: Str?
}

update-branch-config
meta {
    doc: """
    Update branch configuration (git branch association, reset behavior,
    persistence).

    **Example**

    ```hot
    ::branches ::supabase::admin::branches

    ::branches/update-branch-config(::branches/UpdateBranchConfigRequest({
      branch_id: "branch-id-123",
      git_branch: "feat/auth",
      persistent: true
    }))
    ```
    """
}
fn
(request: UpdateBranchConfigRequest): Map {
  update-branch-config(request, {})
},
(request: UpdateBranchConfigRequest, opts: Map): Map {
  body {}
    |> assoc-some("git_branch", request.git_branch)
    |> assoc-some("reset_on_push", request.reset_on_push)
    |> assoc-some("persistent", request.persistent)
    |> assoc-some("status", request.status)

  ::api/request("PATCH", branch-path(request.branch_id), {}, body, opts)
}

push-branch
meta {
    doc: """
    Push migrations to a preview branch database.

    **Example**

    ```hot
    ::branches ::supabase::admin::branches

    ::branches/push-branch("branch-id-123")
