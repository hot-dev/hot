::sec::iapd::integration::ctx ns

::env ::hot::env

// IAPD needs no key but only runs with SEC_IAPD_LIVE=1, so CI without network
// stays hermetic.

live
meta {doc: """True when SEC_IAPD_LIVE=1."""}
fn (): Bool {
    eq(::env/get("SEC_IAPD_LIVE", ""), "1")
}

skip
meta {doc: """Record a skip and pass."""}
fn (why: Str): Bool {
    println(`sec-iapd integration: ${why} - skipping`)
    assert(true, `skipped: ${why}`)
}
