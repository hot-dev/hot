::github::search ns

::api ::github::api
query-string ::hot::uri/query-string

search-path fn (resource: Str, query: Str, params: Map): Str {
  `/search/${resource}${query-string({q: query, ...params})}`
}

search-repos
meta {
    doc: """GET /search/repositories - Search repositories with GitHub's query syntax, e.g. `"language:rust stars:>1000 topic:runtime"`. `params` supports `sort`, `order`, `per_page`, and `page`."""
}
fn
(query: Str): Map {
  search-repos(query, {})
},
(query: Str, params: Map): Map {
  ::api/json("GET", search-path("repositories", query, params))
}

search-issues
meta {
    doc: """
    GET /search/issues - Search issues and PRs, e.g.
    `"repo:hot-dev/hot is:issue is:open label:bug"`. `params` supports
    `sort`, `order`, `per_page`, and `page`.

    **Example**

    ```hot
    hits ::github::search/search-issues("repo:hot-dev/hot is:pr is:open review:required")
    hits.total_count
    ```
    """
}
fn
(query: Str): Map {
  search-issues(query, {})
},
(query: Str, params: Map): Map {
  ::api/json("GET", search-path("issues", query, params))
}

search-code
meta {
    doc: """GET /search/code - Search code, e.g. `"repo:hot-dev/hot ed25519 in:file language:rust"`. `params` supports `sort`, `order`, `per_page`, and `page`."""
}
fn
(query: Str): Map {
  search-code(query, {})
},
(query: Str, params: Map): Map {
  ::api/json("GET", search-path("code", query, params))
}
