# Target directories and build artifacts (exclude everything except AWS builds)
target/
!target/aws-builds/

# Hot development directory (contains local SQLite DB and other dev files)
.hot/

# Git and version control
.git/
.gitignore

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS specific files
.DS_Store

# Docker files (avoid recursion)
Dockerfile
docker-compose.yml
*.Dockerfile

# Documentation and non-essential files
README.md
*.md
docs/

# Test files and examples
examples/
tests/

# Temporary files
*.tmp
*.temp
.env
.env.*

# Secrets, keys, and infrastructure state (mirroring .gitignore)
**/dev.key
*.key
**/*.key
*.pem
**/*.pem
*.p12
**/*.p12
*.pfx
**/*.pfx
hot/ctx.hot
*.tfvars
**/*.tfvars
*.tfstate
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/.terraform/
**/.terraform.tfstate.lock.info
*.kubeconfig
**/*.kubeconfig

# Local CDN, AI, and git worktree directories
cdn-output/
.claude/
.skills/
.worktrees/

# Node modules (if any)
node_modules/
package*.json

# Scripts directory (not needed for compilation)
scripts/

# GitHub workflows (not needed for compilation)
.github/

# Rust specific temporary files
**/*.rs.bk

# Build outputs from native builds
hot-*
*.exe
*.dll
*.so
*.dylib