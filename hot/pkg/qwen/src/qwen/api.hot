::qwen::api ns
meta {
    doc: """
    Low-level authenticated requests to Model Studio's OpenAI-compatible
    endpoint, through `::openai::api/Endpoint`. Paths are relative to
    `::qwen/base-url()` (e.g. `/chat/completions`).
    """
}

::ctx ::hot::ctx
::oai ::openai::api

HttpError ::oai/HttpError
HttpResponse ::hot::http/HttpResponse
StreamingHttpResponse ::hot::http/StreamingHttpResponse

endpoint
meta {
    doc: """
    The ctx-configured Qwen endpoint: `::qwen/base-url()` with the
    `qwen.api.key` key (your DashScope API key, `DASHSCOPE_API_KEY` in
    Alibaba's docs).

    **Example**

    ```hot
    ep ::qwen::api/endpoint()
    ep.base-url  // => "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
    ```
    """,
    ctx: {"qwen.api.key": {}}
}
fn (): ::oai/Endpoint {
    ::oai/endpoint(::qwen/base-url(), ::ctx/get("qwen.api.key"))
}

endpoint-for
meta {
    doc: """
    An explicit Qwen endpoint for a region (and optional workspace id),
    with an explicit key. Reads no ctx.

    **Example**

    ```hot
    us ::qwen::api/endpoint-for("us", null, "sk-...")
    us.base-url  // => "https://dashscope-us.aliyuncs.com/compatible-mode/v1"
    ```
    """
}
fn (region: Str?, workspace-id: Str?, api-key: Str): ::oai/Endpoint {
    ::oai/endpoint(::qwen/resolve-base-url(null, region, workspace-id), api-key)
}

request
meta {
    doc: """
    Authenticated request to the ctx-configured endpoint. Returns the raw
    `HttpResponse`.

    **Example**

    ```hot
    response ::qwen::api/request("GET", "/models")
    response ::qwen::api/request("POST", "/chat/completions", {}, {
        model: "qwen3.7-plus",
        messages: [{role: "user", content: "Hello"}]
    })
    ```
    """
}
fn
(method: Str, path: Str): HttpResponse {
    request(method, path, {}, "")
},
(method: Str, path: Str, additional-headers: Map): HttpResponse {
    request(method, path, additional-headers, "")
},
(method: Str, path: Str, additional-headers: Map, body: Any): HttpResponse {
    ::oai/endpoint-request(endpoint(), method, path, additional-headers, body)
}

request-stream
meta {
    doc: """Streaming (SSE) request to the ctx-configured endpoint. Returns a `StreamingHttpResponse`."""
}
fn (method: Str, path: Str, additional-headers: Map, body: Any): StreamingHttpResponse {
    ::oai/endpoint-request-stream(endpoint(), method, path, additional-headers, body)
}
