            "X-Amz-Target": "AmazonSimpleNotificationService.GetTopicAttributes"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { GetTopicAttributesResponse({
                attributes: if(is-null(response.body.Attributes), {}, response.body.Attributes)
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(topic_arn: Str): GetTopicAttributesResponse | AwsError {
    get-topic-attributes(topic_arn, {})
}

