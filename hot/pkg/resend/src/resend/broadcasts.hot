remove-existing-broadcast-that-is-draft-status
meta {
    doc: """Remove an existing broadcast. Only broadcasts in draft status can be deleted."""
}
fn
(request: DELETEBroadcastsIdRequest): DELETEBroadcastsIdResponse {
  remove-existing-broadcast-that-is-draft-status(request, {})
},
(request: DELETEBroadcastsIdRequest, opts: Map): DELETEBroadcastsIdResponse {
