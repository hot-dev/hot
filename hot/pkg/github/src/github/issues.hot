::github::issues ns

::api ::github::api
query-string ::hot::uri/query-string

list-issues
meta {
    doc: """
    GET /repos/{owner}/{repo}/issues - List issues (GitHub includes PRs;
    filter on the `pull_request` key if you need issues only). `params`
    supports `state` ("open"/"closed"/"all"), `labels` (comma-separated),
    `assignee`, `since`, `per_page`, `page`. Returns a single page (GitHub
    default 30, max 100); pass `page` to paginate.
    """
}
fn
(owner: Str, repo: Str): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/issues`)
},
(owner: Str, repo: Str, params: Map): Vec {
  list-issues(owner, repo, params, {})
},
(owner: Str, repo: Str, params: Map, opts: Map): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/issues${query-string(params)}`, {}, "", opts)
}

get-issue
meta {
    doc: """GET /repos/{owner}/{repo}/issues/{number} - One issue."""
}
fn
(owner: Str, repo: Str, number: Int): Map {
  get-issue(owner, repo, number, {})
},
(owner: Str, repo: Str, number: Int, opts: Map): Map {
  ::api/json("GET", `/repos/${owner}/${repo}/issues/${number}`, {}, "", opts)
}

create-issue
meta {
    doc: """
    POST /repos/{owner}/{repo}/issues - Open an issue. `options`: `body`,
    `labels` (Vec), `assignees` (Vec), `milestone`.

    **Example**

    ```hot
    issue ::github::issues/create-issue("acme", "api", "Timeout on /v1/users", {
      body: "Repro steps ...",
      labels: ["bug"]
    })
    issue.number
    ```
    """
}
fn
(owner: Str, repo: Str, title: Str): Map {
  create-issue(owner, repo, title, {})
},
(owner: Str, repo: Str, title: Str, options: Map): Map {
  create-issue(owner, repo, title, options, {})
},
(owner: Str, repo: Str, title: Str, options: Map, opts: Map): Map {
  ::api/json("POST", `/repos/${owner}/${repo}/issues`, {}, {title: title, ...options}, opts)
}

update-issue
meta {
    doc: """PATCH /repos/{owner}/{repo}/issues/{number} - Update fields: `title`, `body`, `state` ("open"/"closed"), `state_reason`, `labels`, `assignees`."""
}
fn
(owner: Str, repo: Str, number: Int, changes: Map): Map {
  update-issue(owner, repo, number, changes, {})
},
(owner: Str, repo: Str, number: Int, changes: Map, opts: Map): Map {
  ::api/json("PATCH", `/repos/${owner}/${repo}/issues/${number}`, {}, changes, opts)
}

close-issue
meta {
    doc: """Close an issue (`state: "closed"`, reason "completed")."""
}
fn
(owner: Str, repo: Str, number: Int): Map {
  close-issue(owner, repo, number, {})
},
(owner: Str, repo: Str, number: Int, opts: Map): Map {
  update-issue(owner, repo, number, {state: "closed", state_reason: "completed"}, opts)
}

create-comment
meta {
    doc: """POST /repos/{owner}/{repo}/issues/{number}/comments - Comment on an issue or pull request."""
}
fn
(owner: Str, repo: Str, number: Int, body: Str): Map {
  create-comment(owner, repo, number, body, {})
},
(owner: Str, repo: Str, number: Int, body: Str, opts: Map): Map {
  ::api/json("POST", `/repos/${owner}/${repo}/issues/${number}/comments`, {}, {body: body}, opts)
}

list-comments
meta {
    doc: """GET /repos/{owner}/{repo}/issues/{number}/comments - The comments on an issue or pull request. `params` supports `since`, `per_page`, `page`. Returns a single page (GitHub default 30, max 100); pass `page` to paginate."""
}
fn
(owner: Str, repo: Str, number: Int): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/issues/${number}/comments`)
},
(owner: Str, repo: Str, number: Int, params: Map): Vec {
  list-comments(owner, repo, number, params, {})
},
(owner: Str, repo: Str, number: Int, params: Map, opts: Map): Vec {
  ::api/json("GET", `/repos/${owner}/${repo}/issues/${number}/comments${query-string(params)}`, {}, "", opts)
}

add-labels
meta {
    doc: """POST /repos/{owner}/{repo}/issues/{number}/labels - Add labels to an issue."""
}
fn
(owner: Str, repo: Str, number: Int, labels: Vec): Vec {
  add-labels(owner, repo, number, labels, {})
},
(owner: Str, repo: Str, number: Int, labels: Vec, opts: Map): Vec {
  ::api/json("POST", `/repos/${owner}/${repo}/issues/${number}/labels`, {}, {labels: labels}, opts)
}
