::increase::standard-webhooks ns
meta {
    doc: """
    A reusable verifier for Standard Webhooks
    (https://www.standardwebhooks.com), the signing scheme Increase uses.
    A delivery carries three headers:

    - `webhook-id`: the message id (Increase sends the Event id)
    - `webhook-timestamp`: Unix seconds when the delivery was sent
    - `webhook-signature`: space-separated signatures, each
      `v1,<base64 HMAC-SHA256>`; several are sent while a secret rotates

    The signed content is `{id}.{timestamp}.{raw body}`. `verify` accepts
    the delivery when any `v1` signature matches (each compared in
    constant time) and the timestamp is within the tolerance (five minutes
    by default) in either direction. It fails closed: a missing header, a
    non-numeric timestamp, an empty key or an unknown signature version is
    a rejection.

    Keys: Standard Webhooks secrets look like `whsec_<base64>`; turn one
    into the HMAC key with `decode-secret`. Increase signs with the raw
    bytes of the event subscription's shared secret instead (see
    `::increase::webhooks`).
    """
}

::b64 ::hot::base64
::hmac ::hot::hmac
::time ::hot::time
::re ::hot::regex

DEFAULT_TOLERANCE_SECONDS 300

SECRET_PREFIX "whsec_"

BASE64_ALPHABET "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

pad-base64
meta {
    doc: """
    Canonical, padded base64 for a secret that may be shared unpadded:
    strip any `=`, clear the unused low bits of the last character (the
    reference libraries decode leniently and ignore them; Hot's decoder
    is strict), and pad to a multiple of four. Exposed for testing.
    """
}
fn (text: Str): Str {
  bare ::re/replace-all(text, "=+$", "")
  remainder mod(length(bare), 4)
  unused-bits cond {
    eq(remainder, 2) => { 16 }
    eq(remainder, 3) => { 4 }
    => { 1 }
  }

  last-index sub(length(bare), 1)
  last-char if(lt(last-index, 0), "", slice(bare, last-index, length(bare)))
  position if(is-empty(last-char), null, ::hot::bytes/index-of(Bytes(BASE64_ALPHABET), Bytes(last-char)))
  canonical cond {
    or(eq(unused-bits, 1), is-null(position)) => { bare }
    => {
      cleared sub(position, mod(position, unused-bits))
      `${slice(bare, 0, last-index)}${slice(BASE64_ALPHABET, cleared, add(cleared, 1))}`
    }
  }

  cond {
    eq(remainder, 2) => { `${canonical}==` }
    eq(remainder, 3) => { `${canonical}=` }
    => { canonical }
  }
}

decode-secret
meta {
    doc: """
    The HMAC key for a Standard Webhooks secret: drop an optional
    `whsec_` prefix and base64-decode the rest (padding optional). Errs
    on an empty or non-base64 secret.

    **Example**

    ```hot
    key ::increase::standard-webhooks/decode-secret("whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw")
    ```
    """
}
fn (secret: Str): Bytes {
  raw trim(secret)
  body if(starts-with(raw, SECRET_PREFIX), slice(raw, length(SECRET_PREFIX), length(raw)), raw)
  cond {
    is-empty(body) => { err("standard-webhooks: the webhook secret is empty") }
    not(::re/is-match(body, "^[A-Za-z0-9+/]+={0,2}$")) => { err("standard-webhooks: the webhook secret is not base64") }
    => {
      padded pad-base64(body)
      if(::b64/is-valid(padded), ::b64/decode(padded), err("standard-webhooks: the webhook secret is not base64"))
    }
  }
}

signed-content
meta {
    doc: """The bytes a Standard Webhooks signature covers: `{msg-id}.{timestamp}.` followed by the body exactly as received. A `Bytes` body stays bytes, so a body that isn't valid UTF-8 still verifies. Exposed for testing."""
}
fn (msg-id: Str, timestamp: Str, body: Str | Bytes): Str | Bytes {
  if(is-bytes(body), concat(Bytes(`${msg-id}.${timestamp}.`), body), `${msg-id}.${timestamp}.${body}`)
}

sign
meta {
    doc: """
    The `v1,<base64>` signature for a message: HMAC-SHA256 of
    `signed-content` under `key` (the decoded secret, as Bytes or Str).
    Use it to produce test deliveries.

    **Example**

    ```hot
    key ::increase::standard-webhooks/decode-secret("whsec_MfKQ9r8GKYqrTwjUPD8ILPZIo2LaLaSw")
    ::increase::standard-webhooks/sign(key, "msg_p5jXN8AQM9LWM0D4loKWxJek", "1614265330", "{\\"test\\": 2432232314}")
    // => "v1,g0hM9SsE+OTPJTGt/tmIKtSyZlE3uFJELVlNIOLJ1OE="
    ```
    """
}
fn (key: Str | Bytes, msg-id: Str, timestamp: Str, body: Str | Bytes): Str {
  `v1,${::b64/encode(::hmac/hmac-sha256-bytes(key, signed-content(msg-id, timestamp, body)))}`
}

header
meta {
    doc: """A header value by name, ignoring case, trimmed; `""` when absent. Exposed for testing."""
}
fn (headers: Map, name: Str): Str {
  wanted lowercase(name)
  found filter(keys(or(headers, {})), (k) { eq(lowercase(Str(k)), wanted) })
  value if(is-empty(found), null, get(headers, first(found)))
  if(is-str(value), trim(value), "")
}

signatures
meta {
    doc: """The space-separated entries of a `webhook-signature` header. Exposed for testing."""
}
fn (value: Str): Vec<Str> {
  filter(split(trim(value), " "), (s) { not(is-empty(s)) })
}

key-is-empty fn (key: Str | Bytes): Bool {
  eq(length(key), 0)
}

timestamp-within fn (timestamp: Int, now: Int, tolerance-seconds: Int): Bool {
  and(lte(sub(now, timestamp), tolerance-seconds), lte(sub(timestamp, now), tolerance-seconds))
}

verify-at
meta {
    doc: """
    Verify a delivery against `key` as of `now` (Unix seconds): true when
    `webhook-id`, `webhook-timestamp` and `webhook-signature` are present,
    the timestamp is an integer within `tolerance-seconds` of `now` (a
    tolerance of 0 or less rejects everything), and one of the signatures
    equals `sign(key, id, timestamp, body)`. Every candidate is compared
    in constant time. Exposed for testing with fixed vectors; use
    `verify` in handlers.
    """
}
fn (headers: Map, body: Str | Bytes, key: Str | Bytes, tolerance-seconds: Int, now: Int): Bool {
  msg-id header(headers, "webhook-id")
  timestamp header(headers, "webhook-timestamp")
  signature header(headers, "webhook-signature")
  cond {
    // An empty key would make every signature forgeable: fail closed.
    key-is-empty(key) => { false }
    is-empty(msg-id) => { false }
    is-empty(signature) => { false }
    lte(tolerance-seconds, 0) => { false }
    // WORKAROUND(hot-bug-6): Int("abc") halts the run; match the digits first.
    not(::re/is-match(timestamp, "^[0-9]{1,15}$")) => { false }
    => {
      expected sign(key, msg-id, timestamp, body)
      // Compare every candidate (no short-circuit), each in constant time.
      matches map(signatures(signature), (candidate) { secure-compare(expected, candidate) })
      and(in(true, matches), timestamp-within(Int(timestamp), now, tolerance-seconds))
    }
  }
}

verify
meta {
    doc: """
    Verify a delivery's `headers` and raw `body` against `key` (the
    decoded secret) at the current time, with a five-minute tolerance by
    default. Pass the body exactly as received (`::hot::http/raw-body`),
    never a re-serialized `request.body`.

    **Example**

    ```hot
    key ::increase::standard-webhooks/decode-secret(secret)
    ok ::increase::standard-webhooks/verify(request.headers, ::hot::http/raw-body(request), key)
    ```
    """
}
fn
(headers: Map, body: Str | Bytes, key: Str | Bytes): Bool {
  verify-at(headers, body, key, DEFAULT_TOLERANCE_SECONDS, ::time/epoch-seconds())
},
(headers: Map, body: Str | Bytes, key: Str | Bytes, tolerance-seconds: Int): Bool {
  verify-at(headers, body, key, tolerance-seconds, ::time/epoch-seconds())
}

verify-request
meta {
    doc: """`verify` for an inbound webhook request: its `headers` and `::hot::http/raw-body`."""
}
fn
(request: Map, key: Str | Bytes): Bool {
  verify-request(request, key, DEFAULT_TOLERANCE_SECONDS)
},
(request: Map, key: Str | Bytes, tolerance-seconds: Int): Bool {
  verify(or(get(request, "headers"), {}), ::hot::http/raw-body(request), key, tolerance-seconds)
}

endpoint-verification-response
meta {
    doc: """The `webhook-challenge-response` header value for a Standard Webhooks endpoint-verification `challenge`: `v1,` + base64 HMAC-SHA256 of the challenge under HMAC-SHA256(key, `"wev-v1"`). Increase doesn't send challenges; this is here for other Standard Webhooks senders."""
}
fn (key: Str | Bytes, challenge: Str): Str {
  verification-key ::hmac/hmac-sha256-bytes(key, "wev-v1")
  `v1,${::b64/encode(::hmac/hmac-sha256-bytes(verification-key, challenge))}`
}
