::ai::chat ns
meta {
    doc: """
    Provider-agnostic chat surface used by every `::ai::*` consumer.

    This module defines:

    - `Provider` enum and a model-name → provider mapping for routing.
    - `Message` and `ChatReply` types that normalize provider responses
      so downstream code never branches on the underlying SDK.
    - `ChatOptions` carrying the chat function reference, model name,
      optional system prompt, and (for tool-using flows) `tools` plus
      a `max-iterations` cap.
    - `run-loop`, the canonical agent loop that calls `chat-fn`,
      dispatches `tool_use` blocks via `::ai::tool/dispatch`, and
      iterates until the model finishes or the iteration cap is hit.

    Provider packages (e.g. `::anthropic::messages`, `::openai::chat`)
    each expose a `chat-with-tools` function matching the new
    `chat-fn` contract:

    ```
    chat-fn(model: Str, messages: Vec<Message>, system: Str?, tools: Vec<Tool>?): ChatReply
    ```

    The legacy `(model, prompt, system) -> Str` shape used by `::ai::rag`
    is still supported as-is — only `run-loop` callers must adopt the
    new shape.

    **Per-call provider credentials.** `ChatOptions.provider-opts` carries a
    provider's `opts` (`api-key`, `base-url`, ...) so one run can serve many
    tenants without touching ctx. It is handed to the `chat-opts-fn` and
    `chat-stream-opts-fn` slots, on `ChatOptions` or on a
    `ProviderRegistration`:

    ```
    chat-opts-fn(model: Str, messages: Vec<Message>, system: Str?, tools: Vec<Tool>?, provider-opts: Map): ChatReply
    chat-stream-opts-fn(model: Str, messages: Vec<Message>, system: Str?, tools: Vec<Tool>?, on-delta: Fn, provider-opts: Map): ChatReply
    ```

    A plain `chat-fn` keeps working without `provider-opts`, but can't receive
    it, so setting `provider-opts` for one is a failure naming the provider. A
    null or blank credential is a failure too, as is a `base-url` without a
    credential: a tenant's call never falls back to the project's ctx key.

    The run loop never puts `provider-opts` in chat history, step or delta
    stream records, skill context or failure payloads. It marks each credential
    in it with `::hot::ctx/mark-secret`, so call records mask it, including inside
    strings like `Bearer ${key}`. A credential shorter than 8 bytes is masked only
    as a whole value.
    """
}

::tool ::ai::tool

// ============================================================================
// Provider enum + registry
// ============================================================================

Provider
meta {
    doc: """
    Known AI chat completion providers. Declared `enum open` so
    third-party adapters can register their own provider identity
    via arrow enrollment without forking this enum:

    ```hot
    Mistral type { name: Str }
    Mistral -> Provider.Mistral
    ```

    Match expressions on `Provider` MUST include a `_` default arm
    (`open-enum-match-missing-default` otherwise).
    """
}
enum open { Anthropic, OpenAi, Xai, Gemini }

MODEL_PREFIXES [
    {prefix: "claude",  provider: Provider.Anthropic},
    {prefix: "gpt",     provider: Provider.OpenAi},
    {prefix: "o1",      provider: Provider.OpenAi},
    {prefix: "o3",      provider: Provider.OpenAi},
    {prefix: "o4",      provider: Provider.OpenAi},
    {prefix: "grok",    provider: Provider.Xai},
    {prefix: "gemini",  provider: Provider.Gemini},
]

// FOLLOWUP: `provider-available?(opts: ChatOptions) -> Bool` and a
// per-registration `available?-fn` that probes provider auth (`api-key`
// in `::hot::ctx`, or any other provider-specific signal). This would
// let `::ai::agent::chat-turn` (and other downstream callers) decide
// "should I run the model or fall back to a deterministic stub?"
// without hardcoding `::hot::ctx/get("anthropic.api.key")`. The
// ChatTurn fallback-text path is the current workaround — see
// `::ai::agent::chat-turn/TurnInput.fallback-text`.

ProviderRegistration
meta {
    doc: """
    Open-registry entry describing a chat-completion provider. First-party
    providers (Anthropic, OpenAI, xAI, Gemini) populate the built-in
    registry; third-party packages register their own via
    `with-providers`.

    Fields

    - `variant` — the `Provider` enum variant (open enum, third parties
      enroll via arrow: `MyProviderTag -> Provider.MyProviderTag`).
    - `detect` — `(model: Str) -> Bool`. Returns true when this entry
      should handle the given lowercased model name.
    - `display-name` — human-readable label used in logs and `provider-name`.
    - `chat-fn` — tools-aware chat function matching the
      `(model, messages, system, tools) -> ChatReply` contract.
    - `chat-stream-fn` — optional streaming variant.
    - `chat-opts-fn` — optional `chat-fn` that also takes
      `ChatOptions.provider-opts` as a fifth argument. Preferred over
      `chat-fn` when set.
    - `chat-stream-opts-fn` — optional `chat-stream-fn` that also takes
      `provider-opts` as a sixth argument. Preferred over `chat-stream-fn`
      when set.
    - `embed-fn` — optional embeddings function for RAG.
    - `meta` — open map for capability flags (`vision`, `audio`, `tool-choice`, etc.).
    """
}
type {
    variant: Provider,
    detect: Any,
    display-name: Str,
    chat-fn: Any,
    chat-stream-fn: Any,
    embed-fn: Any,
    meta: Map?,
    chat-opts-fn: Any?,
    chat-stream-opts-fn: Any?,
}

prefix-detector
meta {
    doc: """
    Build a `detect` function that matches when the model starts with
    `prefix` (case-insensitive).

    **Example**

    ```hot
    detect ::ai::chat/prefix-detector("mistral")
    detect("Mistral-Large")  // true
    detect("gpt-4o")  // false
    ```
    """
}
fn (prefix: Str): Fn {
    p lowercase(prefix)
    (model) { starts-with(lowercase(model), p) }
}

builtin-providers
meta {
    doc: """
    Built-in provider registry. Entries only carry `variant`, `detect`,
    and `display-name`, with `chat-fn` and `chat-stream-fn` left null, so
    this namespace doesn't pin a dependency on every provider package.

    Wire a provider's adapter in setup code: set `ChatOptions.chat-fn`
    (or `chat-opts-fn`, `chat-stream-fn`, `chat-stream-opts-fn`) to it,
    or register it with `with-providers` and pass the registry as
    `ChatOptions.providers`. The adapters are
    `::anthropic::chat-tools/chat-with-tools`,
    `::openai::chat-tools/chat-with-tools`,
    `::gemini::chat-tools/chat-with-tools`,
    `::xai::ai/chat-with-tools` and
    `::aws::bedrock::chat-tools/chat-with-tools`, each with a `-stream`
    counterpart. OpenAI-compatible servers (Groq, OpenRouter, Ollama, ...)
    and Qwen register through `hot.dev/openai-compatible` and `hot.dev/qwen`.

    ```hot
    opts ::ai::chat/ChatOptions({
        chat-fn: ::gemini::chat-tools/chat-with-tools,
        chat-stream-fn: ::gemini::chat-tools/chat-with-tools-stream,
        model: "gemini-3.8-flash",
    })
    ```

    **Example**

    ```hot
    map(::ai::chat/builtin-providers(), %.display-name)
    // ["Anthropic", "OpenAI", "xAI", "Google Gemini"]
    ```
    """
}
fn (): Vec<ProviderRegistration> {
    [
        ProviderRegistration({
            variant: Provider.Anthropic,
            detect: prefix-detector("claude"),
            display-name: "Anthropic",
            chat-fn: null,
            chat-stream-fn: null,
            embed-fn: null,
            meta: null,
        }),
        ProviderRegistration({
            variant: Provider.OpenAi,
            detect: (m) {
                lower lowercase(m)
                or(starts-with(lower, "gpt"), or(starts-with(lower, "o1"), or(starts-with(lower, "o3"), starts-with(lower, "o4"))))
            },
            display-name: "OpenAI",
            chat-fn: null,
            chat-stream-fn: null,
            embed-fn: null,
            meta: null,
        }),
        ProviderRegistration({
            variant: Provider.Xai,
            detect: prefix-detector("grok"),
            display-name: "xAI",
            chat-fn: null,
            chat-stream-fn: null,
            embed-fn: null,
            meta: null,
        }),
        ProviderRegistration({
            variant: Provider.Gemini,
            detect: prefix-detector("gemini"),
            display-name: "Google Gemini",
            chat-fn: null,
            chat-stream-fn: null,
            embed-fn: null,
            meta: null,
        }),
    ]
}

with-providers
meta {
    doc: """
    Compose a registry from the built-in entries plus `extras`. Later
    entries take precedence over earlier ones when their `detect`
    matches the same model — this lets a third-party adapter override
    a built-in (e.g. routing all `gpt-*` calls through a self-hosted
    proxy).

    ```hot
    ::chat ::ai::chat

    proxy ::chat/ProviderRegistration({
        variant: ::chat/Provider.OpenAi,
        detect: ::chat/prefix-detector("gpt"),
        display-name: "OpenAI Proxy",
        chat-fn: null,
        chat-stream-fn: null,
        embed-fn: null,
    })

    registry ::chat/with-providers([proxy])
    ::chat/detect-provider-from(registry, "gpt-4o").display-name  // "OpenAI Proxy"
    ```
    """
}
fn (extras: Vec<ProviderRegistration>): Vec<ProviderRegistration> {
    concat(builtin-providers(), or(extras, []))
}

detect-provider-from
meta {
    doc: """
    Find the registry entry whose `detect` returns true for `model`.
    Walks `registry` from the end first so user-supplied overrides win
    over built-ins. Returns `null` when nothing matches.

    **Example**

    ```hot
    registry ::ai::chat/builtin-providers()
    ::ai::chat/detect-provider-from(registry, "GPT-4o").display-name  // "OpenAI"
    ::ai::chat/detect-provider-from(registry, "llama3")  // null
    ```
    """
}
fn (registry: Vec<ProviderRegistration>, model: Str): ProviderRegistration? {
    name lowercase(model)
    walk reverse(or(registry, []))
    find-first(walk, (entry) { entry.detect(name) })
}

detect-provider
meta {
    doc: """
    Map a model name to its `Provider` variant. Walks
    `builtin-providers()` first, then falls back to the legacy
    `MODEL_PREFIXES` table for backward compatibility. Returns `Err`
    for unrecognized models. Use `detect-provider-from` when you have
    a custom registry.

    **Example**

    ```hot
    ::ai::chat/detect-provider("claude-sonnet-4-5")  // Provider.Anthropic
    ::ai::chat/detect-provider("gpt-4o")             // Provider.OpenAi
    ```
    """
}
fn (model: Str): Provider {
    name lowercase(model)
    found detect-provider-from(builtin-providers(), name)
    cond {
        not(is-null(found)) => { found.variant }
        => {
            hit find-first(MODEL_PREFIXES, (entry) { starts-with(name, entry.prefix) })
            if(is-null(hit), err(`Unknown model: ${model}`), hit.provider)
        }
    }
}

provider-name
meta {
    doc: """
    Human-readable name for a `Provider`. Falls back to the variant's
    short name for any provider enrolled by a third-party package via
    `Source -> Provider.Variant` arrows. The `_` default arm is
    required because `Provider` is an open enum.

    **Example**

    ```hot
    ::ai::chat/provider-name(::ai::chat/Provider.OpenAi)  // "OpenAI"
    ```
    """
}
fn match (provider: Provider): Str {
    Provider.Anthropic => { "Anthropic" }
    Provider.OpenAi    => { "OpenAI" }
    Provider.Xai       => { "xAI" }
    Provider.Gemini    => { "Google Gemini" }
    _                  => { Str(provider) }
}

resolve-registration
meta {
    doc: """
    Pick the `ProviderRegistration` whose `detect` matches `opts.model`,
    using `opts.providers` first if set, otherwise the built-in
    registry.

    Returns the **whole registration value** rather than its `chat-fn`.
    This is intentional — Hot reliably round-trips struct values across
    function boundaries, but extracting a typed fn field and returning
    it as a value does not preserve the fn ref. Call `reg.chat-fn(...)`
    directly on the returned registration to dispatch.

    ```hot
    ::chat ::ai::chat

    local-chat (model, messages, system, tools) {
        ::chat/ChatReply({text: "Hello from llama3", stop-reason: "end_turn"})
    }

    registry ::chat/with-providers([
        ::chat/ProviderRegistration({
            variant: ::chat/Provider.OpenAi,
            detect: ::chat/prefix-detector("ollama/"),
            display-name: "Ollama",
            chat-fn: local-chat,
            chat-stream-fn: null,
            embed-fn: null,
        })
    ])

    opts ::chat/ChatOptions({model: "ollama/llama3", providers: registry})
    reg ::chat/resolve-registration(opts)
    reply reg.chat-fn(opts.model, [::chat/user-message("Hi")], opts.system, null)
    reply.text  // "Hello from llama3"
    ```
    """
}
fn (opts: ChatOptions): Any {
    extras or(opts.providers, [])
    cond {
        not(is-empty(extras)) => { detect-provider-from(extras, opts.model) }
        => { detect-provider-from(builtin-providers(), opts.model) }
    }
}

PROVIDER_SETTING_KEYS ["base-url", "management-base-url", "api-version", "region", "environment"]

// Keys in `provider-opts` that hold no secret, left readable in call records.
PROVIDER_PLAIN_KEYS ["base-url", "management-base-url", "api-version", "region", "environment", "endpoint", "path-style", "transport"]

is-blank-opt
meta {
    no-doc: true,
    doc: """Internal: true for null and for a blank Str."""
}
fn (value: Any): Bool {
    or(is-null(value), and(is-str(value), is-empty(trim(value))))
}

mark-provider-opts
meta {
    no-doc: true,
    doc: """
    Internal: mask every credential in `provider-opts` in the run's call records.
    Every key but the settings in `PROVIDER_SETTING_KEYS` and `endpoint`,
    `path-style` and `transport` counts. Registered first thing in a run, this
    also masks the records of the calls still open above it.
    """
}
fn (provider-opts: Map?): Null {
    opts or(provider-opts, {})
    for-each(keys(opts), (key) {
        cond {
            in(key, PROVIDER_PLAIN_KEYS) => { null }
            => { ::hot::ctx/mark-secret(opts[key]) }
        }
    })
    null
}

check-provider-opts
meta {
    doc: """
    Fail when a credential in `provider-opts` is null or blank: a tenant with a
    missing key must never fall back to the provider's ctx key. Any key other
    than the settings in `PROVIDER_SETTING_KEYS` counts as a credential. Leave
    a key out to use ctx.

    Also fail when `management-base-url` comes without `management-api-key`,
    or `base-url` without a credential, so a ctx key is never sent to a
    per-call URL. Provider names for the credential differ (`api-key`,
    `token`, ...), so for `base-url` any credential other than
    `management-api-key` passes here, and the provider's own resolver checks
    the exact key. Failures name keys, never values.

    **Example**

    ```hot
    // Passes: the credential has a value
    ::ai::chat/check-provider-opts({api-key: ::hot::ctx/get("tenant.acme.api.key")})

    // Fails: a blank credential never falls back to the ctx key
    ::ai::chat/check-provider-opts({api-key: ""})
    ```
    """
}
fn (provider-opts: Map?): Null {
    mark-provider-opts(provider-opts)
    for-each(keys(or(provider-opts, {})), (key) {
        cond {
            and(is-blank-opt(get(provider-opts, key)), not(in(key, PROVIDER_SETTING_KEYS))) => {
                fail(`ChatOptions.provider-opts.${key} is blank. Pass the credential, or leave ${key} out to use the provider's default.`)
            }
            => { null }
        }
    })
    opts or(provider-opts, {})
    has-value (key) { not(is-blank-opt(get(opts, key))) }
    credentials filter(keys(opts), (key) { and(not(in(key, PROVIDER_SETTING_KEYS)), not(eq(key, "management-api-key"))) })
    cond {
        and(has-value("management-base-url"), not(has-value("management-api-key"))) => {
            fail("ChatOptions.provider-opts has management-base-url but no management-api-key. A ctx key is never sent to a per-call base URL.")
        }

        and(has-value("base-url"), is-empty(credentials)) => {
            fail("ChatOptions.provider-opts has base-url but no api-key. A ctx key is never sent to a per-call base URL.")
        }
        => { null }
    }
}

reject-provider-opts
meta {
    no-doc: true,
    doc: """
    Internal: fail when `provider-opts` is set but `label`, the chat function
    about to be called, has no way to receive it. Running anyway would use the
    provider's defaults, usually the project's ctx key, for a tenant's call.
    Without `provider-opts` it does nothing. Names the provider, never values.
    """
}
fn (opts: ChatOptions, label: Str): Null {
    cond {
        is-empty(or(opts.provider-opts, {})) => { null }
        => {
            fail(`${label} does not support per-call credentials: ChatOptions.provider-opts is set for model '${opts.model}', but it has no opts-taking function. Use chat-opts-fn or chat-stream-opts-fn, or remove provider-opts.`)
        }
    }
}

dispatch-chat
meta {
    doc: """
    Dispatch a chat call using `opts`. Resolution order:

    1. If `opts.chat-opts-fn` is set, call it with `opts.provider-opts`
       (`{}` when unset).
    2. If `opts.chat-fn` is set, call it directly.
    3. Otherwise resolve a `ProviderRegistration` via `opts.providers`
       (or built-ins) and call its `chat-opts-fn` with `opts.provider-opts`,
       or else its `chat-fn`.
    4. Otherwise `fail` with a clear message.

    Use this helper in any code that wants to honor
    `ChatOptions.providers` without bypassing `chat-fn`'s
    explicit-override semantics.

    **Example**

    ```hot
    ::chat ::ai::chat
    reply-fn (model, messages, system, tools) {
        ::chat/ChatReply({text: `${model} says hi`, stop-reason: "end_turn"})
    }
    opts ::chat/ChatOptions({chat-fn: reply-fn, model: "claude-sonnet-4-5"})
    ::chat/dispatch-chat(opts, [::chat/user-message("Hello")], null).text  // "claude-sonnet-4-5 says hi"
    ```
    """
}
fn (opts: ChatOptions, messages: Any, tools: Any): Any {
    check-provider-opts(opts.provider-opts)
    cond {
        not(is-null(opts.chat-opts-fn)) => {
            opts.chat-opts-fn(opts.model, messages, opts.system, tools, or(opts.provider-opts, {}))
        }

        not(is-null(opts.chat-fn)) => {
            reject-provider-opts(opts, "ChatOptions.chat-fn")
            opts.chat-fn(opts.model, messages, opts.system, tools)
        }
        => {
            reg resolve-registration(opts)
            cond {
                is-null(reg) => {
                    fail(`No provider matched model '${opts.model}' in ChatOptions.providers or built-ins`)
                }

                not(is-null(reg.chat-opts-fn)) => {
                    reg.chat-opts-fn(opts.model, messages, opts.system, tools, or(opts.provider-opts, {}))
                }

                is-null(reg.chat-fn) => {
                    fail(`Provider '${reg.display-name}' has no chat-fn wired; pass an explicit chat-fn or supply a registration with chat-fn populated`)
                }
                => {
                    reject-provider-opts(opts, `Provider '${reg.display-name}'`)
                    reg.chat-fn(opts.model, messages, opts.system, tools)
                }
            }
        }
    }
}

dispatch-chat-stream
meta {
    doc: """
    Streaming counterpart to `dispatch-chat`. Honors explicit
    `opts.chat-stream-opts-fn` and `opts.chat-stream-fn` first, then the
    same two slots on `opts.providers[*]`. `chat-stream-opts-fn` receives
    `opts.provider-opts` (`{}` when unset).

    **Example**

    ```hot
    ::chat ::ai::chat
    stream-fn (model, messages, system, tools, on-delta) {
        on-delta(::chat/ReplyDelta.TextDelta({text: "hi"}))
        ::chat/ChatReply({text: "hi", stop-reason: "end_turn"})
    }
    opts ::chat/ChatOptions({chat-stream-fn: stream-fn, model: "claude-sonnet-4-5"})
    ::chat/dispatch-chat-stream(opts, [::chat/user-message("Hello")], null, ::chat/noop-on-delta).text  // "hi"
    ```
    """
}
fn (opts: ChatOptions, messages: Any, tools: Any, on-delta: Fn): Any {
    check-provider-opts(opts.provider-opts)
    cond {
        not(is-null(opts.chat-stream-opts-fn)) => {
            opts.chat-stream-opts-fn(opts.model, messages, opts.system, tools, on-delta, or(opts.provider-opts, {}))
        }

        not(is-null(opts.chat-stream-fn)) => {
            reject-provider-opts(opts, "ChatOptions.chat-stream-fn")
            opts.chat-stream-fn(opts.model, messages, opts.system, tools, on-delta)
        }
        => {
            reg resolve-registration(opts)
            cond {
                is-null(reg) => {
                    fail(`No provider matched model '${opts.model}' in ChatOptions.providers or built-ins`)
                }

                not(is-null(reg.chat-stream-opts-fn)) => {
                    reg.chat-stream-opts-fn(opts.model, messages, opts.system, tools, on-delta, or(opts.provider-opts, {}))
                }

                is-null(reg.chat-stream-fn) => {
                    fail(`Provider '${reg.display-name}' has no chat-stream-fn wired; pass an explicit chat-stream-fn or supply a registration with chat-stream-fn populated`)
                }
                => {
                    reject-provider-opts(opts, `Provider '${reg.display-name}'`)
                    reg.chat-stream-fn(opts.model, messages, opts.system, tools, on-delta)
                }
            }
        }
    }
}

complete-prompt
meta {
    doc: """
    One prompt in, one Str out, for helpers such as `::ai::rag` that don't
    run a tool loop. With `opts.chat-opts-fn`, sends the prompt as a single
    user message along with `opts.provider-opts`. Otherwise calls the legacy
    `chat-fn` contract, `(model, prompt, system) -> Str`.

    **Example**

    ```hot
    ::chat ::ai::chat
    prompt-fn (model, prompt, system) { `${model}: ${prompt}` }
    opts ::chat/ChatOptions({chat-fn: prompt-fn, model: "gpt-4o"})
    ::chat/complete-prompt(opts, "Summarize this.", null)  // "gpt-4o: Summarize this."
    ```
    """
}
fn (opts: ChatOptions, prompt: Str, system: Str?): Any {
    check-provider-opts(opts.provider-opts)
    cond {
        not(is-null(opts.chat-opts-fn)) => {
            reply opts.chat-opts-fn(opts.model, [user-message(prompt)], system, null, or(opts.provider-opts, {}))
            if(is-err(reply), reply, or(reply.text, ""))
        }
        => {
            reject-provider-opts(opts, "ChatOptions.chat-fn")
            opts.chat-fn(opts.model, prompt, system)
        }
    }
}

// ============================================================================
// Conversation types
// ============================================================================

MessagePart
meta {
    doc: """
    One element of a multi-part message. Used by adapters and agent
    code to pass mixed text + image + audio + file content into a
    single `Message` turn without falling back to provider-specific
    shapes.

    Fields

    - `kind` — `"text" | "image" | "audio" | "file" | "tool-result"`.
    - `text` — UTF-8 string content. Set for `kind: "text"` and as a
      caption fallback on other kinds.
    - `mime` — best-effort media type (e.g. `"image/png"`,
      `"audio/mp3"`).
    - `data` — base64-encoded bytes when the part is inlined.
    - `url` — addressable URL when the part is referenced rather than
      inlined.
    - `name` — display label (filename for files, alt text for
      images).
    - `meta` — open map for adapter-specific hints (Anthropic
      `cache_control`, OpenAI `image.detail`, etc.).

    Adapters that don't yet support multi-part input MUST flatten
    parts via `flatten-parts(parts)` before sending — this collapses
    text parts into a single string and discards everything else with
    a placeholder note so the model sees something coherent.
    """
}
type {
    kind: Str,
    text: Str?,
    mime: Str?,
    data: Str?,
    url: Str?,
    name: Str?,
    meta: Map?,
}

text-part
meta {
    doc: """
    Convenience: build a `MessagePart({kind: "text", text: …})`.

    **Example**

    ```hot
    ::ai::chat/text-part("Hello").kind  // "text"
    ```
    """
}
fn (text: Str): MessagePart {
    MessagePart({
        kind: "text",
        text: text,
        mime: null,
        data: null,
        url: null,
        name: null,
        meta: null,
    })
}

image-part
meta {
    doc: """
    Convenience: build an image `MessagePart`. Either `data`
    (base64) or `url` should be set; `mime` should describe the
    encoding when `data` is set.

    **Example**

    ```hot
    ::ai::chat/image-part("https://example.com/cat.png").url  // "https://example.com/cat.png"
    ::ai::chat/image-part("iVBORw0KGgo=", "image/png").mime  // "image/png"
    ```
    """
}
fn
(url: Str): MessagePart {
    MessagePart({
        kind: "image",
        text: null,
        mime: null,
        data: null,
        url: url,
        name: null,
        meta: null,
    })
},
(data: Str, mime: Str): MessagePart {
    MessagePart({
        kind: "image",
        text: null,
        mime: mime,
        data: data,
        url: null,
        name: null,
        meta: null,
    })
}

flatten-parts
meta {
    doc: """
    Collapse a `Vec<MessagePart>` into a single string for adapters
    that don't yet support multi-part input. Text parts are
    concatenated with `\\n\\n` separators; image/audio/file parts
    become bracketed placeholders so the model knows something was
    attached even when the bytes can't be sent.

    Returns the empty string for empty input.

    **Example**

    ```hot
    ::chat ::ai::chat
    ::chat/flatten-parts([::chat/text-part("Caption"), ::chat/image-part("https://example.com/cat.png")])
    // "Caption\n\n[image:image (https://example.com/cat.png)]"
    ```
    """
}
fn (parts: Vec<MessagePart>?): Str {
    cond {
        is-null(parts) => { "" }
        is-empty(parts) => { "" }
        => {
            rendered map(parts, render-part)
            join(filter(rendered, (s) { not(is-empty(s)) }), "\n\n")
        }
    }
}

render-part
meta {
    no-doc: true,
    doc: "Internal: render a single `MessagePart` for `flatten-parts`."
}
fn (p: MessagePart): Str {
    cond {
        eq(p.kind, "text") => { or(p.text, "") }
        eq(p.kind, "image") => {
            label or(p.name, "image")
            location or(p.url, if(is-null(p.data), "inline", "inline-data"))
            `[image:${label} (${location})]`
        }

        eq(p.kind, "audio") => {
            label or(p.name, "audio")
            location or(p.url, "inline-data")
            `[audio:${label} (${location})]`
        }

        eq(p.kind, "file") => {
            label or(p.name, "file")
            mime or(p.mime, "application/octet-stream")
            `[file:${label} (${mime})]`
        }

        eq(p.kind, "tool-result") => { or(p.text, "[tool-result]") }
        => { `[${p.kind}]` }
    }
}

Message
meta {
    doc: """
    One turn of a chat conversation in normalized form. Provider
    adapters translate this into their native message shape.

    Fields

    - `role` — `"user"`, `"assistant"`, `"system"`, or `"tool"`.
    - `content` — usually a `Str` (plain text). For `role: "tool"` it
      is the result returned by `::ai::tool/dispatch`. For
      `role: "assistant"` turns that called tools it may be empty.
      When `parts` is set, adapters that support multi-part input
      should prefer `parts` and treat `content` as a flattened
      fallback.
    - `parts` — optional multi-part body. Set this when the message
      mixes text with images, audio, or files. Adapters that don't
      support multi-part input call `flatten-parts(parts)` to get a
      string equivalent.
    - `tool-calls` — present on `role: "assistant"` turns that
      requested tool use; carries the parsed `ToolCall` records.
    - `tool-call-id` — present on `role: "tool"` results, echoing
      the `id` of the originating `ToolCall`.
    - `is-error` — true on a `role: "tool"` result whose tool failed,
      so an adapter can mark it in the provider's shape. Null otherwise.

    **Example**

    ```hot
    user-msg Message({role: "user", content: "What's the weather in Paris?"})

    multimodal Message({
        role: "user",
        content: "What's in this image?",
        parts: [
            text-part("What's in this image?"),
            image-part(image-bytes, "image/png"),
        ],
    })

    assistant-call Message({
        role: "assistant",
        content: "",
        tool-calls: [::tool/ToolCall({id: "tu_1", name: "get-weather", input: {city: "Paris"}})]
    })

    tool-result Message({
        role: "tool",
        content: "18C and clear",
        tool-call-id: "tu_1"
    })
    ```
    """
}
type {
    role: Str,
    content: Any,
    parts: Vec<MessagePart>?,
    tool-calls: Vec<::ai::tool/ToolCall>?,
    tool-call-id: Str?,
    is-error: Bool?
}

message-text
meta {
    doc: """
    Extract the textual content of a `Message`, regardless of whether
    it's stored in `content` or in `parts`. Adapters that haven't
    moved to multi-part input use this to keep working with
    multi-part-aware callers.

    **Example**

    ```hot
    ::chat ::ai::chat
    ::chat/message-text(::chat/user-message("Hello"))  // "Hello"
    ::chat/message-text(::chat/Message({role: "user", content: "", parts: [::chat/text-part("Hi there")]}))  // "Hi there"
    ```
    """
}
fn (msg: Message): Str {
    cond {
        not(is-null(msg.parts)) => { flatten-parts(msg.parts) }
        is-str(msg.content) => { msg.content }
        => { Str(or(msg.content, "")) }
    }
}

ChatUsage
meta {
    doc: """
    Provider-agnostic usage and cost shape. Returned alongside
    `ChatReply.usage` by adapters that have populated it. Construct via
    `make-usage(map)` to coerce a provider's native usage map (with
    fields like `prompt_tokens`, `completion_tokens`) into the
    normalized shape.

    Fields

    - `input-tokens` — tokens consumed by the prompt + tool definitions,
      cached ones included.
    - `output-tokens` — tokens generated by the model, thinking included.
    - `total-tokens` — the provider's total when it reports one,
      otherwise input + output.
    - `cache-read-tokens` — the part of `input-tokens` served from a
      prompt cache.
    - `cache-write-tokens` — the part of `input-tokens` written to a
      prompt cache.
    - `thought-tokens` — the part of `output-tokens` spent on thinking.
    - `cost-usd` — provider-reported cost in USD when available.
    - `latency-ms` — wall-clock time the call took, when measured by
      the adapter.
    - `provider` — `display-name` of the provider that handled the call.
    - `model` — concrete model name (e.g. `"claude-sonnet-4-5"`).
    """
}
type {
    input-tokens: Int?,
    output-tokens: Int?,
    total-tokens: Int?,
    cache-read-tokens: Int?,
    cache-write-tokens: Int?,
    thought-tokens: Int?,
    cost-usd: Dec?,
    latency-ms: Int?,
    provider: Str?,
    model: Str?,
}

make-usage
meta {
    doc: """
    Build a `ChatUsage` from a provider-native usage map. Accepts
    Anthropic-style (`input_tokens`/`output_tokens`), OpenAI-style
    (`prompt_tokens`/`completion_tokens`), Gemini-style
    (`promptTokenCount`/`candidatesTokenCount`/`thoughtsTokenCount`) and
    the normalized kebab-case keys; missing fields stay `null`.

    Anthropic counts cached input tokens apart from `input_tokens`, so its
    `cache_read_input_tokens` and `cache_creation_input_tokens` are added
    into `input-tokens`. Gemini counts thinking apart from
    `candidatesTokenCount`, so its `thoughtsTokenCount` is added into
    `output-tokens`, as the other providers already count it. `total-tokens`
    is the reported total when there is one, otherwise input + output.

    ```hot
    usage ::ai::chat/make-usage({
        prompt_tokens: 120,
        completion_tokens: 84,
        latency_ms: 1280,
    }, "OpenAI", "gpt-4o")
    usage.total-tokens  // 204

    gemini ::ai::chat/make-usage({
        promptTokenCount: 100,
        candidatesTokenCount: 20,
        thoughtsTokenCount: 30,
        cachedContentTokenCount: 80,
        totalTokenCount: 150,
    }, "Google Gemini", "gemini-2.5-flash")
    gemini.output-tokens  // 50
    gemini.cache-read-tokens  // 80
    ```
    """
}
fn (raw: Map?, provider-name: Str?, model: Str?): ChatUsage {
    src or(raw, {})
    anth-input get(src, "input_tokens")
    anth-cache-read get(src, "cache_read_input_tokens")
    anth-cache-write get(src, "cache_creation_input_tokens")
    anth-total-input cond {
        is-null(anth-input) => { null }
        => { add(anth-input, add(or(anth-cache-read, 0), or(anth-cache-write, 0))) }
    }

    input-tokens or(get(src, "input-tokens"), anth-total-input, get(src, "prompt_tokens"), get(src, "promptTokenCount"), null)
    gemini-thoughts get(src, "thoughtsTokenCount")
    gemini-candidates get(src, "candidatesTokenCount")
    gemini-output cond {
        is-null(gemini-candidates) => { gemini-thoughts }
        is-null(gemini-thoughts) => { gemini-candidates }
        => { add(gemini-candidates, gemini-thoughts) }
    }

    output-tokens or(get(src, "output-tokens"), get(src, "output_tokens"), get(src, "completion_tokens"), gemini-output, null)
    reported-total or(get(src, "total-tokens"), get(src, "total_tokens"), get(src, "totalTokenCount"), null)
    total-tokens cond {
        is-some(reported-total) => { reported-total }
        and(is-some(input-tokens), is-some(output-tokens)) => { add(input-tokens, output-tokens) }
        => { null }
    }

    cache-read-tokens or(
        get(src, "cache-read-tokens"),
        anth-cache-read,
        get(src, "cachedContentTokenCount"),
        get-in(src, ["prompt_tokens_details", "cached_tokens"]),
        null
    )
    cache-write-tokens or(get(src, "cache-write-tokens"), anth-cache-write, null)
    thought-tokens or(
        get(src, "thought-tokens"),
        gemini-thoughts,
        get-in(src, ["completion_tokens_details", "reasoning_tokens"]),
        null
    )

    cost-usd or(get(src, "cost-usd"), get(src, "cost_usd"), null)
    latency-ms or(get(src, "latency-ms"), get(src, "latency_ms"), null)
    ChatUsage({
        input-tokens: input-tokens,
        output-tokens: output-tokens,
        total-tokens: total-tokens,
        cache-read-tokens: cache-read-tokens,
        cache-write-tokens: cache-write-tokens,
        thought-tokens: thought-tokens,
        cost-usd: cost-usd,
        latency-ms: latency-ms,
        provider: provider-name,
        model: model,
    })
}

ChatReply
meta {
    doc: """
    Normalized provider response. Returned by the new `chat-fn`
    contract and consumed by `run-loop`.

    Fields

    - `text` — the assistant's text output for this turn (may be empty
      when the turn is purely tool-use).
    - `tool-calls` — parsed `ToolCall` records when the model
      requested tool use.
    - `stop-reason` — `"end_turn"`, `"tool_use"`, `"max_tokens"`,
      `"stop_sequence"`, or any other provider-specific reason.
    - `usage` — token accounting and cost. Adapters that have moved to
      structured usage populate this with a `ChatUsage`; legacy
      adapters still populate it with a raw `Map` and callers use
      `make-usage` to coerce. Phase 1.5 will normalize on `ChatUsage`.
    - `raw` — the raw provider response for adapter use; opaque to
      `run-loop` callers.
    """
}
type {
    text: Str?,
    tool-calls: Vec<::ai::tool/ToolCall>?,
    stop-reason: Str,
    usage: Any?,
    raw: Any?
}

// ============================================================================
// Streaming deltas
// ============================================================================

TextDelta
meta {
    doc: """
    Incremental text fragment from a streaming reply. `text` is the
    delta only — concatenate them in order to reconstruct the full
    assistant text for the turn.
    """
}
type {
    text: Str
}

ToolUseStart
meta {
    doc: """
    A new `tool_use` block has begun in a streaming reply. The model
    has chosen `name` for tool-call `id`; the input arguments stream
    as `ToolUseInputDelta` events until a matching `ToolUseEnd`.
    """
}
type {
    id: Str,
    name: Str
}

ToolUseInputDelta
meta {
    doc: """
    Partial JSON fragment of a tool call's input. Concatenate the
    `partial-input-json` strings for a given `id`, then `from-json`
    the result to reconstruct the call's `input` map.
    """
}
type {
    id: Str,
    partial-input-json: Str
}

ToolUseEnd
meta {
    doc: """
    A `tool_use` block has finished streaming. The accumulated input
    JSON is now ready to parse and dispatch.
    """
}
type {
    id: Str
}

StreamStop
meta {
    doc: """
    Final event of a streaming turn. `reason` mirrors `ChatReply.stop-reason`
    (`"end_turn"`, `"tool_use"`, `"max_tokens"`, …). `usage` carries
    the normalized `{input-tokens, output-tokens}` map when the
    provider reports it on this terminal event.
    """
}
type {
    reason: Str,
    usage: Map?
}

ReplyDelta
meta {
    doc: """
    Provider-agnostic streaming event emitted by a `chat-stream-fn`.
    Each event is one of:

    - `TextDelta` — a text fragment (concatenate to rebuild the turn).
    - `ToolUseStart` — a new tool call has begun (`id`, `name`).
    - `ToolUseInputDelta` — partial JSON of a tool call's input.
    - `ToolUseEnd` — a tool call has finished streaming.
    - `Stop` — terminal event with `stop-reason` and optional `usage`.

    Provider adapters translate native SSE/wire events into this
    enum so consumers (and `run-loop-stream`) never branch on the
    underlying SDK.

    Declared `enum open` so provider adapters can introduce
    provider-specific delta kinds (e.g., `ThinkingDelta`,
    `ReasoningDelta`) via arrow enrollment without forking this
    type. Match expressions on `ReplyDelta` MUST include a `_`
    default arm (`open-enum-match-missing-default` otherwise) —
    unknown deltas should be silently ignored or forwarded.
    """
}
enum open {
    TextDelta(TextDelta),
    ToolUseStart(ToolUseStart),
    ToolUseInputDelta(ToolUseInputDelta),
    ToolUseEnd(ToolUseEnd),
    Stop(StreamStop)
}

noop-on-delta
meta {
    doc: """
    Default `on-delta` callback used when a streaming caller does not
    supply one. Discards every event.

    **Example**

    ```hot
    ::ai::chat/noop-on-delta(::ai::chat/ReplyDelta.TextDelta({text: "hi"}))  // null
    ```
    """
}
fn (delta: ReplyDelta): Null { null }

// ============================================================================
// Token counting helpers
// ============================================================================

CHARS_PER_TOKEN_HEURISTIC 4
PER_MESSAGE_OVERHEAD_TOKENS 4

count-message-chars
meta {
    no-doc: true,
    doc: """Internal: serialize a single Message to a char-count for the shared heuristic."""
}
fn (m: Message): Int {
    body cond {
        is-str(m.content) => { m.content }
        is-null(m.content) => { "" }
        => { to-json(untype(m.content)) }
    }

    role-chars length(or(m.role, ""))
    body-chars length(body)
    // A call's `meta` is opaque provider data (Gemini thought signatures run
    // to kilobytes of base64) that the model never reads as text.
    tool-chars cond {
        is-null(m.tool-calls) => { 0 }
        => { length(to-json(map(m.tool-calls, (c) { {id: c.id, name: c.name, input: c.input} }))) }
    }

    add(add(role-chars, body-chars), tool-chars)
}

count-tokens-heuristic
meta {
    doc: """
    Provider-agnostic char/4 token estimator. Use as a fallback for
    `ChatOptions.count-tokens-fn` when a provider lacks a precise
    counter (e.g. OpenAI without `tiktoken`). Tracks BPE tokenizers
    to within ~10% on English prose; code/JSON/non-Latin will skew
    higher.

    Contract matches the `count-tokens-fn` slot:

    ```
    (messages: Vec<Message>, model: Str): Int
    ```

    **Example**

    ```hot
    ::ai::chat/count-tokens-heuristic([::ai::chat/user-message("Hello there")], "gpt-4o")  // 8
    ```
    """
}
fn (messages: Vec<Message>, model: Str): Int {
    char-total reduce(messages, (acc, m) { add(acc, count-message-chars(m)) }, 0)
    overhead mul(length(messages), PER_MESSAGE_OVERHEAD_TOKENS)
    add(ceil(div(char-total, CHARS_PER_TOKEN_HEURISTIC)), overhead)
}

// ============================================================================
// ChatOptions
// ============================================================================

ChatOptions
meta {
    doc: """
    Options bundle for chat-consuming functions.

    Required

    - `chat-fn` — function reference used to call the underlying
      provider. Two contracts are recognized:
        - Legacy: `(model: Str, prompt: Str, system: Str?) -> Str`
          — used by `::ai::rag` and other single-shot helpers.
        - Tools-aware: `(model: Str, messages: Vec<Message>,
          system: Str?, tools: Vec<Tool>?) -> ChatReply` — required
          by `run-loop`.
    - `model` — model identifier passed through to the provider.
    - `chat-stream-fn` — streaming counterpart used by
      `run-loop-stream`. Contract:

      ```hot
      (model: Str, messages: Vec<Message>, system: Str?,
       tools: Vec<Tool>?, on-delta: Fn) -> ChatReply
      ```

      The function invokes `on-delta(delta: ReplyDelta)` for each
      event in turn order and returns the same `ChatReply` shape
      as the non-streaming version.

    - `chat-opts-fn` — `chat-fn` (tools-aware contract) that also takes
      `provider-opts` as a fifth argument. Preferred over `chat-fn`.
    - `chat-stream-opts-fn` — `chat-stream-fn` that also takes
      `provider-opts` as a sixth argument. Preferred over `chat-stream-fn`.

    Optional

    - `provider-opts` — per-call provider credentials and settings
      (`api-key`, `base-url`, ...), so one run can serve many tenants
      without touching ctx. Handed to `chat-opts-fn` and
      `chat-stream-opts-fn` as is, on `ChatOptions` or on the matching
      `ProviderRegistration`. Plain `chat-fn` and `chat-stream-fn` can't
      receive it, so setting it for them is a failure naming the provider. So
      is a null or blank credential, or a `base-url` without a credential: a
      tenant's call never falls back to the project's ctx key. Masked in the run's
      call records, and in nothing else the run loop stores or emits.
    - `system` — system prompt prepended to every call.
    - `tools` — tools the model is allowed to call from `run-loop`.
    - `skills` — vector of skill-meta'd functions to advertise to the
      model. `run-loop` wraps these in `::ai::skill/in-memory-resolver`
      and exposes the `list_skills`/`read_skill`/`apply_skill` built-in
      tools automatically. Ignored when `skill-resolver` is set.
    - `skill-resolver` — explicit `::ai::skill/SkillResolver`. Takes
      precedence over `skills` and lets callers plug in store-backed,
      embedding-ranked, or otherwise dynamic skill discovery while
      reusing the run-loop's index + built-in-tools machinery.
    - `skill-context` — per-turn map merged into every `apply_skill`
      invocation's `ctx` argument before the skill's `body-fn` runs.
      The harness's keys override anything the model passes for the
      same key — useful for threading inbound `attachments`, sender
      identity, transport, or session info into skill resolution
      without trusting the model to populate them. Ignored by static
      `body` skills (those are returned verbatim).
    - `max-iterations` — hard cap on `run-loop` turns (default 10).
    - `max-context-tokens`, `max-output-tokens`, `warn-context-pct` —
      reserved for Phase 1.5 token-budget enforcement; ignored today.
    - `emit-steps` — when `true`, `run-loop` publishes a per-turn
      observability record to the current run's stream via
      `::hot::stream/data`. Defaults to `false`. Errors from missing
      stream context are swallowed so opting in is safe in any
      execution environment.
    - `step-data-type` — stream `data-type` label used when
      `emit-steps` is on. Defaults to `"ai:chat:step"`.
    - `emit-stream-deltas` — when `true`, `run-loop-stream` mirrors
      every `ReplyDelta` to the current run's stream via
      `::hot::stream/data` (in addition to invoking any caller
      `on-delta`). Defaults to `false`. Errors from missing stream
      context are swallowed.
    - `delta-data-type` — stream `data-type` label used when
      `emit-stream-deltas` is on. Defaults to `"ai:chat:delta"`.
    - `count-tokens-fn` — provider's `(messages, model) -> Int`
      counter used by pre-call budget checks. When unset, falls
      back to `count-tokens-heuristic`. It doesn't receive
      `provider-opts`; bind per-call credentials in a closure.
    - `model-context-window` — explicit context-window size in
      tokens. When unset, the budget check uses
      `max-context-tokens` directly without computing a percentage.
    - `on-final-reply` — called when the model replies with no tool
      calls, as `(reply: ChatReply, messages: Vec<Message>) -> Str?`,
      where `messages` is the history the model answered. Return null or
      an empty Str to accept the reply. Return a Str to send it to the
      model as a user turn and ask again, for example "You haven't called
      submit_result yet." Each extra turn counts toward `max-iterations`.
      An Err it returns ends the loop with that Err.
    - `fail-on-tool-error` — when `true`, a failed tool call ends the
      loop with an Err holding a `ToolFailure`, instead of going back to
      the model as an error result. Use it when the failure should be
      retried by the platform, not explained by the model. A tool's own
      `fail-on-error` wins over this. A call to a tool that doesn't exist
      always goes back to the model.

    **Example**

    ```hot
    ::tool ::ai::tool
    ::anth ::anthropic::messages

    weather-tool ::tool/from-fn(get-weather)

    opts ChatOptions({
        chat-fn: ::anth/chat-with-tools,
        model: "claude-sonnet-4-5",
        system: "You are a concise assistant.",
        tools: [weather-tool],
        max-iterations: 5
    })
    ```
    """
}
type {
    chat-fn: Fn?,
    chat-stream-fn: Fn?,
    model: Str,
    system: Str?,
    tools: Vec<::ai::tool/Tool>?,
    skills: Vec<Any>?,
    skill-resolver: ::ai::skill/SkillResolver?,
    skill-context: Map?,
    providers: Vec<ProviderRegistration>?,
    max-iterations: Int?,
    max-context-tokens: Int?,
    max-output-tokens: Int?,
    warn-context-pct: Dec?,
    emit-steps: Bool?,
    step-data-type: Str?,
    emit-stream-deltas: Bool?,
    delta-data-type: Str?,
    count-tokens-fn: Fn?,
    model-context-window: Int?,
    chat-opts-fn: Fn?,
    chat-stream-opts-fn: Fn?,
    provider-opts: Map?,
    on-final-reply: Fn?,
    fail-on-tool-error: Bool?
}

// ============================================================================
// Run loop
// ============================================================================

DEFAULT_MAX_ITERATIONS 10

user-message
meta {
    doc: """
    Construct a `Message` with `role: "user"` and the given text content.

    **Example**

    ```hot
    ::ai::chat/user-message("Hello").role  // "user"
    ```
    """
}
fn (text: Str): Message {
    Message({role: "user", content: text})
}

assistant-message
meta {
    doc: """
    Construct a `Message` representing an assistant turn. When
    `tool-calls` is non-null the message records a tool-use turn that
    must be paired with one or more `tool-result-message` entries on
    the next user turn.

    **Example**

    ```hot
    call ::ai::tool/ToolCall({id: "tu_1", name: "get-weather", input: {city: "Paris"}})
    first(::ai::chat/assistant-message("Checking.", [call]).tool-calls).name  // "get-weather"
    ::ai::chat/assistant-message(null, null).content  // ""
    ```
    """
}
fn (text: Str?, tool-calls: Vec<::ai::tool/ToolCall>?): Message {
    Message({
        role: "assistant",
        content: or(text, ""),
        tool-calls: tool-calls
    })
}

tool-result-message
meta {
    doc: """
    Construct a `Message` carrying a `::ai::tool/dispatch` result back
    to the model. Echoes `result.id` as `tool-call-id` so providers
    can correlate it with the originating `ToolCall`, and sets
    `is-error: true` when the tool failed.

    **Example**

    ```hot
    result ::ai::tool/ToolResult({id: "tu_1", output: "18C and clear", is-error: false})
    ::ai::chat/tool-result-message(result).tool-call-id  // "tu_1"
    ```
    """
}
fn (result: ::ai::tool/ToolResult): Message {
    base Message({
        role: "tool",
        content: result.output,
        tool-call-id: result.id
    })
    if(eq(result.is-error, true), Message({...untype(base), is-error: true}), base)
}

run-loop
meta {
    doc: """
    Drive a chat conversation through any number of tool-use turns,
    stopping when the model says `end_turn` or when `max-iterations`
    is reached.

    `opts.chat-fn` must match the tools-aware contract:

    ```
    (model: Str, messages: Vec<Message>, system: Str?, tools: Vec<Tool>?) -> ChatReply
    ```

    On each iteration:

    1. Call `chat-fn` with the running message list.
    2. If the reply has no tool calls, return its text. When
       `on-final-reply` is set and returns a Str, send that as a user
       turn and loop instead.
    3. Otherwise, dispatch every tool call via `::ai::tool/dispatch`.
       If a tool marked `ends-run` succeeded, return its output. Else
       append the assistant turn and one tool-result turn per call,
       and loop.

    Errors from individual tool calls are surfaced back to the model
    as `tool-result-message` entries with the failure text — the model
    is allowed to recover. With `fail-on-tool-error` (or a tool's
    `fail-on-error`), a failed call ends the loop with an Err holding a
    `ToolFailure` instead. Hitting `max-iterations` raises a `fail`.

    **Example**

    ```hot
    sum fn (x: Int, y: Int): Int { add(x, y) }

    opts ::ai::chat/ChatOptions({
        chat-fn: ::anthropic::chat-tools/chat-with-tools,
        model: "claude-sonnet-4-5",
        tools: [::ai::tool/from-fn(sum)],
        max-iterations: 5
    })

    answer ::ai::chat/run-loop(opts, "What is 17 + 25?")
    // answer = "17 + 25 is 42."
    ```
    """
}
fn (opts: ChatOptions, user-msg: Str): Str {
    run-loop-messages(opts, [user-message(user-msg)])
}

run-loop-messages
meta {
    doc: """
    Variant of `run-loop` that takes an explicit `Vec<Message>` as
    starting history. Useful for resuming an existing conversation.

    **Example**

    ```hot
    opts ::ai::chat/ChatOptions({
        chat-fn: ::anthropic::chat-tools/chat-with-tools,
        model: "claude-sonnet-4-5"
    })

    history [
        ::ai::chat/user-message("Hi"),
        ::ai::chat/assistant-message("Hello!", null),
        ::ai::chat/user-message("How are you?")
    ]
    ::ai::chat/run-loop-messages(opts, history)
    ```
    """
}
fn (opts: ChatOptions, messages: Vec<Message>): Str {
    mark-provider-opts(opts.provider-opts)
    max-iter or(opts.max-iterations, DEFAULT_MAX_ITERATIONS)
    base-tools or(opts.tools, [])
    resolver ::ai::skill/effective-resolver(opts.skill-resolver, opts.skills)

    skill-ctx {messages: messages, system: opts.system, model: opts.model}
    indexed-skills cond {
        is-null(resolver) => { [] }
        => { resolver.list-fn(skill-ctx) }
    }

    tools cond {
        is-null(resolver) => { base-tools }
        => { concat(base-tools, ::ai::skill/builtins-with-resolver(resolver, opts.skill-context)) }
    }

    host-owns-skill-tools some(base-tools, (t) { or(eq(t.name, "read_skill"), eq(t.name, "apply_skill")) })
    activation-resolver if(host-owns-skill-tools, null, resolver)
    seeded ::ai::skill/seed-active-skills(activation-resolver, messages, tools)

    effective-system cond {
        is-empty(indexed-skills) => { opts.system }
        => {
            index ::ai::skill/build-index(indexed-skills)
            cond {
                is-null(opts.system) => { index }
                is-empty(opts.system) => { index }
                => { `${opts.system}\n\n${index}` }
            }
        }
    }

    run-loop-step(
        ChatOptions({...untype(opts), system: effective-system}),
        messages,
        seeded.tools,
        max-iter,
        activation-resolver,
        seeded.active
    )
}

// ============================================================================
// Pre-call budget checks
// ============================================================================

DEFAULT_WARN_CONTEXT_PCT 0.8

estimate-tools-tokens
meta {
    no-doc: true,
    doc: """
    Internal: char-based heuristic for the JSON-serialized weight of
    a tool list. Adds ~10 tokens of overhead per tool to account for
    schema formatting in the wire request.
    """
}
fn (tools: Vec<::ai::tool/Tool>?): Int {
    cond {
        is-null(tools) => { 0 }
        is-empty(tools) => { 0 }
        => {
            json to-json(untype(tools))
            chars length(json)
            tool-overhead mul(length(tools), 10)
            add(ceil(div(chars, CHARS_PER_TOKEN_HEURISTIC)), tool-overhead)
        }
    }
}

estimate-system-tokens
meta {
    no-doc: true,
    doc: """Internal: char/4 heuristic for the system prompt."""
}
fn (system: Str?): Int {
    cond {
        is-null(system) => { 0 }
        is-empty(system) => { 0 }
        => { ceil(div(length(system), CHARS_PER_TOKEN_HEURISTIC)) }
    }
}

format-budget-breakdown
meta {
    no-doc: true,
    doc: """Internal: human-readable breakdown of a token budget overrun."""
}
fn (parts: Map, total: Int, limit: Int): Str {
    `Approaching context limit (${total} / ${limit}):
  system prompt: ${parts.system}
  tool schemas:  ${parts.tools}
  message history: ${parts.messages}`
}

check-budget
meta {
    no-doc: true,
    doc: """
    Internal: enforce `opts.max-context-tokens` /
    `opts.warn-context-pct` against `messages` + `system` + `tools`.

    - If neither limit is set, returns silently.
    - If `count-tokens-fn` is set, uses it for messages; otherwise
      falls back to `count-tokens-heuristic`.
    - Logs a warning via `tap` when the projected total crosses the
      `warn-context-pct` threshold of the limit.
    - Fails (`fail`) when the projected total exceeds the limit
      outright. The failure carries a structured breakdown.
    """
}
fn (opts: ChatOptions, messages: Vec<Message>, tools: Vec<::ai::tool/Tool>?): Null {
    limit cond {
        is-some(opts.max-context-tokens) => { opts.max-context-tokens }
        is-some(opts.model-context-window) => { opts.model-context-window }
        => { 0 }
    }

    cond {
        lte(limit, 0) => { null }
        => {
            counter or(opts.count-tokens-fn, count-tokens-heuristic)
            msg-tokens counter(messages, opts.model)
            sys-tokens estimate-system-tokens(opts.system)
            tool-tokens estimate-tools-tokens(tools)
            total add(add(msg-tokens, sys-tokens), tool-tokens)
            warn-pct or(opts.warn-context-pct, DEFAULT_WARN_CONTEXT_PCT)
            warn-threshold mul(limit, warn-pct)

            parts {
                messages: msg-tokens,
                system: sys-tokens,
                tools: tool-tokens
            }

            cond {
                gt(total, limit) => {
                    fail(
                        format-budget-breakdown(parts, total, limit),
                        {parts, total, limit, kind: "context_overflow"}
                    )
                }

                gt(total, warn-threshold) => {
                    tap(format-budget-breakdown(parts, total, limit), "ai:chat:budget warning")
                    null
                }
                => { null }
            }
        }
    }
}

emit-stream-delta
meta {
    no-doc: true,
    doc: """
    Internal: forward a `ReplyDelta` to the current run's stream when
    `opts.emit-stream-deltas` is on. Errors (e.g. no stream context)
    are swallowed.
    """
}
fn (opts: ChatOptions, delta: ReplyDelta): Null {
    cond {
        not(or(opts.emit-stream-deltas, false)) => { null }
        => {
            data-type or(opts.delta-data-type, ::ai::stream-labels/CHAT_DELTA)
            if-err(::hot::stream/data(data-type, delta), null)
            null
        }
    }
}

wrap-on-delta
meta {
    no-doc: true,
    doc: """
    Internal: build the effective per-turn `on-delta` callback —
    combines an optional caller-supplied `user-on-delta` with the
    stream-emit forwarder controlled by `opts.emit-stream-deltas`.
    """
}
fn (opts: ChatOptions, user-on-delta: Fn?): Fn {
    base or(user-on-delta, noop-on-delta)
    cond {
        not(or(opts.emit-stream-deltas, false)) => { base }
        => {
            (delta: ReplyDelta) {
                emit-stream-delta(opts, delta)
                base(delta)
            }
        }
    }
}

step-payload
meta {
    no-doc: true,
    doc: """Internal: the per-turn step record `emit-step` publishes. Lists its fields, so `provider-opts` can't reach the stream."""
}
fn (opts: ChatOptions, iteration: Int, reply: ChatReply, tool-results: Vec<Any>?): Map {
    {
        iteration: iteration,
        model: opts.model,
        text: reply.text,
        tool-calls: reply.tool-calls,
        tool-results: tool-results,
        stop-reason: reply.stop-reason,
        usage: reply.usage,
    }
}

emit-step
meta {
    no-doc: true,
    doc: """
    Internal: publish a per-turn step record to the current run's
    stream when `opts.emit-steps` is on. Errors (e.g. no stream
    context) are swallowed so callers can opt in unconditionally.
    """
}
fn (opts: ChatOptions, iteration: Int, reply: ChatReply, tool-results: Vec<Any>?): Null {
    cond {
        not(or(opts.emit-steps, false)) => { null }
        => {
            data-type or(opts.step-data-type, ::ai::stream-labels/CHAT_STEP)
            if-err(::hot::stream/data(data-type, step-payload(opts, iteration, reply, tool-results)), null)
            null
        }
    }
}

emit-skill-activations
meta {
    no-doc: true,
    doc: """
    Internal: publish an `ai:skill:activate` event per activated skill when
    `opts.emit-steps` is on. Swallows stream errors like `emit-step`.
    """
}
fn (opts: ChatOptions, iteration: Int, activations: Vec<Map>): Null {
    cond {
        or(not(or(opts.emit-steps, false)), is-empty(activations)) => { null }
        => {
            for-each(activations, (act) {
                payload {
                    iteration: iteration,
                    skill: act.skill,
                    tools-added: act.tools-added,
                    requires: act.requires,
                }

                if-err(::hot::stream/data(::ai::stream-labels/SKILL_ACTIVATE, payload), null)
            })
            null
        }
    }
}

ToolFailure
meta {
    doc: """
    Why `run-loop` stopped on a failed tool call, when
    `ChatOptions.fail-on-tool-error` or the tool's `fail-on-error` is on.
    The loop returns it as an Err.

    - `tool`: the tool's name, as the model called it.
    - `call-id`: the call's id.
    - `input`: the input the model passed.
    - `error`: the tool's failure, as `ToolResult.output` holds it.
    - `iteration`: the turn it happened on, from 1.

    **Example**

    ```hot
    failure ::ai::chat/ToolFailure({tool: "charge", call-id: "c1", input: {}, error: "card declined", iteration: 2})
    failure.error  // "card declined"
    ```
    """
}
type {
    tool: Str,
    call-id: Str,
    input: Map,
    error: Any,
    iteration: Int
}

final-nudge
meta {
    no-doc: true,
    doc: """Internal: what `on-final-reply` asks the model next, or null to accept the reply."""
}
fn (opts: ChatOptions, reply: ChatReply, messages: Vec<Message>): Str? {
    hook opts.on-final-reply
    cond {
        is-null(hook) => { null }
        => {
            nudge hook(reply, messages)
            cond {
                is-err(nudge) => { nudge }
                not(is-str(nudge)) => { null }
                is-empty(trim(nudge)) => { null }
                => { nudge }
            }
        }
    }
}

nudged-messages
meta {
    no-doc: true,
    doc: """Internal: the history after a reply `on-final-reply` sent back, with the reply's text (when it had any) and the nudge as a user turn."""
}
fn (messages: Vec<Message>, reply: ChatReply, nudge: Str): Vec<Message> {
    text or(reply.text, "")
    said if(is-empty(trim(text)), [], [assistant-message(text, null)])
    concat(messages, said, [user-message(nudge)])
}

is-fatal-failure
meta {
    no-doc: true,
    doc: """Internal: true when a failed result should end the loop: the tool's `fail-on-error`, else `fail-on-tool-error`. A call to an unknown tool never is."""
}
fn (opts: ChatOptions, tool: ::ai::tool/Tool?): Bool {
    cond {
        is-null(tool) => { false }
        is-some(tool.fail-on-error) => { eq(tool.fail-on-error, true) }
        => { eq(opts.fail-on-tool-error, true) }
    }
}

fatal-entry
meta {
    no-doc: true,
    doc: """Internal: the first `{call, result}` pair whose failure ends the loop, or null."""
}
fn (opts: ChatOptions, tools: Vec<::ai::tool/Tool>, dispatched: Vec<Map>): Map? {
    find-first(dispatched, (entry) {
        and(entry.result.is-error, is-fatal-failure(opts, ::tool/find-by-name(tools, entry.call.name)))
    })
}

finishing-entry
meta {
    no-doc: true,
    doc: """Internal: the first successful `{call, result}` pair from a tool marked `ends-run`, or null."""
}
fn (tools: Vec<::ai::tool/Tool>, dispatched: Vec<Map>): Map? {
    find-first(dispatched, (entry) {
        tool ::tool/find-by-name(tools, entry.call.name)
        and(not(entry.result.is-error), and(is-some(tool), eq(get(tool, "ends-run"), true)))
    })
}

tool-failure
meta {
    no-doc: true,
    doc: """Internal: the Err `run-loop` returns for a fatal tool failure."""
}
fn (entry: Map, iteration: Int): Any {
    call entry.call
    result entry.result
    err(ToolFailure({
        tool: call.name,
        call-id: result.id,
        input: or(call.input, {}),
        error: result.output,
        iteration: iteration
    }))
}

result-text
meta {
    no-doc: true,
    doc: """Internal: the loop's answer from an `ends-run` tool's output: a Str as is, anything else as JSON."""
}
fn (output: Any): Str {
    value untype(output)
    cond {
        is-null(value) => { "" }
        is-str(value) => { value }
        => { to-json(value) }
    }
}

run-loop-step
meta {
    no-doc: true,
    doc: """Internal: one iteration of `run-loop`. Tail-recursive."""
}
fn cond (opts: ChatOptions, messages: Vec<Message>, tools: Vec<::ai::tool/Tool>, remaining: Int, resolver: ::ai::skill/SkillResolver?, active-skills: Vec<Str>): Str {
    lte(remaining, 0) => {
        fail(`run-loop exceeded max-iterations`, {messages: messages})
    }
    => {
        max-iter or(opts.max-iterations, DEFAULT_MAX_ITERATIONS)
        iteration add(sub(max-iter, remaining), 1)
        check-budget(opts, messages, tools)
        reply dispatch-chat(opts, messages, tools)
        calls if(is-err(reply), [], or(reply.tool-calls, []))
        cond {
            is-err(reply) => { reply }
            is-empty(calls) => {
                emit-step(opts, iteration, reply, null)
                nudge final-nudge(opts, reply, messages)
                cond {
                    is-err(nudge) => { nudge }
                    is-null(nudge) => { or(reply.text, "") }
                    => { run-loop-step(opts, nudged-messages(messages, reply, nudge), tools, sub(remaining, 1), resolver, active-skills) }
                }
            }
            => {
                dispatched map(calls, (call) { {call: call, result: ::tool/dispatch(tools, call)} })
                results map(dispatched, %.result)
                emit-step(opts, iteration, reply, results)
                failure fatal-entry(opts, tools, dispatched)
                finish finishing-entry(tools, dispatched)
                cond {
                    is-some(failure) => { tool-failure(failure, iteration) }
                    is-some(finish) => { result-text(finish.result.output) }
                    => {
                activated ::ai::skill/activate-skills-from-calls(resolver, calls, tools, active-skills)
                emit-skill-activations(opts, iteration, activated.activations)
                tool-msgs map(results, tool-result-message)
                next-messages concat(
                    messages,
                    [assistant-message(reply.text, calls)],
                    tool-msgs
                )
                run-loop-step(opts, next-messages, activated.tools, sub(remaining, 1), resolver, activated.active)
                    }
                }
            }
        }
    }
}

// ============================================================================
// Streaming run loop
// ============================================================================

run-loop-stream
meta {
    doc: """
    Streaming counterpart to `run-loop`. Drives a tools-aware
    conversation through any number of turns, invoking
    `on-delta(delta: ReplyDelta)` for every event the underlying
    `chat-stream-fn` emits across all turns.

    `opts.chat-stream-fn` must match the streaming contract:

    ```
    (model: Str, messages: Vec<Message>, system: Str?,
     tools: Vec<Tool>?, on-delta: Fn) -> ChatReply
    ```

    On each iteration the function:

    1. Calls `chat-stream-fn` with the running message list and a
       merged on-delta that also forwards to `::hot::stream/data`
       when `opts.emit-stream-deltas` is on.
    2. Collects the final `ChatReply`. If no tool calls, returns
       the accumulated text.
    3. Otherwise dispatches every tool call via `::ai::tool/dispatch`,
       appends the assistant turn + tool-result turns, and loops.

    Errors and `max-iterations` behavior match `run-loop`.

    **Example**

    ```hot
    on-token (delta: ::ai::chat/ReplyDelta) {
        match delta {
            ::ai::chat/ReplyDelta.TextDelta => { print(delta.text) }
            => { null }
        }
    }

    sum fn (x: Int, y: Int): Int { add(x, y) }

    opts ::ai::chat/ChatOptions({
        chat-stream-fn: ::anthropic::chat-tools/chat-with-tools-stream,
        model: "claude-sonnet-4-5",
        tools: [::ai::tool/from-fn(sum)]
    })

    answer ::ai::chat/run-loop-stream(opts, "What is 17 + 25?", on-token)
    ```
    """
}
fn
(opts: ChatOptions, user-msg: Str): Str {
    run-loop-stream-messages(opts, [user-message(user-msg)], null)
},
(opts: ChatOptions, user-msg: Str, on-delta: Fn?): Str {
    run-loop-stream-messages(opts, [user-message(user-msg)], on-delta)
}

run-loop-stream-messages
meta {
    doc: """
    Variant of `run-loop-stream` that takes an explicit
    `Vec<Message>` as starting history. Useful for resuming an
    existing conversation while still streaming the next response.

    **Example**

    ```hot
    ::chat ::ai::chat
    stream-fn (model, messages, system, tools, on-delta) {
        on-delta(::chat/ReplyDelta.TextDelta({text: "Why did the tool cross the road?"}))
        ::chat/ChatReply({text: "Why did the tool cross the road?", stop-reason: "end_turn"})
    }
    opts ::chat/ChatOptions({chat-stream-fn: stream-fn, model: "claude-sonnet-4-5"})
    history [::chat/user-message("Hi"), ::chat/assistant-message("Hello!", null), ::chat/user-message("Tell me a joke.")]
    ::chat/run-loop-stream-messages(opts, history, null)  // "Why did the tool cross the road?"
    ```
    """
}
fn (opts: ChatOptions, messages: Vec<Message>, on-delta: Fn?): Str {
    mark-provider-opts(opts.provider-opts)
    max-iter or(opts.max-iterations, DEFAULT_MAX_ITERATIONS)
    base-tools or(opts.tools, [])
    resolver ::ai::skill/effective-resolver(opts.skill-resolver, opts.skills)

    skill-ctx {messages: messages, system: opts.system, model: opts.model}
    indexed-skills cond {
        is-null(resolver) => { [] }
        => { resolver.list-fn(skill-ctx) }
    }

    tools cond {
        is-null(resolver) => { base-tools }
        => { concat(base-tools, ::ai::skill/builtins-with-resolver(resolver, opts.skill-context)) }
    }

    host-owns-skill-tools some(base-tools, (t) { or(eq(t.name, "read_skill"), eq(t.name, "apply_skill")) })
    activation-resolver if(host-owns-skill-tools, null, resolver)
    seeded ::ai::skill/seed-active-skills(activation-resolver, messages, tools)

    effective-system cond {
        is-empty(indexed-skills) => { opts.system }
        => {
            index ::ai::skill/build-index(indexed-skills)
            cond {
                is-null(opts.system) => { index }
                is-empty(opts.system) => { index }
                => { `${opts.system}\n\n${index}` }
            }
        }
    }

    effective-on-delta wrap-on-delta(opts, on-delta)
    run-loop-stream-step(
        ChatOptions({...untype(opts), system: effective-system}),
        messages,
        seeded.tools,
        max-iter,
        effective-on-delta,
        activation-resolver,
        seeded.active
    )
}

run-loop-stream-step
meta {
    no-doc: true,
    doc: """Internal: one iteration of `run-loop-stream`. Tail-recursive."""
}
fn cond (opts: ChatOptions, messages: Vec<Message>, tools: Vec<::ai::tool/Tool>, remaining: Int, on-delta: Fn, resolver: ::ai::skill/SkillResolver?, active-skills: Vec<Str>): Str {
    lte(remaining, 0) => {
        fail(`run-loop-stream exceeded max-iterations`, {messages: messages})
    }
    => {
        max-iter or(opts.max-iterations, DEFAULT_MAX_ITERATIONS)
        iteration add(sub(max-iter, remaining), 1)
        check-budget(opts, messages, tools)
        reply dispatch-chat-stream(opts, messages, tools, on-delta)
        calls if(is-err(reply), [], or(reply.tool-calls, []))
        cond {
            is-err(reply) => { reply }
            is-empty(calls) => {
                emit-step(opts, iteration, reply, null)
                nudge final-nudge(opts, reply, messages)
                cond {
                    is-err(nudge) => { nudge }
                    is-null(nudge) => { or(reply.text, "") }
                    => { run-loop-stream-step(opts, nudged-messages(messages, reply, nudge), tools, sub(remaining, 1), on-delta, resolver, active-skills) }
                }
            }
            => {
                dispatched map(calls, (call) { {call: call, result: ::tool/dispatch(tools, call)} })
                results map(dispatched, %.result)
                emit-step(opts, iteration, reply, results)
                failure fatal-entry(opts, tools, dispatched)
                finish finishing-entry(tools, dispatched)
                cond {
                    is-some(failure) => { tool-failure(failure, iteration) }
                    is-some(finish) => { result-text(finish.result.output) }
                    => {
                activated ::ai::skill/activate-skills-from-calls(resolver, calls, tools, active-skills)
                emit-skill-activations(opts, iteration, activated.activations)
                tool-msgs map(results, tool-result-message)
                next-messages concat(
                    messages,
                    [assistant-message(reply.text, calls)],
                    tool-msgs
                )
                run-loop-stream-step(opts, next-messages, activated.tools, sub(remaining, 1), on-delta, resolver, activated.active)
                    }
                }
            }
        }
    }
}
