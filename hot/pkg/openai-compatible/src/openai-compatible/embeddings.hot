::openai-compatible::embeddings ns

::compat ::openai::compatible

CompatibleProvider ::compat/CompatibleProvider

EmbeddingsRequest
meta {doc: "OpenAI embeddings request. Unset optional fields are not sent."}
type {
    model: Str,
    input: Any,
    dimensions: Int?,
    encoding_format: Str?,
    user: Str?
}

embeddings-body
meta {
    doc: """
    The JSON body for an `EmbeddingsRequest`, with unset optionals omitted.
    Pure; exposed for testing.
    """
}
fn (request: EmbeddingsRequest): Map {
    filter-vals(untype(request), is-some)
}

create-embeddings
meta {
    doc: """
    POST /embeddings on the provider. Returns the decoded body
    (`data[].embedding`, `usage`), or an Err carrying `HttpError`.

    **Example**

    ```hot
    ::emb ::openai-compatible::embeddings

    out ::emb/create-embeddings(::openai-compatible/ollama(), ::emb/EmbeddingsRequest({
        model: "nomic-embed-text",
        input: ["first text", "second text"]
    }))
    out.data[0].embedding
    ```
    """
}
fn (p: CompatibleProvider, request: EmbeddingsRequest): Map {
    ::compat/create-embeddings(p, embeddings-body(request))
}
