::hubspot ns
meta {
    doc: """
    HubSpot CRM bindings.

    HubSpot's CRM API is uniform across object types, so
    `::hubspot::objects` covers contacts, companies, deals, tickets,
    activities, and custom objects with one surface (CRUD, search, batch,
    associations, pagination); `::hubspot::contacts` /
    `::hubspot::companies` / `::hubspot::deals` are thin conveniences on
    top. `::hubspot::engagements` and `::hubspot::notes` log activity,
    `::hubspot::pipelines` resolves deal stages, `::hubspot::owners`
    finds assignees, `::hubspot::properties` describes and creates
    fields, and `::hubspot::lists` manages segments. Paths use HubSpot's
    date-based API versions (`2026-09` by default).

    **Setup** — context variable `hubspot.token`: a private-app (or
    service key) access token (`pat-...`). Webhook verification
    additionally uses `hubspot.client.secret`; `hubspot.api.version`
    optionally pins another date version.

    **Quick start**

    ```hot
    ::contacts ::hubspot::contacts
    ::notes ::hubspot::notes

    contact ::contacts/create-contact({
      email: "ada@example.com",
      firstname: "Ada",
      lastname: "Lovelace"
    })

    ::notes/log-note("contacts", contact.id, "Talked at the conference; wants a demo.")

    found ::contacts/find-by-email("ada@example.com")
    ```
    """
}

BASE_URL "https://api.hubapi.com"
