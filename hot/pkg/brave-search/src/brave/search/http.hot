::brave::search::http ns
meta {
    doc: """HTTP plumbing for Brave Search: one `HttpError` shape with a readable message, and `send`."""
}

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError
meta {
    doc: """A non-2xx Brave response. `message` is readable text such as `Brave API error 422: Unable to validate request parameter(s)`; `body` keeps the raw response."""
}
type {
    status: Int,
    message: Str,
    headers: Map,
    body: Any
}

error-detail
meta {
    doc: """
    Brave's error text from a response body, or null. Understands `{error:
    {detail}}`, `{error: {message}}`, `{error}`, and plain `{message}` or
    string bodies. Exposed for testing.

    **Example**

    ```hot
    ::brave::search::http/error-detail({error: {detail: "Bad query"}})  // "Bad query"
    ::brave::search::http/error-detail({message: "Rate limited"})  // "Rate limited"
    ::brave::search::http/error-detail("Forbidden")  // "Forbidden"
    ::brave::search::http/error-detail({})  // null
    ```
    """
}
fn (body: Any): Any {
  cond {
    is-str(body) => { text-or-null(body) }
    not(is-map(body)) => { null }
    => {
      error get(body, "error")
      or(
        if(is-map(error), or(text-or-null(get(error, "detail")), text-or-null(get(error, "message"))), text-or-null(error)),
        text-or-null(get(body, "message"))
      )
    }
  }
}

text-or-null
meta {no-doc: true}
fn (value: Any): Any {
  if(and(is-str(value), not(is-blank(value))), value, null)
}

error-message
meta {
    doc: """
    `Brave API error <status>: <detail>`, or without the detail when the
    body has none. Exposed for testing.

    **Example**

    ```hot
    ::brave::search::http/error-message(422, {error: {detail: "Bad query"}})  // "Brave API error 422: Bad query"
    ::brave::search::http/error-message(500, null)  // "Brave API error 500"
    ```
    """
}
fn (status: Int, body: Any): Str {
  detail error-detail(body)
  if(is-some(detail), `Brave API error ${status}: ${detail}`, `Brave API error ${status}`)
}

http-error
meta {
    doc: """
    Build the `HttpError` for a non-2xx response. Exposed for testing.

    **Example**

    ```hot
    response {status: 422, headers: {}, body: {error: {detail: "Bad query"}}}
    ::brave::search::http/http-error(response).message  // "Brave API error 422: Bad query"
    ```
    """
}
fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    message: error-message(response.status, response.body),
    headers: or(response.headers, {}),
    body: response.body
  })
}

send
meta {
    doc: """
    Send `request` and unwrap: the decoded JSON body on 2xx, an Err carrying
    `HttpError` otherwise, or the transport Err.

    **Example**

    ```hot
    req ::brave::search/build-request("/web/search?q=rust", ::hot::ctx/get("brave.api.key"))
    out ::brave::search::http/send(req)

    // The decoded body, or the readable message when the call failed
    if-err(out, (e) { e.message })
    ```
    """
}
fn (request: HttpRequest): Any {
  response ::hot::http/request(request)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body }
    => { err(http-error(response)) }
  }
}
