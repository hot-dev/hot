::discord::channels ns
meta {
    doc: """
    Channels and threads: read, modify and delete channels, permission
    overwrites, invites, guild channel creation and ordering, and the
    thread lifecycle (start, join, members, archives).

    Calls that change a guild accept `reason`, recorded in the audit log.
    """
}

::api ::discord::api

seg ::discord::api/seg

// ============================================================================
// Channels
// ============================================================================

GetChannelRequest type {
  channel_id: Str
}

get-channel
meta {
    doc: """
    GET /channels/{channel_id} - A channel or thread by id.

    **Example**

    ```hot
    ::channels ::discord::channels

    channel ::channels/get-channel(::channels/GetChannelRequest({channel_id: "1100000000000000000"}))
    channel.name  // => "general"
    channel.type  // => 0 (guild text)
    ```
    """
}
fn (request: GetChannelRequest): Map {
  ::api/call("GET", `/channels/${seg(request.channel_id)}`)
}

ModifyChannelRequest type {
  channel_id: Str,
  name: Str?,
  type: Int?,
  position: Int?,
  topic: Str?,
  nsfw: Bool?,
  rate_limit_per_user: Int?,
  bitrate: Int?,
  user_limit: Int?,
  permission_overwrites: Vec<Map>?,
  parent_id: Str?,
  rtc_region: Str?,
  video_quality_mode: Int?,
  default_auto_archive_duration: Int?,
  flags: Int?,
  available_tags: Vec<Map>?,
  default_reaction_emoji: Map?,
  default_thread_rate_limit_per_user: Int?,
  default_sort_order: Int?,
  default_forum_layout: Int?,
  archived: Bool?,
  auto_archive_duration: Int?,
  locked: Bool?,
  invitable: Bool?,
  applied_tags: Vec<Str>?,
  reason: Str?,
  clear: Vec<Str>?
}

modify-channel
meta {
    doc: """
    PATCH /channels/{channel_id} - Update a guild channel or thread. Only
    the fields you set are sent. To null a nullable field on purpose (move
    a channel out of its category, drop a topic), list it in `clear`, e.g.
    `clear: ["parent_id"]`. Needs MANAGE_CHANNELS (MANAGE_THREADS for
    threads). Thread-only fields: `archived`, `auto_archive_duration`,
    `locked`, `invitable`, `applied_tags`.

    **Example**

    ```hot
    ::channels ::discord::channels

    ::channels/modify-channel(::channels/ModifyChannelRequest({
      channel_id: "1100000000000000000",
      topic: "Release coordination",
      rate_limit_per_user: 10,
      reason: "Slow mode during launch"
    }))
    ```
    """
}
fn (request: ModifyChannelRequest): Map {
  ::api/call("PATCH", `/channels/${seg(request.channel_id)}`, {
    body: ::api/body(request, ["channel_id"]),
    reason: request.reason
  })
}

DeleteChannelRequest type {
  channel_id: Str,
  reason: Str?
}

delete-channel
meta {
    doc: """DELETE /channels/{channel_id} - Delete a guild channel or thread, or close a DM. Returns the deleted channel. Needs MANAGE_CHANNELS (MANAGE_THREADS for threads). Deleting a category leaves its channels in place."""
}
fn (request: DeleteChannelRequest): Map {
  ::api/call("DELETE", `/channels/${seg(request.channel_id)}`, {reason: request.reason})
}

EditChannelPermissionsRequest type {
  channel_id: Str,
  overwrite_id: Str,
  type: Int,
  allow: Str?,
  deny: Str?,
  reason: Str?
}

edit-channel-permissions
meta {
    doc: """
    PUT /channels/{channel_id}/permissions/{overwrite_id} - Create or
    replace a permission overwrite for a role (`type` 0) or member
    (`type` 1). `allow`/`deny` are permission bit sets as strings; an
    omitted one defaults to "0". Needs MANAGE_ROLES.

    **Example**

    ```hot
    ::channels ::discord::channels

    // Hide the channel from @everyone (role id = guild id)
    ::channels/edit-channel-permissions(::channels/EditChannelPermissionsRequest({
      channel_id: "1100000000000000000",
      overwrite_id: "1000000000000000000",
      type: 0,
      deny: "1024"
    }))
    ```
    """
}
fn (request: EditChannelPermissionsRequest): Bool {
  ::api/call-ok("PUT", `/channels/${seg(request.channel_id)}/permissions/${seg(request.overwrite_id)}`, {
    body: ::api/body(request, ["channel_id", "overwrite_id"]),
    reason: request.reason
  })
}

DeleteChannelPermissionRequest type {
  channel_id: Str,
  overwrite_id: Str,
  reason: Str?
}

delete-channel-permission
meta {
    doc: """DELETE /channels/{channel_id}/permissions/{overwrite_id} - Remove a role or member permission overwrite. Needs MANAGE_ROLES."""
}
fn (request: DeleteChannelPermissionRequest): Bool {
  ::api/call-ok("DELETE", `/channels/${seg(request.channel_id)}/permissions/${seg(request.overwrite_id)}`, {reason: request.reason})
}

GetChannelInvitesRequest type {
  channel_id: Str
}

get-channel-invites
meta {
    doc: """GET /channels/{channel_id}/invites - Invites for a channel, with metadata. Needs MANAGE_CHANNELS."""
}
fn (request: GetChannelInvitesRequest): Vec<Map> {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/invites`)
}

CreateChannelInviteRequest type {
  channel_id: Str,
  max_age: Int?,
  max_uses: Int?,
  temporary: Bool?,
  unique: Bool?,
  target_type: Int?,
  target_user_id: Str?,
  target_application_id: Str?,
  role_ids: Vec<Str>?,
  reason: Str?
}

create-channel-invite
meta {
    doc: """
    POST /channels/{channel_id}/invites - Create an invite. `max_age` in
    seconds (0 = never, default 86400), `max_uses` (0 = unlimited),
    `unique: true` to skip reusing a similar invite. Needs
    CREATE_INSTANT_INVITE.

    **Example**

    ```hot
    ::channels ::discord::channels

    invite ::channels/create-channel-invite(::channels/CreateChannelInviteRequest({
      channel_id: "1100000000000000000",
      max_age: 3600,
      max_uses: 1,
      unique: true
    }))
    `https://discord.gg/${invite.code}`
    ```
    """
}
fn (request: CreateChannelInviteRequest): Map {
  ::api/call("POST", `/channels/${seg(request.channel_id)}/invites`, {
    body: ::api/body(request, ["channel_id"]),
    reason: request.reason
  })
}

