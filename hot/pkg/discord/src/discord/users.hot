::discord::users ns
meta {
    doc: """Users: the bot's own user and guilds, other users, and DM channels."""
}

::api ::discord::api

seg ::discord::api/seg

get-current-user
meta {
    doc: """
    GET /users/@me - The bot's own user. The cheapest token smoke test.

    **Example**

    ```hot
    me ::discord::users/get-current-user()
    me.username
    ```
    """
}
fn (): Map {
  ::api/call("GET", "/users/@me")
}

GetUserRequest type {
  user_id: Str
}

get-user
meta {
    doc: """
    GET /users/{user_id} - A user by id (username, global_name, avatar, banner, bot flag).

    **Example**

    ```hot
    ::users ::discord::users

    user ::users/get-user(::users/GetUserRequest({user_id: "1300000000000000000"}))
    user.username
    ```
    """
}
fn (request: GetUserRequest): Map {
  ::api/call("GET", `/users/${seg(request.user_id)}`)
}

ModifyCurrentUserRequest type {
  username: Str?,
  avatar: Str?,
  banner: Str?,
  clear: Vec<Str>?
}

modify-current-user
meta {
    doc: """
    PATCH /users/@me - Change the bot's `username`, `avatar` or `banner`
    (image data URIs, e.g. `data:image/png;base64,...`). Only fields you
    set are sent. To remove the avatar or banner, list it in `clear`:
    `clear: ["avatar"]`.

    **Example**

    ```hot
    ::users ::discord::users

    ::users/modify-current-user(::users/ModifyCurrentUserRequest({username: "hot-bot"}))
    ::users/modify-current-user(::users/ModifyCurrentUserRequest({clear: ["banner"]}))
    ```
    """
}
fn (request: ModifyCurrentUserRequest): Map {
  ::api/call("PATCH", "/users/@me", {body: ::api/body(request, [])})
}

GetCurrentUserGuildsRequest type {
  before: Str?,
  after: Str?,
  limit: Int?,
  with_counts: Bool?,
  shard: Int?
}

get-current-user-guilds
meta {
    doc: """
    GET /users/@me/guilds - Guilds the bot is in (partial guild objects),
    up to `limit` (1-200). Page with `before`/`after` guild ids, or use
    `get-all-current-user-guilds`. Apps on large bot sharding must pass
    `shard`.
    """
}
fn (request: GetCurrentUserGuildsRequest): Vec<Map> {
  ::api/call("GET", "/users/@me/guilds", {
    query: {
      before: request.before,
      after: request.after,
      limit: request.limit,
      with_counts: request.with_counts,
      shard: request.shard
    }
  })
}

get-all-current-user-guilds
meta {
    doc: """Every guild the bot is in (up to `max-items`, default 1000), paging with `after` 200 at a time."""
}
fn
(): Vec<Map> {
  get-all-current-user-guilds(1000)
},
(max-items: Int): Vec<Map> {
  ::api/paginate(
    (after) { get-current-user-guilds(GetCurrentUserGuildsRequest({after: after, limit: 200})) },
    (page) { last(page).id },
    200,
    max-items
  )
}

GetCurrentUserGuildMemberRequest type {
  guild_id: Str
}

get-current-user-guild-member
meta {
    doc: """GET /users/@me/guilds/{guild_id}/member - The current user's member object in a guild. Needs the `guilds.members.read` OAuth2 scope (user tokens); bots should use `::discord::guilds/get-guild-member`."""
}
fn (request: GetCurrentUserGuildMemberRequest): Map {
  ::api/call("GET", `/users/@me/guilds/${seg(request.guild_id)}/member`)
}

LeaveGuildRequest type {
  guild_id: Str
}

leave-guild
meta {
    doc: """DELETE /users/@me/guilds/{guild_id} - Make the bot leave a guild."""
}
fn (request: LeaveGuildRequest): Bool {
  ::api/call-ok("DELETE", `/users/@me/guilds/${seg(request.guild_id)}`)
}

CreateDMRequest type {
  recipient_id: Str
}

create-dm
meta {
    doc: """
    POST /users/@me/channels - Open (or fetch the existing) DM channel with
    a user. Send into it with `::discord::messages/create-message`.

    **Example**

    ```hot
    ::users ::discord::users
    ::messages ::discord::messages

    dm ::users/create-dm(::users/CreateDMRequest({recipient_id: "1300000000000000000"}))
    ::messages/create-message(::messages/CreateMessageRequest({channel_id: dm.id, content: "Your export is ready"}))
    ```
    """
}
fn (request: CreateDMRequest): Map {
  ::api/call("POST", "/users/@me/channels", {body: {recipient_id: request.recipient_id}})
}

get-current-user-connections
meta {
    doc: """GET /users/@me/connections - The current user's connected accounts. Needs a user OAuth2 token with the `connections` scope; bot tokens are rejected."""
}
fn (): Vec<Map> {
  ::api/call("GET", "/users/@me/connections")
}
