    ```
    """
}
fn
(owner: Str, repo: Str, number: Int): Map {
  list-requested-reviewers(owner, repo, number, {})
},
(owner: Str, repo: Str, number: Int, opts: Map): Map {
  ::api/json("GET", `${pull-path(owner, repo, number)}/requested_reviewers`, {}, "", opts)
}

request-reviewers
meta {
    doc: """
    POST /repos/{owner}/{repo}/pulls/{number}/requested_reviewers - Request
    reviews from users.

    **Example**

    ```hot
    ::github::pulls/request-reviewers("acme", "api", 68, ["octocat"])
    ```
    """
}
fn
(owner: Str, repo: Str, number: Int, reviewers: Vec): Map {
  request-reviewers(owner, repo, number, reviewers, {})
},
(owner: Str, repo: Str, number: Int, reviewers: Vec, opts: Map): Map {
  ::api/json("POST", `${pull-path(owner, repo, number)}/requested_reviewers`, {}, {reviewers: reviewers}, opts)
}

merge-pull
meta {
    doc: """
    PUT /repos/{owner}/{repo}/pulls/{number}/merge - Merge a PR. `options`:
    `merge_method` ("merge"/"squash"/"rebase"), `commit_title`,
    `commit_message`.

    **Example**

    ```hot
    merged ::github::pulls/merge-pull("acme", "api", 68, {merge_method: "squash"})
    merged.sha
    ```
    """
}
fn
(owner: Str, repo: Str, number: Int): Map {
  ::api/json("PUT", `${pull-path(owner, repo, number)}/merge`, {}, {})
},
(owner: Str, repo: Str, number: Int, options: Map): Map {
  merge-pull(owner, repo, number, options, {})
},
(owner: Str, repo: Str, number: Int, options: Map, opts: Map): Map {
  ::api/json("PUT", `${pull-path(owner, repo, number)}/merge`, {}, options, opts)
}
