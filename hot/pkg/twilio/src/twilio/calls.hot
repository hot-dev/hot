}

delete-call
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """DELETE /Accounts/{AccountSid}/Calls/{Sid}.json - Delete a call record. The call log is permanently removed."""
}
fn
(request: DeleteCallRequest): Bool {
  delete-call(request, {})
},
(request: DeleteCallRequest, opts: Map): Bool {
  resolve(opts) |> if-ok((client) { delete-call(client, request) })
},
(client: Client, request: DeleteCallRequest): Bool {
  ::twilio::api/delete-request(client, `${account-url(client)}/Calls/${::uri/encode(request.sid)}.json`)
}
