::github::commits ns

::api ::github::api
::uri ::hot::uri
query-string ::hot::uri/query-string

commit-path
meta {no-doc: true}
fn (owner: Str, repo: Str, ref: Str): Str {
  `/repos/${owner}/${repo}/commits/${::uri/encode(ref)}`
}

compare-path
meta {no-doc: true}
fn (owner: Str, repo: Str, base: Str, head: Str): Str {
  `/repos/${owner}/${repo}/compare/${::uri/encode(base)}...${::uri/encode(head)}`
}

get-commit
meta {
    doc: """
    GET /repos/{owner}/{repo}/commits/{ref} - One commit, including
    verification, stats, changed files, and patches. `ref` may be a SHA,
    branch, or tag. `params` supports `per_page` and `page` for large commits.

    **Example**

    ```hot
    commit ::github::commits/get-commit("acme", "api", "main")
    commit.commit.message
    map(commit.files, %.filename)
    ```
    """
}
fn
(owner: Str, repo: Str, ref: Str): Map {
  ::api/json("GET", commit-path(owner, repo, ref))
},
(owner: Str, repo: Str, ref: Str, params: Map): Map {
  get-commit(owner, repo, ref, params, {})
},
(owner: Str, repo: Str, ref: Str, params: Map, opts: Map): Map {
  ::api/json("GET", `${commit-path(owner, repo, ref)}${query-string(params)}`, {}, "", opts)
}

compare-commits
meta {
    doc: """
    GET /repos/{owner}/{repo}/compare/{base}...{head} - Compare two commits,
    branches, or tags. Returns merge base, ahead/behind counts, commits, and
    changed files. `params` supports `per_page` and `page`.

    **Example**

    ```hot
    diff ::github::commits/compare-commits("acme", "api", "v1.1.0", "v1.2.0")
    diff.ahead_by
    map(diff.commits, %.sha)
    ```
    """
}
fn
(owner: Str, repo: Str, base: Str, head: Str): Map {
  ::api/json("GET", compare-path(owner, repo, base, head))
},
(owner: Str, repo: Str, base: Str, head: Str, params: Map): Map {
  compare-commits(owner, repo, base, head, params, {})
},
(owner: Str, repo: Str, base: Str, head: Str, params: Map, opts: Map): Map {
  ::api/json("GET", `${compare-path(owner, repo, base, head)}${query-string(params)}`, {}, "", opts)
}

get-combined-status
meta {
    doc: """
    GET /repos/{owner}/{repo}/commits/{ref}/status - Combined legacy commit
    status and its latest status for every context.

    **Example**

    ```hot
    status ::github::commits/get-combined-status("acme", "api", "main")
    status.state
    ```
    """
}
fn
(owner: Str, repo: Str, ref: Str): Map {
  get-combined-status(owner, repo, ref, {})
},
(owner: Str, repo: Str, ref: Str, opts: Map): Map {
  ::api/json("GET", `${commit-path(owner, repo, ref)}/status`, {}, "", opts)
}

list-statuses
meta {
    doc: """
    GET /repos/{owner}/{repo}/commits/{ref}/statuses - Every legacy commit
    status, newest first. `params` supports `per_page` and `page`.

    **Example**

    ```hot
    statuses ::github::commits/list-statuses("acme", "api", "main", {per_page: 10})
    map(statuses, %.context)
    ```
    """
}
fn
(owner: Str, repo: Str, ref: Str): Vec {
  ::api/json("GET", `${commit-path(owner, repo, ref)}/statuses`)
},
(owner: Str, repo: Str, ref: Str, params: Map): Vec {
  list-statuses(owner, repo, ref, params, {})
},
(owner: Str, repo: Str, ref: Str, params: Map, opts: Map): Vec {
  ::api/json("GET", `${commit-path(owner, repo, ref)}/statuses${query-string(params)}`, {}, "", opts)
}
