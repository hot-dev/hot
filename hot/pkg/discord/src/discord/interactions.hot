BulkOverwriteGlobalCommandsRequest type {
  application_id: Str,
  commands: Vec<Map>
}

bulk-overwrite-global-commands
meta {
    doc: """
    PUT /applications/{application_id}/commands - Replace the whole set of
    global commands (commands not listed are deleted). The usual way to
    sync commands on deploy. Unset fields inside each command are dropped.

    **Example**

    ```hot
    ::interactions ::discord::interactions

    ::interactions/bulk-overwrite-global-commands(::interactions/BulkOverwriteGlobalCommandsRequest({
      application_id: "1800000000000000000",
      commands: [
        {name: "ping", description: "Check the bot is alive"},
        {name: "report", description: "Generate the daily report"}
      ]
    }))
    ```
    """
}
fn
(request: BulkOverwriteGlobalCommandsRequest): Vec<Map> {
  bulk-overwrite-global-commands(request, {})
},
(request: BulkOverwriteGlobalCommandsRequest, opts: Map): Vec<Map> {
  ::api/call("PUT", global-commands-path(request.application_id), {
    body: map(request.commands, (c) { ::api/body(c, []) })
  }, opts)
}

