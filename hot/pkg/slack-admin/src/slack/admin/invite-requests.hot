::slack::admin::invite-requests ns
meta {
    doc: """
    `admin.inviteRequests.*`: review workspace invite requests. With an
    org-level token, `team_id` is required.

    **Example**

    ```hot
    ::invites ::slack::admin::invite-requests

    pending ::invites/list(::invites/ListRequest({team_id: "T0123ABCDEF"}))
    ::invites/approve(::invites/ApproveRequest({invite_request_id: first(pending.invite_requests).id, team_id: "T0123ABCDEF"}))
    ```
    """
}

::api ::slack::admin::api

ListRequest type {
  team_id: Str?,
  cursor: Str?,
  limit: Int?
}

list
meta {
    doc: """
    admin.inviteRequests.list - List pending invite requests (`invite_requests`).

    Scope: `admin.invites:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `list-all`.

    **Example**

    ```hot
    ::invites ::slack::admin::invite-requests

    page ::invites/list(::invites/ListRequest({team_id: "T0123ABCDEF", limit: 100}))
    page.invite_requests
    ```
    """
}
fn
(): Map {
  list(ListRequest({}))
},
(request: ListRequest): Map {
  list(request, {})
},
(request: ListRequest, opts: Map): Map {
  ::api/call("admin.inviteRequests.list", request, opts)
}

list-all
meta {
    doc: """
    Every `invite_requests` entry from `admin.inviteRequests.list`,
    following `next_cursor` until the last page or `max-items` (default
    1000). `request` sets the filters; its `cursor` is the starting point.

    **Example**

    ```hot
    ::invites ::slack::admin::invite-requests

    pending ::invites/list-all(::invites/ListRequest({team_id: "T0123ABCDEF"}), 500)
    length(pending)
    ```
    """
}
fn
(): Vec {
  list-all(ListRequest({}), 1000)
},
(request: ListRequest): Vec {
  list-all(request, 1000)
},
(request: ListRequest, max-items: Int): Vec {
  list-all(request, max-items, {})
},
(request: ListRequest, max-items: Int, opts: Map): Vec {
  ::api/paginate("admin.inviteRequests.list", request, "invite_requests", max-items, opts)
}

