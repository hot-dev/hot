::pinecone ns
meta {
    doc: """
    Pinecone vector database bindings: serverless index management,
    vector upsert/query/fetch/update/list/delete with namespaces,
    integrated-embedding records, and hosted inference (embed and
    rerank). Pair with an embeddings source (`::pinecone::inference`,
    `openai`, `openai-compatible`) for the vectors.

    **Setup**: context variable `pinecone.api.key`. Optionally
    `pinecone.api.version` to pin a different API version than
    `API_VERSION`. Both can also come per call, in the trailing `opts` Map
    of any API-calling function (see `::pinecone::api`).

    **Quick start**

    ```hot
    ::indexes ::pinecone::indexes
    ::vectors ::pinecone::vectors

    // Once, at setup: a new index takes a few seconds to be ready
    ::indexes/create-index("docs", 3, {metric: "cosine"})

    // Later: check it is ready, then write and query
    index ::indexes/describe-index("docs")
    ::vectors/upsert(index.host, [
      {id: "doc-1", values: [0.1, 0.2, 0.3], metadata: {source: "guide.md"}}
    ], "guides")

    hits ::vectors/query(index.host, {
      vector: [0.1, 0.2, 0.3],
      topK: 5,
      namespace: "guides",
      includeMetadata: true,
      filter: {source: {"$eq": "guide.md"}}
    })
    map(hits.matches, (m) { m.metadata.source })
    ```

    Data-plane calls (`::pinecone::vectors`, `::pinecone::namespaces`,
    `::pinecone::records`) take the index `host` from `describe-index`;
    control-plane and inference calls go to api.pinecone.io. Non-2xx
    responses are an Err carrying `::pinecone::api/HttpError`.
    """
}

CONTROL_URL "https://api.pinecone.io"

// Latest stable Pinecone API version as of November 2026. Each stable
// version is supported for at least 12 months after release; override
// per deployment with the `pinecone.api.version` context variable.
API_VERSION "2026-07"

// The namespace Pinecone uses when none is given.
DEFAULT_NAMESPACE "__default__"
