::ai::test::tool ns
meta ["test"]

::tool ::ai::tool
Failure ::hot::run/Failure
Cancellation ::hot::run/Cancellation

// ---------------------------------------------------------------------------
// Fixture functions used as tools
// ---------------------------------------------------------------------------

add-fn
meta {doc: "Add two integers and return the sum."}
fn (x: Int, y: Int): Int {
    add(x, y)
}

greet-fn
meta {doc: "Build a greeting for `name`."}
fn (name: Str): Str {
    `Hello, ${name}!`
}

untyped-input-fn
meta {doc: "Echo back the entire input map (back-compat path)."}
fn (input: Map): Map {
    input
}

aliased-fn
meta {
    doc: "Original docstring (should lose to tool.description).",
    tool: {name: "alias_name", description: "Tool-meta description."}
}
fn (q: Str): Str {
    q
}

// ---------------------------------------------------------------------------
// schema-from-fn
// ---------------------------------------------------------------------------

test-schema-from-fn-shape
meta ["test"]
fn () {
    schema ::tool/schema-from-fn(add-fn)
    assert-eq("::ai::test::tool/add-fn", schema.name)
    assert-eq("Add two integers and return the sum.", schema.description)
    assert-eq("object", schema.input-schema.type)
    props schema.input-schema.properties
    assert(is-some(get(props, "x")), "x property present")
    assert(is-some(get(props, "y")), "y property present")
}

// ---------------------------------------------------------------------------
// from-fn
// ---------------------------------------------------------------------------

test-from-fn-defaults
meta ["test"]
fn () {
    t ::tool/from-fn(add-fn)
    assert(is-type(t, ::tool/Tool), "from-fn returns a Tool")
    assert-eq("::ai::test::tool/add-fn", t.name)
    assert-eq("Add two integers and return the sum.", t.description)
    assert-eq("object", t.input-schema.type)
}

test-from-fn-overrides
meta ["test"]
fn () {
    t ::tool/from-fn(add-fn, {name: "add", description: "Sum two ints."})
    assert-eq("add", t.name)
    assert-eq("Sum two ints.", t.description)
}

test-from-fn-uses-tool-meta-display-name
meta ["test"]
fn () {
    t ::tool/from-fn(aliased-fn)
    assert-eq("alias_name", t.name)
    assert-eq("Tool-meta description.", t.description)
}

test-dispatch-via-tool-meta-name
meta ["test"]
fn () {
    tools ::tool/for-agent([aliased-fn])
    call ::tool/ToolCall({
        id: "call-alias",
        name: "alias_name",
        input: {q: "ping"}
    })
    result ::tool/dispatch(tools, call)
    assert-eq(false, result.is-error)
    assert-eq("ping", result.output)
}

test-for-agent-mixed
meta ["test"]
fn () {
    custom ::tool/Tool({
        name: "echo",
        description: null,
        input-schema: {type: "object", properties: {}},
        output-schema: null,
        fn: untyped-input-fn
    })
    tools ::tool/for-agent([add-fn, custom])
    assert-eq(2, length(tools))
    assert-eq("::ai::test::tool/add-fn", tools[0].name)
    assert-eq("echo", tools[1].name)
}

test-provider-name-preserves-valid-names-and-aliases-qualified-names
meta ["test"]
fn () {
    assert-eq("get_weather-2", ::tool/provider-name("get_weather-2"))

    alias ::tool/provider-name("github/list-workflow-runs")
    assert(lte(length(alias), ::tool/PROVIDER_NAME_LIMIT))
    assert(::hot::regex/is-match(alias, "^[a-zA-Z0-9_-]+$"))
    assert(not(eq(alias, "github/list-workflow-runs")))
    assert-eq(alias, ::tool/provider-name("github/list-workflow-runs"))
    assert(not(eq(alias, ::tool/provider-name("github:list-workflow-runs"))))
}

// ---------------------------------------------------------------------------
// dispatch
// ---------------------------------------------------------------------------

test-dispatch-positional
meta ["test"]
fn () {
    tools ::tool/for-agent([add-fn])
    call ::tool/ToolCall({
        id: "call-1",
        name: "::ai::test::tool/add-fn",
        input: {x: 2, y: 5}
    })
    result ::tool/dispatch(tools, call)
    assert-eq("call-1", result.id)
    assert-eq(7, result.output)
    assert-eq(false, result.is-error)
}

test-dispatch-string-arg
meta ["test"]
fn () {
    tools ::tool/for-agent([greet-fn])
    call ::tool/ToolCall({
        id: "call-2",
        name: "::ai::test::tool/greet-fn",
        input: {name: "Alice"}
    })
    result ::tool/dispatch(tools, call)
    assert-eq("Hello, Alice!", result.output)
}

test-dispatch-provider-safe-alias
meta ["test"]
fn () {
    tools ::tool/for-agent([add-fn])
    call ::tool/ToolCall({
        id: "call-provider",
        name: ::tool/provider-name(tools[0].name),
        input: {x: 4, y: 6}
    })
    result ::tool/dispatch(tools, call)
    assert-eq(false, result.is-error)
    assert-eq(10, result.output)
}

test-dispatch-unknown-tool
meta ["test"]
fn () {
    tools ::tool/for-agent([add-fn])
    call ::tool/ToolCall({
        id: "call-3",
        name: "missing",
        input: {}
    })
    result ::tool/dispatch(tools, call)
    assert-eq(true, result.is-error)
}

test-dispatch-named-map-arg
meta ["test"]
fn () {
    // The function declares its parameter as `input: Map`, so the
    // ToolCall must address it by that name. This mirrors how an LLM
    // sees the auto-generated input-schema.
    tools ::tool/for-agent([untyped-input-fn])
    call ::tool/ToolCall({
        id: "call-4",
        name: "::ai::test::tool/untyped-input-fn",
        input: {input: {a: 1, b: 2}}
    })
    result ::tool/dispatch(tools, call)
    assert-eq(false, result.is-error)
    assert-eq({a: 1, b: 2}, result.output)
}

// ---------------------------------------------------------------------------
// dispatch: what the model sees for a failed call
// ---------------------------------------------------------------------------

fails-with-msg
meta {doc: "Fails with a message."}
fn (input: Str): Str {
    fail(`rejected '${input}'`)
}

fails-with-data
meta {doc: "Fails with a message and data."}
fn (input: Str): Str {
    fail("bad input", {field: "input", value: input})
}

returns-err
meta {doc: "Returns an Err value."}
fn (input: Str): Str {
    err({code: "nope", input: input})
}

divides-by-zero
meta {doc: "Raises a runtime error."}
fn (input: Str): Int {
    div(1, sub(length(input), length(input)))
}

dispatch-one fn (f: Fn, name: Str): ::tool/ToolResult {
    tools [::tool/from-fn(f, {name: name})]
    ::tool/dispatch(tools, ::tool/ToolCall({id: "c1", name: name, input: {input: "x"}}))
}

test-dispatch-fail-message-reaches-the-model
meta ["test"]
fn () {
    result dispatch-one(fails-with-msg, "msg")
    assert(result.is-error)
    assert-eq("rejected 'x'", result.output)
    assert-eq("rejected 'x'", ::ai::chat/tool-result-message(result).content)
}

test-dispatch-fail-with-data-keeps-both
meta ["test"]
fn () {
    result dispatch-one(fails-with-data, "data")
    assert(result.is-error)
    assert-eq({message: "bad input", data: {field: "input", value: "x"}}, result.output)
}

test-dispatch-returned-err-stays-as-is
meta ["test"]
fn () {
    result dispatch-one(returns-err, "returns")
    assert(result.is-error)
    assert-eq({code: "nope", input: "x"}, result.output)
}

test-dispatch-runtime-error-is-a-message
meta ["test"]
fn () {
    result dispatch-one(divides-by-zero, "divide")
    assert(result.is-error)
    assert(is-str(result.output), `a message, got ${to-json(result.output)}`)
    assert(not(is-empty(result.output)), "not empty")
}

test-failure-output-shapes
meta ["test"]
fn () {
    assert-eq("m", ::tool/failure-output(Failure({msg: "m", err: "m"}), "t"))
    assert-eq("m", ::tool/failure-output(Failure({msg: "m", err: null}), "t"))
    assert-eq("m", ::tool/failure-output(Failure({msg: "m", err: {error: "m"}}), "t"))
    assert-eq({message: "m", data: [1]}, ::tool/failure-output(Failure({msg: "m", err: [1]}), "t"))
    assert-eq("m", ::tool/failure-output(Cancellation({msg: "m", data: null}), "t"))
    assert-eq("plain", ::tool/failure-output("plain", "t"))
    assert-eq("Tool t failed.", ::tool/failure-output(null, "t"))
}

test-failure-output-keeps-an-err-map-whole
meta ["test"]
fn () {
    // An Err Map the tool returned isn't a Failure: every field reaches the
    // model, whatever its keys.
    rate {msg: "rate limited", retry_after: 30, code: 429}
    assert-eq(rate, ::tool/failure-output(rate, "t"))
    shaped {msg: "failed", err: "timeout"}
    assert-eq(shaped, ::tool/failure-output(shaped, "t"))
    with-err {msg: "failed", err: "timeout", retry_after: 5}
    assert-eq(with-err, ::tool/failure-output(with-err, "t"))
    assert-eq({msg: 5}, ::tool/failure-output({msg: 5}, "t"))
    // A halt's detail is dropped only when it is just `{error: msg}`.
    assert-eq({message: "bad", data: {error: "bad", field: "x"}}, ::tool/failure-output(Failure({msg: "bad", err: {error: "bad", field: "x"}}), "t"))
}

take-two fn (a: Str, b: Str): Str { a }

call-with-one fn (f: Fn, a: Str): Str { f(a) }

test-failure-output-of-an-error-the-call-stopped-on
meta ["test"]
fn () {
    // Not a fail(): the contained call's own error, typed as a Failure.
    contained ::hot::internal::exec/contain(call-with-one, [take-two, "x"])
    assert(is-err(contained))
    assert(is-type(err-value(contained), Failure))
    out ::tool/failure-output(err-value(contained), "t")
    assert(is-str(out), `a message, got ${to-json(out)}`)
    assert(contains(out, "expects 2 arguments"), out)
}

returns-rate-limited
meta {doc: "Test fixture: a tool that returns an Err Map."}
fn (input: Str): Any { err({msg: "rate limited", retry_after: 30}) }

fails-with-detail
meta {doc: "Test fixture: a tool that fails with data beside the message."}
fn (input: Str): Str { fail("bad", {error: "bad", field: "x"}) }

cancels
meta {doc: "Test fixture: a tool that cancels."}
fn (input: Str): Str { cancel("stopped by user") }

cancels-with-data
meta {doc: "Test fixture: a tool that cancels with data."}
fn (input: Str): Str { cancel("stopped", {why: "quota"}) }

test-dispatch-cancel-sends-its-message
meta ["test"]
fn () {
    plain dispatch-one(cancels, "cancel")
    assert(plain.is-error)
    assert-eq("stopped by user", plain.output)
    with-data dispatch-one(cancels-with-data, "cancel-data")
    assert-eq({message: "stopped", data: {why: "quota"}}, with-data.output)
    // A returned Err Map shaped like a Cancellation is still the tool's own.
    assert-eq({msg: "m", data: 1}, ::tool/failure-output({msg: "m", data: 1}, "t"))
}

test-dispatch-keeps-a-returned-err-map-and-fail-data
meta ["test"]
fn () {
    rate dispatch-one(returns-rate-limited, "rate")
    assert(rate.is-error)
    assert-eq({msg: "rate limited", retry_after: 30}, rate.output)
    failed dispatch-one(fails-with-detail, "detail")
    assert(failed.is-error)
    assert-eq({message: "bad", data: {error: "bad", field: "x"}}, failed.output)
}
