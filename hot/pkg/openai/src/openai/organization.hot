list-all-organization-and-project-api-keys
meta {
    doc: """
    GET /organization/admin_api_keys - List all organization and project API
    keys.

    **Example**

    ```hot
    admin {api-key: ::hot::ctx/get("openai.admin.key")}
    page ::openai::organization/list-all-organization-and-project-api-keys({
      limit: "20",
      order: "desc"
    }, admin)
    map(page.data, %.name)
    ```
    """
}
fn
(request: AdminApiKeysListRequest): AdminApiKeysListResponse {
  list-all-organization-and-project-api-keys(request, {})
},
(request: AdminApiKeysListRequest, opts: Map): AdminApiKeysListResponse {
  response api-request("GET", ::openai::api/with-query(`/organization/admin_api_keys`, {after: request.after, order: request.order, limit: request.limit}), {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { AdminApiKeysListResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

