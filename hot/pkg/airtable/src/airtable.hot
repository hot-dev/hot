::airtable ns
meta {
    doc: """
    Airtable bindings — the lightweight database half the world runs ops
    on. Records CRUD with formula filtering, batch upsert/delete, record
    comments, plus the metadata API for base schemas and token identity.

    **Setup** — context variable `airtable.token`: a personal access
    token (`pat...`) with the scopes and bases it needs. Every API function
    also takes a trailing `opts` Map, so one run can use several tokens:
    `{token: "pat..."}` replaces the context token for that call.

    **Quick start**

    ```hot
    ::at ::airtable

    base-id "appXyz123"

    rows ::at/list-records(base-id, "Leads", {
      filterByFormula: "AND({Status} = 'New', {Score} > 50)",
      maxRecords: 20
    })

    ::at/create-records(base-id, "Leads", [
      {fields: {Name: "Ada Lovelace", Status: "New", Score: 99}}
    ])
    ```
    """
}

::ctx ::hot::ctx
::uri ::hot::uri

BASE_URL "https://api.airtable.com/v0"

request
meta {
    ctx: {"airtable.token": {required: false}},
    doc: """
    The authenticated request behind every function: `opts` (`{token}`),
    then the `airtable.token` context variable. With no token from either
    place, it returns an Err (see `::airtable::api/resolve`).

    **Example**

    ```hot
    ::airtable/request("GET", "/meta/whoami", "")

    // Per-call token
    tenant ::airtable/request("GET", "/meta/bases", "", {token: ::hot::ctx/get("tenant.airtable.token")})
    tenant.bases
    ```
    """
}
fn
(method: Str, path: Str, body: Any): Any {
  request(method, path, body, {})
},
// 4-arity: per-call opts ({token}), then ctx
(method: Str, path: Str, body: Any, opts: Map): Any {
  resolved ::airtable::api/resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { request(method, path, body, resolved.token) }
  }
},
// 4-arity: explicit token override
(method: Str, path: Str, body: Any, token: Str): Any {
  ::ctx/mark-secret(token)
  headers cond {
    eq(body, "") => { {Authorization: `Bearer ${token}`} }
    => { {Authorization: `Bearer ${token}`, Content-Type: "application/json"} }
  }

  encoded if(eq(body, ""), "", to-json(untype(body)))
  response ::hot::http/request(::hot::http/HttpRequest({
    method,
    url: `${BASE_URL}${path}`,
    headers: headers,
    body: encoded
  }))
  cond {
    is-err(response) => { response }
    ::hot::http/is-ok-response(response) => { response.body }
    => { err({status: response.status, body: response.body}) }
  }
}

table-path
meta {no-doc: true}
fn (base-id: Str, table: Str): Str {
  `/${base-id}/${::uri/encode(table)}`
}

escape-formula-value
meta {
    doc: """
    Escape a value for interpolation into an Airtable formula as a
    single-quoted string literal (backslashes and quotes escaped, quotes
    included). **Always use this when building `filterByFormula` from
    user or agent input** — unescaped interpolation lets crafted input
    rewrite the formula.

    **Example**

    ```hot
    ::airtable/escape-formula-value("O'Brien")  // "'O\\'Brien'"

    // Pass this as `filterByFormula` to `list-records`
    `{Last Name} = ${::airtable/escape-formula-value("O'Brien")}`  // "{Last Name} = 'O\\'Brien'"
    ```
    """
}
fn (value: Str): Str {
  no-backslash join(split(value, "\\"), "\\\\")
  escaped join(split(no-backslash, "'"), "\\'")
  `'${escaped}'`
}

list-records
meta {
    ctx: {"airtable.token": {required: false}},
    doc: """
    GET /{base}/{table} - List records. `params`: `filterByFormula`
    (Airtable formula), `maxRecords`, `view`, `sort` handled by formula,
    `offset` (paging cursor from the previous page). Returns
    `{records, offset?}`. To pass `opts` without filters, use `{}` for
    `params`.

    **Example**

    ```hot
    page ::airtable/list-records(::airtable::apiASE, "Leads", {
      filterByFormula: "{Status} = 'New'",
      maxRecords: 20
    })
    map(page.records, %.fields.Name)

    // The next page, with a per-call token
    ::airtable/list-records(::airtable::apiASE, "Leads", {offset: page.offset}, {token: ::hot::ctx/get("tenant.airtable.token")})
    ```
    """
}
fn
(base-id: Str, table: Str): Map {
  request("GET", table-path(base-id, table), "")
},
(base-id: Str, table: Str, params: Map): Map {
  request("GET", `${table-path(base-id, table)}${::uri/query-string(params)}`, "")
},
(base-id: Str, table: Str, params: Map, opts: Map): Map {
  request("GET", `${table-path(base-id, table)}${::uri/query-string(params)}`, "", opts)
}

get-record
meta {
    doc: """
    GET /{base}/{table}/{id} - One record (`{id, createdTime, fields}`).

    **Example**

    ```hot
    record ::airtable/get-record(::airtable::apiASE, "Leads", "recAbc123")
    record.fields.Status
    ```
    """
}
fn
(base-id: Str, table: Str, record-id: Str): Map {
  get-record(base-id, table, record-id, {})
},
(base-id: Str, table: Str, record-id: Str, opts: Map): Map {
  request("GET", `${table-path(base-id, table)}/${record-id}`, "", opts)
}

create-records
meta {
    doc: """
    POST /{base}/{table} - Create up to 10 records: `[{fields: {...}}]`.
    `typecast` is enabled so string inputs coerce to the field types.

    **Example**

    ```hot
    created ::airtable/create-records(::airtable::apiASE, "Leads", [
      {fields: {Name: "Ada Lovelace", Status: "New", Score: 99}}
    ])
    first(created.records).id
    ```
    """
}
fn
(base-id: Str, table: Str, records: Vec): Map {
  create-records(base-id, table, records, {})
},
(base-id: Str, table: Str, records: Vec, opts: Map): Map {
  request("POST", table-path(base-id, table), {records: records, typecast: true}, opts)
}

update-records
meta {
    doc: """
    PATCH /{base}/{table} - Update up to 10 records: `[{id, fields}]` (only
    the given fields change).

    **Example**

    ```hot
    ::airtable/update-records(::airtable::apiASE, "Leads", [
      {id: "recAbc123", fields: {Status: "Qualified"}}
    ])
    ```
    """
}
fn
(base-id: Str, table: Str, records: Vec): Map {
  update-records(base-id, table, records, {})
},
(base-id: Str, table: Str, records: Vec, opts: Map): Map {
  request("PATCH", table-path(base-id, table), {records: records, typecast: true}, opts)
}

delete-record
meta {
    doc: """
    DELETE /{base}/{table}/{id} - Delete one record.

    **Example**

    ```hot
    ::airtable/delete-record(::airtable::apiASE, "Leads", "recAbc123")
    ```
    """
}
fn
(base-id: Str, table: Str, record-id: Str): Map {
  delete-record(base-id, table, record-id, {})
},
(base-id: Str, table: Str, record-id: Str, opts: Map): Map {
  request("DELETE", `${table-path(base-id, table)}/${record-id}`, "", opts)
}

upsert-records
meta {
    doc: """
    PATCH /{base}/{table} with performUpsert - Create-or-update up to 10
    records keyed on `merge-fields` (field names that uniquely identify a
    record). Records are `[{fields: {...}}]` — no ids. Returns
    `{records, createdRecords, updatedRecords}`.

    **Example**

    ```hot
    ::airtable/upsert-records("appXyz123", "Leads", ["Email"], [
      {fields: {Email: "ada@example.com", Status: "Customer"}}
    ])
    ```
    """
}
fn
(base-id: Str, table: Str, merge-fields: Vec, records: Vec): Map {
  upsert-records(base-id, table, merge-fields, records, {})
},
(base-id: Str, table: Str, merge-fields: Vec, records: Vec, opts: Map): Map {
  request("PATCH", table-path(base-id, table), {
    performUpsert: {fieldsToMergeOn: merge-fields},
    records: records,
    typecast: true
  }, opts)
}

records-query
meta {
    doc: """
    Build the repeated `records[]=` query string batch deletion needs
    (query-string can't express repeated keys). Exposed for testing;
    `delete-records` uses it.

    **Example**

    ```hot
    ::airtable/records-query(["recAbc123", "recDef456"])  // "?records[]=recAbc123&records[]=recDef456"
    ```
    """
}
fn (record-ids: Vec): Str {
  parts map(record-ids, (id) { `records[]=${::uri/encode(id)}` })
  `?${join(parts, "&")}`
}

delete-records
meta {
    doc: """
    DELETE /{base}/{table}?records[]= - Delete up to 10 records in one call.
    Returns `{records: [{id, deleted}]}`.

    **Example**

    ```hot
    out ::airtable/delete-records(::airtable::apiASE, "Leads", ["recAbc123", "recDef456"])
    map(out.records, %.deleted)
    ```
    """
}
fn
(base-id: Str, table: Str, record-ids: Vec): Map {
  delete-records(base-id, table, record-ids, {})
},
(base-id: Str, table: Str, record-ids: Vec, opts: Map): Map {
  request("DELETE", `${table-path(base-id, table)}${records-query(record-ids)}`, "", opts)
}

// ---------------------------------------------------------------------------
// Record comments (require the data.recordComments scopes)
// ---------------------------------------------------------------------------

comments-path
meta {no-doc: true}
fn (base-id: Str, table: Str, record-id: Str): Str {
  `${table-path(base-id, table)}/${record-id}/comments`
}

list-comments
meta {
    doc: """
    GET /{base}/{table}/{record}/comments - A record's comments (`{comments,
    offset?}`). `params` (4-arity): `pageSize` (max 100), `offset`.

    **Example**

    ```hot
    page ::airtable/list-comments(::airtable::apiASE, "Leads", "recAbc123", {pageSize: 50})
    map(page.comments, %.text)
    ```
    """
}
fn
(base-id: Str, table: Str, record-id: Str): Map {
  request("GET", comments-path(base-id, table, record-id), "")
},
(base-id: Str, table: Str, record-id: Str, params: Map): Map {
  request("GET", `${comments-path(base-id, table, record-id)}${::uri/query-string(params)}`, "")
},
(base-id: Str, table: Str, record-id: Str, params: Map, opts: Map): Map {
  request("GET", `${comments-path(base-id, table, record-id)}${::uri/query-string(params)}`, "", opts)
}

create-comment
meta {
    doc: """
    POST /{base}/{table}/{record}/comments - Comment on a record.
    `@[userId]` mentions work inside `text`.

    **Example**

    ```hot
    comment ::airtable/create-comment(::airtable::apiASE, "Leads", "recAbc123", "Called and left a voicemail.")
    comment.id
    ```
    """
}
fn
(base-id: Str, table: Str, record-id: Str, text: Str): Map {
  create-comment(base-id, table, record-id, text, {})
},
(base-id: Str, table: Str, record-id: Str, text: Str, opts: Map): Map {
  request("POST", comments-path(base-id, table, record-id), {text: text}, opts)
}

update-comment
meta {
    doc: """
    PATCH /{base}/{table}/{record}/comments/{comment} - Edit a comment's
    text (author-owned comments only).

    **Example**

    ```hot
    ::airtable/update-comment(::airtable::apiASE, "Leads", "recAbc123", "comAbc123", "Called and booked a demo.")
    ```
    """
}
fn
(base-id: Str, table: Str, record-id: Str, comment-id: Str, text: Str): Map {
  update-comment(base-id, table, record-id, comment-id, text, {})
},
(base-id: Str, table: Str, record-id: Str, comment-id: Str, text: Str, opts: Map): Map {
  request("PATCH", `${comments-path(base-id, table, record-id)}/${comment-id}`, {text: text}, opts)
}

delete-comment
meta {
    doc: """
    DELETE /{base}/{table}/{record}/comments/{comment} - Delete a comment
    (author-owned comments only).

    **Example**

    ```hot
    ::airtable/delete-comment(::airtable::apiASE, "Leads", "recAbc123", "comAbc123")
    ```
    """
}
fn
(base-id: Str, table: Str, record-id: Str, comment-id: Str): Map {
  delete-comment(base-id, table, record-id, comment-id, {})
},
(base-id: Str, table: Str, record-id: Str, comment-id: Str, opts: Map): Map {
  request("DELETE", `${comments-path(base-id, table, record-id)}/${comment-id}`, "", opts)
}

// ---------------------------------------------------------------------------
// Metadata
// ---------------------------------------------------------------------------

whoami
meta {
    doc: """
    GET /meta/whoami - The token's own user id and granted scopes. The
    cheapest way to smoke-test a token.

    **Example**

    ```hot
    me ::airtable/whoami()
    me.scopes
    ```
    """
}
fn
(): Map {
  whoami({})
},
(opts: Map): Map {
  request("GET", "/meta/whoami", "", opts)
}

list-bases
meta {
    doc: """
    GET /meta/bases - The bases the token can access.

    **Example**

    ```hot
    out ::airtable/list-bases()
    map(out.bases, %.name)
    ```
    """
}
fn
(): Map {
  list-bases({})
},
(opts: Map): Map {
  request("GET", "/meta/bases", "", opts)
}

get-base-schema
meta {
    doc: """
    GET /meta/bases/{base}/tables - The base's tables, fields, and views —
    what an agent reads before writing records.

    **Example**

    ```hot
    schema ::airtable/get-base-schema(::airtable::apiASE)
    map(schema.tables, %.name)
    ```
    """
}
fn
(base-id: Str): Map {
  get-base-schema(base-id, {})
},
(base-id: Str, opts: Map): Map {
  request("GET", `/meta/bases/${base-id}/tables`, "", opts)
}
