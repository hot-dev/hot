::twilio::accounts ns

::uri ::hot::uri

api-request ::twilio::api/request
account-url ::twilio::api/account-url
resolve ::twilio::api/resolve
Client ::twilio::api/Client
HttpError ::twilio::api/HttpError
is-ok-response ::hot::http/is-ok-response

// ============================================================================
// Account
// ============================================================================

Account type {
  sid: Str?,
  friendly_name: Str?,
  status: Str?,
  type: Str?,
  date_created: Str?,
  date_updated: Str?,
  auth_token: Str?,
  uri: Str?,
  owner_account_sid: Str?,
  subresource_uris: Map?
}

mark-auth-token
meta {
    doc: """Mask the `auth_token` of an account response in call records. Returns `body` unchanged. Exposed for testing."""
}
fn (body: Map): Map {
  if(is-str(get(body, "auth_token")), ::hot::ctx/mark-secret(body.auth_token))
  body
}

get-account
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
GET /Accounts/{AccountSid}.json - Get the account's details: SID, friendly name, status, type, and subresource URIs. A cheap credentials check.

**Example**

```hot
::accounts ::twilio::accounts

response ::accounts/get-account()
response.sid            // => "AC..."
response.friendly_name  // => "My Twilio Account"
response.status         // => "active"
response.type           // => "Full"
```
"""
}
fn
(): Account {
  get-account({})
},
(opts: Map): Account {
  resolve(opts) |> if-ok((client) { get-account(client) })
},
(client: Client): Account {
  response api-request(client, "GET", `${account-url(client)}.json`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { Account(mark-auth-token(response.body)) }
    => { err(HttpError(response)) }
  }
}

UpdateAccountRequest type {
  FriendlyName: Str?,
  Status: Str?
}

update-account
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """POST /Accounts/{AccountSid}.json - Update account settings. Can change the `FriendlyName`, or set `Status` to "active", "suspended", or "closed" (subaccounts; closing is permanent)."""
}
fn
(request: UpdateAccountRequest): Account {
  update-account(request, {})
},
(request: UpdateAccountRequest, opts: Map): Account {
  resolve(opts) |> if-ok((client) { update-account(client, request) })
},
(client: Client, request: UpdateAccountRequest): Account {
  response api-request(client, "POST", `${account-url(client)}.json`, {}, filter-vals(untype(request), is-some))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { Account(mark-auth-token(response.body)) }
    => { err(HttpError(response)) }
  }
}

// ============================================================================
// Incoming Phone Numbers
// ============================================================================

GetIncomingPhoneNumbersRequest type {
  PhoneNumber: Str?,
  FriendlyName: Str?,
  Beta: Bool?,
  Origin: Str?,
  PageSize: Int?,
  Page: Int?,
  PageToken: Str?
}

GetIncomingPhoneNumbersResponse type {
  incoming_phone_numbers: Vec<Map>?,
  end: Int?,
  first_page_uri: Str?,
  next_page_uri: Str?,
  page: Int?,
  page_size: Int?,
  previous_page_uri: Str?,
  start: Int?,
  uri: Str?
}

get-incoming-phone-numbers
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
GET /Accounts/{AccountSid}/IncomingPhoneNumbers.json - List your Twilio phone numbers. Filter by `PhoneNumber` (matches any part), `FriendlyName`, or `Origin` (`twilio` or `hosted`).

**Example**

```hot
::accounts ::twilio::accounts

response ::accounts/get-incoming-phone-numbers(::accounts/GetIncomingPhoneNumbersRequest({}))
numbers response.incoming_phone_numbers
// => [{sid: "PN...", phone_number: "+15017122661", friendly_name: "My Number", ...}]
```
"""
}
fn
(request: GetIncomingPhoneNumbersRequest): GetIncomingPhoneNumbersResponse {
  get-incoming-phone-numbers(request, {})
},
(request: GetIncomingPhoneNumbersRequest, opts: Map): GetIncomingPhoneNumbersResponse {
  resolve(opts) |> if-ok((client) { get-incoming-phone-numbers(client, request) })
},
(client: Client, request: GetIncomingPhoneNumbersRequest): GetIncomingPhoneNumbersResponse {
  query ::twilio::api/query-string(untype(request))
  response api-request(client, "GET", `${account-url(client)}/IncomingPhoneNumbers.json${query}`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { GetIncomingPhoneNumbersResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

GetIncomingPhoneNumberRequest type {
  sid: Str
}

IncomingPhoneNumber type {
  sid: Str?,
  account_sid: Str?,
  phone_number: Str?,
  friendly_name: Str?,
  capabilities: Map?,
  status: Str?,
  origin: Str?,
  voice_url: Str?,
  voice_method: Str?,
  voice_fallback_url: Str?,
  voice_application_sid: Str?,
  sms_url: Str?,
  sms_method: Str?,
  sms_fallback_url: Str?,
  sms_application_sid: Str?,
  status_callback: Str?,
  date_created: Str?,
  date_updated: Str?,
  uri: Str?
}

get-incoming-phone-number
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """GET /Accounts/{AccountSid}/IncomingPhoneNumbers/{Sid}.json - Get details of a specific phone number by SID."""
}
fn
(request: GetIncomingPhoneNumberRequest): IncomingPhoneNumber {
  get-incoming-phone-number(request, {})
},
(request: GetIncomingPhoneNumberRequest, opts: Map): IncomingPhoneNumber {
  resolve(opts) |> if-ok((client) { get-incoming-phone-number(client, request) })
},
(client: Client, request: GetIncomingPhoneNumberRequest): IncomingPhoneNumber {
  response api-request(client, "GET", `${account-url(client)}/IncomingPhoneNumbers/${::uri/encode(request.sid)}.json`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { IncomingPhoneNumber(response.body) }
    => { err(HttpError(response)) }
  }
}

UpdateIncomingPhoneNumberRequest type {
  sid: Str,
  FriendlyName: Str?,
  SmsUrl: Str?,
  SmsMethod: Str?,
  SmsFallbackUrl: Str?,
  SmsFallbackMethod: Str?,
  SmsApplicationSid: Str?,
  VoiceUrl: Str?,
  VoiceMethod: Str?,
  VoiceFallbackUrl: Str?,
  VoiceFallbackMethod: Str?,
  VoiceApplicationSid: Str?,
  VoiceCallerIdLookup: Bool?,
  VoiceReceiveMode: Str?,
  StatusCallback: Str?,
  StatusCallbackMethod: Str?
}

update-incoming-phone-number-body
meta {
    doc: """The form parameters `update-incoming-phone-number` sends (the request without its path `sid`). Exposed for testing."""
}
fn (request: UpdateIncomingPhoneNumberRequest): Map {
  filter-vals(delete(untype(request), "sid"), is-some)
}

update-incoming-phone-number
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
POST /Accounts/{AccountSid}/IncomingPhoneNumbers/{Sid}.json - Update a phone number's settings: point its voice/SMS webhooks at your Hot endpoints, or at a TwiML App.

**Example**

```hot
::accounts ::twilio::accounts

::accounts/update-incoming-phone-number(::accounts/UpdateIncomingPhoneNumberRequest({
  sid: "PN123",
  SmsUrl: "https://myapp.hot.dev/twilio/sms",
  VoiceUrl: "https://myapp.hot.dev/twilio/voice"
}))
```
"""
}
fn
(request: UpdateIncomingPhoneNumberRequest): IncomingPhoneNumber {
  update-incoming-phone-number(request, {})
},
(request: UpdateIncomingPhoneNumberRequest, opts: Map): IncomingPhoneNumber {
  resolve(opts) |> if-ok((client) { update-incoming-phone-number(client, request) })
},
(client: Client, request: UpdateIncomingPhoneNumberRequest): IncomingPhoneNumber {
  response api-request(client, "POST", `${account-url(client)}/IncomingPhoneNumbers/${::uri/encode(request.sid)}.json`, {}, update-incoming-phone-number-body(request))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { IncomingPhoneNumber(response.body) }
    => { err(HttpError(response)) }
  }
}

DeleteIncomingPhoneNumberRequest type {
  sid: Str
}

delete-incoming-phone-number
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """DELETE /Accounts/{AccountSid}/IncomingPhoneNumbers/{Sid}.json - Release a phone number. The number is returned to Twilio's inventory and will no longer incur charges. This cannot be undone."""
}
fn
(request: DeleteIncomingPhoneNumberRequest): Bool {
  delete-incoming-phone-number(request, {})
},
(request: DeleteIncomingPhoneNumberRequest, opts: Map): Bool {
  resolve(opts) |> if-ok((client) { delete-incoming-phone-number(client, request) })
},
(client: Client, request: DeleteIncomingPhoneNumberRequest): Bool {
  ::twilio::api/delete-request(client, `${account-url(client)}/IncomingPhoneNumbers/${::uri/encode(request.sid)}.json`)
}
