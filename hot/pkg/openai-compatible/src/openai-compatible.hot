    doc: "Cerebras inference. `n` must be 1; non-standard fields (`disable_reasoning`, ...) go in `extra-body`."
}

Preset({
    name: "Cerebras",
    base-url: "https://api.cerebras.ai/v1",
    model-prefix: "cerebras/",
    key-ctx: "cerebras.api.key",
    key-env: "CEREBRAS_API_KEY",
    max-tokens-param: "max_completion_tokens",
