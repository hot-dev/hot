// ============================================================================
// Application commands
// ============================================================================
// Global commands are available everywhere the app is installed; guild
// commands appear only in that guild and update instantly. `type`:
// 1 CHAT_INPUT (slash), 2 USER and 3 MESSAGE (context menus), 4 PRIMARY_ENTRY_POINT.
// `contexts` (0 guild, 1 bot DM, 2 private channel) and
// `integration_types` (0 guild install, 1 user install) replace the
// deprecated `dm_permission`.

global-commands-path fn (application-id: Str): Str {
  `/applications/${seg(application-id)}/commands`
}

guild-commands-path fn (application-id: Str, guild-id: Str): Str {
  `/applications/${seg(application-id)}/guilds/${seg(guild-id)}/commands`
}

GetGlobalCommandsRequest type {
  application_id: Str,
  with_localizations: Bool?
}

get-global-commands
meta {
    doc: """GET /applications/{application_id}/commands - Every global command."""
}
fn
(request: GetGlobalCommandsRequest): Vec<Map> {
  get-global-commands(request, {})
},
(request: GetGlobalCommandsRequest, opts: Map): Vec<Map> {
  ::api/call("GET", global-commands-path(request.application_id), {query: {with_localizations: request.with_localizations}}, opts)
}

CreateGlobalCommandRequest type {
  application_id: Str,
  name: Str,
  name_localizations: Map?,
  description: Str?,
  description_localizations: Map?,
  options: Vec<Map>?,
  default_member_permissions: Str?,
  dm_permission: Bool?,
  integration_types: Vec<Int>?,
  contexts: Vec<Int>?,
  type: Int?,
  nsfw: Bool?,
  handler: Int?
}

create-global-command
meta {
    doc: """
    POST /applications/{application_id}/commands - Create (or overwrite by
    name) a global command. Returns 201 for new, 200 for an update. A
    CHAT_INPUT command needs a `description`.

    **Example**

    ```hot
    ::interactions ::discord::interactions

    ::interactions/create-global-command(::interactions/CreateGlobalCommandRequest({
      application_id: "1800000000000000000",
      name: "hello",
      description: "Say hello from Hot",
      options: [{name: "name", description: "Who to greet", type: 3, required: false}],
      contexts: [0, 1]
    }))
    ```
    """
}
fn
(request: CreateGlobalCommandRequest): Map {
  create-global-command(request, {})
},
(request: CreateGlobalCommandRequest, opts: Map): Map {
  ::api/call("POST", global-commands-path(request.application_id), {body: ::api/body(request, ["application_id"])}, opts)
}

GetGlobalCommandRequest type {
  application_id: Str,
  command_id: Str
}

get-global-command
meta {
    doc: """GET /applications/{application_id}/commands/{command_id} - One global command."""
}
fn
(request: GetGlobalCommandRequest): Map {
  get-global-command(request, {})
},
(request: GetGlobalCommandRequest, opts: Map): Map {
  ::api/call("GET", `${global-commands-path(request.application_id)}/${seg(request.command_id)}`, {}, opts)
}

EditGlobalCommandRequest type {
  application_id: Str,
  command_id: Str,
  name: Str?,
  name_localizations: Map?,
  description: Str?,
  description_localizations: Map?,
  options: Vec<Map>?,
  default_member_permissions: Str?,
  dm_permission: Bool?,
  integration_types: Vec<Int>?,
  contexts: Vec<Int>?,
  nsfw: Bool?,
  handler: Int?,
  clear: Vec<Str>?
}

edit-global-command
meta {
    doc: """PATCH /applications/{application_id}/commands/{command_id} - Change a global command. Only fields you set are sent; `clear: ["default_member_permissions"]` resets permissions to the default."""
}
fn
(request: EditGlobalCommandRequest): Map {
  edit-global-command(request, {})
},
(request: EditGlobalCommandRequest, opts: Map): Map {
  ::api/call("PATCH", `${global-commands-path(request.application_id)}/${seg(request.command_id)}`, {
    body: ::api/body(request, ["application_id", "command_id"])
  }, opts)
}

DeleteGlobalCommandRequest type {
  application_id: Str,
