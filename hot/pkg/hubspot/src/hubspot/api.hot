::hubspot::api ns
meta {
    ctx: {
        "hubspot.token": {required: false},
        "hubspot.api.version": {required: false, secret: false}
    },
    doc: """
    Low-level HubSpot client: authenticated requests, response unwrapping,
    date-versioned CRM path building, query strings, and cursor pagination
    over `paging.next.after`.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then the `hubspot.*` context variables, then the defaults. A
    per-call token is masked in call records and never written to ctx, so
    one run can act for many portals.

    - `token`: the private app or OAuth access token for this call
    - `api-version`: the date-based API version for this call

    A `token` that is present but blank or null is an Err naming the key,
    never a fallback to context.
    """
}

::ctx ::hot::ctx
::uri ::hot::uri

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

// HubSpot's latest date-based API version as of Nov 2026, the one it
// recommends for new integrations. Paths look like
// /crm/objects/2026-09/contacts. Override with `hubspot.api.version`.
DEFAULT_API_VERSION "2026-09"

HttpError
meta {
    doc: """A non-2xx HubSpot response. HubSpot's error body carries `status`, `message`, `category`, `correlationId`, and sometimes `errors`/`context`."""
}
type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: or(response.headers, {}),
    body: response.body
  })
}

non-blank
meta {no-doc: true}
fn (value: Any): Str? {
  if(is-str(value), if(is-empty(trim(value)), null, trim(value)), null)
}

resolve-from
meta {
    doc: """
    The one resolver, pure: `{token, api-version}` for a call from `opts`
    first, then `ctx-values` (a Map of context variables), then defaults. An
    Err when no token is set, or when `token` is in `opts` but blank or null
    (that never falls back to context). Exposed for testing; `resolve` feeds
    it the context.

    **Example**

    ```hot
    ::hubspot::api/resolve-from({api-version: "2026-03"}, {"hubspot.token": "pat-example"}).api-version  // "2026-03"
    is-err(::hubspot::api/resolve-from({}, {}))  // true
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  token or(non-blank(get(opts, "token")), non-blank(get(ctx-values, "hubspot.token")))
  cond {
    and(in("token", keys(opts)), is-null(non-blank(get(opts, "token")))) => {
      err("hubspot: token is in the call's opts but is blank or null. Pass a value, or leave token out to use hubspot.token.")
    }

    is-null(token) => { err("hubspot: hubspot.token is not set. Add it in Context Variables, or pass {token: ...} in the call's opts.") }
    => {
      {
        token: token,
        api-version: or(non-blank(get(opts, "api-version")), non-blank(get(ctx-values, "hubspot.api.version")), DEFAULT_API_VERSION)
      }
    }
  }
}

mark-credentials
meta {
    doc: """
    Mask the `token` in `opts` in this run's call records. Called first
    wherever `opts` arrives, so the records of the calls after it are masked
    too. Returns null.

    **Example**

    ```hot
    opts {token: ::hot::ctx/get("tenant.hubspot.token")}
    ::hubspot::api/mark-credentials(opts)
    ```
    """
}
fn (opts: Map): Any {
  ::ctx/mark-secret(opts.token)
  null
}

resolve
meta {
    ctx: {
        "hubspot.token": {required: false},
        "hubspot.api.version": {required: false, secret: false}
    },
    doc: """
    Credentials and settings for one call (see `resolve-from`). The token
    is masked in this run's call records, and nothing from `opts` is
    written to ctx.

    **Example**

    ```hot
    ::hubspot::api/resolve({token: "pat-tenant", api-version: "2026-03"}).api-version  // "2026-03"
    ```
    """
}
fn (opts: Map): Map {
  mark-credentials(opts)
  resolved resolve-from(opts, {
    "hubspot.token": ::ctx/get("hubspot.token"),
    "hubspot.api.version": ::ctx/get("hubspot.api.version")
  })
  cond {
    is-err(resolved) => { resolved }
    => { {...resolved, token: ::ctx/mark-secret(resolved.token)} }
  }
}

api-version
meta {
    ctx: {"hubspot.api.version": {required: false, secret: false}},
    doc: """
    The date-based API version used in CRM paths: `api-version` in `opts`,
    then the `hubspot.api.version` context variable (e.g. `"2026-03"`),
    otherwise `DEFAULT_API_VERSION`.

    **Example**

    ```hot
    ::hubspot::api/api-version()  // "2026-09"
    ::hubspot::api/api-version({api-version: "2026-03"})  // "2026-03"
    ```
    """
}
fn
(): Str {
  api-version({})
},
(opts: Map): Str {
  mark-credentials(opts)
  or(non-blank(get(opts, "api-version")), non-blank(::ctx/get("hubspot.api.version")), DEFAULT_API_VERSION)
}

crm-path
meta {
    doc: """
    A date-versioned CRM path: `crm-path("objects", "/contacts/123")` gives
    `/crm/objects/2026-09/contacts/123`. `api` is the API family:
    `objects`, `associations`, `pipelines`, `properties`, `owners`, or
    `lists`. `opts` can carry the call's `api-version`.

    **Example**

    ```hot
    ::hubspot::api/crm-path("objects", "/contacts/123")  // "/crm/objects/2026-09/contacts/123"
    ::hubspot::api/crm-path("lists", "", {api-version: "2026-03"})  // "/crm/lists/2026-03"
    ```
    """
}
fn
(api: Str, rest: Str): Str {
  crm-path(api, rest, {})
},
(api: Str, rest: Str, opts: Map): Str {
  `/crm/${api}/${api-version(opts)}${rest}`
}

segment
meta {
    doc: """
    Percent-encode one path segment (an id, object type, or name). Exposed
    for testing.

    **Example**

    ```hot
    ::hubspot::api/segment("a b/c")  // "a%20b%2Fc"
    ```
    """
}
fn (value: Any): Str {
  ::uri/encode(Str(value))
}

query-string
meta {
    doc: """
    Build a query string from a Map, omitting nulls; Vec values become
    comma-separated (HubSpot's `properties=email,firstname` style).

    **Example**

    ```hot
    ::hubspot::api/query-string({limit: 10, after: null})  // "?limit=10"
    ```
    """
}
fn (params: Map): Str {
  flattened map-vals(filter-vals(params, is-some), (v) { if(is-vec(v), join(v, ","), v) })
  ::uri/query-string(flattened)
}

build-request
meta {
    doc: """
    The outgoing `HttpRequest` for a token. A `""` body sends no body and no
    `Content-Type`; `additional-headers` win over the defaults. Pure;
    exposed for testing.

    **Example**

    ```hot
    req ::hubspot::api/build-request("POST", "/crm/objects/2026-09/contacts", {}, {properties: {email: "ada@example.com"}}, "pat-example")
    req.url  // "https://api.hubapi.com/crm/objects/2026-09/contacts"
    req.headers  // {Authorization: "Bearer pat-example", Content-Type: "application/json"}
    ```
    """
}
fn (method: Str, path: Str, additional-headers: Map, body: Any, token: Str): HttpRequest {
  default-headers {
    Authorization: `Bearer ${token}`
  }

  headers if(eq(body, ""), default-headers, {...default-headers, Content-Type: "application/json"})
  final-headers {...headers, ...additional-headers}

  encoded-body if(eq(body, ""), "", to-json(untype(body)))
  HttpRequest({
    method,
    url: `${::hubspot/BASE_URL}${path}`,
    headers: final-headers,
    body: encoded-body
  })
}

request
meta {
    doc: """
    Make an authenticated HubSpot request and return the raw `HttpResponse`.
    `path` is relative to api.hubapi.com (e.g.
    `/crm/objects/2026-09/contacts`). A `""` body sends no body; anything
    else is sent as JSON. Build the path with `crm-path` and the same `opts`
    so a per-call `api-version` reaches it.

    **Example**

    ```hot
    response ::hubspot::api/request("GET", ::hubspot::api/crm-path("objects", "/contacts/12345"))
    response.status

    // Another portal's token for this call
    opts {token: ::hot::ctx/get("tenant.hubspot.token")}
    ::hubspot::api/request("POST", ::hubspot::api/crm-path("objects", "/contacts", opts), {}, {properties: {email: "ada@example.com"}}, opts)
    ```
    """
}
fn
(method: Str, path: Str): HttpResponse {
  request(method, path, {}, "", {})
},
// 3-arity: per-call credentials (see `resolve`)
(method: Str, path: Str, opts: Map): HttpResponse {
  request(method, path, {}, "", opts)
},
(method: Str, path: Str, additional-headers: Map, body: Any): HttpResponse {
  request(method, path, additional-headers, body, {})
},
// 5-arity: explicit token
(method: Str, path: Str, additional-headers: Map, body: Any, token: Str): HttpResponse {
  request(method, path, additional-headers, body, {token: token})
},
// 5-arity: per-call credentials (see `resolve`)
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { ::hot::http/request(build-request(method, path, additional-headers, body, resolved.token)) }
  }
}

handle-response
meta {
    doc: """
    Unwrap a response: the decoded body on 2xx (null for an empty 204), an
    Err carrying `HttpError` otherwise. Exposed for testing.

    **Example**

    ```hot
    ::hubspot::api/handle-response(::hot::http/HttpResponse({status: 200, headers: {}, body: {id: "1"}}))  // {id: "1"}
    ::hubspot::api/handle-response(::hot::http/HttpResponse({status: 204, headers: {}, body: ""}))  // null
    is-err(::hubspot::api/handle-response(::hot::http/HttpResponse({status: 409, headers: {}, body: {message: "Conflict"}})))  // true
    ```
    """
}
fn (response: Result): Any {
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { if(eq(response.body, ""), null, response.body) }
    => { err(HttpError(response)) }
  }
}

json
meta {
    doc: """
    Like `request`, but unwraps: the decoded JSON body on 2xx, or an Err
    carrying `HttpError` (HubSpot's `category`/`message` in `body`).
    Transport failures pass through as Errs.

    **Example**

    ```hot
    contact ::hubspot::api/json("GET", ::hubspot::api/crm-path("objects", "/contacts/12345"))
    contact.properties.email

    created ::hubspot::api/json("POST", ::hubspot::api/crm-path("objects", "/contacts"), {}, {properties: {email: "ada@example.com"}})
    created.id
    ```
    """
}
fn
(method: Str, path: Str): Any {
  json(method, path, {}, "", {})
},
// 3-arity: per-call credentials (see `resolve`)
(method: Str, path: Str, opts: Map): Any {
  json(method, path, {}, "", opts)
},
(method: Str, path: Str, additional-headers: Map, body: Any): Any {
  json(method, path, additional-headers, body, {})
},
// 5-arity: explicit token
(method: Str, path: Str, additional-headers: Map, body: Any, token: Str): Any {
  json(method, path, additional-headers, body, {token: token})
},
// 5-arity: per-call credentials (see `resolve`)
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): Any {
  response request(method, path, additional-headers, body, opts)
  cond {
    is-err(response) => { response }
    => { handle-response(response) }
  }
}

error-message
meta {
    doc: """
    The message from a failed call's error value: HubSpot's `body.message`
    when present, otherwise the stringified body.

    **Example**

    ```hot
    e ::hubspot::api/HttpError(::hot::http/HttpResponse({status: 409, headers: {}, body: {message: "Contact already exists"}}))
    ::hubspot::api/error-message(e)  // "Contact already exists"
    ```
    """
}
fn (error: Any): Str? {
  fields untype(error)
  body if(is-map(fields), get(fields, "body"), null)
  cond {
    and(is-map(body), is-some(get(body, "message"))) => { Str(body.message) }
    is-some(body) => { Str(body) }
    is-some(error) => { Str(error) }
    => { null }
  }
}

// ============================================================================
// Pagination
// ============================================================================

next-after
meta {
    doc: """
    The cursor for the next page (`paging.next.after`) of a HubSpot list or
    search response, or null on the last page.

    **Example**

    ```hot
    ::hubspot::api/next-after({results: [], paging: {next: {after: "100"}}})  // "100"
    ::hubspot::api/next-after({results: []})  // null
    ```
    """
}
fn (page: Any): Str? {
  after if(is-map(page), get-in(page, ["paging", "next", "after"]), null)
  if(is-some(after), Str(after), null)
}

collect-pages
meta {no-doc: true}
fn (fetch: Fn, after: Str?, acc: Vec, pages-left: Int): Vec {
  page fetch(after)
  cond {
    is-err(page) => { page }
    => {
      results concat(acc, or(get(page, "results"), []))
      next next-after(page)
      cond {
        is-null(next) => { results }
        lte(pages-left, 1) => { results }
        => { collect-pages(fetch, next, results, sub(pages-left, 1)) }
      }
    }
  }
}

paginate
meta {
    doc: """
    Follow `paging.next.after` cursors and concatenate every page's
    `results`. `fetch` receives the cursor (null for the first page) and
    returns one page. Stops after `max-pages` pages (default 10) so a
    runaway listing cannot loop forever; returns the first Err.

    **Example**

    ```hot
    ::objects ::hubspot::objects

    contacts ::hubspot::api/paginate((after) {
      ::objects/list-objects("contacts", {limit: 100, after: after, properties: ["email"]})
    }, 5)
    length(contacts)
    ```
    """
}
fn
(fetch: Fn): Vec {
  collect-pages(fetch, null, [], 10)
},
(fetch: Fn, max-pages: Int): Vec {
  collect-pages(fetch, null, [], max-pages)
}
