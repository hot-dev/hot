::zendesk::api ns
meta {
    ctx: {
        "zendesk.subdomain": {required: false, secret: false},
        "zendesk.email": {required: false, secret: false},
        "zendesk.api.token": {required: false},
        "zendesk.oauth.token": {required: false}
    },
    doc: """
    Low-level Zendesk transport: subdomain normalising, API token
    (Basic) or OAuth (Bearer) auth, `HttpError` with a parsed
    `retry-after` for 429s, and cursor pagination (`page[size]`,
    `page[after]`, `meta.has_more`, `meta.after_cursor`).

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then context variables. Nothing from `opts` is written to ctx,
    so one run can act for many accounts and parallel flows don't share
    credentials. Credentials from `opts` are masked in call records.

    - `email` and `api-token`: API token auth for this call (both, in the
      same `opts`)
    - `oauth-token`: an OAuth access token for this call. It wins over
      `email` and `api-token`.
    - `subdomain`: another account's subdomain. It needs credentials in the
      same `opts`: context credentials are never sent to a per-call account.

    With credentials in `opts`, context credentials are ignored for that
    call. A credential key present but blank or null is an error, never a
    fallback to context.
    """
}

::ctx ::hot::ctx
::b64 ::hot::base64
::uri ::hot::uri
::re ::hot::regex

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError
meta {
    doc: """A non-2xx Zendesk response. `retry-after` is the parsed `Retry-After` header in seconds (set on 429 rate limits and some 503s), or null."""
}
type {
    status: Int,
    headers: Map,
    body: Any,
    retry-after: Int?
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  headers or(response.headers, {})
  HttpError({
    status: response.status,
    headers: headers,
    body: response.body,
    retry-after: retry-after(headers)
  })
}

retry-after
meta {
    doc: """Parse the `Retry-After` header (seconds) from response headers, or null when absent or not a number. Exposed for testing."""
}
fn (headers: Map): Int? {
  value get(headers, "retry-after")
  match value {
    Null => { null }
    _ => {
      parsed Int(trim(Str(value)))
      match parsed {
        Result.Err => { null }
        _ => { parsed }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Subdomain and auth
// ---------------------------------------------------------------------------

normalize-subdomain
meta {
    doc: """
    Reduce `acme`, `acme.zendesk.com`, `https://acme.zendesk.com/` or
    `https://acme.zendesk.com/agent` to the bare handle `acme`
    (lowercased). Anything that isn't a plain Zendesk handle afterwards
    (dots, slashes, `@`, empty) is an Err, so a bad value can't point
    requests and credentials at another host. Exposed for testing.
    """
}
fn (subdomain: Str): Str {
  stripped lowercase(trim(subdomain))
    |> ::re/replace-all("^https?://", "")
    |> ::re/replace-all("/.*$", "")
    |> ::re/replace-all("\\.zendesk\\.com$", "")
  cond {
    ::re/is-match(stripped, "^[a-z0-9][a-z0-9-]*$") => { stripped }
    => { err(`zendesk.subdomain must be a Zendesk handle like "acme" or "acme.zendesk.com" (got '${subdomain}')`) }
  }
}

base-url
meta {
    doc: """`https://{subdomain}.zendesk.com/api/v2` for a handle or full `*.zendesk.com` host (see `normalize-subdomain`)."""
}
fn (subdomain: Str): Str {
  `https://${normalize-subdomain(subdomain)}.zendesk.com/api/v2`
}

auth-header
meta {
    doc: """Zendesk API token auth: `Basic base64("{email}/token:{api-token}")`. Exposed for testing."""
}
fn (email: Str, token: Str): Str {
  credentials `${email}/token:${token}`
  `Basic ${::b64/encode(Bytes(credentials))}`
}

non-blank fn (value: Any): Str? {
  if(is-str(value), if(is-empty(trim(value)), null, trim(value)), null)
}

resolve-auth
meta {
    doc: """
    Pick the Authorization header: an OAuth access token gives `Bearer
    {token}` and wins when set; otherwise email plus API token gives
    Basic token auth. Returns an Err naming the missing context
    variables when neither is complete. Exposed for testing.
    """
}
fn (oauth-token: Str?, email: Str?, api-token: Str?): Str {
  cond {
    is-some(non-blank(oauth-token)) => { `Bearer ${non-blank(oauth-token)}` }
    and(is-some(non-blank(email)), is-some(non-blank(api-token))) => { auth-header(non-blank(email), non-blank(api-token)) }
    => { err("Zendesk auth is not configured: set zendesk.oauth.token, or both zendesk.email and zendesk.api.token, or pass {oauth-token: ...} or {email: ..., api-token: ...} in the call's opts.") }
  }
}

CREDENTIAL_KEYS ["email", "api-token", "oauth-token"]

blank-credential
meta {
    doc: """The first of `names` that `opts` has but with a blank or null value, else null. Such a key is an error, never a fallback to context: a tenant whose key is missing must not run on the project's credentials."""
}
fn (opts: Map, names: Vec): Str? {
  find-first(names, (name) { and(in(name, keys(opts)), is-null(non-blank(get(opts, name)))) })
}

has-opts-credentials fn (opts: Map): Bool {
  some(CREDENTIAL_KEYS, (name) { in(name, keys(opts)) })
}

resolve-from
meta {
    doc: """
    The one resolver, pure: `{base-url, authorization}` for a call from
    `opts` first, then `ctx-values` (a Map of context variables). An Err
    when a credential key in `opts` is blank or null (that never falls back
    to context), when `opts` has only half of `email` and `api-token`, when
    `opts` has `subdomain` without credentials, or when no subdomain or
    credentials are set. Exposed for testing; `resolve` feeds it the context.
    """
}
fn (opts: Map, ctx-values: Map): Map {
  blank blank-credential(opts, CREDENTIAL_KEYS)
  subdomain or(non-blank(get(opts, "subdomain")), non-blank(get(ctx-values, "zendesk.subdomain")))
  oauth-token non-blank(get(opts, "oauth-token"))
  email non-blank(get(opts, "email"))
  api-token non-blank(get(opts, "api-token"))
  handle if(is-null(subdomain), null, normalize-subdomain(subdomain))
  cond {
    is-some(blank) => {
      err(`zendesk: ${blank} is in the call's opts but is blank or null. Pass a value, or leave ${blank} out to use context credentials.`)
    }

    and(is-null(oauth-token), or(is-some(email), is-some(api-token)), or(is-null(email), is-null(api-token))) => {
      err("zendesk: API token auth needs both email and api-token in the call's opts.")
    }

    and(in("subdomain", keys(opts)), not(has-opts-credentials(opts))) => {
      err("zendesk: subdomain is in the call's opts without oauth-token, or email and api-token. Pass credentials with it. Context credentials are never sent to a per-call account.")
    }

    is-null(subdomain) => { err("zendesk: zendesk.subdomain is not set. Add it in Context Variables, or pass {subdomain: ...} with credentials in the call's opts.") }
    is-err(handle) => { handle }
    has-opts-credentials(opts) => {
      {base-url: base-url(handle), authorization: resolve-auth(oauth-token, email, api-token)}
    }
    => {
      authorization resolve-auth(
        get(ctx-values, "zendesk.oauth.token"),
        get(ctx-values, "zendesk.email"),
        get(ctx-values, "zendesk.api.token")
      )
      cond {
        is-err(authorization) => { authorization }
        => { {base-url: base-url(handle), authorization: authorization} }
      }
    }
  }
}

mark-opts-credentials fn (opts: Map): Bool {
  for-each(["api-token", "oauth-token"], (name) {
    if(in(name, keys(opts)), ::ctx/mark-secret(non-blank(get(opts, name))))
  })
  true
}

resolve
meta {
    ctx: {
        "zendesk.subdomain": {required: false, secret: false},
        "zendesk.email": {required: false, secret: false},
        "zendesk.api.token": {required: false},
        "zendesk.oauth.token": {required: false}
    },
    doc: """
    The base URL and Authorization header for one call (see
    `resolve-from`). An `api-token` or `oauth-token` from `opts` is masked
    in call records with `::hot::ctx/mark-secret`, and `opts` values are
    never written to ctx.

    **Example**

    ```hot
    ::zendesk::api/resolve({subdomain: "tenant-b", oauth-token: "tenant-b-token"}).base-url  // "https://tenant-b.zendesk.com/api/v2"
    ```
    """
}
fn (opts: Map): Map {
  resolved resolve-from(opts, {
    "zendesk.subdomain": ::ctx/get("zendesk.subdomain"),
    "zendesk.email": ::ctx/get("zendesk.email"),
    "zendesk.api.token": ::ctx/get("zendesk.api.token"),
    "zendesk.oauth.token": ::ctx/get("zendesk.oauth.token")
  })
  cond {
    is-err(resolved) => { resolved }
    => {
      mark-opts-credentials(opts)
      resolved
    }
  }
}

build-headers
meta {
    doc: """Request headers: Authorization, `Accept: application/json`, and `Content-Type` only when there is a body. Exposed for testing."""
}
fn (authorization: Str, has-body: Bool): Map {
  base {Authorization: authorization, Accept: "application/json"}
  if(has-body, {...base, Content-Type: "application/json"}, base)
}

response-body
meta {
    doc: """Normalize a decoded 2xx body: empty text (204 No Content, e.g. deletes) becomes null; anything else passes through. Exposed for testing."""
}
fn (body: Any): Any {
  match body {
    Str => { if(is-empty(trim(body)), null, body) }
    _ => { body }
  }
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

send fn (method: Str, path: Str, body: Any, resolved: Map): Any {
  has-body not(eq(body, ""))
  response ::hot::http/request(HttpRequest({
    method,
    url: `${resolved.base-url}${path}`,
    headers: build-headers(resolved.authorization, has-body),
    body: if(has-body, to-json(untype(body)), "")
  }))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response-body(response.body) }
    => { err(HttpError(response)) }
  }
}

request-with-auth
meta {
    doc: """Make a Zendesk request with an explicit subdomain and Authorization header value, which is masked in call records. `path` is relative to `/api/v2`; `body` is a Map, or `""` for none. Returns the decoded body on 2xx (null when empty), or an Err carrying `HttpError`."""
}
fn (method: Str, path: Str, body: Any, subdomain: Str, authorization: Str): Any {
  handle normalize-subdomain(subdomain)
  cond {
    is-err(handle) => { handle }
    => { send(method, path, body, {base-url: base-url(handle), authorization: ::ctx/mark-secret(authorization)}) }
  }
}

request
meta {
    ctx: {"zendesk.subdomain": {required: false, secret: false}},
    doc: """
    Make an authenticated Zendesk Support request. `path` is relative to
    `/api/v2` (e.g. `/groups`). Returns the decoded body on 2xx (null when
    empty), or an Err carrying `HttpError`. The 4-arity form takes per-call
    `opts` (see `resolve`); the 6-arity form takes an explicit subdomain,
    email and API token.

    **Example**

    ```hot
    groups ::zendesk::api/request("GET", "/groups", "")
    tenant ::zendesk::api/request("GET", "/groups", "", {subdomain: "tenant-b", oauth-token: "tenant-b-token"})
    ```
    """
}
fn
(method: Str, path: Str, body: Any): Any {
  request(method, path, body, {})
},
// 4-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, body: Any, opts: Map): Any {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { send(method, path, body, resolved) }
  }
},
// 6-arity: explicit subdomain + API token credential override
(method: Str, path: Str, body: Any, subdomain: Str, email: Str, api-token: Str): Any {
  request(method, path, body, {subdomain: subdomain, email: email, api-token: api-token})
}

path-segment
meta {
    doc: """Percent-encode one path segment (an id). Ints pass through as text."""
}
fn (value: Any): Str {
  ::uri/encode(Str(value))
}

query-string
meta {
    doc: """Build a `?a=1` suffix from a Map, dropping null values; `""` when nothing remains. Vec values are comma-joined (Zendesk's `ids=1,2,3` form)."""
}
fn (options: Map): Str {
  ::uri/query-string(map-vals(options, (v) {
    match v {
      Vec => { join(map(v, (x) { Str(x) }), ",") }
      _ => { v }
    }
  }))
}

compact
meta {
    doc: """Drop null-valued keys so unset optionals are omitted rather than sent as JSON null."""
}
fn (body: Map): Map {
  filter-vals(body, is-some)
}

// ---------------------------------------------------------------------------
// Cursor pagination
// ---------------------------------------------------------------------------

cursor-query
meta {
    doc: """
    Build a cursor-paginated query string. `options` takes `page_size`
    (sent as `page[size]`, default 100) and `after` (sent as
    `page[after]`, the previous page's `meta.after_cursor`); every other
    key (`sort`, `include`, filters) passes through. Exposed for testing.
    """
}
fn (options: Map): Str {
  rest delete(delete(options, "page_size"), "after")
  query-string({
    ...rest,
    "page[size]": or(get(options, "page_size"), ::zendesk/DEFAULT_PAGE_SIZE),
    "page[after]": get(options, "after")
  })
}

next-after
meta {
    doc: """The `page[after]` cursor for the page after `page`: `meta.after_cursor` when `meta.has_more` is true, otherwise null."""
}
fn (page: Any): Str? {
  meta-block or(get(or(page, {}), "meta"), {})
  if(eq(get(meta-block, "has_more"), true), get(meta-block, "after_cursor"), null)
}

list-page
meta {
    doc: """
    GET one cursor page of `path` (relative to `/api/v2`, without a
    query string). Returns the body: the item Vec under its resource key
    plus `meta: {has_more, after_cursor, before_cursor}` and `links`.
    Read the next cursor with `next-after`.

    **Example**

    ```hot
    page ::zendesk::api/list-page("/groups", {page_size: 50})
    more ::zendesk::api/list-page("/groups", {page_size: 50, after: ::zendesk::api/next-after(page)})
    ```
    """
}
fn
(path: Str, options: Map): Any {
  list-page(path, options, {})
},
(path: Str, options: Map, opts: Map): Any {
  request("GET", `${path}${cursor-query(options)}`, "", opts)
}

collect-pages
meta {
    doc: """
    Follow cursors, concatenating each page's `key` Vec, until `limit`
    items or `meta.has_more` is false. `fetch` is a Fn taking the cursor
    (null for the first page) and returning one page. Exposed for
    testing; `collect` uses it. A failed page comes back as its Err.
    """
}
fn (fetch: Fn, key: Str, cursor: Str?, limit: Int, acc: Vec): Vec {
  cond {
    lte(limit, length(acc)) => { slice(acc, 0, max(limit, 0)) }
    => {
      page fetch(cursor)
      cond {
        is-err(page) => { page }
        => {
          items or(get(page, key), [])
          combined concat(acc, items)
          next next-after(page)
          cond {
            gte(length(combined), limit) => { slice(combined, 0, limit) }
            is-empty(items) => { combined }
            is-null(next) => { combined }
            => { collect-pages(fetch, key, next, limit, combined) }
          }
        }
      }
    }
  }
}

collect
meta {
    doc: """
    Collect up to `limit` items from a cursor-paginated list: `key` is
    the resource key in each page (`"tickets"`, `"users"`, ...).
    `options` takes the same filters as `list-page`.

    **Example**

    ```hot
    groups ::zendesk::api/collect("/groups", "groups", {}, 500)
    ```
    """
}
fn
(path: Str, key: Str, options: Map, limit: Int): Vec {
  collect(path, key, options, limit, {})
},
(path: Str, key: Str, options: Map, limit: Int, opts: Map): Vec {
  size min(::zendesk/DEFAULT_PAGE_SIZE, max(1, limit))
  collect-pages((cursor) { list-page(path, {page_size: size, ...options, after: cursor}, opts) }, key, null, limit, [])
}
