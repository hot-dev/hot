files-remote-list
meta {
    doc: """
    GET /files.remote.list - List remote files. Filter by channel and
    timestamp range. Supports cursor-based pagination.

    **Example**

    ```hot
    response ::slack::files/files-remote-list(::slack::files/FilesRemoteListRequest({
      channel: "C1234567",
      limit: 50
    }))
    map(response.files, %.title)
    ```
    """
}
fn
(request: FilesRemoteListRequest): FilesRemoteListResponse {
  files-remote-list(request, {})
},
(request: FilesRemoteListRequest, opts: Map): FilesRemoteListResponse {
  response api-request("GET", `${::slack::core/BASE_URL}/files.remote.list?channel=${or(request.channel, "")}&ts_from=${or(request.ts_from, "")}&ts_to=${or(request.ts_to, "")}&limit=${or(request.limit, "")}&cursor=${or(request.cursor, "")}`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { FilesRemoteListResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

