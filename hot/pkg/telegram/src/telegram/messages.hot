// ============================================================================
// Callback Queries
// ============================================================================

AnswerCallbackQueryRequest type {
  callback_query_id: Str,
  text: Str?,
  show_alert: Bool?,
  url: Str?,
  cache_time: Int?
}

answer-callback-query
meta {
    doc: """
answerCallbackQuery - Respond to a callback query from an inline keyboard button. Must be called even if no notification is needed. Set `show_alert: true` for a popup instead of a toast.

**Example**

```hot
::messages ::telegram::messages

on-callback fn (update: Map): Bool {
  ::messages/answer-callback-query(::messages/AnswerCallbackQueryRequest({
    callback_query_id: update.callback_query.id,
    text: "Button pressed!"
  }))
}
```
"""
}
fn (request: AnswerCallbackQueryRequest): Bool {
  api-request("answerCallbackQuery", untype(request))
}

// ============================================================================
// Albums and media edits
// ============================================================================

SendMediaGroupRequest
meta {
    doc: """
    `media` is 2-10 InputMedia objects (`{type: "photo" | "video" | "document" | "audio", media, caption?, ...}`). Each `media` (and `thumbnail`/`cover`) may be a file_id, a URL, or an `InputFile`; files are uploaded in one multipart request and referenced with `attach://`. Documents and audio can only be grouped with their own type.
    """
}
type {
  chat_id: Any,
  media: Vec<Map>,
  disable_notification: Bool?,
  protect_content: Bool?,
  allow_paid_broadcast: Bool?,
  message_effect_id: Str?,
  reply_parameters: Map?,
  message_thread_id: Int?,
  direct_messages_topic_id: Int?,
  business_connection_id: Str?
}

send-media-group
meta {
    doc: """
sendMediaGroup - Send 2-10 photos, videos, documents, or audios as an album. Returns the Vec of sent messages.

**Example**

```hot
::messages ::telegram::messages
::api ::telegram::api

album ::messages/send-media-group(::messages/SendMediaGroupRequest({
  chat_id: 123456789,
  media: [
    {type: "photo", media: "https://example.com/a.jpg", caption: "Before"},
    {type: "photo", media: ::api/input-file(::hot::file/read-file-bytes("after.jpg"), "after.jpg", "image/jpeg")}
  ]
}))
length(album)  // => 2
```
"""
}
fn (request: SendMediaGroupRequest): Vec<Map> {
  api-request("sendMediaGroup", untype(request))
}

EditMessageMediaRequest
meta {
    doc: """`media` is one InputMedia object; its `media` may be a file_id, URL, or `InputFile`. Identify the message with `chat_id` + `message_id`, or `inline_message_id`."""
}
type {
  business_connection_id: Str?,
  chat_id: Any?,
  message_id: Int?,
  inline_message_id: Str?,
  media: Map,
  reply_markup: Map?
}

edit-message-media
meta {
    doc: """
editMessageMedia - Replace a message's photo, video, document, audio, or animation (or turn a text message into media). Returns the edited message, or `true` for inline messages.

**Example**

```hot
::messages ::telegram::messages

::messages/edit-message-media(::messages/EditMessageMediaRequest({
  chat_id: 123456789,
  message_id: 42,
  media: {type: "photo", media: "https://example.com/updated.png", caption: "Updated chart"}
}))
```
"""
}
fn (request: EditMessageMediaRequest): Any {
  api-request("editMessageMedia", untype(request))
}

// ============================================================================
// Reactions and polls
// ============================================================================

SetMessageReactionRequest type {
  chat_id: Any,
  message_id: Int,
  reaction: Vec<Map>?,
  is_big: Bool?
}

set-message-reaction
meta {
    doc: """
setMessageReaction - Set the bot's reactions on a message. Each reaction is `{type: "emoji", emoji: "👍"}` (from Telegram's allowed set) or `{type: "custom_emoji", custom_emoji_id}`. Pass an empty `reaction` Vec to remove the bot's reaction. Bots can set one reaction per message.

**Example**

```hot
::messages ::telegram::messages

::messages/set-message-reaction(::messages/SetMessageReactionRequest({
  chat_id: 123456789,
  message_id: 42,
  reaction: [{type: "emoji", emoji: "👍"}]
}))
```
"""
}
fn (request: SetMessageReactionRequest): Bool {
  api-request("setMessageReaction", untype(request))
}

StopPollRequest type {
  business_connection_id: Str?,
  chat_id: Any,
  message_id: Int,
  reply_markup: Map?
}

stop-poll
meta {
    doc: """stopPoll - Close a poll the bot sent. Returns the final Poll with vote counts."""
}
fn (request: StopPollRequest): Map {
  api-request("stopPoll", untype(request))
}

// ============================================================================
// Inline mode
// ============================================================================

AnswerInlineQueryRequest
meta {
    doc: """`results` is up to 50 InlineQueryResult objects, e.g. `{type: "article", id: "1", title, input_message_content: {message_text}}`. `next_offset` enables paging; `button` shows a button above the results."""
}
type {
  inline_query_id: Str,
  results: Vec<Map>,
  cache_time: Int?,
  is_personal: Bool?,
  next_offset: Str?,
  button: Map?
}

answer-inline-query
meta {
    doc: """
answerInlineQuery - Answer an `inline_query` update (a user typing `@yourbot query`). Requires inline mode enabled in BotFather.

**Example**

```hot
::messages ::telegram::messages

on-inline fn (update: Map): Bool {
  ::messages/answer-inline-query(::messages/AnswerInlineQueryRequest({
    inline_query_id: update.inline_query.id,
    results: [{
      type: "article",
      id: "echo",
      title: `Echo: ${update.inline_query.query}`,
      input_message_content: {message_text: update.inline_query.query}
    }],
    cache_time: 0
  }))
}
```
"""
}
fn (request: AnswerInlineQueryRequest): Bool {
  api-request("answerInlineQuery", untype(request))
}
