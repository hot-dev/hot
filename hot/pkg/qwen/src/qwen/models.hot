::qwen::models ns

// ============================================================================
// Qwen Models API
// https://www.alibabacloud.com/help/en/model-studio/models
// ============================================================================

HttpError ::openai::api/HttpError
is-ok-response ::hot::http/is-ok-response

// ============================================================================
// Types
// ============================================================================

Model type {
    id: Str,
    object: Str,
    created: Int?,
    owned_by: Str?
}

ModelsListResponse type {
    object: Str,
    data: Vec<Model>
}

// ============================================================================
// API Functions
// ============================================================================

list
meta {
    doc: """
    List available models from the Qwen (DashScope) API.

    Returns a ModelsListResponse containing a Vec of Model objects.

    **Example**

    ```hot
    models ::qwen::models/list()
    models.data // => [{id: "qwen3.7-plus", object: "model", ...}, ...]

    first-model first(models.data)
    first-model.id // => "qwen3.7-plus"
    ```
    """
}
fn
(): ModelsListResponse | HttpError {
    list({})
},
(opts: Map): ModelsListResponse | HttpError {
    response ::qwen::api/request("GET", "/models", {}, "", opts)
    cond {
        is-err(response) => { response }
        is-ok-response(response) => { ModelsListResponse(response.body) }
        => { err(HttpError(response)) }
    }
}

get
meta {
    doc: """
    Retrieve details about a specific model by its ID.

    Returns a Model with id, object, created, and owned_by fields.

    **Example**

    ```hot
    model ::qwen::models/get("qwen3.7-plus")
    model.id // => "qwen3.7-plus"
    model.object // => "model"
    ```
    """
}
fn
(model-id: Str): Model | HttpError {
    get(model-id, {})
},
(model-id: Str, opts: Map): Model | HttpError {
    response ::qwen::api/request("GET", model-path(model-id), {}, "", opts)
    cond {
        is-err(response) => { response }
        is-ok-response(response) => { Model(response.body) }
        => { err(HttpError(response)) }
    }
}

model-path
meta {
    doc: """
    The `/models/{id}` path with the id URL-encoded.

    **Example**

    ```hot
    ::qwen::models/model-path("qwen3.8-max")  // => "/models/qwen3.8-max"
    ```
    """
}
fn (model-id: Str): Str {
    `/models/${::hot::uri/encode(model-id)}`
}

// ============================================================================
// Model ids (Model Studio, November 2026). Availability varies by region;
// check the Model Studio model list for yours.
// ============================================================================

// Current generation (proprietary, hosted only)
QWEN3_8_MAX "qwen3.8-max"       // flagship: complex reasoning and coding
QWEN3_7_PLUS "qwen3.7-plus"     // balanced performance, speed and cost; multimodal input
QWEN3_8_FLASH "qwen3.8-flash"   // fast and cost-effective

// Previous generations, still served
QWEN3_6_PLUS "qwen3.6-plus"
QWEN3_5_PLUS "qwen3.5-plus"
QWEN3_5_FLASH "qwen3.5-flash"
QWEN3_MAX "qwen3-max"           // proprietary (not open-weight)

// Rolling aliases for the commercial tiers
QWEN_MAX "qwen-max"
QWEN_PLUS "qwen-plus"
QWEN_FLASH "qwen-flash"
QWEN_TURBO "qwen-turbo"         // superseded by qwen-flash

// Long-context / document model
QWEN_LONG "qwen-long"

// Vision-language
QWEN_VL_PLUS "qwen-vl-plus"
QWEN_VL_MAX "qwen-vl-max"

// Embeddings
TEXT_EMBEDDING_V4 "text-embedding-v4"
QWEN3_7_TEXT_EMBEDDING "qwen3.7-text-embedding"
TEXT_EMBEDDING_V3 "text-embedding-v3"
