}

ValidateGraderRequest type {
    grader: Map
}

ValidateGraderResponse type {
    grader: Map?
}


validate-grader
meta {
    doc: """POST /fine_tuning/alpha/graders/validate - Validate a grader configuration before using it in fine-tuning."""
}
fn
(request: ValidateGraderRequest): ValidateGraderResponse {
  validate-grader(request, {})
},
(request: ValidateGraderRequest, opts: Map): ValidateGraderResponse {
  response api-request("POST", "/fine_tuning/alpha/graders/validate", {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ValidateGraderResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
