::ai::tool ns
meta {
    doc: """
    Provider-agnostic Tool primitive shared across `::ai::chat`,
    `::ai::session`, and any agent code that needs to expose Hot
    functions (or external MCP-served functions) to an LLM.

    A `Tool` carries enough metadata for the chat layer to advertise it
    to a model and dispatch incoming `tool_use`/`tool_call` blocks. The
    underlying schema is computed from a Hot function's typed signature
    via `::hot::internal::mcp/schema-from-fn`, ensuring there is a
    single source of truth between MCP-exposed tools (baked into the
    deploy manifest) and runtime agent dispatch.
    """
}

::regex ::hot::regex
::hash  ::hot::hash

// ============================================================================
// Types
// ============================================================================

Tool
meta {
    doc: """
    A callable, model-facing tool. Most fields are derived
    automatically by `from-fn`; pass overrides to customize what the
    model sees.

    Fields:
    - `name` — unique tool identifier presented to the model. Defaults
      to the qualified Hot function name (e.g. `"::myapp/search"`).
    - `description` — short natural-language summary the model uses to
      decide when to call the tool. Falls back to the `meta {doc: ...}`
      docstring on the underlying Hot function.
    - `input-schema` — JSON-Schema describing the tool's input. Auto
      generated from the function's typed parameters.
    - `output-schema` — optional JSON-Schema for the tool's output.
    - `fn` — the Hot function the run-loop will dispatch to.
    - `pass-input` — when `true`, `dispatch` calls `fn(input-map)`
      directly instead of unpacking the map into positional arguments.
      Used by external MCP wrappers (`::ai::mcp/from-server`) and other
      tools whose schema is supplied by an external system. Defaults
      to `false`.
    - `ends-run` — when `true`, a successful call to this tool ends
      `run-loop`, and the tool's output is the loop's answer (a `Str` as
      is, anything else as JSON). Use it for a `finish` or `submit_result`
      tool. A failed call goes back to the model as usual, so it can fix
      the input. Defaults to `false`.
    - `fail-on-error` — when `true`, a failed call to this tool ends
      `run-loop` with an Err holding a `::ai::chat/ToolFailure`, instead of
      going back to the model. When `false`, it always goes back, whatever
      `ChatOptions.fail-on-tool-error` says. Null follows that option.

    **Example**

    ```hot
    ::ai::tool ::ai::tool

    search-docs
    meta {doc: "Search project documentation."}
    fn (query: Str, limit: Int): Vec<Str> {
        // ... implementation ...
        []
    }

    web-search-tool ::ai::tool/from-fn(search-docs)
    // => Tool({name: "::myapp/search-docs",
    //          description: "Search project documentation.",
    //          input-schema: {type: "object", ...},
    //          fn: search-docs, ...})
    ```
    """
}
type {
    name: Str,
    description: Str?,
    input-schema: Map,
    output-schema: Map?,
    fn: Fn,
    pass-input: Bool?,
    ends-run: Bool?,
    fail-on-error: Bool?
}

ToolCall
meta {
    doc: """
    A single tool invocation request emitted by an LLM in a
    multi-turn loop. Providers normalize their native tool-use blocks
    into this shape before passing them to `dispatch`.

    Fields:
    - `id` — provider-supplied identifier echoed back in the
      corresponding `ToolResult`.
    - `name` — the `Tool.name` the model wants to invoke.
    - `input` — JSON-decoded input map matching the tool's
      `input-schema`.
    - `meta` — optional provider data the adapter needs back on the
      next turn, such as Gemini's `thoughtSignature`. `run-loop`
      carries it untouched from the reply into the next request, and
      it is left out of the token estimate. Other adapters ignore it.
    """
}
type {
    id: Str,
    name: Str,
    input: Map,
    meta: Map?
}

ToolResult
meta {
    doc: """
    The reply for a single `ToolCall`, fed back into the next chat
    turn. The chat layer is responsible for serializing this into the
    provider's native shape (e.g. Anthropic `tool_result` blocks or
    OpenAI tool-message replies).

    Fields:
    - `id` — must match the originating `ToolCall.id`.
    - `output` — the result value to return to the model.
    - `is-error` — true when the tool failed; the message is then
      surfaced to the model as an error so it can react.
    """
}
type {
    id: Str,
    output: Any,
    is-error: Bool
}

// ============================================================================
// Schema introspection
// ============================================================================

schema-from-fn
meta {
    doc: """
    Return `{name, input-schema, output-schema?, description?}` for a
    Hot function, derived from its typed signature and `meta {doc: ...}`.

    Schemas are computed once at compile time by the Hot engine and
    served from a process-global registry, so this call is cheap and
    safe to use during boot. Useful when you want to advertise a tool
    to a downstream system without going through `from-fn`.

    **Example**

    ```hot
    search fn (query: Str, limit: Int): Vec<Str> { [query] }
    ::ai::tool/schema-from-fn(search)
    // => {name: "::myapp/search",
    //     input-schema: {type: "object",
    //                    properties: {query: {type: "string"},
    //                                 limit: {type: "integer"}},
    //                    required: ["query", "limit"]},
    //     output-schema: {type: "array", items: {type: "string"}}}
    ```
    """
}
fn (f: Fn): Map {
    ::hot::internal::mcp/schema-from-fn(f)
}

// ============================================================================
// Provider names
// ============================================================================

PROVIDER_NAME_LIMIT 64

provider-name
meta {
    doc: """
    Return a deterministic provider-safe alias for an internal tool name.

    Hot tool names may be qualified (`::project/search`) or grouped
    (`github/list-runs`), while model providers accept only letters, digits,
    underscores, and hyphens. Valid short names pass through unchanged.
    Rewritten names carry a hash suffix so two distinct internal names cannot
    silently collapse onto the same provider-facing alias.

    **Example**

    ```hot
    ::ai::tool/provider-name("search-docs")  // "search-docs"
    starts-with(::ai::tool/provider-name("::myapp/search"), "__myapp_search_")  // true
    ```
    """
}
fn (name: Str): Str {
    safe ::regex/replace-all(name, "[^a-zA-Z0-9_-]", "_")
    cond {
        and(gt(length(safe), 0),
            and(lte(length(safe), PROVIDER_NAME_LIMIT), eq(safe, name))) => {
            safe
        }
        => {
            suffix slice(::hash/blake3(name), 0, 10)
            prefix-limit sub(PROVIDER_NAME_LIMIT, add(length(suffix), 1))
            `${slice(safe, 0, prefix-limit)}_${suffix}`
        }
    }
}

// ============================================================================
// Construction
// ============================================================================

from-fn
meta {
    doc: """
    Build a `Tool` from any Hot function with typed parameters.

    The function's qualified name becomes `Tool.name`, its
    `meta {doc: ...}` becomes `description`, and its parameter types
    are converted to a JSON-Schema input. Pass an `overrides` map to
    customize any of these fields, or to set `ends-run` and
    `fail-on-error`.

    **Example**

    ```hot
    sum fn (x: Int, y: Int): Int { add(x, y) }

    // Defaults
    t1 ::ai::tool/from-fn(sum)
    // => Tool({name: "::myapp/sum", input-schema: {...}, fn: sum})

    // With overrides for the model-facing surface
    t2 ::ai::tool/from-fn(sum, {
        name: "add-numbers",
        description: "Add two integers and return the sum."
    })

    // A tool whose successful call ends the run
    finish fn (answer: Str): Str { answer }
    t3 ::ai::tool/from-fn(finish, {name: "finish", ends-run: true})
    ```
    """
}
fn
(f: Fn): Tool {
    from-fn(f, {})
},
(f: Fn, overrides: Map): Tool {
    schema schema-from-fn(f)
    Tool({
        name: or(
            get(overrides, "name"),
            get(schema, "display-name"),
            schema.name
        ),
        description: or(
            get(overrides, "description"),
            get(schema, "description"),
            null
        ),
        input-schema: or(get(overrides, "input-schema"), schema.input-schema),
        output-schema: or(
            get(overrides, "output-schema"),
            get(schema, "output-schema"),
            null
        ),
        fn: f,
        ends-run: get(overrides, "ends-run"),
        fail-on-error: get(overrides, "fail-on-error")
    })
}

for-agent
meta {
    doc: """
    Normalize an agent's `tools:` list (a mix of Hot function refs and
    pre-built `Tool` records) into a `Vec<Tool>` ready for the chat
    run-loop.

    **Example**

    ```hot
    search fn (query: Str): Vec<Str> { [query] }
    web-tool ::ai::tool/Tool({name: "web", input-schema: {type: "object"}, fn: search})

    tools ::ai::tool/for-agent([search, web-tool])
    // => [Tool({name: "::myapp/search", ...}),
    //     Tool({name: "web", ...})]
    ```
    """
}
fn (entries: Vec<Any>): Vec<Tool> {
    map(entries, (entry) {
        if(is-type(entry, Tool), entry, from-fn(entry))
    })
}

// ============================================================================
// Dispatch
// ============================================================================

find-by-name
meta {
    doc: """
    Look up a `Tool` in `tools` by `name`, returning `null` when no
    tool matches. Used by `dispatch` and surfaced for callers that
    need to inspect or rewrite a tool before invoking it.

    **Example**

    ```hot
    web ::ai::tool/Tool({name: "web", input-schema: {}, fn: (q: Str) { [q] }})
    ::ai::tool/find-by-name([web], "web").name  // "web"
    ::ai::tool/find-by-name([web], "missing")  // null
    ```
    """
}
fn (tools: Vec<Tool>, name: Str): Tool? {
    find-first(tools, (tool) {
        or(eq(tool.name, name), eq(provider-name(tool.name), name))
    })
}

failure-output
meta {
    doc: """
    What the model sees for a failed tool call, from the error payload:
    a halt (`fail(msg)`, `fail(msg, data)`, a runtime error) becomes its
    message, or `{message, data}` when it carries data beyond the message.
    An Err value the tool returned stays as is, a Map with a `msg` key
    included. A null payload names the tool.

    **Example**

    ```hot
    ::ai::tool/failure-output({msg: "card declined", err: "card declined"}, "charge")  // "card declined"
    ::ai::tool/failure-output({msg: "bad input", err: {field: "amount"}}, "charge")   // {message: "bad input", data: {field: "amount"}}
    ::ai::tool/failure-output({msg: "rate limited", code: 429}, "charge")             // {msg: "rate limited", code: 429}
    ::ai::tool/failure-output(null, "charge")                                         // "Tool charge failed."
    ```
    """
}
fn (payload: Any, tool-name: Str): Any {
    // A halt's payload is a typed `::hot::run/Failure`; read it as a Map.
    // Only a halt has both `msg` and `err`: an Err Map the tool returned,
    // such as `{msg, code}`, stays whole.
    plain if(is-null(payload), null, untype(payload))
    is-halt and(is-map(plain), in("err", keys(plain)), is-str(get(plain, "msg")))
    msg if(is-halt, get(plain, "msg"), null)
    detail if(is-halt, get(plain, "err"), null)
    cond {
        is-null(payload) => { `Tool ${tool-name} failed.` }
        not(is-halt) => { payload }
        is-null(detail) => { msg }
        eq(detail, msg) => { msg }
        // A runtime error's detail is just `{error: msg}`.
        eq(detail, {error: msg}) => { msg }
        => { {message: msg, data: detail} }
    }
}

dispatch
meta {
    doc: """
    Invoke the tool whose `name` matches `call.name`, mapping
    `call.input` (a Map keyed by parameter name) to the function's
    positional arguments. Returns a `ToolResult` whose `id` echoes the
    incoming call and whose `output` is the function's return value.

    Errors from the underlying function are caught and returned with
    `is-error: true` so the model can react on the next turn. The output
    is the failure's message (see `failure-output`).

    **Example**

    ```hot
    sum fn (x: Int, y: Int): Int { add(x, y) }
    tools ::ai::tool/for-agent([sum])

    call ::ai::tool/ToolCall({id: "call_1", name: "::myapp/sum", input: {x: 2, y: 3}})
    ::ai::tool/dispatch(tools, call)
    // => ToolResult({id: "call_1", output: 5, is-error: false})
    ```
    """
}
fn (tools: Vec<Tool>, call: ToolCall): ToolResult {
    tool find-by-name(tools, call.name)
    cond {
        is-null(tool) => { ToolResult({
            id: call.id,
            output: `Unknown tool: ${call.name}`,
            is-error: true
        }) }
        => {
            // Supervision boundary: a tool is arbitrary user code invoked
            // on the model's behalf, so this is one of the sanctioned
            // halt-containment points — a tool that fail()s (or returns
            // an Err) is reported back to the model as `is-error: true`
            // instead of bringing down the agent run-loop. Application
            // code should not copy this pattern; expected failures are
            // Result.Err values.
            attempt cond {
                or(get(tool, "pass-input"), false) => { ::hot::internal::exec/contain(tool.fn, [call.input]) }
                => { ::hot::internal::exec/contain(::hot::internal::mcp/invoke-with-input, [tool.fn, call.input]) }
            }

            match attempt {
                Result.Err => {
                    // Inside a `Result.Err` arm `attempt` is already the
                    // error payload: `err-value(attempt)` would be null.
                    ToolResult({
                        id: call.id,
                        output: failure-output(attempt, call.name),
                        is-error: true,
                    })
                }

                Result.Ok => {
                    ToolResult({
                        id: call.id,
                        output: ok-value(attempt),
                        is-error: false,
                    })
                }
            }
        }
    }
}
