::web-search::test ns
meta ["test"]

::ws ::web-search
::http ::web-search::http
::tavily ::web-search::tavily
::brave ::web-search::brave
::exa ::web-search::exa
::firecrawl ::web-search::firecrawl

// ============================================================================
// Provider selection
// ============================================================================

test-no-provider-errors
meta ["test"] fn () {
    out ::ws/search("anything")
    assert(is-err(out), "no configured provider should be a clear error")
    message if-err(out, (e) { e })
    assert(contains(message, "no provider configured"))
}

test-provider-order-defaults-to-first-configured
meta ["test"] fn () {
    assert-eq(["brave"], ::ws/provider-order(null, false, ["brave", "exa"]))
    assert-eq(["brave", "exa"], ::ws/provider-order(null, true, ["brave", "exa"]), "fallback adds the rest in order")
}

test-provider-order-preferred-first
meta ["test"] fn () {
    assert-eq(["exa"], ::ws/provider-order("exa", false, ["tavily", "brave", "exa"]))
    assert-eq(["exa", "tavily", "brave"], ::ws/provider-order("exa", true, ["tavily", "brave", "exa"]))
    assert-eq(["firecrawl", "tavily"], ::ws/provider-order("firecrawl", true, ["tavily"]),
        "an unconfigured preference is still tried first, so its error is reported")
}

test-provider-order-errors
meta ["test"] fn () {
    unknown ::ws/provider-order("bing", false, ["tavily"])
    assert(is-err(unknown))
    assert(contains(if-err(unknown, (e) { e }), "unknown provider"))
    assert(is-err(::ws/provider-order(null, true, [])), "nothing configured")
}

test-explicit-unconfigured-provider-errors
meta ["test"] fn () {
    out ::ws/search("anything", 3, {provider: "exa"})
    assert(is-err(out))
    assert(contains(if-err(out, (e) { e }), "exa.api.key"))
}

test-context-default-provider
meta ["test"] fn () {
    ::hot::ctx/set("web-search.provider", "brave")
    assert-eq("brave", ::ws/configured-provider())
    out ::ws/search("anything")
    assert(contains(if-err(out, (e) { e }), "brave.api.key"), "the context default is used")
    ::hot::ctx/set("web-search.provider", "")
    assert(is-null(::ws/configured-provider()), "blank context value means no default")
}

test-search-filters
meta ["test"] fn () {
    assert-eq({}, ::ws/search-filters({}))
    assert-eq({freshness: "week", include-domains: ["hot.dev"]},
        ::ws/search-filters({freshness: "week", include-domains: ["hot.dev"], exclude-domains: []}),
        "empty domain lists are dropped")
    bad ::ws/search-filters({freshness: "fortnight"})
    assert(is-err(bad))
    assert(contains(if-err(bad, (e) { e }), "unknown freshness"))
}

// ============================================================================
// Clamping and per-provider filter mapping
// ============================================================================

test-clamp
meta ["test"] fn () {
    assert-eq(20, ::http/clamp(50, 1, 20))
    assert-eq(1, ::http/clamp(0, 1, 20))
    assert-eq(7, ::http/clamp(7, 1, 20))
}

FILTERS {freshness: "week", include-domains: ["hot.dev", "docs.hot.dev"], exclude-domains: ["spam.example"]}

test-tavily-options
meta ["test"] fn () {
    assert-eq({max_results: 20}, ::tavily/build-search-options(50, {}), "clamped to 20, no unset filters")
    opts ::tavily/build-search-options(5, FILTERS)
    assert-eq(5, opts.max_results)
    assert-eq("week", opts.time_range)
    assert-eq(["hot.dev", "docs.hot.dev"], opts.include_domains)
    assert-eq(["spam.example"], opts.exclude_domains)
}

test-brave-options-and-query
meta ["test"] fn () {
    assert-eq({count: 20}, ::brave/build-search-options(100, {}))
    assert-eq("pw", ::brave/build-search-options(5, FILTERS).freshness)
    assert-eq("rust", ::brave/build-query("rust", {}))
    assert-eq("rust site:hot.dev", ::brave/build-query("rust", {include-domains: ["hot.dev"]}))
    assert-eq("rust site:hot.dev OR site:docs.hot.dev NOT site:spam.example", ::brave/build-query("rust", FILTERS))
}

test-exa-options
meta ["test"] fn () {
    now 1767225600000 // 2026-01-01T00:00:00Z
    opts ::exa/build-search-options(500, FILTERS, now)
    assert-eq(100, opts.numResults)
    assert-eq({text: {maxCharacters: 1000}}, opts.contents, "page text is always requested, capped")
    assert-eq("2025-12-25T00:00:00Z", opts.startPublishedDate)
    assert-eq(["hot.dev", "docs.hot.dev"], opts.includeDomains)
    assert-eq(["spam.example"], opts.excludeDomains)

    plain ::exa/build-search-options(3, {}, now)
    assert(not(in("startPublishedDate", keys(plain))), "unset filters are omitted")
    assert(not(in("includeDomains", keys(plain))))
}

test-exa-published-since
meta ["test"] fn () {
    now 1767225600000
    assert-eq("2025-12-31T00:00:00Z", ::exa/published-since("day", now))
    assert-eq("2025-01-01T00:00:00Z", ::exa/published-since("year", now))
    assert(is-null(::exa/published-since(null, now)))
}

test-firecrawl-options
meta ["test"] fn () {
    assert-eq({limit: 100}, ::firecrawl/build-search-options(1000, {}))
    opts ::firecrawl/build-search-options(5, FILTERS)
    assert-eq("qdr:w", opts.tbs)
    assert-eq(["hot.dev", "docs.hot.dev"], opts.includeDomains)
}

// ============================================================================
// Snippet cleanup
// ============================================================================

test-clean-text-strips-markup-and-decodes-entities
meta ["test"] fn () {
    assert-eq("The Hot language & its runtime",
        ::http/clean-text("The <strong>Hot</strong> language &amp; its <em class=\"x\">runtime</em>"))
    assert-eq("It's \"quoted\" <tag>", ::http/clean-text("It&#x27;s &quot;quoted&quot; &lt;tag&gt;"))
    assert-eq("&lt; stays literal", ::http/clean-text("&amp;lt; stays literal"), "double-escaped entities decode once")
    assert(is-null(::http/clean-text(null)))
}

// ============================================================================
// Errors
// ============================================================================

test-error-messages-per-provider
meta ["test"] fn () {
    assert-eq("Tavily API error 401: Unauthorized: missing or invalid API key.",
        ::http/error-message("Tavily", 401, {detail: {error: "Unauthorized: missing or invalid API key."}}))
    assert-eq("Brave API error 422: Unable to validate request parameter(s)",
        ::http/error-message("Brave", 422, {type: "ErrorResponse", error: {code: "VALIDATION", detail: "Unable to validate request parameter(s)", status: 422}}))
    assert-eq("Exa API error 400: Invalid request", ::http/error-message("Exa", 400, {requestId: "r1", error: "Invalid request"}))
    assert-eq("Firecrawl API error 402: Payment required", ::http/error-message("Firecrawl", 402, {success: false, error: "Payment required"}))
    assert-eq("Brave API error 503", ::http/error-message("Brave", 503, null))
}

test-http-error-from-response
meta ["test"] fn () {
    e ::http/http-error("tavily", "Tavily", ::hot::http/HttpResponse({status: 429, body: {detail: {error: "Rate limit exceeded"}}}))
    assert-eq("tavily", e.provider)
    assert-eq(429, e.status)
    assert-eq("Tavily API error 429: Rate limit exceeded", e.message)
}

// ============================================================================
// Normalizers (shapes from each provider's documented responses)
// ============================================================================

test-tavily-normalize
meta ["test"] fn () {
    body {
        query: "q",
        results: [
            {title: "First", url: "https://a.example", content: "snippet a", score: 0.98},
            {title: "Second", url: "https://b.example", content: "snippet b", score: 0.72}
        ]
    }

    out ::tavily/normalize(body)
    assert-eq(2, length(out))
    assert-eq("First", first(out).title)
    assert-eq(0.98, first(out).score)
    assert-eq("https://b.example", last(out).url)
}

test-brave-normalize
meta ["test"] fn () {
    body {
        web: {
            results: [
                {title: "The <strong>Hot</strong> language", url: "https://c.example", description: "desc &amp; <strong>text</strong>"}
            ]
        }
    }

    out ::brave/normalize(body)
    assert-eq(1, length(out))
    assert-eq("The Hot language", first(out).title, "markup stripped from titles")
    assert-eq("desc & text", first(out).content, "markup stripped and entities decoded in snippets")
    assert(is-null(first(out).score), "brave has no score")
}

test-brave-normalize-empty-body
meta ["test"] fn () {
    assert-eq([], ::brave/normalize({}), "missing web section yields no results, not an error")
}

test-exa-normalize
meta ["test"] fn () {
    body {
        results: [
            {title: "Neural hit", url: "https://d.example", text: "page text"},
            {title: null, url: "https://e.example", highlights: ["a highlight"]}
        ]
    }

    out ::exa/normalize(body)
    assert-eq("page text", first(out).content)
    assert(is-null(first(out).score), "no score in current Exa responses")
    assert-eq("", last(out).title, "null titles normalize to empty string")
    assert-eq("a highlight", last(out).content, "highlights stand in when there is no text")
}

test-firecrawl-normalize
meta ["test"] fn () {
    body {success: true, data: {web: [
        {title: "Firecrawl", url: "https://firecrawl.dev", description: "Turn websites into <b>LLM-ready</b> data"},
        {title: "Docs", url: "https://docs.firecrawl.dev", markdown: "# Docs"}
    ]}}
    out ::firecrawl/normalize(body)
    assert-eq("Turn websites into LLM-ready data", first(out).content)
    assert-eq("# Docs", last(out).content, "markdown stands in when there is no description")
    assert-eq([], ::firecrawl/normalize({success: true, data: {}}))
}
