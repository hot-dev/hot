::slack::admin::teams ns
meta {
    doc: """
    `admin.teams.*`: create and list the workspaces in an Enterprise
    organization, list their admins and owners, and change workspace
    settings (name, description, icon, discoverability, default channels).

    **Example**

    ```hot
    ::teams ::slack::admin::teams

    workspaces ::teams/list-all(::teams/ListRequest({}), 500)
    map(workspaces, (t) { t.name })
    ```
    """
}

::api ::slack::admin::api

CreateRequest type {
  team_domain: Str,
  team_name: Str,
  team_description: Str?,
  team_discoverability: Str?
}

create
meta {
    doc: """
    admin.teams.create - Create a workspace. `team_discoverability`: `open`, `closed`, `invite_only` or `unlisted`. Returns `team` (the new team id).

    Scope: `admin.teams:write`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    """
}
fn
(request: CreateRequest): Map {
  create(request, {})
},
(request: CreateRequest, opts: Map): Map {
  ::api/call("admin.teams.create", request, opts)
}

ListRequest type {
  cursor: Str?,
  limit: Int?
}

list
meta {
    doc: """
    admin.teams.list - List every workspace in the organization (`teams`).

    Scope: `admin.teams:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `list-all`.
    """
}
fn
(): Map {
  list(ListRequest({}))
},
(request: ListRequest): Map {
  list(request, {})
},
(request: ListRequest, opts: Map): Map {
  ::api/call("admin.teams.list", request, opts)
}

list-all
meta {
    doc: """
    Every `teams` entry from `admin.teams.list`, following `next_cursor` until the last page or `max-items` (default 1000). `request` sets the filters; its `cursor` is the starting point.
    """
}
fn
(): Vec {
  list-all(ListRequest({}), 1000)
},
(request: ListRequest): Vec {
  list-all(request, 1000)
},
(request: ListRequest, max-items: Int): Vec {
  list-all(request, max-items, {})
},
(request: ListRequest, max-items: Int, opts: Map): Vec {
  ::api/paginate("admin.teams.list", request, "teams", max-items, opts)
}

