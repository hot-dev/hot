::github::actions ns

::api ::github::api
query-string ::hot::uri/query-string

actions-path
meta {
    doc: """
    Build a repository Actions API path, including its leading slash.

    **Example**

    ```hot
    ::github::actions/actions-path("acme", "api", "/runs")  // "/repos/acme/api/actions/runs"
    ```
    """
}
fn (owner: Str, repo: Str, suffix: Str): Str {
  `/repos/${owner}/${repo}/actions${suffix}`
}

with-query
meta {
    doc: """
    Append GitHub REST query parameters to an endpoint path.

    **Example**

    ```hot
    ::github::actions/with-query("/repos/acme/api/actions/runs", {status: "completed"})
    // "/repos/acme/api/actions/runs?status=completed"
    ```
    """
}
fn (path: Str, params: Map): Str {
  `${path}${query-string(params)}`
}

workflow-path
meta {no-doc: true}
fn (owner: Str, repo: Str, workflow: Any): Str {
  actions-path(owner, repo, `/workflows/${workflow}`)
}

run-path
meta {no-doc: true}
fn (owner: Str, repo: Str, run-id: Any): Str {
  actions-path(owner, repo, `/runs/${run-id}`)
}

attempt-path
meta {no-doc: true}
fn (owner: Str, repo: Str, run-id: Any, attempt: Any): Str {
  `${run-path(owner, repo, run-id)}/attempts/${attempt}`
}

job-path
meta {no-doc: true}
fn (owner: Str, repo: Str, job-id: Any): Str {
  actions-path(owner, repo, `/jobs/${job-id}`)
}

// ============================================================================
// Workflows
// ============================================================================

list-workflows
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/workflows - Repository workflows.
    `params` supports `per_page` and `page`.

    **Example**

    ```hot
    result ::github::actions/list-workflows("acme", "api", {per_page: 100})
    map(result.workflows, %.path)
    ```
    """
}
fn
(owner: Str, repo: Str): Map {
  ::api/json("GET", actions-path(owner, repo, "/workflows"))
},
(owner: Str, repo: Str, params: Map): Map {
  list-workflows(owner, repo, params, {})
},
(owner: Str, repo: Str, params: Map, opts: Map): Map {
  ::api/json("GET", actions-path(owner, repo, "/workflows") |> with-query(params), {}, "", opts)
}

get-workflow
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/workflows/{workflow} - Get a workflow
    by numeric id or file name.

    **Example**

    ```hot
    workflow ::github::actions/get-workflow("acme", "api", "ci.yml")
    workflow.state
    ```
    """
}
fn
(owner: Str, repo: Str, workflow: Any): Map {
  get-workflow(owner, repo, workflow, {})
},
(owner: Str, repo: Str, workflow: Any, opts: Map): Map {
  ::api/json("GET", workflow-path(owner, repo, workflow), {}, "", opts)
}

list-runs-for-workflow
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/workflows/{workflow}/runs - Runs for
    one workflow. `params` supports `actor`, `branch`, `event`, `status`,
    `created`, `exclude_pull_requests`, `check_suite_id`, `head_sha`,
    `per_page`, and `page`.

    **Example**

    ```hot
    result ::github::actions/list-runs-for-workflow("acme", "api", "ci.yml", {branch: "main", status: "failure"})
    map(result.workflow_runs, %.html_url)
    ```
    """
}
fn
(owner: Str, repo: Str, workflow: Any): Map {
  ::api/json("GET", `${workflow-path(owner, repo, workflow)}/runs`)
},
(owner: Str, repo: Str, workflow: Any, params: Map): Map {
  list-runs-for-workflow(owner, repo, workflow, params, {})
},
(owner: Str, repo: Str, workflow: Any, params: Map, opts: Map): Map {
  ::api/json("GET", `${workflow-path(owner, repo, workflow)}/runs` |> with-query(params), {}, "", opts)
}

enable-workflow
meta {
    doc: """
    PUT /repos/{owner}/{repo}/actions/workflows/{workflow}/enable - Enable a
    workflow.

    **Example**

    ```hot
    ::github::actions/enable-workflow("acme", "api", "ci.yml")
    ```
    """
}
fn
(owner: Str, repo: Str, workflow: Any): Any {
  enable-workflow(owner, repo, workflow, {})
},
(owner: Str, repo: Str, workflow: Any, opts: Map): Any {
  ::api/json("PUT", `${workflow-path(owner, repo, workflow)}/enable`, {}, "", opts)
}

disable-workflow
meta {
    doc: """
    PUT /repos/{owner}/{repo}/actions/workflows/{workflow}/disable - Disable
    a workflow.

    **Example**

    ```hot
    ::github::actions/disable-workflow("acme", "api", "ci.yml")
    ```
    """
}
fn
(owner: Str, repo: Str, workflow: Any): Any {
  disable-workflow(owner, repo, workflow, {})
},
(owner: Str, repo: Str, workflow: Any, opts: Map): Any {
  ::api/json("PUT", `${workflow-path(owner, repo, workflow)}/disable`, {}, "", opts)
}

dispatch-body
meta {no-doc: true}
fn (ref: Str, inputs: Map): Map {
  if(is-empty(inputs), {ref: ref}, {ref: ref, inputs: inputs})
}

dispatch-workflow
meta {
    doc: """
    POST /repos/{owner}/{repo}/actions/workflows/{workflow}/dispatches -
    Trigger a `workflow_dispatch` workflow on a ref. `workflow` is the
    file name (e.g. "deploy.yml") or numeric id; `inputs` (5-arity) is the
    inputs Map. Returns null on success (GitHub replies 204).

    **Example**

    ```hot
    ::github::actions/dispatch-workflow("acme", "api", "deploy.yml", "main")

    // With workflow inputs
    ::github::actions/dispatch-workflow("acme", "api", "deploy.yml", "main", {environment: "staging"})
    ```
    """
}
fn
(owner: Str, repo: Str, workflow: Any, ref: Str): Any {
  ::api/json("POST", `${workflow-path(owner, repo, workflow)}/dispatches`, {}, {ref: ref})
},
(owner: Str, repo: Str, workflow: Any, ref: Str, inputs: Map): Any {
  dispatch-workflow(owner, repo, workflow, ref, inputs, {})
},
(owner: Str, repo: Str, workflow: Any, ref: Str, inputs: Map, opts: Map): Any {
  ::api/json("POST", `${workflow-path(owner, repo, workflow)}/dispatches`, {}, dispatch-body(ref, inputs), opts)
}

// ============================================================================
// Runs and attempts
// ============================================================================

list-workflow-runs
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/runs - Recent workflow runs. `params`
    supports `branch`, `status` ("queued"/"in_progress"/"completed"),
    `event`, `per_page`, `page`. Returns a single page (GitHub default 30,
    max 100); pass `page` to paginate.

    **Example**

    ```hot
    result ::github::actions/list-workflow-runs("acme", "api", {status: "in_progress", per_page: 20})
    map(result.workflow_runs, %.id)

    // For one installation or tenant
    other ::github::actions/list-workflow-runs("acme", "api", {}, {token: ::hot::ctx/get("acme.github-token")})
    other.total_count
    ```
    """
}
fn
(owner: Str, repo: Str): Map {
  ::api/json("GET", actions-path(owner, repo, "/runs"))
},
(owner: Str, repo: Str, params: Map): Map {
  list-workflow-runs(owner, repo, params, {})
},
(owner: Str, repo: Str, params: Map, opts: Map): Map {
  ::api/json("GET", actions-path(owner, repo, "/runs") |> with-query(params), {}, "", opts)
}

get-workflow-run
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/runs/{run_id} - One run's status and
    conclusion — poll this to watch CI.

    **Example**

    ```hot
    run ::github::actions/get-workflow-run("acme", "api", 1234567890)
    if(eq(run.status, "completed"), run.conclusion, "still running")
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any): Map {
  get-workflow-run(owner, repo, run-id, {})
},
(owner: Str, repo: Str, run-id: Any, opts: Map): Map {
  ::api/json("GET", run-path(owner, repo, run-id), {}, "", opts)
}

get-workflow-run-attempt
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/runs/{run_id}/attempts/{attempt} - One
    attempt of a re-run workflow.

    **Example**

    ```hot
    attempt ::github::actions/get-workflow-run-attempt("acme", "api", 1234567890, 2)
    attempt.conclusion
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any, attempt: Any): Map {
  get-workflow-run-attempt(owner, repo, run-id, attempt, {})
},
(owner: Str, repo: Str, run-id: Any, attempt: Any, opts: Map): Map {
  ::api/json("GET", attempt-path(owner, repo, run-id, attempt), {}, "", opts)
}

list-workflow-jobs
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/runs/{run_id}/jobs - Jobs and step
    conclusions for one workflow run. `params` supports `filter`
    ("latest"/"all"), `per_page`, and `page`. This is the endpoint that
    distinguishes a checkout-step failure from a later build or test failure.

    **Example**

    ```hot
    result ::github::actions/list-workflow-jobs("acme", "api", 1234567890, {filter: "latest"})
    failed filter(result.jobs, eq(%.conclusion, "failure"))
    map(failed, %.name)
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any): Map {
  ::api/json("GET", `${run-path(owner, repo, run-id)}/jobs`)
},
(owner: Str, repo: Str, run-id: Any, params: Map): Map {
  list-workflow-jobs(owner, repo, run-id, params, {})
},
(owner: Str, repo: Str, run-id: Any, params: Map, opts: Map): Map {
  ::api/json("GET", `${run-path(owner, repo, run-id)}/jobs` |> with-query(params), {}, "", opts)
}

list-workflow-attempt-jobs
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/runs/{run_id}/attempts/{attempt}/jobs -
    Jobs and step conclusions for one workflow attempt. `params` supports
    `per_page` and `page`.

    **Example**

    ```hot
    result ::github::actions/list-workflow-attempt-jobs("acme", "api", 1234567890, 2)
    map(result.jobs, %.conclusion)
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any, attempt: Any): Map {
  ::api/json("GET", `${attempt-path(owner, repo, run-id, attempt)}/jobs`)
},
(owner: Str, repo: Str, run-id: Any, attempt: Any, params: Map): Map {
  list-workflow-attempt-jobs(owner, repo, run-id, attempt, params, {})
},
(owner: Str, repo: Str, run-id: Any, attempt: Any, params: Map, opts: Map): Map {
  ::api/json("GET", `${attempt-path(owner, repo, run-id, attempt)}/jobs` |> with-query(params), {}, "", opts)
}

get-workflow-job
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/jobs/{job_id} - One workflow job,
    including its ordered steps and each step's status and conclusion.

    **Example**

    ```hot
    job ::github::actions/get-workflow-job("acme", "api", 9876543210)
    map(job.steps, %.name)
    ```
    """
}
fn
(owner: Str, repo: Str, job-id: Any): Map {
  get-workflow-job(owner, repo, job-id, {})
},
(owner: Str, repo: Str, job-id: Any, opts: Map): Map {
  ::api/json("GET", job-path(owner, repo, job-id), {}, "", opts)
}

download-workflow-job-logs
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/jobs/{job_id}/logs - Download one
    job's plain-text log. This is the smallest useful log request after
    `list-workflow-jobs` identifies a failed checkout or test step.

    **Example**

    ```hot
    log ::github::actions/download-workflow-job-logs("acme", "api", 9876543210)
    filter(split(log, "\n"), contains(%, "error"))
    ```
    """
}
fn
(owner: Str, repo: Str, job-id: Any): Any {
  download-workflow-job-logs(owner, repo, job-id, {})
},
(owner: Str, repo: Str, job-id: Any, opts: Map): Any {
  ::api/download(`${job-path(owner, repo, job-id)}/logs`, opts)
}

download-workflow-run-logs
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/runs/{run_id}/logs - Download a
    workflow run's log archive as Bytes.

    **Example**

    ```hot
    archive ::github::actions/download-workflow-run-logs("acme", "api", 1234567890)
    ::hot::zip/entries(archive)
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any): Any {
  download-workflow-run-logs(owner, repo, run-id, {})
},
(owner: Str, repo: Str, run-id: Any, opts: Map): Any {
  ::api/download(`${run-path(owner, repo, run-id)}/logs`, opts)
}

download-workflow-attempt-logs
meta {
    doc: """
    GET /repos/{owner}/{repo}/actions/runs/{run_id}/attempts/{attempt}/logs
    - Download one attempt's log archive as Bytes.

    **Example**

    ```hot
    archive ::github::actions/download-workflow-attempt-logs("acme", "api", 1234567890, 2)
    ::hot::zip/entries(archive)
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any, attempt: Any): Any {
  download-workflow-attempt-logs(owner, repo, run-id, attempt, {})
},
(owner: Str, repo: Str, run-id: Any, attempt: Any, opts: Map): Any {
  ::api/download(`${attempt-path(owner, repo, run-id, attempt)}/logs`, opts)
}

cancel-workflow-run
meta {
    doc: """
    POST /repos/{owner}/{repo}/actions/runs/{run_id}/cancel - Cancel a
    workflow run.

    **Example**

    ```hot
    ::github::actions/cancel-workflow-run("acme", "api", 1234567890)
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any): Any {
  cancel-workflow-run(owner, repo, run-id, {})
},
(owner: Str, repo: Str, run-id: Any, opts: Map): Any {
  ::api/json("POST", `${run-path(owner, repo, run-id)}/cancel`, {}, "", opts)
}

rerun-workflow
meta {
    doc: """
    POST /repos/{owner}/{repo}/actions/runs/{run_id}/rerun - Re-run every
    job in a workflow run. The optional `options` Map supports
    `enable_debug_logging`.

    **Example**

    ```hot
    ::github::actions/rerun-workflow("acme", "api", 1234567890)

    // With step debug logs
    ::github::actions/rerun-workflow("acme", "api", 1234567890, {enable_debug_logging: true})
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any): Any {
  rerun-workflow(owner, repo, run-id, {})
},
(owner: Str, repo: Str, run-id: Any, options: Map): Any {
  rerun-workflow(owner, repo, run-id, options, {})
},
(owner: Str, repo: Str, run-id: Any, options: Map, opts: Map): Any {
  ::api/json("POST", `${run-path(owner, repo, run-id)}/rerun`, {}, options, opts)
}

rerun-failed-workflow-jobs
meta {
    doc: """
    POST /repos/{owner}/{repo}/actions/runs/{run_id}/rerun-failed-jobs -
    Re-run only failed jobs and their dependent jobs. The optional `options`
    Map supports `enable_debug_logging`.

    **Example**

    ```hot
    ::github::actions/rerun-failed-workflow-jobs("acme", "api", 1234567890)
    ```
    """
}
fn
(owner: Str, repo: Str, run-id: Any): Any {
  rerun-failed-workflow-jobs(owner, repo, run-id, {})
},
(owner: Str, repo: Str, run-id: Any, options: Map): Any {
  rerun-failed-workflow-jobs(owner, repo, run-id, options, {})
},
(owner: Str, repo: Str, run-id: Any, options: Map, opts: Map): Any {
  ::api/json("POST", `${run-path(owner, repo, run-id)}/rerun-failed-jobs`, {}, options, opts)
}

rerun-workflow-job
meta {
    doc: """
    POST /repos/{owner}/{repo}/actions/jobs/{job_id}/rerun - Re-run one
    job and its dependent jobs. The optional `options` Map supports
    `enable_debug_logging`.

    **Example**

    ```hot
    ::github::actions/rerun-workflow-job("acme", "api", 9876543210)
    ```
    """
}
fn
(owner: Str, repo: Str, job-id: Any): Any {
  rerun-workflow-job(owner, repo, job-id, {})
},
(owner: Str, repo: Str, job-id: Any, options: Map): Any {
  rerun-workflow-job(owner, repo, job-id, options, {})
},
(owner: Str, repo: Str, job-id: Any, options: Map, opts: Map): Any {
  ::api/json("POST", `${job-path(owner, repo, job-id)}/rerun`, {}, options, opts)
}
