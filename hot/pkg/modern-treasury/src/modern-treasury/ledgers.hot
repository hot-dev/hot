}
fn
(): Map {
  list-ledger-accounts({})
},
(params: Map): Map {
  list-ledger-accounts(params, {})
},
(params: Map, opts: Map): Map {
  ::api/list-page("/api/ledger_accounts", params, opts)
}

update-ledger-account
meta {
    doc: """
    PATCH /api/ledger_accounts/{id}: change `name`, `description`,
    `external_id` or `metadata`.

    **Example**

    ```hot
    ::modern-treasury::ledgers/update-ledger-account("f1c7e474-e6d5-4741-9f76-04510c8b6d7a", {name: "User 42 main wallet"})
    ```
    """
}
fn
(ledger-account-id: Str, params: Map): Map {
  update-ledger-account(ledger-account-id, params, {})
},
(ledger-account-id: Str, params: Map, opts: Map): Map {
  ::api/call("PATCH", `/api/ledger_accounts/${seg(ledger-account-id)}`, params, opts)
}

// ---------------------------------------------------------------------------
// Ledger transactions and entries
// ---------------------------------------------------------------------------

entry-total
meta {no-doc: true}
fn (entries: Vec, direction: Str): Int {
  reduce(filter(entries, (e) { eq(get(e, "direction"), direction) }), (acc, e) {
    amount get(e, "amount")
    add(acc, if(is-int(amount), amount, 0))
  }, 0)
}

is-balanced
meta {
    doc: """
    True when the Int `amount`s of the `credit` entries equal those of the
    `debit` entries. A pre-check for single-currency transactions (Modern
    Treasury checks each currency itself). Exposed for testing.

    **Example**

    ```hot
    ::modern-treasury::ledgers/is-balanced([{direction: "debit", amount: 1000}, {direction: "credit", amount: 1000}])  // true
    ::modern-treasury::ledgers/is-balanced([{direction: "debit", amount: 1000}])  // false
    ```
    """
}
fn (entries: Vec): Bool {
  eq(entry-total(entries, "credit"), entry-total(entries, "debit"))
}

invalid-entries
meta {
    doc: """
    The positions of `ledger_entries` that lack `ledger_account_id`,
    `direction` (`"credit"` or `"debit"`) or an `amount`/`amount_string`.
    Exposed for testing.

    **Example**

    ```hot
    ::modern-treasury::ledgers/invalid-entries([
      {ledger_account_id: "a", direction: "debit", amount: 1000},
      {ledger_account_id: "b", direction: "sideways", amount: 1000}
    ])  // [1]
    ```
    """
}
fn (entries: Vec): Vec<Int> {
  checked map-indexed(entries, (i, e) {
    ok and(
      is-map(e),
      is-some(get(e, "ledger_account_id")),
      in(get(e, "direction"), ["credit", "debit"]),
      or(is-some(get(e, "amount")), is-some(get(e, "amount_string")))
    )
    if(ok, null, i)
  })
  filter(checked, is-some)
}

create-ledger-transaction
meta {
    doc: """
    POST /api/ledger_transactions: record a ledger transaction.
    `params` needs `ledger_entries: [{ledger_account_id, direction,
    amount}]` (at least two, balanced per currency); optional
    `description`, `status` (`"pending"`, `"posted"`; default pending),
    `effective_at`, `effective_date`, `external_id` (unique; a second
    create with the same one fails), `metadata`, `ledgerable_type` and
    `ledgerable_id`. Each entry may set `available_balance_amount`,
    `pending_balance_amount` or `posted_balance_amount` conditions for
    balance locking. Entries missing an account, direction or amount err
    locally.

    **Example**

    ```hot
    ::modern-treasury::ledgers/create-ledger-transaction({
      description: "User 42 top-up",
      status: "posted",
      external_id: "topup-42-1",
      ledger_entries: [
        {ledger_account_id: "f1c7e474-e6d5-4741-9f76-04510c8b6d7a", direction: "debit", amount: 1000},
        {ledger_account_id: "0e0e0e0e-1111-2222-3333-444444444444", direction: "credit", amount: 1000}
      ]
    }, {idempotency-key: "topup-42-1"})
    ```
    """
}
fn
(params: Map): Map {
  create-ledger-transaction(params, {})
},
(params: Map, opts: Map): Map {
  entries get(params, "ledger_entries")
  cond {
    or(not(is-vec(entries)), lt(length(or(entries, [])), 2)) => {
      err("modern-treasury: create-ledger-transaction needs ledger_entries with at least two entries; nothing was sent")
    }

    not(is-empty(invalid-entries(entries))) => {
      err(`modern-treasury: create-ledger-transaction: ledger_entries ${join(map(invalid-entries(entries), (i) { Str(i) }), ", ")} need ledger_account_id, direction and amount; nothing was sent`)
    }
    => { ::api/create("/api/ledger_transactions", params, ["ledger_entries"], opts, "create-ledger-transaction") }
  }
}

get-ledger-transaction
meta {
    doc: """
    GET /api/ledger_transactions/{id}: retrieve a ledger transaction with
    its entries.

    **Example**

    ```hot
    transaction ::modern-treasury::ledgers/get-ledger-transaction("3e9a1f60-7c2b-4d18-a4f3-92b6d0e1c847")
    map(transaction.ledger_entries, %.amount)
    ```
    """
}
fn
(ledger-transaction-id: Str): Map {
  get-ledger-transaction(ledger-transaction-id, {})
},
(ledger-transaction-id: Str, opts: Map): Map {
  ::api/call("GET", `/api/ledger_transactions/${seg(ledger-transaction-id)}`, {}, opts)
}

list-ledger-transactions
meta {
    doc: """
    GET /api/ledger_transactions: one page. Filters: `ledger_id`,
    `ledger_account_id`, `status`, `external_id`, `ledgerable_type`,
    `ledgerable_id`, `effective_at: {gte, lte}`, `posted_at: {...}`,
    `updated_at: {...}`, `order_by: {created_at: "asc"}`, `metadata`,
    `per_page`, `after_cursor`.

    **Example**

    ```hot
    page ::modern-treasury::ledgers/list-ledger-transactions({ledger_account_id: "f1c7e474-e6d5-4741-9f76-04510c8b6d7a", status: "posted"})
    map(page.items, %.description)
    ```
    """
}
fn
(): Map {
  list-ledger-transactions({})
},
(params: Map): Map {
  list-ledger-transactions(params, {})
},
(params: Map, opts: Map): Map {
  ::api/list-page("/api/ledger_transactions", params, opts)
}

update-ledger-transaction
meta {
    doc: """
    PATCH /api/ledger_transactions/{id}: change a pending ledger
    transaction: `status` (`"posted"` or `"archived"`), `description`,
    `metadata`, `effective_at`, or its `ledger_entries`. Posted transactions
    are immutable; reverse them instead.

    **Example**

    ```hot
    transaction ::modern-treasury::ledgers/update-ledger-transaction("3e9a1f60-7c2b-4d18-a4f3-92b6d0e1c847", {status: "posted"})
    transaction.status
    ```
    """
}
fn
(ledger-transaction-id: Str, params: Map): Map {
  update-ledger-transaction(ledger-transaction-id, params, {})
},
(ledger-transaction-id: Str, params: Map, opts: Map): Map {
  ::api/call("PATCH", `/api/ledger_transactions/${seg(ledger-transaction-id)}`, params, opts)
}

reverse-ledger-transaction
meta {
    doc: """
    POST /api/ledger_transactions/{id}/reversal: post a new ledger
    transaction that undoes a posted one. `params`: `description`, `status`,
    `effective_at`, `external_id`, `metadata`.

    **Example**

    ```hot
    reversal ::modern-treasury::ledgers/reverse-ledger-transaction("3e9a1f60-7c2b-4d18-a4f3-92b6d0e1c847", {description: "Refund top-up", status: "posted"})
    reversal.id
    ```
    """
}
fn
(ledger-transaction-id: Str, params: Map): Map {
  reverse-ledger-transaction(ledger-transaction-id, params, {})
},
(ledger-transaction-id: Str, params: Map, opts: Map): Map {
  ::api/call("POST", `/api/ledger_transactions/${seg(ledger-transaction-id)}/reversal`, params, opts)
}

list-ledger-entries
meta {
    doc: """
    GET /api/ledger_entries: one page of ledger entries. Filters:
    `ledger_account_id`, `ledger_transaction_id`, `direction`, `status`,
    `effective_at: {...}`, `show_balances` (Bool, adds resulting balances),
    `order_by: {created_at: "asc"}`, `per_page`, `after_cursor`.

    **Example**

    ```hot
    page ::modern-treasury::ledgers/list-ledger-entries({ledger_account_id: "f1c7e474-e6d5-4741-9f76-04510c8b6d7a", show_balances: true})
    map(page.items, %.amount)
    ```
    """
}
fn
(): Map {
  list-ledger-entries({})
},
(params: Map): Map {
  list-ledger-entries(params, {})
},
(params: Map, opts: Map): Map {
  ::api/list-page("/api/ledger_entries", params, opts)
}
