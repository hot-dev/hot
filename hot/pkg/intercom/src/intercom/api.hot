::intercom::api ns
meta {
    ctx: {
        "intercom.token": {required: false},
        "intercom.admin.id": {required: false, secret: false},
        "intercom.region": {required: false, secret: false},
        "intercom.version": {required: false, secret: false}
    },
    doc: """
    Low-level Intercom transport: regional base URL, auth and
    `Intercom-Version` headers, `HttpError` for non-2xx responses, and the
    cursor (`starting_after`) pagination helpers the endpoint namespaces
    share.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then context variables, then defaults. Nothing from `opts` is
    written to ctx, so one run can act for many workspaces and parallel
    flows don't share credentials. A `token` from `opts` is masked in call
    records. A `token` present but blank or null is an error, never a
    fallback to `intercom.token`.

    - `token`: the access token for this call
    - `region`: `us`, `eu` or `au` for this call
    - `version`: the `Intercom-Version` for this call
    - `admin-id`: the admin to act as. It's required for acting calls that
      pass a `token`, since `intercom.admin.id` belongs to the workspace of
      `intercom.token`.
    """
}

::ctx ::hot::ctx
::uri ::hot::uri

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: or(response.headers, {}),
    body: response.body
  })
}

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

non-blank
meta {no-doc: true}
fn (value: Any): Any {
  cond {
    is-str(value) => {
      trimmed trim(value)
      if(is-empty(trimmed), null, trimmed)
    }
    => { value }
  }
}

base-url
meta {
    ctx: {"intercom.region": {required: false, secret: false}},
    doc: """
    The regional API host. The 1-arity form takes `"us"`, `"eu"` or
    `"au"` (case-insensitive; null means `us`) and returns an Err for
    anything else. The 0-arity form reads `intercom.region`.

    **Example**

    ```hot
    ::intercom::api/base-url("eu")  // "https://api.eu.intercom.io"
    ::intercom::api/base-url(null)  // "https://api.intercom.io"
    ```
    """
}
fn
(): Str {
  base-url(::ctx/get("intercom.region"))
},
(region: Str?): Str {
  key lowercase(trim(or(region, "us")))
  url get(::intercom/BASE_URLS, if(is-empty(key), "us", key))
  cond {
    is-null(url) => { err(`intercom.region must be one of us, eu, au (got '${region}')`) }
    => { url }
  }
}

api-version
meta {
    ctx: {"intercom.version": {required: false, secret: false}},
    doc: """
    The `Intercom-Version` to send: `intercom.version` when set, otherwise
    the pinned `::intercom/API_VERSION`.

    **Example**

    ```hot
    version ::intercom::api/api-version()
    ::intercom::api/request("GET", "/me", "", {version: version})
    ```
    """
}
fn (): Str {
  or(non-blank(::ctx/get("intercom.version")), ::intercom/API_VERSION)
}

resolve-from
meta {
    doc: """
    The one resolver, pure: `{token, base-url, version}` for a call from
    `opts` first, then `ctx-values` (a Map of context variables), then
    defaults. An Err when no token is set, when `token` is in `opts` but
    blank or null (that never falls back to context), or when the region
    isn't `us`, `eu` or `au`. Exposed for testing; `resolve` feeds it the
    context.

    **Example**

    ```hot
    ::intercom::api/resolve-from({region: "eu"}, {"intercom.token": "tok"}).base-url  // "https://api.eu.intercom.io"
    is-err(::intercom::api/resolve-from({token: ""}, {"intercom.token": "tok"}))  // true
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  token or(non-blank(get(opts, "token")), non-blank(get(ctx-values, "intercom.token")))
  host base-url(or(non-blank(get(opts, "region")), non-blank(get(ctx-values, "intercom.region"))))
  cond {
    and(in("token", keys(opts)), is-null(non-blank(get(opts, "token")))) => {
      err("intercom: token is in the call's opts but is blank or null. Pass a value, or leave token out to use intercom.token.")
    }

    is-null(token) => { err("intercom: intercom.token is not set. Add it in Context Variables, or pass {token: ...} in the call's opts.") }
    is-err(host) => { host }
    => {
      {
        token: token,
        base-url: host,
        version: or(non-blank(get(opts, "version")), non-blank(get(ctx-values, "intercom.version")), ::intercom/API_VERSION)
      }
    }
  }
}

resolve
meta {
    ctx: {
        "intercom.token": {required: false},
        "intercom.region": {required: false, secret: false},
        "intercom.version": {required: false, secret: false}
    },
    doc: """
    Credentials and settings for one call (see `resolve-from`). A `token`
    from `opts` is masked in call records with `::hot::ctx/mark-secret`,
    and `opts` values are never written to ctx.

    **Example**

    ```hot
    ::intercom::api/resolve({token: ::hot::ctx/get("tenant-b.intercom.token"), region: "eu"}).base-url
    ```
    """
}
fn (opts: Map): Map {
  resolved resolve-from(opts, {
    "intercom.token": ::ctx/get("intercom.token"),
    "intercom.region": ::ctx/get("intercom.region"),
    "intercom.version": ::ctx/get("intercom.version")
  })
  cond {
    is-err(resolved) => { resolved }
    in("token", keys(opts)) => { {...resolved, token: ::ctx/mark-secret(resolved.token)} }
    => { resolved }
  }
}

optional-admin-id
meta {
    ctx: {"intercom.admin.id": {required: false, secret: false}},
    doc: """
    The admin in `opts`, else `intercom.admin.id`, else null.
    `intercom.admin.id` belongs to the workspace of `intercom.token`, so it
    isn't used when `opts` has its own `token`.

    **Example**

    ```hot
    // null when nothing is configured
    ::intercom::api/optional-admin-id({admin-id: "814860"})
    ```
    """
}
fn (opts: Map): Str? {
  explicit non-blank(get(opts, "admin-id"))
  id if(in("token", keys(opts)), explicit, or(explicit, non-blank(::ctx/get("intercom.admin.id"))))
  if(is-null(id), null, Str(id))
}

admin-id
meta {
    ctx: {"intercom.admin.id": {required: false, secret: false}},
    doc: """
    The admin to act as (see `optional-admin-id`), or an Err with a hint
    when there is none: look it up with `::intercom::admins/me()`.

    **Example**

    ```hot
    // Reads intercom.admin.id
    admin ::intercom::api/admin-id()

    // A token in opts needs its own admin-id
    tenant ::intercom::api/admin-id({token: ::hot::ctx/get("tenant-b.intercom.token"), admin-id: "814860"})
    ```
    """
}
fn
(): Str {
  admin-id({})
},
(opts: Map): Str {
  id optional-admin-id(opts)
  cond {
    is-null(id) => {
      err("intercom: no admin to act as. Set intercom.admin.id, or pass {admin-id: ...} in the call's opts; ::intercom::admins/me() returns the token's admin. A token in opts needs its own admin-id.")
    }
    => { id }
  }
}

with-admin
meta {
    doc: """
    Run `action` with the admin to act as. A problem with the call's
    credentials, or a missing admin, comes back as an Err before anything is
    sent.

    **Example**

    ```hot
    ::intercom::api/with-admin({}, (admin) {
      ::intercom::api/request("POST", "/conversations/215473041/reply", {
        message_type: "note",
        type: "admin",
        admin_id: admin,
        body: "Checked the logs."
      })
    })
    ```
    """
}
fn (opts: Map, action: Fn): Any {
  resolved resolve(opts)
  admin admin-id(opts)
  cond {
    is-err(resolved) => { resolved }
    is-err(admin) => { admin }
    => { action(admin) }
  }
}

build-headers
meta {
    doc: """
    Request headers: Bearer auth, `Intercom-Version`, `Accept:
    application/json`, and `Content-Type` only when there is a body. Exposed
    for testing.

    **Example**

    ```hot
    ::intercom::api/build-headers("tok", "2.17", false)  // {Authorization: "Bearer tok", Intercom-Version: "2.17", Accept: "application/json"}
    ::intercom::api/build-headers("tok", "2.17", true).Content-Type  // "application/json"
    ```
    """
}
fn (token: Str, version: Str, has-body: Bool): Map {
  base {
    Authorization: `Bearer ${token}`,
    Intercom-Version: version,
    Accept: "application/json"
  }

  if(has-body, {...base, Content-Type: "application/json"}, base)
}

response-body
meta {
    doc: """
    Normalize a decoded 2xx body: empty text (202/204 with no content, e.g.
    data events) becomes null; anything else passes through. Exposed for
    testing.

    **Example**

    ```hot
    ::intercom::api/response-body("  ")  // null
    ::intercom::api/response-body({id: "1"})  // {id: "1"}
    ```
    """
}
fn (body: Any): Any {
  match body {
    Str => { if(is-empty(trim(body)), null, body) }
    _ => { body }
  }
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

send
meta {no-doc: true}
fn (method: Str, path: Str, body: Any, resolved: Map): Any {
  has-body not(eq(body, ""))
  response ::hot::http/request(HttpRequest({
    method,
    url: `${resolved.base-url}${path}`,
    headers: build-headers(resolved.token, resolved.version, has-body),
    body: if(has-body, to-json(untype(body)), "")
  }))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response-body(response.body) }
    => { err(HttpError(response)) }
  }
}

request
meta {
    ctx: {"intercom.token": {required: false}},
    doc: """
    Make an authenticated Intercom request. `path` is relative to the
    regional host (e.g. `/contacts`); `body` is a Map, or `""` for none.
    Returns the decoded body on 2xx (null when empty), or an Err carrying
    `HttpError` (Intercom's `errors` list is in `body`). The 4th argument
    is per-call `opts` (see `resolve`) or an access token.

    **Example**

    ```hot
    segments ::intercom::api/request("GET", "/segments", "")
    tenant ::intercom::api/request("GET", "/segments", "", {token: ::hot::ctx/get("tenant-b.intercom.token"), region: "eu"})
    ```
    """
}
fn
(method: Str, path: Str, body: Any): Any {
  request(method, path, body, {})
},
// 4-arity: explicit access token override (e.g. an OAuth token per workspace)
(method: Str, path: Str, body: Any, token: Str): Any {
  request(method, path, body, {token: token})
},
// 4-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, body: Any, opts: Map): Any {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { send(method, path, body, resolved) }
  }
}

path-segment
meta {
    doc: """
    Percent-encode one path segment (an id). Ints pass through as text.

    **Example**

    ```hot
    ::intercom::api/path-segment("a/b")  // "a%2Fb"
    ::intercom::api/path-segment(42)  // "42"
    ```
    """
}
fn (value: Any): Str {
  ::uri/encode(Str(value))
}

query-string
meta {
    doc: """
    Build a `?a=1` suffix from a Map, dropping null values; `""` when
    nothing remains.

    **Example**

    ```hot
    ::intercom::api/query-string({per_page: 20, starting_after: null})  // "?per_page=20"
    ::intercom::api/query-string({})  // ""
    ```
    """
}
fn (options: Map): Str {
  ::uri/query-string(options)
}

compact
meta {
    doc: """
    Drop null-valued keys so unset optionals are omitted rather than sent as
    JSON null.

    **Example**

    ```hot
    ::intercom::api/compact({name: "Ada", phone: null})  // {name: "Ada"}
    ```
    """
}
fn (body: Map): Map {
  filter-vals(body, is-some)
}

// ---------------------------------------------------------------------------
// Pagination
// ---------------------------------------------------------------------------

build-search-body
meta {
    doc: """
    Build a `POST /…/search` body: `{query, pagination?, sort?}`.
    `options`: `per_page` (max 150), `starting_after` (the cursor from
    the previous page's `pages.next.starting_after`), and `sort`
    (`{field, order: "ascending"|"descending"}`, contacts only). The
    pagination object is omitted when neither is set. Exposed for testing.

    **Example**

    ```hot
    query {field: "open", operator: "=", value: true}
    ::intercom::api/build-search-body(query, {per_page: 50}).pagination  // {per_page: 50}
    ::intercom::api/build-search-body(query, {})  // {query: {field: "open", operator: "=", value: true}}
    ```
    """
}
fn (query: Map, options: Map): Map {
  pagination compact({per_page: get(options, "per_page"), starting_after: get(options, "starting_after")})
  compact({
    query: query,
    pagination: if(is-empty(pagination), null, pagination),
    sort: get(options, "sort")
  })
}

next-cursor
meta {
    doc: """
    The `starting_after` cursor for the page after `page` (from
    `pages.next.starting_after`), or null on the last page. Works for list
    and search responses.

    **Example**

    ```hot
    ::intercom::api/next-cursor({pages: {next: {starting_after: "WzE3"}}})  // "WzE3"
    ::intercom::api/next-cursor({pages: {}})  // null
    ```
    """
}
fn (page: Any): Str? {
  next get(or(get(or(page, {}), "pages"), {}), "next")
  match next {
    Map => { get(next, "starting_after") }
    _ => { null }
  }
}

collect-pages
meta {
    doc: """
    Follow `starting_after` cursors, concatenating each page's `key`
    Vec (e.g. `"conversations"`, `"contacts"`, `"tickets"`, `"data"`),
    until `limit` items or the last page. `fetch` is a Fn taking the
    cursor (null for the first page) and returning one page. Exposed for
    testing; the `search-all-*` functions use it. A failed page comes back as its Err.

    **Example**

    ```hot
    fetch (cursor) {
      if(is-null(cursor), {data: [1, 2], pages: {next: {starting_after: "p2"}}}, {data: [3], pages: {}})
    }
    ::intercom::api/collect-pages(fetch, "data", null, 10, [])  // [1, 2, 3]
    ::intercom::api/collect-pages(fetch, "data", null, 2, [])  // [1, 2]
    ```
    """
}
fn (fetch: Fn, key: Str, cursor: Str?, limit: Int, acc: Vec): Vec {
  cond {
    lte(limit, length(acc)) => { slice(acc, 0, max(limit, 0)) }
    => {
      page fetch(cursor)
      cond {
        is-err(page) => { page }
        => {
          items or(get(page, key), [])
          combined concat(acc, items)
          next next-cursor(page)
          cond {
            gte(length(combined), limit) => { slice(combined, 0, limit) }
            is-empty(items) => { combined }
            is-null(next) => { combined }
            => { collect-pages(fetch, key, next, limit, combined) }
          }
        }
      }
    }
  }
}

page-size
meta {
    doc: """
    The `per_page` to request when collecting up to `limit` items: `limit`
    clamped to 1..150 (Intercom's maximum).

    **Example**

    ```hot
    ::intercom::api/page-size(500)  // 150
    ::intercom::api/page-size(25)  // 25
    ```
    """
}
fn (limit: Int): Int {
  max(1, min(150, limit))
}
