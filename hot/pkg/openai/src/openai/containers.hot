}

ListContainersRequest type {
  limit: Str,
  order: Str,
  after: Str
}

ListContainersResponse type {
    object: Any,
    data: Vec<ContainerResource>,
    first_id: Str?,
    last_id: Str?,
    has_more: Bool
}


list-containers
meta {
    doc: """
    GET /containers - List all containers. Supports pagination with limit,
    order, and after parameters.

    **Example**

    ```hot
    page ::openai::containers/list-containers({limit: "20", order: "desc"})
    map(page.data, %.id)
    page.has_more
    ```
    """
}
fn
(request: ListContainersRequest): ListContainersResponse {
  list-containers(request, {})
},
(request: ListContainersRequest, opts: Map): ListContainersResponse {
  response api-request("GET", `/containers?limit=${request.limit}&order=${request.order}&after=${request.after}`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ListContainersResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

