::name-screening::integration::ctx ns

::env ::hot::env

// Live smoke tests read one public web page, so they only run when
// NAME_SCREENING_LIVE=1.

live
meta {doc: """True when NAME_SCREENING_LIVE=1: the live tests may run."""}
fn (): Bool {
    eq(::env/get("NAME_SCREENING_LIVE", ""), "1")
}

skip
meta {doc: """Record a skip and pass."""}
fn (why: Str): Bool {
    println(`name-screening integration: ${why} - skipping`)
    assert(true, `skipped: ${why}`)
}
