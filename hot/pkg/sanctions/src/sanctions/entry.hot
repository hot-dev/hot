::sanctions::entry ns
meta {
    doc: """
    The normalized `Entry` record every list parser produces, and the
    helpers parsers share: building an entry without empty values, and
    normalizing dates of birth to ISO 8601 (`YYYY-MM-DD`, `YYYY-MM` or
    `YYYY`; a range is `YYYY/YYYY`).
    """
}

::re ::hot::regex

EntryKind
meta {
    doc: """What a listed party is: `"individual"`, `"entity"` (companies, organizations, groups), `"vessel"` or `"aircraft"`."""
}
type "individual" | "entity" | "vessel" | "aircraft"

Entry
meta {
    doc: """
    One listed party, normalized across sources.

    **Fields**
    - `source` — dataset key: `"ofac-sdn"`, `"ofac-cons"`, `"uk"`, `"eu"` or `"un"`
    - `list` — the human-readable list name, e.g. `"OFAC SDN List"`
    - `id` — the source's own identifier (OFAC `ent_num`, UK Unique ID,
      EU logical id, UN reference number)
    - `kind` — an `EntryKind`
    - `name` — the primary name as published
    - `aliases` — other names (a.k.a., f.k.a., name variations, original script)
    - `dobs` — dates of birth: `YYYY-MM-DD`, `YYYY-MM`, `YYYY`, or a range `YYYY/YYYY`
    - `nationalities` — nationality or citizenship countries (ISO 3166-1
      alpha-2 when known, else as published)
    - `programs` — sanctions programs or regimes (OFAC program tags, UK
      regime names, EU programme codes, UN list types)
    - `addresses` — brief one-line addresses
    - `remarks` — free-text remarks, possibly truncated
    - `url` — where the source publishes the list
    """
}
type {
    source: Str,
    list: Str,
    id: Str,
    kind: EntryKind,
    name: Str,
    aliases: Vec<Str>,
    dobs: Vec<Str>,
    nationalities: Vec<Str>,
    programs: Vec<Str>,
    addresses: Vec<Str>,
    remarks: Str?,
    url: Str?
}

present
meta {
    doc: """True for a non-null value that is not a blank string."""
}
fn (v: Any): Bool {
  match v {
    Null => { false }
    Str => { not(is-empty(trim(v))) }
    _ => { true }
  }
}

clean-list
meta {
    doc: """Trim strings, drop blanks and duplicates, keep the first-seen order."""
}
fn (values: Vec): Vec<Str> {
  distinct(map(filter(values, present), (v) { trim(Str(v)) }))
}

MAX_REMARKS 2000

make
meta {
    doc: """
    Build an `Entry` from a Map of the fields above, cleaning the list
    fields (trimmed, no blanks, no duplicates, aliases without the
    primary name), dropping a blank `remarks`, and capping remarks at
    2000 characters.
    """
}
fn (m: Map): Entry {
  name trim(Str(or(m.name, "")))
  aliases filter(clean-list(or(m.aliases, [])), (a) { ne(lowercase(a), lowercase(name)) })
  remarks if(present(m.remarks), trim(m.remarks), null)
  Entry({
    source: m.source,
    list: m.list,
    id: trim(Str(or(m.id, ""))),
    kind: m.kind,
    name: name,
    aliases: aliases,
    dobs: clean-list(or(m.dobs, [])),
    nationalities: clean-list(or(m.nationalities, [])),
    programs: clean-list(or(m.programs, [])),
    addresses: clean-list(or(m.addresses, [])),
    remarks: if(and(is-some(remarks), gt(length(remarks), MAX_REMARKS)), `${slice(remarks, 0, MAX_REMARKS)}…`, remarks),
    url: m.url
  })
}

// ---------------------------------------------------------------------------
// Dates of birth
// ---------------------------------------------------------------------------

MONTHS {
  jan: "01", feb: "02", mar: "03", apr: "04", may: "05", jun: "06",
  jul: "07", aug: "08", sep: "09", oct: "10", nov: "11", dec: "12"
}

pad2 fn (s: Str): Str {
  if(eq(length(s), 1), `0${s}`, s)
}

iso-date
meta {
    doc: """
    Normalize one published date of birth to ISO 8601, or null when it
    has no year. Accepts `1948-12-10`, `10 Dec 1948`, `Dec 1948`,
    `1948`, `circa 1948`, `10/12/1948` and `dd/mm/1948` (UK, day
    first), and ranges such as `1959 to 1962` or `01 Jan 1960 to 31
    Dec 1962` (`1959/1962`, `1960/1962`).

    **Example**

    ```hot
    ::sanctions::entry/iso-date("10 Dec 1948")  // "1948-12-10"
    ::sanctions::entry/iso-date("dd/mm/1963")   // "1963"
    ::sanctions::entry/iso-date("1959 to 1962") // "1959/1962"
    ```
    """
}
fn (raw: Str?): Str? {
  s lowercase(trim(or(raw, "")))
  years map(::re/find-all(s, "\\d{4}"), (m) { m.match })
  is-range and(gte(length(years), 2), ::re/is-match(s, "\\d{4}.*(?:\\bto\\b|–|\\d{4}\\s*/\\s*\\d{4}$)"))
  iso ::re/capture(s, "^(\\d{4})-(\\d{1,2})-(\\d{1,2})")
  dmy ::re/capture(s, "^(\\d{1,2})\\s+([a-z]{3})[a-z]*\\.?\\s+(\\d{4})")
  my ::re/capture(s, "^([a-z]{3})[a-z]*\\.?\\s+(\\d{4})")
  slash ::re/capture(s, "^(\\d{1,2}|dd)/(\\d{1,2}|mm)/(\\d{4})")
  year ::re/capture(s, "(\\d{4})")
  cond {
    is-range => { `${first(years)}/${last(years)}` }
    is-some(iso) => { `${iso.groups[0]}-${pad2(iso.groups[1])}-${pad2(iso.groups[2])}` }
    and(is-some(dmy), is-some(get(MONTHS, dmy.groups[1]))) => {
      `${dmy.groups[2]}-${get(MONTHS, dmy.groups[1])}-${pad2(dmy.groups[0])}`
    }

    and(is-some(my), is-some(get(MONTHS, my.groups[0]))) => { `${my.groups[1]}-${get(MONTHS, my.groups[0])}` }
    is-some(slash) => {
      d slash.groups[0]
      m slash.groups[1]
      y slash.groups[2]
      cond {
        eq(m, "mm") => { y }
        eq(d, "dd") => { `${y}-${pad2(m)}` }
        => { `${y}-${pad2(m)}-${pad2(d)}` }
      }
    }

    is-some(year) => { year.groups[0] }
    => { null }
  }
}

year-range
meta {
    doc: """The `[from, to]` years an ISO date of birth covers (`"1959/1962"` → `[1959, 1962]`, `"1948-12-10"` → `[1948, 1948]`), or null."""
}
fn (dob: Str): Vec? {
  // WORKAROUND(hot-bug-6): Int() only sees strings a regex has already proven numeric.
  r ::re/capture(dob, "^(\\d{4})/(\\d{4})$")
  y ::re/capture(dob, "^(\\d{4})")
  cond {
    is-some(r) => { [Int(r.groups[0]), Int(r.groups[1])] }
    is-some(y) => { [Int(y.groups[0]), Int(y.groups[0])] }
    => { null }
  }
}
