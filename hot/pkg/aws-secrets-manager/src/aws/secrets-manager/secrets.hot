// List secrets
list-secrets
meta {
    doc: """
    List all secrets in the account.

    **Example**

    ```hot
    result ::aws::secrets-manager::secrets/list-secrets(10)
    result.secrets
    // => [{name: "my-app/api-key", arn: "arn:aws:...", ...}, ...]
    ```
    """
}
fn
(max_results: Int, next_token: Str?, filters: Vec<Map>?, opts: Map): ListSecretsResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${service-url(resolved, "secretsmanager")}/`

        request-body {}

        with-filters merge(request-body, filter-vals({
            MaxResults: max_results,
            NextToken: next_token,
            Filters: filters
        }, is-some))

        body to-json(with-filters)

        headers {
            "Content-Type": "application/x-amz-json-1.1",
            "X-Amz-Target": "secretsmanager.ListSecrets"
        }

        response send-signed("POST", url, "secretsmanager", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { ListSecretsResponse({
                secrets: cond {
                    is-null(response.body.SecretList) => { [] }
                    => { map(response.body.SecretList, SecretMetadata({
                    arn: %.ARN,
                    name: %.Name,
                    description: %.Description,
                    kms_key_id: %.KmsKeyId,
                    rotation_enabled: %.RotationEnabled,
                    rotation_lambda_arn: %.RotationLambdaARN,
                    rotation_rules: %.RotationRules,
                    last_rotated_date: opt-str(%.LastRotatedDate),
                    last_changed_date: opt-str(%.LastChangedDate),
                    last_accessed_date: opt-str(%.LastAccessedDate),
                    deleted_date: opt-str(%.DeletedDate),
                    tags: %.Tags,
                    primary_region: %.PrimaryRegion,
                    created_date: opt-str(%.CreatedDate)
                })) }
                },
                next_token: response.body.NextToken
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(max_results: Int, opts: Map): ListSecretsResponse | AwsError {
    list-secrets(max_results, null, null, opts)
},
(opts: Map): ListSecretsResponse | AwsError {
    list-secrets(100, null, null, opts)
},
(max_results: Int, next_token: Str?, filters: Vec<Map>?): ListSecretsResponse | AwsError {
    list-secrets(max_results, next_token, filters, {})
},
(max_results: Int): ListSecretsResponse | AwsError {
    list-secrets(max_results, null, null)
},
(): ListSecretsResponse | AwsError {
    list-secrets(100, null, null)
}

// Rotate a secret
rotate-secret
meta {
    doc: """
    Trigger rotation of a secret using its configured rotation Lambda.

    **Example**

    ```hot
    ::aws::secrets-manager::secrets/rotate-secret("my-app/db-password")
    ```
    """
}
fn
(secret_id: Str, rotation_lambda_arn: Str?, rotation_rules: Map?, opts: Map): CreateSecretResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${service-url(resolved, "secretsmanager")}/`

        request-body {
            SecretId: secret_id
        }

        with-rules merge(request-body, filter-vals({
            RotationLambdaARN: rotation_lambda_arn,
            RotationRules: rotation_rules
        }, is-some))

        body to-json(with-rules)

        headers {
            "Content-Type": "application/x-amz-json-1.1",
            "X-Amz-Target": "secretsmanager.RotateSecret"
        }

        response send-signed("POST", url, "secretsmanager", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { CreateSecretResponse({
                arn: response.body.ARN,
                name: response.body.Name,
                version_id: response.body.VersionId
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(secret_id: Str, opts: Map): CreateSecretResponse | AwsError {
    rotate-secret(secret_id, null, null, opts)
},
(secret_id: Str, rotation_lambda_arn: Str?, rotation_rules: Map?): CreateSecretResponse | AwsError {
    rotate-secret(secret_id, rotation_lambda_arn, rotation_rules, {})
},
(secret_id: Str): CreateSecretResponse | AwsError {
    rotate-secret(secret_id, null, null)
}
