::supabase::admin::organizations ns

::api ::supabase::admin::api

Organization type {
  id: Str?,
  slug: Str?,
  name: Str?
}

OrganizationMember type {
  user_id: Str?,
  user_name: Str?,
  role_name: Str?,
  email: Str?
}

// ============================================================================
// Organization CRUD
// ============================================================================

list-organizations
meta {
    doc: """
List all organizations the authenticated user belongs to.

**Example**

```hot
::orgs ::supabase::admin::organizations

orgs ::orgs/list-organizations()
// => [{id: "org-123", name: "My Team", ...}, ...]
```
"""
}
fn
(): Vec<Organization> {
  list-organizations({})
},
(opts: Map): Vec<Organization> {
  ::api/request("GET", "/organizations", {}, {}, opts)
}

get-organization
meta {
    doc: """
    Get details for a specific organization by slug.

    **Example**

    ```hot
    ::orgs ::supabase::admin::organizations

    org ::orgs/get-organization("my-org-slug")
    org.name
    ```
    """
}
fn
(slug: Str): Organization {
  get-organization(slug, {})
},
(slug: Str, opts: Map): Organization {
  ::api/request("GET", `/organizations/${slug}`, {}, {}, opts)
}

CreateOrganizationRequest type {
  name: Str
}

create-organization
meta {
    doc: """
Create a new organization.

**Example**

```hot
::orgs ::supabase::admin::organizations

org ::orgs/create-organization(::orgs/CreateOrganizationRequest({
  name: "My New Team"
}))
org.id  // => "org-abc-123"
```
"""
}
fn
(request: CreateOrganizationRequest): Organization {
  create-organization(request, {})
},
(request: CreateOrganizationRequest, opts: Map): Organization {
  ::api/request("POST", "/organizations", {}, untype(request), opts)
}

// ============================================================================
// Members
// ============================================================================

list-members
meta {
    doc: """
List members of an organization.

**Example**

```hot
::orgs ::supabase::admin::organizations

members ::orgs/list-members("my-org-slug")
// => [{user_id: "...", user_name: "...", role_name: "Owner", ...}, ...]
```
"""
}
fn
(slug: Str): Vec<OrganizationMember> {
  list-members(slug, {})
},
(slug: Str, opts: Map): Vec<OrganizationMember> {
  ::api/request("GET", `/organizations/${slug}/members`, {}, {}, opts)
}

// ============================================================================
// Projects
// ============================================================================

list-organization-projects
meta {
    doc: """
    List all projects belonging to an organization.

    **Example**

    ```hot
    ::orgs ::supabase::admin::organizations

    projects ::orgs/list-organization-projects("my-org-slug")
    map(projects, %.name)
    ```
    """
}
fn
(slug: Str): Vec<Map> {
  list-organization-projects(slug, {})
},
(slug: Str, opts: Map): Vec<Map> {
  ::api/request("GET", `/organizations/${slug}/projects`, {}, {}, opts)
}
