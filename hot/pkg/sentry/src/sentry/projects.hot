::sentry::projects ns
meta {
    doc: """Sentry projects and teams in the organization.""",
    ctx: {"sentry.token": {required: true}, "sentry.org": {required: true}}
}

::api ::sentry::api

Page ::sentry::api/Page

list-projects
meta {
    doc: """GET /organizations/{org}/projects/ - One page of the organization's projects (`query`, `per_page`, `cursor`). Returns a `Page`."""
}
fn
(): Page {
  list-projects({})
},
(params: Map): Page {
  ::api/org-page("/projects/", params)
}

list-all-projects
meta {
    doc: """Every project in the organization, following cursors up to `max` (default 1000)."""
}
fn
(): Vec {
  list-all-projects(::api/DEFAULT_MAX_ITEMS)
},
(max: Int): Vec {
  ::api/collect-pages(list-projects, {}, max)
}

get-project
meta {
    doc: """GET /projects/{org}/{project}/ - One project by slug or id: platform, teams, options."""
}
fn (project: Str): Map {
  slug ::api/org()
  cond {
    is-err(slug) => { slug }
    => { ::api/json("GET", `/projects/${::api/seg(slug)}/${::api/seg(project)}/`) }
  }
}

list-teams
meta {
    doc: """GET /organizations/{org}/teams/ - One page of teams (`query`, `detailed`, `per_page`, `cursor`). Returns a `Page`."""
}
fn
(): Page {
  list-teams({})
},
(params: Map): Page {
  ::api/org-page("/teams/", params)
}

list-all-teams
meta {
    doc: """Every team in the organization, following cursors up to `max` (default 1000)."""
}
fn
(): Vec {
  list-all-teams(::api/DEFAULT_MAX_ITEMS)
},
(max: Int): Vec {
  ::api/collect-pages(list-teams, {}, max)
}
