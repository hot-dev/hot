::discord::guilds ns
meta {
    doc: """
    Guilds: settings, members (list, search, modify, timeout, kick),
    roles, bans (single and bulk), custom emoji, prune, the audit log, and
    invites.

    Moderation and modify calls accept `reason`, recorded in the guild
    audit log (sent as the URL-encoded `X-Audit-Log-Reason` header).
    """
}

::api ::discord::api

seg ::discord::api/seg

// ============================================================================
// Guild
// ============================================================================

GetGuildRequest type {
  guild_id: Str,
  with_counts: Bool?
}

get-guild
meta {
    doc: """
    GET /guilds/{guild_id} - A guild. `with_counts: true` adds
    `approximate_member_count` and `approximate_presence_count`.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    guild ::guilds/get-guild(::guilds/GetGuildRequest({guild_id: "1000000000000000000", with_counts: true}))
    guild.approximate_member_count
    ```
    """
}
fn
(request: GetGuildRequest): Map {
  get-guild(request, {})
},
(request: GetGuildRequest, opts: Map): Map {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}`, {query: {with_counts: request.with_counts}}, opts)
}

