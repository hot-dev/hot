::documents::source ns
meta {
    doc: """
    Source descriptors and the per-call options resolver.

    A source descriptor is a Map naming the provider, its scope and the
    provider options (credentials, settings) for every call on it:

    | Provider | Descriptor |
    |---|---|
    | Google Drive | `{provider: "google-drive", drive-id?, opts}` (`drive-id`: a shared drive) |
    | OneDrive / SharePoint | `{provider: "onedrive", drive?, opts}` (`drive`: `"me"`, a drive id, or `{drive-id}` / `{user}` / `{site}` / `{group}`) |
    | Dropbox | `{provider: "dropbox", root?, opts}` (`root`: a folder path, default the whole account) |
    | Box | `{provider: "box", folder-id?, opts}` (default `"0"`, the root) |
    | Amazon S3 | `{provider: "s3", bucket, prefix?, opts}` |

    A bare provider name (`"box"`) is a descriptor with the default scope
    and context credentials. Aliases are accepted: `google`, `drive`,
    `microsoft-onedrive`, `sharepoint`, `aws-s3`.

    **Options.** `provider-opts(source, opts)` merges the call's `opts`
    over the descriptor's `opts` and drops this package's own keys
    (`cursor`, `page-size`, `limit`, `mime-type`, `max-pages`). The
    result goes straight to the provider package, which resolves
    credentials as it always does: keys in opts first, then context.
    This package never reads or writes context itself.
    """
}

PROVIDERS ["google-drive", "onedrive", "dropbox", "box", "s3"]

ALIASES {
    "google-drive": "google-drive",
    google: "google-drive",
    drive: "google-drive",
    onedrive: "onedrive",
    "microsoft-onedrive": "onedrive",
    sharepoint: "onedrive",
    "microsoft-sharepoint": "onedrive",
    dropbox: "dropbox",
    box: "box",
    s3: "s3",
    "aws-s3": "s3"
}

// The scope keys each provider's descriptor may carry.
SCOPE_KEYS {
    "google-drive": ["drive-id"],
    onedrive: ["drive"],
    dropbox: ["root"],
    box: ["folder-id"],
    s3: ["bucket", "prefix"]
}

// Keys of a call's opts that this package consumes (never sent to a provider).
LOCAL_KEYS ["cursor", "page-size", "limit", "mime-type", "max-pages", "folder-scope"]

is-blank
meta {doc: """True for null, `""` and whitespace-only strings (pure)."""}
fn (value: Any): Bool {
  or(is-null(value), and(is-str(value), is-empty(trim(value))))
}

provider-name
meta {
    doc: """
    The canonical provider name for a name, alias, or descriptor Map
    (pure): `"google-drive"`, `"onedrive"`, `"dropbox"`, `"box"` or `"s3"`.
    An Err names the supported providers.
    """
}
fn (value: Any): Str {
  raw cond {
    is-map(value) => { get(value, "provider") }
    => { value }
  }

  name if(is-str(raw), get(ALIASES, lowercase(trim(raw))), null)
  cond {
    is-blank(raw) => { err(`documents: a source needs a provider (${join(PROVIDERS, ", ")})`) }
    is-null(name) => { err(`documents: unknown provider "${raw}"; use ${join(PROVIDERS, ", ")}`) }
    => { name }
  }
}

resolve
meta {
    doc: """
    Normalise a source descriptor (pure): `{provider, opts, ...scope}`
    with the canonical provider name, `opts` defaulting to `{}`, and blank
    scope values dropped. An S3 source without a `bucket` is an Err.

    ```hot
    ::documents::source/resolve({provider: "SharePoint", drive: "b!abc"})
    // {provider: "onedrive", drive: "b!abc", opts: {}}
    ```
    """
}
fn (source: Any): Map {
  name provider-name(source)
  cond {
    is-err(name) => { name }
    => {
      given if(is-map(source), source, {})
      scope-keys get(SCOPE_KEYS, name)
      scope reduce(scope-keys, (acc, k) {
        v get(given, k)
        if(is-blank(v), acc, assoc(acc, k, v))
      }, {})
      opts get(given, "opts")
      cond {
        and(eq(name, "s3"), is-null(get(scope, "bucket"))) => { err("documents: an s3 source needs a bucket") }
        and(is-some(opts), not(is-map(opts))) => { err("documents: a source's opts must be a Map") }
        => { {provider: name, ...scope, opts: or(opts, {})} }
      }
    }
  }
}

source-id
meta {
    doc: """The identifying part of a resolved source (pure): `provider` plus its scope keys, never `opts` (so no credentials end up in a `Document`)."""
}
fn (source: Map): Map {
  filter-keys(source, (k) { ne(k, "opts") })
}

provider-opts
meta {
    doc: """
    The options a provider call gets (pure): the source's `opts`, then
    the call's `opts` over them, without this package's own keys
    (`LOCAL_KEYS`). Credentials in the call override the source's, and
    both override context inside the provider package.
    """
}
fn (source: Map, opts: Map): Map {
  call-opts filter-keys(opts, (k) { not(in(k, LOCAL_KEYS)) })
  {...or(get(source, "opts"), {}), ...call-opts}
}

page-size
meta {
    doc: """The page size for a call (pure): `opts.page-size` within 1..`max`, else `default`."""
}
fn (opts: Map, default: Int, max-size: Int): Int {
  n get(opts, "page-size")
  if(is-int(n), min(max(n, 1), max-size), default)
}
