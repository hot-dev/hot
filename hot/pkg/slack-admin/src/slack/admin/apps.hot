meta {
    doc: """
    admin.apps.requests.list - List pending install requests (`app_requests`).

    Scope: `admin.apps:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `requests-list-all`.

    **Example**

    ```hot
    ::apps ::slack::admin::apps

    page ::apps/requests-list(::apps/RequestsListRequest({team_id: "T0123ABCDEF", limit: 100}))
    map(page.app_requests, %.id)

    // As another organization
    ::apps/requests-list(::apps/RequestsListRequest({team_id: "T0123ABCDEF"}), {token: ::hot::ctx/get("tenant-b.slack.admin.token")})
    ```
    """
}
fn
(): Map {
