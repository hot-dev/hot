::qdrant ns
meta {
    doc: """
    Qdrant vector database bindings — the self-hosted/open-source RAG
    store (Qdrant Cloud works identically). Same shape as the `pinecone`
    package: collections + points.

    **Setup** — context variables:
    - `qdrant.url` — e.g. `http://localhost:6333` or your cloud cluster URL
    - `qdrant.api.key` — optional for local, required for cloud

    Every API function also takes a trailing `opts` Map, so one run can use
    several instances: `{url: ..., api-key: ...}` replaces the context
    values for that call. A per-call `url` never borrows the context key.

    **Quick start**

    ```hot
    ::qd ::qdrant

    ::qd/create-collection("docs", 1536)
    ::qd/upsert-points("docs", [
      {id: 1, vector: embedding, payload: {source: "guide.md"}}
    ])
    hits ::qd/search("docs", {vector: question-embedding, limit: 5, with_payload: true})
    map(hits, (h) { h.payload.source })
    ```
    """
}

::ctx ::hot::ctx

base-url
meta {
    ctx: {"qdrant.url": {required: false, secret: false}},
    doc: """The instance URL without a trailing slash: the `qdrant.url` context variable or the local default, or the given URL."""
}
fn
(): Str {
  base-url(or(::ctx/get("qdrant.url"), "http://localhost:6333"))
},
(url: Str): Str {
  if(ends-with(url, "/"), slice(url, 0, sub(length(url), 1)), url)
}

request
meta {
    ctx: {"qdrant.url": {required: false, secret: false}, "qdrant.api.key": {required: false}},
    doc: """The request behind every function: `opts` (`{url, api-key}`), then the context variables, then the local default (see `::qdrant::api/resolve`)."""
}
fn
(method: Str, path: Str, body: Any): Any {
  request(method, path, body, {})
},
// 4-arity: per-call opts ({url, api-key}), then ctx, then the local default
(method: Str, path: Str, body: Any, opts: Map): Any {
  resolved ::qdrant::api/resolve(opts)
  request(method, path, body, resolved.url, resolved.api-key)
},
// 5-arity: explicit instance URL + API key override ("" sends no auth header)
(method: Str, path: Str, body: Any, url: Str, api-key: Str): Any {
  base-headers cond {
    is-empty(api-key) => { {} }
    => { {api-key: api-key} }
  }

  headers cond {
    eq(body, "") => { base-headers }
    => { {...base-headers, Content-Type: "application/json"} }
  }

  encoded if(eq(body, ""), "", to-json(untype(body)))
  response ::hot::http/request(::hot::http/HttpRequest({
    method,
    url: `${base-url(url)}${path}`,
    headers: headers,
    body: encoded
  }))
  cond {
    is-err(response) => { response }
    ::hot::http/is-ok-response(response) => { get(response.body, "result", response.body) }
    => { err({status: response.status, body: response.body}) }
  }
}

// ---------------------------------------------------------------------------
// Collections
// ---------------------------------------------------------------------------

list-collections
meta {
    ctx: {"qdrant.url": {required: false, secret: false}, "qdrant.api.key": {required: false}},
    doc: """GET /collections - The instance's collections."""
}
fn
(): Map {
  list-collections({})
},
(opts: Map): Map {
  request("GET", "/collections", "", opts)
}

create-collection
meta {
    doc: """PUT /collections/{name} - Create a collection. The 3-arity form sets the distance metric ("Cosine" default, "Euclid", "Dot") or takes `opts`; the 4-arity form takes both."""
}
fn
(name: Str, dimension: Int): Any {
  create-collection(name, dimension, "Cosine")
},
(name: Str, dimension: Int, opts: Map): Any {
  create-collection(name, dimension, "Cosine", opts)
},
(name: Str, dimension: Int, distance: Str): Any {
  create-collection(name, dimension, distance, {})
},
(name: Str, dimension: Int, distance: Str, opts: Map): Any {
  request("PUT", `/collections/${name}`, {vectors: {size: dimension, distance: distance}}, opts)
}

get-collection
meta {
    doc: """GET /collections/{name} - Collection info: vector config, point count, status."""
}
fn
(name: Str): Map {
  get-collection(name, {})
},
(name: Str, opts: Map): Map {
  request("GET", `/collections/${name}`, "", opts)
}

delete-collection
meta {
    doc: """DELETE /collections/{name} - Drop a collection and its points."""
}
fn
(name: Str): Any {
  delete-collection(name, {})
},
(name: Str, opts: Map): Any {
  request("DELETE", `/collections/${name}`, "", opts)
}

// ---------------------------------------------------------------------------
// Points
// ---------------------------------------------------------------------------

upsert-points
meta {
    doc: """
    PUT /collections/{name}/points - Upsert points: `[{id, vector, payload?}]` (ids are ints or UUIDs).

    **Example**

    ```hot
    ::qdrant/upsert-points("docs", [
      {id: 1, vector: embedding, payload: {title: "Q3 roadmap", lang: "en"}}
    ])
    ```
    """
}
fn
(collection: Str, points: Vec): Any {
  upsert-points(collection, points, {})
},
(collection: Str, points: Vec, opts: Map): Any {
  request("PUT", `/collections/${collection}/points?wait=true`, {points: points}, opts)
}

search
meta {
    doc: """
    POST /collections/{name}/points/search - Nearest-neighbor search.
    `options`: `vector` (required), `limit` (default 10), `filter`
    (Qdrant filter DSL), `with_payload`, `with_vector`,
    `score_threshold`. Returns the hits (`[{id, score, payload?}]`).

    **Example**

    ```hot
    hits ::qdrant/search("docs", {
      vector: embedding,
      limit: 5,
      filter: {must: [{key: "lang", match: {value: "en"}}]},
      with_payload: true
    })
    first(hits).payload
    ```
    """
}
fn
(collection: Str, options: Map): Vec {
  search(collection, options, {})
},
(collection: Str, options: Map, opts: Map): Vec {
  request("POST", `/collections/${collection}/points/search`, {limit: 10, ...options}, opts)
}

get-points
meta {
    doc: """POST /collections/{name}/points - Retrieve points by ids (payloads included)."""
}
fn
(collection: Str, ids: Vec): Vec {
  get-points(collection, ids, {})
},
(collection: Str, ids: Vec, opts: Map): Vec {
  request("POST", `/collections/${collection}/points`, {ids: ids, with_payload: true}, opts)
}

delete-points
meta {
    doc: """POST /collections/{name}/points/delete - Delete by ids (`{points: [...]}`) or by filter (`{filter: {...}}`)."""
}
fn
(collection: Str, selector: Map): Any {
  delete-points(collection, selector, {})
},
(collection: Str, selector: Map, opts: Map): Any {
  request("POST", `/collections/${collection}/points/delete?wait=true`, selector, opts)
}

count-points
meta {
    doc: """POST /collections/{name}/points/count - Count points, optionally under a filter."""
}
fn
(collection: Str): Map {
  request("POST", `/collections/${collection}/points/count`, {})
},
(collection: Str, filter: Map): Map {
  request("POST", `/collections/${collection}/points/count`, {filter: filter})
},
// With opts, an empty filter counts everything: `count-points(name, {}, opts)`.
(collection: Str, filter: Map, opts: Map): Map {
  request("POST", `/collections/${collection}/points/count`, if(is-empty(filter), {}, {filter: filter}), opts)
}
