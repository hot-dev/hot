ApprovedListRequest type {
  team_id: Str?,
  enterprise_id: Str?,
  certified: Bool?,
  cursor: Str?,
  limit: Int?
}

approved-list
meta {
    doc: """
    admin.apps.approved.list - List approved apps (`approved_apps`).

    Scope: `admin.apps:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    Cursor-paginated: pass `cursor` from `response_metadata.next_cursor`, or use `approved-list-all`.
    """
}
fn
(): Map {
  approved-list(ApprovedListRequest({}))
},
(request: ApprovedListRequest): Map {
  ::api/call("admin.apps.approved.list", request)
}

approved-list-all
meta {
    doc: """
    Every `approved_apps` entry from `admin.apps.approved.list`, following `next_cursor` until the last page or `max-items` (default 1000). `request` sets the filters; its `cursor` is the starting point.
    """
}
fn
(): Vec {
  approved-list-all(ApprovedListRequest({}), 1000)
},
(request: ApprovedListRequest): Vec {
  approved-list-all(request, 1000)
},
(request: ApprovedListRequest, max-items: Int): Vec {
  ::api/paginate("admin.apps.approved.list", request, "approved_apps", max-items)
}

