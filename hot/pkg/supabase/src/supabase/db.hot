delete-response-as
meta {
    doc: """
    Like `delete-as`, but returns the full `HttpResponse`. A non-2xx status
    is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db
    ::f ::supabase::filters

    token ::hot::ctx/get("supabase.user.token")
    response ::db/delete-response-as(::db/DeleteRequest({table: "orders", filters: [::f/eq("id", 42)]}), token)
    response.status
    ```
    """
}
fn
(request: DeleteRequest, access-token: Str): ::api/HttpResponse {
  delete-response-as(request, access-token, {})
},
(request: DeleteRequest, access-token: Str, opts: Map): ::api/HttpResponse {
  validate-filters(request.filters, "delete")
  ::api/request-raw-as("DELETE", filtered-table-path(request.table, request.filters), delete-headers(request.return, request.count, request.schema), {}, access-token, opts)
}

delete-response-service
meta {
    doc: """
    Like `delete-service`, but returns the full `HttpResponse`. A non-2xx
    status is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db
    ::f ::supabase::filters

    response ::db/delete-response-service(::db/DeleteRequest({table: "orders", filters: [::f/eq("id", 42)]}))
    response.status
    ```
    """
}
fn
(request: DeleteRequest): ::api/HttpResponse {
  delete-response-service(request, {})
},
(request: DeleteRequest, opts: Map): ::api/HttpResponse {
  validate-filters(request.filters, "delete")
  ::api/request-raw-service("DELETE", filtered-table-path(request.table, request.filters), delete-headers(request.return, request.count, request.schema), {}, opts)
}

// ============================================================================
// Upsert
// ============================================================================

UpsertRequest type {
  table: Str,
  data: Any,
  on-conflict: Str?,
  ignore-duplicates: Bool?,
  return: Bool?,
  count: CountMode?,
  schema: Str?,
  missing-as-default: Bool?
}

upsert
meta {
    doc: """
Insert rows, updating on conflict. `on-conflict` specifies the conflict column(s). Set `ignore-duplicates: true` to skip conflicting rows instead of updating.

**Example**

```hot
::db ::supabase::db

::db/upsert(::db/UpsertRequest({
  table: "products",
  data: [{sku: "X1", name: "Widget", price: 10}],
  on-conflict: "sku"
}))
```
"""
}
fn
(request: UpsertRequest): Any {
  upsert(request, {})
},
(request: UpsertRequest, opts: Map): Any {
  body-or-error(upsert-response(request, opts))
}

upsert-as
meta {
    doc: """
    Like `upsert`, but as a signed-in user. `access-token` is the Bearer
    token, so row level security applies as that user.

    **Example**

    ```hot
    ::db ::supabase::db

    token ::hot::ctx/get("supabase.user.token")
    ::db/upsert-as(::db/UpsertRequest({table: "products", data: [{sku: "X1", price: 10}], on-conflict: "sku"}), token)
    ```
    """
}
fn
(request: UpsertRequest, access-token: Str): Any {
  upsert-as(request, access-token, {})
},
(request: UpsertRequest, access-token: Str, opts: Map): Any {
  body-or-error(upsert-response-as(request, access-token, opts))
}

upsert-service
meta {
    doc: """
    Like `upsert`, with the service role key, which bypasses row level
    security. Server-side only.

    **Example**

    ```hot
    ::db ::supabase::db

    ::db/upsert-service(::db/UpsertRequest({table: "products", data: [{sku: "X1", price: 10}], on-conflict: "sku"}))
    ```
    """
}
fn
(request: UpsertRequest): Any {
  upsert-service(request, {})
},
(request: UpsertRequest, opts: Map): Any {
  body-or-error(upsert-response-service(request, opts))
}

upsert-response
meta {
    doc: """
    Like `upsert`, but returns the full `HttpResponse`. A non-2xx status is
    not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    response ::db/upsert-response(::db/UpsertRequest({table: "products", data: [{sku: "X1", price: 10}], on-conflict: "sku"}))
    response.status
    response.body
    ```
    """
}
fn
(request: UpsertRequest): ::api/HttpResponse {
  upsert-response(request, {})
},
(request: UpsertRequest, opts: Map): ::api/HttpResponse {
  ::api/request-raw("POST", upsert-path(request), upsert-headers(request), request.data, opts)
}

upsert-response-as
meta {
    doc: """
    Like `upsert-as`, but returns the full `HttpResponse`. A non-2xx status
    is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    token ::hot::ctx/get("supabase.user.token")
    response ::db/upsert-response-as(::db/UpsertRequest({table: "products", data: [{sku: "X1", price: 10}], on-conflict: "sku"}), token)
    response.status
    response.body
    ```
    """
}
fn
(request: UpsertRequest, access-token: Str): ::api/HttpResponse {
  upsert-response-as(request, access-token, {})
},
(request: UpsertRequest, access-token: Str, opts: Map): ::api/HttpResponse {
  ::api/request-raw-as("POST", upsert-path(request), upsert-headers(request), request.data, access-token, opts)
}

upsert-response-service
meta {
    doc: """
    Like `upsert-service`, but returns the full `HttpResponse`. A non-2xx
    status is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    response ::db/upsert-response-service(::db/UpsertRequest({table: "products", data: [{sku: "X1", price: 10}], on-conflict: "sku"}))
    response.status
    response.body
    ```
    """
}
fn
(request: UpsertRequest): ::api/HttpResponse {
  upsert-response-service(request, {})
},
(request: UpsertRequest, opts: Map): ::api/HttpResponse {
  ::api/request-raw-service("POST", upsert-path(request), upsert-headers(request), request.data, opts)
}

upsert-path
meta {no-doc: true}
fn (request: UpsertRequest): Str {
  append-query(table-path(request.table), [
    query-param("on_conflict", request.on-conflict)
  ])
}

upsert-headers
meta {no-doc: true}
fn (request: UpsertRequest): Map {
  resolution cond {
      and(is-some(request.ignore-duplicates), request.ignore-duplicates) => { "resolution=ignore-duplicates" }
      => { "resolution=merge-duplicates" }
  }

  should-return if(is-null(request.return), true, request.return)
  prefer-parts []
  prefer-parts concat(prefer-parts, [resolution])
  prefer-parts if(should-return, concat(prefer-parts, ["return=representation"]), concat(prefer-parts, ["return=minimal"]))
  prefer-parts if(is-some(request.count), concat(prefer-parts, [`count=${untype(request.count)}`]), prefer-parts)
  prefer-parts if(and(is-some(request.missing-as-default), request.missing-as-default), concat(prefer-parts, ["missing=default"]), prefer-parts)

  write-headers(request.schema)
    |> assoc("Prefer", join(prefer-parts, ", "))
}

// ============================================================================
// RPC (Stored Procedures)
// ============================================================================

RpcRequest type {
  fn-name: Str,
  params: Map?,
  count: CountMode?,
  schema: Str?,
  single: Bool?
}

rpc
meta {
    doc: """
Call a Postgres function (RPC). Pass arguments in `params`.

**Example**

```hot
::db ::supabase::db

// Call a function
result ::db/rpc(::db/RpcRequest({
  fn-name: "add_them",
  params: {a: 1, b: 2}
}))
// => 3

// Table-valued function with single result
user ::db/rpc(::db/RpcRequest({
  fn-name: "get_user_by_email",
  params: {user_email: "alice@example.com"},
  single: true
}))
```
"""
}
fn
(request: RpcRequest): Any {
  rpc(request, {})
},
(request: RpcRequest, opts: Map): Any {
  body-or-error(rpc-response(request, opts))
}

rpc-as
meta {
    doc: """
    Like `rpc`, but as a signed-in user. `access-token` is the Bearer token,
    so row level security applies as that user.

    **Example**

    ```hot
    ::db ::supabase::db

    token ::hot::ctx/get("supabase.user.token")
    ::db/rpc-as(::db/RpcRequest({fn-name: "add_them", params: {a: 1, b: 2}}), token)
    ```
    """
}
fn
(request: RpcRequest, access-token: Str): Any {
  rpc-as(request, access-token, {})
},
(request: RpcRequest, access-token: Str, opts: Map): Any {
  body-or-error(rpc-response-as(request, access-token, opts))
}

rpc-service
meta {
    doc: """
    Like `rpc`, with the service role key, which bypasses row level
    security. Server-side only.

    **Example**

    ```hot
    ::db ::supabase::db

    ::db/rpc-service(::db/RpcRequest({fn-name: "add_them", params: {a: 1, b: 2}}))
    ```
    """
}
fn
(request: RpcRequest): Any {
  rpc-service(request, {})
},
(request: RpcRequest, opts: Map): Any {
  body-or-error(rpc-response-service(request, opts))
}

rpc-response
meta {
    doc: """
    Like `rpc`, but returns the full `HttpResponse`. A non-2xx status is not
    an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    response ::db/rpc-response(::db/RpcRequest({fn-name: "add_them", params: {a: 1, b: 2}}))
    response.status
    response.body
    ```
    """
}
fn
(request: RpcRequest): ::api/HttpResponse {
  rpc-response(request, {})
},
(request: RpcRequest, opts: Map): ::api/HttpResponse {
  ::api/request-raw("POST", rpc-path(request.fn-name), rpc-headers(request), or(request.params, {}), opts)
}

rpc-response-as
meta {
    doc: """
    Like `rpc-as`, but returns the full `HttpResponse`. A non-2xx status is
    not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    token ::hot::ctx/get("supabase.user.token")
    response ::db/rpc-response-as(::db/RpcRequest({fn-name: "add_them", params: {a: 1, b: 2}}), token)
    response.status
    response.body
    ```
    """
}
fn
(request: RpcRequest, access-token: Str): ::api/HttpResponse {
  rpc-response-as(request, access-token, {})
},
(request: RpcRequest, access-token: Str, opts: Map): ::api/HttpResponse {
  ::api/request-raw-as("POST", rpc-path(request.fn-name), rpc-headers(request), or(request.params, {}), access-token, opts)
}

rpc-response-service
meta {
    doc: """
    Like `rpc-service`, but returns the full `HttpResponse`. A non-2xx
    status is not an Err: check `status`.

    **Example**

    ```hot
    ::db ::supabase::db

    response ::db/rpc-response-service(::db/RpcRequest({fn-name: "add_them", params: {a: 1, b: 2}}))
    response.status
    response.body
    ```
    """
}
fn
(request: RpcRequest): ::api/HttpResponse {
  rpc-response-service(request, {})
},
(request: RpcRequest, opts: Map): ::api/HttpResponse {
  ::api/request-raw-service("POST", rpc-path(request.fn-name), rpc-headers(request), or(request.params, {}), opts)
}

rpc-headers
meta {no-doc: true}
fn (request: RpcRequest): Map {
  prefer if(is-some(request.count), `count=${untype(request.count)}`, null)
  accept if(and(is-some(request.single), request.single), "application/vnd.pgrst.object+json", null)
  write-headers(request.schema)
    |> assoc-some("Prefer", prefer)
    |> assoc-some("Accept", accept)
}
