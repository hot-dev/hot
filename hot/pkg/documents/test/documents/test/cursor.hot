::documents::test::cursor ns
meta ["test"]

::cursor ::documents::cursor

test-roundtrip
meta ["test"] fn () {
    c ::cursor/encode("box", "list", "JV9IRGZmieiBasejOG9yDCRNgd2ymoZIbjsxbJMjIs3kioVii", "12345")
    assert(starts-with(c, "doc1."))
    assert(not(contains(c, "/")), "URL-safe")
    assert(not(contains(c, "+")))
    d ::cursor/decode(c)
    assert-eq("box", d.p)
    assert-eq("list", d.k)
    assert-eq("JV9IRGZmieiBasejOG9yDCRNgd2ymoZIbjsxbJMjIs3kioVii", d.v)
    assert-eq("12345", d.f)

    link "https://graph.microsoft.com/v1.0/drives/b!x/root/delta?token=MzslMjM0OzEuMDsx%3D&$top=200"
    assert-eq(link, ::cursor/decode(::cursor/encode("onedrive", "changes", link)).v, "Graph links survive untouched")
    s3 ::cursor/decode(::cursor/encode("s3", "changes", {w: "2026-10-30T12:00:00.000Z", k: ["a b/é.txt"]}))
    assert-eq({w: "2026-10-30T12:00:00.000Z", k: ["a b/é.txt"]}, s3.v, "Map values and Unicode survive")
    assert(is-null(get(::cursor/decode(::cursor/encode("box", "changes", "1234")), "f")), "nulls are left out")
}

test-garbage-is-an-err-not-a-halt
meta ["test"] fn () {
    assert(is-err(::cursor/decode("not-a-cursor")))
    assert(is-err(::cursor/decode("doc1.%%%%")), "bad base64")
    assert(is-err(::cursor/decode(`doc1.${::hot::base64/encode-url("not json")}`)), "bad JSON")
    assert(is-err(::cursor/decode(`doc1.${::hot::base64/encode-url("[1,2]")}`)), "not an object")
    partial ::hot::base64/encode-url(to-json({p: "box"}))
    assert(is-err(::cursor/decode(`doc1.${partial}`)), "missing kind and value")
    assert(is-err(::cursor/decode(42)))
    assert(is-err(::cursor/decode(null)))
}

test-decode-for-checks-provider-and-kind
meta ["test"] fn () {
    c ::cursor/encode("dropbox", "changes", "AAG...")
    assert-eq("AAG...", ::cursor/decode-for(c, "dropbox", "changes").v)
    wrong-provider ::cursor/decode-for(c, "box", "changes")
    assert(is-err(wrong-provider))
    assert(contains(err-message(wrong-provider), "belongs to dropbox"))
    wrong-kind ::cursor/decode-for(c, "dropbox", "list")
    assert(is-err(wrong-kind))
    assert(contains(err-message(wrong-kind), "changes cursor"))
}

test-list-and-change-cursor-helpers
meta ["test"] fn () {
    assert(is-null(::cursor/list-cursor("box", null, "0")), "no token: last page")
    assert(is-null(::cursor/list-cursor("box", "", "0")))
    assert(is-str(::cursor/list-cursor("box", "m1", "0")))
    assert(is-err(::cursor/change-cursor("box", null)), "a missing change token is an Err")
    assert-eq("p9", ::cursor/decode(::cursor/change-cursor("google-drive", "p9")).v)
}
