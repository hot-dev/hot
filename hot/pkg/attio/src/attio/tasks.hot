::attio::tasks ns

::api ::attio::api

build-task-payload
meta {
    doc: """
    Build the create-task payload. Attio requires `deadline_at`,
    `linked_records`, and `assignees` to be present (nullable/empty is
    fine); `options` overrides any of them. Exposed for testing;
    `create-task` uses it.

    **Example**

    ```hot
    payload ::attio::tasks/build-task-payload("Send the proposal", {deadline_at: "2026-08-01T12:00:00Z"})
    payload.data.deadline_at  // "2026-08-01T12:00:00Z"
    payload.data.assignees  // []
    ```
    """
}
fn (content: Str, options: Map): Map {
  {
    data: {
      content: content,
      format: "plaintext",
      is_completed: false,
      deadline_at: null,
      linked_records: [],
      assignees: [],
      ...options
    }
  }
}

list-tasks
meta {
    doc: """
    GET /tasks - The workspace's tasks (`limit`/`offset` via the 1-arity
    options map).

    **Example**

    ```hot
    tasks ::attio::tasks/list-tasks({limit: 20})
    map(tasks.data, %.content_plaintext)
    ```
    """
}
fn
(): Map {
  ::api/json("GET", "/tasks")
},
(options: Map): Map {
  list-tasks(options, {})
},
(options: Map, opts: Map): Map {
  ::api/json("GET", `/tasks${::hot::uri/query-string(options)}`, "", opts)
}

create-task
meta {
    doc: """
    POST /tasks - Create a task. `options`: `deadline_at` (RFC3339 or
    null), `linked_records` (Vec of `{target_object, target_record_id}`),
    `assignees` (Vec of `{referenced_actor_type: "workspace-member",
    referenced_actor_id}`).

    **Example**

    ```hot
    ::attio::tasks/create-task("Send the proposal", {
      deadline_at: "2026-08-01T12:00:00Z",
      linked_records: [{target_object: "companies", target_record_id: "7f4e2a10-3b9c-4d2a-8f1e-6a5c9d0b1e23"}]
    })
    ```
    """
}
fn
(content: Str): Map {
  create-task(content, {})
},
(content: Str, options: Map): Map {
  create-task(content, options, {})
},
(content: Str, options: Map, opts: Map): Map {
  out ::api/json("POST", "/tasks", build-task-payload(content, options), opts)
  match out {
    Result.Err => { err(out) }

    _ => { out.data }
  }
}

update-task
meta {
    doc: """
    PATCH /tasks/{id} - Update a task (`is_completed`, `deadline_at`,
    `assignees`, `linked_records`).

    **Example**

    ```hot
    ::attio::tasks/update-task("c2d8e4f1-5a6b-47c9-b0d3-1e2f3a4b5c6d", {is_completed: true})
    ```
    """
}
fn
(task-id: Str, changes: Map): Map {
  update-task(task-id, changes, {})
},
(task-id: Str, changes: Map, opts: Map): Map {
  out ::api/json("PATCH", `/tasks/${task-id}`, {data: changes}, opts)
  match out {
    Result.Err => { err(out) }

    _ => { out.data }
  }
}

delete-task
meta {
    doc: """
    DELETE /tasks/{id} - Delete a task.

    **Example**

    ```hot
    ::attio::tasks/delete-task("c2d8e4f1-5a6b-47c9-b0d3-1e2f3a4b5c6d")
    ```
    """
}
fn
(task-id: Str): Any {
  delete-task(task-id, {})
},
(task-id: Str, opts: Map): Any {
  ::api/json("DELETE", `/tasks/${task-id}`, "", opts)
}
