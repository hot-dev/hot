::supabase::test::db ns
meta ["test"]

::db ::supabase::db
::f ::supabase::filters

test-select-path-encodes-query
meta ["test"]
fn () {
  path ::db/select-path(::db/SelectRequest({
    table: "users",
    select: "id,name,posts(title)",
    filters: [::f/eq("email", "a@b.com")],
    order: "created_at.desc",
    limit: 10,
    offset: 20
  }))

  assert-eq("/rest/v1/users?select=id%2Cname%2Cposts%28title%29&email=eq.a%40b.com&order=created_at.desc&limit=10&offset=20", path)
}

test-schema-headers
meta ["test"]
fn () {
  headers ::db/select-headers(::db/SelectRequest({
    table: "items",
    count: "exact",
    schema: "private",
    single: true
  }))

  assert-eq("private", headers.Accept-Profile)
  assert-eq("count=exact", headers.Prefer)
  assert-eq("application/vnd.pgrst.object+json", headers.Accept)
}

test-count-parser
meta ["test"]
fn () {
  assert-eq(42, ::db/parse-count({"content-range": "0-9/42"}))
  assert(is-null(::db/parse-count({"content-range": "0-9/*"})), "wildcard total should be null")
  assert(is-null(::db/parse-count({})), "missing header should be null")
}

// `return: false` asks PostgREST for no rows back. Unset means rows come back.
test-return-false-sends-return-minimal
meta ["test"]
fn () {
  assert-eq("return=minimal", get(::db/insert-headers(::db/InsertRequest({table: "t", data: {}, return: false})), "Prefer"))
  assert-eq("return=representation", get(::db/insert-headers(::db/InsertRequest({table: "t", data: {}, return: true})), "Prefer"))
  assert-eq("return=representation", get(::db/insert-headers(::db/InsertRequest({table: "t", data: {}})), "Prefer"), "the default")
  assert-eq("resolution=merge-duplicates, return=minimal", get(::db/upsert-headers(::db/UpsertRequest({table: "t", data: {}, return: false})), "Prefer"))
  assert-eq("resolution=merge-duplicates, return=representation", get(::db/upsert-headers(::db/UpsertRequest({table: "t", data: {}})), "Prefer"))
  assert-eq("return=minimal", get(::db/mutation-headers(false, null, null), "Prefer"))
  assert-eq("return=representation", get(::db/mutation-headers(null, null, null), "Prefer"))
}
