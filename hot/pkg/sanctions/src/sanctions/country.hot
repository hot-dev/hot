norm fn (s: Str): Str {
  lowercase(s)
    |> ::sanctions::text/fold()
    |> ::re/replace-all("['’.]", "")
    |> ::re/replace-all("[^a-z0-9]+", " ")
    |> trim()
}

code
meta {
    doc: """
    The ISO 3166-1 alpha-2 code for a country name or code, or null when
    unknown. Two-letter input is taken as a code. "X (now Y)" and
    "Former USSR, now Y" resolve to Y, a parenthetical is otherwise
    ignored ("Russia (USSR)" is RU), and so is a leading "Region:".

    **Example**

    ```hot
    ::sanctions::country/code("Burma")                          // "MM"
    ::sanctions::country/code("Congo, Democratic Republic of the") // "CD"
    ::sanctions::country/code("ir")                             // "IR"
    ::sanctions::country/code("USSR (now Russian Federation)")  // "RU"
    ```
    """
}
fn (s: Str?): Str? {
  cond {
    is-null(s) => { null }
    ::re/is-match(trim(s), "^[A-Za-z]{2}$") => {
      upper uppercase(trim(s))
      if(is-some(get(CODES, upper)), upper, null)
    }
    => {
      n norm(s)
      now ::re/capture(n, "(?:now|currently) (?:republic of )?([a-z ]+)$")
      base ::re/replace-all(n, "^region ", "")
      plain trim(::re/replace-all(lowercase(s), "\\(.*\\)", "") |> ::sanctions::text/fold() |> ::re/replace-all("[^a-z0-9]+", " "))
      cond {
        is-some(get(NAMES, base)) => { get(NAMES, base) }
        is-some(get(NAMES, plain)) => { get(NAMES, plain) }
        and(is-some(now), is-some(get(NAMES, trim(now.groups[0])))) => { get(NAMES, trim(now.groups[0])) }
        => { null }
      }
    }
  }
}

key
meta {
    doc: """The comparison key for a country: its ISO code when known, else its normalized name (`""` for blank input)."""
}
fn (s: Str?): Str {
  c code(s)
  cond {
    is-some(c) => { c }
    is-null(s) => { "" }
    => { norm(s) }
  }
}

name
meta {
    doc: """The English short name for an ISO 3166-1 alpha-2 code, or null."""
}
fn (iso: Str): Str? {
  get(CODES, uppercase(iso))
}
