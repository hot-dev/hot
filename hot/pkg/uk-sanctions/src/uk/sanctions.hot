::uk::sanctions ns
meta {
    doc: """
    **Fetch only.** This package fetches and parses the list. It does
    not screen names and it stores nothing. List data alone is not a
    clearance decision.

    The UK Sanctions List published by the FCDO (`uk`), the single
    source of UK designations since the OFSI Consolidated List closed on
    28 January 2026. About 6,400 designations: individuals, entities and
    ships.

    **Format used**: the XML file
    (`https://sanctionslist.fcdo.gov.uk/docs/UK-Sanctions-List.xml`,
    about 22 MB; the CSV is about 50 MB because it repeats every field
    per name). It is larger than the default 16 MiB response cap, so it
    is downloaded in 8 MiB Range requests, which the server supports.
    Change detection uses its ETag: `current-version` reads it without
    downloading the list, and `fetch` skips the download when you pass
    the version you already hold.

    **Example**

    ```hot
    out ::uk::sanctions/fetch()
    out.version
    first(out.entries).name
    ```
    """
}

::re ::hot::regex
::sx ::uk::sanctions::xml
::http ::uk::sanctions::http

URL "https://sanctionslist.fcdo.gov.uk/docs/UK-Sanctions-List.xml"
LIST_NAME "UK Sanctions List"

DesignationKind
meta {
    doc: """What is designated. The list says `Individual`, `Entity` or `Ship`, and a ship is `"vessel"` here."""
}
type "individual" | "entity" | "vessel"

Designation
meta {
    doc: """
    One designation, as the UK Sanctions List XML publishes it.

    **Fields**
    - `id` — the `UniqueID`
    - `kind` — a `DesignationKind`
    - `name` — the primary name, its `Name1` to `Name6` parts joined
    - `aliases` — every other name, then the non-Latin names
    - `dobs` — dates of birth as ISO 8601: `YYYY-MM-DD`, `YYYY-MM` or
      `YYYY` (`dd/mm/1963` is `"1963"`)
    - `nationalities` — as published
    - `regimes` — the sanctions regime names
    - `addresses` — one line per address
    - `other-information` — the `OtherInformation` text
    - `designation-source` — who designated it, e.g. `"UN"`
    - `un-reference` — the `UNReferenceNumber`
    - `ofsi-group-id` — the `OFSIGroupID`
    - `date-designated`, `last-updated` — as published (`dd/mm/yyyy`)
    - `url` — the list file
    """
}
type {
    id: Str,
    kind: DesignationKind,
    name: Str,
    aliases: Vec<Str>,
    dobs: Vec<Str>,
    nationalities: Vec<Str>,
    regimes: Vec<Str>,
    addresses: Vec<Str>,
    other-information: Str?,
    designation-source: Str?,
    un-reference: Str?,
    ofsi-group-id: Str?,
    date-designated: Str?,
    last-updated: Str?,
    url: Str
}

present
meta {no-doc: true}
fn (v: Any): Bool {
  match v {
    Null => { false }
    Str => { not(is-empty(trim(v))) }
    _ => { true }
  }
}

clean-list
meta {
    doc: """
    Trim strings, drop blanks and duplicates, keep the first-seen order.

    **Example**

    ```hot
    ::uk::sanctions/clean-list([" Iran ", "Iran", "", null, "Syria"])  // ["Iran", "Syria"]
    ```
    """
}
fn (values: Vec): Vec<Str> {
  distinct(map(filter(values, present), (v) { trim(Str(v)) }))
}

other-names
meta {
    doc: """
    Cleaned aliases without the primary name, ignoring case.

    **Example**

    ```hot
    ::uk::sanctions/other-names(["Jane Roe", "JANE ROE", "J. Roe"], "Jane Roe")  // ["J. Roe"]
    ```
    """
}
fn (aliases: Vec, name: Str): Vec<Str> {
  filter(clean-list(aliases), (a) { ne(lowercase(a), lowercase(name)) })
}

blank-to-null
meta {no-doc: true}
fn (v: Any): Str? {
  if(present(v), trim(Str(v)), null)
}

// ---------------------------------------------------------------------------
// Dates of birth
// ---------------------------------------------------------------------------

MONTHS {
  jan: "01", feb: "02", mar: "03", apr: "04", may: "05", jun: "06",
  jul: "07", aug: "08", sep: "09", oct: "10", nov: "11", dec: "12"
}

pad2
meta {no-doc: true}
fn (s: Str): Str {
  if(eq(length(s), 1), `0${s}`, s)
}

iso-date
meta {
    doc: """
    Normalize one published date of birth to ISO 8601, or null when it
    has no year. Accepts `1948-12-10`, `10 Dec 1948`, `Dec 1948`,
    `1948`, `circa 1948`, `10/12/1948` and `dd/mm/1948` (day
    first), and ranges such as `1959 to 1962` or `01 Jan 1960 to 31
    Dec 1962` (`1959/1962`, `1960/1962`).

    **Example**

    ```hot
    ::uk::sanctions/iso-date("10 Dec 1948")  // "1948-12-10"
    ::uk::sanctions/iso-date("dd/mm/1963")   // "1963"
    ::uk::sanctions/iso-date("1959 to 1962") // "1959/1962"
    ```
    """
}
fn (raw: Str?): Str? {
  s lowercase(trim(or(raw, "")))
  years map(::re/find-all(s, "\\d{4}"), (m) { m.match })
  is-range and(gte(length(years), 2), ::re/is-match(s, "\\d{4}.*(?:\\bto\\b|–|\\d{4}\\s*/\\s*\\d{4}$)"))
  iso ::re/capture(s, "^(\\d{4})-(\\d{1,2})-(\\d{1,2})")
  dmy ::re/capture(s, "^(\\d{1,2})\\s+([a-z]{3})[a-z]*\\.?\\s+(\\d{4})")
  my ::re/capture(s, "^([a-z]{3})[a-z]*\\.?\\s+(\\d{4})")
  slash ::re/capture(s, "^(\\d{1,2}|dd)/(\\d{1,2}|mm)/(\\d{4})")
  year ::re/capture(s, "(\\d{4})")
  cond {
    is-range => { `${first(years)}/${last(years)}` }
    is-some(iso) => { `${iso.groups[0]}-${pad2(iso.groups[1])}-${pad2(iso.groups[2])}` }
    and(is-some(dmy), is-some(get(MONTHS, dmy.groups[1]))) => {
      `${dmy.groups[2]}-${get(MONTHS, dmy.groups[1])}-${pad2(dmy.groups[0])}`
    }

    and(is-some(my), is-some(get(MONTHS, my.groups[0]))) => { `${my.groups[1]}-${get(MONTHS, my.groups[0])}` }
    is-some(slash) => {
      d slash.groups[0]
      m slash.groups[1]
      y slash.groups[2]
      cond {
        eq(m, "mm") => { y }
        eq(d, "dd") => { `${y}-${pad2(m)}` }
        => { `${y}-${pad2(m)}-${pad2(d)}` }
      }
    }

    is-some(year) => { year.groups[0] }
    => { null }
  }
}

full-name
meta {no-doc: true}
fn (name: Str): Str {
  parts filter(map(["Name1", "Name2", "Name3", "Name4", "Name5", "Name6"], (t) { ::sx/text(name, t) }), is-some)
  join(parts, " ")
}

kind
meta {no-doc: true}
fn (raw: Str?): Str {
  t lowercase(or(raw, ""))
  cond {
    eq(t, "individual") => { "individual" }
    eq(t, "ship") => { "vessel" }
    => { "entity" }
  }
}

address-line
meta {no-doc: true}
fn (address: Str): Str {
  tags ["AddressLine1", "AddressLine2", "AddressLine3", "AddressLine4", "AddressLine5", "AddressLine6", "AddressPostalCode", "AddressCountry"]
  join(filter(map(tags, (t) { ::sx/text(address, t) }), is-some), ", ")
}

parse-designation
meta {
    doc: """
    Turn one `<Designation>` record string into a `Designation`. Exposed for
    testing.

    **Example**

    ```hot
    record "<Designation><UniqueID>AFG0007</UniqueID><Names><Name><Name1>Jane</Name1><Name6>ROE</Name6><NameType>Primary Name</NameType></Name><Name><Name6>J Roe</Name6><NameType>Alias</NameType></Name></Names><IndividualEntityShip>Individual</IndividualEntityShip></Designation>"
    d ::uk::sanctions/parse-designation(record)
    d.name  // "Jane ROE"
    d.kind  // "individual"
    d.aliases  // ["J Roe"]
    ```
    """
}
fn (record: Str): Designation {
  names map(::sx/blocks(::sx/block(record, "Names"), "Name"), (n) {
    {name: full-name(n), type: lowercase(or(::sx/text(n, "NameType"), ""))}
  })
  primary or(find-first(names, (n) { eq(n.type, "primary name") }), first(names))
  pname trim(or(get(or(primary, {}), "name"), ""))
  others filter(names, (n) { ne(n.name, pname) })
  non-latin ::sx/texts(::sx/block(record, "NonLatinNames"), "NameNonLatinScript")
  individual ::sx/block(record, "IndividualDetails")
  dobs ::sx/texts(::sx/block(individual, "DOBs"), "DOB")
  nationalities ::sx/texts(::sx/block(individual, "Nationalities"), "Nationality")
  Designation({
    id: trim(or(::sx/text(record, "UniqueID"), "")),
    kind: kind(::sx/text(record, "IndividualEntityShip")),
    name: pname,
    aliases: other-names(concat(map(others, (n) { n.name }), non-latin), pname),
    dobs: clean-list(filter(map(dobs, iso-date), is-some)),
    nationalities: clean-list(nationalities),
    regimes: clean-list(::sx/texts(record, "RegimeName")),
    addresses: clean-list(map(::sx/blocks(::sx/block(record, "Addresses"), "Address"), address-line)),
    other-information: blank-to-null(::sx/text(record, "OtherInformation")),
    designation-source: ::sx/text(record, "DesignationSource"),
    un-reference: ::sx/text(record, "UNReferenceNumber"),
    ofsi-group-id: ::sx/text(record, "OFSIGroupID"),
    date-designated: ::sx/text(record, "DateDesignated"),
    last-updated: ::sx/text(record, "LastUpdated"),
    url: URL
  })
}

parse
meta {
    doc: """
    Parse the whole UK Sanctions List XML into `Designation` records (pure).
    Records without a name or id are skipped.

    **Example**

    ```hot
    file "<Designations><Designation><UniqueID>CYB0001</UniqueID><Names><Name><Name6>Acme Trading</Name6><NameType>Primary Name</NameType></Name></Names><IndividualEntityShip>Entity</IndividualEntityShip></Designation></Designations>"
    map(::uk::sanctions/parse(file), (d) { d.name })  // ["Acme Trading"]
    ```
    """
}
fn (doc: Str): Vec<Designation> {
  entries map(::sx/records(doc, "Designation"), parse-designation)
  filter(entries, (e) { and(not(is-empty(e.id)), not(is-empty(e.name))) })
}

version-of
meta {no-doc: true}
fn (info: Map): Str? {
  or(info.etag, info.last-modified)
}

require-entries
meta {
    doc: """
    The parsed records, or an Err when there are none: a changed file format
    can parse to nothing, and an empty list must not pass for a list with
    nobody on it.

    **Example**

    ```hot
    ::uk::sanctions/require-entries([{id: "AFG0007"}])  // [{id: "AFG0007"}]
    is-err(::uk::sanctions/require-entries([]))  // true
    ```
    """
}
fn (entries: Vec): Vec {
  cond {
    is-empty(entries) => { err("uk-sanctions: the file parsed to no records; its format may have changed") }
    => { entries }
  }
}

current-version
meta {
    doc: """
    The list's current version from one HEAD request, without
    downloading the list: its ETag, or Last-Modified. Compare it with
    the version you hold to skip a download. Null when the server sends
    neither, an Err when the request fails.

    **Example**

    ```hot
    ::uk::sanctions/current-version()
    ```
    """
}
fn (): Str? {
  info ::http/head(URL)
  cond {
    is-err(info) => { info }
    => { version-of(info) }
  }
}

fetch
meta {
    doc: """
    Download and parse the UK list. Returns `{version, entries,
    unchanged}`, with `Designation` records in `entries`.
    `known-version` is the version you already hold: when the HEAD ETag
    (or Last-Modified) equals it, nothing is downloaded, `unchanged` is
    true and `entries` is null. A list that parses to no records is an
    Err.

    **Example**

    ```hot
    out ::uk::sanctions/fetch()
    again ::uk::sanctions/fetch(out.version)
    again.unchanged
    ```
    """
}
fn
(): Map {
  fetch(null)
},
(known-version: Str?): Map {
  info ::http/head(URL)
  ver if(is-err(info), null, version-of(info))
  cond {
    and(is-some(ver), eq(ver, known-version)) => { {version: ver, entries: null, unchanged: true} }
    => {
      out ::http/get-text(URL)
      cond {
        is-err(out) => { out }
        => {
          entries require-entries(parse(out.text))
          cond {
            is-err(entries) => { entries }
            => {
              {
                version: or(ver, or(out.etag, slice(::hot::hash/sha256(out.text), 0, 16))),
                entries: entries,
                unchanged: false
              }
            }
          }
        }
      }
    }
  }
}
