}

ultimate-parent-relationship
meta {
    doc: """The ultimate-parent relationship record (`IS_ULTIMATELY_CONSOLIDATED_BY`), or null."""
}
fn
(lei: Str): Map? {
  ultimate-parent-relationship(lei, {})
},
(lei: Str, opts: Map): Map? {
