ModifyGuildChannelPositionsRequest type {
  guild_id: Str,
  positions: Vec<Map>,
  reason: Str?
}

modify-guild-channel-positions
meta {
    doc: """
    PATCH /guilds/{guild_id}/channels - Reorder channels. `positions` is
    `[{id, position?, lock_permissions?, parent_id?}]`. Needs
    MANAGE_CHANNELS.

    **Example**

    ```hot
    ::channels ::discord::channels

    ::channels/modify-guild-channel-positions(::channels/ModifyGuildChannelPositionsRequest({
      guild_id: "1000000000000000000",
      positions: [
        {id: "1100000000000000000", position: 0},
        {id: "1100000000000000001", position: 1, parent_id: "1400000000000000000"}
      ],
      reason: "Reorder for launch"
    }))
    ```
    """
}
fn
(request: ModifyGuildChannelPositionsRequest): Bool {
  modify-guild-channel-positions(request, {})
},
(request: ModifyGuildChannelPositionsRequest, opts: Map): Bool {
  ::api/call-ok("PATCH", `/guilds/${seg(request.guild_id)}/channels`, {
    body: map(request.positions, (p) { ::api/body(p, []) }),
    reason: request.reason
  }, opts)
}

