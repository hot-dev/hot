::aws::sns::subscriptions ns

// SNS Subscription operations

HttpResponse ::hot::http/HttpResponse
is-ok-response ::hot::http/is-ok-response

resolve ::aws::core/resolve
send-signed ::aws::core/send-signed
service-url ::aws::core/service-url
AwsError ::aws::core/AwsError

// Subscription type
Subscription type {
    subscription_arn: Str?,
    owner: Str?,
    protocol: Str?,
    endpoint: Str?,
    topic_arn: Str?
}

// Subscribe response
SubscribeResponse type {
    subscription_arn: Str?
}

// List subscriptions response
ListSubscriptionsResponse type {
    subscriptions: Vec<Subscription>,
    next_token: Str?
}

// Get subscription attributes response
GetSubscriptionAttributesResponse type {
    attributes: Map
}

// Subscribe to a topic
subscribe
meta {
    doc: """
    Subscribe an endpoint to an SNS topic.

    Supported protocols: "http", "https", "email", "email-json", "sms",
    "sqs", "lambda", "application", "firehose".

    **Example**

    ```hot
    // Subscribe an SQS queue
    result ::aws::sns::subscriptions/subscribe("arn:aws:sns:us-east-1:123456789012:orders", "sqs", "arn:aws:sqs:us-east-1:123456789012:order-events")
    result.subscription_arn  // => "arn:aws:sns:us-east-1:123456:my-topic:abc-123..."

    // Subscribe a Lambda function
    ::aws::sns::subscriptions/subscribe("arn:aws:sns:us-east-1:123456789012:orders", "lambda", "arn:aws:lambda:us-east-1:123456789012:function:on-order")

    // Subscribe with filter policy
    ::aws::sns::subscriptions/subscribe("arn:aws:sns:us-east-1:123456789012:orders", "sqs", "arn:aws:sqs:us-east-1:123456789012:order-events", {
        FilterPolicy: to-json({event_type: ["order", "payment"]})
    })
    ```
    """
}
fn
(topic_arn: Str, protocol: Str, endpoint: Str, attributes: Map, opts: Map): SubscribeResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        request-body {
            TopicArn: topic_arn,
            Protocol: protocol,
            Endpoint: endpoint
        }

        with-attributes cond {
            is-empty(attributes) => { request-body }
            => { {...request-body, Attributes: attributes} }
        }

        body to-json(with-attributes)

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.Subscribe"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { SubscribeResponse({
                subscription_arn: response.body.SubscriptionArn
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(topic_arn: Str, protocol: Str, endpoint: Str, attributes: Map): SubscribeResponse | AwsError {
    subscribe(topic_arn, protocol, endpoint, attributes, {})
},
(topic_arn: Str, protocol: Str, endpoint: Str): SubscribeResponse | AwsError {
    subscribe(topic_arn, protocol, endpoint, {})
}

// Unsubscribe from a topic
unsubscribe
meta {
    doc: """
    Unsubscribe from an SNS topic.

    **Example**

    ```hot
    ::aws::sns::subscriptions/unsubscribe("arn:aws:sns:us-east-1:123456789012:orders:1a2b3c4d")
    ```
    """
}
fn
(subscription_arn: Str, opts: Map): Map | AwsError {
    if-ok(resolve(opts), (resolved) {
        body to-json({
            SubscriptionArn: subscription_arn
        })

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.Unsubscribe"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { { success: true } }
            => { AwsError(response) }
        }
    })
},
(subscription_arn: Str): Map | AwsError {
    unsubscribe(subscription_arn, {})
}

// Confirm a subscription (for HTTP/HTTPS endpoints)
confirm-subscription
meta {
    doc: """
    Confirm a pending subscription using the token from the confirmation message.

    Required for HTTP/HTTPS and email subscriptions.

    **Example**

    ```hot
    result ::aws::sns::subscriptions/confirm-subscription("arn:aws:sns:us-east-1:123456789012:orders", "token-from-the-confirmation-message")
    result.subscription_arn  // => "arn:aws:sns:us-east-1:123456:my-topic:abc-123..."
    ```
    """
}
fn
(topic_arn: Str, token: Str, opts: Map): SubscribeResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        body to-json({
            TopicArn: topic_arn,
            Token: token
        })

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.ConfirmSubscription"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { SubscribeResponse({
                subscription_arn: response.body.SubscriptionArn
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(topic_arn: Str, token: Str): SubscribeResponse | AwsError {
    confirm-subscription(topic_arn, token, {})
}

// List all subscriptions
list-subscriptions
meta {
    doc: """
    List all subscriptions across all topics. Supports pagination via next_token.

    **Example**

    ```hot
    result ::aws::sns::subscriptions/list-subscriptions()
    result.subscriptions
    // => [{subscription_arn: "arn:...", protocol: "sqs", endpoint: "arn:aws:sqs:...", ...}]
    ```
    """
}
fn
(next_token: Str?, opts: Map): ListSubscriptionsResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        request-body {}

        with-token merge(request-body, filter-vals({
            NextToken: next_token
        }, is-some))

        body to-json(with-token)

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.ListSubscriptions"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { ListSubscriptionsResponse({
                subscriptions: cond {
                    is-null(response.body.Subscriptions) => { [] }
                    => { map(response.body.Subscriptions, Subscription({
                    subscription_arn: %.SubscriptionArn,
                    owner: %.Owner,
                    protocol: %.Protocol,
                    endpoint: %.Endpoint,
                    topic_arn: %.TopicArn
                })) }
                },
                next_token: response.body.NextToken
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(opts: Map): ListSubscriptionsResponse | AwsError {
    list-subscriptions(null, opts)
},
(next_token: Str?): ListSubscriptionsResponse | AwsError {
    list-subscriptions(next_token, {})
},
(): ListSubscriptionsResponse | AwsError {
    list-subscriptions(null)
}

// List subscriptions by topic
list-subscriptions-by-topic
meta {
    doc: """
    List all subscriptions for a specific topic. Supports pagination via next_token.

    **Example**

    ```hot
    result ::aws::sns::subscriptions/list-subscriptions-by-topic("arn:aws:sns:us-east-1:123456789012:orders")
    length(result.subscriptions)  // => 3
    ```
    """
}
fn
(topic_arn: Str, next_token: Str?, opts: Map): ListSubscriptionsResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        request-body {
            TopicArn: topic_arn
        }

        with-token merge(request-body, filter-vals({
            NextToken: next_token
        }, is-some))

        body to-json(with-token)

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.ListSubscriptionsByTopic"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { ListSubscriptionsResponse({
                subscriptions: cond {
                    is-null(response.body.Subscriptions) => { [] }
                    => { map(response.body.Subscriptions, Subscription({
                    subscription_arn: %.SubscriptionArn,
                    owner: %.Owner,
                    protocol: %.Protocol,
                    endpoint: %.Endpoint,
                    topic_arn: %.TopicArn
                })) }
                },
                next_token: response.body.NextToken
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(topic_arn: Str, opts: Map): ListSubscriptionsResponse | AwsError {
    list-subscriptions-by-topic(topic_arn, null, opts)
},
(topic_arn: Str, next_token: Str?): ListSubscriptionsResponse | AwsError {
    list-subscriptions-by-topic(topic_arn, next_token, {})
},
(topic_arn: Str): ListSubscriptionsResponse | AwsError {
    list-subscriptions-by-topic(topic_arn, null)
}

// Get subscription attributes
get-subscription-attributes
meta {
    doc: """
    Get attributes of an SNS subscription.

    **Example**

    ```hot
    result ::aws::sns::subscriptions/get-subscription-attributes("arn:aws:sns:us-east-1:123456789012:orders:1a2b3c4d")
    result.attributes  // => {Protocol: "sqs", Endpoint: "arn:aws:sqs:...", ...}
    ```
    """
}
fn
(subscription_arn: Str, opts: Map): GetSubscriptionAttributesResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        body to-json({
            SubscriptionArn: subscription_arn
        })

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.GetSubscriptionAttributes"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { GetSubscriptionAttributesResponse({
                attributes: if(is-null(response.body.Attributes), {}, response.body.Attributes)
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(subscription_arn: Str): GetSubscriptionAttributesResponse | AwsError {
    get-subscription-attributes(subscription_arn, {})
}

// Set subscription attributes
set-subscription-attributes
meta {
    doc: """
    Set a single attribute of an SNS subscription.

    Common attribute names: FilterPolicy, FilterPolicyScope, RawMessageDelivery, RedrivePolicy.

    **Example**

    ```hot
    // Enable raw message delivery for SQS
    ::aws::sns::subscriptions/set-subscription-attributes("arn:aws:sns:us-east-1:123456789012:orders:1a2b3c4d", "RawMessageDelivery", "true")

    // Set a filter policy
    ::aws::sns::subscriptions/set-subscription-attributes(
        "arn:aws:sns:us-east-1:123456789012:orders:1a2b3c4d",
        "FilterPolicy",
        to-json({event_type: ["order"]})
    )
    ```
    """
}
fn
(subscription_arn: Str, attribute_name: Str, attribute_value: Str, opts: Map): Map | AwsError {
    if-ok(resolve(opts), (resolved) {
        body to-json({
            SubscriptionArn: subscription_arn,
            AttributeName: attribute_name,
            AttributeValue: attribute_value
        })

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.SetSubscriptionAttributes"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { { success: true } }
            => { AwsError(response) }
        }
    })
},
(subscription_arn: Str, attribute_name: Str, attribute_value: Str): Map | AwsError {
    set-subscription-attributes(subscription_arn, attribute_name, attribute_value, {})
}
