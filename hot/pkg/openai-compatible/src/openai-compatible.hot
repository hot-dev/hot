}

openrouter
meta {
    doc: """
    OpenRouter with the `openrouter.api.key` ctx key. Optional
    `openrouter.app.url` and `openrouter.app.title` are sent as the
    `HTTP-Referer` and `X-OpenRouter-Title` attribution headers.

    **Example**

    ```hot
    ::oc ::openai-compatible

    ::openai-compatible::chat/chat(::oc/openrouter(), "anthropic/claude-sonnet-4.5", "Say hi")

    // Another tenant's key, for one call
    ::oc/openrouter({api-key: ::hot::ctx/get("tenant.openrouter.key")})
    ```
    """,
    ctx: {
        "openrouter.api.key": {required: false},
        "openrouter.app.url": {required: false, secret: false},
        "openrouter.app.title": {required: false, secret: false}
    }
}
fn
(): CompatibleProvider {
    openrouter({})
},
(opts: Map): CompatibleProvider {
    headers openrouter-headers(::ctx/get("openrouter.app.url"), ::ctx/get("openrouter.app.title"))
    resolve(OPENROUTER, {headers: headers, ...opts})
}

openrouter-headers
meta {
    doc: """
    OpenRouter app-attribution headers. Unset values are omitted.

    **Example**

    ```hot
    ::openai-compatible/openrouter-headers("https://example.com", "Example")
    // => {"HTTP-Referer": "https://example.com", "X-OpenRouter-Title": "Example"}
    ```
    """
}
fn (app-url: Str?, app-title: Str?): Map {
    {}
    |> assoc-some("HTTP-Referer", if(is-empty(or(app-url, "")), null, app-url))
    |> assoc-some("X-OpenRouter-Title", if(is-empty(or(app-title, "")), null, app-title))
}

