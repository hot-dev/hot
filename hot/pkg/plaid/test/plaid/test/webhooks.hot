::plaid::test::webhooks ns
meta ["test"]

::webhooks ::plaid::webhooks

b64 fn (value: Map): Str {
    ::hot::base64/encode-url(to-json(value))
}

// An unsigned token with the given header and payload, for the checks that
// run before (or instead of) the signature. The verifier is stubbed.
fake-token fn (header: Map, payload: Map): Str {
    `${b64(header)}.${b64(payload)}.c2ln`
}

KID "6c5516e1-92dc-479e-a8ff-5a51992e0001"

// A webhook body exactly as Plaid sends it (2-space indented JSON).
BODY join([
    "{",
    "  \"environment\": \"sandbox\",",
    "  \"item_id\": \"Ed6bjNrDLJfGvZWwnkQlfxwoNz54B5C97ejBr\",",
    "  \"new_transactions\": 3,",
    "  \"webhook_code\": \"SYNC_UPDATES_AVAILABLE\",",
    "  \"webhook_type\": \"TRANSACTIONS\"",
    "}"
], "\n")

BODY_SHA256 "388fedbdb0f29527c1eb7095568fccd580b26ed36936fc49017522e8feec76be"

stub-jwk {kid: KID, alg: "ES256", crv: "P-256", kty: "EC", use: "sig", x: "x", y: "y", expired_at: null}

// Returns the token's payload as the claims, like a passing signature check.
stub-verify fn (token: Str, x: Any, y: Any, options: Map): Map {
    ::jwt/decode(token).payload
}

request-with fn (token: Str, body: Str): Map {
    {headers: {plaid-verification: token}, body-raw: body}
}

// ============================================================================
// Header parsing and kid selection
// ============================================================================

test-verification-token
meta ["test"] fn () {
    assert-eq("abc", ::webhooks/verification-token({headers: {plaid-verification: "abc"}}))
    assert-eq("abc", ::webhooks/verification-token({headers: {Plaid-Verification: " abc "}}), "case-insensitive and trimmed")
    assert-eq("", ::webhooks/verification-token({headers: {}}))
    assert-eq("", ::webhooks/verification-token({}))
}

test-token-key-id
meta ["test"] fn () {
    assert-eq(KID, ::webhooks/token-key-id(fake-token({alg: "ES256", kid: KID, typ: "JWT"}, {iat: 1})))
    assert(is-err(::webhooks/token-key-id(fake-token({alg: "HS256", kid: KID}, {iat: 1}))), "only ES256 is accepted")
    assert(is-err(::webhooks/token-key-id(fake-token({alg: "none", kid: KID}, {iat: 1}))), "alg none is rejected")
    assert(is-err(::webhooks/token-key-id(fake-token({alg: "ES256"}, {iat: 1}))), "a kid is required")
    assert(is-err(::webhooks/token-key-id("not-a-jwt")), "garbage errs")
}

// ============================================================================
// Body hash and key checks
// ============================================================================

test-body-hash
meta ["test"] fn () {
    assert(::webhooks/body-hash-matches(BODY, BODY_SHA256), "hash of the exact body matches")
    assert(::webhooks/body-hash-matches(BODY, uppercase(BODY_SHA256)), "hex case doesn't matter")
    assert(not(::webhooks/body-hash-matches(replace(BODY, "  ", "    "), BODY_SHA256)), "re-indented body does not match")
    assert(not(::webhooks/body-hash-matches(BODY, null)), "missing claim fails closed")
    assert(not(::webhooks/body-hash-matches(BODY, "")), "empty claim fails closed")
}

test-check-key
meta ["test"] fn () {
    assert-eq(true, ::webhooks/check-key(stub-jwk, 1793000000))
    assert-eq(true, ::webhooks/check-key({...stub-jwk, expired_at: 1793000100}, 1793000000), "not yet expired")
    assert(is-err(::webhooks/check-key({...stub-jwk, expired_at: 1792999999}, 1793000000)), "expired key is refused")
    assert(is-err(::webhooks/check-key({...stub-jwk, alg: "RS256"}, 1)), "wrong alg")
    assert(is-err(::webhooks/check-key({...stub-jwk, crv: "P-384"}, 1)), "wrong curve")
    assert(is-err(::webhooks/check-key({kid: KID}, 1)), "missing coordinates")
}

test-verify-options
meta ["test"] fn () {
    assert-eq({max-age: 300, leeway: 0}, ::webhooks/verify-options({}), "Plaid's five minutes, no extra leeway")
    assert-eq(30, ::webhooks/verify-options({leeway: 30}).leeway)
}

// ============================================================================
// check-webhook-with (stubbed verifier)
// ============================================================================

test-check-webhook-stubbed
meta ["test"] fn () {
    good fake-token({alg: "ES256", kid: KID}, {iat: 1793000000, request_body_sha256: BODY_SHA256})
    claims ::webhooks/check-webhook-with(request-with(good, BODY), stub-jwk, {now: 1793000010}, stub-verify)
    assert-eq(BODY_SHA256, claims.request_body_sha256, "valid request returns the claims")

    tampered ::webhooks/check-webhook-with(request-with(good, replace(BODY, "3", "4")), stub-jwk, {now: 1793000010}, stub-verify)
    assert(is-err(tampered), "tampered body fails")

    missing ::webhooks/check-webhook-with({headers: {}, body-raw: BODY}, stub-jwk, {}, stub-verify)
    assert(is-err(missing), "missing header fails")

    other-kid ::webhooks/check-webhook-with(request-with(good, BODY), {...stub-jwk, kid: "another"}, {}, stub-verify)
    assert(is-err(other-kid), "a key for another kid is not used")

    no-hash fake-token({alg: "ES256", kid: KID}, {iat: 1793000000})
    assert(is-err(::webhooks/check-webhook-with(request-with(no-hash, BODY), stub-jwk, {}, stub-verify)), "claims without a body hash fail")

    rejecting (token, x, y, options) { err("jwt: invalid signature") }
    assert(is-err(::webhooks/check-webhook-with(request-with(good, BODY), stub-jwk, {}, rejecting)), "a failed signature check fails")

    expired ::webhooks/check-webhook-with(request-with(good, BODY), {...stub-jwk, expired_at: 1}, {now: 1793000010}, stub-verify)
    assert(is-err(expired), "an expired key fails before verifying")
}

test-verify-webhook-without-header-is-false
meta ["test"] fn () {
    // No header: false straight away, with no key fetch and no credentials.
    assert(not(::webhooks/verify-webhook({headers: {}, body-raw: BODY})))
}

test-event-fields
meta ["test"] fn () {
    e ::webhooks/event({body: {webhook_type: "TRANSACTIONS", webhook_code: "SYNC_UPDATES_AVAILABLE", item_id: "item-1"}})
    assert-eq("TRANSACTIONS", e.webhook_type)
    assert-eq("SYNC_UPDATES_AVAILABLE", e.webhook_code)
    assert-eq("item-1", e.item_id)
    assert(is-null(e.error))
    assert(is-null(::webhooks/event({body: null}).item_id))
}
