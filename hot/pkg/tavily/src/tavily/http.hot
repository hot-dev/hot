::tavily::http ns
meta {
    doc: """HTTP plumbing for Tavily: one `HttpError` shape with a readable message, and `send`."""
}

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError
meta {
    doc: """A non-2xx Tavily response. `message` is readable text such as `Tavily API error 401: Unauthorized: missing or invalid API key.`; `body` keeps the raw response."""
}
type {
    status: Int,
    message: Str,
    headers: Map,
    body: Any
}

error-detail
meta {
    doc: """
    Tavily's error text from a response body, or null. Understands `{detail:
    {error}}`, `{detail}`, and plain `{message}` or string bodies. Exposed
    for testing.

    **Example**

    ```hot
    ::tavily::http/error-detail({detail: {error: "Unauthorized"}})  // "Unauthorized"
    ::tavily::http/error-detail({message: "Bad request"})  // "Bad request"
    ::tavily::http/error-detail(500)  // null
    ```
    """
}
fn (body: Any): Any {
  cond {
    is-str(body) => { text-or-null(body) }
    not(is-map(body)) => { null }
    => {
      detail get(body, "detail")
      or(
        if(is-map(detail), text-or-null(get(detail, "error")), text-or-null(detail)),
        text-or-null(get(body, "message"))
      )
    }
  }
}

text-or-null
meta {no-doc: true}
fn (value: Any): Any {
  if(and(is-str(value), not(is-blank(value))), value, null)
}

error-message
meta {
    doc: """
    `Tavily API error <status>: <detail>`, or without the detail when the
    body has none. Exposed for testing.

    **Example**

    ```hot
    ::tavily::http/error-message(401, {detail: {error: "Unauthorized"}})  // "Tavily API error 401: Unauthorized"
    ::tavily::http/error-message(500, "")  // "Tavily API error 500"
    ```
    """
}
fn (status: Int, body: Any): Str {
  detail error-detail(body)
  if(is-some(detail), `Tavily API error ${status}: ${detail}`, `Tavily API error ${status}`)
}

http-error
meta {
    doc: """
    Build the `HttpError` for a non-2xx response. Exposed for testing.

    **Example**

    ```hot
    response ::hot::http/HttpResponse({status: 429, headers: {}, body: {detail: "Slow down"}})
    e ::tavily::http/http-error(response)
    e.status  // 429
    e.message  // "Tavily API error 429: Slow down"
    ```
    """
}
fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    message: error-message(response.status, response.body),
    headers: or(response.headers, {}),
    body: response.body
  })
}

send
meta {
    doc: """
    Send `request` and unwrap: the decoded JSON body on 2xx, an Err carrying
    `HttpError` otherwise, or the transport Err.

    **Example**

    ```hot
    key ::hot::ctx/get("tavily.api.key")
    out ::tavily::http/send(::tavily/build-request("/search", {query: "hot language"}, key))
    if(is-err(out), out, map(out.results, (r) { r.url }))
    ```
    """
}
fn (request: HttpRequest): Any {
  response ::hot::http/request(request)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body }
    => { err(http-error(response)) }
  }
}
