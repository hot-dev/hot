// ============================================================================
// URLs
// ============================================================================

get-public-url
meta {
    doc: """
Build the public URL for an object in a public bucket. This is a pure string operation -- no API call.

**Example**

```hot
::storage ::supabase::storage

url ::storage/get-public-url("avatars", "users/alice.jpg")
// => "https://xxxx.supabase.co/storage/v1/object/public/avatars/users/alice.jpg"
```
"""
}
fn
(bucket: Str, path: Str): Str {
  `${::core/project-url()}/storage/v1/object/public/${object-path(bucket, path)}`
},
(bucket: Str, path: Str, opts: Map): Str {
  resolved ::api/resolve(opts)
  if(is-err(resolved), resolved, `${resolved.url}/storage/v1/object/public/${object-path(bucket, path)}`)
}

create-signed-url
meta {
    doc: """
Create a signed URL for temporary access to a private object. `expires-in` is the validity in seconds.

**Example**

```hot
::storage ::supabase::storage

result ::storage/create-signed-url("documents", "reports/q1.pdf", 3600)
result.signedURL  // => "/storage/v1/object/sign/documents/reports/q1.pdf?token=..."
```
"""
}
fn
(bucket: Str, path: Str, expires-in: Int): SignedUrlResponse {
  create-signed-url(bucket, path, expires-in, {})
},
(bucket: Str, path: Str, expires-in: Int, opts: Map): SignedUrlResponse {
  ::api/request("POST", `/storage/v1/object/sign/${object-path(bucket, path)}`, {}, {expiresIn: expires-in}, opts)
}

create-signed-url-as
meta {
    doc: """
    Like `create-signed-url`, but as a signed-in user. `access-token` is the
    Bearer token, so row level security applies as that user.

    **Example**

    ```hot
    ::storage ::supabase::storage

    token ::hot::ctx/get("supabase.user.token")
    result ::storage/create-signed-url-as("documents", "reports/q1.pdf", 3600, token)
    result.signedURL
    ```
    """
}
fn
(bucket: Str, path: Str, expires-in: Int, access-token: Str): SignedUrlResponse {
  create-signed-url-as(bucket, path, expires-in, access-token, {})
},
(bucket: Str, path: Str, expires-in: Int, access-token: Str, opts: Map): SignedUrlResponse {
  ::api/request-as("POST", `/storage/v1/object/sign/${object-path(bucket, path)}`, {}, {expiresIn: expires-in}, access-token, opts)
}

create-signed-url-service
meta {
    doc: """
    Like `create-signed-url`, with the service role key, which bypasses row
    level security. Server-side only.

    **Example**

    ```hot
    ::storage ::supabase::storage

    result ::storage/create-signed-url-service("documents", "reports/q1.pdf", 3600)
    result.signedURL
    ```
    """
}
fn
(bucket: Str, path: Str, expires-in: Int): SignedUrlResponse {
  create-signed-url-service(bucket, path, expires-in, {})
},
(bucket: Str, path: Str, expires-in: Int, opts: Map): SignedUrlResponse {
  ::api/request-service("POST", `/storage/v1/object/sign/${object-path(bucket, path)}`, {}, {expiresIn: expires-in}, opts)
}

create-signed-urls
meta {
    doc: """
    Create signed URLs for multiple objects in a bucket at once.

    **Example**

    ```hot
    ::storage ::supabase::storage

    urls ::storage/create-signed-urls("documents", ["reports/q1.pdf", "reports/q2.pdf"], 3600)
    map(urls, %.signedURL)
    ```
    """
}
fn
(bucket: Str, paths: Vec<Str>, expires-in: Int): Vec<Map> {
  create-signed-urls(bucket, paths, expires-in, {})
},
(bucket: Str, paths: Vec<Str>, expires-in: Int, opts: Map): Vec<Map> {
  ::api/request("POST", `/storage/v1/object/sign/${bucket-path(bucket)}`, {}, {expiresIn: expires-in, paths: paths}, opts)
}

create-signed-upload-url
meta {
    doc: """
    Create a signed URL for uploading an object without further
    authentication.

    **Example**

    ```hot
    ::storage ::supabase::storage

    target ::storage/create-signed-upload-url("documents", "reports/q3.pdf", 3600)
    target.url
    target.token
    ```
    """
}
fn
(bucket: Str, path: Str, expires-in: Int): SignedUploadUrlResponse {
  create-signed-upload-url(bucket, path, expires-in, {})
},
(bucket: Str, path: Str, expires-in: Int, opts: Map): SignedUploadUrlResponse {
  ::api/request("POST", `/storage/v1/object/upload/sign/${object-path(bucket, path)}`, {}, {expiresIn: expires-in}, opts)
}

create-signed-upload-url-as
meta {
    doc: """
    Like `create-signed-upload-url`, but as a signed-in user. `access-token`
    is the Bearer token, so row level security applies as that user.

    **Example**

    ```hot
    ::storage ::supabase::storage

    token ::hot::ctx/get("supabase.user.token")
    target ::storage/create-signed-upload-url-as("documents", "reports/q3.pdf", 3600, token)
    target.url
    ```
    """
}
fn
(bucket: Str, path: Str, expires-in: Int, access-token: Str): SignedUploadUrlResponse {
  create-signed-upload-url-as(bucket, path, expires-in, access-token, {})
},
(bucket: Str, path: Str, expires-in: Int, access-token: Str, opts: Map): SignedUploadUrlResponse {
  ::api/request-as("POST", `/storage/v1/object/upload/sign/${object-path(bucket, path)}`, {}, {expiresIn: expires-in}, access-token, opts)
}
