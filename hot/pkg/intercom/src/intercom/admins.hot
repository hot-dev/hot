::intercom::admins ns
meta {
    ctx: {"intercom.token": {required: false}},
    doc: """Admins (teammates): find the id to set as `intercom.admin.id`, and the ids to assign conversations to."""
}

::api ::intercom::api

me
meta {
    doc: """
    GET /me - The admin the access token acts as, with its workspace
    (`app`, including `region`). Its `id` is the usual value for
    `intercom.admin.id`, and the cheapest token check.

    **Example**

    ```hot
    admin ::intercom::admins/me()
    admin.id
    ```
    """
}
fn
(): Any {
  me({})
},
(opts: Map): Any {
  ::api/request("GET", "/me", "", opts)
}

list-admins
meta {
    doc: """
    GET /admins - Every admin in the workspace: `{type: "admin.list",
    admins: [...]}`.

    **Example**

    ```hot
    out ::intercom::admins/list-admins()
    map(out.admins, %.email)
    ```
    """
}
fn
(): Any {
  list-admins({})
},
(opts: Map): Any {
  ::api/request("GET", "/admins", "", opts)
}

get-admin
meta {
    doc: """
    GET /admins/{id} - One admin.

    **Example**

    ```hot
    admin ::intercom::admins/get-admin("814860")
    admin.name
    ```
    """
}
fn
(id: Any): Any {
  get-admin(id, {})
},
(id: Any, opts: Map): Any {
  ::api/request("GET", `/admins/${::api/path-segment(id)}`, "", opts)
}

find-admin-by-email
meta {
    doc: """
    The admin whose `email` matches (case-insensitive), from `list-admins`,
    or null.

    **Example**

    ```hot
    admin ::intercom::admins/find-admin-by-email("support@example.com")
    if(is-null(admin), "no such admin", admin.id)
    ```
    """
}
fn
(email: Str): Any {
  find-admin-by-email(email, {})
},
(email: Str, opts: Map): Any {
  out list-admins(opts)
  cond {
    is-err(out) => { out }
    => { find-first(or(get(out, "admins"), []), (a) { eq(lowercase(or(a.email, "")), lowercase(email)) }) }
  }
}

list-teams
meta {
    doc: """
    GET /teams - The workspace's teams (assignment targets for
    `assign-conversation` with `type: "team"`).

    **Example**

    ```hot
    out ::intercom::admins/list-teams()
    map(out.teams, %.name)
    ```
    """
}
fn
(): Any {
  list-teams({})
},
(opts: Map): Any {
  ::api/request("GET", "/teams", "", opts)
}
