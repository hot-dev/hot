::cfpb::complaints::integration::ctx ns

::env ::hot::env

// The API needs no key, but this only runs with CFPB_COMPLAINTS_LIVE=1, so CI
// without network stays hermetic.

live
meta {doc: """True when CFPB_COMPLAINTS_LIVE=1."""}
fn (): Bool {
    eq(::env/get("CFPB_COMPLAINTS_LIVE", ""), "1")
}

skip
meta {doc: """Record a skip and pass."""}
fn (why: Str): Bool {
    println(`cfpb-complaints integration: ${why} - skipping`)
    assert(true, `skipped: ${why}`)
}
