::brave::search::api ns
meta {
    ctx: {"brave.api.key": {required: false}},
    doc: """
    Credentials for Brave Search.

    **Per-call credentials.** Every API-calling function in `::brave::search`
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then the `brave.api.key` context variable. Nothing from `opts`
    is written to ctx, so one run can act for many tenants and parallel
    flows don't share credentials. Credentials in `opts` are masked in
    call records. An `api-key` present but blank or null is an error,
    never a fallback to context.

    - `api-key`: the API key for this call
    """
}

::ctx ::hot::ctx

non-blank fn (value: Any): Str? {
  if(is-str(value), if(is-blank(value), null, trim(value)), null)
}

resolve-from
meta {
    doc: """The one resolver, pure: `{api-key}` for a call from `opts` first, then `ctx-values` (a Map of context variables). An Err when no API key is set, or when `api-key` is in `opts` but blank or null (that never falls back to context). Exposed for testing; `resolve` feeds it the context."""
}
fn (opts: Map, ctx-values: Map): Map {
  opt-key non-blank(get(opts, "api-key"))
  api-key or(opt-key, non-blank(get(ctx-values, "brave.api.key")))
  cond {
    and(in("api-key", keys(opts)), is-null(opt-key)) => {
      err("brave: api-key is in the call's opts but is blank or null. Pass a value, or leave api-key out to use brave.api.key.")
    }

    is-null(api-key) => { err("brave: brave.api.key is not set. Add it in Context Variables, or pass {api-key: ...} in the call's opts.") }
    => { {api-key: api-key} }
  }
}

resolve
meta {
    ctx: {"brave.api.key": {required: false}},
    doc: """
    The credentials for one call (see `resolve-from`). An `api-key` from
    `opts` is masked in this run's records and never written to ctx.

    **Example**

    ```hot
    ::brave::search::api/resolve({api-key: "tenant-b-token"}).api-key  // "tenant-b-token"
    ```
    """
}
fn (opts: Map): Map {
  ::ctx/mark-secret(non-blank(get(opts, "api-key")))
  resolve-from(opts, {"brave.api.key": ::ctx/get("brave.api.key")})
}
