::stripe::refunds ns
meta {
    doc: """Refunds: full or partial refunds of a PaymentIntent or charge. See https://docs.stripe.com/api/refunds."""
}

api-call ::stripe::api/call
seg ::stripe::api/encode-id
RequestOptions ::stripe::api/RequestOptions

// ============================================================================
// Refunds
// ============================================================================

CreateRefundRequest type {
  payment_intent: Str?,
  charge: Str?,
  amount: Int?,
  reason: Str?,
  metadata: Map?,
  instructions_email: Str?,
  refund_application_fee: Bool?,
  reverse_transfer: Bool?,
  expand: Vec<Str>?
}

create-refund
meta {
    doc: """
POST /v1/refunds - Refund a PaymentIntent (preferred) or charge, in full (omit `amount`) or partially. `reason` can be "duplicate", "fraudulent", or "requested_by_customer". Pass an idempotency key so a retried refund is never issued twice.

**Example**

```hot
::refunds ::stripe::refunds

refund ::refunds/create-refund(::refunds/CreateRefundRequest({
  payment_intent: "pi_...",
  amount: 500
}), ::stripe::api/RequestOptions({idempotency_key: "order-42-refund-1"}))
refund.status  // => "succeeded" (or "pending" for some methods)
```
"""
}
fn
(request: CreateRefundRequest): Map {
  create-refund(request, RequestOptions({}))
},
(request: CreateRefundRequest, options: RequestOptions | Map): Map {
  api-call("POST", "/v1/refunds", request, options)
}

get-refund
meta {
    doc: """GET /v1/refunds/{refund} - Retrieve a refund by ID."""
}
fn
(refund: Str): Map {
  get-refund(refund, {})
},
(refund: Str, params: Map): Map {
  get-refund(refund, params, {})
},
(refund: Str, params: Map, opts: Map): Map {
  api-call("GET", `/v1/refunds/${seg(refund)}`, params, opts)
}

update-refund
meta {
    doc: """POST /v1/refunds/{refund} - Update a refund's metadata (the only updatable field)."""
}
fn
(refund: Str, metadata: Map): Map {
  update-refund(refund, metadata, RequestOptions({}))
},
(refund: Str, metadata: Map, options: RequestOptions | Map): Map {
  api-call("POST", `/v1/refunds/${seg(refund)}`, {metadata: metadata}, options)
}

cancel-refund
meta {
    doc: """POST /v1/refunds/{refund}/cancel - Cancel a refund. Only refunds with status "requires_action" can be canceled."""
}
fn
(refund: Str): Map {
  cancel-refund(refund, RequestOptions({}))
},
(refund: Str, options: RequestOptions | Map): Map {
  api-call("POST", `/v1/refunds/${seg(refund)}/cancel`, {}, options)
}

ListRefundsRequest type {
  payment_intent: Str?,
  charge: Str?,
  created: Any?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-refunds
meta {
    doc: """GET /v1/refunds - List refunds, most recent first. Filter by `payment_intent` or `charge`."""
}
fn
(): Map {
  list-refunds(ListRefundsRequest({}))
},
(request: ListRefundsRequest): Map {
  list-refunds(request, {})
},
(request: ListRefundsRequest, opts: Map): Map {
  api-call("GET", "/v1/refunds", request, opts)
}
