::ai::message ns
meta {
    doc: "Normalized message types for AI agents. Includes Role enum, ChatMessage, Message (with session + sender), and AgentMessage for inter-agent bus."
}

Session  ::ai::session/Session
Identity ::ai::session/Identity

// ============================================================================
// Role Enum
// ============================================================================

Role
meta {
    doc: """
    The role of a message in an AI conversation. The closed variant
    set covers the standard chat-completion roles: `User`,
    `Assistant`, `System`, and `Tool` (for tool/function call
    results that are fed back to the model). `Tool` is the only
    role recognized by every modern provider beyond the original
    three; rather than open the enum, we add it explicitly.
    """
}
enum { User, Assistant, System, Tool }

// ============================================================================
// ChatMessage — lightweight role + content for AI threads
// ============================================================================

ChatMessage
meta { doc: "A single message in an AI conversation thread." }
type {
    role: Role,
    content: Str
}

user-msg
meta {
    doc: """
    Create a ChatMessage with role User.

    **Example**

    ```hot
    ::ai::message/user-msg("Hello").content  // "Hello"
    ```
    """
}
fn (content: Str): ChatMessage {
    ChatMessage({role: Role.User, content: content})
}

assistant-msg
meta {
    doc: """
    Create a ChatMessage with role Assistant.

    **Example**

    ```hot
    ::ai::message/assistant-msg("Hi there").content  // "Hi there"
    ```
    """
}
fn (content: Str): ChatMessage {
    ChatMessage({role: Role.Assistant, content: content})
}

system-msg
meta {
    doc: """
    Create a ChatMessage with role System.

    **Example**

    ```hot
    ::ai::message/system-msg("Be concise.").content  // "Be concise."
    ```
    """
}
fn (content: Str): ChatMessage {
    ChatMessage({role: Role.System, content: content})
}

tool-msg
meta {
    doc: """
    Create a ChatMessage with role Tool — used for tool/function call
    results fed back into the model.

    **Example**

    ```hot
    ::ai::message/tool-msg("18C and clear").content  // "18C and clear"
    ```
    """
}
fn (content: Str): ChatMessage {
    ChatMessage({role: Role.Tool, content: content})
}

// ============================================================================
// Message — a message in a conversation with session + sender
// ============================================================================

Message
meta { doc: "A message in a conversation, carrying session and sender context." }
type {
    id: Str,
    content: Str,
    sender: Identity,
    session: Session,
    timestamp: Int,
    source: Str?,
    metadata: Map?,
}

// ============================================================================
// AgentMessage — routed through the inter-agent event bus
// ============================================================================

AgentMessage
meta {
    doc: "A message routed between agents via the event bus. Carries session + sender."
}
type {
    session: Session,
    sender: Identity,
    from-agent: Str?,
    to-agent: Str?,
    content: Str,
    reply-event: Str?,
    correlation-id: Str?,
    metadata: Map?,
}

// ============================================================================
// Helpers
// ============================================================================

format-messages
meta {
    doc: """
    Render a Vec of Messages as [sender]: content lines for AI prompts.

    **Example**

    ```hot
    ::ai::message/format-messages([
        {content: "Hello", sender: {id: "u1", name: "Ada"}},
        {content: "Hi Ada", sender: {id: "u2"}}
    ])  // "[Ada]: Hello\n[u2]: Hi Ada"
    ```
    """
}
fn (messages: Vec): Str {
    messages
        |> map((m) { `[${or(m.sender.name, m.sender.id)}]: ${m.content}` })
        |> join("\n")
}

format-chat-messages
meta {
    doc: """
    Render a Vec of ChatMessages as role: content lines.

    **Example**

    ```hot
    ::ai::message/format-chat-messages([
        ::ai::message/user-msg("Hello"),
        ::ai::message/assistant-msg("Hi there")
    ])  // "user: Hello\nassistant: Hi there"
    ```
    """
}
fn (messages: Vec): Str {
    messages
        |> map((m) {
            role-str match m.role {
                Role.User      => { "user" }
                Role.Assistant => { "assistant" }
                Role.System    => { "system" }
                Role.Tool      => { "tool" }
            }
            `${role-str}: ${m.content}`
        })
        |> join("\n")
}
