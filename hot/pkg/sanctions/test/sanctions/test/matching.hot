::sanctions::test::matching ns
meta ["test"]

::text ::sanctions::text
::sim ::sanctions::similarity
::country ::sanctions::country

// Reference values: the classic Jaro / Jaro-Winkler examples (Winkler 1990)
// and Levenshtein kitten/sitting, cross-checked with an independent Python
// implementation of the same algorithms.

// ============================================================================
// Normalization
// ============================================================================

test-fold-latin-diacritics-and-ligatures
meta ["test"]
fn () {
    assert-eq("gulsen muller", ::text/fold("Ğülşen Müller"))
    assert-eq("francois lelievre", ::text/fold("François Lelièvre"))
    assert-eq("strasse aeneas oeuvre", ::text/fold("Straße Æneas Œuvre"))
    assert-eq("lukasz zolkiewski", ::text/fold("Łukasz Żółkiewski"))
    assert-eq("already ascii", ::text/fold("ALREADY ASCII"))
}

test-fold-cyrillic-and-greek
meta ["test"]
fn () {
    assert-eq("putin", ::text/fold("Путин"))
    assert-eq("shchukin", ::text/fold("Щукин"))
    assert-eq("yevgen", ::text/fold("Євген"), "simplified: г is always g")
    assert-eq("athina", ::text/fold("Αθήνα"))
}

test-clean-punctuation
meta ["test"]
fn () {
    assert-eq("oneil sa al qaida", ::text/clean("O'Neil S.A. al-Qaida"))
    assert-eq("abu abbas", ::text/clean("  ABU   ABBAS,  "))
    assert-eq("عبد الکبیر", ::text/clean("عبد الکبیر"), "other scripts are kept")
}

test-tokens-strip-corporate-suffixes
meta ["test"]
fn () {
    assert-eq(["acme", "trading"], ::text/tokens("Acme Trading Co., Ltd.", true))
    assert-eq(["gazprombank"], ::text/tokens("GAZPROMBANK JOINT STOCK COMPANY", true))
    assert-eq(["siemens"], ::text/tokens("Siemens GmbH", true))
    assert-eq(["the", "company"], ::text/tokens("The Company", true), "never reduced to nothing")
    assert-eq(["acme", "trading", "co", "ltd"], ::text/tokens("Acme Trading Co., Ltd.", false), "kept for individuals")
}

test-tokens-strip-honorifics-for-individuals
meta ["test"]
fn () {
    assert-eq(["al", "zawahiri", "ayman"], ::text/tokens("AL ZAWAHIRI, Dr. Ayman", false))
    assert-eq(["dr"], ::text/tokens("Dr.", false))
    assert-eq([], ::text/tokens("  ", false))
}

test-skeleton-groups-spellings
meta ["test"]
fn () {
    assert-eq("mhmd", ::text/skeleton("mohammed"))
    assert-eq("mhmd", ::text/skeleton("muhammad"))
    assert-eq("mhmd", ::text/skeleton("mohamad"))
    assert-eq(::text/skeleton("zawahiri"), ::text/skeleton("zawahri"))
    assert-eq(::text/skeleton("philip"), ::text/skeleton("filip"))
    assert-eq(::text/skeleton("khalid"), ::text/skeleton("chalid"))
    assert-eq("عبد", ::text/skeleton("عبد"), "non-ASCII tokens are their own key")
}

test-blocking-keys
meta ["test"]
fn () {
    assert-eq(["p:ayma", "p:zawa", "s:amn", "s:svhr"], ::text/blocking-keys(["al", "zawahiri", "ayman"]))
    assert-eq(["s:al", "s:b"], ::text/blocking-keys(["al", "bo"]), "short-only names still get keys")
    assert-eq([], ::text/blocking-keys([]))
}

test-merge-particles
meta ["test"]
fn () {
    assert-eq(["abubakr", "albaghdadi"], ::text/merge-particles(["abu", "bakr", "al", "baghdadi"]))
    assert-eq(["john", "smith"], ::text/merge-particles(["john", "smith"]))
    assert-eq(["al"], ::text/merge-particles(["al"]))
}

test-collapse-repeats
meta ["test"]
fn () {
    assert-eq("mhmd", ::text/collapse-repeats("mhmmd"))
    assert-eq("abc", ::text/collapse-repeats("aaabbbc"))
    assert-eq("", ::text/collapse-repeats(""))
}

test-country-codes
meta ["test"]
fn () {
    assert-eq("MM", ::country/code("Burma"))
    assert-eq("CD", ::country/code("Congo, Democratic Republic of the"))
    assert-eq("IR", ::country/code("ir"))
    assert-eq("RU", ::country/code("USSR (now Russian Federation)"))
    assert-eq("BY", ::country/code("Former USSR Currently Belarus"))
    assert-eq("PS", ::country/code("Region: Gaza"))
    assert-eq("CI", ::country/code("Côte d'Ivoire"))
    assert-eq(null, ::country/code("Atlantis"))
    assert-eq(null, ::country/code("QQ"), "unknown two-letter codes are not codes")
    assert-eq("atlantis", ::country/key("Atlantis"))
    assert-eq("Iran", ::country/name("ir"))
}

// ============================================================================
// Similarity
// ============================================================================

test-jaro-known-values
meta ["test"]
fn () {
    assert-eq(0.9444, ::sim/jaro("martha", "marhta"))
    assert-eq(0.7667, ::sim/jaro("dixon", "dicksonx"))
    assert-eq(1.0, ::sim/jaro("", ""))
    assert-eq(0.0, ::sim/jaro("abc", ""))
    assert-eq(0.0, ::sim/jaro("abc", "xyz"))
}

test-jaro-winkler-known-values
meta ["test"]
fn () {
    assert-eq(0.9611, ::sim/jaro-winkler("martha", "marhta"))
    assert-eq(0.8133, ::sim/jaro-winkler("dixon", "dicksonx"))
    assert-eq(0.84, ::sim/jaro-winkler("dwayne", "duane"))
    assert-eq(1.0, ::sim/jaro-winkler("same", "same"))
}

test-levenshtein-known-values
meta ["test"]
fn () {
    assert-eq(3, ::sim/levenshtein("kitten", "sitting"))
    assert-eq(0.5714, ::sim/levenshtein-ratio("kitten", "sitting"))
    assert-eq(3, ::sim/levenshtein("", "abc"))
    assert-eq(0, ::sim/levenshtein("abc", "abc"))
    assert-eq(1.0, ::sim/levenshtein-ratio("", ""))
    assert-eq(1, ::sim/levenshtein("café", "cafe"), "by character, not byte")
}

test-token-sim
meta ["test"]
fn () {
    assert-eq(1.0, ::sim/token-sim("ayman", "ayman"))
    assert-eq(0.0, ::sim/token-sim("ayman", "zawahiri"), "different first letters")
    assert-eq(0.0, ::sim/token-sim("abc", "axy"), "below the 0.8 floor")
    assert-eq(0.9464, ::sim/token-sim("zawahri", "zawahiri"), "a typo stays high")
}

test-token-set-order-and-extras
meta ["test"]
fn () {
    assert-eq(1.0, ::sim/token-set(["abu", "abbas"], ["abbas", "abu"]))
    assert-eq(0.5, ::sim/token-set(["gazprombank"], ["gazprombank", "joint", "stock"]), "extra tokens count against")
    assert-eq(1.0, ::sim/token-set(["ayman", "zawahiri"], ["al", "zawahiri", "ayman"]), "an unmatched particle is not counted")
    assert-eq(0.0, ::sim/token-set([], ["x"]))
}

test-similarity-counts-code-points
meta ["test"]
fn () {
    // Same results as the ASCII pairs with one letter per position swapped for a
    // multi-byte one, computed independently with Python over code points.
    assert-eq(::sim/jaro-winkler("martha", "marhta"), ::sim/jaro-winkler("mértha", "mérhta"))
    assert-eq(0.9611, ::sim/jaro-winkler("日本語テスト", "日本語ステト"))
    assert-eq(1, ::sim/levenshtein("José", "Jose"))
    assert-eq(0.75, ::sim/levenshtein-ratio("José", "Jose"))
    assert-eq(3, ::sim/levenshtein("кіттен", "сіттінг"))
    assert-eq(0.5714, ::sim/levenshtein-ratio("кіттен", "сіттінг"))
    assert-eq(["p:日本語テ", "s:日本語テスト"], ::sanctions::text/token-keys("日本語テスト") |> sort(), "five characters, not bytes, earn a prefix key")
    assert-eq(["s:日本語"], ::sanctions::text/token-keys("日本語"), "nine bytes are still three characters")
}

test-name-similarity
meta ["test"]
fn () {
    assert-eq(1.0, ::sim/name-similarity(["ayman", "al", "zawahiri"], ["al", "zawahiri", "ayman"]))
    assert-eq(1.0, ::sim/name-similarity(["ayman", "alzawahiri"], ["al", "zawahiri", "ayman"]), "merged particle")
    assert(gt(::sim/name-similarity(["aiman", "zawahri"], ["al", "zawahiri", "ayman"]), 0.85), "two typos")
    assert(lt(::sim/name-similarity(["john", "smith"], ["jane", "doe"]), 0.5))
}

test-round4
meta ["test"]
fn () {
    assert-eq(0.6667, ::sim/round4(div(2, 3)))
    assert-eq(1.0, ::sim/round4(1))
}
