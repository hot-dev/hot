::discord::interactions ns
meta {
    doc: """
    Interactions: handle Discord's signed interaction webhooks (verify,
    answer PING with PONG, reply inline), respond through the callback
    endpoint, manage the original response and followups, and register
    application commands (global and per guild).

    The interaction routes (callback, `@original`, followups) are
    authenticated by the interaction token, so they don't need
    `discord.bot.token`. Interaction tokens stay valid for 15 minutes; the
    initial response must arrive within 3 seconds.
    """
}

::api ::discord::api

seg ::discord::api/seg

HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

// ============================================================================
// Constants
// ============================================================================

// Interaction types (interaction.type)
PING 1
APPLICATION_COMMAND 2
MESSAGE_COMPONENT 3
APPLICATION_COMMAND_AUTOCOMPLETE 4
MODAL_SUBMIT 5

// Interaction callback types (response.type)
PONG 1
CHANNEL_MESSAGE_WITH_SOURCE 4
DEFERRED_CHANNEL_MESSAGE_WITH_SOURCE 5
DEFERRED_UPDATE_MESSAGE 6
UPDATE_MESSAGE 7
APPLICATION_COMMAND_AUTOCOMPLETE_RESULT 8
MODAL 9
LAUNCH_ACTIVITY 12

// Message flag: only the invoking user sees the message
EPHEMERAL 64

// ============================================================================
// Inline responses (returned from your webhook handler)
// ============================================================================

pong
meta {doc: """The PONG response (`{type: 1}`) for Discord's PING."""}
fn (): Map {
  {type: PONG}
}

message-response
meta {
    doc: """
    Reply with a message (callback type 4). `data` is message content:
    `{content?, embeds?, components?, allowed_mentions?, flags?, ...}`.
    The 2-arity form with `true` makes it ephemeral.

    **Example**

    ```hot
    ::discord::interactions/message-response({content: "Pong!"})
    ::discord::interactions/message-response({content: "Only you can see this"}, true)
    ```
    """
}
fn
(data: Map): Map {
  {type: CHANNEL_MESSAGE_WITH_SOURCE, data: data}
},
(data: Map, ephemeral: Bool): Map {
  flags if(ephemeral, ::hot::bit/or(or(get(data, "flags"), 0), EPHEMERAL), get(data, "flags"))
  {type: CHANNEL_MESSAGE_WITH_SOURCE, data: assoc-some(data, "flags", flags)}
}

deferred-response
meta {
    doc: """ACK now and show "thinking..." (callback type 5); finish later with `edit-original-interaction-response`. Pass `true` for an ephemeral reply."""
}
fn
(): Map {
  {type: DEFERRED_CHANNEL_MESSAGE_WITH_SOURCE}
},
(ephemeral: Bool): Map {
  if(ephemeral, {type: DEFERRED_CHANNEL_MESSAGE_WITH_SOURCE, data: {flags: EPHEMERAL}}, {type: DEFERRED_CHANNEL_MESSAGE_WITH_SOURCE})
}

update-message-response
meta {
    doc: """For component interactions: edit the message the component is on (callback type 7)."""
}
fn (data: Map): Map {
  {type: UPDATE_MESSAGE, data: data}
}

deferred-update-response
meta {
    doc: """For component interactions: ACK without a loading state, edit later (callback type 6)."""
}
fn (): Map {
  {type: DEFERRED_UPDATE_MESSAGE}
}

autocomplete-response
meta {
    doc: """Answer an autocomplete interaction with up to 25 `choices` (`[{name, value}]`, callback type 8)."""
}
fn (choices: Vec<Map>): Map {
  {type: APPLICATION_COMMAND_AUTOCOMPLETE_RESULT, data: {choices: choices}}
}

modal-response
meta {
    doc: """Open a modal (callback type 9). `components` are the modal's label/text-input components."""
}
fn (custom-id: Str, title: Str, components: Vec<Map>): Map {
  {type: MODAL, data: {custom_id: custom-id, title: title, components: components}}
}

option-value
meta {
    doc: """
    Read a slash-command option by name from an interaction
    (`interaction.data.options`, searching one level of subcommands).
    Returns `null` when absent.

    **Example**

    ```hot
    interaction {data: {name: "hello", options: [{name: "name", type: 3, value: "Ada"}]}}
    who or(::discord::interactions/option-value(interaction, "name"), "world")  // => "Ada"
    ```
    """
}
fn (interaction: Map, name: Str): Any {
  options or(get-in(interaction, ["data", "options"]), [])
  nested mapcat(options, (o) { or(get(o, "options"), []) })
  hit find-first(concat(options, nested), (o) { eq(get(o, "name"), name) })
  if(is-null(hit), null, get(hit, "value"))
}

json-response fn (status: Int, body: Map): HttpResponse {
  HttpResponse({status: status, headers: {content-type: "application/json"}, body: body})
}

handle-request
meta {
    doc: """
    Run an interactions endpoint: verify the request (401 on failure),
    answer PING with PONG, and otherwise call `handler` with the parsed
    interaction and return its result as the inline JSON response. The
    handler returns a response map such as `message-response(...)` or
    `deferred-response()`. The 3-arity form takes an explicit public key
    instead of `discord.public.key`.

    **Example**

    ```hot
    ::interactions ::discord::interactions

    on-discord
    meta {webhook: {service: "discord", path: "/interactions", method: "POST"}}
    fn (request: HttpRequest): HttpResponse {
      ::interactions/handle-request(request, (interaction) {
        cond {
          eq(get-in(interaction, ["data", "name"]), "ping") => { ::interactions/message-response({content: "Pong!"}) }
          => { ::interactions/message-response({content: "Unknown command"}, true) }
        }
      })
    }
    ```
    """
}
fn
(request: Map, handler: Fn): HttpResponse {
  respond(request, ::discord::webhooks/verify-request(request), handler)
},
(request: Map, handler: Fn, public-key: Str): HttpResponse {
  respond(request, ::discord::webhooks/verify-request(request, public-key), handler)
}

respond
meta {
    doc: """The dispatch step of `handle-request` after verification. Exposed for testing."""
}
fn (request: Map, verified: Bool, handler: Fn): HttpResponse {
  interaction or(get(request, "body"), {})
  cond {
    not(verified) => { json-response(401, {error: "invalid request signature"}) }
    eq(get(interaction, "type"), PING) => { json-response(200, pong()) }
    => { json-response(200, handler(interaction)) }
  }
}

// ============================================================================
// Callback endpoint
// ============================================================================

CreateInteractionResponseRequest type {
  interaction_id: Str,
  interaction_token: Str,
  type: Int,
  data: Map?,
  with_response: Bool?,
  files: Vec<::discord::api/FileUpload>?
}

create-interaction-response
meta {
    doc: """
    POST /interactions/{interaction_id}/{interaction_token}/callback -
    Respond out of band instead of inline (within 3 seconds). `type` is a
    callback type (4 message, 5 deferred, 6/7 component update, 8
    autocomplete, 9 modal). `with_response: true` returns the
    interaction callback object instead of `true`. `files` uploads
    attachments with the response.

    **Example**

    ```hot
    ::interactions ::discord::interactions

    ::interactions/create-interaction-response(::interactions/CreateInteractionResponseRequest({
      interaction_id: "1700000000000000000",
      interaction_token: "interaction-token",
      type: 4,
      data: {content: "Hello from Hot!"}
    }))
    ```
    """
}
fn
(request: CreateInteractionResponseRequest): Any {
  create-interaction-response(request, {})
},
(request: CreateInteractionResponseRequest, opts: Map): Any {
  files or(request.files, [])
  data cond {
    and(not(is-empty(files)), is-null(get(or(request.data, {}), "attachments"))) => {
      assoc(or(request.data, {}), "attachments", ::api/attachments-for(files))
    }
    => { request.data }
  }

  result ::api/call("POST", `/interactions/${seg(request.interaction_id)}/${::api/token-seg(request.interaction_token)}/callback`, {
    query: {with_response: request.with_response},
    body: assoc-some({type: request.type}, "data", data),
    files: files,
    auth: false
  }, opts)
  cond {
    is-err(result) => { result }
    eq(request.with_response, true) => { result }
    => { true }
  }
}

// ============================================================================
// Original response and followups
// ============================================================================

original-path fn (application-id: Str, interaction-token: Str): Str {
  `/webhooks/${seg(application-id)}/${::api/token-seg(interaction-token)}/messages/@original`
}

GetOriginalInteractionResponseRequest type {
  application_id: Str,
  interaction_token: Str
}

get-original-interaction-response
meta {
    doc: """GET /webhooks/{application_id}/{interaction_token}/messages/@original - The initial response message."""
}
fn
(request: GetOriginalInteractionResponseRequest): Map {
  get-original-interaction-response(request, {})
},
(request: GetOriginalInteractionResponseRequest, opts: Map): Map {
  ::api/call("GET", original-path(request.application_id, request.interaction_token), {auth: false}, opts)
}

EditOriginalInteractionResponseRequest type {
  application_id: Str,
  interaction_token: Str,
  content: Str?,
  embeds: Vec<Map>?,
  flags: Int?,
  allowed_mentions: Map?,
  components: Vec<Map>?,
  attachments: Vec<Map>?,
  poll: Map?,
  files: Vec<::discord::api/FileUpload>?,
  clear: Vec<Str>?
}

edit-original-interaction-response
meta {
    doc: """
    PATCH /webhooks/{application_id}/{interaction_token}/messages/@original -
    Edit the initial response; this is how a deferred (type 5) reply gets
    its content. Only fields you set are sent.

    **Example**

    ```hot
    ::interactions ::discord::interactions

    ::interactions/edit-original-interaction-response(::interactions/EditOriginalInteractionResponseRequest({
      application_id: "1800000000000000000",
      interaction_token: "interaction-token",
      content: "Report ready",
      files: [{filename: "report.csv", content: "a,b\n1,2\n"}]
    }))
    ```
    """
}
fn
(request: EditOriginalInteractionResponseRequest): Map {
  edit-original-interaction-response(request, {})
},
(request: EditOriginalInteractionResponseRequest, opts: Map): Map {
  files or(request.files, [])
  payload ::api/body(request, ["application_id", "interaction_token"])
  final cond {
    and(not(is-empty(files)), is-null(request.attachments)) => { assoc(payload, "attachments", ::api/attachments-for(files)) }
    => { payload }
  }

  ::api/call("PATCH", original-path(request.application_id, request.interaction_token), {
    body: final,
    files: files,
    auth: false
  }, opts)
}

DeleteOriginalInteractionResponseRequest type {
  application_id: Str,
  interaction_token: Str
}

delete-original-interaction-response
meta {
    doc: """DELETE /webhooks/{application_id}/{interaction_token}/messages/@original - Delete the initial response."""
}
fn
(request: DeleteOriginalInteractionResponseRequest): Bool {
  delete-original-interaction-response(request, {})
},
(request: DeleteOriginalInteractionResponseRequest, opts: Map): Bool {
  ::api/call-ok("DELETE", original-path(request.application_id, request.interaction_token), {auth: false}, opts)
}

CreateFollowupMessageRequest type {
  application_id: Str,
  interaction_token: Str,
  content: Str?,
  tts: Bool?,
  embeds: Vec<Map>?,
  allowed_mentions: Map?,
  components: Vec<Map>?,
  attachments: Vec<Map>?,
  flags: Int?,
  poll: Map?,
  files: Vec<::discord::api/FileUpload>?
}

create-followup-message
meta {
    doc: """POST /webhooks/{application_id}/{interaction_token} - Send a followup message. `flags: 64` makes it ephemeral. Returns the message."""
}
fn
(request: CreateFollowupMessageRequest): Map {
  create-followup-message(request, {})
},
(request: CreateFollowupMessageRequest, opts: Map): Map {
  files or(request.files, [])
  payload ::api/body(request, ["application_id", "interaction_token"])
  final cond {
    and(not(is-empty(files)), is-null(request.attachments)) => { assoc(payload, "attachments", ::api/attachments-for(files)) }
    => { payload }
  }

  ::api/call("POST", `/webhooks/${seg(request.application_id)}/${::api/token-seg(request.interaction_token)}`, {
    query: {wait: true},
    body: final,
    files: files,
    auth: false
  }, opts)
}

