// Inside an `Enum.Variant` match arm, the arm's binding holds the variant's
// payload when it is not a record: a Vec, a Str, an Int. Previously it held
// the variant, which only field access reads through, so a Vec payload had a
// length of 2 (its `$type` and `$val`). The matched variable, and a `fn
// match` parameter, keep the variant, so an arm can pass it on as the enum.
// A record variant's binding keeps the variant too: its fields read through.
::hot::test::match-variant-payloads ns
meta ["test"]

Ask type {
    step: Str
}

Circle type {
    radius: Dec
}

Status enum { Open(Vec), NotOwed(Str), Count(Int), Ring(Circle), Done }

Creature enum open { Dog }
Label type Str where gt(length(%), 0)
Label -> Creature.Named

open-steps fn (): Status {
    Status.Open([Ask(step: "a"), Ask(step: "b"), Ask(step: "c")])
}

owed fn match (s: Status): Any {
    Status.Open => { s }
    Status.NotOwed => { s }
    Status.Count => { s }
    Status.Ring => { s }
    Status.Done => { s }
}

test-vec-payload-binding
meta ["test"] fn () {
    steps match open-steps() {
        Status.Open (owed) => { owed }
        _ => { null }
    }

    assert(is-vec(steps), "the binding is the Vec payload")
    assert-eq(3, length(steps), "the Vec keeps every step")
    assert(is-type(first(steps), Ask), "the steps keep their type")
    assert-eq("b", steps[1].step, "the steps index like a Vec")
}

test-matched-variable-keeps-the-variant
meta ["test"] fn () {
    s open-steps()
    kept match s {
        Status.Open => { s }
        _ => { null }
    }

    assert(is-type(kept, Status.Open), "the matched variable is the variant")
    assert(is-type(kept, Status), "it can be passed on as the enum")
    steps match s {
        Status.Open (owed) => { map(owed, %.step) }
        _ => { null }
    }

    assert-eq(["a", "b", "c"], steps, "a binding the arm names is the Vec payload")
}

test-scalar-payloads
meta ["test"] fn () {
    reason match Status.NotOwed("why") {
        Status.NotOwed (why) => { why }
        _ => { null }
    }

    assert-eq("why", reason, "a Str payload binds as the Str")
    assert(is-str(reason), "the Str payload is a Str")
    assert-eq(8, match Status.Count(7) { Status.Count (n) => { add(n, 1) } _ => { 0 } },
        "an Int payload binds as the Int")
}

test-record-payload-keeps-the-variant
meta ["test"] fn () {
    ring match Status.Ring(radius: 2.0) {
        Status.Ring (c) => { c }
        _ => { null }
    }

    assert(is-type(ring, Status.Ring), "a record variant arm keeps the variant")
    assert-eq(2.0, ring.radius, "its payload fields read through")
}

test-fn-match-parameter-keeps-the-variant
meta ["test"] fn () {
    assert(is-type(owed(Status.NotOwed("why")), Status.NotOwed), "a fn match parameter is the variant")
    assert(is-type(owed(open-steps()), Status), "a Vec variant passes through fn match as the enum")
    assert(is-type(owed(Status.Done), Status.Done), "a unit variant stays the variant")
}

test-arrow-variant-payload
meta ["test"] fn () {
    name match Creature.Named("Rex") {
        Creature.Named (n) => { n }
        _ => { null }
    }

    assert-eq("Rex", name, "an arrow-enrolled variant binds its Str payload")
}

test-field-subject-is-not-shadowed
meta ["test"] fn () {
    order {id: "o-1", status: Status.NotOwed("paid")}
    seen match order.status {
        Status.NotOwed (why) => { [order.id, why] }
        _ => { null }
    }

    assert-eq(["o-1", "paid"], seen, "matching a field leaves the outer variable alone")
}
