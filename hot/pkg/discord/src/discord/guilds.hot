// ============================================================================
// Prune
// ============================================================================

GetGuildPruneCountRequest type {
  guild_id: Str,
  days: Int?,
  include_roles: Vec<Str>?
}

get-guild-prune-count
meta {
    doc: """GET /guilds/{guild_id}/prune - How many members a prune of inactive (`days`, 1-30, default 7) members would remove. Needs MANAGE_GUILD and KICK_MEMBERS."""
}
fn (request: GetGuildPruneCountRequest): Map {
  roles if(is-null(request.include_roles), null, join(request.include_roles, ","))
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/prune`, {query: {days: request.days, include_roles: roles}})
}

BeginGuildPruneRequest type {
  guild_id: Str,
  days: Int?,
  compute_prune_count: Bool?,
  include_roles: Vec<Str>?,
  reason: Str?
}

begin-guild-prune
meta {
    doc: """POST /guilds/{guild_id}/prune - Kick members inactive for `days`. Set `compute_prune_count: false` on large guilds. Returns `{pruned}`. Needs MANAGE_GUILD and KICK_MEMBERS."""
}
fn (request: BeginGuildPruneRequest): Map {
  ::api/call("POST", `/guilds/${seg(request.guild_id)}/prune`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  })
}

// ============================================================================
// Audit log and invites
// ============================================================================

GetGuildAuditLogRequest type {
  guild_id: Str,
  user_id: Str?,
  action_type: Int?,
  before: Str?,
  after: Str?,
  limit: Int?
}

get-guild-audit-log
meta {
    doc: """
    GET /guilds/{guild_id}/audit-logs - Audit log entries (up to `limit`,
    1-100), filtered by actor `user_id` and `action_type`. Returns
    `{audit_log_entries, users, ...}`. Needs VIEW_AUDIT_LOG.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    // Recent bans (action type 22)
    log ::guilds/get-guild-audit-log(::guilds/GetGuildAuditLogRequest({
      guild_id: "1000000000000000000",
      action_type: 22,
      limit: 20
    }))
    map(log.audit_log_entries, (e) { e.reason })
    ```
    """
}
fn (request: GetGuildAuditLogRequest): Map {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/audit-logs`, {
    query: {
      user_id: request.user_id,
      action_type: request.action_type,
      before: request.before,
      after: request.after,
      limit: request.limit
    }
  })
}

GetGuildInvitesRequest type {
  guild_id: Str
}

get-guild-invites
meta {
    doc: """GET /guilds/{guild_id}/invites - Every invite in a guild, with metadata. Needs MANAGE_GUILD or VIEW_AUDIT_LOG."""
}
fn (request: GetGuildInvitesRequest): Vec<Map> {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/invites`)
}
