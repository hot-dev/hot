custom
meta {
    doc: """
    Any other OpenAI-compatible server or private gateway (see `CUSTOM`):
    `openai-compatible.url`, or `base-url` in `opts`, and an optional
    `openai-compatible.api.key`. Routing prefix `custom/`. No URL at all is
    an Err, so a key can't end up at a default.

    **Example**

    ```hot
    ::oc ::openai-compatible

    gateway ::oc/custom({
      base-url: "https://llm.internal.example.com/v1",
      api-key: ::hot::ctx/get("gateway.api.key")
    })
    ::openai-compatible::chat/chat(gateway, "my-model", "Say hi")
    ```
    """,
    ctx: {
        "openai-compatible.url": {required: false, secret: false},
        "openai-compatible.api.key": {required: false}
    }
}
fn
(): CompatibleProvider {
    custom({})
},
(opts: Map): CompatibleProvider {
    resolve(CUSTOM, opts)
}
