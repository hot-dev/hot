::deepgram::api ns
meta {
    doc: """
    Internal HTTP plumbing for the Deepgram API: authenticated requests,
    repeated-key query strings, and the `HttpError` returned for non-2xx
    responses.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then context, then the defaults. Nothing from `opts` is written
    to ctx, so one run can act for many tenants and parallel flows don't
    share credentials. Credentials in `opts` are masked in call records. A
    credential key present but blank or null is an error, never a fallback
    to context.

    - `api-key`: the API key for this call
    - `base-url`: another API root, such as a proxy. It needs an `api-key`
      in the same `opts`: `deepgram.api.key` is never sent to a per-call URL.
    - `callback-secret`: the shared secret the async functions send with
      this call, instead of `deepgram.callback.secret`
    """,
    ctx: {
        "deepgram.api.key": {required: false},
        "deepgram.callback.secret": {required: false}
    }
}

::ctx ::hot::ctx
::uri ::hot::uri
::re ::hot::regex

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError
meta {
    doc: """
    A non-2xx Deepgram response. `message` is a readable summary built
    from Deepgram's error body (`err_code`/`err_msg` on older endpoints,
    `category`/`message`/`details` on newer ones); `body` keeps the
    decoded payload for anything else.
    """
}
type {
    status: Int,
    headers: Map?,
    body: Any?,
    message: Str
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: response.headers,
    body: response.body,
    message: error-message(response.status, response.body)
  })
}

error-message
meta {
    doc: """
    Build a readable message from a Deepgram error status and body. Exposed
    for testing.

    **Example**

    ```hot
    ::deepgram::api/error-message(402, {err_code: "ASR_PAYMENT_REQUIRED", err_msg: "Out of credits."})
    // "Deepgram API error (HTTP 402): ASR_PAYMENT_REQUIRED: Out of credits."
    ::deepgram::api/error-message(500, "")  // "Deepgram API error (HTTP 500)"
    ```
    """
}
fn (status: Int, body: Any): Str {
  detail cond {
    is-str(body) => { if(is-blank(body), null, trim(body)) }
    is-map(body) => {
      code or(get(body, "err_code"), get(body, "category"))
      text or(get(body, "err_msg"), get(body, "message"), get(body, "details"))
      cond {
        and(is-some(code), is-some(text)) => { `${code}: ${text}` }
        => { or(text, code) }
      }
    }
    => { null }
  }

  if(is-some(detail), `Deepgram API error (HTTP ${status}): ${detail}`, `Deepgram API error (HTTP ${status})`)
}

query-string
meta {
    doc: """
    Build a query-string suffix (`?a=1&b=2`, or `""` when nothing is
    set) from a Map of options. Null values are dropped, Bools render as
    `true`/`false`, and Vec values repeat the key (`keyterm=a&keyterm=b`),
    which is how Deepgram takes multi-value options such as `keyterm`,
    `keywords`, `search`, `replace`, `redact`, `tag`, and `extra`.
    Keys and values are percent-encoded.

    **Example**

    ```hot
    ::deepgram::api/query-string({model: "nova-3", keyterm: ["Hot", "Deepgram"], diarize: null})
    // "?model=nova-3&keyterm=Hot&keyterm=Deepgram"
    ```
    """
}
fn (params: Map): Str {
  pairs reduce(params, (acc, entry) {
    key ::uri/encode(Str(first(entry)))
    value entry[1]
    cond {
      is-null(value) => { acc }
      is-vec(value) => {
        concat(acc, map(filter(value, is-some), (item) { `${key}=${::uri/encode(Str(item))}` }))
      }
      => { concat(acc, [`${key}=${::uri/encode(Str(value))}`]) }
    }
  }, [])
  if(is-empty(pairs), "", `?${join(pairs, "&")}`)
}

non-blank
meta {no-doc: true}
fn (value: Any): Str? {
  if(is-str(value), if(is-blank(value), null, trim(value)), null)
}

CREDENTIAL_KEYS ["api-key", "callback-secret"]

resolve-from
meta {
    doc: """
    The one resolver, pure: `{api-key, base-url, callback-secret}` for a
    call from `opts` first, then `ctx-values` (a Map of context
    variables), then defaults. An Err when no API key is set, when a
    credential key is in `opts` but blank or null (that never falls back
    to context), or when `opts` has `base-url` without `api-key`. A
    per-call `base-url` also keeps `deepgram.callback.secret` out of the
    request. Exposed for testing; `resolve` feeds it the context.

    **Example**

    ```hot
    settings ::deepgram::api/resolve-from({}, {"deepgram.api.key": ::hot::ctx/get("deepgram.api.key")})
    settings.base-url
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  opt-key non-blank(get(opts, "api-key"))
  opt-url non-blank(get(opts, "base-url"))
  opt-secret non-blank(get(opts, "callback-secret"))
  api-key or(opt-key, non-blank(get(ctx-values, "deepgram.api.key")))
  blank find-first(CREDENTIAL_KEYS, (name) { and(in(name, keys(opts)), is-null(non-blank(get(opts, name)))) })
  cond {
    is-some(blank) => {
      err(`deepgram: ${blank} is in the call's opts but is blank or null. Pass a value, or leave ${blank} out to use context.`)
    }

    and(is-some(opt-url), is-null(opt-key)) => {
      err("deepgram: base-url is in the call's opts without api-key. Pass api-key with it. Context credentials are never sent to a per-call URL.")
    }

    is-null(api-key) => { err("deepgram: deepgram.api.key is not set. Add it in Context Variables, or pass {api-key: ...} in the call's opts.") }
    => {
      {
        api-key: api-key,
        base-url: ::re/replace-all(or(opt-url, ::deepgram/BASE_URL), "/+$", ""),
        callback-secret: or(opt-secret, if(is-some(opt-url), null, non-blank(get(ctx-values, "deepgram.callback.secret"))))
      }
    }
  }
}

resolve
meta {
    ctx: {
        "deepgram.api.key": {required: false},
        "deepgram.callback.secret": {required: false}
    },
    doc: """
    Credentials and settings for one call (see `resolve-from`). Credentials
    from `opts` are masked in this run's records and never written to ctx.

    **Example**

    ```hot
    ::deepgram::api/resolve({api-key: "tenant-b-key"}).base-url  // "https://api.deepgram.com"
    ```
    """
}
fn (opts: Map): Map {
  ::ctx/mark-secret(filter(map(CREDENTIAL_KEYS, (name) { non-blank(get(opts, name)) }), is-some))
  resolve-from(opts, {
    "deepgram.api.key": ::ctx/get("deepgram.api.key"),
    "deepgram.callback.secret": ::ctx/get("deepgram.callback.secret")
  })
}

build-request
meta {
    doc: """
    The outgoing `HttpRequest` from resolved settings (see `resolve`). An
    empty `content-type` sends no `Content-Type`. Pure; exposed for testing.

    **Example**

    ```hot
    settings ::deepgram::api/resolve({})
    req ::deepgram::api/build-request("POST", "/v1/listen?model=nova-3", "application/json", to-json({url: "https://example.com/a.wav"}), settings)
    req.url
    ```
    """
}
fn (method: Str, path: Str, content-type: Str, body: Any, resolved: Map): HttpRequest {
  auth {Authorization: `Token ${resolved.api-key}`}
  HttpRequest({
    method,
    url: `${resolved.base-url}${path}`,
    headers: if(is-empty(content-type), auth, {...auth, Content-Type: content-type}),
    body
  })
}

request
meta {
    doc: """
    Make an authenticated request to the Deepgram API (`Authorization:
    Token <key>`). `path` is relative to `https://api.deepgram.com`
    (e.g. `/v1/listen?model=nova-3`). `body` is sent as-is: a JSON
    string, raw audio `Bytes`, or `""` for none. Returns the raw
    `HttpResponse`; `json` and `bytes` unwrap it.

    **Example**

    ```hot
    response ::deepgram::api/request("GET", "/v1/models")
    response.status

    // A different key for this call
    ::deepgram::api/request("GET", "/v1/models", "", "", {api-key: ::hot::ctx/get("tenant-b.deepgram.api.key")})
    ```
    """
}
fn
(method: Str, path: Str): HttpResponse {
  request(method, path, "", "")
},
(method: Str, path: Str, content-type: Str, body: Any): HttpResponse {
  request(method, path, content-type, body, {})
},
// 5-arity: explicit API key override
(method: Str, path: Str, content-type: Str, body: Any, key: Str?): HttpResponse {
  request(method, path, content-type, body, {api-key: key})
},
// 5-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, content-type: Str, body: Any, opts: Map): HttpResponse {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { ::hot::http/request(build-request(method, path, content-type, body, resolved)) }
  }
}

json
meta {
    doc: """
    Like `request`, but returns the decoded JSON body on 2xx, or an Err
    carrying `HttpError`.

    **Example**

    ```hot
    models ::deepgram::api/json("GET", "/v1/models")
    map(models.stt, %.canonical_name)
    ```
    """
}
fn
(method: Str, path: Str): Any {
  json(method, path, "", "")
},
(method: Str, path: Str, content-type: Str, body: Any): Any {
  json(method, path, content-type, body, {})
},
(method: Str, path: Str, content-type: Str, body: Any, opts: Map): Any {
  response request(method, path, content-type, body, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body }
    => { err(HttpError(response)) }
  }
}

bytes
meta {
    doc: """
    Like `request`, but returns the verbatim response `Bytes` on 2xx (for
    audio), or an Err carrying `HttpError`.

    **Example**

    ```hot
    audio ::deepgram::api/bytes("POST", "/v1/speak?model=aura-2-thalia-en", "application/json", to-json({text: "Hello."}))
    ::hot::file/write-file-bytes("hello.mp3", audio)
    ```
    """
}
fn
(method: Str, path: Str, content-type: Str, body: Any): Bytes {
  bytes(method, path, content-type, body, {})
},
(method: Str, path: Str, content-type: Str, body: Any, opts: Map): Bytes {
  response request(method, path, content-type, body, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body-bytes }
    => { err(HttpError(response)) }
  }
}
