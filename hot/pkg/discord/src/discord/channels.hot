create-channel-invite
meta {
    doc: """
    POST /channels/{channel_id}/invites - Create an invite. `max_age` in
    seconds (0 = never, default 86400), `max_uses` (0 = unlimited),
    `unique: true` to skip reusing a similar invite. Needs
    CREATE_INSTANT_INVITE.

    **Example**

    ```hot
    ::channels ::discord::channels

    invite ::channels/create-channel-invite(::channels/CreateChannelInviteRequest({
      channel_id: "1100000000000000000",
      max_age: 3600,
      max_uses: 1,
      unique: true
    }))
    `https://discord.gg/${invite.code}`
    ```
    """
}
fn
(request: CreateChannelInviteRequest): Map {
  create-channel-invite(request, {})
},
(request: CreateChannelInviteRequest, opts: Map): Map {
  ::api/call("POST", `/channels/${seg(request.channel_id)}/invites`, {
    body: ::api/body(request, ["channel_id"]),
    reason: request.reason
  }, opts)
}

