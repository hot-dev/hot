::sanctions::test::screening ns
meta ["test"]

::fx ::sanctions::test::fixtures
::screen ::sanctions::screen
::index ::sanctions::index
::cache ::sanctions::cache
::cfg ::sanctions::config
::os ::sanctions::opensanctions
::http ::sanctions::http

screen fn (name: Str, opts: Map): Map {
  untype(::screen/screen-index(::fx/indexes(), name, opts))
}

top fn (r: Map): Map {
  first(r.matches)
}

// ============================================================================
// Index
// ============================================================================

test-index-build-shape
meta ["test"]
fn () {
    idx ::index/build(::sanctions::un/parse(::fx/UN_XML))
    assert-eq(3, idx.entry-count)
    rec get(idx.records, "e:IQi.004")
    assert-eq(["abid", "hamid", "mahmud", "al", "tikriti"], first(rec.toks))
    assert-eq(["IQ"], rec.countries)
    key "s:tkrt"
    bucket get(idx.buckets, ::index/bucket-of(key))
    assert-eq(["IQi.004"], get(bucket, key))
    assert-eq(add(length(keys(idx.records)), length(keys(idx.buckets))), length(idx.pairs))
}

test-bucket-of-is-stable
meta ["test"]
fn () {
    assert-eq("b:", slice(::index/bucket-of("s:mhmd"), 0, 2))
    assert-eq(4, length(::index/bucket-of("s:mhmd")))
    assert-eq(::index/bucket-of("s:mhmd"), ::index/bucket-of("s:mhmd"))
}

test-rank-candidates-prefers-rare-keys
meta ["test"]
fn () {
    // "b" shares the rare key; "a" only the common one.
    postings [["s:common", ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k"]], ["s:rare", ["b"]]]
    assert-eq(["b", "a", "c"], ::index/rank-candidates(postings, 3))
    assert-eq([], ::index/rank-candidates([], 5))
}

test-entry-countries-from-addresses
meta ["test"]
fn () {
    e {nationalities: ["AF"], addresses: ["Zweierstrasse 35, Zurich CH-8022, Switzerland", "Kabul, Afghanistan"]}
    assert-eq(["AF", "CH"], ::index/entry-countries(e))
}

// ============================================================================
// Screening
// ============================================================================

test-screen-exact-name
meta ["test"]
fn () {
    r screen("Ayman al-Zawahiri", {})
    assert-eq("possible-match", r.status)
    assert-eq(true, r.review-required)
    m top(r)
    assert-eq("2676", m.entry.id)
    assert-eq("possible-match", m.status)
    assert-eq(1.0, m.score)
    assert(::hot::str/contains(r.notice, "reviewed by a person"), "the human-review notice is always included")
}

test-screen-typos-match-an-alias
meta ["test"]
fn () {
    m top(screen("Aiman Zawahri", {}))
    assert-eq("2676", m.entry.id)
    assert(gte(m.score, 0.85), "two typos still screen as a possible match")
}

test-screen-dob-boost-and-penalty
meta ["test"]
fn () {
    plain top(screen("Ayman al-Zawahiri", {threshold: 0.5})).score
    same top(screen("Ayman al-Zawahiri", {dob: "1951-06-19", threshold: 0.5}))
    assert-eq(1.0, same.score, "clamped at 1")
    assert(some(same.matched-fields, (f) { eq(f, "dob") }), "dob listed as matched")
    other top(screen("Ayman al-Zawahiri", {dob: "1980", threshold: 0.5}))
    assert-eq(::sanctions::similarity/round4(sub(plain, 0.15)), other.score)
    assert(some(other.explanation, (l) { ::hot::str/contains(l, "date of birth differs") }), "explained")
}

test-screen-dob-range-overlaps
meta ["test"]
fn () {
    m top(screen("Muhamad Lumisa", {dob: "1962", country: "Uganda"}))
    assert-eq("CDi.047", m.entry.id)
    assert-eq(["alias", "dob", "country"], m.matched-fields)
}

test-screen-country-mismatch-penalty
meta ["test"]
fn () {
    base top(screen("Abid Hamid Mahmud al-Tikriti", {})).score
    off top(screen("Abid Hamid Mahmud al-Tikriti", {country: "FR", threshold: 0.5})).score
    assert-eq(::sanctions::similarity/round4(sub(base, 0.05)), off)
}

test-screen-kind-filter
meta ["test"]
fn () {
    assert-eq("no-match", screen("Petrel 8", {kind: "individual"}).status)
    m top(screen("Petrel 8", {kind: ["vessel", "aircraft"]}))
    assert-eq("DPR0075", m.entry.id)
}

test-screen-entity-suffixes
meta ["test"]
fn () {
    m top(screen("Gazprombank", {kind: "entity"}))
    assert-eq("17016", m.entry.id)
    assert-eq(1.0, m.score, "JOINT STOCK COMPANY is a legal form")
}

test-screen-no-match
meta ["test"]
fn () {
    r screen("Jane Q. Example", {})
    assert-eq("no-match", r.status)
    assert-eq(false, r.review-required)
    assert-eq([], r.matches)
}

test-screen-ranking-is-deterministic
meta ["test"]
fn () {
    a screen("Ali", {threshold: 0.0, limit: 20})
    b screen("Ali", {threshold: 0.0, limit: 20})
    assert-eq(map(a.matches, (m) { m.entry.id }), map(b.matches, (m) { m.entry.id }))
    scores map(a.matches, (m) { m.score })
    assert-eq(scores, reverse(sort(scores)), "best first")
}

test-screen-limit-and-threshold
meta ["test"]
fn () {
    r screen("Abu Ali", {threshold: 0.0, limit: 1})
    assert-eq(1, length(r.matches))
    assert-eq(0.0, r.threshold)
}

test-dob-adjustment-cases
meta ["test"]
fn () {
    assert-eq(0.0, ::screen/dob-adjustment(null, null, ["1950"]).delta)
    assert-eq(0.0, ::screen/dob-adjustment("1950", [1950, 1950], []).delta)
    assert-eq(0.05, ::screen/dob-adjustment("1950-01-02", [1950, 1950], ["1950-01-02"]).delta)
    assert-eq(0.02, ::screen/dob-adjustment("1950", [1950, 1950], ["1950-01-02"]).delta)
    assert-eq(0.02, ::screen/dob-adjustment("1961", [1961, 1961], ["1959/1965"]).delta)
    assert-eq(0.0, ::screen/dob-adjustment("1951", [1951, 1951], ["1950"]).delta)
    assert-eq(-0.15, ::screen/dob-adjustment("1970", [1970, 1970], ["1950"]).delta)
}

test-country-adjustment-cases
meta ["test"]
fn () {
    assert-eq(0.0, ::screen/country-adjustment(null, ["IR"]).delta)
    assert-eq(0.0, ::screen/country-adjustment("IR", []).delta)
    assert-eq(0.03, ::screen/country-adjustment("IR", ["IQ", "IR"]).delta)
    assert-eq(-0.05, ::screen/country-adjustment("FR", ["IR"]).delta)
}

test-query-of
meta ["test"]
fn () {
    q ::screen/query-of("Acme Trading Ltd", {dob: "10 Dec 1948", country: "Iran", kind: "entity"})
    assert-eq(["acme", "trading", "ltd"], q.plain)
    assert-eq(["acme", "trading"], q.stripped)
    assert-eq("1948-12-10", q.dob)
    assert-eq([1948, 1948], q.years)
    assert-eq("IR", q.country)
}

// ============================================================================
// Cache helpers
// ============================================================================

test-check-sources
meta ["test"]
fn () {
    assert-eq(::cache/SOURCES, ::cache/check-sources(null))
    assert-eq(["un"], ::cache/check-sources("un"))
    assert-eq(["uk", "eu"], ::cache/check-sources(["uk", "eu"]))
    assert(is-err(::cache/check-sources(["ofac", "un"])), "unknown source")
}

test-data-store-name
meta ["test"]
fn () {
    n ::cache/data-store-name("sanctions", "un", "abc")
    assert(::hot::str/starts-with(n, "sanctions:un:"), n)
    assert-eq(25, length(n))
    assert(ne(n, ::cache/data-store-name("sanctions", "un", "abd")), "versions get different stores")
}

// ============================================================================
// Settings resolver
// ============================================================================

test-config-defaults
meta ["test"]
fn () {
    cfg ::cfg/resolve({})
    assert-eq("sanctions", cfg.store)
    assert-eq(7, cfg.max-age-days)
    assert-eq("https://api.opensanctions.org", cfg.base-url)
    assert-eq("default", cfg.dataset)
    assert-eq(null, cfg.api-key)
}

test-config-opts-override
meta ["test"]
fn () {
    cfg ::cfg/resolve({api-key: "k-test", base-url: "https://yente.example.com/", dataset: "sanctions", store: "s2", max-age-days: "3"})
    assert-eq("k-test", cfg.api-key)
    assert-eq("https://yente.example.com", cfg.base-url, "trailing slash removed")
    assert-eq("sanctions", cfg.dataset)
    assert-eq("s2", cfg.store)
    assert-eq(3, cfg.max-age-days)
    assert-eq(null, ::hot::ctx/get("sanctions.opensanctions.api-key"), "per-call keys are never written to ctx")
}

test-config-blank-api-key-is-an-err-naming-the-key
meta ["test"]
fn () {
    ::hot::ctx/set({"sanctions.opensanctions.api-key": "ctx-key"})
    for-each(["", "  ", null], (v) {
      out ::cfg/resolve({api-key: v})
      assert(is-err(out), "a blank key never falls back to context")
      assert(contains(err-message(out), "api-key"), "names the key")
    })
    assert-eq("ctx-key", ::cfg/resolve({}).api-key)
    ::hot::ctx/set({"sanctions.opensanctions.api-key": null})
}

test-config-blank-api-key-reaches-every-caller-as-an-err
meta ["test"]
fn () {
    assert(is-err(::sanctions::opensanctions/screen("x", {api-key: ""})), "opensanctions")
    assert(is-err(::sanctions::cache/status({api-key: ""})), "status")
    assert(is-err(::sanctions::cache/meta-of("un", {api-key: ""})), "meta-of")
    assert(is-err(::sanctions::cache/refresh-source("un", {api-key: ""})), "refresh-source")
    assert(is-err(::sanctions::cache/open-sources({api-key: ""})), "open-sources")
}

test-config-context-key-never-goes-to-a-per-call-url
meta ["test"]
fn () {
    ::hot::ctx/set({"sanctions.opensanctions.api-key": "ctx-key"})
    yente ::cfg/resolve({base-url: "https://yente.internal"})
    assert-eq(null, yente.api-key, "the context key is not used")
    assert-eq(null, ::cfg/require-api-key(yente), "a self-hosted yente may need no key")
    assert(not(in("Authorization", keys(::sanctions::opensanctions/match-headers(null)))), "no key, no header")
    assert-eq("ApiKey k", ::sanctions::opensanctions/match-headers("k").Authorization)
    assert-eq("t", ::cfg/resolve({base-url: "https://yente.internal", api-key: "t"}).api-key)
    hosted ::cfg/resolve({base-url: "https://api.opensanctions.org"})
    assert(is-err(::cfg/require-api-key(hosted)), "the hosted API named per call still needs a per-call key")
    ::hot::ctx/set({"sanctions.opensanctions.api-key": null})
}

test-config-marks-and-returns-the-key-unchanged
meta ["test"]
fn () {
    assert-eq("marked-opensanctions-key", ::cfg/resolve({api-key: "marked-opensanctions-key"}).api-key)
}

test-config-missing-key-error
meta ["test"]
fn () {
    out ::cfg/require-api-key(::cfg/resolve({}))
    assert(is-err(out), "missing key")
    assert(::hot::str/contains(err-message(out), "sanctions.opensanctions.api-key"), "names the ctx key")
}

// ============================================================================
// OpenSanctions
// ============================================================================

test-opensanctions-body-person
meta ["test"]
fn () {
    body ::os/match-body("John Doe", {dob: "1975-04-21", country: "United States", kind: "individual"})
    assert-eq({queries: {q: {schema: "Person", properties: {name: ["John Doe"], birthDate: ["1975-04-21"], nationality: ["us"]}}}}, body)
}

test-opensanctions-body-omits-unset
meta ["test"]
fn () {
    assert-eq({queries: {q: {schema: "LegalEntity", properties: {name: ["Acme"]}}}}, ::os/match-body("Acme", {}))
    assert-eq({queries: {q: {schema: "Organization", properties: {name: ["Acme"], country: ["ir"]}}}}, ::os/match-body("Acme", {kind: "entity", country: "IR", dob: "1990"}))
}

test-opensanctions-url
meta ["test"]
fn () {
    assert-eq("https://api.opensanctions.org/match/default", ::os/match-url("https://api.opensanctions.org", "default", {}))
    assert-eq(
      "https://api.opensanctions.org/match/sanctions?threshold=0.8&limit=5&topics=sanction&include_dataset=us_ofac_sdn",
      ::os/match-url("https://api.opensanctions.org", "sanctions", {threshold: 0.8, limit: 5, topics: ["sanction"], include-datasets: ["us_ofac_sdn"]})
    )
}

test-opensanctions-parse-response
meta ["test"]
fn () {
    body {
      responses: {q: {status: 200, results: [
        {id: "NK-abc", caption: "John Doe", schema: "Person", score: 0.91, match: true, datasets: ["us_ofac_sdn"],
         properties: {name: ["John Doe", "Johnny Doe"], birthDate: ["1975-04-21"], nationality: ["us"]},
         explanations: {name_literal_match: {score: 1.0, explanation: "exact"}}},
        {id: "NK-low", caption: "Jon Do", schema: "Person", score: 0.3, match: false, properties: {}}
      ], total: {value: 2}}},
      limit: 5
    }

    r untype(::os/parse-response(body, "John Doe", {}, "https://api.opensanctions.org"))
    assert-eq("possible-match", r.status)
    assert-eq(1, length(r.matches), "below the 0.7 default threshold is dropped")
    m first(r.matches)
    assert-eq("opensanctions", m.entry.source)
    assert-eq("individual", m.entry.kind)
    assert-eq(["Johnny Doe"], m.entry.aliases)
    assert-eq(["us_ofac_sdn"], m.entry.programs)
    assert-eq(0.91, m.score)
    assert-eq("https://www.opensanctions.org/entities/NK-abc/", m.entry.url)
    assert(some(m.explanation, (l) { ::hot::str/contains(l, "name_literal_match: 1.0 (exact)") }), "explanations are kept")
    assert-eq("no-match", untype(::os/parse-response({responses: {q: {results: []}}}, "x", {}, "u")).status)
}

test-opensanctions-requires-key
meta ["test"]
fn () {
    out ::os/screen("John Doe", {})
    assert(is-err(out), "no key")
}

// ============================================================================
// HTTP helpers
// ============================================================================

test-byte-ranges
meta ["test"]
fn () {
    assert-eq([[0, 3], [4, 7], [8, 9]], ::http/byte-ranges(10, 4))
    assert-eq([[0, 9]], ::http/byte-ranges(10, 100))
    assert-eq([], ::http/byte-ranges(0, 4))
}

test-http-error
meta ["test"]
fn () {
    e untype(::http/http-error(::hot::http/HttpResponse({status: 404, headers: {}, body: "not here"}), "https://example.test/x"))
    assert-eq(404, e.status)
    assert-eq("HTTP 404 from https://example.test/x: not here", e.message)
    blank untype(::http/http-error(::hot::http/HttpResponse({status: 500, headers: {}, body: null}), "https://example.test/y"))
    assert-eq("HTTP 500 from https://example.test/y", blank.message)
}

test-body-text
meta ["test"]
fn () {
    assert-eq("a,b", ::http/body-text({body: "a,b"}))
    assert-eq("Hi", ::http/body-text({body: Bytes("Hi"), body-bytes: Bytes("Hi")}))
    assert-eq("[1,2]", ::http/body-text({body: [1, 2], body-bytes: Bytes("[1,2]")}), "prefers the raw bytes")
}
