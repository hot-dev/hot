::hot::test::store ns
meta ["test"]

::store ::hot::store

settings ::store/Map({name: "test-settings"})

test-embedding-shorthand-coerces-to-custom
meta ["test"] fn () {
    s ::store/Map({
        name: "test-embedding-shorthand",
        embedding: ::store/Embedding({
            provider: "test",
            model: "custom-v1",
            dimensions: 2,
        }),
    })
    assert-eq("test", s.embedding.provider, "Embedding(...) coerces to EmbeddingOptions.Embedding")
    assert-eq("custom-v1", s.embedding.model, "custom embedding payload is preserved")
}

test-put-and-get
meta ["test"] fn () {
    ::store/put(settings, "host", "localhost")
    assert-eq("localhost", ::store/get(settings, "host"), "get returns the put value")
}

test-put-if-missing-creates-only-new-keys
meta ["test"] fn () {
    s ::store/Map({name: "test-put-if-missing"})
    assert(::store/put-if-missing(s, "a", 1), "a missing key is created")
    assert(::store/put-if-missing(s, "b", 2), "a second missing key is created")
    assert(not(::store/put-if-missing(s, "a", 99)), "an existing key returns false")
    assert-eq(1, ::store/get(s, "a"), "the existing value is preserved")
    assert-eq(["a", "b"], ::store/keys(s), "a rejected put preserves insertion order")
}

test-put-if-missing-distinguishes-null-from-a-missing-key
meta ["test"] fn () {
    s ::store/Map({name: "test-put-if-missing-null"})
    assert(::store/put-if-missing(s, "nullable", null), "a null value can be stored")
    assert(not(::store/put-if-missing(s, "nullable", "replacement")), "the null-valued key exists")
    assert(is-null(::store/get(s, "nullable")), "the original null remains stored")
}

test-get-missing-returns-null
meta ["test"] fn () {
    s ::store/Map({name: "test-missing"})
    assert(is-null(::store/get(s, "nonexistent")), "get on missing key returns null")
}

test-get-with-default
meta ["test"] fn () {
    s ::store/Map({name: "test-default"})
    assert-eq("fallback", ::store/get(s, "nope", "fallback"), "get with default returns default")
}

test-delete
meta ["test"] fn () {
    s ::store/Map({name: "test-delete"})
    ::store/put(s, "k", "v")
    assert(::store/delete(s, "k"), "delete returns true for existing key")
    assert(not(::store/delete(s, "k")), "delete returns false for missing key")
    assert(is-null(::store/get(s, "k")), "get after delete returns null")
}

test-keys-and-vals
meta ["test"] fn () {
    s ::store/Map({name: "test-keys-vals"})
    ::store/put(s, "a", 1)
    ::store/put(s, "b", 2)
    ::store/put(s, "c", 3)
    assert-eq(["a", "b", "c"], ::store/keys(s), "keys returns all keys in order")
    assert-eq([1, 2, 3], ::store/vals(s), "vals returns all values in order")
}

test-length-and-is-empty
meta ["test"] fn () {
    s ::store/Map({name: "test-length"})
    assert(::store/is-empty(s), "new store is empty")
    assert-eq(0, ::store/length(s), "new store has length 0")
    ::store/put(s, "a", 1)
    assert(not(::store/is-empty(s)), "store with entry is not empty")
    assert-eq(1, ::store/length(s), "store has length 1 after put")
}

test-first-and-last
meta ["test"] fn () {
    s ::store/Map({name: "test-first-last"})
    assert(is-null(::store/first(s)), "first on empty store is null")
    assert(is-null(::store/last(s)), "last on empty store is null")
    ::store/put(s, "x", 10)
    ::store/put(s, "y", 20)
    ::store/put(s, "z", 30)
    f ::store/first(s)
    assert-eq("x", f.key, "first returns the first inserted key")
    assert-eq(10, f.value, "first returns the first inserted value")
    l ::store/last(s)
    assert-eq("z", l.key, "last returns the last inserted key")
    assert-eq(30, l.value, "last returns the last inserted value")
}

test-merge-and-put-many
meta ["test"] fn () {
    s ::store/Map({name: "test-merge"})
    count ::store/merge(s, {"a": 1, "b": 2, "c": 3})
    assert-eq(3, count, "merge returns the number of entries written")
    assert-eq(3, ::store/length(s), "store has 3 entries after merge")
    assert-eq(2, ::store/get(s, "b"), "merged value is accessible")
}

test-list
meta ["test"] fn () {
    s ::store/Map({name: "test-list"})
    ::store/merge(s, {"a": 1, "b": 2, "c": 3, "d": 4, "e": 5})
    all ::store/list(s)
    assert-eq(5, length(all), "list returns all entries")
    page ::store/list(s, {limit: 2, offset: 1})
    assert-eq(2, length(page), "list with limit returns correct count")
    assert-eq("b", get(page, 0).key, "list offset works")
}

test-clear
meta ["test"] fn () {
    s ::store/Map({name: "test-clear"})
    ::store/put(s, "a", 1)
    ::store/put(s, "b", 2)
    ::store/clear(s)
    assert(::store/is-empty(s), "store is empty after clear")
}

test-destroy
meta ["test"] fn () {
    s ::store/Map({name: "test-destroy"})
    ::store/put(s, "a", 1)
    ::store/destroy(s)
    assert-eq(0, ::store/length(s), "length is 0 after destroy")
}

test-upsert-preserves-order
meta ["test"] fn () {
    s ::store/Map({name: "test-upsert"})
    ::store/put(s, "a", 1)
    ::store/put(s, "b", 2)
    ::store/put(s, "a", 99)
    assert-eq(["a", "b"], ::store/keys(s), "upsert preserves insertion order")
    assert-eq(99, ::store/get(s, "a"), "upsert updates the value")
}

test-map-values
meta ["test"] fn () {
    s ::store/Map({name: "test-map-vals"})
    ::store/put(s, "user1", {name: "Alice", age: 30})
    ::store/put(s, "user2", {name: "Bob", age: 25})
    user ::store/get(s, "user1")
    assert-eq("Alice", user.name, "map values are stored and retrieved correctly")
    assert-eq(30, user.age, "nested map fields accessible")
}

test-slice
meta ["test"] fn () {
    s ::store/Map({name: "test-slice"})
    ::store/merge(s, {"a": 1, "b": 2, "c": 3, "d": 4, "e": 5})
    sliced ::store/slice(s, 1, 3)
    assert-eq(2, length(sliced), "slice returns correct number of entries")
    assert-eq("b", get(sliced, 0).key, "slice starts at correct offset")
    assert-eq("c", get(sliced, 1).key, "slice ends at correct position")
}

test-filter
meta ["test"] fn () {
    s ::store/Map({name: "test-filter"})
    ::store/merge(s, {"alice": {age: 30}, "bob": {age: 17}, "carol": {age: 25}, "dave": {age: 15}})
    adults ::store/filter(s, (k, v) { gte(v.age, 18) })
    assert-eq(2, length(adults), "filter returns matching entries")
    adult-keys map(adults, (entry) { entry.key })
    assert-eq(["alice", "carol"], adult-keys, "filter keeps correct entries")
}

test-filter-none-match
meta ["test"] fn () {
    s ::store/Map({name: "test-filter-none"})
    ::store/merge(s, {"a": 1, "b": 2})
    result ::store/filter(s, (k, v) { gt(v, 100) })
    assert-eq(0, length(result), "filter with no matches returns empty")
}

test-find-first
meta ["test"] fn () {
    s ::store/Map({name: "test-find-first"})
    ::store/merge(s, {"x": 10, "y": 20, "z": 30})
    found ::store/find-first(s, (k, v) { gt(v, 15) })
    assert-eq("y", found.key, "find-first returns first matching key")
    assert-eq(20, found.value, "find-first returns first matching value")
}

test-find-first-no-match
meta ["test"] fn () {
    s ::store/Map({name: "test-find-first-none"})
    ::store/merge(s, {"a": 1, "b": 2})
    result ::store/find-first(s, (k, v) { gt(v, 100) })
    assert(is-null(result), "find-first returns null when no match")
}

test-reduce
meta ["test"] fn () {
    s ::store/Map({name: "test-reduce"})
    ::store/merge(s, {"a": 10, "b": 20, "c": 30})
    total ::store/reduce(s, (acc, k, v) { add(acc, v) }, 0)
    assert-eq(60, total, "reduce sums all values")
}

test-reduce-to-map
meta ["test"] fn () {
    s ::store/Map({name: "test-reduce-map"})
    ::store/merge(s, {"first": "Alice", "second": "Bob"})
    inverted ::store/reduce(s, (acc, k, v) { assoc(acc, v, k) }, {})
    assert-eq("first", get(inverted, "Alice"), "reduce builds inverted map")
    assert-eq("second", get(inverted, "Bob"), "reduce builds inverted map")
}

test-put-many
meta ["test"] fn () {
    s ::store/Map({name: "test-put-many"})
    count ::store/put-many(s, {"x": 1, "y": 2, "z": 3})
    assert-eq(3, count, "put-many returns count of entries written")
    assert-eq(3, ::store/length(s), "put-many stores all entries")
    assert-eq(1, ::store/get(s, "x"), "put-many entries are accessible")
    assert-eq(2, ::store/get(s, "y"), "put-many entries are accessible")
    assert-eq(3, ::store/get(s, "z"), "put-many entries are accessible")
}

// Add one entry to the map stored at `key`, retrying while another writer
// changed it between the read and the write. Each retry means another
// writer won, so the budget only stops a put-if that never matches.
add-entry fn (s: ::store/Map, key: Str, entry-key: Str, entry: Any): Map {
    add-entry-within(s, key, entry-key, entry, 100)
}

add-entry-within fn (s: ::store/Map, key: Str, entry-key: Str, entry: Any, attempts: Int): Map {
    current ::store/get(s, key)
    next assoc(if(is-null(current), {}, current), entry-key, entry)
    wrote ::store/put-if(s, key, current, next)
    cond {
        wrote => { next }
        lte(attempts, 1) => { fail(`put-if never matched ${key}`) }
        => { add-entry-within(s, key, entry-key, entry, sub(attempts, 1)) }
    }
}

test-put-if-writes-only-over-the-expected-value
meta ["test"] fn () {
    s ::store/Map({name: "test-put-if"})
    ::store/clear(s)
    assert(::store/put-if(s, "k", null, 1), "null expects a missing key and creates it")
    assert(not(::store/put-if(s, "k", null, 2)), "null no longer matches once the key holds a value")
    assert(not(::store/put-if(s, "k", 5, 2)), "a stale expectation does not write")
    assert-eq(1, ::store/get(s, "k"), "a refused put-if leaves the value")
    assert(::store/put-if(s, "k", 1, 2), "the current value matches")
    assert-eq(2, ::store/get(s, "k"), "put-if wrote the new value")
    assert-eq(["k"], ::store/keys(s), "put-if over an entry keeps one entry")
}

test-put-if-matches-a-value-read-back
meta ["test"] fn () {
    s ::store/Map({name: "test-put-if-read-back"})
    ::store/clear(s)
    ::store/put(s, "case", {zeta: [1, 2], alpha: {name: "x", amount: 1.5}, flag: null})
    current ::store/get(s, "case")
    next assoc(current, "answered", true)
    assert(::store/put-if(s, "case", current, next), "a value read with get matches the stored value")
    assert(not(::store/put-if(s, "case", current, {})), "the earlier read no longer matches")
    assert-eq(next, ::store/get(s, "case"), "the matching write is the stored value")
}

// Decs read back as the Decs written, so put-if matches what get returned:
// an integral Dec used to read back as a Dec that never matched, and a Dec
// with trailing zeros as a Str
test-put-if-matches-decs-read-back
meta ["test"] fn () {
    s ::store/Map({name: "test-put-if-decs"})
    ::store/clear(s)
    values [Dec(100), Dec(0), 100.0, 2.0, 19.90, mul(2.5, 2), div(Dec(1000), 100), Dec(10000000000000000), {total: Dec(100)}, [Dec(7), 2.50]]
    for-each(range(0, length(values)), (i) {
        key `dec-${i}`
        value values[i]
        ::store/put(s, key, value)
        current ::store/get(s, key)
        assert-eq(value, current, `${key} reads back as written`)
        assert(not(is-str(current)), `${key} does not read back as a Str`)
        assert(::store/put-if(s, key, current, "next"), `put-if matches ${key} as get returned it`)
    })
    total add-entry(s, "budget", "spent", Dec(100))
    assert-eq(Dec(100), total.spent, "a put-if loop over a Dec finishes")
}

test-store-decs-keep-their-type-and-digits
meta ["test"] fn () {
    s ::store/Map({name: "test-store-decs"})
    ::store/clear(s)
    ::store/put(s, "order", {total: 19.90, tax: 2.0, count: 3})
    order ::store/get(s, "order")
    assert(is-dec(order.total), "a Dec with a trailing zero reads back as a Dec")
    assert-eq("19.90", Str(order.total), "its digits are kept")
    assert-eq(20.00, add(order.total, 0.10), "it takes part in arithmetic")
    assert(is-dec(order.tax), "an integral Dec reads back as a Dec")
    assert(is-int(order.count), "an Int reads back as an Int")
    assert(is-dec(first(::store/vals(s)).total), "vals returns Decs too")
    assert(is-dec(first(::store/list(s)).value.tax), "list returns Decs too")
}

test-list-and-keys-refuse-counts-that-are-not-ints
meta ["test"] fn () {
    s ::store/Map({name: "test-list-count-types"})
    ::store/clear(s)
    ::store/put(s, "a:1", 1)
    ::store/put(s, "a:2", 2)
    assert(is-err(::store/keys(s, {prefix: "a:", limit: 1.0})), "keys refuses a Dec limit")
    assert(is-err(::store/keys(s, {offset: "1"})), "keys refuses a Str offset")
    assert(is-err(::store/list(s, {limit: div(3, 2)})), "list refuses a Dec limit")
    assert-eq(["a:1"], ::store/keys(s, {prefix: "a:", limit: 1}), "an Int limit still applies")
}

test-put-if-keeps-every-concurrent-entry
meta ["test"] fn () {
    s ::store/Map({name: "test-put-if-concurrent"})
    ::store/clear(s)
    ids range(0, 48)
    pmap(ids, (i) { add-entry(s, "case", `answer-${i}`, i) })
    stored ::store/get(s, "case")
    assert-eq(48, length(stored), "no concurrent entry is lost")
    assert-eq(ids, map(ids, (i) { get(stored, `answer-${i}`) }), "each writer's entry holds its value")
}

test-increment-counts-from-zero
meta ["test"] fn () {
    s ::store/Map({name: "test-increment"})
    ::store/clear(s)
    assert-eq(1, ::store/increment(s, "n"), "a missing key counts from 0")
    assert-eq(6, ::store/increment(s, "n", 5), "increment adds by")
    assert-eq(4, ::store/increment(s, "n", -2), "by can be negative")
    assert-eq(4, ::store/get(s, "n"), "the counter is a stored Int")
    assert-eq(-3, ::store/increment(s, "m", -3), "a first negative increment starts from 0")
}

test-increment-refuses-what-it-cannot-count
meta ["test"] fn () {
    s ::store/Map({name: "test-increment-errors"})
    ::store/clear(s)
    ::store/put(s, "name", "case")
    assert(is-err(::store/increment(s, "name")), "a non-Int value is an error")
    assert-eq("case", ::store/get(s, "name"), "a refused increment leaves the value")
    ::store/put(s, "max", 9223372036854775807)
    assert(is-err(::store/increment(s, "max")), "an overflow is an error")
    assert-eq(9223372036854775807, ::store/get(s, "max"), "an overflow leaves the counter")
}

test-increment-gives-each-concurrent-caller-its-own-value
meta ["test"] fn () {
    s ::store/Map({name: "test-increment-concurrent"})
    ::store/clear(s)
    seqs pmap(range(0, 48), (i) { ::store/increment(s, "seq") })
    assert-eq(48, ::store/get(s, "seq"), "no concurrent increment is lost")
    assert-eq(range(1, 49), sort(seqs), "each increment returned a distinct value")
}

test-list-and-keys-with-a-prefix
meta ["test"] fn () {
    s ::store/Map({name: "test-list-prefix"})
    ::store/clear(s)
    ::store/put(s, "case:2:b", 1)
    ::store/put(s, "case:1:a", 2)
    ::store/put(s, "case:10:a", 3)
    ::store/put(s, "case:1:b", 4)
    ::store/put(s, "cases", 5)
    ::store/put(s, 42, 6)
    entries ::store/list(s, {prefix: "case:1:"})
    assert-eq(["case:1:a", "case:1:b"], map(entries, %.key), "only keys with the prefix, in insertion order")
    assert-eq([2, 4], map(entries, %.value), "prefix entries carry their values")
    page ::store/list(s, {prefix: "case:1", limit: 1, offset: 1})
    assert-eq(["case:10:a"], map(page, %.key), "limit and offset page through the matches")
    assert-eq(["case:2:b", "case:1:a", "case:10:a", "case:1:b"], ::store/keys(s, {prefix: "case:"}), "keys takes a prefix")
    assert-eq(["case:1:a"], ::store/keys(s, {prefix: "case:", limit: 1, offset: 1}), "keys pages through the matches")
    assert-eq(5, length(::store/keys(s, {prefix: ""})), "an empty prefix matches every Str key")
    assert-eq([], ::store/list(s, {prefix: "nope"}), "no key has the prefix")
}

test-prefix-takes-characters-literally
meta ["test"] fn () {
    s ::store/Map({name: "test-prefix-literal"})
    ::store/clear(s)
    ::store/put(s, "100%", 1)
    ::store/put(s, "100x", 2)
    ::store/put(s, "a_b", 3)
    ::store/put(s, "axb", 4)
    ::store/put(s, "say \"hi\"", 5)
    ::store/put(s, "back\\slash", 6)
    ::store/put(s, "naïve", 7)
    ::store/put(s, "naive", 8)
    assert-eq(["100%"], ::store/keys(s, {prefix: "100%"}), "% is not a wildcard")
    assert-eq(["a_b"], ::store/keys(s, {prefix: "a_"}), "_ is not a wildcard")
    assert-eq(["say \"hi\""], ::store/keys(s, {prefix: "say \""}), "a quote matches itself")
    assert-eq(["back\\slash"], ::store/keys(s, {prefix: "back\\"}), "a backslash matches itself")
    assert-eq(["naïve"], ::store/keys(s, {prefix: "naï"}), "non-ASCII characters match themselves")
}
