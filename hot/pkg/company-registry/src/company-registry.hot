::company-registry ns
meta {
    doc: """
    Free company registries for Hot, behind one normalized `Company`
    record:

    - `::company-registry::gleif`: the GLEIF LEI API (global, no key):
      search, records, ISINs and parent/child relationships
    - `::company-registry::sec`: SEC EDGAR (US filers, no key but a
      User-Agent with contact details): tickers to CIK, submissions,
      XBRL facts, filing documents, full-text search
    - `::company-registry::companies-house`: UK Companies House (free
      API key): search, profiles, officers, persons with significant
      control, filing history and documents

    `lookup` searches every configured source and returns `Company`
    records; the `from-*` functions normalize one source's record.

    **Quick start**

    ```hot
    ::cr ::company-registry

    found ::cr/lookup("Tesco PLC")
    map(found.companies, (c) { `${c.source}: ${c.name} ${to-json(c.identifiers)}` })

    lei ::cr/from-gleif(::company-registry::gleif/get-record("HWUPKR0MPOU8FGXBT394"))
    lei.parents
    ```
    """
}

::api ::company-registry::api
::gleif ::company-registry::gleif
::sec ::company-registry::sec
::ch ::company-registry::companies-house

Address
meta {
    doc: """A normalized address: `kind` (`"legal"`, `"headquarters"`, `"business"`, `"mailing"`, `"registered-office"`), `lines`, `city`, `region`, `postal-code`, `country` (ISO 3166-1 alpha-2 where the source gives one)."""
}
type {
    kind: Str,
    lines: Vec<Str>,
    city: Str?,
    region: Str?,
    postal-code: Str?,
    country: Str?
}

Company
meta {
    doc: """
    One company from one registry.

    **Fields**
    - `source` — `"gleif"`, `"sec"` or `"companies-house"`
    - `name` — the legal (or registered) name
    - `identifiers` — `{lei, cik, uk-company-number, tickers, ein,
      registered-as}`, only those known
    - `jurisdiction` — ISO country or subdivision code (`"US-DE"`,
      `"GB"`, `"IE"`) or the source's own value
    - `status` — the source's status in lower case (`"active"`,
      `"dissolved"`, `"inactive"`, `"lapsed"`, ...)
    - `addresses` — `Address` records
    - `incorporation-date` — `YYYY-MM-DD` when known
    - `parents` — `[{relationship: "direct" | "ultimate", lei, name}]` when
      known (GLEIF records filled by `with-parents`)
    - `raw` — the source record as returned
    """
}
type {
    source: Str,
    name: Str,
    identifiers: Map,
    jurisdiction: Str?,
    status: Str?,
    addresses: Vec<Address>,
    incorporation-date: Str?,
    parents: Vec<Map>,
    raw: Any
}

clean-lines fn (lines: Vec): Vec<Str> {
  filter(map(lines, (l) { if(is-str(l), trim(l), null) }), (l) { and(is-some(l), not(is-empty(l))) })
}

nonblank fn (v: Any): Any {
  if(::api/given(v), v, null)
}

date-part fn (v: Any): Str? {
  if(::api/given(v), slice(Str(v), 0, 10), null)
}

// ---------------------------------------------------------------------------
// GLEIF
// ---------------------------------------------------------------------------

gleif-address fn (kind: Str, a: Any): Address? {
  cond {
    not(is-map(a)) => { null }
    => {
      Address({
        kind: kind,
        lines: clean-lines(concat(or(get(a, "addressLines"), []), filter([get(a, "addressNumber"), get(a, "addressNumberWithinBuilding"), get(a, "mailRouting")], is-some))),
        city: nonblank(get(a, "city")),
        region: nonblank(get(a, "region")),
        postal-code: nonblank(get(a, "postalCode")),
        country: nonblank(get(a, "country"))
      })
    }
  }
}

from-gleif
meta {
    doc: """
    Normalize a GLEIF LEI record (the JSON:API `data` object from
    `::company-registry::gleif/get-record` or `search`) into a `Company`
    (pure). `parents` is empty; use `with-parents` to fill it.
    """
}
fn (record: Map): Company {
  attrs or(get(record, "attributes"), {})
  entity or(get(attrs, "entity"), {})
  lei or(get(attrs, "lei"), get(record, "id"))
  addresses filter([gleif-address("legal", get(entity, "legalAddress")), gleif-address("headquarters", get(entity, "headquartersAddress"))], is-some)
  Company({
    source: "gleif",
    name: or(get-in(entity, ["legalName", "name"]), ""),
    identifiers: filter-vals({lei: lei, registered-as: nonblank(get(entity, "registeredAs")), bic: get(attrs, "bic")}, is-some),
    jurisdiction: nonblank(get(entity, "jurisdiction")),
    status: if(::api/given(get(entity, "status")), lowercase(get(entity, "status")), null),
    addresses: addresses,
    incorporation-date: date-part(get(entity, "creationDate")),
    parents: [],
    raw: record
  })
}

parent-link fn (relationship: Str, record: Any): Map? {
  cond {
    not(is-map(record)) => { null }
    => { {relationship: relationship, lei: get(record, "id"), name: get-in(record, ["attributes", "entity", "legalName", "name"])} }
  }
}

with-parents
meta {
    doc: """A GLEIF `Company` with `parents` filled from its direct and ultimate parent records (two requests). Other companies are returned unchanged."""
}
fn
(company: Company): Company {
  with-parents(company, {})
},
(company: Company, opts: Map): Company {
  lei get(company.identifiers, "lei")
  cond {
    or(ne(company.source, "gleif"), is-null(lei)) => { company }
    => {
      direct ::gleif/direct-parent(lei, opts)
      ultimate ::gleif/ultimate-parent(lei, opts)
      cond {
        is-err(direct) => { direct }
        is-err(ultimate) => { ultimate }
        => {
          links filter([parent-link("direct", direct), parent-link("ultimate", ultimate)], is-some)
          Company({...untype(company), parents: links})
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// SEC
// ---------------------------------------------------------------------------

sec-address fn (kind: Str, a: Any): Address? {
  cond {
    not(is-map(a)) => { null }
    is-null(get(a, "street1")) => { null }
    => {
      foreign eq(get(a, "isForeignLocation"), 1)
      Address({
        kind: kind,
        lines: clean-lines([get(a, "street1"), get(a, "street2")]),
        city: nonblank(get(a, "city")),
        region: if(foreign, nonblank(get(a, "stateOrCountryDescription")), nonblank(get(a, "stateOrCountry"))),
        postal-code: nonblank(get(a, "zipCode")),
        country: or(nonblank(get(a, "countryCode")), if(foreign, null, "US"))
      })
    }
  }
}

from-sec
meta {
    doc: """Normalize an EDGAR submissions body (`::company-registry::sec/submissions`) into a `Company` (pure). `jurisdiction` is `US-{state of incorporation}` for US states."""
}
fn (subs: Map): Company {
  state nonblank(get(subs, "stateOfIncorporation"))
  addresses or(get(subs, "addresses"), {})
  Company({
    source: "sec",
    name: or(get(subs, "name"), ""),
    identifiers: filter-vals({
      cik: if(is-some(get(subs, "cik")), ::sec/pad-cik(get(subs, "cik")), null),
      tickers: if(::api/given(get(subs, "tickers")), get(subs, "tickers"), null),
      ein: nonblank(get(subs, "ein")),
      lei: nonblank(get(subs, "lei"))
    }, is-some),
    jurisdiction: if(and(is-some(state), ::hot::regex/is-match(state, "^[A-Z]{2}$")), `US-${state}`, state),
    status: null,
    addresses: filter([sec-address("business", get(addresses, "business")), sec-address("mailing", get(addresses, "mailing"))], is-some),
    incorporation-date: null,
    parents: [],
    raw: subs
  })
}

from-sec-ticker
meta {
    doc: """A minimal `Company` from a ticker-file row `{cik, ticker, title}` (pure)."""
}
fn (row: Map): Company {
  Company({
    source: "sec",
    name: row.title,
    identifiers: {cik: row.cik, tickers: [row.ticker]},
    jurisdiction: null,
    status: null,
    addresses: [],
    incorporation-date: null,
    parents: [],
    raw: row
  })
}

// ---------------------------------------------------------------------------
// Companies House
// ---------------------------------------------------------------------------

ch-address fn (kind: Str, a: Any): Address? {
  cond {
    not(is-map(a)) => { null }
    => {
      Address({
        kind: kind,
        lines: clean-lines([get(a, "care_of"), get(a, "po_box"), get(a, "premises"), get(a, "address_line_1"), get(a, "address_line_2")]),
        city: nonblank(get(a, "locality")),
        region: nonblank(get(a, "region")),
        postal-code: nonblank(get(a, "postal_code")),
        country: nonblank(get(a, "country"))
      })
    }
  }
}

ch-jurisdiction fn (j: Any): Str? {
  cond {
    not(::api/given(j)) => { null }
    eq(j, "england-wales") => { "GB-EAW" }
    eq(j, "scotland") => { "GB-SCT" }
    eq(j, "northern-ireland") => { "GB-NIR" }
    or(eq(j, "united-kingdom"), eq(j, "great-britain"), eq(j, "wales"), eq(j, "england")) => { "GB" }
    => { j }
  }
}

from-companies-house
meta {
    doc: """
    Normalize a Companies House company profile, or a `search-companies`
    item, into a `Company` (pure). `jurisdiction` maps `england-wales`,
    `scotland` and `northern-ireland` to ISO 3166-2 codes (`GB-EAW`,
    `GB-SCT`, `GB-NIR`).
    """
}
fn (record: Map): Company {
  number or(get(record, "company_number"), "")
  addr or(get(record, "registered_office_address"), get(record, "address"))
  Company({
    source: "companies-house",
    name: or(get(record, "company_name"), get(record, "title"), ""),
    identifiers: if(::api/given(number), {uk-company-number: number}, {}),
    jurisdiction: or(ch-jurisdiction(get(record, "jurisdiction")), "GB"),
    status: nonblank(get(record, "company_status")),
    addresses: filter([ch-address("registered-office", addr)], is-some),
    incorporation-date: date-part(get(record, "date_of_creation")),
    parents: [],
    raw: record
  })
}

// ---------------------------------------------------------------------------
// Lookup
// ---------------------------------------------------------------------------

lookup-source
meta {
    doc: """Search one source by name and return `Company` records (at most `limit`)."""
}
fn (source: Str, name: Str, limit: Int, opts: Map): Vec<Company> {
  cond {
    // Each answer is checked: consuming an Err would halt the whole lookup.
    eq(source, "gleif") => {
      page ::gleif/search(name, {...opts, page-size: limit})
      if(is-err(page), page, map(or(get(page, "data"), []), from-gleif))
    }

    eq(source, "sec") => {
      tickers ::sec/company-tickers(opts)
      if(is-err(tickers), tickers, map(::sec/search-tickers(tickers, name, limit), from-sec-ticker))
    }

    eq(source, "companies-house") => {
      found ::ch/search-companies(name, {...opts, items-per-page: limit})
      if(is-err(found), found, map(or(get(found, "items"), []), from-companies-house))
    }
    => { err(`company-registry: unknown source '${source}'; use gleif, sec or companies-house`) }
  }
}

lookup
meta {
    doc: """
    Search the configured registries for a company name, in parallel.

    **Options**
    - `sources` — any of `"gleif"`, `"sec"`, `"companies-house"`.
      Defaults to `company-registry.sources`, else GLEIF plus every
      source whose credentials are set (SEC needs the user-agent,
      Companies House the API key)
    - `limit` — results per source (default 5)
    - plus credentials and settings for each source (`user-agent`,
      `api-key`, base URLs)

    SEC matching is a case-insensitive substring match on the names in
    the ticker file, so it only finds listed companies; use
    `::company-registry::sec/full-text-search` for others.

    Returns `{companies, errors}`: the companies from every source that
    answered, and `{source, message}` for each that failed, so one
    registry being down never hides the others.

    **Example**

    ```hot
    found ::company-registry/lookup("Apple Inc", {sources: ["gleif", "sec"], limit: 3})
    map(found.companies, (c) { c.identifiers })
    ```
    """
}
fn
(name: Str): Map {
  lookup(name, {})
},
(name: Str, opts: Map): Map {
  cfg ::api/resolve(opts)
  cond {
    is-err(cfg) => { cfg }
    => {
      sources cfg.sources
      limit or(get(opts, "limit"), 5)
      results pmap(sources, (s) { lookup-source(s, name, limit, opts) }, OnErr.Preserve)
      pairs map(range(0, length(sources)), (i) { {source: get(sources, i), result: get(results, i)} })
      {
        companies: mapcat(filter(pairs, (p) { is-ok(p.result) }), (p) { p.result }),
        errors: map(filter(pairs, (p) { is-err(p.result) }), (p) { {source: p.source, message: err-message(p.result)} })
      }
    }
  }
}
