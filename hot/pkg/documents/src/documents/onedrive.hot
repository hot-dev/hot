::documents::onedrive ns
meta {
    doc: """
    The OneDrive and SharePoint implementation of the `::documents`
    verbs, over `hot.dev/microsoft-onedrive` (credentials, clouds and
    retries come from `microsoft-graph`). Source: `{provider: "onedrive",
    drive?, opts}`. `drive` is anything the onedrive package accepts as
    `opts.drive`: `"me"` (the default for delegated tokens), a drive id
    (a SharePoint document library), or `{drive-id}`, `{user}`, `{site}`
    (the site's default library) or `{group}`. App-only tokens need a drive.
    """
}

::source ::documents::source
::cursor ::documents::cursor
::adapters ::documents::adapters
::text ::documents::text
::od ::microsoft::onedrive
::items ::microsoft::onedrive::items
::content ::microsoft::onedrive::content
::up ::microsoft::onedrive::upload
::delta ::microsoft::onedrive::delta
::gapi ::microsoft::graph::api
Page ::documents/Page
ChangeSet ::documents/ChangeSet

PROVIDER "onedrive"
MAX_PAGE_SIZE 999

to-document fn (source: Map, item: Map): Any {
  ::adapters/from-onedrive(source, ::od/to-doc-file(item))
}

with-drive
meta {
    doc: """The provider options plus the source's `drive` as `opts.drive` (pure; the call's own `drive` wins)."""
}
fn (source: Map, opts: Map): Map {
  popts ::source/provider-opts(source, opts)
  d get(source, "drive")
  if(or(is-null(d), is-some(get(popts, "drive"))), popts, {...popts, drive: d})
}

// ---------------------------------------------------------------------------
// Pure builders
// ---------------------------------------------------------------------------

children-request
meta {
    doc: """The path and options for one page of `folder`'s children (pure): `{path: "{drive}/items/{id}/children", opts}` with `top` and the OData and credential options (onedrive-only keys such as `drive` removed, so they never become query parameters)."""
}
fn (folder: Str, page-size: Int, popts: Map): Map {
  path `${::od/item-path(folder, popts)}/children`
  {path: path, opts: {...::od/query-opts({top: page-size}, popts), ...::od/creds(popts)}}
}

to-page
meta {
    doc: """A Graph collection page (`::microsoft::graph::api/Page`) as a `::documents/Page` (pure); `@odata.nextLink` becomes the cursor."""
}
fn (source: Map, folder: Str, page: Map): Page {
  docs map(or(page.items, []), (i) { to-document(source, i) })
  c ::cursor/list-cursor(PROVIDER, page.next-link, folder)
  Page({documents: docs, cursor: c, has-more: is-some(c)})
}

to-change-set
meta {
    doc: """A onedrive `DeltaSet` as a `::documents/ChangeSet` (pure). A `410` resync (`resync: true`) sets `reset-required`: `documents` is then a full enumeration of the drive."""
}
fn (source: Map, set: Map): ChangeSet {
  next ::cursor/change-cursor(PROVIDER, set.delta-link)
  cond {
    is-err(next) => { next }
    => {
      ChangeSet({
        documents: map(::delta/changed-items(set), (f) { ::adapters/from-onedrive(source, f) }),
        deleted-ids: ::delta/deleted-ids(set),
        deleted-paths: [],
        next-cursor: next,
        reset-required: eq(set.resync, true),
        has-more: false
      })
    }
  }
}

// ---------------------------------------------------------------------------
// Verbs
// ---------------------------------------------------------------------------

list fn (source: Map, folder: Str?, opts: Map): Page {
  popts with-drive(source, opts)
  given get(opts, "cursor")
  c if(is-null(given), null, ::cursor/decode-for(given, PROVIDER, "list"))
  cond {
    is-err(c) => { c }
    => {
      target or(if(is-map(c), c.f, null), folder, "root")
      link if(is-map(c), Str(c.v), null)
      req children-request(target, ::source/page-size(opts, ::documents/DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE), popts)
      page ::gapi/fetch-page(req.path, req.opts, link)
      if(is-err(page), page, to-page(source, target, page))
    }
  }
}

search fn (source: Map, query: Str, limit: Int, opts: Map): Vec {
  found ::items/search(query, with-drive(source, opts), limit)
  if(is-err(found), found, map(found, (i) { to-document(source, i) }))
}

get-doc fn (source: Map, id: Str, opts: Map): Any {
  item ::items/get-item(id, with-drive(source, opts))
  if(is-err(item), item, to-document(source, item))
}

download fn (source: Map, id: Str, opts: Map): Any {
  popts with-drive(source, opts)
  item ::items/get-item(id, popts)
  target if(is-err(item), item, ::items/resolve-remote(item, ::od/creds(popts)))
  doc if(is-err(target), target, to-document(source, target))
  cond {
    is-err(doc) => { doc }
    eq(doc.kind, "folder") => { err(`documents: ${doc.name} is a folder; list it instead`) }
    => {
      content ::content/download(target, popts)
      if(is-err(content), content, ::adapters/to-content(source, content, ::adapters/from-onedrive, doc))
    }
  }
}

read-text fn (source: Map, id: Str, format: Str, opts: Map): Any {
  popts with-drive(source, opts)
  item ::items/get-item(id, popts)
  target if(is-err(item), item, ::items/resolve-remote(item, ::od/creds(popts)))
  doc if(is-err(target), target, to-document(source, target))
  cond {
    is-err(doc) => { doc }
    => {
      plan ::text/plan(doc, format)
      cond {
        eq(plan.action, "error") => { ::text/plan-error(plan) }
        eq(plan.action, "unsupported") => { ::text/not-ok-result(doc, "unsupported", plan.reason) }
        eq(plan.action, "convert") => {
          content ::content/convert(target, plan.export, ::od/creds(popts))
          cond {
            // A refusal (size, unsupported file) is "unsupported"; transient failures stay Errs.
            and(is-err(content), not(::gapi/is-retryable(content))) => {
              ::text/not-ok-result(doc, "unsupported", `Graph could not convert ${doc.name} to ${plan.export}: ${err-message(content)}`)
            }

            is-err(content) => { content }
            => { ::text/ok-result(doc, content.bytes, plan.format, content.mime-type, "convert") }
          }
        }
        => {
          content ::content/download(target, popts)
          if(is-err(content), content, ::text/ok-result(doc, content.bytes, plan.format, or(content.mime-type, doc.mime-type), "download"))
        }
      }
    }
  }
}

upload fn (source: Map, parent: Str?, name: Str, bytes: Bytes, mime-type: Str, opts: Map): Any {
  item ::up/upload-file(or(parent, "root"), name, bytes, mime-type, with-drive(source, opts))
  if(is-err(item), item, to-document(source, item))
}

start-cursor fn (source: Map, opts: Map): Any {
  link ::delta/latest-delta-link(with-drive(source, opts))
  if(is-err(link), link, ::cursor/change-cursor(PROVIDER, link))
}

changes fn (source: Map, cursor: Str, opts: Map): Any {
  c ::cursor/decode-for(cursor, PROVIDER, "changes")
  cond {
    is-err(c) => { c }
    => {
      set ::delta/sync-changes(Str(c.v), with-drive(source, opts))
      if(is-err(set), set, to-change-set(source, set))
    }
  }
}
