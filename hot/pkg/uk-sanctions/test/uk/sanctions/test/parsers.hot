::uk::sanctions::test::parsers ns
meta ["test"]

::fx ::uk::sanctions::test::fixtures
::uk ::uk::sanctions
::sx ::uk::sanctions::xml
::http ::uk::sanctions::http

by-id fn (entries: Vec, id: Str): Map {
  untype(find-first(entries, (e) { eq(e.id, id) }))
}

// ============================================================================
// UK
// ============================================================================

test-uk-individual
meta ["test"]
fn () {
    es ::uk/parse(::fx/UK_XML)
    assert-eq(3, length(es))
    a by-id(es, "AFG0007")
    assert-eq("Abdul Kabir MOHAMMAD JAN", a.name)
    assert-eq("individual", a.kind)
    assert-eq(["KABIR MUHAMMAD JAN ABDUL", "A Kabir", "عبد الکبیر محمد جان"], a.aliases)
    assert-eq(["1963", "1972-01-30"], a.dobs, "dd/mm/1963 is a year; duplicates dropped")
    assert-eq(["Afghanistan"], a.nationalities, "as published")
    assert-eq(["Afghanistan"], a.addresses)
    assert-eq(["The Afghanistan (Sanctions) (EU Exit) Regulations 2020"], a.regimes)
    assert-eq("Active in terrorist operations in Eastern Afghanistan.", a.other-information)
    assert-eq("UN", a.designation-source)
    assert-eq("TAi.003", a.un-reference)
    assert-eq("6909", a.ofsi-group-id)
    assert-eq("25/01/2001", a.date-designated)
    assert-eq("29/04/2026", a.last-updated)
}

test-uk-ship-and-entity-with-ampersand
meta ["test"]
fn () {
    es ::uk/parse(::fx/UK_XML)
    ship by-id(es, "DPR0075")
    assert-eq("vessel", ship.kind)
    assert-eq("Petrel 8", ship.name)
    assert-eq(["Jal Vahini", "Tian Tai 36"], ship.aliases)
    org by-id(es, "AQD0011")
    assert-eq("entity", org.kind)
    assert-eq("AL-HARAMAIN & AL MASJED AL-AQSA CHARITY FOUNDATION", org.name, "&amp; is decoded")
    assert-eq(["Hamdije Cemerlica 41, Sarajevo, Bosnia and Herzegovina"], org.addresses)
}

// ============================================================================
// Helpers
// ============================================================================

test-iso-date-formats
meta ["test"]
fn () {
    assert-eq("1948-12-10", ::uk/iso-date("10 Dec 1948"))
    assert-eq("1948-12-10", ::uk/iso-date("1948-12-10"))
    assert-eq("1948-12", ::uk/iso-date("Dec 1948"))
    assert-eq("1948", ::uk/iso-date("circa 1948"))
    assert-eq("1963", ::uk/iso-date("dd/mm/1963"))
    assert-eq("1972-01-30", ::uk/iso-date("30/01/1972"))
    assert-eq("1959/1962", ::uk/iso-date("1959 to 1962"))
    assert-eq("1960/1962", ::uk/iso-date("01 Jan 1960 to 31 Dec 1962"))
    assert-eq(null, ::uk/iso-date("unknown"))
    assert-eq(null, ::uk/iso-date(null))
}

test-clean-list-and-other-names
meta ["test"]
fn () {
    assert-eq(["Acme Two"], ::uk/other-names(["acme", " Acme Two ", "", null, "Acme Two"], "ACME"), "blanks, duplicates and the primary name are dropped")
    assert-eq(["a", "b"], ::uk/clean-list([" a ", "b", "a", "  ", null]))
}

test-require-entries
meta ["test"]
fn () {
    assert-eq(["a"], ::uk/require-entries(["a"]))
    out ::uk/require-entries([])
    assert(is-err(out), "an empty list must not pass for a list with nobody on it")
    assert(contains(err-message(out), "no records"), err-message(out))
}

test-xml-decode-and-attributes
meta ["test"]
fn () {
    assert-eq("Smith & Sons été", ::sx/decode("Smith &amp; Sons &#233;t&#xE9;"))
    assert-eq("&lt;", ::sx/decode("&amp;lt;"), "&amp; is decoded last")
    assert-eq("A \"B\" <C>", ::sx/decode("A &quot;B&quot; &lt;C&gt;"))
    assert-eq("Müller & Söhne", ::sx/decode("M&#xFC;ller &amp; S&#246;hne"), "text around a reference stays in one piece")
    assert-eq("AT&T", ::sx/decode("AT&T"), "text the parser refuses comes back as it was")
    assert-eq("a&nbsp;b", ::sx/decode("a&nbsp;b"), "an undeclared entity stays as written")
    assert-eq("no references", ::sx/decode("no references"))
    assert-eq(["A & B", "C"], ::sx/texts("<n><v>A &amp; B</v><v/><v> C </v></n>", "v"))
    assert-eq(["<r>1</r>", "<r a=\"x\">2</r>"], ::sx/records("<a><r>1</r><rs/><r a=\"x\">2</r></a>", "r"))
    tag first(::sx/start-tags("<x><nameAlias wholeName=\"Abu Ali\" strong=\"true\" title=\"\"/></x>", "nameAlias"))
    assert-eq("Abu Ali", ::sx/attr(tag, "wholeName"))
    assert-eq(null, ::sx/attr(tag, "title"), "blank attributes are null")
    assert-eq(null, ::sx/attr(tag, "missing"))
}

// ============================================================================
// HTTP helpers
// ============================================================================

test-byte-ranges
meta ["test"]
fn () {
    assert-eq([[0, 3], [4, 7], [8, 9]], ::http/byte-ranges(10, 4))
    assert-eq([[0, 9]], ::http/byte-ranges(10, 100))
    assert-eq([], ::http/byte-ranges(0, 4))
}

test-http-error
meta ["test"]
fn () {
    e untype(::http/http-error(::hot::http/HttpResponse({status: 404, headers: {}, body: "not here"}), "https://example.test/x"))
    assert-eq(404, e.status)
    assert-eq("HTTP 404 from https://example.test/x: not here", e.message)
    blank untype(::http/http-error(::hot::http/HttpResponse({status: 500, headers: {}, body: null}), "https://example.test/y"))
    assert-eq("HTTP 500 from https://example.test/y", blank.message)
}

test-body-text
meta ["test"]
fn () {
    assert-eq("a,b", ::http/body-text({body: "a,b"}))
    assert-eq("Hi", ::http/body-text({body: Bytes("Hi"), body-bytes: Bytes("Hi")}))
    assert-eq("[1,2]", ::http/body-text({body: [1, 2], body-bytes: Bytes("[1,2]")}), "prefers the raw bytes")
}

test-too-large-message
meta ["test"]
fn () {
    told ::http/too-large-message("https://example.test/x")
    assert(contains(told, "raise http.max-response-bytes"), told)
    assert(contains(told, "does not support Range requests"), told)
}

test-is-size-limit-error
meta ["test"]
fn () {
    assert(::http/is-size-limit-error(err("response size exceeds http.max-response-bytes")), "the runtime's error")
    assert(not(::http/is-size-limit-error(err("connection refused"))), "another failure")
    assert(not(::http/is-size-limit-error({status: 200})), "a response")
}
