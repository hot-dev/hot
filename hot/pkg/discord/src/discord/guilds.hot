RemoveGuildBanRequest type {
  guild_id: Str,
  user_id: Str,
  reason: Str?
}

remove-guild-ban
meta {
    doc: """
    DELETE /guilds/{guild_id}/bans/{user_id} - Unban a user. Needs
    BAN_MEMBERS.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    ::guilds/remove-guild-ban(::guilds/RemoveGuildBanRequest({
      guild_id: "1000000000000000000",
      user_id: "1300000000000000000",
      reason: "Appeal accepted"
    }))
    ```
    """
}
fn
(request: RemoveGuildBanRequest): Bool {
  remove-guild-ban(request, {})
},
(request: RemoveGuildBanRequest, opts: Map): Bool {
  ::api/call-ok("DELETE", `/guilds/${seg(request.guild_id)}/bans/${seg(request.user_id)}`, {reason: request.reason}, opts)
}

BulkGuildBanRequest type {
  guild_id: Str,
  user_ids: Vec<Str>,
  delete_message_seconds: Int?,
  reason: Str?
}

bulk-guild-ban
meta {
    doc: """
    POST /guilds/{guild_id}/bulk-ban - Ban up to 200 users at once. Returns
    `{banned_users, failed_users}`. Needs BAN_MEMBERS and MANAGE_GUILD.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    result ::guilds/bulk-guild-ban(::guilds/BulkGuildBanRequest({
      guild_id: "1000000000000000000",
      user_ids: ["1300000000000000000", "1300000000000000001"],
      delete_message_seconds: 3600,
      reason: "Raid accounts"
    }))
    result.failed_users
    ```
    """
}
fn
(request: BulkGuildBanRequest): Map {
  bulk-guild-ban(request, {})
},
(request: BulkGuildBanRequest, opts: Map): Map {
  ::api/call("POST", `/guilds/${seg(request.guild_id)}/bulk-ban`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  }, opts)
}

