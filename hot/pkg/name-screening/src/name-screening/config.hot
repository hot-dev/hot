::name-screening::config ns
meta {
    ctx: {
        "name-screening.store": {required: false, secret: false},
        "name-screening.max-age-days": {required: false, secret: false}
    },
    doc: """
    The one settings resolver for the package: per-call `opts` first,
    then context variables, then defaults. Per-call values are never
    written to context, so parallel flows and tenants in one run don't
    see each other's settings.

    | opts key | Context variable | Default |
    |---|---|---|
    | `store` | `name-screening.store` | `"name-screening"` |
    | `max-age-days` | `name-screening.max-age-days` | `7` |
    """
}

::ctx ::hot::ctx

DEFAULT_STORE "name-screening"
DEFAULT_MAX_AGE_DAYS 7

given fn (v: Any): Bool {
  match v {
    Null => { false }
    Str => { not(is-empty(trim(v))) }
    _ => { true }
  }
}

pick fn (opts: Map, key: Str, ctx-key: Str, default: Any): Any {
  from-opts get(opts, key)
  from-ctx ::ctx/get(ctx-key)
  cond {
    given(from-opts) => { from-opts }
    given(from-ctx) => { from-ctx }
    => { default }
  }
}

to-int fn (v: Any, default: Int): Int {
  match v {
    Int => { v }
    Str => { if(::hot::regex/is-match(trim(v), "^\\d+$"), Int(trim(v)), default) }
    _ => { default }
  }
}

resolve
meta {
    doc: """
    Resolve settings for one call: `{store, max-age-days}`.

    **Example**

    ```hot
    cfg ::name-screening::config/resolve({store: "tenant-a-lists", max-age-days: 3})
    ```
    """
}
fn (opts: Map): Map {
  {
    store: pick(opts, "store", "name-screening.store", DEFAULT_STORE),
    max-age-days: to-int(pick(opts, "max-age-days", "name-screening.max-age-days", DEFAULT_MAX_AGE_DAYS), DEFAULT_MAX_AGE_DAYS)
  }
}
