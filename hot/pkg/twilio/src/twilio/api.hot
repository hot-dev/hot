::twilio::api ns

::ctx ::hot::ctx
::base64 ::hot::base64
::uri ::hot::uri

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: response.headers,
    body: response.body
  })
}

// ============================================================================
// Credentials
// ============================================================================

Client
meta {
    doc: """
    The credentials one Twilio call is made with. `account-sid` (`AC...`) is
    the account every resource URL is scoped to; `username`/`password` are
    the HTTP Basic credentials: the Account SID and Auth Token, or an API
    Key SID (`SK...`) and its secret. Build one with `client-from-ctx`,
    `auth-token-client`, or `api-key-client`, and pass it as the first
    argument of any resource function to call a different account (a
    subaccount, a customer's account) than the one in context.
    """
}
type {
    account-sid: Str,
    username: Str,
    password: Str
}

auth-token-client
meta {
    doc: """
    A `Client` that authenticates with an Account SID and its Auth Token.

    **Example**

    ```hot
    sub ::twilio::api/auth-token-client("AC1111...", "subaccount-auth-token")
    ::twilio::messages/list-messages(sub, ::twilio::messages/ListMessagesRequest({PageSize: 20}))
    ```
    """
}
fn (account-sid: Str, auth-token: Str): Client {
  Client({account-sid: account-sid, username: account-sid, password: auth-token})
}

api-key-client
meta {
    doc: """
    A `Client` that authenticates with an API Key (`SK...` SID plus secret)
    against the account `account-sid`. Twilio recommends API keys over the
    Auth Token for production: they can be revoked individually and never
    grant access to the account's own credentials.

    **Example**

    ```hot
    c ::twilio::api/api-key-client("AC1234...", "SK5678...", "key-secret")
    ::twilio::accounts/get-account(c)
    ```
    """
}
fn (account-sid: Str, key-sid: Str, key-secret: Str): Client {
  Client({account-sid: account-sid, username: key-sid, password: key-secret})
}

client-from-ctx
meta {
    ctx: {
      "twilio.account.sid": {required: true},
      "twilio.auth.token": {required: false},
      "twilio.api.key.sid": {required: false},
      "twilio.api.key.secret": {required: false}
    },
    doc: """
    The `Client` described by context variables: `twilio.account.sid` plus
    either an API key (`twilio.api.key.sid` and `twilio.api.key.secret`,
    preferred when both are set) or `twilio.auth.token`. Every resource
    function's short arity uses this. Halts with a clear message when the
    Account SID or both credential forms are missing.
    """
}
fn (): Client {
  account-sid or(::ctx/get("twilio.account.sid"), "")
  key-sid or(::ctx/get("twilio.api.key.sid"), "")
  key-secret or(::ctx/get("twilio.api.key.secret"), "")
  auth-token or(::ctx/get("twilio.auth.token"), "")
  cond {
    is-empty(account-sid) => {
      fail("twilio.account.sid is not set. Add it in Context Variables.")
    }

    and(not(is-empty(key-sid)), not(is-empty(key-secret))) => {
      api-key-client(account-sid, key-sid, key-secret)
    }

    not(is-empty(auth-token)) => { auth-token-client(account-sid, auth-token) }
    => {
      fail("No Twilio credentials: set twilio.auth.token, or twilio.api.key.sid and twilio.api.key.secret, in Context Variables.")
    }
  }
}

auth-header
meta {
    doc: """The HTTP Basic `Authorization` header value for a `Client`. Exposed for testing."""
}
fn (client: Client): Str {
  pair `${client.username}:${client.password}`
  `Basic ${::base64/encode(pair)}`
}

account-url
meta {
    doc: """The 2010-04-01 base URL scoped to the client's account: `https://api.twilio.com/2010-04-01/Accounts/{AccountSid}`."""
}
fn (client: Client): Str {
  `${::twilio::core/BASE_URL}/Accounts/${::uri/encode(client.account-sid)}`
}

// ============================================================================
// Encoding
// ============================================================================

encode-value fn (value: Any): Str {
  `${value}`
}

encode-pair fn (key: Str, value: Any): Str {
  `${::uri/encode(key)}=${::uri/encode(encode-value(value))}`
}

form-encode
meta {
    doc: """Encode a Map as application/x-www-form-urlencoded. Null values are omitted. Vec values are encoded as repeated parameters (`MediaUrl=a&MediaUrl=b`) per Twilio's convention."""
}
fn (data: Map): Str {
  filtered filter-vals(data, is-some)
  parts reduce(keys(filtered), (acc, key) {
    value get(filtered, key)
    pairs cond {
        is-vec(value) => { map(value, (item) { encode-pair(key, item) }) }
        => { [encode-pair(key, value)] }
    }

    concat(acc, pairs)
  }, [])
  join(parts, "&")
}

query-string
meta {
    doc: """Build a query string (`?a=1&b=2`) from a Map. Null values are omitted; returns an empty string when no parameters remain. Values are percent-encoded, so `+` in phone numbers is preserved."""
}
fn (params: Map): Str {
  filtered filter-vals(params, is-some)
  if(is-empty(filtered), "", `?${form-encode(filtered)}`)
}

// ============================================================================
// Requests
// ============================================================================

request
meta {
    ctx: {
      "twilio.account.sid": {required: true},
      "twilio.auth.token": {required: false},
      "twilio.api.key.sid": {required: false},
      "twilio.api.key.secret": {required: false}
    },
    doc: """
    Make an authenticated HTTP request to a Twilio API. Uses HTTP Basic Auth
    with the credentials of a `Client` (the 5-arity form) or of
    `client-from-ctx()` (the shorter forms). POST bodies are form-encoded
    (application/x-www-form-urlencoded) per Twilio's API convention; null
    values are dropped and Vec values become repeated parameters.

    The 6-arity form takes an Account SID and Auth Token directly.

    **Example**

    ```hot
    ::api ::twilio::api

    // Simple GET request with context credentials
    response ::api/request("GET", `${::api/account-url(::api/client-from-ctx())}/Messages.json`)

    // POST with form-encoded body and an explicit client
    c ::api/api-key-client("AC123", "SK456", "secret")
    response ::api/request(c, "POST", `${::api/account-url(c)}/Messages.json`, {}, {To: "+15558675310", From: "+15017122661", Body: "Hello"})
    ```
    """
}
fn
(method: Str, url: Str): HttpResponse {
  request(client-from-ctx(), method, url, {}, {})
},
(method: Str, url: Str, additional-headers: Map): HttpResponse {
  request(client-from-ctx(), method, url, additional-headers, {})
},
(method: Str, url: Str, additional-headers: Map, body: Map): HttpResponse {
  request(client-from-ctx(), method, url, additional-headers, body)
},
(client: Client, method: Str, url: Str, additional-headers: Map, body: Map): HttpResponse {
  has-body not(is-empty(filter-vals(body, is-some)))
  default-headers {Authorization: auth-header(client)}
  headers if(has-body, {...default-headers, Content-Type: "application/x-www-form-urlencoded"}, default-headers)
  final-headers {...headers, ...additional-headers}

  encoded-body if(has-body, form-encode(body), "")
  ::hot::http/request(HttpRequest({
    method,
    url,
    headers: final-headers,
    body: encoded-body
  }))
},
(method: Str, url: Str, additional-headers: Map, body: Map, account-sid: Str, auth-token: Str): HttpResponse {
  request(auth-token-client(account-sid, auth-token), method, url, additional-headers, body)
}

json
meta {
    doc: """Make a request and return the parsed JSON body, or `err(HttpError)` on a non-2xx response."""
}
fn
(client: Client, method: Str, url: Str): Map {
  json(client, method, url, {})
},
(client: Client, method: Str, url: Str, body: Map): Map {
  response request(client, method, url, {}, body)
  if(is-ok-response(response), response.body, err(HttpError(response)))
}

delete-request
meta {
    doc: """DELETE a resource; `true` on success (Twilio answers 204), `err(HttpError)` otherwise."""
}
fn (client: Client, url: Str): Bool {
  response request(client, "DELETE", url, {}, {})
  if(is-ok-response(response), true, err(HttpError(response)))
}

// ============================================================================
// Pagination
// ============================================================================
// 2010-04-01 list responses carry `next_page_uri` (a path on api.twilio.com,
// including the PageToken Twilio requires for every page after the first).
// v2 APIs (Verify, Lookup) carry `meta.next_page_url` (an absolute URL).

next-page-ref
meta {
    doc: """The next-page reference of a list response, from `next_page_uri` (2010-04-01 APIs) or `meta.next_page_url` (v2 APIs); null on the last page. Exposed for testing."""
}
fn (page: Map): Str? {
  uri or(get(page, "next_page_uri"), get-in(page, ["meta", "next_page_url"]))
  if(or(is-null(uri), is-empty(or(uri, ""))), null, uri)
}

is-twilio-url
meta {
    doc: """True for an `https://` URL on a `twilio.com` host. Pagination only follows these, so a page reference never sends credentials elsewhere. Exposed for testing."""
}
fn (url: Str): Bool {
  // Host is everything up to the first "/"; it must be plain DNS labels
  // ending in twilio.com, so userinfo, ports, "?" or "#" tricks never pass.
  ::hot::regex/is-match(url, "^https://([a-z0-9-]+\\.)*twilio\\.com/")
}

page-url
meta {
    doc: """Resolve a page reference to an absolute URL: a path is joined to `https://api.twilio.com`; an absolute URL must be on a twilio.com host. Exposed for testing."""
}
fn (ref: Str): Str {
  cond {
    starts-with(ref, "/") => { `${::twilio::core/API_HOST}${ref}` }
    is-twilio-url(ref) => { ref }
    => { err(`refusing to follow a non-Twilio page URL: ${ref}`) }
  }
}

next-page
meta {
    doc: """
    Fetch the page after `page` (any list response). Returns the next
    page's Map, or null when `page` is the last one.

    **Example**

    ```hot
    page1 ::twilio::messages/list-messages(::twilio::messages/ListMessagesRequest({PageSize: 50}))
    page2 ::twilio::api/next-page(page1)
    ```
    """
}
fn
(page: Map): Map? {
  next-page(client-from-ctx(), page)
},
(client: Client, page: Map): Map? {
  ref next-page-ref(page)
  if(is-null(ref), null, json(client, "GET", page-url(ref)))
}

collect-pages
meta {
    doc: """
    Collect the items under `key` from `page` and the pages after it, up
    to `limit` items (pages are fetched only while more are needed). Each
    `list-all-*` function uses this.
    """
}
fn (client: Client, page: Map, key: Str, limit: Int): Vec<Map> {
  collect-pages(client, page, key, limit, [])
},
(client: Client, page: Map, key: Str, limit: Int, acc: Vec): Vec<Map> {
  items concat(acc, or(get(page, key), []))
  ref next-page-ref(page)
  cond {
    gte(length(items), limit) => { slice(items, 0, limit) }
    is-null(ref) => { items }
    => { collect-pages(client, json(client, "GET", page-url(ref)), key, limit, items) }
  }
}
