::documents::google ns
meta {
    doc: """
    The Google Drive implementation of the `::documents` verbs, over
    `hot.dev/google-drive` (credentials, scopes and retries come from
    `google-core`). Source: `{provider: "google-drive", drive-id?, opts}`;
    with `drive-id`, listing, search and changes stay in that shared drive.
    """
}

::source ::documents::source
::cursor ::documents::cursor
::adapters ::documents::adapters
::text ::documents::text
::gd ::google::drive
::files ::google::drive::files
::content ::google::drive::content
::up ::google::drive::upload
::gchanges ::google::drive::changes
::q ::google::drive::query
Page ::documents/Page
ChangeSet ::documents/ChangeSet

PROVIDER "google-drive"
MAX_PAGE_SIZE 1000

to-document fn (source: Map, file: Map): Any {
  ::adapters/from-google(source, ::gd/to-doc-file(file))
}

drive-opts
meta {
    doc: """The source's shared drive as Drive's `driveId` parameter (pure; `{}` for My Drive)."""
}
fn (source: Map): Map {
  d get(source, "drive-id")
  if(is-null(d), {}, {driveId: d})
}

// ---------------------------------------------------------------------------
// Pure builders
// ---------------------------------------------------------------------------

list-params
meta {
    doc: """The Drive `files.list` options for one page of `folder` (pure): `'folder' in parents and trashed = false`, `pageSize`, `pageToken`, the shared drive, then the provider options."""
}
fn (source: Map, folder: Str, token: Any, page-size: Int, popts: Map): Map {
  filter-vals({
    ...popts,
    ...drive-opts(source),
    q: ::q/all-of(::q/in-folder(folder), ::q/not-trashed()),
    pageSize: page-size,
    pageToken: token
  }, is-some)
}

to-page
meta {
    doc: """A `files.list` response as a `::documents/Page` (pure); `nextPageToken` becomes the cursor."""
}
fn (source: Map, folder: Str, response: Map): Page {
  docs map(or(response.files, []), (f) { to-document(source, f) })
  c ::cursor/list-cursor(PROVIDER, response.nextPageToken, folder)
  Page({documents: docs, cursor: c, has-more: is-some(c)})
}

to-change-set
meta {
    doc: """A google-drive `ChangeSet` (from `sync-changes`) as a `::documents/ChangeSet` (pure). Removed and trashed files are deletions."""
}
fn (source: Map, set: Map): ChangeSet {
  next ::cursor/change-cursor(PROVIDER, set.new-start-page-token)
  cond {
    is-err(next) => { next }
    => {
      ChangeSet({
        documents: map(::gchanges/changed-files(set), (f) { ::adapters/from-google(source, f) }),
        deleted-ids: ::gchanges/removed-file-ids(set),
        deleted-paths: [],
        next-cursor: next,
        reset-required: false,
        has-more: false
      })
    }
  }
}

// ---------------------------------------------------------------------------
// Verbs
// ---------------------------------------------------------------------------

list fn (source: Map, folder: Str?, opts: Map): Page {
  popts ::source/provider-opts(source, opts)
  given get(opts, "cursor")
  c if(is-null(given), null, ::cursor/decode-for(given, PROVIDER, "list"))
  cond {
    is-err(c) => { c }
    => {
      target or(if(is-map(c), c.f, null), folder, get(source, "drive-id"), "root")
      token if(is-map(c), c.v, null)
      size ::source/page-size(opts, ::documents/DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE)
      response ::files/list-files(list-params(source, target, token, size, popts))
      if(is-err(response), response, to-page(source, target, response))
    }
  }
}

search fn (source: Map, query: Str, limit: Int, opts: Map): Vec {
  popts ::source/provider-opts(source, opts)
  q ::q/all-of(::q/full-text-contains(query), ::q/not-trashed())
  found ::files/list-all-files({...popts, ...drive-opts(source), q: q}, limit)
  if(is-err(found), found, map(found, (f) { to-document(source, f) }))
}

get-doc fn (source: Map, id: Str, opts: Map): Any {
  file ::files/get-file(id, ::source/provider-opts(source, opts))
  if(is-err(file), file, to-document(source, file))
}

download fn (source: Map, id: Str, opts: Map): Any {
  popts ::source/provider-opts(source, opts)
  file ::files/get-file(id, ::gd/creds(popts))
  doc if(is-err(file), file, to-document(source, file))
  cond {
    is-err(doc) => { doc }
    doc.is-native => { err(`documents: ${doc.name} is a Google ${doc.mime-type} with no stored bytes; use read-text`) }
    => {
      content ::content/download-file(id, popts)
      if(is-err(content), content, ::adapters/to-content(source, {...untype(content), name: doc.name}, ::adapters/from-google, doc))
    }
  }
}

read-text fn (source: Map, id: Str, format: Str, opts: Map): Any {
  popts ::source/provider-opts(source, opts)
  file ::files/get-file(id, popts)
  target if(is-err(file), file, ::files/resolve-shortcut(file, popts))
  doc if(is-err(target), target, to-document(source, target))
  cond {
    is-err(doc) => { doc }
    => {
      plan ::text/plan(doc, format)
      cond {
        eq(plan.action, "error") => { ::text/plan-error(plan) }
        eq(plan.action, "unsupported") => { ::text/not-ok-result(doc, "unsupported", plan.reason) }
        eq(plan.action, "export") => {
          content ::content/export-file(doc.id, plan.export, popts)
          if(is-err(content), content, ::text/ok-result(doc, content.bytes, plan.format, content.mime-type, "export"))
        }
        => {
          content ::content/download-file(doc.id, popts)
          if(is-err(content), content, ::text/ok-result(doc, content.bytes, plan.format, or(content.mime-type, doc.mime-type), "download"))
        }
      }
    }
  }
}

upload fn (source: Map, parent: Str?, name: Str, bytes: Bytes, mime-type: Str, opts: Map): Any {
  popts ::source/provider-opts(source, opts)
  target or(parent, get(source, "drive-id"))
  file ::up/upload-file(name, bytes, mime-type, filter-vals({...popts, parent: target}, is-some))
  if(is-err(file), file, to-document(source, file))
}

start-cursor fn (source: Map, opts: Map): Any {
  token ::gchanges/get-start-page-token({...::source/provider-opts(source, opts), ...drive-opts(source)})
  if(is-err(token), token, ::cursor/change-cursor(PROVIDER, token))
}

changes fn (source: Map, cursor: Str, opts: Map): Any {
  c ::cursor/decode-for(cursor, PROVIDER, "changes")
  cond {
    is-err(c) => { c }
    => {
      set ::gchanges/sync-changes(Str(c.v), {...::source/provider-opts(source, opts), ...drive-opts(source)})
      if(is-err(set), set, to-change-set(source, set))
    }
  }
}
