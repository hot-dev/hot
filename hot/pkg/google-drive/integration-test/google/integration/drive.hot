::google::integration::drive ns
meta ["test"]

// Live Drive roundtrip (self-cleaning: it only deletes the folder and file
// it created). Requires GOOGLE_SERVICE_ACCOUNT. Set GOOGLE_IMPERSONATE (a
// Workspace user, via domain-wide delegation) so files land in that
// user's Drive: service accounts have no storage of their own, so the
// upload fails with storageQuotaExceeded without it.

::files ::google::drive::files
::up ::google::drive::upload
::content ::google::drive::content

test-file-roundtrip
meta ["test"] fn () {
    if(is-empty(::hot::env/get("GOOGLE_SERVICE_ACCOUNT", "")),
        fail("Set GOOGLE_SERVICE_ACCOUNT in .env")
    )

    folder ::files/create-folder(`hot-it-${Uuid()}`)
    assert(not(is-err(folder)), `create-folder: ${if-err(folder, (e) { err-message(e) })}`)

    body `hot drive integration ${Uuid()}`
    file ::up/upload-file("hot-it.txt", body, "text/plain", folder.id)
    assert(not(is-err(file)), `upload-file: ${if-err(file, (e) { err-message(e) })}`)

    fetched ::files/get-file(file.id)
    assert-eq("hot-it.txt", fetched.name)

    content ::content/download-file(file.id)
    assert-eq(body, content.text, "downloaded content roundtrips byte for byte")

    ::files/delete-file(file.id)
    deleted ::files/delete-file(folder.id)
    assert(not(is-err(deleted)), "cleanup should succeed")
}
