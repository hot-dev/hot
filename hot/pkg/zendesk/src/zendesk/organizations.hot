search-organizations
meta {
    doc: """
    GET /organizations/search - Exact-match (case-insensitive) lookup:
    pass `{name: "Acme"}` or `{external_id: "acme-42"}`, not both.
    Returns `{organizations, count}`. For fuzzy matches use
    `::zendesk::search/search("type:organization acme")`.

    **Example**

    ```hot
    out ::zendesk::organizations/search-organizations({external_id: "acme-42"})
    map(out.organizations, %.name)
    ```
    """
}
fn
(by: Map): Any {
  search-organizations(by, {})
},
(by: Map, opts: Map): Any {
  ::api/request("GET", `/organizations/search${::api/query-string(by)}`, "", opts)
}
