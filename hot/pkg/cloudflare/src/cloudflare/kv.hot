::cloudflare::kv ns
meta {
    doc: """
    Workers KV over the Cloudflare API: namespaces, key listing (cursor
    paged), and values. KV stores raw bytes — `read` returns Bytes;
    `read-text` and `read-json` decode them. Values written through the
    API become visible at the edge within about 60 seconds.
    """,
    ctx: {"cloudflare.token": {required: false}, "cloudflare.account.id": {required: false, secret: false}}
}

::api ::cloudflare::api

ListPage ::cloudflare::api/ListPage
HttpError ::cloudflare::api/HttpError

namespaces-suffix "/storage/kv/namespaces"

namespace-suffix
meta {no-doc: true}
fn (namespace-id: Str): Str {
  `${namespaces-suffix}/${::api/seg(namespace-id)}`
}

value-suffix
meta {no-doc: true}
fn (namespace-id: Str, key: Str): Str {
  `${namespace-suffix(namespace-id)}/values/${::api/seg(key)}`
}

// ---------------------------------------------------------------------------
// Namespaces
// ---------------------------------------------------------------------------

list-namespaces
meta {
    doc: """
    GET /accounts/{account_id}/storage/kv/namespaces - One page of
    namespaces (`page`, `per_page` up to 1000, `order`: `id`/`title`,
    `direction`). Returns a `ListPage`.

    **Example**

    ```hot
    page ::cloudflare::kv/list-namespaces({per_page: 100, order: "title"})
    map(page.result, %.title)
    ```
    """
}
fn
(): ListPage {
  list-namespaces({})
},
(params: Map): ListPage {
  list-namespaces(params, {})
},
(params: Map, opts: Map): ListPage {
  ::api/account-page(`${namespaces-suffix}${::api/query(params)}`, "", opts)
}

list-all-namespaces
meta {
    doc: """
    Every namespace, following pages (1000 per request) up to `max` items
    (default 10000).

    **Example**

    ```hot
    map(::cloudflare::kv/list-all-namespaces(500), %.title)
    ```
    """
}
fn
(): Vec {
  list-all-namespaces(::api/DEFAULT_MAX_ITEMS)
},
(max: Int): Vec {
  list-all-namespaces(max, {})
},
(opts: Map): Vec {
  list-all-namespaces(::api/DEFAULT_MAX_ITEMS, opts)
},
(max: Int, opts: Map): Vec {
  ::api/collect-pages((p) { list-namespaces(p, opts) }, {per_page: 1000}, max)
}

create-namespace
meta {
    doc: """
    POST /accounts/{account_id}/storage/kv/namespaces - Create a namespace
    titled `title`. Returns `{id, title, supports_url_encoding}`.

    **Example**

    ```hot
    created ::cloudflare::kv/create-namespace("sessions")
    created.id
    ```
    """
}
fn
(title: Str): Map {
  create-namespace(title, {})
},
(title: Str, opts: Map): Map {
  ::api/account-json("POST", namespaces-suffix, {title: title}, opts)
}

delete-namespace
meta {
    doc: """
    DELETE a namespace and every key in it.

    **Example**

    ```hot
    ::cloudflare::kv/delete-namespace("0f2ac74b498b48028cb68387c421e279")
    ```
    """
}
fn
(namespace-id: Str): Any {
  delete-namespace(namespace-id, {})
},
(namespace-id: Str, opts: Map): Any {
  ::api/account-json("DELETE", namespace-suffix(namespace-id), "", opts)
}

// ---------------------------------------------------------------------------
// Keys
// ---------------------------------------------------------------------------

list-keys
meta {
    doc: """
    GET .../namespaces/{id}/keys - One page of keys (names, `expiration`,
    `metadata`; never values). `params`: `prefix`, `limit` (10–1000),
    `cursor` (from the previous page's `result_info.cursor`). Returns a
    `ListPage`; `::cloudflare::api/next-cursor(page.result_info)` is null
    on the last page.

    **Example**

    ```hot
    namespace-id "0f2ac74b498b48028cb68387c421e279"
    page ::cloudflare::kv/list-keys(namespace-id, {prefix: "session:", limit: 100})
    map(page.result, %.name)
    ```
    """
}
fn
(namespace-id: Str): ListPage {
  list-keys(namespace-id, {})
},
(namespace-id: Str, params: Map): ListPage {
  list-keys(namespace-id, params, {})
},
(namespace-id: Str, params: Map, opts: Map): ListPage {
  ::api/account-page(`${namespace-suffix(namespace-id)}/keys${::api/query(params)}`, "", opts)
}

list-all-keys
meta {
    doc: """
    Every key matching `params` (usually `{prefix}`), following cursors
    (1000 per request) up to `max` keys (default 10000).

    **Example**

    ```hot
    keys-found ::cloudflare::kv/list-all-keys("0f2ac74b498b48028cb68387c421e279", {prefix: "session:"}, 5000)
    map(keys-found, %.name)
    ```
    """
}
fn
(namespace-id: Str): Vec {
  list-all-keys(namespace-id, {})
},
(namespace-id: Str, params: Map): Vec {
  list-all-keys(namespace-id, params, ::api/DEFAULT_MAX_ITEMS)
},
(namespace-id: Str, params: Map, max: Int): Vec {
  list-all-keys(namespace-id, params, max, {})
},
(namespace-id: Str, params: Map, opts: Map): Vec {
  list-all-keys(namespace-id, params, ::api/DEFAULT_MAX_ITEMS, opts)
},
(namespace-id: Str, params: Map, max: Int, opts: Map): Vec {
  ::api/collect-cursor((p) { list-keys(namespace-id, p, opts) }, {limit: 1000, ...params}, max)
}

// ---------------------------------------------------------------------------
// Values
// ---------------------------------------------------------------------------

read
meta {
    doc: """
    GET .../values/{key} - A value's raw bytes. An absent key is an Err
    carrying `HttpError` with status 404 (see `is-not-found`).

    **Example**

    ```hot
    namespace-id "0f2ac74b498b48028cb68387c421e279"
    png ::cloudflare::kv/read(namespace-id, "avatar:42")
    ```
    """
}
fn
(namespace-id: Str, key: Str): Bytes {
  read(namespace-id, key, {})
},
(namespace-id: Str, key: Str, opts: Map): Bytes {
  path ::api/account-path(value-suffix(namespace-id, key), opts)
  cond {
    is-err(path) => { path }
    => {
      response ::api/send("GET", path, {}, "", opts)
      cond {
        is-err(response) => { response }
        => { or(response.body-bytes, Bytes("")) }
      }
    }
  }
}

read-text
meta {
    doc: """
    A value decoded as UTF-8 text.

    **Example**

    ```hot
    ::cloudflare::kv/read-text("0f2ac74b498b48028cb68387c421e279", "flag:checkout-v2")
    ```
    """
}
fn
(namespace-id: Str, key: Str): Str {
  read-text(namespace-id, key, {})
},
(namespace-id: Str, key: Str, opts: Map): Str {
  value read(namespace-id, key, opts)
  cond {
    is-err(value) => { value }
    => { Str(value) }
  }
}

read-json
meta {
    doc: """
    A value parsed as JSON (an Err when it is not valid JSON).

    **Example**

    ```hot
    settings ::cloudflare::kv/read-json("0f2ac74b498b48028cb68387c421e279", "settings")
    settings.theme
    ```
    """
}
fn
(namespace-id: Str, key: Str): Any {
  read-json(namespace-id, key, {})
},
(namespace-id: Str, key: Str, opts: Map): Any {
  text read-text(namespace-id, key, opts)
  cond {
    is-err(text) => { text }
    => { ::hot::json/from-json(text) }
  }
}

read-metadata
meta {
    doc: """
    GET .../metadata/{key} - The JSON metadata stored with a key (null when
    none).

    **Example**

    ```hot
    meta-data ::cloudflare::kv/read-metadata("0f2ac74b498b48028cb68387c421e279", "session:abc")
    meta-data.user
    ```
    """
}
fn
(namespace-id: Str, key: Str): Any {
  read-metadata(namespace-id, key, {})
},
(namespace-id: Str, key: Str, opts: Map): Any {
  ::api/account-json("GET", `${namespace-suffix(namespace-id)}/metadata/${::api/seg(key)}`, "", opts)
}

status-of
meta {no-doc: true}
fn (e: Any): Int? {
  cond {
    is-map(e) => { get(e, "status") }
    => { null }
  }
}

is-not-found
meta {
    doc: """
    True when `result` is an Err for a missing key (HTTP 404). Use it to
    tell "absent" from real failures after `read`.

    **Example**

    ```hot
    missing err(::cloudflare::api/HttpError({status: 404, headers: {}, body: "", errors: [], message: "HTTP 404"}))
    ::cloudflare::kv/is-not-found(missing)  // true
    ::cloudflare::kv/is-not-found("value")  // false
    ```
    """
}
fn (result: Result): Bool {
  cond {
    is-err(result) => { if-err(result, (e) { status-of(e) |> eq(404) }) }
    => { false }
  }
}

write-query
meta {
    doc: """
    The `?expiration_ttl=…&expiration=…` suffix for a write; unset options
    are omitted. Exposed for testing.

    **Example**

    ```hot
    ::cloudflare::kv/write-query({expiration_ttl: 3600})  // "?expiration_ttl=3600"
    ::cloudflare::kv/write-query({})  // ""
    ```
    """
}
fn
(options: Map): Str {
  ::api/query({
    expiration_ttl: get(options, "expiration_ttl"),
    expiration: get(options, "expiration")
  })
}

write-parts
meta {
    doc: """
    The multipart parts for a write that carries metadata: the `value` part
    (Str or Bytes) and a JSON `metadata` part. Exposed for testing.

    **Example**

    ```hot
    parts ::cloudflare::kv/write-parts("on", {user: "u_42"})
    map(parts, %.name)  // ["value", "metadata"]
    parts[1].value  // "{\"user\":\"u_42\"}"
    ```
    """
}
fn (value: Any, metadata: Any): Vec {
  [
    {name: "value", value: value, content_type: "application/octet-stream"},
    {name: "metadata", value: to-json(untype(metadata)), content_type: "application/json"}
  ]
}

write
meta {
    doc: """
    PUT .../values/{key} - Store `value` (Str or Bytes; a Map/Vec is
    stored as JSON). `options`:
    - `expiration_ttl` — seconds until the key expires (minimum 60)
    - `expiration` — absolute expiry, seconds since the epoch
    - `metadata` — JSON (up to 1024 bytes serialized) kept alongside the key

    A write without metadata sends the raw bytes; with metadata it uses
    the multipart form the API requires.

    **Example**

    ```hot
    namespace-id "0f2ac74b498b48028cb68387c421e279"
    ::cloudflare::kv/write(namespace-id, "flag:checkout-v2", "on")
    ::cloudflare::kv/write(namespace-id, "session:abc", to-json({cart: ["sku-1"]}), {expiration_ttl: 3600, metadata: {user: "u_42"}})
    ```
    """
}
fn
(namespace-id: Str, key: Str, value: Any): Any {
  write(namespace-id, key, value, {})
},
(namespace-id: Str, key: Str, value: Any, options: Map): Any {
  write(namespace-id, key, value, options, {})
},
(namespace-id: Str, key: Str, value: Any, options: Map, opts: Map): Any {
  suffix `${value-suffix(namespace-id, key)}${write-query(options)}`
  path ::api/account-path(suffix, opts)
  metadata get(options, "metadata")
  cond {
    is-err(path) => { path }
    is-some(metadata) => { ::api/send-multipart("PUT", path, write-parts(value, metadata), opts) }
    => {
      response ::api/send("PUT", path, {Content-Type: "application/octet-stream"}, ::api/as-bytes(value), opts)
      cond {
        is-err(response) => { response }
        => { get(or(response.body, {}), "result") }
      }
    }
  }
}

delete-key
meta {
    doc: """
    DELETE .../values/{key} - Remove a key (succeeds for absent keys too).

    **Example**

    ```hot
    ::cloudflare::kv/delete-key("0f2ac74b498b48028cb68387c421e279", "session:abc")
    ```
    """
}
fn
(namespace-id: Str, key: Str): Any {
  delete-key(namespace-id, key, {})
},
(namespace-id: Str, key: Str, opts: Map): Any {
  ::api/account-json("DELETE", value-suffix(namespace-id, key), "", opts)
}

write-bulk
meta {
    doc: """
    PUT .../bulk - Write up to 10,000 entries in one request. Each entry
    is `{key, value, expiration_ttl?, expiration?, metadata?, base64?}`;
    `value` must be a string (set `base64: true` and base64-encode binary
    values). Returns `{successful_key_count, unsuccessful_keys}`.

    **Example**

    ```hot
    out ::cloudflare::kv/write-bulk("0f2ac74b498b48028cb68387c421e279", [
      {key: "flag:a", value: "on"},
      {key: "session:abc", value: "{}", expiration_ttl: 3600}
    ])
    out.successful_key_count
    ```
    """
}
fn
(namespace-id: Str, entries: Vec): Map {
  write-bulk(namespace-id, entries, {})
},
(namespace-id: Str, entries: Vec, opts: Map): Map {
  ::api/account-json("PUT", `${namespace-suffix(namespace-id)}/bulk`, map(entries, (e) { filter-vals(untype(e), is-some) }), opts)
}

delete-bulk
meta {
    doc: """
    POST .../bulk/delete - Delete up to 10,000 keys in one request.

    **Example**

    ```hot
    ::cloudflare::kv/delete-bulk("0f2ac74b498b48028cb68387c421e279", ["flag:a", "session:abc"])
    ```
    """
}
fn
(namespace-id: Str, key-names: Vec<Str>): Map {
  delete-bulk(namespace-id, key-names, {})
},
(namespace-id: Str, key-names: Vec<Str>, opts: Map): Map {
  ::api/account-json("POST", `${namespace-suffix(namespace-id)}/bulk/delete`, key-names, opts)
}
