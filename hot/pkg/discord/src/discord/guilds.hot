GetGuildAuditLogRequest type {
  guild_id: Str,
  user_id: Str?,
  action_type: Int?,
  before: Str?,
  after: Str?,
  limit: Int?
}

get-guild-audit-log
meta {
    doc: """
    GET /guilds/{guild_id}/audit-logs - Audit log entries (up to `limit`,
    1-100), filtered by actor `user_id` and `action_type`. Returns
    `{audit_log_entries, users, ...}`. Needs VIEW_AUDIT_LOG.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    // Recent bans (action type 22)
    log ::guilds/get-guild-audit-log(::guilds/GetGuildAuditLogRequest({
      guild_id: "1000000000000000000",
      action_type: 22,
      limit: 20
    }))
    map(log.audit_log_entries, (e) { e.reason })
    ```
    """
}
fn
(request: GetGuildAuditLogRequest): Map {
  get-guild-audit-log(request, {})
},
(request: GetGuildAuditLogRequest, opts: Map): Map {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/audit-logs`, {
    query: {
      user_id: request.user_id,
      action_type: request.action_type,
      before: request.before,
      after: request.after,
      limit: request.limit
    }
  }, opts)
}

GetGuildInvitesRequest type {
  guild_id: Str
}

get-guild-invites
meta {
    doc: """
    GET /guilds/{guild_id}/invites - Every invite in a guild, with metadata.
    Needs MANAGE_GUILD or VIEW_AUDIT_LOG.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    invites ::guilds/get-guild-invites(::guilds/GetGuildInvitesRequest({guild_id: "1000000000000000000"}))
    map(invites, %.code)
    ```
    """
}
fn
(request: GetGuildInvitesRequest): Vec<Map> {
  get-guild-invites(request, {})
},
(request: GetGuildInvitesRequest, opts: Map): Vec<Map> {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/invites`, {}, opts)
}
