::attio::records ns

::api ::attio::api

list-objects
meta {
    doc: """
    GET /objects - The workspace's objects (system
    `people`/`companies`/`deals` and custom ones) with their slugs.

    **Example**

    ```hot
    objects ::attio::records/list-objects()
    map(objects.data, %.api_slug)
    ```
    """
}
fn
(): Map {
  list-objects({})
},
(opts: Map): Map {
  ::api/json("GET", "/objects", "", opts)
}

get-object
meta {
    doc: """
    GET /objects/{object} - One object's configuration (`api_slug`,
    singular/plural nouns). Requires the Object Configuration scope.

    **Example**

    ```hot
    people ::attio::records/get-object("people")
    people.api_slug
    ```
    """
}
fn
(object: Str): Map {
  get-object(object, {})
},
(object: Str, opts: Map): Map {
  out ::api/json("GET", `/objects/${object}`, "", opts)
  match out {
    Result.Err => { err(out) }

    _ => { out.data }
  }
}

list-attributes
meta {
    doc: """
    GET /objects/{object}/attributes - An object's attributes (`api_slug`,
    `type`, `is_required`, ...). Attribute slugs are the keys
    `create-record` values use. Requires the Object Configuration scope.

    **Example**

    ```hot
    attributes ::attio::records/list-attributes("people")
    map(attributes.data, %.api_slug)
    ```
    """
}
fn
(object: Str): Map {
  list-attributes(object, {})
},
(object: Str, opts: Map): Map {
  ::api/json("GET", `/objects/${object}/attributes`, "", opts)
}

query-records
meta {
    doc: """
    POST /objects/{object}/records/query - Query records. `options`:
    `filter` (https://docs.attio.com/rest-api/how-to/filtering-and-sorting),
    `sorts`, `limit` (max 500), `offset`.

    **Example**

    ```hot
    hits ::attio::records/query-records("companies", {
      filter: {domains: {domain: {"$contains": "example.com"}}},
      limit: 10
    })
    hits.data
    ```
    """
}
fn
(object: Str): Map {
  query-records(object, {})
},
(object: Str, options: Map): Map {
  query-records(object, options, {})
},
(object: Str, options: Map, opts: Map): Map {
  ::api/json("POST", `/objects/${object}/records/query`, options, opts)
}

get-record
meta {
    doc: """
    GET /objects/{object}/records/{id} - One record with all attribute
    values.

    **Example**

    ```hot
    person ::attio::records/get-record("people", ::attio::recordsEC)
    person.values.email_addresses
    ```
    """
}
fn
(object: Str, record-id: Str): Map {
  get-record(object, record-id, {})
},
(object: Str, record-id: Str, opts: Map): Map {
  out ::api/json("GET", `/objects/${object}/records/${record-id}`, "", opts)
  match out {
    Result.Err => { err(out) }

    _ => { out.data }
  }
}

create-record
meta {
    doc: """
    POST /objects/{object}/records - Create a record from attribute
    `values` (Attio's value shapes, e.g.
    `{email_addresses: [{email_address: "a@b.c"}]}`).

    **Example**

    ```hot
    company ::attio::records/create-record("companies", {name: [{value: "Example Inc"}], domains: [{domain: "example.com"}]})
    company.id.record_id
    ```
    """
}
fn
(object: Str, values: Map): Map {
  create-record(object, values, {})
},
(object: Str, values: Map, opts: Map): Map {
  out ::api/json("POST", `/objects/${object}/records`, {data: {values: values}}, opts)
  match out {
    Result.Err => { err(out) }

    _ => { out.data }
  }
}

assert-record
meta {
    doc: """
    PUT /objects/{object}/records?matching_attribute= - Create-or-update
    keyed on a unique attribute (Attio's upsert). The idiomatic way to
    sync people/companies in.

    **Example**

    ```hot
    person ::attio::records/assert-record("people", "email_addresses", {
      email_addresses: [{email_address: "ada@example.com"}],
      name: [{first_name: "Ada", last_name: "Lovelace", full_name: "Ada Lovelace"}]
    })
    ```
    """
}
fn
(object: Str, matching-attribute: Str, values: Map): Map {
  assert-record(object, matching-attribute, values, {})
},
(object: Str, matching-attribute: Str, values: Map, opts: Map): Map {
  out ::api/json("PUT", `/objects/${object}/records?matching_attribute=${matching-attribute}`, {data: {values: values}}, opts)
  match out {
    Result.Err => { err(out) }

    _ => { out.data }
  }
}

update-record
meta {
    doc: """
    PATCH /objects/{object}/records/{id} - Update the given attribute values
    of a record.

    **Example**

    ```hot
    ::attio::records/update-record("people", ::attio::recordsEC, {job_title: [{value: "CTO"}]})
    ```
    """
}
fn
(object: Str, record-id: Str, values: Map): Map {
  update-record(object, record-id, values, {})
},
(object: Str, record-id: Str, values: Map, opts: Map): Map {
  out ::api/json("PATCH", `/objects/${object}/records/${record-id}`, {data: {values: values}}, opts)
  match out {
    Result.Err => { err(out) }

    _ => { out.data }
  }
}

delete-record
meta {
    doc: """
    DELETE /objects/{object}/records/{id} - Delete a record.

    **Example**

    ```hot
    ::attio::records/delete-record("people", ::attio::recordsEC)
    ```
    """
}
fn
(object: Str, record-id: Str): Any {
  delete-record(object, record-id, {})
},
(object: Str, record-id: Str, opts: Map): Any {
  ::api/json("DELETE", `/objects/${object}/records/${record-id}`, "", opts)
}
