::web-search::integration ns
meta ["test"]

// Requires at least one of TAVILY_API_KEY, BRAVE_API_KEY, EXA_API_KEY,
// FIRECRAWL_API_KEY; runs one small search against every configured
// provider and skips when none is set. Read-only.
// Run with: hot test --project pkg-integration-web-search

::ctx ::web-search::integration::ctx

test-normalized-search-each-provider
meta ["test"] fn () {
    providers ::web-search/configured-providers()
    cond {
        is-empty(providers) => { ::ctx/skip(::ctx/UNCONFIGURED) }
        => {
            map(providers, (provider) {
                results ::web-search/search("hot.dev programming language", 3, {provider: provider})
                assert(not(is-err(results)), `${provider}: ${if-err(results, (e) { err-message(e) })}`)
                assert(gt(length(results), 0), `${provider} should return results`)
                assert(lte(length(results), 3), `${provider} respects max-results`)
                assert(starts-with(first(results).url, "http"), `${provider} returns URLs`)
            })
        }
    }
}
