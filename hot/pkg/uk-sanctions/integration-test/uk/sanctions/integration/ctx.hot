::uk::sanctions::integration::ctx ns

::env ::hot::env

// Live smoke tests download the public list file (about 22 MB), so they only run when
// UK_SANCTIONS_LIVE=1.

live
meta {doc: """True when UK_SANCTIONS_LIVE=1: the live tests may run."""}
fn (): Bool {
    eq(::env/get("UK_SANCTIONS_LIVE", ""), "1")
}

skip
meta {doc: """Record a skip and pass."""}
fn (why: Str): Bool {
    println(`uk-sanctions integration: ${why} - skipping`)
    assert(true, `skipped: ${why}`)
}
