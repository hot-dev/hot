::stripe::invoices ns
meta {
    doc: """Invoices and invoice items: drafts, finalization, payment, sending, voiding, previews, and search. See https://docs.stripe.com/api/invoices."""
}

api-call ::stripe::api/call
seg ::stripe::api/encode-id
RequestOptions ::stripe::api/RequestOptions

// ============================================================================
// Invoices
// ============================================================================

CreateInvoiceRequest type {
  customer: Str?,
  subscription: Str?,
  auto_advance: Bool?,
  collection_method: Str?,
  days_until_due: Int?,
  due_date: Int?,
  description: Str?,
  metadata: Map?,
  currency: Str?,
  automatic_tax: Map?,
  default_payment_method: Str?,
  default_tax_rates: Vec<Str>?,
  discounts: Vec<Map>?,
  custom_fields: Vec<Map>?,
  footer: Str?,
  pending_invoice_items_behavior: Str?,
  payment_settings: Map?,
  expand: Vec<Str>?
}

create-invoice
meta {
    doc: """
POST /v1/invoices - Create a draft invoice. Pending invoice items for the customer are included only with `pending_invoice_items_behavior: "include"` (the default is "exclude"); or attach items to the draft afterwards with `create-invoice-item(..., invoice.id)`. Set `auto_advance: true` to let Stripe finalize and collect it automatically.

**Example**

```hot
::invoices ::stripe::invoices

invoice ::invoices/create-invoice(::invoices/CreateInvoiceRequest({
  customer: "cus_...",
  collection_method: "send_invoice",
  days_until_due: 30
}))
::invoices/create-invoice-item(::invoices/CreateInvoiceItemRequest({
  customer: "cus_...",
  invoice: invoice.id,
  amount: 2500,
  currency: "usd",
  description: "Consulting"
}))
::invoices/finalize-invoice(invoice.id)
::invoices/send-invoice(invoice.id)
```
"""
}
fn
(request: CreateInvoiceRequest): Map {
  create-invoice(request, RequestOptions({}))
},
(request: CreateInvoiceRequest, options: RequestOptions): Map {
  api-call("POST", "/v1/invoices", request, options)
}

get-invoice
meta {
    doc: """GET /v1/invoices/{invoice} - Retrieve an invoice by ID. Optional `params` such as `{expand: ["payments"]}`. The subscription an invoice belongs to is at `parent.subscription_details.subscription`; the client secret for paying it client-side is `confirmation_secret.client_secret`."""
}
fn
(invoice: Str): Map {
  get-invoice(invoice, {})
},
(invoice: Str, params: Map): Map {
  api-call("GET", `/v1/invoices/${seg(invoice)}`, params)
}

UpdateInvoiceRequest type {
  description: Str?,
  metadata: Map?,
  auto_advance: Bool?,
  collection_method: Str?,
  days_until_due: Int?,
  due_date: Int?,
  default_payment_method: Str?,
  discounts: Any?,
  custom_fields: Any?,
  footer: Str?,
  payment_settings: Map?,
  expand: Vec<Str>?
}

update-invoice
meta {
    doc: """POST /v1/invoices/{invoice} - Update an invoice. Most fields can only change while it is a draft; `metadata`, `auto_advance` and a few others stay editable after finalization."""
}
fn
(invoice: Str, request: UpdateInvoiceRequest): Map {
  update-invoice(invoice, request, RequestOptions({}))
},
(invoice: Str, request: UpdateInvoiceRequest, options: RequestOptions): Map {
  api-call("POST", `/v1/invoices/${seg(invoice)}`, request, options)
}

delete-invoice
meta {
    doc: """DELETE /v1/invoices/{invoice} - Delete a draft invoice. Finalized invoices must be voided instead."""
}
fn (invoice: Str): Map {
  api-call("DELETE", `/v1/invoices/${seg(invoice)}`)
}

FinalizeInvoiceRequest type {
  auto_advance: Bool?,
  expand: Vec<Str>?
}

finalize-invoice
meta {
    doc: """POST /v1/invoices/{invoice}/finalize - Finalize a draft invoice so it can be paid. `auto_advance: false` finalizes without letting Stripe attempt collection automatically."""
}
fn
(invoice: Str): Map {
  finalize-invoice(invoice, FinalizeInvoiceRequest({}), RequestOptions({}))
},
(invoice: Str, request: FinalizeInvoiceRequest): Map {
  finalize-invoice(invoice, request, RequestOptions({}))
},
(invoice: Str, request: FinalizeInvoiceRequest, options: RequestOptions): Map {
  api-call("POST", `/v1/invoices/${seg(invoice)}/finalize`, request, options)
}

PayInvoiceRequest type {
  payment_method: Str?,
  off_session: Bool?,
  forgive: Bool?,
  paid_out_of_band: Bool?,
  mandate: Str?,
  source: Str?,
  expand: Vec<Str>?
}

pay-invoice
meta {
    doc: """
POST /v1/invoices/{invoice}/pay - Attempt payment on an open invoice now, outside the normal collection schedule. Pass `payment_method` to charge a specific method, `off_session: false` when the customer is present (allows 3DS), or `paid_out_of_band: true` to mark it paid outside Stripe. Pass an idempotency key so a retry never charges twice.

**Example**

```hot
::invoices ::stripe::invoices

paid ::invoices/pay-invoice("in_...",
  ::invoices/PayInvoiceRequest({payment_method: "pm_..."}),
  ::stripe::api/RequestOptions({idempotency_key: "in_123-pay-1"}))
paid.status  // => "paid"
```
"""
}
fn
(invoice: Str): Map {
  pay-invoice(invoice, PayInvoiceRequest({}), RequestOptions({}))
},
(invoice: Str, request: PayInvoiceRequest): Map {
  pay-invoice(invoice, request, RequestOptions({}))
},
(invoice: Str, request: PayInvoiceRequest, options: RequestOptions): Map {
  api-call("POST", `/v1/invoices/${seg(invoice)}/pay`, request, options)
}

send-invoice
meta {
    doc: """POST /v1/invoices/{invoice}/send - Email an invoice to the customer for manual payment. The invoice must use `collection_method: "send_invoice"`. In test mode no email is actually sent."""
}
fn
(invoice: Str): Map {
  send-invoice(invoice, RequestOptions({}))
},
(invoice: Str, options: RequestOptions): Map {
  api-call("POST", `/v1/invoices/${seg(invoice)}/send`, {}, options)
}

void-invoice
meta {
    doc: """POST /v1/invoices/{invoice}/void - Void a finalized invoice. Voiding is irreversible and similar to deletion for accounting purposes."""
}
fn
(invoice: Str): Map {
  void-invoice(invoice, RequestOptions({}))
},
(invoice: Str, options: RequestOptions): Map {
  api-call("POST", `/v1/invoices/${seg(invoice)}/void`, {}, options)
}

mark-invoice-uncollectible
meta {
    doc: """POST /v1/invoices/{invoice}/mark_uncollectible - Mark an open invoice as uncollectible (bad debt). It can still be paid later."""
}
fn
(invoice: Str): Map {
  mark-invoice-uncollectible(invoice, RequestOptions({}))
},
(invoice: Str, options: RequestOptions): Map {
  api-call("POST", `/v1/invoices/${seg(invoice)}/mark_uncollectible`, {}, options)
}

list-invoice-lines
meta {
    doc: """GET /v1/invoices/{invoice}/lines - List an invoice's line items. Optional `params`: `limit`, `starting_after`, `ending_before`."""
}
fn
(invoice: Str): Map {
  list-invoice-lines(invoice, {})
},
(invoice: Str, params: Map): Map {
  api-call("GET", `/v1/invoices/${seg(invoice)}/lines`, params)
}

create-invoice-preview
meta {
    doc: """
POST /v1/invoices/create_preview - Preview the next invoice for a customer or subscription without creating it, e.g. to show the prorated cost of a plan change. `params` takes the API's fields directly (`customer`, `subscription`, `subscription_details: {items, proration_date}`, ...).

**Example**

```hot
::invoices ::stripe::invoices

preview ::invoices/create-invoice-preview({
  customer: "cus_...",
  subscription: "sub_...",
  subscription_details: {items: [{id: "si_...", price: "price_pro"}]}
})
preview.amount_due
```
"""
}
fn (params: Map): Map {
  api-call("POST", "/v1/invoices/create_preview", params)
}

ListInvoicesRequest type {
  customer: Str?,
  subscription: Str?,
  status: Str?,
  collection_method: Str?,
  created: Any?,
  due_date: Any?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-invoices
meta {
    doc: """GET /v1/invoices - List invoices, most recent first. Filter by `customer`, `subscription`, or `status` ("draft", "open", "paid", "uncollectible", "void")."""
}
fn
(): Map {
  list-invoices(ListInvoicesRequest({}))
},
(request: ListInvoicesRequest): Map {
  api-call("GET", "/v1/invoices", request)
}

search-invoices
meta {
    doc: """GET /v1/invoices/search - Search invoices with Stripe's search query language, e.g. `status:"open" AND customer:"cus_..."`. Pass `next_page` back as `page` in `params` to continue."""
}
fn
(query: Str): Map {
  search-invoices(query, {})
},
(query: Str, params: Map): Map {
  api-call("GET", "/v1/invoices/search", {...params, query: query})
}

// ============================================================================
// Invoice Items
// ============================================================================

CreateInvoiceItemRequest type {
  customer: Str?,
  invoice: Str?,
  subscription: Str?,
  amount: Int?,
  currency: Str?,
  description: Str?,
  quantity: Int?,
  pricing: Map?,
  price_data: Map?,
  unit_amount_decimal: Str?,
  period: Map?,
  discountable: Bool?,
  discounts: Vec<Map>?,
  tax_rates: Vec<Str>?,
  tax_behavior: Str?,
  tax_code: Str?,
  metadata: Map?,
  expand: Vec<Str>?
}

create-invoice-item
meta {
    doc: """
POST /v1/invoiceitems - Add a one-off line to a customer's next invoice, or to a specific draft with `invoice`. Give either a flat `amount` (smallest currency unit), or `pricing: {price: "price_..."}` with a `quantity` (since 2025-03-31.basil, `price` moved under `pricing`).

The 4- and 5-arity forms are shortcuts for a flat-amount item: `(customer, amount, currency, description)` and the same with a draft `invoice` ID.

**Example**

```hot
::invoices ::stripe::invoices

::invoices/create-invoice-item("cus_...", 2500, "usd", "Consulting")
::invoices/create-invoice-item(::invoices/CreateInvoiceItemRequest({
  customer: "cus_...",
  pricing: {price: "price_..."},
  quantity: 2
}))
```
"""
}
fn
(request: CreateInvoiceItemRequest): Map {
  create-invoice-item(request, RequestOptions({}))
},
(request: CreateInvoiceItemRequest, options: RequestOptions): Map {
  api-call("POST", "/v1/invoiceitems", request, options)
},
(customer: Str, amount: Int, currency: Str, description: Str): Map {
  create-invoice-item(CreateInvoiceItemRequest({customer: customer, amount: amount, currency: currency, description: description}))
},
(customer: Str, amount: Int, currency: Str, description: Str, invoice: Str): Map {
  create-invoice-item(CreateInvoiceItemRequest({customer: customer, amount: amount, currency: currency, description: description, invoice: invoice}))
}

delete-invoice-item
meta {
    doc: """DELETE /v1/invoiceitems/{invoiceitem} - Delete an invoice item that isn't yet on a finalized invoice."""
}
fn (invoice-item: Str): Map {
  api-call("DELETE", `/v1/invoiceitems/${seg(invoice-item)}`)
}
