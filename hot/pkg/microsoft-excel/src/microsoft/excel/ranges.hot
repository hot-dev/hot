::microsoft::excel::ranges ns
meta {
    doc: """
    Cell ranges: read and write values and formulas by A1 address, used
    ranges, clearing, inserting and deleting cells, and rows as records.

    Excel returns blank cells as `""` and dates as serial numbers (use
    `read-formatted` for what the cell shows). When writing, `""` empties
    a cell, null leaves it unchanged, and a string starting with `=` is a
    formula.
    """
}

::excel ::microsoft::excel
::records ::microsoft::excel::records

get-range
meta {
    doc: """
    GET /worksheets/{sheet}/range(address='...'). Returns the range:
    `address`, `values`, `formulas`, `text`, `numberFormat`, `rowCount`,
    `columnCount`, ... Pass `{select: "values,address"}` to trim it.

    **Example**

    ```hot
    cells ::microsoft::excel::ranges/get-range("/Reports/Q3.xlsx", "Data", "A1:C10")
    cells.rowCount

    // Only the fields you need
    ::microsoft::excel::ranges/get-range("/Reports/Q3.xlsx", "Data", "A1:C10", {select: "values,address"})
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str): Map {
  get-range(item, sheet, address, {})
},
(item: Any, sheet: Str, address: Str, opts: Map): Map {
  ::excel/fetch(::excel/range-path(item, sheet, address, opts), {}, opts)
}

read-field
meta {no-doc: true}
fn (item: Any, sheet: Str, address: Str, field: Str, opts: Map): Vec {
  result ::excel/fetch(::excel/range-path(item, sheet, address, opts), {select: field}, ::excel/without-query(opts))
  if(is-err(result), result, or(get(result, field), []))
}

read-values
meta {
    doc: """
    A range's values as a grid (a Vec of rows).

    **Example**

    ```hot
    grid ::microsoft::excel::ranges/read-values("/Reports/Q3.xlsx", "Data", "A1:C10")
    first(grid)

    // A workbook in another drive
    ::microsoft::excel::ranges/read-values("01ABC", "Data", "A1:C10", {drive: "b1"})
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str): Vec {
  read-field(item, sheet, address, "values", {})
},
(item: Any, sheet: Str, address: Str, opts: Map): Vec {
  read-field(item, sheet, address, "values", opts)
}

read-formulas
meta {
    doc: """
    A range's formulas as a grid; cells without a formula hold their value.

    **Example**

    ```hot
    formulas ::microsoft::excel::ranges/read-formulas("/Reports/Q3.xlsx", "Summary", "B2:B5")
    first(formulas)
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str): Vec {
  read-field(item, sheet, address, "formulas", {})
},
(item: Any, sheet: Str, address: Str, opts: Map): Vec {
  read-field(item, sheet, address, "formulas", opts)
}

read-formatted
meta {
    doc: """
    A range's cells as the text they display, as a grid of Strs.

    **Example**

    ```hot
    // Dates as the cell shows them, not as serial numbers
    shown ::microsoft::excel::ranges/read-formatted("/Reports/Q3.xlsx", "Data", "A2:A5")
    first(shown)
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str): Vec {
  read-field(item, sheet, address, "text", {})
},
(item: Any, sheet: Str, address: Str, opts: Map): Vec {
  read-field(item, sheet, address, "text", opts)
}

used-range-path
meta {
    doc: """
    The Graph path of a worksheet's used range (pure). With
    `opts.values-only`, cells that only have formatting are left out.

    **Example**

    ```hot
    ::microsoft::excel::ranges/used-range-path("01ABC", "Data", {drive: "b1"})
    // "/drives/b1/items/01ABC/workbook/worksheets/Data/usedRange"

    ::microsoft::excel::ranges/used-range-path("01ABC", "Data", {drive: "b1", values-only: true})
    // "/drives/b1/items/01ABC/workbook/worksheets/Data/usedRange(valuesOnly=true)"
    ```
    """
}
fn (item: Any, sheet: Str, opts: Map): Str {
  base `${::excel/worksheet-path(item, sheet, opts)}/usedRange`
  if(eq(get(opts, "values-only"), true), `${base}(valuesOnly=true)`, base)
}

used-range
meta {
    doc: """
    GET /worksheets/{sheet}/usedRange: the smallest range holding every used
    cell.

    **Example**

    ```hot
    used ::microsoft::excel::ranges/used-range("/Reports/Q3.xlsx", "Data")
    used.address

    // Skip cells that only have formatting, and trim the response
    ::microsoft::excel::ranges/used-range("/Reports/Q3.xlsx", "Data", {values-only: true, select: "address,values"})
    ```
    """
}
fn
(item: Any, sheet: Str): Map {
  used-range(item, sheet, {})
},
(item: Any, sheet: Str, opts: Map): Map {
  ::excel/fetch(used-range-path(item, sheet, opts), {}, opts)
}

update-range
meta {
    doc: """
    PATCH /worksheets/{sheet}/range(address='...'). `changes` holds
    `values`, `formulas` or `numberFormat`, each a grid matching the
    address's size.

    **Example**

    ```hot
    ::microsoft::excel::ranges/update-range("/Reports/Q3.xlsx", "Data", "A1:B1", {values: [["Name", "Score"]]})

    // Each field is a grid the size of the address
    ::microsoft::excel::ranges/update-range("/Reports/Q3.xlsx", "Data", "B2:B3", {numberFormat: [["0.00"], ["0.00"]]}, {session: "s1"})
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str, changes: Map): Map {
  update-range(item, sheet, address, changes, {})
},
(item: Any, sheet: Str, address: Str, changes: Map, opts: Map): Map {
  ::excel/call("PATCH", ::excel/range-path(item, sheet, address, opts), changes, opts)
}

write-grid
meta {no-doc: true}
fn (item: Any, sheet: Str, address: Str, field: Str, grid: Vec, opts: Map): Map {
  cond {
    all(grid, is-empty) => { {} }
    => {
      square ::records/rectangular(grid)
      target ::records/expand-address(address, length(square), length(first(square)))
      update-range(item, sheet, target, assoc({}, field, square), opts)
    }
  }
}

write-values
meta {
    doc: """
    Write a grid to a worksheet. `address` is a full range, or a single
    top-left cell that is expanded to the grid's size. Short rows are
    padded with null, which leaves those cells unchanged. An empty grid
    makes no call and returns `{}`.

    ```hot
    ::microsoft::excel::ranges/write-values("/Reports/Q3.xlsx", "Data", "B2", [["a", 1], ["b", 2]])
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str, grid: Vec): Map {
  write-grid(item, sheet, address, "values", grid, {})
},
(item: Any, sheet: Str, address: Str, grid: Vec, opts: Map): Map {
  write-grid(item, sheet, address, "values", grid, opts)
}

write-formulas
meta {
    doc: """
    Write a grid of formulas, addressed as in `write-values`.

    **Example**

    ```hot
    ::microsoft::excel::ranges/write-formulas("/Reports/Q3.xlsx", "Summary", "B2", [["=SUM(Data!C:C)"], ["=AVERAGE(Data!C:C)"]])
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str, grid: Vec): Map {
  write-grid(item, sheet, address, "formulas", grid, {})
},
(item: Any, sheet: Str, address: Str, grid: Vec, opts: Map): Map {
  write-grid(item, sheet, address, "formulas", grid, opts)
}

clear-body
meta {
    doc: """
    The `clear` body (pure): `opts.apply-to` is `All` (the default),
    `Formats` or `Contents`.

    **Example**

    ```hot
    ::microsoft::excel::ranges/clear-body({})  // {applyTo: "All"}
    ::microsoft::excel::ranges/clear-body({apply-to: "Contents"})  // {applyTo: "Contents"}
    ```
    """
}
fn (opts: Map): Map {
  {applyTo: get(opts, "apply-to", "All")}
}

clear-range
meta {
    doc: """
    POST /range(...)/clear. Clears values and formatting unless
    `opts.apply-to` is `Formats` or `Contents`.

    **Example**

    ```hot
    ::microsoft::excel::ranges/clear-range("/Reports/Q3.xlsx", "Data", "A2:C100")

    // Keep the formatting
    ::microsoft::excel::ranges/clear-range("/Reports/Q3.xlsx", "Data", "A2:C100", {apply-to: "Contents"})
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str): Map {
  clear-range(item, sheet, address, {})
},
(item: Any, sheet: Str, address: Str, opts: Map): Map {
  ::excel/call("POST", `${::excel/range-path(item, sheet, address, opts)}/clear`, clear-body(opts), opts)
}

insert-cells
meta {
    doc: """
    POST /range(...)/insert. Insert blank cells over `address`, moving
    existing cells `Down` or `Right`.

    **Example**

    ```hot
    // A blank row of three cells above the data
    ::microsoft::excel::ranges/insert-cells("/Reports/Q3.xlsx", "Data", "A2:C2", "Down")
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str, shift: Str): Map {
  insert-cells(item, sheet, address, shift, {})
},
(item: Any, sheet: Str, address: Str, shift: Str, opts: Map): Map {
  ::excel/call("POST", `${::excel/range-path(item, sheet, address, opts)}/insert`, {shift: shift}, opts)
}

delete-cells
meta {
    doc: """
    POST /range(...)/delete. Delete the cells at `address`, moving the rest
    `Up` or `Left`.

    **Example**

    ```hot
    // Remove three cells and close the gap
    ::microsoft::excel::ranges/delete-cells("/Reports/Q3.xlsx", "Data", "A2:C2", "Up")
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str, shift: Str): Map {
  delete-cells(item, sheet, address, shift, {})
},
(item: Any, sheet: Str, address: Str, shift: Str, opts: Map): Map {
  ::excel/call("POST", `${::excel/range-path(item, sheet, address, opts)}/delete`, {shift: shift}, opts)
}

read-records
meta {
    doc: """
    A worksheet as records, one Map per row keyed by the first row. Reads
    the used range unless `opts.address` names a range. Blank cells are
    null and fully blank rows are skipped.

    ```hot
    leads ::microsoft::excel::ranges/read-records("/Reports/Q3.xlsx", "Leads")
    ```
    """
}
fn
(item: Any, sheet: Str): Vec {
  read-records(item, sheet, {})
},
(item: Any, sheet: Str, opts: Map): Vec {
  address get(opts, "address")
  grid if(is-some(address),
    read-values(item, sheet, address, opts),
    read-used-values(item, sheet, opts))
  if(is-err(grid), grid, ::records/rows-to-records(grid))
}

read-used-values
meta {no-doc: true}
fn (item: Any, sheet: Str, opts: Map): Vec {
  result ::excel/fetch(used-range-path(item, sheet, {...opts, values-only: true}), {select: "values"}, ::excel/without-query(opts))
  if(is-err(result), result, or(get(result, "values"), []))
}

write-records
meta {
    doc: """
    Write records as a header row and data rows from a top-left cell.
    `columns` sets the order (default, or null: every key in order of
    first appearance). Missing values empty their cells. No records and
    no `columns` make no call.

    **Example**

    ```hot
    leads [{name: "Ada", stage: "demo"}, {name: "Grace", stage: "trial"}]
    ::microsoft::excel::ranges/write-records("/Reports/Q3.xlsx", "Pipeline", "A1", leads)

    // Choose the columns and their order
    ::microsoft::excel::ranges/write-records("/Reports/Q3.xlsx", "Pipeline", "A1", leads, ["stage", "name"])

    // With a session, keeping the default columns
    ::microsoft::excel::ranges/write-records("/Reports/Q3.xlsx", "Pipeline", "A1", leads, null, {session: "s1"})
    ```
    """
}
fn
(item: Any, sheet: Str, address: Str, records: Vec): Map {
  write-values(item, sheet, address, ::records/records-to-grid(records), {})
},
(item: Any, sheet: Str, address: Str, records: Vec, columns: Vec?): Map {
  write-records(item, sheet, address, records, columns, {})
},
(item: Any, sheet: Str, address: Str, records: Vec, columns: Vec?, opts: Map): Map {
  grid if(is-null(columns), ::records/records-to-grid(records), ::records/records-to-grid(records, columns))
  write-values(item, sheet, address, grid, opts)
}
