::discord::api ns
meta {
    ctx: {"discord.bot.token": {required: true}},
    doc: """
    Low-level Discord REST client shared by every module: request
    building (auth, User-Agent, audit-log reason, JSON or multipart
    bodies), body and query helpers that never send unset fields, and
    error handling that surfaces Discord's rate-limit `retry_after`.
    """
}

::ctx ::hot::ctx
::uri ::hot::uri

HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse
is-ok-response ::hot::http/is-ok-response

// ============================================================================
// Errors
// ============================================================================

HttpError
meta {
    doc: """
    A non-2xx Discord response. `body` is Discord's JSON error
    (`{code, message, errors?}`). On HTTP 429, `retry_after` holds the
    seconds to wait (from the body's `retry_after`, falling back to the
    `Retry-After` header), `global` says whether the global limit was hit,
    and `scope` is `X-RateLimit-Scope` (`user`, `global` or `shared`).

    **Example**

    ```hot
    result ::discord::messages/create-message(::discord::messages/CreateMessageRequest({
      channel_id: "1100000000000000000",
      content: "hi"
    }))
    if-err(result, (e) {
      if(::discord::api/is-rate-limited(e), `retry in ${e.retry_after}s`, e.body.message)
    })
    ```
    """
}
type {
    status: Int,
    headers: Map,
    body: Any,
    retry_after: Dec?,
    global: Bool?,
    scope: Str?
}

retry-after-header fn (headers: Map): Dec? {
  value get(headers, "retry-after")
  if(is-empty(or(value, "")), null, Dec(value))
}

error-from-response
meta {
    doc: """Build the `HttpError` for a non-2xx response, parsing rate-limit details on 429."""
}
fn (response: HttpResponse): HttpError {
  headers or(response.headers, {})
  body response.body
  limited eq(response.status, 429)
  from-body if(and(limited, is-map(body)), get(body, "retry_after"), null)
  HttpError({
    status: response.status,
    headers: headers,
    body: body,
    retry_after: if(limited, or(from-body, retry-after-header(headers)), null),
    global: if(and(limited, is-map(body)), get(body, "global"), null),
    scope: if(limited, get(headers, "x-ratelimit-scope"), null)
  })
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  error-from-response(response)
}

is-rate-limited
meta {
    doc: """True when `error` is a Discord 429. Wait `error.retry_after` seconds before retrying."""
}
fn (error: Any): Bool {
  and(is-map(error), eq(get(error, "status"), 429))
}

to-result
meta {
    doc: """Return the response body for a 2xx (`null` for 204 No Content), otherwise an `Err(HttpError)`. Exposed for testing; every endpoint uses it."""
}
fn (response: HttpResponse): Any {
  cond {
    eq(response.status, 204) => { null }
    is-ok-response(response) => { response.body }
    => { err(error-from-response(response)) }
  }
}

to-ok
meta {
    doc: """Return `true` for a 2xx response, otherwise an `Err(HttpError)`. Used by endpoints that return 204 No Content."""
}
fn (response: HttpResponse): Bool {
  if(is-ok-response(response), true, err(error-from-response(response)))
}

// ============================================================================
// Body, query and path helpers
// ============================================================================

// Request fields that steer the call rather than travel in the body.
CONTROL_KEYS ["reason", "clear", "files"]

body
meta {
    doc: """
    Build a JSON body from a request record. Drops the path parameters
    named in `path-keys`, the control fields (`reason`, `clear`, `files`),
    and every unset or null field: Discord reads JSON `null` as "clear
    this field", so an unset optional must never be sent.

    To clear a field on purpose, list it in the request's `clear` field:
    `clear: ["nick"]` sends `"nick": null` and wins over a value set for
    the same field.

    **Example**

    ```hot
    ::discord::api/body({guild_id: "1", user_id: "2", nick: "Ada", roles: null}, ["guild_id", "user_id"])
    // => {nick: "Ada"}

    ::discord::api/body({guild_id: "1", clear: ["communication_disabled_until"]}, ["guild_id"])
    // => {communication_disabled_until: null}
    ```
    """
}
fn (request: Any, path-keys: Vec<Str>): Map {
  data untype(request)
  skip concat(path-keys, CONTROL_KEYS)
  kept filter-vals(filter-keys(data, (k) { not(in(k, skip)) }), is-some)
  reduce(or(get(data, "clear"), []), (acc, k) { assoc(acc, k, null) }, kept)
}

query
meta {
    doc: """Build a `?a=1&b=2` query suffix from the non-null entries of `params` (URL-encoded); `""` when none are set."""
}
fn (params: Map): Str {
  ::uri/query-string(params)
}

seg
meta {
    doc: """URL-encode one path segment (ids, tokens, emoji)."""
}
fn (value: Any): Str {
  ::uri/encode(Str(value))
}

emoji-segment
meta {
    doc: """
    Encode a reaction emoji for the URL path. Pass a Unicode emoji as is
    (`"👍"`) or a custom emoji as `name:id`; already-encoded input
    (`"%F0%9F%91%8D"`) is passed through unchanged.
    """
}
fn (emoji: Str): Str {
  if(contains(emoji, "%"), emoji, ::uri/encode(emoji))
}

reason-headers
meta {
    doc: """`{X-Audit-Log-Reason: ...}` (URL-encoded, as Discord requires) when `reason` is set, otherwise `{}`."""
}
fn (reason: Any): Map {
  if(is-empty(or(reason, "")), {}, {X-Audit-Log-Reason: ::uri/encode(reason)})
}

// ============================================================================
// File uploads (multipart/form-data)
// ============================================================================

FileUpload
meta {
    doc: """
    A file to attach. `content` is the raw file (Bytes, e.g. from
    `::hot::file/read-file-bytes`, or text). `content_type` defaults from
    the filename's extension. `description` becomes the attachment's alt
    text.
    """
}
type {
    filename: Str,
    content: Bytes | Str,
    content_type: Str?,
    description: Str?
}

clean-filename fn (filename: Str): Str {
  filename |> replace("\"", "%22") |> replace("\r", "") |> replace("\n", "")
}

file-part fn (boundary: Str, index: Int, file: Map): Bytes {
  name clean-filename(file.filename)
  content-type or(get(file, "content_type"), or(::hot::mime/from-path(file.filename), "application/octet-stream"))
  content if(is-bytes(file.content), file.content, Bytes(file.content))
  concat(
    Bytes(`--${boundary}\r\nContent-Disposition: form-data; name="files[${index}]"; filename="${name}"\r\nContent-Type: ${content-type}\r\n\r\n`),
    content,
    Bytes("\r\n")
  )
}

attachments-for
meta {
    doc: """The `attachments` array describing `files` by index (`{id, filename, description?}`), for `payload_json`."""
}
fn (files: Vec<Map>): Vec<Map> {
  map-indexed(files, (i, f) {
    assoc-some({id: i, filename: f.filename}, "description", get(f, "description"))
  })
}

multipart-body
meta {
    doc: """
    Build a Discord `multipart/form-data` body: the JSON payload as
    `payload_json`, then each file as `files[n]`. Built as Bytes so binary
    content survives. Exposed for testing; endpoints that take `files` use it.
    """
}
fn (payload: Map, files: Vec<Map>, boundary: Str): Bytes {
  json-part Bytes(`--${boundary}\r\nContent-Disposition: form-data; name="payload_json"\r\nContent-Type: application/json\r\n\r\n${to-json(untype(payload))}\r\n`)
  parts map-indexed(files, (i, f) { file-part(boundary, i, f) })
  with-files reduce(parts, (acc, part) { concat(acc, part) }, json-part)
  concat(with-files, Bytes(`--${boundary}--\r\n`))
}

form-field fn (boundary: Str, name: Str, value: Any): Bytes {
  Bytes(`--${boundary}\r\nContent-Disposition: form-data; name="${name}"\r\n\r\n${value}\r\n`)
}

multipart-form
meta {
    doc: """
    Build a plain `multipart/form-data` body: one text part per non-null
    entry of `fields`, then `file` under the part name `file-field`. Used by
    endpoints that take form fields instead of `payload_json` (sticker
    upload).
    """
}
fn (fields: Map, file-field: Str, file: Map, boundary: Str): Bytes {
  parts map(keys(filter-vals(fields, is-some)), (k) { form-field(boundary, k, get(fields, k)) })
  head reduce(parts, (acc, part) { concat(acc, part) }, Bytes(""))
  name clean-filename(file.filename)
  content-type or(get(file, "content_type"), or(::hot::mime/from-path(file.filename), "application/octet-stream"))
  content if(is-bytes(file.content), file.content, Bytes(file.content))
  concat(
    head,
    Bytes(`--${boundary}\r\nContent-Disposition: form-data; name="${file-field}"; filename="${name}"\r\nContent-Type: ${content-type}\r\n\r\n`),
    content,
    Bytes(`\r\n--${boundary}--\r\n`)
  )
}

// ============================================================================
// Requests
// ============================================================================

bot-token fn (opts: Map): Str {
  token or(get(opts, "token"), ::ctx/get("discord.bot.token"))
  if(is-empty(or(token, "")),
    fail("discord.bot.token is not set. Add your bot token in Context Variables."),
    token)
}

build-request
meta {
    doc: """
    Build (without sending) the HttpRequest for `method` and `path`
    (relative to the API base URL). `opts`:
    - `query`: Map of query params; null entries are dropped
    - `body`: JSON body (sent as `payload_json` when `files` is set)
    - `files`: Vec of `FileUpload`; switches to multipart/form-data
    - `form`: `{fields, file_field, file}` for plain multipart forms (no `payload_json`)
    - `reason`: audit-log reason, sent as `X-Audit-Log-Reason`
    - `auth`: `false` for webhook-token and interaction routes, which take no bot token
    - `token`: explicit bot token instead of `discord.bot.token`
    - `boundary`: fixed multipart boundary (tests)

    **Example**

    ```hot
    req ::discord::api/build-request("GET", "/users/@me/guilds", {query: {limit: 10, after: null}, token: "test"})
    req.url  // => "https://discord.com/api/v10/users/@me/guilds?limit=10"
    ```
    """
}
fn (method: Str, path: Str, opts: Map): HttpRequest {
  files or(get(opts, "files"), [])
  payload get(opts, "body")
  auth-headers if(eq(get(opts, "auth"), false), {}, {Authorization: `Bot ${bot-token(opts)}`})
  boundary or(get(opts, "boundary"), `hot-discord-${Uuid()}`)

  encoded cond {
    is-some(get(opts, "form")) => {
      form get(opts, "form")
      {content-type: `multipart/form-data; boundary=${boundary}`, data: multipart-form(form.fields, form.file_field, form.file, boundary)}
    }

    not(is-empty(files)) => {
      {content-type: `multipart/form-data; boundary=${boundary}`, data: multipart-body(or(payload, {}), files, boundary)}
    }

    is-null(payload) => { {content-type: null, data: ""} }
    => { {content-type: "application/json", data: to-json(untype(payload))} }
  }

  headers {
    User-Agent: ::discord::core/USER_AGENT,
    ...auth-headers,
    ...reason-headers(get(opts, "reason")),
    ...or(get(opts, "headers"), {})
  }

  HttpRequest({
    method: method,
    url: `${::discord::core/BASE_URL}${path}${query(or(get(opts, "query"), {}))}`,
    headers: assoc-some(headers, "Content-Type", encoded.content-type),
    body: encoded.data
  })
}

call
meta {
    doc: """
    Send a request built by `build-request` and return the parsed body
    (`null` for 204), or an `Err(HttpError)` for non-2xx responses.

    **Example**

    ```hot
    me ::discord::api/call("GET", "/users/@me")
    guilds ::discord::api/call("GET", "/users/@me/guilds", {query: {limit: 50}})
    ```
    """
}
fn
(method: Str, path: Str): Any {
  call(method, path, {})
},
(method: Str, path: Str, opts: Map): Any {
  to-result(::hot::http/request(build-request(method, path, opts)))
}

call-ok
meta {
    doc: """Like `call`, but returns `true` on success. For endpoints that answer 204 No Content."""
}
fn
(method: Str, path: Str): Bool {
  call-ok(method, path, {})
},
(method: Str, path: Str, opts: Map): Bool {
  to-ok(::hot::http/request(build-request(method, path, opts)))
}

request
meta {
    doc: """
    Make an authenticated request to an absolute Discord API URL and
    return the raw HttpResponse. Adds the bot token (from
    `discord.bot.token` unless passed) and the User-Agent; Map/Vec bodies
    are sent as JSON and Bytes bodies as is (set Content-Type yourself).
    Prefer `call` for new code.

    **Example**

    ```hot
    ::api ::discord::api

    response ::api/request("GET", "https://discord.com/api/v10/users/@me")
    response ::api/request("POST", "https://discord.com/api/v10/channels/123/messages", {}, {content: "Hello"})
    response ::api/request("GET", "https://discord.com/api/v10/users/@me", {}, "", "my-bot-token")
    ```
    """
}
fn
(method: Str, url: Str): HttpResponse {
  request(method, url, {}, "")
},
(method: Str, url: Str, additional-headers: Map): HttpResponse {
  request(method, url, additional-headers, "")
},
(method: Str, url: Str, additional-headers: Map, body: Any): HttpResponse {
  request(method, url, additional-headers, body, bot-token({}))
},
(method: Str, url: Str, additional-headers: Map, body: Any, token: Str): HttpResponse {
  json-body and(not(eq(body, "")), not(is-bytes(body)))
  default-headers {
    Authorization: `Bot ${token}`,
    User-Agent: ::discord::core/USER_AGENT
  }

  headers if(json-body, {...default-headers, Content-Type: "application/json"}, default-headers)

  ::hot::http/request(HttpRequest({
    method,
    url,
    headers: {...headers, ...additional-headers},
    body: if(json-body, to-json(untype(body)), body)
  }))
}

// ============================================================================
// Pagination
// ============================================================================

paginate-loop fn (fetch: Fn, next-cursor: Fn, page-size: Int, max-items: Int, cursor: Any, acc: Vec): Vec {
  page fetch(cursor)
  all concat(acc, page)
  cond {
    is-empty(page) => { all }
    lt(length(page), page-size) => { slice(all, 0, min(length(all), max-items)) }
    gte(length(all), max-items) => { slice(all, 0, max-items) }
    => { paginate-loop(fetch, next-cursor, page-size, max-items, next-cursor(page), all) }
  }
}

paginate
meta {
    doc: """
    Collect cursor pages until a short page or `max-items`. `fetch` takes
    the cursor (`null` first) and returns one page (Vec); `next-cursor`
    takes that page and returns the next cursor. The module helpers
    (`::discord::guilds/list-all-guild-members`,
    `::discord::messages/get-message-history`, ...) are built on it.

    **Example**

    ```hot
    guilds ::discord::api/paginate(
      (after) { ::discord::api/call("GET", "/users/@me/guilds", {query: {limit: 200, after: after}}) },
      (page) { last(page).id },
      200,
      1000
    )
    ```
    """
}
fn (fetch: Fn, next-cursor: Fn, page-size: Int, max-items: Int): Vec {
  paginate-loop(fetch, next-cursor, page-size, max-items, null, [])
}
