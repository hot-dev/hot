::gemini::test::api ns
meta ["test"]

::api    ::gemini::api
::ctx    ::hot::ctx
::chat   ::gemini::chat
::models ::gemini::models
::files  ::gemini::files
::cached ::gemini::cachedcontents
::images ::gemini::images

// Port 1 refuses connections, so a call that resolved these opts fails at the
// connection, naming this URL, and no request leaves the machine.
OFFLINE {api-key: "tenant-key", base-url: "http://127.0.0.1:1"}

assert-reached-offline-url
meta {
    doc: """The call got as far as the HTTP layer, against the `base-url` from opts."""
}
fn (call: Fn, label: Str) {
    result ::hot::internal::exec/contain(call)
    assert(is-err(result), `${label}: a refused connection is an Err`)
    message Str(err-value(result))
    assert(contains(message, "http://127.0.0.1:1/"), `${label}: reached the opts base-url, got ${message}`)
    assert(not(contains(message, "tenant-key")), `${label}: the key is not in the URL or the error`)
}

// ============================================================================
// Resolver
// ============================================================================

CTX {"gemini.api.key": "ctx-key", "gemini.base.url": "https://ctx.example.com/"}

test-resolve-opts-override-ctx
meta ["test"] fn () {
    r ::api/resolve-from({api-key: "tenant-key", base-url: "https://opts.example.com"}, CTX)
    assert-eq("tenant-key", r.api-key)
    assert-eq("https://opts.example.com", r.base-url)
}

test-resolve-ctx-used-when-opts-empty
meta ["test"] fn () {
    r ::api/resolve-from({}, CTX)
    assert-eq("ctx-key", r.api-key)
    assert-eq("https://ctx.example.com", r.base-url, "the trailing slash is dropped")
}

test-resolve-defaults
meta ["test"] fn () {
    assert-eq("https://generativelanguage.googleapis.com", ::api/resolve-from({api-key: "k"}, {}).base-url)
}

test-resolve-blank-settings-fall-through
meta ["test"] fn () {
    assert-eq("https://ctx.example.com", ::api/resolve-from({base-url: ""}, CTX).base-url)
}

test-resolve-missing-key-is-a-clear-error
meta ["test"] fn () {
    r ::api/resolve-from({}, {})
    assert(is-err(r), "no key is an Err")
    assert(contains(err-value(r), "gemini.api.key"), "the error names the ctx key")
    assert(contains(err-value(r), "api-key"), "and the opts key")
}

test-resolve-live-ctx-and-no-ctx-writes
meta ["test"] fn () {
    before ::ctx/get("gemini.api.key")
    ::ctx/set("gemini.api.key", "ctx-live")
    assert-eq("ctx-live", ::api/resolve().api-key, "ctx is used when opts is empty")
    assert-eq("tenant-key", ::api/resolve({api-key: "tenant-key"}).api-key, "opts win over ctx")
    assert-eq("ctx-live", ::ctx/get("gemini.api.key"), "a per-call key is not written to ctx")
    ::ctx/set("gemini.api.key", before)
}

test-base-url
meta ["test"] fn () {
    assert-eq("https://gw.example.com", ::api/base-url({base-url: "https://gw.example.com/"}))
    assert-eq("https://generativelanguage.googleapis.com", ::api/normalize-base-url(null))
}

test-resolve-blank-opts-key-is-an-error-not-a-fallback
meta ["test"] fn () {
    for-each([null, "", "   "], (blank) {
        r ::api/resolve-from({api-key: blank}, CTX)
        assert(is-err(r), "a blank key in opts is an Err, with a ctx key available")
        assert(contains(err-value(r), "api-key"), "that names the opts key")
    })
}

test-resolve-blank-opts-key-does-not-use-live-ctx
meta ["test"] fn () {
    before ::ctx/get("gemini.api.key")
    ::ctx/set("gemini.api.key", "ctx-live")
    for-each([null, ""], (blank) {
        result ::hot::internal::exec/contain(() { ::api/resolve({api-key: blank}) })
        assert(is-err(result), "a blank key in opts is an Err")
        assert(not(contains(Str(err-value(result)), "ctx-live")), "the ctx key is not used or shown")
    })
    ::ctx/set("gemini.api.key", before)
}

test-typed-call-with-blank-key-sends-nothing
meta ["test"] fn () {
    before ::ctx/get("gemini.api.key")
    ::ctx/set("gemini.api.key", "ctx-live")
    result ::hot::internal::exec/contain(() { ::chat/chat("m", "hi", {api-key: "", base-url: "http://127.0.0.1:1"}) })
    assert(is-err(result), "a blank key in opts is an Err")
    assert(contains(Str(err-value(result)), "is blank"), `it stops at the resolver, got ${Str(err-value(result))}`)
    ::ctx/set("gemini.api.key", before)
}

test-resolve-opts-base-url-without-key-never-gets-the-ctx-key
meta ["test"] fn () {
    r ::api/resolve-from({base-url: "https://tenant.example.com"}, CTX)
    assert(is-err(r), "a per-call base URL without a per-call key is an Err, with a ctx key available")
    assert(contains(err-value(r), "base-url"), "that names base-url")
    assert(contains(err-value(r), "api-key"), "and api-key")
    assert(not(contains(err-value(r), "ctx-key")), "and doesn't show the ctx key's value")
    with-key ::api/resolve-from({base-url: "https://tenant.example.com", api-key: "tenant-key"}, CTX)
    assert-eq("tenant-key", with-key.api-key, "with both in opts it works")
    assert-eq("https://tenant.example.com", with-key.base-url)
}

test-ctx-base-url-with-ctx-key-still-works
meta ["test"] fn () {
    r ::api/resolve-from({}, CTX)
    assert-eq("ctx-key", r.api-key)
    assert-eq("https://ctx.example.com", r.base-url)
}

test-typed-call-with-base-url-and-no-key-sends-nothing
meta ["test"] fn () {
    before ::ctx/get("gemini.api.key")
    ::ctx/set("gemini.api.key", "ctx-live")
    result ::hot::internal::exec/contain(() { ::chat/chat("m", "hi", {base-url: "http://127.0.0.1:1"}) })
    assert(is-err(result), "a per-call base URL without a per-call key is an Err")
    text Str(err-value(result))
    assert(contains(text, "needs api-key"), `it stops at the resolver, got ${text}`)
    assert(not(contains(text, "127.0.0.1")), "before any connection")
    ::ctx/set("gemini.api.key", before)
}

// ============================================================================
// Outgoing request
// ============================================================================

test-explicit-key-reaches-request-headers
meta ["test"] fn () {
    resolved ::api/resolve-from({api-key: "tenant-key"}, CTX)
    req ::api/build-request("POST", "https://x/v1/models/m:generateContent", {}, {contents: []}, resolved)
    assert-eq("tenant-key", get(req.headers, "x-goog-api-key"))
    assert-eq("application/json", get(req.headers, "Content-Type"))
    assert-eq("POST", req.method)
    assert-eq({contents: []}, from-json(req.body))
}

test-key-stays-out-of-the-url
meta ["test"] fn () {
    resolved ::api/resolve-from({api-key: "tenant-key"}, {})
    req ::api/build-request("GET", "https://x/v1/models?pageSize=1", {}, "", resolved)
    assert-eq("https://x/v1/models?pageSize=1", req.url)
}

test-empty-body-sends-no-body
meta ["test"] fn () {
    resolved ::api/resolve-from({api-key: "k"}, {})
    req ::api/build-request("GET", "https://x", {x-extra: "1"}, "", resolved)
    assert(is-null(req.body), "no body for an empty string")
    assert(not(in("Content-Type", keys(req.headers))), "and no Content-Type")
    assert-eq("1", get(req.headers, "x-extra"))
}

// ============================================================================
// The opts arity reaches the request, without ctx
// ============================================================================

REQUEST ::chat/GenerateContentRequest({contents: [::chat/user-content("hi")]})

test-existing-explicit-key-arity-still-works
meta ["test"] fn () {
    assert-reached-offline-url(() { ::api/request("GET", "http://127.0.0.1:1/v1/models", {}, "", "tenant-key") }, "request 5-arity key")
    assert-reached-offline-url(() { ::api/request("GET", "http://127.0.0.1:1/v1/models", {}, "", {api-key: "tenant-key"}) }, "request 5-arity opts")
    assert-reached-offline-url(() { ::api/request-stream("POST", "http://127.0.0.1:1/v1/x", {}, {a: 1}, "sse", "tenant-key") }, "request-stream 6-arity key")
}

test-opts-reach-chat
meta ["test"] fn () {
    assert-reached-offline-url(() { ::chat/generate("m", REQUEST, OFFLINE) }, "generate")
    assert-reached-offline-url(() { ::chat/generate-stream("m", REQUEST, OFFLINE) }, "generate-stream")
    assert-reached-offline-url(() { ::chat/chat("m", "hi", OFFLINE) }, "chat")
    assert-reached-offline-url(() { ::chat/chat("m", "hi", "be brief", OFFLINE) }, "chat system")
    assert-reached-offline-url(() { ::chat/chat("m", "hi", null, 5, OFFLINE) }, "chat max-tokens")
}

test-opts-reach-models
meta ["test"] fn () {
    assert-reached-offline-url(() { ::models/list(::models/ModelsListRequest({page-size: "1", page-token: ""}), OFFLINE) }, "list")
    assert-reached-offline-url(() { ::models/get(::models/ModelsGetRequest({model: "m"}), OFFLINE) }, "get")
    assert-reached-offline-url(() { ::models/generate-content("m", ::models/ModelsGenerateContentRequest({contents: []}), OFFLINE) }, "generate-content")
    assert-reached-offline-url(() { ::models/stream-generate-content("m", "sse", ::models/ModelsStreamGenerateContentRequest({contents: []}), OFFLINE) }, "stream-generate-content")
    assert-reached-offline-url(() { ::models/count-tokens("m", ::models/ModelsCountTokensRequest({contents: []}), OFFLINE) }, "count-tokens")
    assert-reached-offline-url(() { ::models/embed-content("m", ::models/ModelsEmbedContentRequest({content: {parts: []}}), OFFLINE) }, "embed-content")
    assert-reached-offline-url(() { ::models/batch-embed-contents("m", ::models/ModelsBatchEmbedContentsRequest({requests: []}), OFFLINE) }, "batch-embed-contents")
}

test-opts-reach-files
meta ["test"] fn () {
    assert-reached-offline-url(() { ::files/list(::files/FilesListRequest({page-size: "1", page-token: ""}), OFFLINE) }, "list")
    assert-reached-offline-url(() { ::files/get(::files/FilesGetRequest({name: "files/1"}), OFFLINE) }, "get")
    assert-reached-offline-url(() { ::files/delete(::files/FilesDeleteRequest({name: "files/1"}), OFFLINE) }, "delete")
    assert-reached-offline-url(() { ::files/upload(::files/FilesUploadRequest({}), OFFLINE) }, "upload")
}

test-opts-reach-cached-contents
meta ["test"] fn () {
    assert-reached-offline-url(() { ::cached/list(::cached/CachedContentsListRequest({page-size: "1", page-token: ""}), OFFLINE) }, "list")
    assert-reached-offline-url(() { ::cached/get(::cached/CachedContentsGetRequest({name: "cachedContents/1"}), OFFLINE) }, "get")
    assert-reached-offline-url(() { ::cached/delete(::cached/CachedContentsDeleteRequest({name: "cachedContents/1"}), OFFLINE) }, "delete")
}

test-opts-reach-images
meta ["test"] fn () {
    request ::images/GenerateImageRequest({prompt: "p"})
    assert-reached-offline-url(() { ::images/generate(request, OFFLINE) }, "generate")
    assert-reached-offline-url(() { ::images/generate-to-file("/nonexistent/x.png", "p", OFFLINE) }, "generate-to-file prompt")
    assert-reached-offline-url(() { ::images/generate-to-file("/nonexistent/x.png", request, OFFLINE) }, "generate-to-file request")
    assert-reached-offline-url(() { ::images/generate-batch-to-files("/nonexistent", request, OFFLINE) }, "generate-batch-to-files")
    assert-reached-offline-url(() { ::images/generate-inline("p", OFFLINE) }, "generate-inline")
    assert-reached-offline-url(() { ::images/generate-inline-to-file("/nonexistent/x.png", "p", OFFLINE) }, "generate-inline-to-file")
}

test-opts-arity-without-a-key-fails-clearly
meta ["test"] fn () {
    before ::ctx/get("gemini.api.key")
    ::ctx/set("gemini.api.key", null)
    result ::hot::internal::exec/contain(() { ::chat/generate("m", REQUEST, {}) })
    assert(is-err(result), "no key anywhere is an Err")
    assert(contains(Str(err-value(result)), "gemini.api.key"), "that names the ctx key")
    ::ctx/set("gemini.api.key", before)
}

test-resolve-marks-the-opts-credential-and-returns-it-unchanged
meta ["test"] fn () {
    assert-eq("tenant-credential-a", ::api/resolve({api-key: "tenant-credential-a"}).api-key)
}
