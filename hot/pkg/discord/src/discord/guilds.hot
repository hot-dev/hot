(request: ModifyGuildRolePositionsRequest): Vec<Map> {
  modify-guild-role-positions(request, {})
},
(request: ModifyGuildRolePositionsRequest, opts: Map): Vec<Map> {
  ::api/call("PATCH", `/guilds/${seg(request.guild_id)}/roles`, {
    body: map(request.positions, (p) { ::api/body(p, []) }),
    reason: request.reason
