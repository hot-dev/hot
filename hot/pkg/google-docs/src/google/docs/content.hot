::google::docs::content ns
meta {
    doc: """
    Pure readers over a document from `get-document`: tabs, plain text,
    paragraphs, headings, tables and the body's end index. Each reader
    takes a whole document, in which case it covers every tab when the
    document was fetched with `includeTabsContent`.
    """
}

// ---------------------------------------------------------------------------
// Tabs
// ---------------------------------------------------------------------------

flatten-tabs
meta {no-doc: true}
fn (tabs: Any): Vec {
  mapcat(or(tabs, []), (tab) { concat([tab], flatten-tabs(get(tab, "childTabs"))) })
}

all-tabs
meta {
    doc: """
    Every tab of a document fetched with `includeTabsContent`, parents
    before their children, in tab order. Empty for a document fetched
    without it.

    **Example**

    ```hot
    doc {tabs: [{
      tabProperties: {tabId: "t.0", title: "Notes"},
      childTabs: [{tabProperties: {tabId: "t.1", title: "Draft"}}]
    }]}
    map(::google::docs::content/all-tabs(doc), %.tabProperties.title)  // ["Notes", "Draft"]
    ```
    """
}
fn (doc: Map): Vec {
  flatten-tabs(get(doc, "tabs"))
}

tab-id
meta {
    doc: """
    A tab's id, or null. Pass it as `tabId` in the options of `read-text`
    and the `::google::docs::requests` builders.

    **Example**

    ```hot
    ::google::docs::content/tab-id({tabProperties: {tabId: "t.0", title: "Notes"}})  // "t.0"
    ```
    """
}
fn (tab: Map): Str? {
  get-in(tab, ["tabProperties", "tabId"])
}

tab-title
meta {
    doc: """
    A tab's title, or null.

    **Example**

    ```hot
    ::google::docs::content/tab-title({tabProperties: {tabId: "t.0", title: "Notes"}})  // "Notes"
    ```
    """
}
fn (tab: Map): Str? {
  get-in(tab, ["tabProperties", "title"])
}

find-tab
meta {
    doc: """
    The tab with this id, or else this title, or null.

    **Example**

    ```hot
    doc {tabs: [{
      tabProperties: {tabId: "t.0", title: "Notes"},
      childTabs: [{tabProperties: {tabId: "t.1", title: "Draft"}}]
    }]}
    ::google::docs::content/tab-id(::google::docs::content/find-tab(doc, "Draft"))  // "t.1"
    ::google::docs::content/find-tab(doc, "Missing")  // null
    ```
    """
}
fn (doc: Map, id-or-title: Str): Map? {
  tabs all-tabs(doc)
  by-id find-first(tabs, (t) { eq(tab-id(t), id-or-title) })
  if(is-some(by-id), by-id, find-first(tabs, (t) { eq(tab-title(t), id-or-title) }))
}

tab-body
meta {
    doc: """
    A tab's `Body`, or null.

    **Example**

    ```hot
    ::google::docs::content/tab-body({documentTab: {body: {content: []}}})  // {content: []}
    ```
    """
}
fn (tab: Map): Map? {
  get-in(tab, ["documentTab", "body"])
}

bodies
meta {
    doc: """
    Every `Body` in a document: one per tab when it was fetched with
    `includeTabsContent`, otherwise its single `body`. Pass each to
    `body-text`, `body-paragraphs` or `body-tables`.

    **Example**

    ```hot
    ::google::docs::content/bodies({body: {content: []}})  // [{content: []}]
    ```
    """
}
fn (doc: Map): Vec {
  tabs all-tabs(doc)
  found if(is-empty(tabs), [get(doc, "body")], map(tabs, tab-body))
  filter(found, is-some)
}

// ---------------------------------------------------------------------------
// Text
// ---------------------------------------------------------------------------

paragraph-text
meta {
    doc: """
    A Paragraph's text: its text runs and auto text joined, with the
    trailing newline Docs stores.

    **Example**

    ```hot
    ::google::docs::content/paragraph-text({elements: [
      {textRun: {content: "Hello "}},
      {textRun: {content: "world\n"}}
    ]})  // "Hello world\n"
    ```
    """
}
fn (paragraph: Map): Str {
  join(map(or(get(paragraph, "elements"), []), (e) {
    or(get-in(e, ["textRun", "content"]), get-in(e, ["autoText", "content"]), "")
  }), "")
}

content-text
meta {
    doc: """
    The text of a Vec of StructuralElements, descending into tables and
    tables of contents.

    **Example**

    ```hot
    ::google::docs::content/content-text([
      {paragraph: {elements: [{textRun: {content: "One\n"}}]}},
      {paragraph: {elements: [{textRun: {content: "Two\n"}}]}}
    ])  // "One\nTwo\n"
    ```
    """
}
fn (content: Any): Str {
  join(map(or(content, []), element-text), "")
}

element-text
meta {
    doc: """
    A StructuralElement's text. Table cells end with the newline of their
    last paragraph, so cells read one per line.

    **Example**

    ```hot
    ::google::docs::content/element-text({paragraph: {elements: [{textRun: {content: "Hi\n"}}]}})  // "Hi\n"
    ::google::docs::content/element-text({sectionBreak: {}})  // ""
    ```
    """
}
fn cond (element: Map): Str {
  is-some(get(element, "paragraph")) => { paragraph-text(element.paragraph) }
  is-some(get(element, "table")) => {
    join(map(or(element.table.tableRows, []), (row) {
      join(map(or(row.tableCells, []), (cell) { content-text(cell.content) }), "")
    }), "")
  }

  is-some(get(element, "tableOfContents")) => { content-text(element.tableOfContents.content) }
  => { "" }
}

body-text
meta {
    doc: """
    A `Body`'s text.

    **Example**

    ```hot
    body {content: [
      {paragraph: {elements: [{textRun: {content: "Hello\n"}}]}},
      {paragraph: {elements: [{textRun: {content: "World\n"}}]}}
    ]}
    ::google::docs::content/body-text(body)  // "Hello\nWorld\n"
    ```
    """
}
fn (body: Map): Str {
  content-text(get(body, "content"))
}

tab-text
meta {
    doc: """
    A tab's body text, empty when the tab has no body.

    **Example**

    ```hot
    ::google::docs::content/tab-text({documentTab: {body: {content: [
      {paragraph: {elements: [{textRun: {content: "Hi\n"}}]}}
    ]}}})  // "Hi\n"
    ::google::docs::content/tab-text({})  // ""
    ```
    """
}
fn (tab: Map): Str {
  body tab-body(tab)
  if(is-null(body), "", body-text(body))
}

document-text
meta {
    doc: """
    The whole document's body text, tab after tab.

    **Example**

    ```hot
    doc {tabs: [{tabProperties: {tabId: "t.0", title: "Notes"}, documentTab: {body: {content: [
      {paragraph: {elements: [{textRun: {content: "Hello\n"}}]}}
    ]}}}]}
    ::google::docs::content/document-text(doc)  // "Hello\n"
    ```
    """
}
fn (doc: Map): Str {
  join(map(bodies(doc), body-text), "")
}

// ---------------------------------------------------------------------------
// Structure
// ---------------------------------------------------------------------------

strip-newline
meta {no-doc: true}
fn (s: Str): Str {
  if(ends-with(s, "\n"), slice(s, 0, sub(length(s), 1)), s)
}

paragraph-record
meta {no-doc: true}
fn (element: Map): Map {
  style get-in(element, ["paragraph", "paragraphStyle", "namedStyleType"])
  {
    text: strip-newline(paragraph-text(element.paragraph)),
    style: style,
    start: get(element, "startIndex", 0),
    end: get(element, "endIndex", 0),
    bullet: is-some(get(element.paragraph, "bullet"))
  }
}

body-paragraphs
meta {
    doc: """
    A `Body`'s top-level paragraphs, in the shape `paragraphs` returns. Use
    it to read one tab; `paragraphs` covers the whole document.

    **Example**

    ```hot
    body {content: [{startIndex: 1, endIndex: 4, paragraph: {elements: [{textRun: {content: "Hi\n"}}]}}]}
    first(::google::docs::content/body-paragraphs(body)).text  // "Hi"
    ```
    """
}
fn (body: Map): Vec {
  elements filter(or(get(body, "content"), []), (e) { is-some(get(e, "paragraph")) })
  map(elements, paragraph-record)
}

paragraphs
meta {
    doc: """
    Top-level paragraphs as `{text, style, start, end, bullet}`: `text` has
    no trailing newline, `style` is the `namedStyleType` (e.g.
    `"HEADING_1"`), and `start` and `end` are the indexes to pass to
    `::google::docs::requests`. Paragraphs inside tables are not included.

    **Example**

    ```hot
    doc {body: {content: [
      {startIndex: 1, endIndex: 7, paragraph: {
        elements: [{textRun: {content: "Title\n"}}],
        paragraphStyle: {namedStyleType: "HEADING_1"}
      }}
    ]}}
    ::google::docs::content/paragraphs(doc)  // [{text: "Title", style: "HEADING_1", start: 1, end: 7, bullet: false}]
    ```
    """
}
fn (doc: Map): Vec {
  mapcat(bodies(doc), body-paragraphs)
}

is-heading
meta {no-doc: true}
fn (style: Any): Bool {
  and(is-str(style), or(starts-with(style, "HEADING_"), eq(style, "TITLE"), eq(style, "SUBTITLE")))
}

headings
meta {
    doc: """
    The paragraphs styled as `TITLE`, `SUBTITLE` or `HEADING_1` to
    `HEADING_6`, in the shape of `paragraphs`.

    **Example**

    ```hot
    doc {body: {content: [
      {startIndex: 1, endIndex: 7, paragraph: {
        elements: [{textRun: {content: "Title\n"}}],
        paragraphStyle: {namedStyleType: "HEADING_1"}
      }}
    ]}}
    map(::google::docs::content/headings(doc), %.text)  // ["Title"]
    ```
    """
}
fn (doc: Map): Vec {
  filter(paragraphs(doc), (p) { is-heading(p.style) })
}

table-grid
meta {no-doc: true}
fn (table: Map): Vec {
  map(or(get(table, "tableRows"), []), (row) {
    map(or(get(row, "tableCells"), []), (cell) { strip-newline(content-text(get(cell, "content"))) })
  })
}

body-tables
meta {
    doc: """
    A `Body`'s top-level tables, in the shape `tables` returns. Use it to
    read one tab; `tables` covers the whole document.

    **Example**

    ```hot
    body {content: [{startIndex: 2, endIndex: 5, table: {tableRows: []}}]}
    ::google::docs::content/body-tables(body)  // [{start: 2, end: 5, rows: []}]
    ```
    """
}
fn (body: Map): Vec {
  elements filter(or(get(body, "content"), []), (e) { is-some(get(e, "table")) })
  map(elements, (e) { {start: get(e, "startIndex", 0), end: get(e, "endIndex", 0), rows: table-grid(e.table)} })
}

tables
meta {
    doc: """
    Top-level tables as `{start, end, rows}`, with `rows` a Vec of rows of
    cell text. `start` is the table start index that
    `::google::docs::requests` table builders take.

    **Example**

    ```hot
    doc {body: {content: [{startIndex: 2, endIndex: 12, table: {tableRows: [{tableCells: [
      {content: [{paragraph: {elements: [{textRun: {content: "a\n"}}]}}]},
      {content: [{paragraph: {elements: [{textRun: {content: "b\n"}}]}}]}
    ]}]}}]}}
    ::google::docs::content/tables(doc)  // [{start: 2, end: 12, rows: [["a", "b"]]}]
    ```
    """
}
fn (doc: Map): Vec {
  mapcat(bodies(doc), body-tables)
}

end-index
meta {
    doc: """
    The index just past a `Body`'s last element. A body always ends with
    a newline that cannot be deleted, so the last insertable index is
    `sub(end-index(body), 1)`.

    **Example**

    ```hot
    ::google::docs::content/end-index({content: [{startIndex: 1, endIndex: 12}]})  // 12
    ::google::docs::content/end-index({content: []})  // 1
    ```
    """
}
fn (body: Map): Int {
  content or(get(body, "content"), [])
  if(is-empty(content), 1, get(last(content), "endIndex", 1))
}
