::stripe::events ns
meta {
    doc: """Events: the log of every change on the account, as delivered by webhooks. See https://docs.stripe.com/api/events."""
}

api-call ::stripe::api/call
seg ::stripe::api/encode-id

// ============================================================================
// Events
// ============================================================================
// Stripe records every change to your account as an Event. Webhooks deliver
// events in near real-time; this API lets you list or re-fetch them.

get-event
meta {
    doc: """
    GET /v1/events/{id} - Retrieve an event by ID. Useful for re-fetching an
    event referenced by a webhook to confirm its authenticity.

    **Example**

    ```hot
    ::events ::stripe::events

    event ::events/get-event("evt_123")
    event.type
    event.data.object
    ```
    """
}
fn
(event: Str): Map {
  get-event(event, {})
},
(event: Str, opts: Map): Map {
  api-call("GET", `/v1/events/${seg(event)}`, "", opts)
}

ListEventsRequest type {
  type: Str?,
  types: Vec<Str>?,
  created: Any?,
  delivery_success: Bool?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-events
meta {
    doc: """
GET /v1/events - List events from the last 30 days, most recent first. Filter by a single `type` (supports `*` wildcards, e.g. "invoice.*") or a list of `types`.

**Example**

```hot
::events ::stripe::events

page ::events/list-events(::events/ListEventsRequest({type: "payment_intent.succeeded", limit: 10}))
page.data[0].data.object  // => the PaymentIntent
```
"""
}
fn
(): Map {
  list-events(ListEventsRequest({}))
},
(request: ListEventsRequest): Map {
  list-events(request, {})
},
(request: ListEventsRequest, opts: Map): Map {
  api-call("GET", "/v1/events", request, opts)
}
