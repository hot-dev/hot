::xero::reports ns
meta {
    doc: """
    Xero reports, plus `flatten-report`, which turns a report's sections
    into flat records an agent or a spreadsheet can use.

    Each report takes Xero's own parameters: `fromDate` / `toDate` /
    `date` (`YYYY-MM-DD`), `periods` and `timeframe` (`MONTH`,
    `QUARTER`, `YEAR`) for comparisons, `trackingCategoryID` /
    `trackingOptionID`, `standardLayout`, `paymentsOnly` (cash basis).
    Null values are dropped. Reports need the granular report scopes
    (`accounting.reports.profitandloss.read`, ...) or, for apps created
    before 2 March 2026, `accounting.reports.read`.

    ```hot
    ::r ::xero::reports

    pnl ::r/profit-and-loss({fromDate: "2026-07-01", toDate: "2026-09-30"})
    rows ::r/flatten-report(pnl)
    net find-first(rows, (row) { eq(row.label, "Net Profit") })
    ```
    """
}

::api ::xero::api
::re ::hot::regex

is-blank ::xero::oauth/is-blank

REPORTS [
  "ProfitAndLoss",
  "BalanceSheet",
  "TrialBalance",
  "AgedReceivablesByContact",
  "AgedPayablesByContact",
  "BankSummary",
  "ExecutiveSummary",
  "BudgetSummary"
]

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

check-name fn (name: Str): Str {
  cond {
    ::re/is-match(name, "^[A-Za-z]{2,64}$") => { name }
    => { err(`xero: invalid report name '${name}'`) }
  }
}

run-report
meta {
    doc: """GET /Reports/{name} with `params`. Returns the first report (`ReportName`, `ReportTitles`, `ReportDate`, `Rows`, ...). Use `flatten-report` for records."""
}
fn
(name: Str): Map {
  run-report(name, {}, {})
},
(name: Str, params: Map): Map {
  run-report(name, params, {})
},
(name: Str, params: Map, opts: Map): Map {
  checked check-name(name)
  cond {
    is-err(checked) => { checked }
    => {
      body ::api/json("GET", `/Reports/${checked}`, filter-vals(untype(params), is-some), "", opts)
      reports if(and(not(is-err(body)), is-map(body)), or(get(body, "Reports"), []), [])
      cond {
        is-err(body) => { body }
        is-empty(reports) => { err(`xero: no ${checked} report returned`) }
        => { first(reports) }
      }
    }
  }
}

profit-and-loss
meta {
    doc: """The ProfitAndLoss report. Params: `fromDate`, `toDate`, `periods`, `timeframe`, `trackingCategoryID`, `trackingOptionID`, `standardLayout`, `paymentsOnly`."""
}
fn
(params: Map): Map {
  run-report("ProfitAndLoss", params, {})
},
(params: Map, opts: Map): Map {
  run-report("ProfitAndLoss", params, opts)
}

