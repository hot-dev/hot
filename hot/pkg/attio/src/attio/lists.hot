::attio::lists ns

::api ::attio::api

list-lists
meta {
    doc: """
    GET /lists - The workspace's lists (pipelines, curated collections).

    **Example**

    ```hot
    lists ::attio::lists/list-lists()
    map(lists.data, %.api_slug)
    ```
    """
}
fn
(): Map {
  list-lists({})
},
(opts: Map): Map {
  ::api/json("GET", "/lists", "", opts)
}

add-entry
meta {
    doc: """
    POST /lists/{list}/entries - Add a record to a list. `entry-values`
    (3-arity) sets list-specific attributes (e.g. a pipeline stage).

    **Example**

    ```hot
    ::attio::lists/add-entry("sales-pipeline", {
      parent_object: "companies",
      parent_record_id: "7f4e2a10-3b9c-4d2a-8f1e-6a5c9d0b1e23"
    })
    ```
    """
}
fn
(list: Str, parent: Map): Map {
  add-entry(list, parent, {})
},
(list: Str, parent: Map, entry-values: Map): Map {
  add-entry(list, parent, entry-values, {})
},
(list: Str, parent: Map, entry-values: Map, opts: Map): Map {
  out ::api/json("POST", `/lists/${list}/entries`, {
    data: {
      parent_object: parent.parent_object,
      parent_record_id: parent.parent_record_id,
      entry_values: entry-values
    }
  }, opts)
  match out {
    Result.Err => { err(out) }

    _ => { out.data }
  }
}

query-entries
meta {
    doc: """
    POST /lists/{list}/entries/query - Query a list's entries
    (filter/sorts/limit/offset like record queries).

    **Example**

    ```hot
    page ::attio::lists/query-entries("sales-pipeline", {limit: 50})
    page.data
    ```
    """
}
fn
(list: Str): Map {
  query-entries(list, {})
},
(list: Str, options: Map): Map {
  query-entries(list, options, {})
},
(list: Str, options: Map, opts: Map): Map {
  ::api/json("POST", `/lists/${list}/entries/query`, options, opts)
}

delete-entry
meta {
    doc: """
    DELETE /lists/{list}/entries/{id} - Remove an entry from a list (the
    parent record is untouched).

    **Example**

    ```hot
    ::attio::lists/delete-entry("sales-pipeline", "c2d8e4f1-5a6b-47c9-b0d3-1e2f3a4b5c6d")
    ```
    """
}
fn
(list: Str, entry-id: Str): Any {
  delete-entry(list, entry-id, {})
},
(list: Str, entry-id: Str, opts: Map): Any {
  ::api/json("DELETE", `/lists/${list}/entries/${entry-id}`, "", opts)
}
