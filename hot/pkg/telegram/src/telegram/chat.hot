  chat_id: Any,
  message_id: Int?,
  business_connection_id: Str?
}

unpin-chat-message
meta {
    doc: """
    unpinChatMessage - Unpin a message. If `message_id` is not specified,
    the most recent pinned message is unpinned.

    **Example**

    ```hot
    ::chat ::telegram::chat

    ::chat/unpin-chat-message(::chat/UnpinChatMessageRequest({
      chat_id: -1001234567890,
      message_id: 42
    }))
    ```
    """
}
fn
(request: UnpinChatMessageRequest): Bool {
  unpin-chat-message(request, {})
},
(request: UnpinChatMessageRequest, opts: Map): Bool {
  api-request("unpinChatMessage", untype(request), opts)
}

