::elevenlabs::voices ns
meta {
    doc: """ElevenLabs voices: list and search the voices on your account, and read one voice's metadata and settings."""
}

::api ::elevenlabs::api

list-voices
meta {
    ctx: {"elevenlabs.api.key": {required: false}},
    doc: """
    GET /v2/voices: the voices available to your account (premade,
    cloned, generated, and saved library voices). Returns `{voices,
    has_more, total_count, next_page_token}`. `options` are query
    params: `page_size` (default 10, max 100), `next_page_token`,
    `search`, `sort` ("created_at_unix" or "name"), `sort_direction`,
    `voice_type` ("personal", "community", "default", ...),
    `category` ("premade", "cloned", "generated", "professional"),
    `voice_ids` (Vec).

    **Example**

    ```hot
    page ::elevenlabs::voices/list-voices({page_size: 50})
    map(page.voices, (v) { {id: v.voice_id, name: v.name} })
    ```
    """
}
fn
(): Map {
  list-voices({})
},
(options: Map): Map {
  list-voices(options, {})
},
(options: Map, opts: Map): Map {
  ::api/json("GET", `/v2/voices${::api/query-string(options)}`, {}, "", opts)
}

search-voices
meta {
    ctx: {"elevenlabs.api.key": {required: false}},
    doc: """
    GET /v2/voices?search=: search your voices by name, description, labels,
    or category.

    **Example**

    ```hot
    found ::elevenlabs::voices/search-voices("narrator")
    map(found.voices, (v) { v.voice_id })
    ```
    """
}
fn
(search: Str): Map {
  search-voices(search, {})
},
(search: Str, opts: Map): Map {
  list-voices({search: search}, opts)
}

get-voice
meta {
    ctx: {"elevenlabs.api.key": {required: false}},
    doc: """
    GET /v1/voices/{voice_id}: one voice's metadata, labels, preview URL,
    and settings.

    **Example**

    ```hot
    voice ::elevenlabs::voices/get-voice(::elevenlabs/GEORGE_VOICE_ID)
    voice.preview_url
    ```
    """
}
fn
(voice-id: Str): Map {
  get-voice(voice-id, {})
},
(voice-id: Str, opts: Map): Map {
  ::api/json("GET", `/v1/voices/${::api/path-segment(voice-id)}`, {}, "", opts)
}

get-voice-settings
meta {
    ctx: {"elevenlabs.api.key": {required: false}},
    doc: """
    GET /v1/voices/{voice_id}/settings: the voice's saved settings
    (`stability`, `similarity_boost`, `style`, `use_speaker_boost`,
    `speed`).

    **Example**

    ```hot
    settings ::elevenlabs::voices/get-voice-settings(::elevenlabs/GEORGE_VOICE_ID)
    settings.stability
    ```
    """
}
fn
(voice-id: Str): Map {
  get-voice-settings(voice-id, {})
},
(voice-id: Str, opts: Map): Map {
  ::api/json("GET", `/v1/voices/${::api/path-segment(voice-id)}/settings`, {}, "", opts)
}

get-default-voice-settings
meta {
    ctx: {"elevenlabs.api.key": {required: false}},
    doc: """
    GET /v1/voices/settings/default: the default voice settings, a starting
    point for tuning.

    **Example**

    ```hot
    defaults ::elevenlabs::voices/get-default-voice-settings()
    ::elevenlabs::tts/TextToSpeechRequest({text: "Hello.", voice_settings: {...defaults, stability: 0.3}})
    ```
    """
}
fn
(): Map {
  get-default-voice-settings({})
},
(opts: Map): Map {
  ::api/json("GET", "/v1/voices/settings/default", {}, "", opts)
}
