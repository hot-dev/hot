// ============================================================================
// OAuth
// ============================================================================

OauthV2AccessRequest type {
  client_id: Str,
  client_secret: Str,
  code: Str,
  redirect_uri: Str?
}

OauthV2AccessResponse type {
  ok: Bool?,
  error: Str?,
  access_token: Str?,
  token_type: Str?,
  scope: Str?,
  bot_user_id: Str?,
  app_id: Str?,
  team: Map?,
  authed_user: Map?,
  enterprise: Map?,
  is_enterprise_install: Bool?
}


oauth-v2-access
meta {
    doc: """
    POST /oauth.v2.access - Exchange a temporary OAuth verifier code for an
    access token. Used during the OAuth 2.0 flow to complete app
    installation. The client secret and the tokens returned are masked in
    the run's call records.

    **Example**

    ```hot
    // `code` comes from the OAuth redirect
    response ::slack::misc/oauth-v2-access(::slack::misc/OauthV2AccessRequest({
      client_id: ::hot::ctx/get("slack.client.id"),
      client_secret: ::hot::ctx/get("slack.client.secret"),
      code: "1234.5678.abcdef",
      redirect_uri: "https://example.com/slack/callback"
    }))
    response.access_token
    response.team
    ```
    """
}
fn
(request: OauthV2AccessRequest): OauthV2AccessResponse {
  oauth-v2-access(request, {})
},
(request: OauthV2AccessRequest, opts: Map): OauthV2AccessResponse {
  ::hot::ctx/mark-secret(request.client_secret)
  response api-request("POST", `${::slack::core/BASE_URL}/oauth.v2.access`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => {
      user or(response.body.authed_user, {})
      ::hot::ctx/mark-secret([
        response.body.access_token,
        response.body.refresh_token,
        user.access_token,
        user.refresh_token
      ])
      OauthV2AccessResponse(response.body)
    }
    => { err(HttpError(response)) }
  }
}
