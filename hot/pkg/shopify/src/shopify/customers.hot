::shopify::customers ns
meta {
    doc: """
    Customers: list and search with cursor pagination, exact-email
    lookup, fetch, create and update. Needs `read_customers` /
    `write_customers`; customer names, emails and addresses are
    protected customer data, so the app needs Shopify's approval for
    those fields.
    """
}

::api ::shopify::api

CUSTOMER_FIELDS """
  id firstName lastName displayName state tags note createdAt updatedAt
  defaultEmailAddress { emailAddress marketingState }
  defaultPhoneNumber { phoneNumber }
  numberOfOrders
  amountSpent { amount currencyCode }
"""

list-customers
meta {
    doc: """
    One page of customers. Options: `first` (default 50, max 250),
    `after`, `query` (e.g. `"country:canada orders_count:>5"`), `sortKey`
    (`NAME`, `CREATED_AT`, `UPDATED_AT`, ...), `reverse`. Returns
    `{nodes, pageInfo}`.

    **Example**

    ```hot
    page ::shopify::customers/list-customers({first: 25, query: "country:canada", sortKey: "UPDATED_AT"})
    map(page.nodes, %.email)
    page.pageInfo.endCursor
    ```
    """
}
fn
(): Map {
  list-customers({})
},
(options: Map): Map {
  list-customers(options, {})
},
(options: Map, opts: Map): Map {
  query ```
  query Customers($first: Int!, $after: String, $query: String, $sortKey: CustomerSortKeys, $reverse: Boolean) {
    customers(first: $first, after: $after, query: $query, sortKey: $sortKey, reverse: $reverse) {
      nodes { ${CUSTOMER_FIELDS} }
      pageInfo { hasNextPage endCursor }
    }
  }
  ```
  data ::api/graphql(query, ::api/connection-variables(options), opts)
  if-ok(data, %(%.customers))
}

search-customers
meta {
    doc: """
    One page of customers matching Shopify's customer search syntax. Options
    as in `list-customers`.

    **Example**

    ```hot
    page ::shopify::customers/search-customers("orders_count:>5", {first: 10})
    map(page.nodes, %.id)
    ```
    """
}
fn
(search-query: Str): Map {
  search-customers(search-query, {})
},
(search-query: Str, options: Map): Map {
  search-customers(search-query, options, {})
},
(search-query: Str, options: Map, opts: Map): Map {
  list-customers({...options, query: search-query}, opts)
}

collect-customers
meta {
    doc: """
    Follow cursors and return up to `max-items` customers (a Vec of nodes).
    Options as in `list-customers`.

    **Example**

    ```hot
    customers ::shopify::customers/collect-customers({query: "tag:vip"}, 500)
    length(customers)
    ```
    """
}
fn
(options: Map, max-items: Int): Vec {
  ::api/collect(list-customers, options, max-items)
},
(options: Map, max-items: Int, opts: Map): Vec {
  ::api/collect((page-options) { list-customers(page-options, opts) }, options, max-items)
}

email-query
meta {
    doc: """
    The search query for an exact email match, with the value quoted so
    operators in it can't widen the search. Exposed for testing.

    **Example**

    ```hot
    ::shopify::customers/email-query("ada@example.com")  // "email:\"ada@example.com\""
    ```
    """
}
fn (email: Str): Str {
  `email:${::api/quote-search-term(email)}`
}

find-customer-by-email
meta {
    doc: """
    Find a customer by exact email. Returns the customer or null.

    **Example**

    ```hot
    customer ::shopify::customers/find-customer-by-email("ada@example.com")
    if(is-null(customer), "no match", customer.id)
    ```
    """
}
fn
(email: Str): Map? {
  find-customer-by-email(email, {})
},
(email: Str, opts: Map): Map? {
  page list-customers({first: 1, query: email-query(email)}, opts)
  if-ok(page, (found) { if(is-empty(found.nodes), null, first(found.nodes)) })
}

get-customer
meta {
    doc: """
    One customer by GraphQL id, with the default address. Returns null when
    not found.

    **Example**

    ```hot
    customer ::shopify::customers/get-customer("gid://shopify/Customer/7")
    customer.email
    ```
    """
}
fn
(id: Str): Map? {
  get-customer(id, {})
},
(id: Str, opts: Map): Map? {
  query ```
  query Customer($id: ID!) {
    customer(id: $id) {
      ${CUSTOMER_FIELDS}
      defaultAddress { address1 address2 city provinceCode zip countryCodeV2 }
    }
  }
  ```
  data ::api/graphql(query, {id: id}, opts)
  if-ok(data, %(%.customer))
}

create-customer
meta {
    doc: """
    Create a customer (`customerCreate`) from a `CustomerInput`: `email`,
    `phone`, `firstName`, `lastName`, `tags`, `note`, `addresses`,
    `metafields`, ... Set marketing consent separately with
    `customerEmailMarketingConsentUpdate` via `graphql`.

    **Example**

    ```hot
    c ::shopify::customers/create-customer({email: "ada@example.com", firstName: "Ada", tags: ["vip"]})
    ```
    """
}
fn
(customer: Map): Map {
  create-customer(customer, {})
},
(customer: Map, opts: Map): Map {
  mutation ```
  mutation CustomerCreate($input: CustomerInput!) {
    customerCreate(input: $input) {
      customer { ${CUSTOMER_FIELDS} }
      userErrors { field message }
    }
  }
  ```
  payload ::api/mutate(mutation, {input: customer}, "customerCreate", opts)
  if-ok(payload, %(%.customer))
}

update-customer
meta {
    doc: """
    Update a customer (`customerUpdate`) from a `CustomerInput` that
    includes the customer `id` and the fields to change.

    **Example**

    ```hot
    ::shopify::customers/update-customer({id: "gid://shopify/Customer/7", tags: ["vip"], note: "Prefers phone."})
    ```
    """
}
fn
(customer: Map): Map {
  update-customer(customer, {})
},
(customer: Map, opts: Map): Map {
  mutation ```
  mutation CustomerUpdate($input: CustomerInput!) {
    customerUpdate(input: $input) {
      customer { ${CUSTOMER_FIELDS} }
      userErrors { field message }
    }
  }
  ```
  cond {
    is-null(get(customer, "id")) => { err("shopify: update-customer needs the customer id in the input") }
    => {
      payload ::api/mutate(mutation, {input: customer}, "customerUpdate", opts)
      if-ok(payload, %(%.customer))
    }
  }
}
