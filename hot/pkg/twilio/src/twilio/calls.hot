CreateCallRequest
meta {
    doc: """
    Parameters of POST /Calls.json. `To` and `From` are required, plus
    exactly one of `Url` (a TwiML endpoint), `Twiml` (inline TwiML, e.g.
    from `::twilio::twiml`), or `ApplicationSid`. Vec fields
    (`StatusCallbackEvent`, `RecordingStatusCallbackEvent`) are sent as
    repeated parameters.
    """
}
type {
  To: Str,
  From: Str,
  Url: Str?,
  Twiml: Str?,
  ApplicationSid: Str?,
  Method: Str?,
  FallbackUrl: Str?,
  FallbackMethod: Str?,
  StatusCallback: Str?,
  StatusCallbackEvent: Vec<Str>?,
  StatusCallbackMethod: Str?,
  SendDigits: Str?,
  Timeout: Int?,
  TimeLimit: Int?,
  Record: Bool?,
  RecordingChannels: Str?,
  RecordingTrack: Str?,
  RecordingStatusCallback: Str?,
  RecordingStatusCallbackMethod: Str?,
  RecordingStatusCallbackEvent: Vec<Str>?,
  MachineDetection: Str?,
  MachineDetectionTimeout: Int?,
  MachineDetectionSpeechThreshold: Int?,
  MachineDetectionSpeechEndThreshold: Int?,
  MachineDetectionSilenceTimeout: Int?,
  AsyncAmd: Bool?,
  AsyncAmdStatusCallback: Str?,
  AsyncAmdStatusCallbackMethod: Str?,
  Trim: Str?,
  CallerId: Str?,
  CallReason: Str?,
  SipAuthUsername: Str?,
  SipAuthPassword: Str?,
  Byoc: Str?
}

Call
meta {
    doc: """A Call resource. `duration` and `price` are set once the call completes."""
}
type {
  sid: Str?,
  account_sid: Str?,
  parent_call_sid: Str?,
  to: Str?,
  to_formatted: Str?,
  from: Str?,
  from_formatted: Str?,
  status: Str?,
  start_time: Str?,
  end_time: Str?,
  duration: Str?,
  price: Str?,
  price_unit: Str?,
  direction: Str?,
  answered_by: Str?,
  forwarded_from: Str?,
  caller_name: Str?,
  queue_time: Str?,
  api_version: Str?,
  uri: Str?,
  subresource_uris: Map?,
  date_created: Str?,
  date_updated: Str?,
  phone_number_sid: Str?
}

create-call-body
meta {
    doc: """The form parameters `create-call` sends: every set field of the request, unset ones omitted. Exposed for testing."""
}
fn (request: CreateCallRequest): Map {
  filter-vals(untype(request), is-some)
}

create-call
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}, "twilio.auth.token": {required: false}},
    doc: """
POST /Accounts/{AccountSid}/Calls.json - Initiate an outbound phone call. Provide either `Url` (TwiML endpoint), `Twiml` (inline TwiML), or `ApplicationSid`.

**Example: Call with TwiML URL**

```hot
::calls ::twilio::calls

response ::calls/create-call(::calls/CreateCallRequest({
  To: "+15558675310",
  From: "+15017122661",
  Url: "https://example.com/twiml/greeting.xml",
  StatusCallback: "https://example.com/hooks/call-status",
  StatusCallbackEvent: ["initiated", "ringing", "answered", "completed"]
}))
response.sid     // => "CA..."
response.status  // => "queued"
```

**Example: Call with inline TwiML**

```hot
::calls ::twilio::calls
::twiml ::twilio::twiml

response ::calls/create-call(::calls/CreateCallRequest({
  To: "+15558675310",
  From: "+15017122661",
  Twiml: ::twiml/voice-response([::twiml/say("Hello from Hot!")])
}))
```
"""
}
fn
(request: CreateCallRequest): Call {
  create-call(request, {})
},
(request: CreateCallRequest, opts: Map): Call {
  resolve(opts) |> if-ok((client) { create-call(client, request) })
},
(client: Client, request: CreateCallRequest): Call {
  response api-request(client, "POST", `${account-url(client)}/Calls.json`, {}, create-call-body(request))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { Call(response.body) }
    => { err(HttpError(response)) }
  }
}

GetCallRequest type {
  sid: Str
}

get-call
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
GET /Accounts/{AccountSid}/Calls/{Sid}.json - Get details of a specific call. Returns status, duration, price, and timestamps.

**Example**

```hot
::calls ::twilio::calls

response ::calls/get-call(::calls/GetCallRequest({
  sid: "CA1234567890abcdef1234567890abcdef"
}))
response.status    // => "completed"
response.duration  // => "30"
```
"""
}
fn
(request: GetCallRequest): Call {
  get-call(request, {})
},
(request: GetCallRequest, opts: Map): Call {
  resolve(opts) |> if-ok((client) { get-call(client, request) })
},
(client: Client, request: GetCallRequest): Call {
  response api-request(client, "GET", `${account-url(client)}/Calls/${::uri/encode(request.sid)}.json`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { Call(response.body) }
    => { err(HttpError(response)) }
  }
}

ListCallsRequest
meta {
    doc: """
    Filters for GET /Calls.json. `StartTime`/`EndTime` match one day
    (`YYYY-MM-DD`); the `...Before`/`...After` fields send Twilio's
    inclusive `StartTime<`, `StartTime>`, `EndTime<`, `EndTime>` range
    filters.
    """
}
type {
  To: Str?,
  From: Str?,
  ParentCallSid: Str?,
  Status: Str?,
  StartTime: Str?,
  StartTimeBefore: Str?,
  StartTimeAfter: Str?,
  EndTime: Str?,
  EndTimeBefore: Str?,
  EndTimeAfter: Str?,
  PageSize: Int?,
  Page: Int?,
  PageToken: Str?
}

ListCallsResponse type {
  calls: Vec<Map>?,
  end: Int?,
  first_page_uri: Str?,
  next_page_uri: Str?,
  page: Int?,
  page_size: Int?,
  previous_page_uri: Str?,
  start: Int?,
  uri: Str?
}

list-calls-query
meta {
    doc: """The query string `list-calls` sends. Exposed for testing."""
}
fn (request: ListCallsRequest): Str {
  ::twilio::api/query-string({
    To: request.To,
    From: request.From,
    ParentCallSid: request.ParentCallSid,
    Status: request.Status,
    StartTime: request.StartTime,
    "StartTime<": request.StartTimeBefore,
    "StartTime>": request.StartTimeAfter,
    EndTime: request.EndTime,
    "EndTime<": request.EndTimeBefore,
    "EndTime>": request.EndTimeAfter,
    PageSize: request.PageSize,
    Page: request.Page,
    PageToken: request.PageToken
  })
}

list-calls
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """GET /Accounts/{AccountSid}/Calls.json - List calls, newest first. Filter by `To`, `From`, `Status`, parent call, or date range. Returns one page; follow it with `::twilio::api/next-page`, or use `list-all-calls`."""
}
fn
(request: ListCallsRequest): ListCallsResponse {
  list-calls(request, {})
},
(request: ListCallsRequest, opts: Map): ListCallsResponse {
  resolve(opts) |> if-ok((client) { list-calls(client, request) })
},
(client: Client, request: ListCallsRequest): ListCallsResponse {
  response api-request(client, "GET", `${account-url(client)}/Calls.json${list-calls-query(request)}`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ListCallsResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

list-all-calls
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """Collect up to `limit` calls matching `request`, following Twilio's page links as needed."""
}
fn
(request: ListCallsRequest, limit: Int): Vec<Map> {
  list-all-calls(request, limit, {})
},
(request: ListCallsRequest, limit: Int, opts: Map): Vec<Map> {
  resolve(opts) |> if-ok((client) { list-all-calls(client, request, limit) })
},
(client: Client, request: ListCallsRequest, limit: Int): Vec<Map> {
  if-ok(list-calls(client, request), (page) { ::twilio::api/collect-pages(client, untype(page), "calls", limit) })
}

