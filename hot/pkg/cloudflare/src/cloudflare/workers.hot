::cloudflare::workers ns
meta {
    doc: """
    Cloudflare Workers: list, deploy (single ES module), fetch, and delete
    scripts, and manage zone routes. Deploying replaces the script and
    creates a new version and deployment in one step. For multi-module
    bundles, static assets, or secrets, use `wrangler deploy`.
    """,
    ctx: {"cloudflare.token": {required: true}, "cloudflare.account.id": {required: true}}
}

::api ::cloudflare::api

// The compatibility date used when a deploy doesn't name one. Pin your
// own in `opts.compatibility_date` for reproducible behaviour.
DEFAULT_COMPATIBILITY_DATE "2025-09-01"

script-suffix fn (name: Str): Str {
  `/workers/scripts/${::api/seg(name)}`
}

list-scripts
meta {
    doc: """GET /accounts/{account_id}/workers/scripts - Every Worker script in the account (`id` is the script name). Not paginated."""
}
fn (): Vec {
  ::api/account-json("GET", "/workers/scripts")
}

get-script-settings
meta {
    doc: """GET .../workers/scripts/{name}/settings - A script's bindings, compatibility date and flags, and observability settings."""
}
fn (name: Str): Map {
  ::api/account-json("GET", `${script-suffix(name)}/settings`)
}

script-metadata
meta {
    doc: """
    The `metadata` part for a module upload. `opts` may set
    `compatibility_date`, `compatibility_flags`, `bindings`
    (`[{type: "plain_text", name, text}, {type: "kv_namespace", name, namespace_id}, …]`),
    `keep_bindings`, `observability`, and `tags`; unset fields are
    omitted. Exposed for testing.
    """
}
fn (main-module: Str, opts: Map): Map {
  {
    main_module: main-module,
    compatibility_date: or(get(opts, "compatibility_date"), DEFAULT_COMPATIBILITY_DATE)
  }
    |> assoc-some("compatibility_flags", get(opts, "compatibility_flags"))
    |> assoc-some("bindings", get(opts, "bindings"))
    |> assoc-some("keep_bindings", get(opts, "keep_bindings"))
    |> assoc-some("observability", get(opts, "observability"))
    |> assoc-some("tags", get(opts, "tags"))
}

deploy-parts
meta {
    doc: """The multipart parts for a module upload: the JSON `metadata` part and the module itself as `application/javascript+module`. Exposed for testing."""
}
fn (main-module: Str, code: Str, opts: Map): Vec {
  [
    {name: "metadata", value: to-json(script-metadata(main-module, opts)), content_type: "application/json"},
    {name: main-module, filename: main-module, value: code, content_type: "application/javascript+module"}
  ]
}

deploy-module
meta {
    doc: """
    PUT /accounts/{account_id}/workers/scripts/{name} - Upload `code` as
    a single ES module Worker (`export default { fetch(request, env) {…} }`)
    and deploy it. `opts` as in `script-metadata`, plus `main_module`
    (the part name, default `"worker.js"`). Returns the script record.
    The Worker still needs a route, custom domain, or workers.dev
    subdomain to receive traffic.

    **Example**

    ```hot
    ::cloudflare::workers/deploy-module("hello", "export default { fetch() { return new Response('hi') } }", {
      bindings: [{type: "plain_text", name: "GREETING", text: "hi"}]
    })
    ```
    """
}
fn
(name: Str, code: Str): Map {
  deploy-module(name, code, {})
},
(name: Str, code: Str, opts: Map): Map {
  main-module or(get(opts, "main_module"), "worker.js")
  path ::api/account-path(script-suffix(name))
  cond {
    is-err(path) => { path }
    => { ::api/send-multipart("PUT", path, deploy-parts(main-module, code, opts)) }
  }
}

delete-script
meta {
    doc: """DELETE .../workers/scripts/{name} - Delete a script. The 2-arity form with `force: true` also deletes it when other Workers bind to it."""
}
fn
(name: Str): Any {
  delete-script(name, false)
},
(name: Str, force: Bool): Any {
  ::api/account-json("DELETE", `${script-suffix(name)}${::api/query({force: if(force, true, null)})}`)
}

// ---------------------------------------------------------------------------
// Routes (zone-scoped)
// ---------------------------------------------------------------------------

list-routes
meta {
    doc: """GET /zones/{zone_id}/workers/routes - A zone's Worker routes: `[{id, pattern, script}]`."""
}
fn (zone-id: Str): Vec {
  ::api/json("GET", `/zones/${::api/seg(zone-id)}/workers/routes`)
}

create-route
meta {
    doc: """POST /zones/{zone_id}/workers/routes - Route `pattern` (e.g. `"example.com/api/*"`) to the Worker `script`. Returns `{id, pattern, script}`."""
}
fn (zone-id: Str, pattern: Str, script: Str): Map {
  ::api/json("POST", `/zones/${::api/seg(zone-id)}/workers/routes`, {pattern: pattern, script: script})
}

delete-route
meta {
    doc: """DELETE /zones/{zone_id}/workers/routes/{route_id} - Remove a route."""
}
fn (zone-id: Str, route-id: Str): Any {
  ::api/json("DELETE", `/zones/${::api/seg(zone-id)}/workers/routes/${::api/seg(route-id)}`)
}
