    doc: "DeepSeek platform API. Uses `max_tokens`; `deepseek-reasoner` streams `reasoning_content`, which the adapter ignores."
}

Preset({
    name: "DeepSeek",
    base-url: "https://api.deepseek.com",
    model-prefix: "deepseek/",
    key-ctx: "deepseek.api.key",
    key-env: "DEEPSEEK_API_KEY",
    max-tokens-param: "max_tokens",
    stream-usage: true,
    capabilities: ["tools", "streaming", "json-mode"],
    docs-url: "https://api-docs.deepseek.com/"
})

