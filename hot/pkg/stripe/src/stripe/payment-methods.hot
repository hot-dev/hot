::stripe::payment-methods ns
meta {
    doc: """PaymentMethods: retrieve, attach to and detach from customers, update, and list. Payment methods are usually created client-side with Stripe.js (or saved with a SetupIntent) and then attached server-side. See https://docs.stripe.com/api/payment_methods."""
}

api-call ::stripe::api/call
seg ::stripe::api/encode-id
RequestOptions ::stripe::api/RequestOptions

// ============================================================================
// Payment Methods
// ============================================================================

get-payment-method
meta {
    doc: """GET /v1/payment_methods/{payment_method} - Retrieve a PaymentMethod by ID."""
}
fn
(payment-method: Str): Map {
  get-payment-method(payment-method, {})
},
(payment-method: Str, opts: Map): Map {
  api-call("GET", `/v1/payment_methods/${seg(payment-method)}`, "", opts)
}

attach-payment-method
meta {
    doc: """
POST /v1/payment_methods/{payment_method}/attach - Attach a PaymentMethod to a customer. Prefer saving cards with a SetupIntent (`::stripe::setup-intents`), which also handles authentication; attaching directly skips it. Set the customer's default with `update-customer(..., {invoice_settings: {default_payment_method}})`.

**Example**

```hot
::pm ::stripe::payment-methods

::pm/attach-payment-method("pm_...", "cus_...")
```
"""
}
fn
(payment-method: Str, customer: Str): Map {
  attach-payment-method(payment-method, customer, RequestOptions({}))
},
(payment-method: Str, customer: Str, options: RequestOptions | Map): Map {
  api-call("POST", `/v1/payment_methods/${seg(payment-method)}/attach`, {customer: customer}, options)
}

detach-payment-method
meta {
    doc: """POST /v1/payment_methods/{payment_method}/detach - Detach a PaymentMethod from its customer. The PaymentMethod cannot be used for payments afterwards."""
}
fn
(payment-method: Str): Map {
  detach-payment-method(payment-method, RequestOptions({}))
},
(payment-method: Str, options: RequestOptions | Map): Map {
  api-call("POST", `/v1/payment_methods/${seg(payment-method)}/detach`, {}, options)
}

UpdatePaymentMethodRequest type {
  billing_details: Map?,
  card: Map?,
  metadata: Map?,
  allow_redisplay: Str?,
  expand: Vec<Str>?
}

update-payment-method
meta {
    doc: """POST /v1/payment_methods/{payment_method} - Update a PaymentMethod attached to a customer. `card` accepts `exp_month`/`exp_year` updates; `allow_redisplay` is "always", "limited", or "unspecified"."""
}
fn
(payment-method: Str, request: UpdatePaymentMethodRequest): Map {
  update-payment-method(payment-method, request, RequestOptions({}))
},
(payment-method: Str, request: UpdatePaymentMethodRequest, options: RequestOptions | Map): Map {
  api-call("POST", `/v1/payment_methods/${seg(payment-method)}`, request, options)
}

ListPaymentMethodsRequest type {
  type: Str?,
  allow_redisplay: Str?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-payment-methods
meta {
    doc: """GET /v1/customers/{customer}/payment_methods - List a customer's PaymentMethods. Optionally filter by `type` (e.g. "card")."""
}
fn
(customer: Str): Map {
  list-payment-methods(customer, ListPaymentMethodsRequest({}))
},
(customer: Str, request: ListPaymentMethodsRequest): Map {
  list-payment-methods(customer, request, {})
},
(customer: Str, request: ListPaymentMethodsRequest, opts: Map): Map {
  api-call("GET", `/v1/customers/${seg(customer)}/payment_methods`, request, opts)
}
