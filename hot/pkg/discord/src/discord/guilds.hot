create-guild-ban
meta {
    doc: """
    PUT /guilds/{guild_id}/bans/{user_id} - Ban a user.
    `delete_message_seconds` (0-604800) also deletes their recent messages.
    Needs BAN_MEMBERS.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    ::guilds/create-guild-ban(::guilds/CreateGuildBanRequest({
      guild_id: "1000000000000000000",
      user_id: "1300000000000000000",
      delete_message_seconds: 3600,
      reason: "Raid account"
    }))
    ```
    """
}
fn (request: CreateGuildBanRequest): Bool {
  ::api/call-ok("PUT", `/guilds/${seg(request.guild_id)}/bans/${seg(request.user_id)}`, {
    body: ::api/body(request, ["guild_id", "user_id"]),
    reason: request.reason
