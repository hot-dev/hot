::anthropic::test::chat-tools ns
meta ["test"]

::ct      ::anthropic::chat-tools
::ai-chat ::ai::chat
::ai-tool ::ai::tool

// ============================================================================
// Outbound conversions
// ============================================================================

test-request-options-carry-opus5-output-controls
meta ["test"]
fn () {
    request ::ct/apply-request-options(
        {model: "claude-opus-5"},
        ::ct/ChatRequestOptions({
            max-tokens: 16384,
            effort: "high",
        })
    )
    assert-eq(16384, request.max_tokens)
    assert-eq("high", request.output_config.effort)
}

test-request-options-leave-the-cache-alone-by-default
meta ["test"]
fn () {
    request ::ct/apply-request-options(
        {model: "claude-opus-5", system: "be brief"},
        ::ct/DEFAULT_REQUEST_OPTIONS
    )
    assert-eq("be brief", request.system)
    assert(not(in("cache_control", keys(request))), "no marker unless one is asked for")
}

test-request-options-mark-the-system-prompt-and-the-conversation
meta ["test"]
fn () {
    marker {type: "ephemeral"}
    request ::ct/apply-request-options(
        {model: "claude-opus-5", system: "the skills and the pack"},
        ::ct/ChatRequestOptions({max-tokens: 1024, cache-control: marker})
    )
    assert-eq(marker, request.cache_control, "the conversation's tail moves forward each turn")
    assert-eq(
        [{type: "text", text: "the skills and the pack", cache_control: marker}],
        request.system,
        "the system prompt is a read point that survives what the tail does",
    )
}

test-request-options-mark-both-with-one-ttl
meta ["test"]
fn () {
    // A longer TTL must come first, so the two can't be allowed to differ.
    marker {type: "ephemeral", ttl: "1h"}
    request ::ct/apply-request-options(
        {model: "claude-opus-5", system: "stable"},
        ::ct/ChatRequestOptions({max-tokens: 1024, cache-control: marker})
    )
    assert-eq("1h", request.cache_control.ttl)
    assert-eq("1h", request.system[0].cache_control.ttl)
}

test-request-options-mark-a-conversation-with-no-system-prompt
meta ["test"]
fn () {
    request ::ct/apply-request-options(
        {model: "claude-opus-5"},
        ::ct/ChatRequestOptions({max-tokens: 1024, cache-control: {type: "ephemeral"}})
    )
    assert-eq("ephemeral", request.cache_control.type)
    assert(not(in("system", keys(request))), "no system prompt appears from nowhere")
}

test-request-options-leave-an-empty-system-prompt-unmarked
meta ["test"]
fn () {
    // The API refuses an empty text block, and there's nothing there to cache.
    request ::ct/apply-request-options(
        {model: "claude-opus-5", system: ""},
        ::ct/ChatRequestOptions({max-tokens: 1024, cache-control: {type: "ephemeral"}})
    )
    assert-eq("", request.system)
    assert-eq("ephemeral", request.cache_control.type)
}

test-request-options-keep-effort-beside-the-cache
meta ["test"]
fn () {
    request ::ct/apply-request-options(
        {model: "claude-opus-5", system: "s"},
        ::ct/ChatRequestOptions({max-tokens: 1024, effort: "high", cache-control: {type: "ephemeral"}})
    )
    assert-eq("high", request.output_config.effort)
    assert-eq("ephemeral", request.cache_control.type)
}

test-a-marked-request-reaches-the-wire-whole
meta ["test"]
fn () {
    marker {type: "ephemeral"}
    request ::ct/apply-request-options(
        {model: "claude-opus-5", messages: [{role: "user", content: "hi"}], system: "s"},
        ::ct/ChatRequestOptions({max-tokens: 1024, cache-control: marker})
    )
    sent untype(::anthropic::messages/MessagesPostRequest(request))
    assert-eq(marker, sent.cache_control)
    assert-eq(marker, sent.system[0].cache_control)
}

test-to-anthropic-user-message
meta ["test"]
fn () {
    m ::ai-chat/Message({role: "user", content: "hello"})
    out ::ct/to-anthropic-message(m)
    assert-eq("user", out.role)
    assert-eq("hello", out.content)
}

test-to-anthropic-assistant-text-only
meta ["test"]
fn () {
    m ::ai-chat/Message({role: "assistant", content: "hi back"})
    out ::ct/to-anthropic-message(m)
    assert-eq("assistant", out.role)
    blocks out.content
    assert-eq(1, length(blocks))
    assert-eq("text", blocks[0].type)
    assert-eq("hi back", blocks[0].text)
}

test-to-anthropic-assistant-with-tools
meta ["test"]
fn () {
    call ::ai-tool/ToolCall({id: "call_1", name: "get_weather", input: {city: "Paris"}})
    m ::ai-chat/Message({role: "assistant", content: "let me check", tool-calls: [call]})
    out ::ct/to-anthropic-message(m)
    assert-eq("assistant", out.role)
    blocks out.content
    assert-eq(2, length(blocks))
    assert-eq("text", blocks[0].type)
    assert-eq("tool_use", blocks[1].type)
    assert-eq("call_1", blocks[1].id)
    assert-eq("get_weather", blocks[1].name)
    assert-eq("Paris", blocks[1].input.city)
}

test-to-anthropic-assistant-tool-only-no-text
meta ["test"]
fn () {
    call ::ai-tool/ToolCall({id: "x", name: "f", input: {}})
    m ::ai-chat/Message({role: "assistant", content: "", tool-calls: [call]})
    out ::ct/to-anthropic-message(m)
    blocks out.content
    assert-eq(1, length(blocks))
    assert-eq("tool_use", blocks[0].type)
}

test-to-anthropic-tool-result
meta ["test"]
fn () {
    m ::ai-chat/Message({role: "tool", content: 42, tool-call-id: "call_1"})
    out ::ct/to-anthropic-message(m)
    assert-eq("user", out.role)
    blocks out.content
    assert-eq(1, length(blocks))
    assert-eq("tool_result", blocks[0].type)
    assert-eq("call_1", blocks[0].tool_use_id)
    assert-eq("42", blocks[0].content)
}

tool-fixture-fn
meta { doc: """Fixture for to-anthropic-tool test.""" }
fn (x: Int): Int { x }

test-to-anthropic-tool-shape
meta ["test"]
fn () {
    t ::ai-tool/from-fn(tool-fixture-fn, {description: "Adds one"})
    out ::ct/to-anthropic-tool(t)
    assert-eq("Adds one", out.description)
    assert(is-some(out.input_schema), "input_schema present")
}

test-to-anthropic-tool-uses-provider-safe-name
meta ["test"]
fn () {
    t ::ai-tool/from-fn(tool-fixture-fn, {name: "github/list-runs"})
    out ::ct/to-anthropic-tool(t)
    assert-eq(::ai-tool/provider-name("github/list-runs"), out.name)
    assert(::hot::regex/is-match(out.name, "^[a-zA-Z0-9_-]+$"))
}

// ============================================================================
// Inbound conversions
// ============================================================================

test-response-text-concat
meta ["test"]
fn () {
    blocks [
        {type: "text", text: "hello "},
        {type: "tool_use", id: "x", name: "f", input: {}},
        {type: "text", text: "world"}
    ]
    assert-eq("hello world", ::ct/response-text(blocks))
}

test-response-tool-calls
meta ["test"]
fn () {
    blocks [
        {type: "text", text: "result:"},
        {type: "tool_use", id: "tu_1", name: "weather", input: {city: "NYC"}},
        {type: "tool_use", id: "tu_2", name: "time", input: {tz: "UTC"}}
    ]
    calls ::ct/response-tool-calls(blocks)
    assert-eq(2, length(calls))
    assert-eq("tu_1", calls[0].id)
    assert-eq("weather", calls[0].name)
    assert-eq("NYC", calls[0].input.city)
    assert-eq("tu_2", calls[1].id)
}

test-usage-counts-the-whole-prompt-with-a-cache
meta ["test"]
fn () {
    usage ::ct/response-usage({
        input_tokens: 10,
        cache_read_input_tokens: 900,
        cache_creation_input_tokens: 90,
        output_tokens: 5,
    })
    assert-eq(1000, usage.input-tokens, "Anthropic's input_tokens is only what the cache didn't cover")
    assert-eq(900, usage.cache-read-tokens)
    assert-eq(90, usage.cache-write-tokens)
    assert-eq(5, usage.output-tokens)
}

test-usage-with-no-cache-reads-as-before
meta ["test"]
fn () {
    usage ::ct/response-usage({input_tokens: 10, output_tokens: 5})
    assert-eq(10, usage.input-tokens)
    assert-eq(5, usage.output-tokens)
    assert-eq(0, usage.cache-read-tokens)
    assert-eq(0, usage.cache-write-tokens)
}

test-a-stream-reports-what-the-cache-held
meta ["test"]
fn () {
    state ::ct/handle-event(
        ::ct/EMPTY_STATE,
        {
            event: "message_start",
            data: {
                type: "message_start",
                message: {usage: {input_tokens: 10, cache_read_input_tokens: 900, cache_creation_input_tokens: 90}},
            },
        },
        (delta) { null },
    )
    reply ::ct/finalize-state(state)
    assert-eq(1000, reply.usage.input-tokens)
    assert-eq(900, reply.usage.cache-read-tokens)
    assert-eq(90, reply.usage.cache-write-tokens)
}

test-response-usage-shape
meta ["test"]
fn () {
    u ::ct/response-usage({input_tokens: 12, output_tokens: 7, cache_read_input_tokens: 0})
    assert-eq(12, u.input-tokens)
    assert-eq(7, u.output-tokens)
}

test-response-usage-null
meta ["test"]
fn () {
    assert(is-null(::ct/response-usage(null)), "null usage stays null")
}
