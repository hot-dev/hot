TeamAccessLogsRequest type {
  before: Str?,
  count: Int?,
  page: Int?
}

TeamAccessLogsResponse type {
  ok: Bool?,
  error: Str?,
  logins: Vec<Map>?,
  paging: Map?
}


team-access-logs
meta {
    doc: """
    GET /team.accessLogs - Get the access logs for the current team.
    Requires an admin or owner token. Returns login records with user, IP,
    and user agent info.

    **Example**

    ```hot
    response ::slack::misc/team-access-logs(::slack::misc/TeamAccessLogsRequest({
      count: 100,
      page: 1
    }))
    map(response.logins, %.ip)

    // With a per-call token
    ::slack::misc/team-access-logs(::slack::misc/TeamAccessLogsRequest({
      count: 100,
      page: 1
    }), {api-key: ::hot::ctx/get("tenant-b.slack.api.key")})
    ```
    """
}
fn
(request: TeamAccessLogsRequest): TeamAccessLogsResponse {
  team-access-logs(request, {})
},
(request: TeamAccessLogsRequest, opts: Map): TeamAccessLogsResponse {
  response api-request("GET", ::slack::api/with-query(`${::slack::core/BASE_URL}/team.accessLogs`, {before: request.before, count: request.count, page: request.page}), {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { TeamAccessLogsResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

