::ofac::test::parsers ns
meta ["test"]

::fx ::ofac::test::fixtures
::ofac ::ofac
::index ::name-screening::index
::screen ::name-screening::screen
::cache ::name-screening::cache

by-id fn (entries: Vec, id: Str): Map {
  untype(find-first(entries, (e) { eq(e.id, id) }))
}

// ============================================================================
// OFAC CSV
// ============================================================================

test-ofac-parse-csv-quoted-and-null-fields
meta ["test"]
fn () {
    rows ::ofac/parse-csv("36,\"AEROCARIBBEAN AIRLINES\",-0- \r\n173,\"ANGLO-CARIBBEAN CO., LTD.\",\"a \"\"b\"\"\"\r\n", 3)
    assert-eq([["36", "AEROCARIBBEAN AIRLINES", null], ["173", "ANGLO-CARIBBEAN CO., LTD.", "a \"b\""]], rows)
}

test-ofac-parse-entries
meta ["test"]
fn () {
    es ::ofac/parse("ofac-sdn", ::fx/OFAC_SDN, ::fx/OFAC_ALT, ::fx/OFAC_ADD, ::fx/OFAC_COMMENTS)
    assert-eq(5, length(es))
    bank by-id(es, "306")
    assert-eq("BANCO NACIONAL DE CUBA", bank.name)
    assert-eq("entity", bank.kind)
    assert-eq(["NATIONAL BANK OF CUBA"], bank.aliases)
    assert-eq(["CUBA"], bank.programs)
    assert-eq(["Zweierstrasse 35, Zurich CH-8022, Switzerland", "Avenida de Concha Espina 8, Madrid E-28036, Spain"], bank.addresses)
    assert-eq("ofac-sdn", bank.source)
    assert-eq("OFAC SDN List", bank.list)
    assert-eq("https://sanctionssearch.ofac.treas.gov/Details.aspx?id=306", bank.url)
}

test-ofac-individual-dob-from-remarks
meta ["test"]
fn () {
    es ::ofac/parse("ofac-sdn", ::fx/OFAC_SDN, ::fx/OFAC_ALT, ::fx/OFAC_ADD, "")
    z by-id(es, "2676")
    assert-eq("individual", z.kind)
    assert-eq("AL ZAWAHIRI, Dr. Ayman", z.name)
    assert-eq(["AL-ZAWAHIRI, Ayman", "SALIM, Ahmad Fuad", "AL-ZAWAHIRI, Aiman Muhammad Rabi"], z.aliases)
    assert-eq(["1951-06-19"], z.dobs)
    assert-eq([], z.addresses, "an all -0- address row is dropped")
}

test-ofac-vessel-aircraft-and-programs
meta ["test"]
fn () {
    es ::ofac/parse("ofac-sdn", ::fx/OFAC_SDN, "", "", ::fx/OFAC_COMMENTS)
    assert-eq("vessel", by-id(es, "4243").kind)
    assert-eq("aircraft", by-id(es, "15432").kind)
    gpb by-id(es, "17016")
    assert-eq(["UKRAINE-EO13662", "RUSSIA-EO14024"], gpb.programs)
    assert(::hot::str/contains(gpb.remarks, "Legal Entity Number 253400WSS48YWMBUA688"), "comments continue the remarks")
}

test-ofac-parse-remarks
meta ["test"]
fn () {
    assert-eq({dobs: ["1951-06-19"], nationalities: ["EG"]}, ::ofac/parse-remarks("DOB 19 Jun 1951; POB Giza, Egypt; nationality Egypt."))
    r ::ofac/parse-remarks("DOB 01 Jan 1960 to 31 Dec 1962; alt. DOB 1959; citizen Iran; alt. nationality Russia (USSR).")
    assert-eq(["1960/1962", "1959"], r.dobs)
    assert-eq(["RU", "IR"], r.nationalities, "nationality items, then citizen items")
    assert-eq({dobs: [], nationalities: []}, ::ofac/parse-remarks(null))
}

test-ofac-manifest-and-version
meta ["test"]
fn () {
    files ::ofac/parse-manifest(::fx/SLS_MANIFEST)
    assert-eq("5f240bed79d504e7a5aa0000000000000000000000000000000000000000beef", get(files, "SDN.CSV").sha256)
    assert-eq(null, get(files, "SDNLIST.PDF").sha256)
    assert-eq("5f240bed79d504e7", ::ofac/version("ofac-sdn", files))
    assert-eq(null, ::ofac/version("ofac-cons", files), "no CONS_PRIM.CSV in this listing")
    assert-eq({}, ::ofac/parse-manifest(null))
}

test-ofac-export-url-encodes-file
meta ["test"]
fn () {
    assert-eq("https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.CSV", ::ofac/export-url("SDN.CSV"))
    assert-eq("https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/A%20B.CSV", ::ofac/export-url("A B.CSV"))
}

test-ofac-consolidated-list-name
meta ["test"]
fn () {
    es ::ofac/parse("ofac-cons", ::fx/OFAC_SDN, "", "", "")
    assert-eq("ofac-cons", first(es).source)
    assert-eq("OFAC Consolidated (non-SDN) List", first(es).list)
}

// ============================================================================
// With hot.dev/name-screening
// ============================================================================

test-lists-register-with-the-cache
meta ["test"]
fn () {
    ls ::ofac/lists()
    assert-eq(::ofac/SOURCES, map(ls, (l) { l.source }))
    for-each(ls, (l) {
      assert-eq(l, ::cache/check-list(l))
      assert(is-fn(l.fetch), "lists carry their fetch")
    })
}

test-screens-the-parsed-list-from-memory
meta ["test"]
fn () {
    idx ::index/build(::ofac/parse("ofac-sdn", ::fx/OFAC_SDN, ::fx/OFAC_ALT, ::fx/OFAC_ADD, ::fx/OFAC_COMMENTS))
    r untype(::screen/screen-index({ofac-sdn: idx}, "Ayman al-Zawahiri", {dob: "1951-06-19", kind: "individual"}))
    assert-eq("possible-match", r.status)
    assert-eq(true, r.review-required)
    assert-eq("2676", first(r.matches).entry.id)
    assert(gt(length(first(r.matches).explanation), 0), "every match is explained")
}

test-screens-the-parsed-list-from-the-cache
meta ["test"]
fn () {
    store `ofac-sdn-test-${Uuid()}`
    row ::cache/refresh-source({source: "ofac-sdn", list: "OFAC SDN List", entries: ::ofac/parse("ofac-sdn", ::fx/OFAC_SDN, ::fx/OFAC_ALT, ::fx/OFAC_ADD, ::fx/OFAC_COMMENTS)}, {store: store})
    assert-eq("updated", row.status)
    r untype(::name-screening/screen("Ayman al-Zawahiri", {...{dob: "1951-06-19", kind: "individual"}, store: store, sources: ["ofac-sdn"]}))
    assert-eq("possible-match", r.status)
    assert-eq("2676", first(r.matches).entry.id)
    clean untype(::name-screening/screen("Jane Q. Example", {store: store, sources: ["ofac-sdn"]}))
    assert-eq("no-match", clean.status)
    assert-eq(["ofac-sdn"], map(clean.sources, (s) { s.source }))
    assert(contains(clean.notice, "Searched: OFAC SDN List."), clean.notice)
}

test-a-list-never-refreshed-is-not-a-no-match
meta ["test"]
fn () {
    out ::name-screening/screen("Jane Q. Example", {store: `ofac-sdn-test-${Uuid()}`, sources: ::ofac/SOURCES})
    assert(is-err(out), "an empty cache is not a no-match")
}

test-screen-typos-match-an-alias
meta ["test"]
fn () {
    idx ::index/build(::ofac/parse("ofac-sdn", ::fx/OFAC_SDN, ::fx/OFAC_ALT, ::fx/OFAC_ADD, ""))
    m first(untype(::screen/screen-index({ofac-sdn: idx}, "Aiman Zawahri", {})).matches)
    assert-eq("2676", m.entry.id)
    assert(gte(m.score, 0.85), "two typos still screen as a possible match")
}

test-screen-entity-suffixes
meta ["test"]
fn () {
    idx ::index/build(::ofac/parse("ofac-sdn", ::fx/OFAC_SDN, "", "", ""))
    m first(untype(::screen/screen-index({ofac-sdn: idx}, "Gazprombank", {kind: "entity"})).matches)
    assert-eq("17016", m.entry.id)
    assert-eq(1.0, m.score, "JOINT STOCK COMPANY is a legal form")
}
