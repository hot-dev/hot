views-publish
meta {
    doc: """
    POST /views.publish - Publish a static view to the App Home tab for a
    user. Use `hash` to avoid overwriting concurrent updates.

    **Example**

    ```hot
    view to-json({
      type: "home",
      blocks: [{type: "section", text: {type: "mrkdwn", text: "Welcome back"}}]
    })

    response ::slack::misc/views-publish(::slack::misc/ViewsPublishRequest({
      user_id: "U1234567",
      view: view
    }))
    response.view.hash
    ```
    """
}
fn
(request: ViewsPublishRequest): ViewsPublishResponse {
  views-publish(request, {})
},
(request: ViewsPublishRequest, opts: Map): ViewsPublishResponse {
  response api-request("POST", `${::slack::core/BASE_URL}/views.publish`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ViewsPublishResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

