::persona::reports ns
meta {
    doc: """
    Reports: screenings and lookups run on demand or attached to an
    inquiry, such as watchlist, politically exposed person, adverse media,
    and the KYB reports (`report/business-lookup`, `business-watchlist`,
    `business-adverse-media`, `business-search`, ...).

    Reports run asynchronously. Create one, then wait for the
    `report/<type>.ready` (or `.errored`) webhook, or check `is-done` from
    a schedule. Statuses: `pending`, `ready`, `errored`; a ready report
    sets `has-match`.
    """
}

::api ::persona::api

seg ::persona::api/seg

report-type
meta {
    doc: """
    The JSON:API type for a report: `"watchlist"` and `"report/watchlist"`
    both give `"report/watchlist"`. Exposed for testing.

    **Example**

    ```hot
    ::persona::reports/report-type("watchlist")  // "report/watchlist"
    ::persona::reports/report-type("report/watchlist")  // "report/watchlist"
    ```
    """
}
fn (type-name: Str): Str {
  t trim(type-name)
  if(starts-with(t, "report/"), t, `report/${t}`)
}

create-body
meta {
    doc: """
    The JSON:API body for `create-report`. Exposed for testing.

    **Example**

    ```hot
    ::persona::reports/create-body("watchlist", "rptp_1", {name-last: "Doe"}, {})
    // {data: {type: "report/watchlist", attributes: {report-template-id: "rptp_1", query: {name-last: "Doe"}}}}
    ```
    """
}
fn (type-name: Str, template-id: Str?, query: Map, opts: Map): Map {
  ::api/document(report-type(type-name), {
    report-template-id: template-id,
    account-id: get(opts, "account-id"),
    query: query
  }, or(get(opts, "meta"), {}))
}

create-report
meta {
    doc: """
    POST /reports - Run a report. `type-name` is the report type
    (`"watchlist"`, `"politically-exposed-person"`, `"adverse-media"`,
    `"business-lookup"`, `"business-watchlist"`, `"business-adverse-media"`,
    `"email-address"`, `"phone-number"`, ...); `template-id` is its report
    template (`rptp_...`, from the dashboard); `query` holds the inputs,
    e.g. `{name-first, name-last, birthdate, address-country-code}` for a
    watchlist or `{business-name, address-street-1, address-city,
    address-subdivision, address-postal-code}` for a business lookup.
    `opts`: `account-id`, `meta` (e.g. `{auto-create-account-reference-id:
    "user-42"}`).

    **Example**

    ```hot
    report ::persona::reports/create-report("watchlist", "rptp_...", {
      name-first: "Jane", name-last: "Doe", address-country-code: "US"
    }, {}, {idempotency-key: "user-42-watchlist"})
    ```
    """
}
fn
(type-name: Str, template-id: Str?, query: Map): Map {
  create-report(type-name, template-id, query, {}, {})
},
(type-name: Str, template-id: Str?, query: Map, opts: Map): Map {
  create-report(type-name, template-id, query, opts, opts)
},
(type-name: Str, template-id: Str?, query: Map, opts: Map, options: Map): Map {
  ::api/send("POST", "/reports", {}, create-body(type-name, template-id, query, opts), options)
}

create-watchlist-report
meta {
    doc: """
    Run a `report/watchlist` (sanctions) screening on a person. `query` as
    in `create-report`; `term` can replace the name parts.

    **Example**

    ```hot
    report ::persona::reports/create-watchlist-report("rptp_123", {
      name-first: "Jane",
      name-last: "Doe",
      birthdate: "1990-01-31",
      address-country-code: "US"
    }, {idempotency-key: "user-42-watchlist"})
    report.data.id
    ```
    """
}
fn
(template-id: Str, query: Map): Map {
  create-report("watchlist", template-id, query, {}, {})
},
(template-id: Str, query: Map, options: Map): Map {
  create-report("watchlist", template-id, query, {}, options)
}

create-business-lookup-report
meta {
    doc: """
    Run a `report/business-lookup` (KYB registry lookup). `query` needs
    `business-name`, `address-street-1`, `address-city`,
    `address-subdivision`, `address-postal-code`; optional `ein`, `website`,
    `phone-number`, `address-country-code`, `associated-people`.

    **Example**

    ```hot
    report ::persona::reports/create-business-lookup-report("rptp_123", {
      business-name: "Acme Robotics LLC",
      address-street-1: "1 Main St",
      address-city: "Austin",
      address-subdivision: "TX",
      address-postal-code: "78701"
    })
    report.data.id
    ```
    """
}
fn
(template-id: Str, query: Map): Map {
  create-report("business-lookup", template-id, query, {}, {})
},
(template-id: Str, query: Map, options: Map): Map {
  create-report("business-lookup", template-id, query, {}, options)
}

get-report
meta {
    doc: """
    GET /reports/{id} - Retrieve a report. `opts` takes `include` and
    `fields`.

    **Example**

    ```hot
    report ::persona::reports/get-report("rep_123")
    if(::persona::reports/is-done(report), ::persona::reports/has-match(report), "still running")
    ```
    """
}
fn
(report-id: Str): Map {
  get-report(report-id, {}, {})
},
(report-id: Str, opts: Map): Map {
  get-report(report-id, opts, opts)
},
(report-id: Str, opts: Map, options: Map): Map {
  ::api/send("GET", `/reports/${seg(report-id)}`, ::api/read-query(opts), null, options)
}

list-reports
meta {
    doc: """
    GET /reports - One page of reports. Filters: `reference-id`,
    `account-id`. `opts` takes `page-size`, `after`, `before`.

    **Example**

    ```hot
    page ::persona::reports/list-reports({reference-id: "user-42"}, {page-size: 25})
    map(page.data, %.id)
    ```
    """
}
fn
(filters: Map): Map {
  list-reports(filters, {}, {})
},
(filters: Map, opts: Map): Map {
  list-reports(filters, opts, opts)
},
(filters: Map, opts: Map, options: Map): Map {
  ::api/list-page("/reports", filters, opts, options)
}

rerun-report
meta {
    doc: """
    POST /reports/{id}/run - Re-run a (continuously monitored) report now.
    Watch for the next `.ready` event.

    **Example**

    ```hot
    ::persona::reports/rerun-report("rep_123")
    ```
    """
}
fn
(report-id: Str): Map {
  rerun-report(report-id, {})
},
(report-id: Str, options: Map): Map {
  ::api/send("POST", `/reports/${seg(report-id)}/run`, {}, null, options)
}

redact-report
meta {
    doc: """
    DELETE /reports/{id} - Permanently remove a report's PII.

    **Example**

    ```hot
    ::persona::reports/redact-report("rep_123")
    ```
    """
}
fn
(report-id: Str): Map {
  redact-report(report-id, {})
},
(report-id: Str, options: Map): Map {
  ::api/send("DELETE", `/reports/${seg(report-id)}`, {}, null, options)
}

add-tag
meta {
    doc: """
    POST /reports/{id}/add-tag - Add a tag by name.

    **Example**

    ```hot
    ::persona::reports/add-tag("rep_123", "reviewed")
    ```
    """
}
fn
(report-id: Str, tag-name: Str): Map {
  add-tag(report-id, tag-name, {})
},
(report-id: Str, tag-name: Str, options: Map): Map {
  ::api/send("POST", `/reports/${seg(report-id)}/add-tag`, {}, ::api/meta-document({tag-name: tag-name}), options)
}

print-report
meta {
    doc: """
    GET /reports/{id}/print - The report as a PDF (`Bytes`).

    **Example**

    ```hot
    pdf ::persona::reports/print-report("rep_123")
    length(pdf)
    ```
    """
}
fn
(report-id: Str): Bytes {
  print-report(report-id, {})
},
(report-id: Str, options: Map): Bytes {
  ::api/get-bytes(`/reports/${seg(report-id)}/print`, options)
}

is-done
meta {
    doc: """
    True when a report has finished: status `ready` or `errored`.

    **Example**

    ```hot
    ::persona::reports/is-done({data: {id: "rep_1", type: "report/watchlist", attributes: {status: "ready"}}})  // true
    ::persona::reports/is-done({data: {id: "rep_2", type: "report/watchlist", attributes: {status: "pending"}}})  // false
    ```
    """
}
fn (doc: Any): Bool {
  in(or(::api/attr(doc, "status"), ""), ["ready", "errored"])
}

has-match
meta {
    doc: """
    True when a ready report found a match (`has-match`).

    **Example**

    ```hot
    ::persona::reports/has-match({data: {id: "rep_1", type: "report/watchlist", attributes: {status: "ready", has-match: true}}})  // true
    ::persona::reports/has-match({data: {id: "rep_2", type: "report/watchlist", attributes: {status: "ready", has_match: false}}})  // false
    ```
    """
}
fn (doc: Any): Bool {
  eq(::api/attr(doc, "has-match"), true)
}
