::stripe::balance ns
meta {
    doc: """Account balance and balance transactions (the ledger behind every charge, refund, payout, and fee). See https://docs.stripe.com/api/balance."""
}

api-call ::stripe::api/call
seg ::stripe::api/encode-id

// ============================================================================
// Balance
// ============================================================================

get-balance
meta {
    doc: """
GET /v1/balance - Retrieve the current account balance.

**Example**

```hot
balance ::stripe::balance/get-balance()
balance.available  // => [{amount: 12300, currency: "usd", ...}]
balance.pending    // => [{amount: 4500, currency: "usd", ...}]
```
"""
}
fn
(): Map {
  get-balance({})
},
(opts: Map): Map {
  api-call("GET", "/v1/balance", "", opts)
}

get-balance-transaction
meta {
    doc: """GET /v1/balance_transactions/{id} - Retrieve a balance transaction (charge, refund, payout, fee, ...) by ID."""
}
fn
(transaction: Str): Map {
  get-balance-transaction(transaction, {})
},
(transaction: Str, opts: Map): Map {
  api-call("GET", `/v1/balance_transactions/${seg(transaction)}`, "", opts)
}

ListBalanceTransactionsRequest type {
  type: Str?,
  payout: Str?,
  source: Str?,
  currency: Str?,
  created: Any?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-balance-transactions
meta {
    doc: """GET /v1/balance_transactions - List balance transactions, most recent first. Filter by `type` (e.g. "charge", "refund", "payout"), `payout` (the transactions a payout settled), or `source`."""
}
fn
(): Map {
  list-balance-transactions(ListBalanceTransactionsRequest({}))
},
(request: ListBalanceTransactionsRequest): Map {
  list-balance-transactions(request, {})
},
(request: ListBalanceTransactionsRequest, opts: Map): Map {
  api-call("GET", "/v1/balance_transactions", request, opts)
}
