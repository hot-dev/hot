::hot::pkg ns

hot.pkg.slack-admin {
  name: "hot.dev/slack-admin",
  version: "0.11.2",
  hot-min-version: "3.0.3",
  description: "Slack Admin API (admin.*) bindings for Hot on Enterprise organizations: conversations (bulk archive/delete/move, retention, sharing), workspaces, users and sessions, apps, emoji, invite requests, IDP groups, roles, information barriers, auth policies, analytics, workflows and functions, with ok:false error handling and cursor pagination.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["messaging"],
  deps: {
    "hot.dev/slack": "1.2.1"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
