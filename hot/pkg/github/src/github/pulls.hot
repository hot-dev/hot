list-review-comments
meta {
    doc: """
    GET /repos/{owner}/{repo}/pulls/{number}/comments - Inline review
    comments across all reviews. `params` supports `sort`, `direction`,
    `since`, `per_page`, and `page`.

    **Example**

    ```hot
    comments ::github::pulls/list-review-comments("acme", "api", 68, {sort: "created", direction: "desc"})
    map(comments, %.path)
    ```
    """
}
fn
(owner: Str, repo: Str, number: Int): Vec {
  ::api/json("GET", `${pull-path(owner, repo, number)}/comments`)
},
(owner: Str, repo: Str, number: Int, params: Map): Vec {
  list-review-comments(owner, repo, number, params, {})
},
(owner: Str, repo: Str, number: Int, params: Map, opts: Map): Vec {
  ::api/json("GET", `${pull-path(owner, repo, number)}/comments${query-string(params)}`, {}, "", opts)
}

list-review-comments-for-review
meta {
    doc: """
    GET /repos/{owner}/{repo}/pulls/{number}/reviews/{review_id}/comments -
    Inline comments belonging to one review. `params` supports `per_page`
    and `page`.

    **Example**

    ```hot
    comments ::github::pulls/list-review-comments-for-review("acme", "api", 68, 9001)
    map(comments, %.body)
    ```
    """
}
fn
(owner: Str, repo: Str, number: Int, review-id: Any): Vec {
  ::api/json("GET", `${review-path(owner, repo, number, review-id)}/comments`)
},
(owner: Str, repo: Str, number: Int, review-id: Any, params: Map): Vec {
  list-review-comments-for-review(owner, repo, number, review-id, params, {})
},
(owner: Str, repo: Str, number: Int, review-id: Any, params: Map, opts: Map): Vec {
  ::api/json(
    "GET",
    `${review-path(owner, repo, number, review-id)}/comments${query-string(params)}`
  , {}, "", opts)
}

create-review
meta {
    doc: """
    POST /repos/{owner}/{repo}/pulls/{number}/reviews - Review a PR.

    The Map form supports `commit_id`, `body`, `event` ("APPROVE",
    "REQUEST_CHANGES", or "COMMENT"), and an inline `comments` Vec. The
    event/body form remains as a concise summary-review convenience.

    **Example**

    ```hot
    ::github::pulls/create-review("acme", "api", 68, "APPROVE", "Looks good.")

    // Map form, with an inline comment
    ::github::pulls/create-review("acme", "api", 68, {
      event: "COMMENT",
      body: "One question.",
      comments: [{path: "src/limit.hot", line: 12, side: "RIGHT", body: "Why 60?"}]
    })
    ```
    """
}
fn
(owner: Str, repo: Str, number: Int, review: Map): Map {
  create-review(owner, repo, number, review, {})
},
(owner: Str, repo: Str, number: Int, review: Map, opts: Map): Map {
  ::api/json("POST", `${pull-path(owner, repo, number)}/reviews`, {}, review, opts)
},
(owner: Str, repo: Str, number: Int, event: Str, body: Str): Map {
  create-review(owner, repo, number, event, body, {})
},
(owner: Str, repo: Str, number: Int, event: Str, body: Str, opts: Map): Map {
  create-review(owner, repo, number, {event: event, body: body}, opts)
}

