CreateChannelInviteRequest type {
  channel_id: Str,
  max_age: Int?,
  max_uses: Int?,
  temporary: Bool?,
  unique: Bool?,
  target_type: Int?,
  target_user_id: Str?,
  target_application_id: Str?,
  role_ids: Vec<Str>?,
  reason: Str?
