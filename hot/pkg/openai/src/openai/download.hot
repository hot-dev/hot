::openai::download ns

api-request ::openai::api/request
HttpError ::openai::api/HttpError
is-ok-response ::hot::http/is-ok-response

DownloadFileRequest type {
  file-id: Str
}

// `value` is the file's content as the API returned it: text, parsed JSON, or Bytes.
DownloadFileResponse type {
    value: Any
}


retrieve-file-content
meta {
    doc: """
    GET /files/{file_id}/content - Download the contents of an uploaded
    file.

    **Example**

    ```hot
    contents ::openai::download/retrieve-file-content(::openai::download/DownloadFileRequest({
      file-id: "file-abc123"
    }))
    contents.value
    ```
    """
}
fn
(request: DownloadFileRequest): DownloadFileResponse {
  retrieve-file-content(request, {})
},
(request: DownloadFileRequest, opts: Map): DownloadFileResponse {
  response api-request("GET", `/files/${request.file-id}/content`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { DownloadFileResponse({value: response.body}) }
    => { err(HttpError(response)) }
  }
}
