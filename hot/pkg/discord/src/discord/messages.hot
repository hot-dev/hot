  channel_id: Str,
  message_id: Str
}

delete-all-reactions
meta {
    doc: """DELETE /channels/{channel_id}/messages/{message_id}/reactions - Remove every reaction from a message. Needs MANAGE_MESSAGES."""
}
fn (request: DeleteAllReactionsRequest): Bool {
  ::api/call-ok("DELETE", `/channels/${seg(request.channel_id)}/messages/${seg(request.message_id)}/reactions`)
}

DeleteAllReactionsForEmojiRequest type {
  channel_id: Str,
  message_id: Str,
  emoji: Str
}

delete-all-reactions-for-emoji
meta {
    doc: """DELETE /channels/{channel_id}/messages/{message_id}/reactions/{emoji} - Remove every reaction of one emoji. Needs MANAGE_MESSAGES."""
}
fn (request: DeleteAllReactionsForEmojiRequest): Bool {
