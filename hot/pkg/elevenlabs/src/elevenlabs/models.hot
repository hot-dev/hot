::elevenlabs::models ns
meta {
    doc: """ElevenLabs models: the text-to-speech and speech-to-speech models available to your account."""
}

::api ::elevenlabs::api

list-models
meta {
    ctx: {"elevenlabs.api.key": {required: true}},
    doc: """
    GET /v1/models: the available models with their capabilities and
    languages (`model_id`, `name`, `can_do_text_to_speech`,
    `languages`, `max_characters_request_free_user`, ...), e.g.
    "eleven_multilingual_v2", "eleven_flash_v2_5", "eleven_v3".

    **Example**

    ```hot
    tts-models filter(::elevenlabs::models/list-models(), (m) { m.can_do_text_to_speech })
    ```
    """
}
fn (): Vec {
  ::api/json("GET", "/v1/models")
}
