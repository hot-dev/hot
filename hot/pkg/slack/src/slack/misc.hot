}


migration-exchange
meta {
    doc: """
    GET /migration.exchange - Exchange legacy user IDs to new Enterprise
    Grid format. Pass a comma-separated list of user IDs. Set `to_old: true`
    to convert in the reverse direction.

    **Example**

    ```hot
    response ::slack::misc/migration-exchange(::slack::misc/MigrationExchangeRequest({
      users: "U1234567,U2345678"
    }))
    response.user_id_map
    ```
    """
}
fn
(request: MigrationExchangeRequest): MigrationExchangeResponse {
  migration-exchange(request, {})
},
(request: MigrationExchangeRequest, opts: Map): MigrationExchangeResponse {
  response api-request("GET", ::slack::api/with-query(`${::slack::core/BASE_URL}/migration.exchange`, {users: request.users, team_id: request.team_id, to_old: request.to_old}), {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { MigrationExchangeResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

