::openfigi::test::fixtures ns

// Real responses from https://api.openfigi.com/v3, retrieved 3 Nov 2026
// without an API key.

// Results of POST /mapping for these jobs, from two calls: a match by
// ISIN, a match by ticker, an unknown ticker (warning), and an ISIN that
// fails OpenFIGI's format check (error)
MAPPING_JOBS [
  {idType: "ID_ISIN", idValue: "US0378331005", exchCode: "US"},
  {idType: "TICKER", idValue: "IBM", exchCode: "US"},
  {idType: "TICKER", idValue: "ZZQXQZ", exchCode: "US"},
  {idType: "ID_ISIN", idValue: "XX0000000000"}
]

MAPPING_RESULTS [
  {data: [{
    figi: "BBG000B9XRY4",
    name: "APPLE INC",
    ticker: "AAPL",
    exchCode: "US",
    compositeFIGI: "BBG000B9XRY4",
    securityType: "Common Stock",
    marketSector: "Equity",
    shareClassFIGI: "BBG001S5N8V8",
    securityType2: "Common Stock",
    securityDescription: "AAPL"
  }]},
  {data: [{
    figi: "BBG000BLNNH6",
    name: "INTL BUSINESS MACHINES CORP",
    ticker: "IBM",
    exchCode: "US",
    compositeFIGI: "BBG000BLNNH6",
