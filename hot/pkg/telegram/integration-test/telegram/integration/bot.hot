::telegram::integration::bot ns
meta ["test"]

::ctx ::telegram::integration::ctx
::bot ::telegram::bot

test-get-me
meta ["test"]
fn () {
  cond {
    not(::ctx/configured()) => { ::ctx/skip(::ctx/UNCONFIGURED) }
    => {
      response ::bot/get-me()

      assert(response.id, "getMe should return bot id")
      assert(response.username, "getMe should return username")
      assert(response.first_name, "getMe should return first_name")
      assert(response.is_bot, "is_bot should be true")
    }
  }
}

// Sets a temporary command list and restores the bot's original one
// (deleting the list again only if there was none).
test-get-and-set-commands
meta ["test"]
fn () {
  cond {
    not(::ctx/configured()) => { ::ctx/skip(::ctx/UNCONFIGURED) }
    => {
      original ::bot/get-my-commands(::bot/GetMyCommandsRequest({}))

      ::bot/set-my-commands(::bot/SetMyCommandsRequest({
        commands: [
          {command: "start", description: "Start the bot"},
          {command: "help", description: "Show help"}
        ]
      }))

      commands ::bot/get-my-commands(::bot/GetMyCommandsRequest({}))

      // Restore before asserting, so a failed assertion can't leave the
      // test commands behind.
      cond {
        is-empty(original) => { ::bot/delete-my-commands(::bot/DeleteMyCommandsRequest({})) }
        => { ::bot/set-my-commands(::bot/SetMyCommandsRequest({commands: original})) }
      }

      assert-eq(2, length(commands), "should have 2 commands")
      assert-eq("start", first(commands).command, "first command should be start")
      assert-eq("help", last(commands).command, "second command should be help")

      restored ::bot/get-my-commands(::bot/GetMyCommandsRequest({}))
      assert-eq(length(original), length(restored), "original commands should be restored")
    }
  }
}

test-get-my-name
meta ["test"]
fn () {
  cond {
    not(::ctx/configured()) => { ::ctx/skip(::ctx/UNCONFIGURED) }
    => {
      response ::bot/get-my-name(::bot/GetMyNameRequest({}))

      assert(is-some(response.name), "getMyName should return a name field")
    }
  }
}

test-get-and-set-description
meta ["test"]
fn () {
  cond {
    not(::ctx/configured()) => { ::ctx/skip(::ctx/UNCONFIGURED) }
    => {
      original ::bot/get-my-description(::bot/GetMyDescriptionRequest({}))

      ::bot/set-my-description(::bot/SetMyDescriptionRequest({
        description: "Hot integration test bot"
      }))

      updated ::bot/get-my-description(::bot/GetMyDescriptionRequest({}))

      ::bot/set-my-description(::bot/SetMyDescriptionRequest({
        description: or(original.description, "")
      }))

      assert-eq("Hot integration test bot", updated.description, "description should match")
    }
  }
}

test-get-and-set-short-description
meta ["test"]
fn () {
  cond {
    not(::ctx/configured()) => { ::ctx/skip(::ctx/UNCONFIGURED) }
    => {
      original ::bot/get-my-short-description(::bot/GetMyShortDescriptionRequest({}))

      ::bot/set-my-short-description(::bot/SetMyShortDescriptionRequest({
        short_description: "Hot test bot"
      }))

      updated ::bot/get-my-short-description(::bot/GetMyShortDescriptionRequest({}))

      ::bot/set-my-short-description(::bot/SetMyShortDescriptionRequest({
        short_description: or(original.short_description, "")
      }))

      assert-eq("Hot test bot", updated.short_description, "short_description should match")
    }
  }
}
