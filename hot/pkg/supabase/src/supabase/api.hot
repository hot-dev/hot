::supabase::api ns
meta {
    doc: """
    Low-level requests to a Supabase project.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then context, then the environment. Nothing from `opts` is
    written to ctx, so one run can reach many projects and parallel flows
    don't share credentials.

    - `url`: the project URL
    - `anon-key` (or `api-key`): the anon/public key
    - `service-key` (or `service-role-key`): the service role key

    A `url` or key in `opts` means a different project or role, so context
    and environment keys are ignored for that call: a project's key is never
    sent to another project's URL. A `url` left out of `opts` still comes
    from context. One of those keys present but blank or null is an error,
    never a fallback to context.
    """
}

::core ::supabase::core

http-request ::hot::http/request
is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

AuthMode type "anon" | "user" | "service"

HttpError type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: response.headers,
    body: response.body
  })
}

has-body
meta {no-doc: true}
fn (body: Any): Bool {
  cond {
    is-map(body) => { not(is-empty(filter-vals(body, is-some))) }
    is-vec(body) => { not(is-empty(body)) }
    is-str(body) => { not(eq(body, "")) }
    => { is-some(body) }
  }
}

encode-body
meta {no-doc: true}
fn (body: Any): Str {
  cond {
    not(has-body(body)) => { "" }
    is-str(body) => { body }
    => { to-json(untype(body)) }
  }
}

body-or-error
meta {
    doc: """
    The body of a response. A non-2xx status becomes an Err carrying an
    `HttpError`, and an Err passes through. Pair it with the `request-raw`
    family when you want both.

    **Example**

    ```hot
    ::api ::supabase::api

    found ::hot::http/HttpResponse({status: 200, headers: {}, body: [{id: 1}]})
    ::api/body-or-error(found)  // [{id: 1}]

    missing ::hot::http/HttpResponse({status: 404, headers: {}, body: {message: "Not found"}})
    is-err(::api/body-or-error(missing))  // true
    ```
    """
}
fn (response: Result): Any {
  cond {
    is-err(response) => { response }
    not(is-ok-response(response)) => { err(HttpError(response)) }
    => { response.body }
  }
}

OPTS_KEYS ["url", "anon-key", "api-key", "service-key", "service-role-key"]

blank-credential
meta {
    doc: """
    The first of `names` that `opts` has but with a blank or null value,
    else null. Such a key is an error, never a fallback to context: a tenant
    whose key is missing must not run on the project's credentials.

    **Example**

    ```hot
    opts {url: "https://x.supabase.co", anon-key: ""}
    ::supabase::api/blank-credential(opts, ["url", "anon-key"])  // "anon-key"
    ::supabase::api/blank-credential(opts, ["url"])  // null
    ```
    """
}
fn (opts: Map, names: Vec): Str? {
  find-first(names, (name) { and(in(name, keys(opts)), or(is-null(get(opts, name)), and(is-str(get(opts, name)), is-empty(trim(Str(get(opts, name))))))) })
}

resolve-from
meta {
    doc: """
    The one resolver, pure: `{url, anon-key?, service-key?}` for a call
    from `opts` first, then `sources` (see `::supabase::core/sources-from`).
    A `url`, `anon-key`, `api-key`, `service-key` or `service-role-key` in
    `opts` means no key comes from `sources`. An Err when no URL is set,
    or when one of those keys is in `opts` but blank or null: that never
    falls back to context, or a tenant could run on the project's credentials.
    Exposed for testing; `resolve` feeds it the context and environment.

    **Example**

    ```hot
    ::api ::supabase::api

    sources {url: "https://main.supabase.co", anon-key: "main-anon", service-key: "main-service"}

    ::api/resolve-from({}, sources).anon-key  // "main-anon"

    // A url in opts means no key comes from sources
    ::api/resolve-from({url: "https://other.supabase.co"}, sources)  // {url: "https://other.supabase.co"}

    is-err(::api/resolve-from({anon-key: ""}, sources))  // true
    ```
    """
}
fn (opts: Map, sources: Map): Map {
  url ::core/first-secret([get(opts, "url")])
  anon ::core/first-secret([get(opts, "anon-key"), get(opts, "api-key")])
  service ::core/first-secret([get(opts, "service-key"), get(opts, "service-role-key")])
  per-call or(is-some(url), is-some(anon), is-some(service))
  resolved-url or(url, get(sources, "url"))
  blank blank-credential(opts, OPTS_KEYS)
  cond {
    is-some(blank) => {
      err(`supabase: ${blank} is in the call's opts but is blank or null. Pass a value, or leave ${blank} out to use context.`)
    }

    is-null(resolved-url) => { err("supabase.url is not set. Add one of: supabase.url or SUPABASE_URL, or pass url in the call's opts.") }
    => {
      filter-vals({
        url: resolved-url,
        anon-key: if(per-call, anon, get(sources, "anon-key")),
        service-key: if(per-call, service, get(sources, "service-key"))
      }, is-some)
    }
  }
}

resolve
meta {
    ctx: {
        "supabase.url": {required: false, secret: false},
        "supabase.anon.key": {required: false},
        "supabase.api.key": {required: false},
        "supabase.service.key": {required: false},
        "supabase.service.role.key": {required: false}
    },
    doc: """
    Credentials for one call (see `resolve-from`). `opts` values are never
    written to ctx. A credential from `opts` is masked in the run's call records.

    **Example**

    ```hot
    tenant {url: "https://tenant-b.supabase.co", anon-key: "tenant-b-anon"}
    ::supabase::api/resolve(tenant).url  // "https://tenant-b.supabase.co"
    ```
    """
}
fn (opts: Map): Map {
  ::hot::ctx/mark-secret([opts.anon-key, opts.api-key, opts.service-key, opts.service-role-key])
  resolve-from(opts, ::core/sources())
}

credentials-for
meta {
    doc: """
    The `{url, key}` a role sends, from resolved credentials (pure): `role`
    is `"anon"` or `"service"`. An Err when that role's key is missing.

    **Example**

    ```hot
    ::api ::supabase::api

    resolved {url: "https://x.supabase.co", anon-key: "anon"}
    ::api/credentials-for(resolved, "anon")  // {url: "https://x.supabase.co", key: "anon"}
    is-err(::api/credentials-for(resolved, "service"))  // true
    ```
    """
}
fn (resolved: Map, role: Str): Map {
  key if(eq(role, "service"), get(resolved, "service-key"), get(resolved, "anon-key"))
  cond {
    is-some(key) => { {url: resolved.url, key: key} }
    eq(role, "service") => {
      err("supabase.service.key is not set. Add one of: supabase.service.key, supabase.service.role.key, SUPABASE_SERVICE_KEY, or SUPABASE_SERVICE_ROLE_KEY, or pass service-key in the call's opts. A url or key in opts never borrows a key from context.")
    }
    => {
      err("supabase.anon.key is not set. Add one of: supabase.anon.key, supabase.api.key, SUPABASE_ANON_KEY, or SUPABASE_API_KEY, or pass anon-key in the call's opts. A url or key in opts never borrows a key from context.")
    }
  }
}

credentials
meta {no-doc: true}
fn (opts: Map, role: Str): Map {
  resolved resolve(opts)
  if(is-err(resolved), resolved, credentials-for(resolved, role))
}

request
meta {
    ctx: {"supabase.url": {required: false, secret: false}, "supabase.anon.key": {required: false}},
    doc: """
    Make an authenticated request to a Supabase project API. Sends the anon key as both the `apikey` header and the default Bearer token.

    Use `request-as` instead when you need to act as a specific user (with their access token).

    **Example**

    ```hot
    ::api ::supabase::api

    // GET request
    response ::api/request("GET", "/rest/v1/users?select=id,name")

    // POST request with body
    response ::api/request("POST", "/rest/v1/users", {Prefer: "return=representation"}, {name: "Alice"})

    // Per-call credentials: another project, for this call only
    tenant {url: "https://tenant-b.supabase.co", anon-key: "tenant-b-anon"}
    response ::api/request("GET", "/rest/v1/users?select=id", {}, {}, tenant)
    ```
    """
}
fn
(method: Str, path: Str): Any {
  request(method, path, {}, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any): Any {
  body-or-error(request-raw(method, path, additional-headers, body))
},
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): Any {
  body-or-error(request-raw(method, path, additional-headers, body, opts))
}

request-raw
meta {
    ctx: {"supabase.url": {required: false, secret: false}, "supabase.anon.key": {required: false}},
    doc: """
    Make an anon Supabase project API request and return the full
    `HttpResponse` including status and headers.

    **Example**

    ```hot
    ::api ::supabase::api

    response ::api/request-raw("GET", "/rest/v1/users?select=id")
    response.status

    // With headers and a body
    created ::api/request-raw("POST", "/rest/v1/users", {Prefer: "return=representation"}, {name: "Alice"})
    created.body
    ```
    """
}
fn
(method: Str, path: Str): HttpResponse {
  request-raw(method, path, {}, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any): HttpResponse {
  request-raw(method, path, additional-headers, body, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  creds credentials(opts, "anon")
  cond {
    is-err(creds) => { creds }
    => { do-request(method, path, additional-headers, body, creds.key, creds.key, creds.url) }
  }
}

request-as
meta {
    doc: """
    Make a request as a specific authenticated user. The anon key is still sent as the `apikey` header, but the user's access token is used as the Bearer token.

    **Example**

    ```hot
    ::api ::supabase::api

    token ::hot::ctx/get("supabase.user.token")

    // Get the current user's profile
    response ::api/request-as("GET", "/rest/v1/profiles?select=*", {}, {}, token)
    ```
    """
}
fn
(method: Str, path: Str, additional-headers: Map, body: Any, access-token: Str): Any {
  body-or-error(request-raw-as(method, path, additional-headers, body, access-token))
},
(method: Str, path: Str, additional-headers: Map, body: Any, access-token: Str, opts: Map): Any {
  body-or-error(request-raw-as(method, path, additional-headers, body, access-token, opts))
}

request-raw-as
meta {
    doc: """
    Make a request as a specific user and return the full `HttpResponse`.

    **Example**

    ```hot
    ::api ::supabase::api

    token ::hot::ctx/get("supabase.user.token")
    response ::api/request-raw-as("GET", "/rest/v1/profiles?select=*", {}, {}, token)
    response.status
    response.body
    ```
    """
}
fn
(method: Str, path: Str, additional-headers: Map, body: Any, access-token: Str): HttpResponse {
  request-raw-as(method, path, additional-headers, body, access-token, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any, access-token: Str, opts: Map): HttpResponse {
  creds credentials(opts, "anon")
  cond {
    is-err(creds) => { creds }
    => { do-request(method, path, additional-headers, body, creds.key, access-token, creds.url) }
  }
}

request-service
meta {
    ctx: {"supabase.url": {required: false, secret: false}, "supabase.service.key": {required: false}},
    doc: """
    Make a request using the service role key (bypasses RLS). Used
    internally by auth-admin and other admin modules.

    **Example**

    ```hot
    ::api ::supabase::api

    // Every row, regardless of row level security
    users ::api/request-service("GET", "/rest/v1/users?select=id,email")

    // Another project, for this call only
    tenant {url: "https://tenant-b.supabase.co", service-key: ::hot::ctx/get("tenant.service.key")}
    tenant-users ::api/request-service("GET", "/rest/v1/users?select=id", {}, {}, tenant)
    ```
    """
}
fn
(method: Str, path: Str): Any {
  request-service(method, path, {}, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any): Any {
  body-or-error(request-raw-service(method, path, additional-headers, body))
},
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): Any {
  body-or-error(request-raw-service(method, path, additional-headers, body, opts))
}

request-raw-service
meta {
    ctx: {"supabase.url": {required: false, secret: false}, "supabase.service.key": {required: false}},
    doc: """
    Make a service-role request and return the full `HttpResponse`.

    **Example**

    ```hot
    ::api ::supabase::api

    response ::api/request-raw-service("GET", "/auth/v1/admin/users")
    response.status
    response.body
    ```
    """
}
fn
(method: Str, path: Str): HttpResponse {
  request-raw-service(method, path, {}, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any): HttpResponse {
  request-raw-service(method, path, additional-headers, body, {})
},
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  creds credentials(opts, "service")
  cond {
    is-err(creds) => { creds }
    => { do-request(method, path, additional-headers, body, creds.key, creds.key, creds.url) }
  }
}

do-request
meta {no-doc: true}
fn
(method: Str, path: Str, additional-headers: Map, body: Any, apikey: Str, bearer-token: Str): HttpResponse {
  do-request(method, path, additional-headers, body, apikey, bearer-token, ::core/project-url())
},
(method: Str, path: Str, additional-headers: Map, body: Any, apikey: Str, bearer-token: Str, base-url: Str): HttpResponse {
  ::hot::ctx/mark-secret([apikey, bearer-token])
  http-request(build-request(method, path, additional-headers, body, apikey, bearer-token, base-url))
}

build-request
meta {
    doc: """
    The outgoing `HttpRequest`: `apikey` and `Authorization: Bearer`
    headers, `additional-headers` on top, and `Content-Type` only with a
    body. Pure; exposed for testing.

    **Example**

    ```hot
    ::api ::supabase::api

    req ::api/build-request("POST", "/rest/v1/todos", {Prefer: "return=minimal"}, {title: "Ship"}, "anon", "user-jwt", "https://x.supabase.co")
    req.url  // "https://x.supabase.co/rest/v1/todos"
    req.headers.Authorization  // "Bearer user-jwt"
    req.body  // "{\"title\":\"Ship\"}"
    ```
    """
}
fn (method: Str, path: Str, additional-headers: Map, body: Any, apikey: Str, bearer-token: Str, base-url: Str): HttpRequest {
  url `${base-url}${path}`

  default-headers {
    apikey: apikey,
    Authorization: `Bearer ${bearer-token}`
  }

  has-request-body has-body(body)
  headers if(has-request-body, merge(default-headers, {Content-Type: "application/json"}), default-headers)
  final-headers merge(headers, additional-headers)

  HttpRequest({
    method: method,
    url: url,
    headers: final-headers,
    body: encode-body(body)
  })
}

request-with-keys
meta {
    doc: """
    Make a Supabase request with explicit API and bearer keys. Useful for
    tests and scripts that do not use context.

    **Example**

    ```hot
    ::api ::supabase::api

    anon ::hot::ctx/get("tenant.anon.key")

    // Project URL from context
    users ::api/request-with-keys("GET", "/rest/v1/users?select=id", {}, {}, anon, anon)

    // Explicit project URL
    tenant-users ::api/request-with-keys("GET", "/rest/v1/users?select=id", {}, {}, anon, anon, "https://tenant-b.supabase.co")
    ```
    """
}
fn
(method: Str, path: Str, additional-headers: Map, body: Any, apikey: Str, bearer-token: Str): Any {
  body-or-error(do-request(method, path, additional-headers, body, apikey, bearer-token))
},
// 7-arity: explicit project URL too — target a different Supabase project than the ctx one
(method: Str, path: Str, additional-headers: Map, body: Any, apikey: Str, bearer-token: Str, project-url: Str): Any {
  body-or-error(do-request(method, path, additional-headers, body, apikey, bearer-token, project-url))
}

request-raw-with-keys
meta {
    doc: """
    Make a Supabase request with explicit API and bearer keys and return the
    full `HttpResponse`.

    **Example**

    ```hot
    ::api ::supabase::api

    anon ::hot::ctx/get("tenant.anon.key")

    response ::api/request-raw-with-keys("GET", "/rest/v1/users?select=id", {}, {}, anon, anon, "https://tenant-b.supabase.co")
    response.status
    ```
    """
}
fn
(method: Str, path: Str, additional-headers: Map, body: Any, apikey: Str, bearer-token: Str): HttpResponse {
  do-request(method, path, additional-headers, body, apikey, bearer-token)
},
// 7-arity: explicit project URL too
(method: Str, path: Str, additional-headers: Map, body: Any, apikey: Str, bearer-token: Str, project-url: Str): HttpResponse {
  do-request(method, path, additional-headers, body, apikey, bearer-token, project-url)
}

request-raw-body
meta {
    doc: """
    Make an anon request with an already-encoded raw body. Use for storage
    uploads and non-JSON payloads.

    **Example**

    ```hot
    ::api ::supabase::api

    response ::api/request-raw-body("POST", "/storage/v1/object/notes/todo.txt", {Content-Type: "text/plain"}, "Buy milk")
    response.status
    ```
    """
}
fn
(method: Str, path: Str, additional-headers: Map, body-raw: Str): HttpResponse {
  request-raw-body(method, path, additional-headers, body-raw, {})
},
(method: Str, path: Str, additional-headers: Map, body-raw: Str, opts: Map): HttpResponse {
  creds credentials(opts, "anon")
  cond {
    is-err(creds) => { creds }
    => { do-raw-body-request(method, path, additional-headers, body-raw, creds.key, creds.key, creds.url) }
  }
}

request-raw-body-as
meta {
    doc: """
    Make a user-authenticated request with an already-encoded raw body.

    **Example**

    ```hot
    ::api ::supabase::api

    token ::hot::ctx/get("supabase.user.token")
    response ::api/request-raw-body-as("POST", "/storage/v1/object/notes/todo.txt", {Content-Type: "text/plain"}, "Buy milk", token)
    response.status
    ```
    """
}
fn
(method: Str, path: Str, additional-headers: Map, body-raw: Str, access-token: Str): HttpResponse {
  request-raw-body-as(method, path, additional-headers, body-raw, access-token, {})
},
(method: Str, path: Str, additional-headers: Map, body-raw: Str, access-token: Str, opts: Map): HttpResponse {
  creds credentials(opts, "anon")
  cond {
    is-err(creds) => { creds }
    => { do-raw-body-request(method, path, additional-headers, body-raw, creds.key, access-token, creds.url) }
  }
}

request-raw-body-service
meta {
    doc: """
    Make a service-role request with an already-encoded raw body.

    **Example**

    ```hot
    ::api ::supabase::api

    response ::api/request-raw-body-service("POST", "/storage/v1/object/notes/todo.txt", {Content-Type: "text/plain"}, "Buy milk")
    response.status
    ```
    """
}
fn
(method: Str, path: Str, additional-headers: Map, body-raw: Str): HttpResponse {
  request-raw-body-service(method, path, additional-headers, body-raw, {})
},
(method: Str, path: Str, additional-headers: Map, body-raw: Str, opts: Map): HttpResponse {
  creds credentials(opts, "service")
  cond {
    is-err(creds) => { creds }
    => { do-raw-body-request(method, path, additional-headers, body-raw, creds.key, creds.key, creds.url) }
  }
}

do-raw-body-request
meta {no-doc: true}
fn
(method: Str, path: Str, additional-headers: Map, body-raw: Str, apikey: Str, bearer-token: Str): HttpResponse {
  do-raw-body-request(method, path, additional-headers, body-raw, apikey, bearer-token, ::core/project-url())
},
(method: Str, path: Str, additional-headers: Map, body-raw: Str, apikey: Str, bearer-token: Str, base-url: Str): HttpResponse {
  ::hot::ctx/mark-secret([apikey, bearer-token])
  url `${base-url}${path}`

  default-headers {
    apikey: apikey,
    Authorization: `Bearer ${bearer-token}`
  }

  final-headers merge(default-headers, additional-headers)

  http-request(HttpRequest({
    method: method,
    url: url,
    headers: final-headers,
    body: body-raw
  }))
}
