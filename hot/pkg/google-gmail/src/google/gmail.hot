::google::gmail ns
meta {
    doc: """
    Gmail API v1 bindings: send safe MIME email (HTML, attachments,
    non-ASCII headers, large messages), reply and forward in thread,
    search and read messages as plain records, threads, drafts, labels,
    and incremental sync with Pub/Sub push notifications. Credentials and
    scopes come from `google-core`.

    **Namespaces**

    - `::google::gmail::mime` - build RFC 5322 messages as Bytes (header
      injection safe, RFC 2047 encoding, multipart, attachments)
    - `::google::gmail::messages` - send, reply, reply-all, forward,
      list/search, get, modify labels, batch modify, trash, attachments
    - `::google::gmail::parse` - read a message: headers, text and HTML
      bodies, attachment list, `to-email`
    - `::google::gmail::threads` - list, get, modify, trash
    - `::google::gmail::drafts` - create (or a reply draft), update,
      send, list, get, delete
    - `::google::gmail::labels` - list, get, create, update, delete,
      `ensure-label`
    - `::google::gmail::sync` - profile, history (incremental sync),
      `watch` / `stop-watch`, Pub/Sub push parsing and verification

    Every function has an options arity taking an `opts` Map. Gmail query
    parameters use Gmail's own names (`q`, `maxResults`, `pageToken`,
    `labelIds`, `format`, ...); credential keys (`token`,
    `refresh-token`, `service-account`, `subject`, `scopes`, `retry`) are
    handled by `google-core` and override context for that call.

    **Service accounts.** Gmail has no service-account mailboxes: a
    service account must use domain-wide delegation and impersonate a
    Workspace user (`google.impersonate`, or `subject` per call).

    **Quick start**

    ```hot
    ::messages ::google::gmail::messages

    ::messages/send({to: "ada@example.com", subject: "Weekly report", text: "All green.", html: "<p>All <b>green</b>.</p>"})

    unread ::messages/search-emails("is:unread newer_than:7d", 20)
    first(unread).subject
    ```
    """
}

::api ::google::api
::ctx ::hot::ctx
::uri ::hot::uri

API_ROOT "https://gmail.googleapis.com"
BASE_URL "https://gmail.googleapis.com/gmail/v1/users/me"
UPLOAD_URL "https://gmail.googleapis.com/upload/gmail/v1/users/me"

// Scopes. gmail.readonly, gmail.modify, gmail.compose and the full
// https://mail.google.com/ scope are restricted (public apps need
// verification plus a security assessment); gmail.send and gmail.labels
// are sensitive.
READ_SCOPE "https://www.googleapis.com/auth/gmail.readonly"
METADATA_SCOPE "https://www.googleapis.com/auth/gmail.metadata"
MODIFY_SCOPE "https://www.googleapis.com/auth/gmail.modify"
SEND_SCOPE "https://www.googleapis.com/auth/gmail.send"
COMPOSE_SCOPE "https://www.googleapis.com/auth/gmail.compose"
LABELS_SCOPE "https://www.googleapis.com/auth/gmail.labels"
FULL_SCOPE "https://mail.google.com/"

// System label ids.
INBOX "INBOX"
UNREAD "UNREAD"
STARRED "STARRED"
IMPORTANT "IMPORTANT"
SPAM "SPAM"
TRASH "TRASH"
SENT "SENT"
DRAFT "DRAFT"

// ---------------------------------------------------------------------------
// URL and parameter helpers (shared by the sub-namespaces)
// ---------------------------------------------------------------------------

api-root
meta {
    ctx: {"google.gmail.api-root": {required: false, secret: false}},
    doc: """
    The API root, `https://gmail.googleapis.com` unless the
    `google.gmail.api-root` context variable points at a proxy or emulator.

    **Example**

    ```hot
    ::google::gmail/api-root()
    ```
    """
}
fn (): Str {
  root ::ctx/get("google.gmail.api-root")
  if(or(is-null(root), eq(root, "")), API_ROOT, root)
}

url
meta {
    doc: """
    A Gmail v1 URL for the authenticated user (`/gmail/v1/users/me` +
    `path`) with non-null `params` as a query string (Vec values repeat the
    key).

    **Example**

    ```hot
    ::google::gmail/url("/profile")

    ::google::gmail/url("/messages", {q: "is:unread", labelIds: ["INBOX", "STARRED"]})
    ```
    """
}
fn
(path: Str): Str {
  url(path, {})
},
(path: Str, params: Map): Str {
  ::api/with-query(`${api-root()}/gmail/v1/users/me${path}`, params)
}

upload-url
meta {
    doc: """
    A Gmail v1 media-upload URL (`/upload/gmail/v1/users/me` + `path`) with
    `params`.

    **Example**

    ```hot
    ::google::gmail/upload-url("/messages/send", {uploadType: "multipart"})
    ```
    """
}
fn (path: Str, params: Map): Str {
  ::api/with-query(`${api-root()}/upload/gmail/v1/users/me${path}`, params)
}

encode-id
meta {
    doc: """
    URL-encode an id for a path segment.

    **Example**

    ```hot
    ::google::gmail/encode-id("a/b")  // "a%2Fb"
    ```
    """
}
fn (id: Str): Str {
  ::uri/encode(id)
}

query-params
meta {
    doc: """
    Build a call's query parameters: `defaults`, overridden by the Gmail
    parameters in `opts` (credential keys and the function's own
    `local-keys` are removed), with nulls dropped. Pass a key as null in
    `opts` to drop a default.

    **Example**

    ```hot
    ::google::gmail/query-params({format: "full"}, {format: "raw", retry: 3})  // {format: "raw"}
    ::google::gmail/query-params({format: "full"}, {format: null})  // {}
    ::google::gmail/query-params({}, {q: "is:unread", upload: true}, ["upload"])  // {q: "is:unread"}
    ```
    """
}
fn
(defaults: Map, opts: Map): Map {
  query-params(defaults, opts, [])
},
(defaults: Map, opts: Map, local-keys: Vec): Map {
  params filter-keys(::api/api-params(opts), (k) { not(in(k, local-keys)) })
  filter-vals({...defaults, ...params}, is-some)
}

creds
meta {
    doc: """
    The google-core part of `opts` (credentials, scopes, retry), passed
    through to `::google::api`.

    **Example**

    ```hot
    ::google::gmail/creds({q: "is:unread", retry: 3, subject: "ada@example.com"})  // {retry: 3, subject: "ada@example.com"}
    ```
    """
}
fn (opts: Map): Map {
  ::api/credential-opts(opts)
}

json
meta {
    doc: """
    `::google::api/json` with this package's conventions: credential opts
    and a JSON (or empty) body.

    **Example**

    ```hot
    ::gmail ::google::gmail

    profile ::gmail/json(::gmail/READ_SCOPE, "GET", ::gmail/url("/profile"), "", {})
    profile.emailAddress
    ```
    """
}
fn (scope: Str, method: Str, full-url: Str, body: Any, opts: Map): Any {
  ::api/json(scope, method, full-url, {}, body, creds(opts))
}

compact
meta {
    doc: """
    Drop null values from a request body (Gmail bodies never carry JSON null
    for unset fields).

    **Example**

    ```hot
    ::google::gmail/compact({id: "d1", threadId: null})  // {id: "d1"}
    ```
    """
}
fn (body: Map): Map {
  filter-vals(untype(body), is-some)
}

done
meta {
    doc: """
    `true` for a successful call whose response has no useful body (delete,
    stop), or the call's Err.

    **Example**

    ```hot
    ::google::gmail/done({})  // true
    is-err(::google::gmail/done(err("denied")))  // true
    ```
    """
}
fn (result: Result): Bool {
  if(is-err(result), result, true)
}

// ---------------------------------------------------------------------------
// Shortcuts to the most used functions (the full surface lives in the
// sub-namespaces listed in the namespace doc)
// ---------------------------------------------------------------------------

send ::google::gmail::messages/send
send-message ::google::gmail::messages/send-message
reply ::google::gmail::messages/reply
reply-all ::google::gmail::messages/reply-all
forward ::google::gmail::messages/forward
list-messages ::google::gmail::messages/list-messages
list-all-messages ::google::gmail::messages/list-all-messages
search-emails ::google::gmail::messages/search-emails
get-message ::google::gmail::messages/get-message
get-email ::google::gmail::messages/get-email
modify-message ::google::gmail::messages/modify-message
trash-message ::google::gmail::messages/trash-message
to-email ::google::gmail::parse/to-email
list-labels ::google::gmail::labels/list-labels
get-profile ::google::gmail::sync/get-profile
