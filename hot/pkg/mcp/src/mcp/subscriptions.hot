::mcp::subscriptions ns
meta {
    doc: """
Long-lived notification subscriptions for MCP 2026-07-28.

The modern `subscriptions/listen` request replaces legacy GET notification
streams. Every notification category is explicitly opted in.
"""
}

::client ::mcp::client
::types ::mcp::types

wire-filter
meta {
    doc: """
    Convert a typed subscription filter to the MCP wire shape.

    **Example**

    ```hot
    opt-ins ::mcp::types/SubscriptionFilter({tools-list-changed: true})
    ::mcp::subscriptions/wire-filter(opt-ins)  // {toolsListChanged: true}
    ```
    """
}
fn (filter: ::types/SubscriptionFilter): Map {
  {}
    |> assoc-some("toolsListChanged", filter.tools-list-changed)
    |> assoc-some("promptsListChanged", filter.prompts-list-changed)
    |> assoc-some("resourcesListChanged", filter.resources-list-changed)
    |> assoc-some("resourceSubscriptions", filter.resource-subscriptions)
}

require-supported
meta {no-doc: true}
fn (supported: Bool, message: Str): Any {
  if(supported, null, fail(message))
}

validate-filter
meta {
    doc: """
    Validate subscription opt-ins against discovered server capabilities.

    **Example**

    ```hot
    session ::mcp::types/Session({
      url: "https://mcp.example.com/mcp",
      protocol-version: "2026-07-28",
      server-info: ::mcp::types/ServerInfo({name: "server", version: "1"}),
      server-capabilities: ::mcp::types/ServerCapabilities({tools: {listChanged: true}}),
      headers: {},
      era: "modern",
      client-info: ::mcp::types/ClientInfo({name: "my-app", version: "1.0.0"})
    })
    opt-ins ::mcp::types/SubscriptionFilter({tools-list-changed: true})
    ::mcp::subscriptions/validate-filter(session, opt-ins)  // {toolsListChanged: true}
    ```
    """
}
fn (session: ::types/Session, filter: ::types/SubscriptionFilter): Map {
  caps untype(session.server-capabilities)
  tools get(caps, "tools", {})
  prompts get(caps, "prompts", {})
  resources get(caps, "resources", {})

  if(
    eq(filter.tools-list-changed, true),
    require-supported(
      eq(get(tools, "listChanged", false), true),
      "MCP server did not advertise tools.listChanged"
    )
  )
  if(
    eq(filter.prompts-list-changed, true),
    require-supported(
      eq(get(prompts, "listChanged", false), true),
      "MCP server did not advertise prompts.listChanged"
    )
  )
  if(
    eq(filter.resources-list-changed, true),
    require-supported(
      eq(get(resources, "listChanged", false), true),
      "MCP server did not advertise resources.listChanged"
    )
  )
  if(
    and(
      is-some(filter.resource-subscriptions),
      gt(length(filter.resource-subscriptions), 0)
    ),
    require-supported(
      eq(get(resources, "subscribe", false), true),
      "MCP server did not advertise resources.subscribe"
    )
  )

  wire-filter(filter)
}

listen
meta {
    doc: """
    Open a modern long-lived notification stream.

    Returns an iterator of parsed `StreamEvent` values. The final event, when a
    server closes the subscription gracefully, contains the
    `subscriptions/listen` JSON-RPC result.

    **Example**

    ```hot
    info ::mcp::types/ClientInfo({name: "my-app", version: "1.0.0"})
    session ::mcp::client/connect("https://mcp.example.com/mcp", info, null)
    opt-ins ::mcp::types/SubscriptionFilter({tools-list-changed: true})
    events ::mcp::subscriptions/listen(session, opt-ins)
    for-each(events, (event) { println(event.data.method) })
    ```
    """
}
fn (session: ::types/Session, filter: ::types/SubscriptionFilter): Iter {
  if(
    ne(or(session.era, "legacy"), "modern"),
    err("subscriptions/listen requires MCP 2026-07-28")
  )
  notifications validate-filter(session, filter)
  response ::client/session-request-stream(
    session,
    "subscriptions/listen",
    {notifications: notifications}
  )
  Iter(map(collect(response.body), (frame) {
    ::types/StreamEvent({
      event: frame.event,
      data: from-json(frame.data),
      id: frame.id
    })
  }))
}
