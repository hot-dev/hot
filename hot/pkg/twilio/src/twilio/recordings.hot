::twilio::recordings ns

::uri ::hot::uri

api-request ::twilio::api/request
account-url ::twilio::api/account-url
resolve ::twilio::api/resolve
Client ::twilio::api/Client
HttpError ::twilio::api/HttpError
is-ok-response ::hot::http/is-ok-response

// ============================================================================
// Recordings
// ============================================================================

Recording type {
  sid: Str?,
  account_sid: Str?,
  call_sid: Str?,
  conference_sid: Str?,
  status: Str?,
  source: Str?,
  channels: Int?,
  duration: Str?,
  start_time: Str?,
  price: Str?,
  price_unit: Str?,
  error_code: Int?,
  media_url: Str?,
  api_version: Str?,
  uri: Str?,
  subresource_uris: Map?,
  date_created: Str?,
  date_updated: Str?
}

ListRecordingsRequest
meta {
    doc: """Filters for GET /Recordings.json. `DateCreated` matches one day (`YYYY-MM-DD`); `DateCreatedBefore`/`DateCreatedAfter` send Twilio's inclusive `DateCreated<`/`DateCreated>` filters."""
}
type {
  CallSid: Str?,
  ConferenceSid: Str?,
  DateCreated: Str?,
  DateCreatedBefore: Str?,
  DateCreatedAfter: Str?,
  IncludeSoftDeleted: Bool?,
  PageSize: Int?,
  Page: Int?,
  PageToken: Str?
}

ListRecordingsResponse type {
  recordings: Vec<Map>?,
  end: Int?,
  first_page_uri: Str?,
  next_page_uri: Str?,
  page: Int?,
  page_size: Int?,
  previous_page_uri: Str?,
  start: Int?,
  uri: Str?
}

list-recordings-query
meta {
    doc: """
    The query string `list-recordings` sends. Exposed for testing.

    **Example**

    ```hot
    ::recordings ::twilio::recordings

    ::recordings/list-recordings-query(::recordings/ListRecordingsRequest({CallSid: "CA123", PageSize: 10}))  // "?CallSid=CA123&PageSize=10"
    ```
    """
}
fn (request: ListRecordingsRequest): Str {
  ::twilio::api/query-string({
    CallSid: request.CallSid,
    ConferenceSid: request.ConferenceSid,
    DateCreated: request.DateCreated,
    "DateCreated<": request.DateCreatedBefore,
    "DateCreated>": request.DateCreatedAfter,
    IncludeSoftDeleted: request.IncludeSoftDeleted,
    PageSize: request.PageSize,
    Page: request.Page,
    PageToken: request.PageToken
  })
}

list-recordings
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
GET /Accounts/{AccountSid}/Recordings.json - List call and conference recordings, newest first. Filter by `CallSid` to get one call's recordings.

**Example**

```hot
::recordings ::twilio::recordings

page ::recordings/list-recordings(::recordings/ListRecordingsRequest({CallSid: "CA123"}))
page.recordings  // => [{sid: "RE...", duration: "14", status: "completed", ...}]
```
"""
}
fn
(request: ListRecordingsRequest): ListRecordingsResponse {
  list-recordings(request, {})
},
(request: ListRecordingsRequest, opts: Map): ListRecordingsResponse {
  resolve(opts) |> if-ok((client) { list-recordings(client, request) })
},
(client: Client, request: ListRecordingsRequest): ListRecordingsResponse {
  response api-request(client, "GET", `${account-url(client)}/Recordings.json${list-recordings-query(request)}`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ListRecordingsResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

GetRecordingRequest type {
  sid: Str
}

get-recording
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
    GET /Accounts/{AccountSid}/Recordings/{Sid}.json - Get a recording's
    metadata (status, duration, source, price).

    **Example**

    ```hot
    ::recordings ::twilio::recordings

    rec ::recordings/get-recording(::recordings/GetRecordingRequest({sid: "RE123"}))
    rec.status
    rec.duration
    ```
    """
}
fn
(request: GetRecordingRequest): Recording {
  get-recording(request, {})
},
(request: GetRecordingRequest, opts: Map): Recording {
  resolve(opts) |> if-ok((client) { get-recording(client, request) })
},
(client: Client, request: GetRecordingRequest): Recording {
  response api-request(client, "GET", `${account-url(client)}/Recordings/${::uri/encode(request.sid)}.json`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { Recording(response.body) }
    => { err(HttpError(response)) }
  }
}

DownloadRecordingRequest
meta {
    doc: """`format` is `"mp3"` or `"wav"` (the default)."""
}
type {
  sid: Str,
  format: Str?
}

recording-media-url
meta {
    doc: """
    The media URL `download-recording` fetches: the recording URI with
    `.mp3` or `.wav` in place of `.json`. Exposed for testing.

    **Example**

    ```hot
    ::recordings ::twilio::recordings

    c ::twilio::api/Client({account-sid: "AC123", username: "AC123", password: "test"})
    ::recordings/recording-media-url(c, ::recordings/DownloadRecordingRequest({sid: "RE123", format: "mp3"}))  // "https://api.twilio.com/2010-04-01/Accounts/AC123/Recordings/RE123.mp3"
    ```
    """
}
fn (client: Client, request: DownloadRecordingRequest): Str {
  ext if(eq(request.format, "mp3"), "mp3", "wav")
  `${account-url(client)}/Recordings/${::uri/encode(request.sid)}.${ext}`
}

download-recording
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
GET /Accounts/{AccountSid}/Recordings/{Sid}.mp3|.wav - Download the recording audio as `Bytes`. Authenticated, so it works with HTTP Basic auth for media enabled.

**Example**

```hot
::recordings ::twilio::recordings

audio ::recordings/download-recording(::recordings/DownloadRecordingRequest({sid: "RE123", format: "mp3"}))
::hot::file/write-file-bytes("call.mp3", audio)
```
"""
}
fn
(request: DownloadRecordingRequest): Bytes {
  download-recording(request, {})
},
(request: DownloadRecordingRequest, opts: Map): Bytes {
  resolve(opts) |> if-ok((client) { download-recording(client, request) })
},
(client: Client, request: DownloadRecordingRequest): Bytes {
  response api-request(client, "GET", recording-media-url(client, request), {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body-bytes }
    => { err(HttpError(response)) }
  }
}

DeleteRecordingRequest type {
  sid: Str
}

delete-recording
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
    DELETE /Accounts/{AccountSid}/Recordings/{Sid}.json - Delete a recording
    and its media. Permanent.

    **Example**

    ```hot
    ::recordings ::twilio::recordings

    deleted ::recordings/delete-recording(::recordings/DeleteRecordingRequest({sid: "RE123"}))
    if(deleted, "Recording removed")
    ```
    """
}
fn
(request: DeleteRecordingRequest): Bool {
  delete-recording(request, {})
},
(request: DeleteRecordingRequest, opts: Map): Bool {
  resolve(opts) |> if-ok((client) { delete-recording(client, request) })
},
(client: Client, request: DeleteRecordingRequest): Bool {
  ::twilio::api/delete-request(client, `${account-url(client)}/Recordings/${::uri/encode(request.sid)}.json`)
}
