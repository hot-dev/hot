::hot::test::math ns
meta ["test"]

// Note: All math functions (is-zero, is-pos, is-neg, add, sub, mul, div, mod, pow,
// ceil, floor, round, rand, rand-int), type predicates (is-int, is-dec), and
// assert, assert-eq are all core functions - no aliasing needed

test-is-zero-is-pos-is-neg
meta ["test"] fn () {
    assert-eq(true, is-zero(0), "is-zero(0) should return true")
    assert-eq(false, is-zero(1), "is-zero(1) should return false")
    assert-eq(true, is-zero(0.0), "is-zero(0.0) should return true")
    assert-eq(true, is-zero(0.00), "is-zero(0.00) should return true")
    assert-eq(true, ::hot::math/is-zero(0.0), "::hot::math/is-zero(0.0) should return true")
    assert-eq(false, is-zero(1.5), "is-zero(1.5) should return false")
    assert-eq(true, is-pos(1), "is-pos(1) should return true")
    assert-eq(false, is-pos(0), "is-pos(0) should return false")
    assert-eq(true, is-neg(-1), "is-neg(-1) should return true")
    assert-eq(false, is-neg(0), "is-neg(0) should return false")
}

test-add
meta ["test"] fn () {
    assert-eq(1, add(0, 1), "add(0, 1) should return 1")
    assert-eq(0, add(0, 0), "add(0, 0) should return 0")
    assert-eq(-1, add(0, -1), "add(0, -1) should return -1")
    assert-eq(1, add(1, 0), "add(1, 0) should return 1")
    assert-eq(0, add(-1, 1), "add(-1, 1) should return 0")
    assert-eq(-2, add(-1, -1), "add(-1, -1) should return -2")
    assert-eq(1.5, add(0.5, 1), "add(0.5, 1) should return 1.5")
    assert-eq(2.5, add(1.5, 1), "add(1.5, 1) should return 2.5")
    assert-eq(3.0, add(1.5, 1.5), "add(1.5, 1.5) should return 3.0")
}

test-sub
meta ["test"] fn () {
    assert-eq(1, sub(2, 1), "sub(2, 1) should return 1")
    assert-eq(0, sub(0, 0), "sub(0, 0) should return 0")
    assert-eq(-1, sub(0, 1), "sub(0, 1) should return -1")
    assert-eq(1, sub(1, 0), "sub(1, 0) should return 1")
    assert-eq(-2, sub(-1, 1), "sub(-1, 1) should return -2")
    assert-eq(0.5, sub(1.5, 1), "sub(1.5, 1) should return 0.5")
    assert-eq(-0.5, sub(1, 1.5), "sub(1, 1.5) should return -0.5")
    assert-eq(0.0, sub(1.5, 1.5), "sub(1.5, 1.5) should return 0.0")
}

test-mul
meta ["test"] fn () {
    assert-eq(2, mul(2, 1), "mul(2, 1) should return 2")
    assert-eq(0, mul(0, 0), "mul(0, 0) should return 0")
    assert-eq(0, mul(0, 1), "mul(0, 1) should return 0")
    assert-eq(0, mul(1, 0), "mul(1, 0) should return 0")
    assert-eq(-1, mul(-1, 1), "mul(-1, 1) should return -1")
    assert-eq(1.5, mul(1.5, 1), "mul(1.5, 1) should return 1.5")
    assert-eq(2.25, mul(1.5, 1.5), "mul(1.5, 1.5) should return 2.25")
    assert-eq(-1.5, mul(-1.5, 1), "mul(-1.5, 1) should return -1.5")
}

test-div
meta ["test"] fn () {
    assert-eq(2, div(2, 1), "div(2, 1) should return 2")
    assert-eq(0, div(0, 1), "div(0, 1) should return 0")
    assert-eq(-1, div(-1, 1), "div(-1, 1) should return -1")
    assert-eq(1.5, div(3, 2), "div(3, 2) should return 1.5")
    assert-eq(0.5, div(1, 2), "div(1, 2) should return 0.5")
    assert-eq(2.0, div(3, 1.5), "div(3, 1.5) should return 2.0")
}

test-mod
meta ["test"] fn () {
    assert-eq(0, mod(2, 1), "mod(2, 1) should return 0")
    assert-eq(0, mod(0, 1), "mod(0, 1) should return 0")
    assert-eq(0, mod(-1, 1), "mod(-1, 1) should return 0")
    assert-eq(0.5, mod(2.5, 1), "mod(2.5, 1) should return 0.5")
    assert-eq(0.2, mod(1.2, 1), "mod(1.2, 1) should return 0.2")
    assert-eq(0.0, mod(2.0, 1), "mod(2.0, 1) should return 0.0")
}

// mod takes the sign of the dividend for every Int and Dec combination
test-mod-sign-matches-for-ints-and-decs
meta ["test"] fn () {
    assert-eq(-1, mod(-7, 2), "mod(-7, 2)")
    assert-eq(-1.0, mod(-7.0, 2), "mod(-7.0, 2)")
    assert-eq(-1.0, mod(-7, 2.0), "mod(-7, 2.0)")
    assert-eq(-1.0, mod(-7.0, 2.0), "mod(-7.0, 2.0)")
    assert-eq(1, mod(7, -2), "mod(7, -2)")
    assert-eq(1.0, mod(7.0, -2), "mod(7.0, -2)")
    assert-eq(-1.5, mod(-7.5, 2), "mod(-7.5, 2)")
    assert-eq(-0.5, mod(-0.5, 3), "mod(-0.5, 3)")
    assert(is-err(mod(1.5, 0)), "mod by zero is an Err")
}

test-pow
meta ["test"] fn () {
    assert-eq(1, pow(1, 0), "pow(1, 0) should return 1")
    assert-eq(1, pow(1, 1), "pow(1, 1) should return 1")
    assert-eq(1, pow(1, 2), "pow(1, 2) should return 1")
    assert-eq(1, pow(1, 3), "pow(1, 3) should return 1")
    assert-eq(1, pow(1, 4), "pow(1, 4) should return 1")
    assert-eq(1, pow(1, 5), "pow(1, 5) should return 1")
    assert-eq(2.25, pow(1.5, 2), "pow(1.5, 2) should return 2.25")
    assert-eq(3.375, pow(1.5, 3), "pow(1.5, 3) should return 3.375")
    assert-eq(1.0, pow(2.0, 0), "pow(2.0, 0) should return 1.0")
}

test-ceil
meta ["test"] fn () {
    assert-eq(5, ceil(5), "ceil(5) should return 5")
    assert-eq(3, ceil(2.3), "ceil(2.3) should return 3")
    assert-eq(2, ceil(2.0), "ceil(2.0) should return 2")
    assert-eq(-2, ceil(-2.3), "ceil(-2.3) should return -2")
    assert-eq(3, ceil(2.1), "ceil(2.1) should return 3")
}

test-floor
meta ["test"] fn () {
    assert-eq(5, floor(5), "floor(5) should return 5")
    assert-eq(2, floor(2.3), "floor(2.3) should return 2")
    assert-eq(2, floor(2.0), "floor(2.0) should return 2")
    assert-eq(-3, floor(-2.3), "floor(-2.3) should return -3")
    assert-eq(2, floor(2.9), "floor(2.9) should return 2")
}

test-round
meta ["test"] fn () {
    assert-eq(5, round(5), "round(5) should return 5")
    assert-eq(2, round(2.3), "round(2.3) should return 2")
    assert-eq(3, round(2.5), "round(2.5) should return 3")
    assert-eq(3, round(2.7), "round(2.7) should return 3")
    assert-eq(-2, round(-2.3), "round(-2.3) should return -2")
    assert-eq(2, round(2.0), "round(2.0) should return 2")
}

test-rand
meta ["test"] fn () {
    // Test rand() returns a decimal (basic type check)
    assert(is-dec(rand()), "rand() should return a decimal")
    // Test rand(n) with positive integer
    assert(is-dec(rand(10)), "rand(10) should return a decimal")
    // Test rand(n) with positive decimal
    assert(is-dec(rand(5.5)), "rand(5.5) should return a decimal")
    // Test rand-int() returns an integer
    assert(is-int(rand-int()), "rand-int() should return an integer")
    // Test rand-int(n) with positive integer
    assert(is-int(rand-int(10)), "rand-int(10) should return an integer")
}

test-rand-int-ranges
meta ["test"] fn () {
    draws map(range(0, 100), (i) { rand-int() })
    assert(gt(length(distinct(draws)), 1), "rand-int() draws more than one value")
    assert(all(draws, gte(%, 0)), "rand-int() is never negative")
    small map(range(0, 200), (i) { rand-int(3) })
    assert(all(small, (x) { and(gte(x, 0), lt(x, 3)) }), "rand-int(3) is 0, 1 or 2")
    assert-eq(3, length(distinct(small)), "rand-int(3) draws each of 0, 1 and 2")
    assert-eq([0], distinct(map(range(0, 20), (i) { rand-int(1) })), "rand-int(1) is always 0")
    assert(is-err(rand-int(0)), "rand-int(0) is an Err")
}

test-add-mul-take-any-count
meta ["test"] fn () {
    assert-eq(0, add(), "add() is the sum of nothing")
    assert-eq(5, add(5), "add(x) is x")
    assert-eq(9, add(1, 1, 1, 1, 1, 1, 1, 1, 1), "add folds nine numbers")
    assert-eq(6.5, add(1, 2.5, 3), "add mixes Int and Dec")
    assert-eq(1, mul(), "mul() is the product of nothing")
    assert-eq(5, mul(5), "mul(x) is x")
    assert-eq(24, mul(2, 3, 4), "mul folds three numbers")
    assert-eq(5.0, mul(2, 2.5, 1), "mul mixes Int and Dec")
}

test-sub-div-fold-from-the-left
meta ["test"] fn () {
    assert-eq(-5, sub(5), "sub(x) negates")
    assert-eq(-1.5, sub(1.5), "sub(x) negates a Dec")
    assert-eq(5, sub(-5), "sub(x) negates a negative")
    assert-eq(7, sub(10, 1, 2), "sub folds from the left")
    assert-eq(10, div(100, 2, 5), "div folds from the left")
    assert-eq(2.5, div(100, 8, 5), "div gives a Dec when a step isn't whole")
}

test-min-max-take-any-count
meta ["test"] fn () {
    assert-eq(4, max(4), "max(x) is x")
    assert-eq(4, min(4), "min(x) is x")
    assert-eq(9, max(3, 9, 2), "max of three")
    assert-eq(2, min(3, 9, 2), "min of three")
    assert-eq(9.5, max(3, 9.5, 9), "max across Int and Dec")
    assert-eq(-3, max(...[-3, -9]), "max needs no seed for negative numbers")
}

test-fold-stops-at-an-err
meta ["test"] fn () {
    assert(is-err(add(9223372036854775807, 1, -5)), "an overflow isn't undone by a later number")
    assert(is-err(mul(9223372036854775807, 2, 0)), "an overflow isn't multiplied away")
    assert(is-err(div(1, 0, 5)), "a zero divisor answers the whole call")
}

test-spread-into-math
meta ["test"] fn () {
    xs [1, 2, 3, 4]
    empty []
    assert-eq(10, add(...xs), "add spreads a Vec")
    assert-eq(0, add(...empty), "an empty Vec sums to 0")
    assert-eq(7, add(...[7]), "one item is itself")
    assert-eq(13, add(1, 2, ...[3, 7]), "written arguments come before a spread")
    assert-eq(6, add(...[1], 2, ...[3]), "a spread can sit anywhere")
    assert-eq(1, mul(...empty), "an empty Vec multiplies to 1")
    assert-eq(-4, sub(...[4]), "one item negates")
    assert(is-err(max(...empty)), "an empty Vec has no maximum")
    assert(is-err(sub(...empty)), "sub takes at least one number")
    assert(is-err(div(...[5])), "div takes at least two numbers")
    assert(is-err(add(...[1, 2, 3, "a"])), "a rest argument must be a number")
}

// Typed Int parameters reach the compiled Int path; `hot test` runs these
// compiled and interpreted.
chain-sum fn (a: Int, b: Int, c: Int): Any { add(a, b, c) }

chain-product fn (a: Int, b: Int, c: Int): Any { mul(a, b, c) }

chain-kept fn (a: Int, b: Int, c: Int): Any {
    total add(a, b, c)
    {total: total}
}

chain-err-check fn (a: Int, b: Int, c: Int): Bool { is-err(add(a, b, c)) }

chain-least fn (a: Int, b: Int, c: Int): Int { min(a, b, c) }

chain-most fn (a: Int, b: Int): Int { max(a, b) }

chain-mixed fn (a: Dec, b: Int, c: Int): Any { add(a, b, c) }

chain-any fn (a, b, c) { add(a, b, c) }

test-chains-in-compiled-functions
meta ["test"] fn () {
    assert-eq(6, chain-sum(1, 2, 3), "add of Ints")
    assert-eq(6, chain-product(1, 2, 3), "mul of Ints")
    assert-eq(6, chain-kept(1, 2, 3).total, "a kept result")
    assert-eq(1, chain-least(3, 1, 2), "min of Ints")
    assert-eq(3, chain-most(3, 1), "max of two Ints")
    assert-eq(6.5, chain-mixed(1.5, 2, 3), "a Dec in the chain")
    assert-eq(6.5, chain-any(1, 2.5, 3), "untyped parameters")
}

test-chains-keep-an-overflow-as-a-value
meta ["test"] fn () {
    max-int 9223372036854775807
    assert(is-err(chain-sum(max-int, 1, -5)), "a first step that overflows")
    assert(is-err(chain-sum(max-int, -1, 2)), "a last step that overflows")
    assert(is-err(chain-product(max-int, 2, 0)), "a later zero doesn't undo it")
    assert(chain-err-check(max-int, 1, -5), "is-err reads it")
    assert-eq(false, chain-err-check(1, 2, 3), "is-err of a number")
    assert(is-err(chain-kept(max-int, 1, -5).total), "a local keeps it")
    assert(is-err(chain-any(max-int, 1, -5)), "untyped parameters")
}

test-chains-of-non-numbers-stay-checked
meta ["test"] fn () {
    assert(is-err(chain-any(1, 2, "a")), "a rest argument that isn't a number")
    assert(is-err(chain-any("a", 2, 3)), "a first argument that isn't a number")
}

test-chains-in-fused-lambdas
meta ["test"] fn () {
    assert-eq(55, reduce(range(0, 10), (acc, x) { add(acc, x, 1) }, 0), "add in a reducer")
    assert-eq([0, 3, 12], map(range(0, 3), (x) { mul(x, 3, x) }), "mul in map")
    assert-eq([-1, 0, 1], map(range(0, 3), (x) { sub(x, 0, 1) }), "sub in map")
    assert-eq([10, 5], map([100, 50], (x) { div(x, 2, 5) }), "div in map")
    assert-eq([2, 2, 2, 3], map(range(0, 4), (x) { max(x, 2, 1) }), "max in map")
    assert-eq([0, 1, 1, 1], map(range(0, 4), (x) { min(x, 1, 5) }), "min in map")
    assert-eq([1, 2], map(range(0, 2), (x) { add(x, 1) }), "two arguments still fuse")
    assert-eq([1, 1], map(range(0, 2), (x) { max(x, 1) }), "max of two")
    assert-eq([4.0, 5.0], map([1.5, 2.5], (x) { add(x, 1, 1.5) }), "Decs in a fused chain")
}

test-comparison-chains-in-fused-lambdas
meta ["test"] fn () {
    assert-eq([3, 4, 5, 6], filter(range(0, 10), (x) { lt(2, x, 7) }), "lt keeps the middle")
    assert-eq([2, 3], filter(range(0, 5), (x) { lte(2, x, 3) }), "lte includes its ends")
    assert-eq([1], filter(range(0, 3), (x) { gt(2, x, 0) }), "gt")
    assert-eq([0, 1, 2], filter(range(0, 4), (x) { gte(2, x, 0) }), "gte")
    assert-eq([2], filter(range(0, 4), (x) { eq(2, x, 2) }), "eq reads all three")
    assert-eq([0, 1, 3], filter(range(0, 4), (x) { ne(2, x, 2) }), "ne is the opposite of eq")
    assert-eq([1.5], filter([0.5, 1.5, 2.5], (x) { lt(1, x, 2) }), "Decs in a fused chain")
    assert(some(range(0, 5), (x) { lt(1, x, 3) }), "some")
    assert(all(range(0, 5), (x) { lte(0, x, 4) }), "all")
}

test-overflow-in-a-fused-chain-falls-back
meta ["test"] fn () {
    max-int 9223372036854775807
    results map([1, max-int], (x) { add(x, 1, -5) }, OnErr.Preserve)
    assert-eq(-3, results[0], "the item that fits")
    assert(is-err(results[1]), "the item that overflows")
    attempt ::hot::internal::exec/contain(() { map([1, max-int], (x) { add(x, 1, -5) }) })
    assert(is-err(attempt), "an Err in map halts by default")
}
