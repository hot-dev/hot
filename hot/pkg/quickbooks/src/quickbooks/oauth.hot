::quickbooks::oauth ns
meta {
    ctx: {
        "quickbooks.client.id": {required: false, secret: false},
        "quickbooks.client.secret": {required: false}
    },
    doc: """
    Intuit OAuth 2.0 for QuickBooks Online, built on `hot.dev/oauth2`.

    **Flow**

    1. Redirect the user to `authorize-url(...)`. Intuit asks them to pick
       a company and approve your app.
    2. Intuit calls your redirect URI with `?code=...&state=...&realmId=...`.
       `callback-params(request)` reads them; check `state` against the
       value you issued.
    3. `exchange-code(code, redirect-uri)` returns a `TokenSet`.
    4. Persist `refresh-token` and `realm-id` per company. Access tokens
       last an hour; refresh tokens last 100 days from their last use and
       at most five years in all.

    **Rotation.** Refresh tokens rotate: `refresh` can return a different
    refresh token than the one you sent, and once it does the old value
    stops working. Every `TokenSet` carries the refresh token to keep
    (`refresh-token`) and `rotated: true` when it changed. Always
    persist it, or let the `::quickbooks::auth` token keeper do that in a
    `::hot::store`.

    Token calls authenticate the app with HTTP Basic (`client_secret_basic`),
    as Intuit's SDKs do. The client id and secret come from `opts`
    (`client-id`, `client-secret`) or the `quickbooks.client.id` /
    `quickbooks.client.secret` context variables.

    ```hot
    ::oauth ::quickbooks::oauth

    url ::oauth/authorize-url("ABcd123", "https://app.example.com/oauth/quickbooks", "csrf-123")

    // In the callback handler, `request` is the inbound request:
    request {query: {code: "Q011abc", state: "csrf-123", realmId: "9341453"}}
    cb ::oauth/callback-params(request)
    tokens ::oauth/exchange-code(cb.code, "https://app.example.com/oauth/quickbooks")
    // persist tokens.refresh-token and cb.realm-id for this company
    ```
    """
}

::ctx ::hot::ctx
::b64 ::hot::base64
::time ::hot::time
::uri ::hot::uri
::oauth2 ::oauth2

http-request ::hot::http/request
HttpRequest ::hot::http/HttpRequest

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

TokenError
meta {
    doc: """
    A credential or token-endpoint failure. `message` is readable, e.g.
    `"quickbooks: token refresh failed: invalid_grant (Token invalid)"`.
    `error-code` / `error-description` carry Intuit's OAuth `error` /
    `error_description`, and `intuit-tid` the response's `intuit_tid`
    header for support requests. Token values never appear in messages.
    """
}
type {
    message: Str,
    status: Int?,
    error-code: Str?,
    error-description: Str?,
    intuit-tid: Str?
}

TokenSet
meta {
    doc: """
    The result of a code exchange or refresh.

    - `access-token` - the bearer token (about an hour)
    - `refresh-token` - **the refresh token to persist**; it may differ
      from the one you sent
    - `rotated` - true when `refresh-token` differs from the token sent
    - `expires-in`, `expires-at` - access-token lifetime (seconds) and
      expiry (epoch ms)
    - `refresh-token-expires-in`, `refresh-token-expires-at` - Intuit's
      `x_refresh_token_expires_in` (rolling, about 100 days)
    - `refresh-token-hard-expires-in` - the absolute five-year limit
      (`x_refresh_token_hard_expires_in`), when Intuit returns it
    - `token-type`, `id-token` (OpenID scopes only), `scope`
    """
}
type {
    access-token: Str,
    refresh-token: Str?,
    rotated: Bool,
    expires-in: Int?,
    expires-at: Int?,
    refresh-token-expires-in: Int?,
    refresh-token-expires-at: Int?,
    refresh-token-hard-expires-in: Int?,
    token-type: Str?,
    id-token: Str?,
    scope: Str?
}

// ---------------------------------------------------------------------------
// Helpers
// ---------------------------------------------------------------------------

is-blank
meta {
    doc: """
    True for null, `""` and whitespace-only strings (unset env placeholders
    arrive as `""`).

    **Example**

    ```hot
    ::quickbooks::oauth/is-blank("  ")  // true
    ::quickbooks::oauth/is-blank("9341453")  // false
    ```
    """
}
fn (value: Any): Bool {
  or(is-null(value), and(is-str(value), is-empty(trim(value))))
}

int-or-null
meta {
    doc: """
    An Int from an Int or digit-only Str; null otherwise. Guards `Int()` so
    bad input never halts a run.

    **Example**

    ```hot
    ::quickbooks::oauth/int-or-null("42")  // 42
    ::quickbooks::oauth/int-or-null("4x")  // null
    ```
    """
}
fn (value: Any): Int? {
  cond {
    is-int(value) => { value }
    and(is-str(value), ::hot::regex/is-match(trim(Str(value)), "^[0-9]{1,15}$")) => { Int(trim(value)) }
    => { null }
  }
}

blank-option
meta {
    doc: """
    The first of `names` that `opts` has but with a blank or null value,
    else null. Such a key is an Err, never a fallback to context: a tenant
    whose credential is missing must not run on the project's. Exposed for
    testing.

    **Example**

    ```hot
    ::quickbooks::oauth/blank-option({realm-id: ""}, ["realm-id", "environment"])  // "realm-id"
    ::quickbooks::oauth/blank-option({realm-id: "9341453"}, ["realm-id"])  // null
    ```
    """
}
fn (opts: Map, names: Vec): Str? {
  find-first(names, (name) { and(in(name, keys(opts)), is-blank(get(opts, name))) })
}

mark-tokens
meta {
    doc: """
    Mask the tokens in a token-endpoint response and return it unchanged.
    Only the tokens: marking the whole body would also hide values like
    `token_type` and `scope`. Exposed for testing.

    **Example**

    ```hot
    body ::quickbooks::oauth/mark-tokens({access_token: ::hot::ctx/get("quickbooks.access.token"), token_type: "bearer"})
    body.token_type
    ```
    """
}
fn (body: Map): Map {
  ::ctx/mark-secret([get(body, "access_token"), get(body, "refresh_token"), get(body, "id_token")])
  body
}

now-ms
meta {no-doc: true}
fn (): Int {
  ::time/epoch-millis(::time/now())
}

token-error
meta {
    doc: """
    Build a `TokenError`. The 1-arity form wraps a message; the 2-arity form
    describes a failed token response (`{status, body, headers}`) or
    transport error, prefixed with `prefix`.

    **Example**

    ```hot
    ::quickbooks::oauth/token-error("quickbooks: no credentials").message  // "quickbooks: no credentials"

    failed ::quickbooks::oauth/token-error("quickbooks: token refresh failed", {status: 400, body: {error: "invalid_grant"}})
    failed.error-code  // "invalid_grant"
    failed.message  // "quickbooks: token refresh failed: invalid_grant"
    ```
    """
}
fn
(message: Str): TokenError {
  TokenError({message: message})
},
(prefix: Str, payload: Any): TokenError {
  body if(is-map(payload), get(payload, "body"), null)
  status if(is-map(payload), get(payload, "status"), null)
  headers if(is-map(payload), or(get(payload, "headers"), {}), {})
  code if(is-map(body), get(body, "error"), null)
  desc if(is-map(body), get(body, "error_description"), null)
  tid get(headers, "intuit_tid")
  detail cond {
    and(is-some(code), is-some(desc)) => { `${code} (${desc})` }
    is-some(code) => { Str(code) }
    is-some(status) => { `HTTP ${status}` }
    is-str(payload) => { payload }
    => { err-message(payload) }
  }

  tid-part if(is-some(tid), ` (intuit_tid: ${tid})`, "")
  TokenError({
    message: `${prefix}: ${detail}${tid-part}`,
    status: status,
    error-code: if(is-some(code), Str(code), null),
    error-description: if(is-some(desc), Str(desc), null),
    intuit-tid: tid
  })
}

basic-auth
meta {
    doc: """
    The `Authorization` header value for token calls: `Basic
    base64(client-id:client-secret)`.

    **Example**

    ```hot
    header ::quickbooks::oauth/basic-auth("ABcd123", ::hot::ctx/get("quickbooks.client.secret"))
    {Authorization: header}
    ```
    """
}
fn (client-id: Str, client-secret: Str): Str {
  pair `${client-id}:${client-secret}`
  `Basic ${::b64/encode(Bytes(pair))}`
}

app-credentials
meta {
    ctx: {
        "quickbooks.client.id": {required: false, secret: false},
        "quickbooks.client.secret": {required: false}
    },
    doc: """
    The app's `{client-id, client-secret}` from `opts`, else context, with a
    per-call secret marked so it is masked in call records. A `TokenError`
    names what is missing; a key in `opts` that is blank or null is one too,
    never a fallback to context.

    **Example**

    ```hot
    app ::quickbooks::oauth/app-credentials({})
    app.client-id

    ::quickbooks::oauth/app-credentials({client-id: "ABcd123", client-secret: ::hot::ctx/get("quickbooks.client.secret")})
    ```
    """
}
fn (opts: Map): Map {
  ::ctx/mark-secret(get(opts, "client-secret"))
  blank blank-option(opts, ["client-id", "client-secret"])
  id or(get(opts, "client-id"), ::ctx/get("quickbooks.client.id"))
  secret or(get(opts, "client-secret"), ::ctx/get("quickbooks.client.secret"))
  cond {
    is-some(blank) => {
      err(token-error(`quickbooks: ${blank} is in the call's opts but is blank or null. Pass a value, or leave ${blank} out to use context.`))
    }

    or(is-blank(id), is-blank(secret)) => {
      err(token-error("quickbooks: the OAuth client id and secret are not set. Set quickbooks.client.id and quickbooks.client.secret in Context Variables, or pass client-id and client-secret in opts."))
    }
    => { {client-id: Str(id), client-secret: Str(secret)} }
  }
}

normalize-scopes
meta {
    doc: """
    Scopes as a space-separated Str from a Vec or a space/comma-separated
    Str; `SCOPE_ACCOUNTING` when null or empty.

    **Example**

    ```hot
    ::quickbooks::oauth/normalize-scopes(null)  // "com.intuit.quickbooks.accounting"
    ::quickbooks::oauth/normalize-scopes("openid,email")  // "openid email"
    ::quickbooks::oauth/normalize-scopes(["openid", "openid"])  // "openid"
    ```
    """
}
fn (scopes: Any): Str {
  raw cond {
    is-null(scopes) => { [] }
    is-vec(scopes) => { scopes }
    => { split(replace(Str(scopes), ",", " "), " ") }
  }

  cleaned distinct(filter(map(raw, (s) { trim(Str(s)) }), (s) { not(is-empty(s)) }))
  if(is-empty(cleaned), ::quickbooks/SCOPE_ACCOUNTING, join(cleaned, " "))
}

// ---------------------------------------------------------------------------
// Authorization URL and callback
// ---------------------------------------------------------------------------

authorize-url
meta {
    doc: """
    Build Intuit's consent URL. `state` is your CSRF token (Intuit
    requires one). Options: `scopes` (Vec or Str; default
    `com.intuit.quickbooks.accounting`; add `openid email` for the user's
    identity), `code-challenge` (an S256 PKCE challenge), and `extra` (any
    other parameters).

    ```hot
    url ::quickbooks::oauth/authorize-url("ABcd123", "https://app.example.com/oauth/quickbooks", "csrf-123",
      {scopes: ["com.intuit.quickbooks.accounting", "openid", "email"]})
    ```
    """
}
fn
(client-id: Str, redirect-uri: Str, state: Str): Str {
  authorize-url(client-id, redirect-uri, state, {})
},
(client-id: Str, redirect-uri: Str, state: Str, opts: Map): Str {
  cond {
    is-blank(state) => { err(token-error("quickbooks: authorize-url needs a non-empty state (your CSRF token)")) }
    => {
      ::oauth2/authorize-url(filter-vals({
        authorize-url: ::quickbooks/AUTHORIZE_URL,
        client-id: client-id,
        redirect-uri: redirect-uri,
        scope: normalize-scopes(get(opts, "scopes")),
        state: state,
        code-challenge: get(opts, "code-challenge"),
        extra: get(opts, "extra")
      }, is-some))
    }
  }
}

callback-params
meta {
    doc: """
    Read Intuit's redirect: `{code, state, realm-id, error,
    error-description}` from the request's query (fields are null when
    absent). `realm-id` is the company the user picked; store it next to
    the refresh token. Compare `state` with the value you issued before
    exchanging the code.

    **Example**

    ```hot
    cb ::quickbooks::oauth/callback-params({query: {code: "Q011abc", state: "csrf-123", realmId: "9341453"}})
    cb.realm-id  // "9341453"
    cb.state  // "csrf-123"
    cb.error  // null
    ```
    """
}
fn (request: Map): Map {
  q or(get(request, "query"), {})
  {
    code: get(q, "code"),
    state: get(q, "state"),
    realm-id: get(q, "realmId"),
    error: get(q, "error"),
    error-description: get(q, "error_description")
  }
}

// ---------------------------------------------------------------------------
// Token requests
// ---------------------------------------------------------------------------

build-token-request
meta {
    doc: """
    Build (without sending) the token-endpoint `HttpRequest`: a
    form-encoded grant `body`, HTTP Basic client authentication, and the
    `x-include-refresh-token-hard-expires-in` header so Intuit reports
    the five-year refresh-token limit. Pure; exposed for testing.

    **Example**

    ```hot
    body ::quickbooks::oauth/build-refresh-body(::hot::ctx/get("quickbooks.refresh.token"))
    req ::quickbooks::oauth/build-token-request(body, "ABcd123", ::hot::ctx/get("quickbooks.client.secret"))
    req.url
    req.headers.Content-Type
    ```
    """
}
fn (body: Map, client-id: Str, client-secret: Str): HttpRequest {
  HttpRequest({
    method: "POST",
    url: ::quickbooks/TOKEN_URL,
    headers: {
      Authorization: basic-auth(client-id, client-secret),
      Accept: "application/json",
      Content-Type: "application/x-www-form-urlencoded",
      x-include-refresh-token-hard-expires-in: "true"
    },
    body: ::uri/encode-query(body)
  })
}

// The ::oauth2 body builders include client_id/client_secret for
// client_secret_post; Intuit's SDKs authenticate with Basic instead.
without-client
meta {no-doc: true}
fn (body: Map): Map {
  delete(delete(body, "client_id"), "client_secret")
}

build-exchange-body
meta {
    doc: """
    The `authorization_code` grant body (client credentials go in the Basic
    header). `code-verifier` completes a PKCE flow.

    **Example**

    ```hot
    body ::quickbooks::oauth/build-exchange-body("Q011abc", "https://app.example.com/oauth/quickbooks", null)
    body.grant_type  // "authorization_code"
    body.code  // "Q011abc"
    ```
    """
}
fn (code: Str, redirect-uri: Str, code-verifier: Str?): Map {
  without-client(::oauth2/build-exchange-body(filter-vals({
    client-id: "",
    code: code,
    redirect-uri: redirect-uri,
    code-verifier: code-verifier
  }, is-some)))
}

build-refresh-body
meta {
    doc: """
    The `refresh_token` grant body (client credentials go in the Basic
    header).

    **Example**

    ```hot
    body ::quickbooks::oauth/build-refresh-body(::hot::ctx/get("quickbooks.refresh.token"))
    body.grant_type
    ```
    """
}
fn (refresh-token: Str): Map {
  without-client(::oauth2/build-refresh-body({client-id: "", refresh-token: refresh-token}))
}

token-set
meta {
    doc: """
    Turn Intuit's token response into a `TokenSet` (pure). `sent-refresh-token`
    is the refresh token the request used (null for a code exchange):
    when Intuit's response has no `refresh_token` the sent one is kept,
    and `rotated` says whether the value changed. `now` is epoch ms.

    **Example**

    ```hot
    body {access_token: "access", refresh_token: "new", expires_in: 3600}
    tokens ::quickbooks::oauth/token-set(body, "old", 1000)
    tokens.rotated  // true
    tokens.refresh-token  // "new"
    tokens.expires-at  // 3601000
    ```
    """
}
fn (body: Map, sent-refresh-token: Str?, now: Int): TokenSet {
  returned get(body, "refresh_token")
  refresh-token if(is-blank(returned), sent-refresh-token, Str(returned))
  expires-in int-or-null(get(body, "expires_in"))
  rt-expires-in int-or-null(get(body, "x_refresh_token_expires_in"))
  TokenSet({
    access-token: Str(get(body, "access_token")),
    refresh-token: refresh-token,
    rotated: and(is-some(sent-refresh-token), is-some(refresh-token), ne(refresh-token, sent-refresh-token)),
    expires-in: expires-in,
    expires-at: if(is-some(expires-in), add(now, mul(or(expires-in, 0), 1000)), null),
    refresh-token-expires-in: rt-expires-in,
    refresh-token-expires-at: if(is-some(rt-expires-in), add(now, mul(or(rt-expires-in, 0), 1000)), null),
    refresh-token-hard-expires-in: int-or-null(get(body, "x_refresh_token_hard_expires_in")),
    token-type: get(body, "token_type"),
    id-token: get(body, "id_token"),
    scope: get(body, "scope")
  })
}

send-token-request
meta {
    doc: """
    Send a token request; the decoded body on 2xx with its tokens marked so
    they are masked in call records, else a `TokenError` prefixed with
    `prefix`.

    **Example**

    ```hot
    body ::quickbooks::oauth/build-refresh-body(::hot::ctx/get("quickbooks.refresh.token"))
    req ::quickbooks::oauth/build-token-request(body, "ABcd123", ::hot::ctx/get("quickbooks.client.secret"))
    response ::quickbooks::oauth/send-token-request(req, "quickbooks: token refresh failed")
    response.expires_in
    ```
    """
}
fn (req: HttpRequest, prefix: Str): Map {
  response http-request(req)
  cond {
    is-err(response) => { err(token-error(prefix, err-message(response))) }
    and(::hot::http/is-ok-response(response), is-map(response.body), is-some(get(response.body, "access_token"))) => { mark-tokens(response.body) }
    => { err(token-error(prefix, {status: response.status, body: response.body, headers: or(response.headers, {})})) }
  }
}

exchange-code
meta {
    doc: """
    Exchange the authorization `code` for a `TokenSet`. `redirect-uri`
    must match the one used for `authorize-url`. Options: `client-id`,
    `client-secret` (else context), `code-verifier` (PKCE).

    **Example**

    ```hot
    tokens ::quickbooks::oauth/exchange-code("Q011abc", "https://app.example.com/oauth/quickbooks")
    tokens.refresh-token

    // PKCE, with the app passed per call
    ::quickbooks::oauth/exchange-code("Q011abc", "https://app.example.com/oauth/quickbooks", {
      client-id: "ABcd123",
      client-secret: ::hot::ctx/get("quickbooks.client.secret"),
      code-verifier: "dBjftJeZ4CVP"
    })
    ```
    """
}
fn
(code: Str, redirect-uri: Str): TokenSet {
  exchange-code(code, redirect-uri, {})
},
(code: Str, redirect-uri: Str, opts: Map): TokenSet {
  ::ctx/mark-secret([code, get(opts, "code-verifier")])
  app app-credentials(opts)
  cond {
    is-err(app) => { app }
    => {
      body send-token-request(
        build-token-request(build-exchange-body(code, redirect-uri, get(opts, "code-verifier")), app.client-id, app.client-secret),
        "quickbooks: code exchange failed"
      )
      if(is-err(body), body, token-set(body, null, now-ms()))
    }
  }
}

refresh
meta {
    doc: """
    Exchange a refresh token for a new `TokenSet` (no cache). **Persist
    the returned `refresh-token`**: Intuit rotates it, and the old value
    stops working once a new one is issued. A revoked or expired refresh
    token gives `error-code: "invalid_grant"`; the company must connect
    again. Options: `client-id`, `client-secret` (else context).

    ```hot
    tokens ::quickbooks::oauth/refresh(::hot::ctx/get("quickbooks.refresh.token"))
    if(tokens.rotated, ::hot::store/put(::hot::store/Map({name: "quickbooks-tokens"}), "9341453", tokens.refresh-token), null)
    ```
    """
}
fn
(refresh-token: Str): TokenSet {
  refresh(refresh-token, {})
},
(refresh-token: Str, opts: Map): TokenSet {
  ::ctx/mark-secret(refresh-token)
  app app-credentials(opts)
  cond {
    is-err(app) => { app }
    is-blank(refresh-token) => { err(token-error("quickbooks: refresh needs a non-empty refresh token")) }
    => {
      body send-token-request(
        build-token-request(build-refresh-body(refresh-token), app.client-id, app.client-secret),
        "quickbooks: token refresh failed"
      )
      if(is-err(body), body, token-set(body, refresh-token, now-ms()))
    }
  }
}

build-revoke-request
meta {
    doc: """
    Build the revoke `HttpRequest` (JSON `{token}`, Basic client auth).
    Pure; exposed for testing.

    **Example**

    ```hot
    req ::quickbooks::oauth/build-revoke-request(::hot::ctx/get("quickbooks.refresh.token"), "ABcd123", ::hot::ctx/get("quickbooks.client.secret"))
    req.url
    ```
    """
}
fn (token: Str, client-id: Str, client-secret: Str): HttpRequest {
  HttpRequest({
    method: "POST",
    url: ::quickbooks/REVOKE_URL,
    headers: {
      Authorization: basic-auth(client-id, client-secret),
      Accept: "application/json",
      Content-Type: "application/json"
    },
    body: to-json({token: token})
  })
}

revoke
meta {
    doc: """
    Revoke a refresh or access token, disconnecting the app from the
    company (revoking the refresh token also ends its access tokens).
    Returns true, or a `TokenError`. Options: `client-id`, `client-secret`.

    **Example**

    ```hot
    result ::quickbooks::oauth/revoke(::hot::ctx/get("quickbooks.refresh.token"))
    if(is-err(result), err-message(result), "disconnected")
    ```
    """
}
fn
(token: Str): Bool {
  revoke(token, {})
},
(token: Str, opts: Map): Bool {
  ::ctx/mark-secret(token)
  app app-credentials(opts)
  cond {
    is-err(app) => { app }
    => {
      response http-request(build-revoke-request(token, app.client-id, app.client-secret))
      cond {
        is-err(response) => { err(token-error("quickbooks: token revocation failed", err-message(response))) }
        ::hot::http/is-ok-response(response) => { true }
        => { err(token-error("quickbooks: token revocation failed", {status: response.status, body: response.body, headers: or(response.headers, {})})) }
      }
    }
  }
}
