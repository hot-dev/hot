::documents::capabilities ns
meta {
    doc: """
    What each provider supports, as plain data an agent can plan with
    (pure): `capabilities("box").extracted-text` is true,
    `capabilities("s3").search` is false, and so on.

    **Keys**
    - `provider`, `name`
    - `native-export` - Map of native type to the `read-text` formats it
      exports to (Google Docs/Sheets/Slides, Dropbox Paper); `{}` when none
    - `conversion` - provider-side conversion: `{formats, max-source-bytes}`
      (OneDrive), else null
    - `extracted-text` - the provider extracts text from binaries itself (Box)
    - `read-text-formats` - the `read-text` formats that can return `ok`
    - `search` - native search exists; `search-scope` says what it covers
    - `change-feed` - how `changes` works
    - `deletions-in-changes` - `changes` reports deletions
    - `push-notifications` - the provider can call a webhook on change;
      `push` describes how, the verifier, and the subscription lifetime
    - `path-addressing` - `get` and friends accept a path instead of an id
    - `max-simple-upload-bytes` - the largest single-request upload the
      provider package sends before switching to a chunked/resumable upload
    - `max-upload-bytes` - the largest upload this package can send (null: provider limit)
    - `chunked-upload` - large uploads are chunked by the provider package
    - `hashes` - the `Document.hashes` keys it fills
    - `notes` - caveats worth knowing before planning
    """
}

::source ::documents::source

google-drive fn (): Map {
  {
    provider: "google-drive",
    name: "Google Drive",
    native-export: {
      "application/vnd.google-apps.document": ["markdown", "text", "pdf"],
      "application/vnd.google-apps.spreadsheet": ["csv", "pdf"],
      "application/vnd.google-apps.presentation": ["text", "pdf"],
      "application/vnd.google-apps.drawing": ["svg", "pdf"],
      "application/vnd.google-apps.script": ["json"]
    },
    conversion: null,
    extracted-text: false,
    read-text-formats: ["auto", "text", "markdown", "pdf"],
    search: true,
    search-scope: "fullText contains: names, descriptions and indexed content",
    change-feed: "changes.list with a page token (whole drive or one shared drive)",
    deletions-in-changes: true,
    push-notifications: true,
    push: {
      mechanism: "changes.watch channel",
      verifier: "X-Goog-Channel-Token, constant-time compare",
      max-lifetime: "7 days; renew from a schedule"
    },
    path-addressing: false,
    max-simple-upload-bytes: ::google::drive::upload/RESUMABLE_THRESHOLD,
    max-upload-bytes: null,
    chunked-upload: true,
    hashes: ["md5", "sha256"],
    notes: [
      "drive and drive.readonly are restricted scopes: public apps need verification and a security assessment; drive.file avoids that",
      "exports are capped at 10 MB (larger ones fall back to exportLinks)",
      "Sheets export only the first sheet as CSV"
    ]
  }
}

onedrive fn (): Map {
  {
    provider: "onedrive",
    name: "OneDrive and SharePoint",
    native-export: {},
    conversion: {formats: ["pdf", "html"], max-source-bytes: ::microsoft::onedrive/MAX_CONVERT_BYTES},
    extracted-text: false,
    read-text-formats: ["auto", "text", "markdown", "pdf"],
    search: true,
    search-scope: "Graph search(q=...): names, metadata and content, from the drive root",
    change-feed: "delta query from the drive root (deltaLink)",
    deletions-in-changes: true,
    push-notifications: true,
    push: {
      mechanism: "Graph change-notification subscription on the drive root",
      verifier: "clientState, constant-time compare; validationToken handshake",
      max-lifetime: "42,300 minutes (under 30 days); renew from a schedule"
    },
    path-addressing: true,
    max-simple-upload-bytes: ::microsoft::onedrive::upload/SIMPLE_UPLOAD_LIMIT,
    max-upload-bytes: null,
    chunked-upload: true,
    hashes: ["quickXorHash", "sha1", "crc32"],
    notes: [
      "Graph converts to PDF (Office, ODF, RTF, HTML, Markdown, EML/MSG, TIFF, Loop) and HTML (Loop, Whiteboard) only for sources up to 2 MB",
      "Office files have no native text: read them as pdf or extract the text yourself",
      "app-only tokens need a drive (a drive id or site); /me only works with delegated tokens"
    ]
  }
}

dropbox fn (): Map {
  {
    provider: "dropbox",
    name: "Dropbox",
    native-export: {"application/vnd.dropbox.paper": ["markdown", "html"]},
    conversion: null,
    extracted-text: false,
    read-text-formats: ["auto", "text", "markdown", "pdf"],
    search: true,
    search-scope: "search_v2: names, and content on plans with content search; lags a few minutes",
    change-feed: "list_folder/continue cursor (recursive under root)",
    deletions-in-changes: true,
    push-notifications: true,
    push: {
      mechanism: "app webhook (per account), or files/list_folder/longpoll",
      verifier: "X-Dropbox-Signature: HMAC-SHA256 of the raw body with the app secret",
      max-lifetime: "none (configured in the App Console)"
    },
    path-addressing: true,
    max-simple-upload-bytes: ::dropbox::upload/DEFAULT_SESSION_THRESHOLD,
    max-upload-bytes: null,
    chunked-upload: true,
    hashes: ["dropbox-content-hash"],
    notes: [
      "deletions are reported by path only: deleted-ids holds lower-cased paths",
      "Dropbox records no creation time",
      "longpoll holds the run open up to its timeout; webhooks scale better"
    ]
  }
}

box fn (): Map {
  {
    provider: "box",
    name: "Box",
    native-export: {},
    conversion: null,
    extracted-text: true,
    read-text-formats: ["auto", "text", "markdown", "pdf"],
    search: true,
    search-scope: "/search: names, descriptions, content, comments and tags; 6 per second per user",
    change-feed: "user event stream (stream_type=changes, stream position)",
    deletions-in-changes: true,
    push-notifications: true,
    push: {
      mechanism: "webhooks v2 on a file or folder",
      verifier: "BOX-SIGNATURE-PRIMARY / -SECONDARY: HMAC-SHA256 of body + timestamp, 10-minute window",
      max-lifetime: "none (one webhook per item and trigger set)"
    },
    path-addressing: false,
    max-simple-upload-bytes: ::box::upload/CHUNKED_THRESHOLD,
    max-upload-bytes: null,
    chunked-upload: true,
    hashes: ["sha1"],
    notes: [
      "extracted text can be pending: read-text returns status pending and never waits",
      "OAuth refresh tokens are single-use; the box package's keeper stores each new one",
      "pdf comes back only for files stored as PDF"
    ]
  }
}

s3 fn (): Map {
  {
    provider: "s3",
    name: "Amazon S3",
    native-export: {},
    conversion: null,
    extracted-text: false,
    read-text-formats: ["auto", "text", "markdown", "pdf"],
    search: false,
    search-scope: "none: list a key prefix",
    change-feed: "full listing of the prefix with a modified-after watermark",
    deletions-in-changes: false,
    push-notifications: false,
    push: {
      mechanism: "S3 Event Notifications to SQS, SNS or EventBridge (not handled here)",
      verifier: null,
      max-lifetime: null
    },
    path-addressing: true,
    max-simple-upload-bytes: 5368709120,
    max-upload-bytes: 5368709120,
    chunked-upload: false,
    hashes: [],
    notes: [
      "only text files and stored PDFs have text; route everything else to an extraction tool",
      "changes lists the whole prefix each time and cannot see deletions; prefer S3 Event Notifications",
      "uploads are one PUT (no multipart), so they are bounded by the run's memory and the 5 GB PutObject limit"
    ]
  }
}

capabilities
meta {
    doc: """
    The capability Map for a provider name, alias or source descriptor
    (pure); an Err for an unknown provider. With no argument, a Map of
    every provider's capabilities.

    ```hot
    caps ::documents::capabilities/capabilities("onedrive")
    caps.conversion.max-source-bytes   // 2097152
    ```
    """
}
fn
(): Map {
  {
    "google-drive": google-drive(),
    onedrive: onedrive(),
    dropbox: dropbox(),
    box: box(),
    s3: s3()
  }
},
(provider: Any): Map {
  name ::source/provider-name(provider)
  cond {
    is-err(name) => { name }
    eq(name, "google-drive") => { google-drive() }
    eq(name, "onedrive") => { onedrive() }
    eq(name, "dropbox") => { dropbox() }
    eq(name, "box") => { box() }
    => { s3() }
  }
}

supports
meta {
    doc: """True when `provider` has capability `key` set to something truthy (pure): `supports("box", "extracted-text")`. Unknown keys and providers are false."""
}
fn (provider: Any, key: Str): Bool {
  caps capabilities(provider)
  cond {
    is-err(caps) => { false }
    => {
      v get(caps, key)
      cond {
        is-null(v) => { false }
        is-bool(v) => { v }
        is-map(v) => { not(is-empty(v)) }
        is-vec(v) => { not(is-empty(v)) }
        => { true }
      }
    }
  }
}
