::name-screening::test::fixtures ns

// Records in the shape list packages produce, from real published lists
// (public data). The base package knows no list, so the four groups go by
// neutral source keys here. Each list package tests its own parser and
// screens its own parsed fixture.

::entry ::name-screening::entry
::index ::name-screening::index

list-a fn (): Vec {
  common {source: "list-a", list: "Sample List A"}
  map([
    {id: "306", kind: "entity", name: "BANCO NACIONAL DE CUBA", aliases: ["NATIONAL BANK OF CUBA"], programs: ["CUBA"], addresses: ["Zweierstrasse 35, Zurich CH-8022, Switzerland", "Avenida de Concha Espina 8, Madrid E-28036, Spain"]},
    {id: "2676", kind: "individual", name: "AL ZAWAHIRI, Dr. Ayman", aliases: ["AL-ZAWAHIRI, Ayman", "SALIM, Ahmad Fuad", "AL-ZAWAHIRI, Aiman Muhammad Rabi"], dobs: ["1951-06-19"], programs: ["SDGT"]},
    {id: "4243", kind: "vessel", name: "EBANO", programs: ["CUBA"]},
    {id: "15432", kind: "aircraft", name: "EP-GOL", programs: ["SDGT"]},
    {id: "17016", kind: "entity", name: "GAZPROMBANK JOINT STOCK COMPANY", programs: ["UKRAINE-EO13662", "RUSSIA-EO14024"]}
  ], (e) { ::entry/make({...common, ...e}) })
}

list-b fn (): Vec {
  common {source: "list-b", list: "Sample List B"}
  map([
    {id: "AFG0007", kind: "individual", name: "Abdul Kabir MOHAMMAD JAN", aliases: ["KABIR MUHAMMAD JAN ABDUL", "A Kabir", "عبد الکبیر محمد جان"], dobs: ["1963", "1972-01-30"], nationalities: ["AF"], addresses: ["Afghanistan"]},
    {id: "DPR0075", kind: "vessel", name: "Petrel 8", aliases: ["Jal Vahini", "Tian Tai 36"]},
    {id: "AQD0011", kind: "entity", name: "AL-HARAMAIN & AL MASJED AL-AQSA CHARITY FOUNDATION", aliases: ["Al Haramain Al Masjed Al Aqsa"], addresses: ["Hamdije Cemerlica 41, Sarajevo, Bosnia and Herzegovina"]}
  ], (e) { ::entry/make({...common, ...e}) })
}

list-c fn (): Vec {
  common {source: "list-c", list: "Sample List C"}
  map([
    {id: "13", kind: "individual", name: "Saddam Hussein Al-Tikriti", aliases: ["Abu Ali", "Abou Ali"], dobs: ["1937-04-28"], nationalities: ["IQ"], programs: ["IRQ"]},
    {id: "382", kind: "entity", name: "Asbat al-Ansar", addresses: ["Ein el-Hilweh camp, LEBANON"], programs: ["TAQA"]}
  ], (e) { ::entry/make({...common, ...e}) })
}

list-d fn (): Vec {
  common {source: "list-d", list: "Sample List D"}
  map([
    {id: "IQi.004", kind: "individual", name: "ABID HAMID MAHMUD AL-TIKRITI", aliases: ["Abid Hamid Bid Hamid Mahmud", "Abed Mahmoud Hammud", "عابد حامد محمود التكريتي"], dobs: ["1957"], nationalities: ["IQ"], programs: ["Iraq"]},
    {id: "CDi.047", kind: "individual", name: "MUHAMMED LUMISA", aliases: ["LUMISA, MUHAMAD"], dobs: ["1959/1965"], nationalities: ["UG"], addresses: ["Democratic Republic of the Congo"], programs: ["DRC"]},
    {id: "CDe.005", kind: "entity", name: "FORCES DEMOCRATIQUES DE LIBERATION DU RWANDA (FDLR)", aliases: ["FDLR", "Combatant Force for the Liberation of Rwanda"], addresses: ["North Kivu, Democratic Republic of the Congo"], programs: ["DRC"]}
  ], (e) { ::entry/make({...common, ...e}) })
}

// In-memory indexes per source, as the cache stores them.
indexes fn (): Map {
  {
    list-a: ::index/build(list-a()),
    list-b: ::index/build(list-b()),
    list-c: ::index/build(list-c()),
    list-d: ::index/build(list-d())
  }
}
