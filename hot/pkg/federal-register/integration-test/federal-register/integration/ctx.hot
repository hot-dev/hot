::federal-register::integration::ctx ns

::env ::hot::env

// The Federal Register needs no key but only runs with FEDERAL_REGISTER_LIVE=1,
// so CI without network stays hermetic.

live
meta {doc: """True when FEDERAL_REGISTER_LIVE=1."""}
fn (): Bool {
    eq(::env/get("FEDERAL_REGISTER_LIVE", ""), "1")
}

skip
meta {doc: """Record a skip and pass."""}
fn (why: Str): Bool {
    println(`federal-register integration: ${why} - skipping`)
    assert(true, `skipped: ${why}`)
}
