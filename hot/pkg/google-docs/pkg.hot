::hot::pkg ns

hot.pkg.google-docs {
  name: "hot.dev/google-docs",
  version: "0.1.0",
  hot-min-version: "3.0.2",
  description: "Google Docs API v1 bindings for Hot: read documents and tabs as plain text, paragraphs, headings and tables, create documents, fill templates, and batchUpdate with builders for text, styles, bullets, tables, images, named ranges, headers and footers.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["documents"],
  deps: {
    "hot.dev/google-core": "0.1.1"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
