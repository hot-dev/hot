::ofac::http ns
meta {
    doc: """
    Requests to the Sanctions List Service: a typed `HttpError` and text
    bodies that survive any content type. Every file this package uses
    fits the default 16 MiB response cap.
    """
}

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

USER_AGENT "hot-dev-ofac-pkg/0.1 (+https://hot.dev)"

HttpError
meta {
    doc: """A non-2xx response from the Sanctions List Service. `url` is the requested URL (without credentials); `message` is a one-line summary."""
}
type {
    status: Int,
    url: Str,
    headers: Map,
    body: Any,
    message: Str
}

body-snippet
meta {no-doc: true}
fn (body: Any): Str {
  text match body {
    Null => { "" }
    Str => { body }
    Bytes => { "" }
    _ => { to-json(body) }
  }

  if(gt(length(text), 200), `${slice(text, 0, 200)}…`, text)
}

http-error
meta {
    doc: """
    Build an `HttpError` from a non-2xx response. Exposed for testing; every
    request uses it.

    **Example**

    ```hot
    url "https://example.test/x"
    response ::hot::http/HttpResponse({status: 404, headers: {}, body: "not here"})
    e ::ofac::http/http-error(response, url)
    e.status  // 404
    e.message  // "HTTP 404 from https://example.test/x: not here"
    ```
    """
}
fn (response: HttpResponse, url: Str): HttpError {
  snippet body-snippet(response.body)
  HttpError({
    status: response.status,
    url: url,
    headers: or(response.headers, {}),
    body: response.body,
    message: if(is-empty(snippet), `HTTP ${response.status} from ${url}`, `HTTP ${response.status} from ${url}: ${snippet}`)
  })
}

body-text
meta {
    doc: """
    The response body as text: the decoded string when Hot kept it as one,
    otherwise the body bytes decoded as UTF-8 (a CSV served as
    `application/octet-stream`, or a body that happened to parse as JSON).

    **Example**

    ```hot
    ::ofac::http/body-text({body: "a,b"})  // "a,b"
    ::ofac::http/body-text({body: [1, 2], body-bytes: Bytes("[1,2]")})  // "[1,2]"
    ```
    """
}
fn (response: Any): Str {
  body get(response, "body")
  bytes get(response, "body-bytes")
  cond {
    is-bytes(bytes) => { Str(bytes) }
    is-str(body) => { body }
    is-bytes(body) => { Str(body) }
    is-null(body) => { "" }
    => { to-json(body) }
  }
}

request
meta {
    doc: """
    One request with the package User-Agent. Returns the `HttpResponse` on
    2xx, or an Err carrying `HttpError` (transport failures pass through as
    their own Err).

    **Example**

    ```hot
    ::http ::ofac::http

    // Lists the published files. An Err carries HttpError on a non-2xx status.
    response ::http/request(
      "POST",
      "https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/SdnList",
      {Content-Type: "application/json", Accept: "application/json"},
      "{}"
    )
    response.body
    ```
    """
}
fn (method: Str, url: Str, headers: Map, body: Any): HttpResponse {
  response ::hot::http/request(HttpRequest({
    method,
    url,
    headers: {User-Agent: USER_AGENT, ...headers},
    body
  }))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response }
    => { err(http-error(response, url)) }
  }
}

get-text
meta {
    doc: """
    GET a file as text: the body as a Str, or an Err.

    **Example**

    ```hot
    csv ::ofac::http/get-text(::ofac/export-url("SDN.CSV"))

    // Parse it with the other files, or inspect the text
    length(csv)
    ```
    """
}
fn (url: Str): Str {
  response request("GET", url, {}, "")
  cond {
    is-err(response) => { response }
    => { body-text(response) }
  }
}
