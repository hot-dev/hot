  usergroup_id: Str,
  team_id: Str?,
  include_num_members: Bool?
}

list-channels
meta {
    doc: """
    admin.usergroups.listChannels - List the channels linked to an IDP group (`channels`).

    Scope: `admin.usergroups:read`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.

    **Example**

    ```hot
    ::usergroups ::slack::admin::usergroups

    res ::usergroups/list-channels(::usergroups/ListChannelsRequest({usergroup_id: "S0123ABCDEF", include_num_members: true}))
    res.channels
    ```
    """
}
fn
(request: ListChannelsRequest): Map {
  list-channels(request, {})
},
(request: ListChannelsRequest, opts: Map): Map {
  ::api/call("admin.usergroups.listChannels", request, opts)
}

