::supabase::storage ns

::api ::supabase::api
::core ::supabase::core
::uri ::hot::uri

StorageBucket type {
  id: Str?,
  name: Str,
  public: Bool?,
  created_at: Str?,
  updated_at: Str?
}

StorageObject type {
  name: Str,
  id: Str?,
  updated_at: Str?,
  created_at: Str?,
  last_accessed_at: Str?,
  metadata: Map?
}

SignedUrlResponse type {
  signedURL: Str
}

SignedUploadUrlResponse type {
  url: Str,
  token: Str?
}

enc
meta {no-doc: true}
fn (value: Any): Str {
  ::uri/encode(Str(value))
}

encode-object-path
meta {no-doc: true}
fn (path: Str): Str {
  join(map(split(path, "/"), enc(%)), "/")
}

bucket-path
meta {no-doc: true}
fn (bucket: Str): Str {
  enc(bucket)
}

object-path
meta {no-doc: true}
fn (bucket: Str, path: Str): Str {
  `${bucket-path(bucket)}/${encode-object-path(path)}`
}

body-or-error
meta {no-doc: true}
fn (response: Result): Any {
  ::api/body-or-error(response)
}

// ============================================================================
// Buckets
// ============================================================================

list-buckets
meta {
    doc: """
List all storage buckets.

**Example**

```hot
::storage ::supabase::storage

buckets ::storage/list-buckets()
// => [{id: "avatars", name: "avatars", public: true, ...}, ...]
```
"""
}
fn
(): Vec<StorageBucket> {
  list-buckets({})
},
(opts: Map): Vec<StorageBucket> {
  ::api/request-service("GET", "/storage/v1/bucket", {}, {}, opts)
}

get-bucket
meta {
    doc: """
    Get a bucket by ID.

    **Example**

    ```hot
    ::storage ::supabase::storage

    bucket ::storage/get-bucket("avatars")
    bucket.public
    ```
    """
}
fn
(bucket-id: Str): StorageBucket {
  get-bucket(bucket-id, {})
},
(bucket-id: Str, opts: Map): StorageBucket {
  ::api/request-service("GET", `/storage/v1/bucket/${bucket-path(bucket-id)}`, {}, {}, opts)
}

CreateBucketRequest type {
  name: Str,
  id: Str?,
  public: Bool?,
  file_size_limit: Int?,
  allowed_mime_types: Vec<Str>?
}

create-bucket
meta {
    doc: """
Create a new storage bucket. Set `public: true` for publicly accessible files.

**Example**

```hot
::storage ::supabase::storage

::storage/create-bucket(::storage/CreateBucketRequest({
  name: "avatars",
  public: true,
  file_size_limit: 5242880,
  allowed_mime_types: ["image/png", "image/jpeg"]
}))
```
"""
}
fn
(request: CreateBucketRequest): Map {
  create-bucket(request, {})
},
(request: CreateBucketRequest, opts: Map): Map {
  body {name: request.name, id: or(request.id, request.name)}
    |> assoc-some("public", request.public)
    |> assoc-some("file_size_limit", request.file_size_limit)
    |> assoc-some("allowed_mime_types", request.allowed_mime_types)

  ::api/request-service("POST", "/storage/v1/bucket", {}, body, opts)
}

UpdateBucketRequest type {
  bucket_id: Str,
  public: Bool?,
  file_size_limit: Int?,
  allowed_mime_types: Vec<Str>?
}

update-bucket
meta {
    doc: """
    Update a bucket's settings.

    **Example**

    ```hot
    ::storage ::supabase::storage

    ::storage/update-bucket(::storage/UpdateBucketRequest({
      bucket_id: "avatars",
      public: false,
      file_size_limit: 1048576
    }))
    ```
    """
}
fn
(request: UpdateBucketRequest): Map {
  update-bucket(request, {})
},
(request: UpdateBucketRequest, opts: Map): Map {
  body {}
    |> assoc-some("public", request.public)
    |> assoc-some("file_size_limit", request.file_size_limit)
    |> assoc-some("allowed_mime_types", request.allowed_mime_types)

  ::api/request-service("PUT", `/storage/v1/bucket/${bucket-path(request.bucket_id)}`, {}, body, opts)
}

empty-bucket
meta {
    doc: """
    Remove all objects from a bucket without deleting the bucket itself.

    **Example**

    ```hot
    ::storage ::supabase::storage

    ::storage/empty-bucket("avatars")
    ```
    """
}
fn
(bucket-id: Str): Map {
  empty-bucket(bucket-id, {})
},
(bucket-id: Str, opts: Map): Map {
  ::api/request-service("POST", `/storage/v1/bucket/${bucket-path(bucket-id)}/empty`, {}, {}, opts)
}

delete-bucket
meta {
    doc: """
    Delete a bucket. The bucket must be empty first (use `empty-bucket`).

    **Example**

    ```hot
    ::storage ::supabase::storage

    ::storage/empty-bucket("avatars")
    ::storage/delete-bucket("avatars")
    ```
    """
}
fn
(bucket-id: Str): Map {
  delete-bucket(bucket-id, {})
},
(bucket-id: Str, opts: Map): Map {
  ::api/request-service("DELETE", `/storage/v1/bucket/${bucket-path(bucket-id)}`, {}, {}, opts)
}

// ============================================================================
// Objects
// ============================================================================

upload
meta {
    doc: """
Upload a file to a bucket. `content` is the file content as a string. `content-type` is the MIME type.

Set `upsert: true` to overwrite existing files.

**Example**

```hot
::storage ::supabase::storage

result ::storage/upload("avatars", "users/alice.txt", "Hello World", "text/plain", false)
result.Key  // => "avatars/users/alice.txt"
```
"""
}
fn
(bucket: Str, path: Str, content: Str, content-type: Str): Map {
  upload(bucket, path, content, content-type, false)
},
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool): Map {
  upload(bucket, path, content, content-type, upsert, {})
},
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool, opts: Map): Map {
  body-or-error(upload-response(bucket, path, content, content-type, upsert, opts))
}

upload-as
meta {
    doc: """
    Like `upload`, but as a signed-in user. `access-token` is the Bearer
    token, so row level security applies as that user.

    **Example**

    ```hot
    ::storage ::supabase::storage

    token ::hot::ctx/get("supabase.user.token")
    result ::storage/upload-as("avatars", "users/alice.txt", "Hello World", "text/plain", true, token)
    result.Key
    ```
    """
}
fn
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool, access-token: Str): Map {
  upload-as(bucket, path, content, content-type, upsert, access-token, {})
},
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool, access-token: Str, opts: Map): Map {
  body-or-error(upload-response-as(bucket, path, content, content-type, upsert, access-token, opts))
}

upload-service
meta {
    doc: """
    Like `upload`, with the service role key, which bypasses row level
    security. Server-side only.

    **Example**

    ```hot
    ::storage ::supabase::storage

    result ::storage/upload-service("avatars", "users/alice.txt", "Hello World", "text/plain", true)
    result.Key
    ```
    """
}
fn
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool): Map {
  upload-service(bucket, path, content, content-type, upsert, {})
},
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool, opts: Map): Map {
  body-or-error(upload-response-service(bucket, path, content, content-type, upsert, opts))
}

upload-headers
meta {no-doc: true}
fn (content-type: Str, upsert: Bool): Map {
  headers {Content-Type: content-type}
  if(upsert, {...headers, "x-upsert": "true"}, headers)
}

upload-response
meta {
    doc: """
    Like `upload`, but returns the full `HttpResponse`. A non-2xx status is
    not an Err: check `status`.

    **Example**

    ```hot
    ::storage ::supabase::storage

    response ::storage/upload-response("avatars", "users/alice.txt", "Hello World", "text/plain", true)
    response.status
    ```
    """
}
fn
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool): ::api/HttpResponse {
  upload-response(bucket, path, content, content-type, upsert, {})
},
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool, opts: Map): ::api/HttpResponse {
  ::api/request-raw-body("POST", `/storage/v1/object/${object-path(bucket, path)}`, upload-headers(content-type, upsert), content, opts)
}

upload-response-as
meta {
    doc: """
    Like `upload-as`, but returns the full `HttpResponse`. A non-2xx status
    is not an Err: check `status`.

    **Example**

    ```hot
    ::storage ::supabase::storage

    token ::hot::ctx/get("supabase.user.token")
    response ::storage/upload-response-as("avatars", "users/alice.txt", "Hello World", "text/plain", true, token)
    response.status
    ```
    """
}
fn
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool, access-token: Str): ::api/HttpResponse {
  upload-response-as(bucket, path, content, content-type, upsert, access-token, {})
},
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool, access-token: Str, opts: Map): ::api/HttpResponse {
  ::api/request-raw-body-as("POST", `/storage/v1/object/${object-path(bucket, path)}`, upload-headers(content-type, upsert), content, access-token, opts)
}

upload-response-service
meta {
    doc: """
    Like `upload-service`, but returns the full `HttpResponse`. A non-2xx
    status is not an Err: check `status`.

    **Example**

    ```hot
    ::storage ::supabase::storage

    response ::storage/upload-response-service("avatars", "users/alice.txt", "Hello World", "text/plain", true)
    response.status
    ```
    """
}
fn
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool): ::api/HttpResponse {
  upload-response-service(bucket, path, content, content-type, upsert, {})
},
(bucket: Str, path: Str, content: Str, content-type: Str, upsert: Bool, opts: Map): ::api/HttpResponse {
  ::api/request-raw-body-service("POST", `/storage/v1/object/${object-path(bucket, path)}`, upload-headers(content-type, upsert), content, opts)
}

download
meta {
    doc: """
Download a file from a private bucket. Returns the file content.

**Example**

```hot
::storage ::supabase::storage

content ::storage/download("documents", "reports/q1.pdf")
```
"""
}
fn
(bucket: Str, path: Str): Any {
  download(bucket, path, {})
},
(bucket: Str, path: Str, opts: Map): Any {
  ::api/request("GET", `/storage/v1/object/authenticated/${object-path(bucket, path)}`, {}, {}, opts)
}

