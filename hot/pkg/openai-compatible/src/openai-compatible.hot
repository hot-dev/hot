meta {doc: "Every built-in preset."}
[OLLAMA, VLLM, LM_STUDIO, GROQ, OPENROUTER, DEEPSEEK, TOGETHER, FIREWORKS, MISTRAL, CEREBRAS, PERPLEXITY]

CUSTOM
meta {
    doc: """
    Any other OpenAI-compatible server or private gateway. It has no default
    URL: `openai-compatible.url`, or `base-url` in `opts`. Sends `max_tokens`
    and no `stream_options`, the most widely accepted shape.
    """
}

Preset({
    name: "OpenAI-compatible",
    base-url: "",
    base-url-ctx: "openai-compatible.url",
    model-prefix: "custom/",
    key-ctx: "openai-compatible.api.key",
    key-env: "OPENAI_COMPATIBLE_API_KEY",
    max-tokens-param: "max_tokens",
    stream-usage: false,
    capabilities: ["tools", "streaming"],
    docs-url: "https://platform.openai.com/docs/api-reference/chat"
})

// ============================================================================
// Building providers
// ============================================================================

configure
meta {
    doc: """
    Turn a `Preset` into an `::openai::compatible/CompatibleProvider` with
    an explicit key (null for keyless servers). Reads no ctx.

    `overrides` may set `base-url`, `model-prefix`, `name`, `headers`,
    `max-tokens` (output ceiling, default 4096) and `extra-body`
    (provider-specific request fields). The key is masked in the run's call
    records. A hosted preset with no key and no `base-url` override gives a
    provider whose calls need `api-key` in their `opts`.

    **Example**

    ```hot
    ::oc ::openai-compatible

    groq ::oc/configure(::oc/GROQ, "gsk_...")
    remote-ollama ::oc/configure(::oc/OLLAMA, null, {base-url: "http://gpu-box.internal:11434/v1"})
    routed ::oc/configure(::oc/OPENROUTER, "sk-or-...", {
        headers: {"HTTP-Referer": "https://example.com", "X-OpenRouter-Title": "Example"},
        extra-body: {provider: {sort: "throughput"}}
    })
    ```
    """
}
fn
(preset: Preset, api-key: Str?): CompatibleProvider {
    configure(preset, api-key, {})
},
(preset: Preset, api-key: Str?, overrides: Map): CompatibleProvider {
    options ::openai::chat-tools/ChatRequestOptions({
        max-completion-tokens: or(get(overrides, "max-tokens"), DEFAULT_MAX_TOKENS),
        reasoning-effort: get(overrides, "reasoning-effort"),
        max-tokens-param: preset.max-tokens-param,
        stream-usage: preset.stream-usage,
        extra-body: get(overrides, "extra-body")
    })
    headers get(overrides, "headers")
    url-override ::api/non-blank(get(overrides, "base-url"))
    ep ::api/endpoint(or(url-override, preset.base-url), api-key, if(is-empty(or(headers, {})), null, headers))

    cond {
        is-err(ep) => { ep }
        => {
            CompatibleProvider({
                name: or(get(overrides, "name"), preset.name),
                endpoint: ep,
                model-prefix: or(get(overrides, "model-prefix"), preset.model-prefix),
                options: options,
                capabilities: preset.capabilities,
                key-name: if(and(eq(preset.key-required, true), is-null(url-override)), preset.key-ctx, null)
            })
        }
    }
}

resolve-from
meta {
    doc: """
    The resolver for named presets, pure: a provider for `preset` from `opts`
    first, then `ctx-values` (`{key, base-url}`, the values of the preset's ctx
    variables), then defaults. An Err when `api-key` in `opts` is blank (never
    a fallback to ctx), when a hosted preset has a `base-url` in `opts` but no
    `api-key` (the ctx key is never sent to a per-call URL), when that
    `base-url` is not a plain http(s) URL, or when the preset has no URL at
    all. On a server that needs no key, a per-call `base-url` sends none.
    Exposed for testing; `resolve` feeds it the context.

    **Example**

    ```hot
    ::openai-compatible/resolve-from(::openai-compatible/GROQ, {api-key: "k"}, {}).endpoint.api-key  // => "k"
    ```
    """
}
fn (preset: Preset, opts: Map, ctx-values: Map): CompatibleProvider {
    has-own-key in("api-key", keys(opts))
    own-key ::api/non-blank(get(opts, "api-key"))
    per-call-url ::api/non-blank(get(opts, "base-url"))
    url-without-key and(is-some(per-call-url), not(has-own-key))
    url-override or(per-call-url, ::api/non-blank(get(ctx-values, "base-url")))
    key cond {
        has-own-key => { own-key }
        is-some(per-call-url) => { null }
        => { ::api/non-blank(get(ctx-values, "key")) }
    }

    cond {
        and(has-own-key, is-null(own-key)) => {
            err(`${preset.name}: api-key in the call's opts is blank. Pass the key, or leave api-key out to use ${or(preset.key-ctx, "no key")}.`)
        }

        and(url-without-key, eq(preset.key-required, true)) => {
            err(`${preset.name}: base-url in the call's opts needs api-key in opts too. ${preset.key-ctx} is never sent to a per-call base URL.`)
        }

        and(is-some(per-call-url), is-null(::api/url-parts(trim(or(per-call-url, ""))))) => {
            err(`${preset.name}: base-url in the call's opts is not a plain http(s) URL. Userinfo, backslashes and control characters are refused.`)
        }

        and(is-null(url-override), is-empty(preset.base-url)) => {
            err(`${preset.name}: no base URL. Set ${preset.base-url-ctx} in Context Variables, or pass {base-url: ...} in the call's opts.`)
        }

        is-some(url-override) => { configure(preset, key, {...opts, base-url: url-override}) }
        => { configure(preset, key, opts) }
    }
}

ctx-value
meta {no-doc: true}
fn (key: Str?): Any {
    cond {
        is-null(key) => { null }
        => { ::ctx/get(key) }
    }
}

resolve
meta {
    doc: """
    A provider for `preset` under one call's `opts`: `opts` over the preset's
    ctx variables over its defaults (see `resolve-from`). With an `api-key` in
    `opts`, the ctx key is not read. Nothing is written to ctx, and a key from
    `opts` is masked in the run's call records.

    **Example**

    ```hot
    tenant ::openai-compatible/resolve(::openai-compatible/GROQ, {api-key: "gsk_tenant"})
    remote ::openai-compatible/resolve(::openai-compatible/OLLAMA, {base-url: "http://gpu-box.internal:11434/v1"})
    ```
    """
}
fn (preset: Preset, opts: Map): CompatibleProvider {
    ::ctx/mark-secret(opts.api-key)
    has-own-key in("api-key", keys(opts))
    resolve-from(preset, opts, {
        key: if(has-own-key, null, ctx-value(preset.key-ctx)),
        base-url: ctx-value(preset.base-url-ctx)
    })
}

provider
meta {
    doc: """
    Build an `::ai::chat/ProviderRegistration` from a configured provider,
    via `::openai::compatible/provider`. Models starting with the preset's
    prefix route to it; the prefix is stripped before the request.

    **Example**

    ```hot
    registry ::ai::chat/with-providers([::openai-compatible/provider(::openai-compatible/ollama())])
    ```
    """
}
fn (p: CompatibleProvider): ::ai::chat/ProviderRegistration {
    ::compat/provider(p)
}

chat-fn
meta {
    doc: """
    The `::ai::chat/run-loop` chat function bound to `p` (for
    `ChatOptions.chat-fn`).

    **Example**

    ```hot
    ::oc ::openai-compatible

    opts ::ai::chat/ChatOptions({model: "llama3.2", chat-fn: ::oc/chat-fn(::oc/ollama())})
    ::ai::chat/run-loop(opts, "Hello!")
    ```
    """
}
fn (p: CompatibleProvider): Fn {
    ::compat/chat-fn(p)
}

chat-stream-fn
meta {
    doc: """
    The `::ai::chat/run-loop-stream` chat function bound to `p` (for
    `ChatOptions.chat-stream-fn`).

    **Example**

    ```hot
    ::oc ::openai-compatible

    opts ::ai::chat/ChatOptions({model: "llama3.2", chat-stream-fn: ::oc/chat-stream-fn(::oc/ollama())})
    ::ai::chat/run-loop-stream(opts, "Hello!", (delta) { print(delta) })
    ```
    """
}
fn (p: CompatibleProvider): Fn {
    ::compat/chat-stream-fn(p)
}

chat-opts-fn
meta {
    doc: """
    The `::ai::chat/run-loop` chat function bound to `p` that also takes
    `ChatOptions.provider-opts` (for `ChatOptions.chat-opts-fn`).

    **Example**

    ```hot
    ::oc ::openai-compatible

    opts ::ai::chat/ChatOptions({
      model: "llama-3.3-70b-versatile",
      chat-opts-fn: ::oc/chat-opts-fn(::oc/groq()),
      provider-opts: {api-key: ::hot::ctx/get("tenant.groq.key")}
    })
    ::ai::chat/run-loop(opts, "Hello!")
    ```
    """
}
fn (p: CompatibleProvider): Fn {
    ::compat/chat-opts-fn(p)
}

chat-stream-opts-fn
meta {
    doc: """
    The `::ai::chat/run-loop-stream` chat function bound to `p` that also
    takes `ChatOptions.provider-opts` (for
    `ChatOptions.chat-stream-opts-fn`).

    **Example**

    ```hot
    ::oc ::openai-compatible

    opts ::ai::chat/ChatOptions({
      model: "llama-3.3-70b-versatile",
      chat-stream-opts-fn: ::oc/chat-stream-opts-fn(::oc/groq()),
      provider-opts: {api-key: ::hot::ctx/get("tenant.groq.key")}
    })
    ::ai::chat/run-loop-stream(opts, "Hello!", (delta) { print(delta) })
    ```
    """
}
fn (p: CompatibleProvider): Fn {
    ::compat/chat-stream-opts-fn(p)
}

// ============================================================================
// Named presets (read keys from ctx)
// ============================================================================

ollama
meta {
    doc: """
    Local Ollama. `ollama.base.url` overrides the default
    `http://localhost:11434/v1` (e.g. `https://ollama.com/v1` for Ollama's
    hosted API, with `ollama.api.key`). Keyless by default.

    **Example**

    ```hot
    ::oc ::openai-compatible

    ::openai-compatible::chat/chat(::oc/ollama(), "llama3.2", "Say hi")

    // A remote server, for one call
    ::oc/ollama({base-url: "http://gpu-box.internal:11434/v1"})
    ```
    """,
    ctx: {
        "ollama.base.url": {required: false, default: "http://localhost:11434/v1", secret: false},
        "ollama.api.key": {required: false}
    }
}
fn
(): CompatibleProvider {
    ollama({})
},
(opts: Map): CompatibleProvider {
    resolve(OLLAMA, opts)
}

vllm
meta {
    doc: """
    vLLM server at `vllm.base.url` (default `http://localhost:8000/v1`).
    `vllm.api.key` only when the server runs with `--api-key`.

    **Example**

    ```hot
    ::oc ::openai-compatible

    ::openai-compatible::chat/chat(::oc/vllm(), "Qwen/Qwen3-8B", "Say hi")

    // A remote server, for one call
    ::oc/vllm({base-url: "http://gpu-box.internal:8000/v1"})
    ```
    """,
    ctx: {
        "vllm.base.url": {required: false, default: "http://localhost:8000/v1", secret: false},
        "vllm.api.key": {required: false}
    }
}
fn
(): CompatibleProvider {
    vllm({})
},
(opts: Map): CompatibleProvider {
    resolve(VLLM, opts)
}

