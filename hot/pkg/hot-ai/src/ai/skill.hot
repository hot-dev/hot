::ai::skill ns
meta {
    doc: """
    Skills are LLM-judgment-routed prompt augmentations: named bundles
    of instructions (and optionally bundled tools) that an agent can
    pull into its context on demand. Prompt-only skills can be built
    directly as `Skill({...})` records. Executable or function-backed
    skills can also be declared by adding `meta {skill: {...}}` to a
    Hot function; `::ai::skill/from-fn` uses the compiler-harvested
    metadata to build the same `Skill` shape at runtime.

    Three built-in tools (`list_skills`, `read_skill`, `apply_skill`)
    are auto-added by `::ai::chat/run-loop` so the model can discover
    and pull skills on demand without exhausting context up front.

    **Example**

    ```hot
    customer-tone
    meta {skill: {
        description: "Apply our customer voice rules",
        when: ["customer reply", "marketing copy", "support email"],
        body: "Use a warm, plain-language tone. Avoid jargon. Close with a next step."
    }}
    fn () { {} }

    generated-tone Skill({
        name: "generated-tone",
        description: "A prompt-only generated skill",
        when: ["generated guidance"],
        body: "Use this body directly."
    })
    ```

    Modalities
    ----------

    A skill may declare the input kinds it can act on via
    `modalities` (e.g. `["image", "pdf"]`). The resolver index
    surfaces this hint so the model picks skills appropriate to the
    turn — a vision-only skill is unlikely to be the right pick on a
    pure-text turn, and vice versa. `null` ≡ `["text"]`. Modalities
    are advisory: the field does not gate dispatch, the model still
    decides.

    Per-turn context (attachments, sender, transport)
    -------------------------------------------------

    `body-fn(ctx: Map)` skills receive a `ctx` argument that the
    model populates at the `apply_skill(name, ctx)` call site. The
    harness can also inject per-turn data via
    `ChatOptions.skill-context`, which is merged into `ctx` **with
    harness keys winning** — so the model cannot spoof harness-owned
    values like `attachments`.

    The conventional reserved key is `attachments`: when the agent
    runtime normalizes an inbound message it stamps the inbound
    attachments into `opts.skill-context.attachments`. A skill that
    wants to see them simply declares an `attachments` parameter on
    its `body-fn` — the framework destructures `ctx` by parameter
    name (`::hot::internal::mcp/invoke-with-input` semantics), so a
    skill never has to do its own `get(ctx, "attachments")`.

    Static `body` strings are returned verbatim — the harness does
    not interpolate `${...}` placeholders into them. If you want
    attachment-aware logic, write a `body-fn`.

    ```hot
    receipt-analyzer
    meta {skill: {
        description: "Extract line items from a receipt",
        when: ["receipt", "expense"],
        modalities: ["image", "pdf"],
    }}
    fn (attachments: Vec?): Str {
        atts or(attachments, [])
        cond {
            is-empty(atts) => { "Ask the user to attach a receipt." }
            => {
                count length(atts)
                `Use any vision tools available to extract line items
                 from the ${count} attached file(s).`
            }
        }
    }
    ```
    """
}

::tool ::ai::tool
::res  ::hot::resource
::md   ::hot::md

// ============================================================================
// Skill type
// ============================================================================

Skill
meta {
    doc: """
    A reusable prompt augmentation. Most fields are optional:

    - `name` — unique identifier the model uses with `read_skill` /
      `apply_skill`. Defaults to the qualified Hot function name.
    - `description` — short summary the model uses to decide when to
      pull the skill. Required for any useful skill.
    - `when` — trigger phrases that hint when this skill applies.
      Joined into the resolver index injected into the system prompt.
    - `modalities` — input kinds this skill can act on, e.g.
      `["text"]`, `["image", "pdf"]`. Surfaced in the resolver index so
      the model can pick the right skill for a non-text turn. Default
      `null` ≡ `["text"]`. See "Modalities" in the module doc.
    - `body` — inline instructions returned by `read_skill`. May be
      loaded from a resource via `::hot::resource/load-str`. Returned
      verbatim — static bodies are not interpolated.
    - `body-fn` — alternative to `body`: a function `(ctx: Map) -> Str`
      that produces context-aware instructions. The harness merges
      per-turn data (e.g. inbound attachments) into `ctx` before
      calling — see "Per-turn context" in the module doc.
    - `tools` — bundled tools that become available to the model
      whenever the skill is read.
    - `requires` — names of other skills this one depends on.
    - `fn` — back-reference to the Hot function the skill was harvested
      from. Preserved for callers that need to round-trip to the source
      function; built-in `read_skill` / `apply_skill` resolve `body` or
      `body-fn` rather than calling this function.
    - `license` — optional license identifier or filename from `SKILL.md`.
    - `compatibility` — optional environment/product requirements from
      `SKILL.md` (max 500 chars per agentskills.io).
    - `metadata` — optional author metadata map (e.g. `{author, version}`)
      from `SKILL.md`.
    - `allowed-tools` — optional pre-approved tools hint from `SKILL.md`
      (either the spec's space-delimited `Str` or a `Vec<Str>`). Use
      `allowed-tools-of` to normalize to `Vec<Str>`.
    - `resource-root` — optional relative resource directory for Tier-3
      bundled files (e.g. `"reglang"` or `"skills/invoice-parser"`).
    - `extra` — any unrecognized top-level frontmatter keys preserved by
      `from-markdown` without polluting `metadata`.
    """
}
type {
    name: Str,
    description: Str,
    when: Vec<Str>?,
    modalities: Vec<Str>?,
    body: Str?,
    body-fn: Fn?,
    tools: Vec<::tool/Tool>?,
    requires: Vec<Str>?,
    fn: Fn?,
    license: Str?,
    compatibility: Str?,
    metadata: Map?,
    allowed-tools: Str | Vec<Str> | Null,
    resource-root: Str?,
    extra: Map?
}

// ============================================================================
// Construction
// ============================================================================

from-fn
meta {
    doc: """
    Build a `Skill` from a Hot function annotated with
    `meta {skill: {...}}`. The annotation map is merged with sensible
    defaults: `name` falls back to the qualified function name, `when`
    defaults to `[]`.

    **Example**

    ```hot
    tone
    meta {skill: {description: "Customer tone", when: ["reply"], body: "..."}}
    fn () { {} }

    skill ::ai::skill/from-fn(tone)
    // => Skill({name: "::myapp/tone", description: "Customer tone", ...})
    ```
    """
}
fn (f: Fn): Skill {
    raw ::hot::internal::skill/meta-from-fn(f)
    base {
        name: or(get(raw, "name"), raw.fn-name),
        description: or(get(raw, "description"), ""),
        when: or(get(raw, "when"), []),
        modalities: get(raw, "modalities"),
        body: get(raw, "body"),
        body-fn: get(raw, "body-fn"),
        tools: get(raw, "tools"),
        requires: get(raw, "requires"),
        fn: f
    }

    enriched base
        |> assoc-some("license", get(raw, "license"))
        |> assoc-some("compatibility", get(raw, "compatibility"))
        |> assoc-some("metadata", get(raw, "metadata"))
        |> assoc-some("allowed-tools", get(raw, "allowed-tools"))
        |> assoc-some("resource-root", get(raw, "resource-root"))
    Skill(enriched)
}

for-agent
meta {
    doc: """
    Normalize an agent's `skills:` list (a mix of Hot function refs
    and pre-built `Skill` records) into a `Vec<Skill>` ready for
    `::ai::chat/run-loop`. Per the design, agents must list every
    skill function explicitly — there is no namespace glob.

    **Example**

    ```hot
    skills ::ai::skill/for-agent([customer-tone, escalation-policy])
    ```
    """
}
fn (entries: Vec<Any>): Vec<Skill> {
    map(entries, (entry) {
        if(is-type(entry, Skill), entry, from-fn(entry))
    })
}

// ============================================================================
// Body resolution
// ============================================================================

load-body
meta {
    doc: """
    Resolve the body of a `Skill` for a given invocation context.

    Resolution order:
    1. If `skill.body-fn` is non-null, call it with `ctx` and return
       the resulting string.
    2. Otherwise return `skill.body` (or `""` if absent).

    Errors from `body-fn` propagate as `Result.Err`.

    **Example**

    ```hot
    skill ::ai::skill/Skill({name: "tone", description: "Customer voice", body: "Be warm."})
    ::ai::skill/load-body(skill, {topic: "refund"})  // "Be warm."
    ```
    """
}
fn (skill: Skill, ctx: Map): Str {
    body-fn skill.body-fn
    body skill.body
    cond {
        not(is-null(body-fn)) => {
            ::hot::internal::mcp/invoke-with-input(body-fn, ctx)
        }

        not(is-null(body)) => { body }
        => { "" }
    }
}

// ============================================================================
// Resolver index
// ============================================================================

index-line
meta {
    doc: """
    Render a single skill as one line in the resolver index, e.g.
    `"  - customer-tone: Apply our voice (when: reply, marketing)"`.
    Trigger phrases and modalities are comma-joined; missing fields
    are omitted. Modalities (when set and non-default) are appended
    in their own bracketed clause so the model can choose skills
    appropriate to the turn's input kind.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    ::skill/index-line(first(skills))  // "  - tone: Customer voice (when: reply)"
    ```
    """
}
fn (skill: Skill): Str {
    when-str cond {
        is-null(skill.when) => { "" }
        is-empty(skill.when) => { "" }
        => { ` (when: ${join(skill.when, ", ")})` }
    }

    mods-str cond {
        is-null(skill.modalities) => { "" }
        is-empty(skill.modalities) => { "" }
        => { ` (modalities: ${join(skill.modalities, ", ")})` }
    }
    `  - ${skill.name}: ${skill.description}${when-str}${mods-str}`
}

build-index
meta {
    doc: """
    Build a system-prompt fragment that lists every skill available to
    the agent, formatted so an LLM can decide which skills to read
    next. Prepended with a short header describing the `read_skill`
    contract.

    **Example**

    ```hot
    ::skill ::ai::skill
    tone ::skill/Skill({name: "customer-tone", description: "Apply our voice", when: ["reply", "marketing"]})
    ::skill/build-index([tone])
    // "Available skills you can read with read_skill(name):\n  - customer-tone: Apply our voice (when: reply, marketing)"
    ```
    """
}
fn (skills: Vec<Skill>): Str {
    cond {
        is-empty(skills) => { "" }
        => {
            header "Available skills you can read with read_skill(name):"
            lines map(skills, index-line)
            join(concat([header], lines), "\n")
        }
    }
}

// ============================================================================
// Built-in tools
// ============================================================================

find-skill
meta {
    doc: """
    Look up a skill by `name`, returning `null` when no match.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    ::skill/find-skill(skills, "tone").body  // "Be warm."
    ::skill/find-skill(skills, "missing")  // null
    ```
    """
}
fn (skills: Vec<Skill>, name: Str): Skill? {
    find-first(skills, eq(%.name, name))
}

list-skills-of
meta {
    doc: """
    Build the body for a `list_skills` tool call: a vector of
    `{name, description, when}` maps suitable for an LLM to scan.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    ::skill/list-skills-of(skills)  // [{name: "tone", description: "Customer voice", when: ["reply"]}]
    ```
    """
}
fn (skills: Vec<Skill>): Vec<Map> {
    map(skills, (s) {
        {
            name: s.name,
            description: s.description,
            when: or(s.when, [])
        }
    })
}

builtin-list-skills
meta {
    doc: """
    Construct the `list_skills` built-in tool over the given skill
    set. Used internally by `builtins`; exposed for callers that want
    to wire individual built-ins by hand.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    tool ::skill/builtin-list-skills(skills)
    tool.name  // "list_skills"
    map(tool.fn(), %.name)  // ["tone"]
    ```
    """
}
fn (skills: Vec<Skill>): ::tool/Tool {
    ::tool/Tool({
        name: "list_skills",
        description: "List every skill available to this agent.",
        input-schema: {type: "object", properties: {}, required: []},
        output-schema: null,
        fn: () { list-skills-of(skills) }
    })
}

format-skill-body-with-requires
meta {
    no-doc: true,
    doc: """
    Internal: append a stateless trailing hint naming `skill.requires` when
    non-empty. Returns `body` unchanged when `requires` is null or empty.
    """
}
fn (skill: Skill, body: Str): Str {
    reqs skill.requires
    cond {
        or(is-null(reqs), is-empty(reqs)) => { body }
        => {
            hint `Required skills (read each if you have not already): ${join(reqs, ", ")}`
            if(is-empty(body), hint, `${body}\n\n${hint}`)
        }
    }
}

builtin-read-skill
meta {
    doc: """
    Construct the `read_skill` built-in tool over the given skill set.
    Returns the resolved body for the named skill, or an error string
    when the name is unknown.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    tool ::skill/builtin-read-skill(skills)
    tool.fn("tone")  // "Be warm."
    tool.fn("missing")  // "Unknown skill: missing"
    ```
    """
}
fn (skills: Vec<Skill>): ::tool/Tool {
    ::tool/Tool({
        name: "read_skill",
        description: "Return the full instructions for a single skill by name.",
        input-schema: {
            type: "object",
            properties: {name: {type: "string"}},
            required: ["name"]
        },
        output-schema: null,
        fn: (name: Str): Str {
            s find-skill(skills, name)
            if(is-null(s), `Unknown skill: ${name}`, format-skill-body-with-requires(s, load-body(s, {})))
        }
    })
}

builtin-apply-skill
meta {
    doc: """
    Construct the `apply_skill` built-in tool over the given skill
    set. Like `read_skill` but lets the model pass a `ctx` map that
    reaches the skill's `body-fn` (when present).

    The arity-2 form takes a `skill-context: Map?` whose keys are
    merged into the model-supplied ctx **with harness keys winning**.
    The harness uses this to thread per-turn data (e.g. `attachments`)
    into skill activation without trusting the model to populate it.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    tool ::skill/builtin-apply-skill(skills, {user: "Ada"})
    tool.fn("tone", {})  // "Be warm."
    ```
    """
}
fn
(skills: Vec<Skill>): ::tool/Tool { builtin-apply-skill(skills, null) },
(skills: Vec<Skill>, skill-context: Map?): ::tool/Tool {
    ::tool/Tool({
        name: "apply_skill",
        description: "Resolve a skill against an optional context map and return its body.",
        input-schema: {
            type: "object",
            properties: {
                name: {type: "string"},
                ctx: {type: "object"}
            },
            required: ["name"]
        },
        output-schema: null,
        fn: (name: Str, ctx: Map?): Str {
            s find-skill(skills, name)
            enriched merge(or(ctx, {}), or(skill-context, {}))
            if(is-null(s), `Unknown skill: ${name}`, format-skill-body-with-requires(s, load-body(s, enriched)))
        }
    })
}

builtins
meta {
    doc: """
    Return the three built-in tools (`list_skills`, `read_skill`,
    `apply_skill`) bound over `skills`. Concatenated into the agent's
    `tools` list by `::ai::chat/run-loop` whenever the agent declares
    one or more skills.

    The arity-2 form forwards `skill-context` to `builtin-apply-skill`
    so per-turn harness data flows into skill activation. See
    `ChatOptions.skill-context` for the conventional usage.

    Equivalent to `builtins-with-resolver(in-memory-resolver(skills))`
    minus the optional `search_skills` tool. Kept for backwards
    compatibility with callers that wire skill toolsets directly.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    map(::skill/builtins(skills), %.name)  // ["list_skills", "read_skill", "apply_skill"]
    ```
    """
}
fn
(skills: Vec<Skill>): Vec<::tool/Tool> { builtins(skills, null) },
(skills: Vec<Skill>, skill-context: Map?): Vec<::tool/Tool> {
    [
        builtin-list-skills(skills),
        builtin-read-skill(skills),
        builtin-apply-skill(skills, skill-context)
    ]
}

// ============================================================================
// SkillResolver — pluggable strategy for skill discovery
// ============================================================================

SkillResolver
meta {
    doc: """
    Pluggable strategy for picking which skills are visible to the
    model on a given turn. `::ai::chat/run-loop` calls into a resolver
    at fixed points:

    - `list-fn(ctx)` — once per turn, when building the system-prompt
      skill index. Returns the `Vec<Skill>` to advertise this turn.
      `ctx` is a map carrying the turn's `messages`, `system` prompt,
      and `model`; resolvers may inspect any of these to decide what
      to surface (e.g. embed the last user message and rank a store).
    - `read-fn(name)` — invoked from the `read_skill` and `apply_skill`
      built-in tools when the model asks for a specific skill body.
      Should return `null` for unknown names. Note this is decoupled
      from `list-fn`: a store-backed resolver may know about more
      skills than it surfaces in any single turn.
    - `search-fn(query, opts)` — optional. When set, `run-loop` adds a
      `search_skills` tool that lets the model query the resolver directly.
    - `list-resources-fn(skill)` — optional `(skill: Skill) -> Vec<Map>`.
      When set, `builtins-with-resolver` adds `list_skill_resources`.
    - `read-resource-fn(skill, rel-path, offset)` — optional
      `(skill: Skill, rel-path: Str, offset: Int?) -> Str`. When set,
      `builtins-with-resolver` adds `read_skill_resource`.

    Built-in factories:

    - `in-memory-resolver(skills)` — current behaviour, no search.
    - `searchable-resolver(skills, opts)` — like `in-memory-resolver` but
      with a substring-rank `search-fn` over name/description/when.
    - `resource-resolver(skills-or-prefix, opts)` — loads or wraps
      `SKILL.md` skills with Tier-3 bundled-file access.

    Custom resolvers (Postgres, Pinecone, LLM-judged routing, etc.)
    are constructed by passing your own `Fn` slots to
    `SkillResolver({...})` directly.
    """
}
type {
    list-fn: Fn,
    read-fn: Fn,
    search-fn: Fn?,
    skills: Vec<Skill>?,
    list-resources-fn: Fn?,
    read-resource-fn: Fn?
}

// ----------------------------------------------------------------------------
// Substring search helper
// ----------------------------------------------------------------------------

skill-search-score
meta {
    doc: """
    Internal: case-insensitive substring score for one skill against a
    query. Counts hits in `name` (×3), `description` (×2), and
    `when` triggers (×1). Returns `0` for no match.
    """,
    no-doc: true
}
fn (skill: Skill, query: Str): Int {
    q lowercase(trim(query))
    cond {
        is-empty(q) => { 0 }
        => {
            name-hits if(contains(lowercase(skill.name), q), 3, 0)
            desc-hits if(contains(lowercase(skill.description), q), 2, 0)
            when-hits cond {
                is-null(skill.when) => { 0 }
                => {
                    matched filter(skill.when, contains(lowercase(%), q))
                    length(matched)
                }
            }

            add(add(name-hits, desc-hits), when-hits)
        }
    }
}

search-skills-of
meta {
    doc: """
    Rank `skills` against a free-text `query` using a lightweight
    case-insensitive substring scorer. `opts.limit` caps the result
    (default 10); `opts.min-score` filters out weak hits (default 1).
    Returns the highest-scoring `Skill` records, ties broken by input
    order.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    map(::skill/search-skills-of(skills, "voice", {limit: 5}), %.name)  // ["tone"]
    ::skill/search-skills-of(skills, "zzz", {})  // []
    ```
    """
}
fn (skills: Vec<Skill>, query: Str, opts: Map): Vec<Skill> {
    limit or(get(opts, "limit"), 10)
    min-score or(get(opts, "min-score"), 1)
    skills
        |> map((s) { {skill: s, score: skill-search-score(s, query)} })
        |> filter(gte(%.score, min-score))
        |> sort-by(sub(0, %.score))
        |> slice(0, limit)
        |> map(%.skill)
}

// ----------------------------------------------------------------------------
// Factories
// ----------------------------------------------------------------------------

in-memory-resolver
meta {
    doc: """
    Default `SkillResolver`: `list-fn` returns the full `skills`
    vector every turn, `read-fn` does an in-memory name lookup, and
    `search-fn` is `null`. When any skill carries a `resource-root`,
    also wires `list-resources-fn` and `read-resource-fn` for Tier-3
    bundled-file access; otherwise omits them so pre-existing callers
    see the exact same resolver shape and tool list.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    resolver ::skill/in-memory-resolver(skills)
    map(resolver.list-fn({}), %.name)  // ["tone"]
    resolver.read-fn("tone").body  // "Be warm."
    ```
    """
}
fn (skills: Vec<Skill>): SkillResolver {
    has-resources some(skills, (s) { is-some(s.resource-root) })
    base {
        list-fn: (ctx: Map): Vec<Skill> { skills },
        read-fn: (name: Str): Skill? { find-skill(skills, name) },
        search-fn: null,
        skills: skills
    }

    enriched cond {
        has-resources => {
            base
                |> assoc("list-resources-fn", (s: Skill): Vec<Map> { list-skill-resources-of(s, null) })
                |> assoc("read-resource-fn", (s: Skill, rel-path: Str, offset: Int?): Str {
                    read-skill-resource-of(s, rel-path, assoc-some({}, "offset", offset))
                })
        }
        => { base }
    }

    SkillResolver(enriched)
}

searchable-resolver
meta {
    doc: """
    `SkillResolver` over a fixed `Vec<Skill>` that also exposes a
    substring-rank `search-fn`. `run-loop` will surface a fourth
    `search_skills` tool so the model can query for relevant skills
    on demand. When any skill carries a `resource-root`, also wires
    `list-resources-fn` and `read-resource-fn`.

    `opts.always-on` (default `[]`) are skills returned from
    `list-fn` every turn regardless of search; the rest of `skills`
    are reachable only via `search_skills` and `read_skill`. This
    keeps the system-prompt index small while still letting the
    model find the long tail.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    resolver ::skill/searchable-resolver(skills, {always-on: []})
    resolver.list-fn({})  // []
    map(resolver.search-fn("voice", {}), %.name)  // ["tone"]
    ```
    """
}
fn (skills: Vec<Skill>, opts: Map): SkillResolver {
    always-on or(get(opts, "always-on"), [])
    has-resources some(skills, (s) { is-some(s.resource-root) })
    base {
        list-fn: (ctx: Map): Vec<Skill> { always-on },
        read-fn: (name: Str): Skill? { find-skill(skills, name) },
        search-fn: (query: Str, search-opts: Map): Vec<Skill> {
            search-skills-of(skills, query, or(search-opts, {}))
        },
        skills: skills
    }

    enriched cond {
        has-resources => {
            base
                |> assoc("list-resources-fn", (s: Skill): Vec<Map> { list-skill-resources-of(s, null) })
                |> assoc("read-resource-fn", (s: Skill, rel-path: Str, offset: Int?): Str {
                    read-skill-resource-of(s, rel-path, assoc-some({}, "offset", offset))
                })
        }
        => { base }
    }

    SkillResolver(enriched)
}

// ----------------------------------------------------------------------------
// Resolver-aware built-in tools
// ----------------------------------------------------------------------------

builtin-list-skills-r
meta {
    doc: """
    Resolver-aware variant of `builtin-list-skills`. The bound
    `list_skills` tool consults the resolver's `list-fn` on every
    invocation, so resolvers that change their output over time (e.g.
    a hybrid resolver that re-ranks after new context arrives) stay
    in sync with what the model sees.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    tool ::skill/builtin-list-skills-r(::skill/in-memory-resolver(skills))
    map(tool.fn(), %.name)  // ["tone"]
    ```
    """
}
fn (resolver: SkillResolver): ::tool/Tool {
    ::tool/Tool({
        name: "list_skills",
        description: "List every skill currently available to this agent.",
        input-schema: {type: "object", properties: {}, required: []},
        output-schema: null,
        fn: () { list-skills-of(resolver.list-fn({})) }
    })
}

builtin-read-skill-r
meta {
    doc: """
    Resolver-aware variant of `builtin-read-skill`. Routes name
    lookups through `resolver.read-fn`, so a store-backed resolver
    can serve skills it never surfaced in the index.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    tool ::skill/builtin-read-skill-r(::skill/in-memory-resolver(skills))
    tool.fn("tone")  // "Be warm."
    ```
    """
}
fn (resolver: SkillResolver): ::tool/Tool {
    ::tool/Tool({
        name: "read_skill",
        description: "Return the full instructions for a single skill by name.",
        input-schema: {
            type: "object",
            properties: {name: {type: "string"}},
            required: ["name"]
        },
        output-schema: null,
        fn: (name: Str): Str {
            s resolver.read-fn(name)
            if(is-null(s), `Unknown skill: ${name}`, format-skill-body-with-requires(s, load-body(s, {})))
        }
    })
}

builtin-apply-skill-r
meta {
    doc: """
    Resolver-aware variant of `builtin-apply-skill`. Like
    `builtin-read-skill-r` but lets the model pass a `ctx` map that
    reaches the skill's `body-fn` (when present).

    The arity-2 form takes a `skill-context: Map?` whose keys are
    merged into the model-supplied ctx with harness keys winning.
    See `ChatOptions.skill-context`.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    tool ::skill/builtin-apply-skill-r(::skill/in-memory-resolver(skills), {user: "Ada"})
    tool.fn("tone", {})  // "Be warm."
    ```
    """
}
fn
(resolver: SkillResolver): ::tool/Tool { builtin-apply-skill-r(resolver, null) },
(resolver: SkillResolver, skill-context: Map?): ::tool/Tool {
    ::tool/Tool({
        name: "apply_skill",
        description: "Resolve a skill against an optional context map and return its body.",
        input-schema: {
            type: "object",
            properties: {
                name: {type: "string"},
                ctx: {type: "object"}
            },
            required: ["name"]
        },
        output-schema: null,
        fn: (name: Str, ctx: Map?): Str {
            s resolver.read-fn(name)
            enriched merge(or(ctx, {}), or(skill-context, {}))
            if(is-null(s), `Unknown skill: ${name}`, format-skill-body-with-requires(s, load-body(s, enriched)))
        }
    })
}

builtin-search-skills-r
meta {
    doc: """
    Built-in `search_skills` tool. Only constructed when the resolver
    declares a `search-fn`; built around `resolver.search-fn(query,
    opts)` so any backing strategy (substring, embeddings, vendor
    APIs) works without changes here.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    tool ::skill/builtin-search-skills-r(::skill/searchable-resolver(skills, {}))
    map(tool.fn("voice", 3), %.name)  // ["tone"]
    ```
    """
}
fn (resolver: SkillResolver): ::tool/Tool {
    search-fn resolver.search-fn
    resolver-skills resolver.skills
    ::tool/Tool({
        name: "search_skills",
        description: "Search available skills by free-text query. \
                      Returns the top matches as {name, description, when} maps. \
                      Use this when the system prompt does not list a skill \
                      that seems relevant.",
        input-schema: {
            type: "object",
            properties: {
                query: {type: "string"},
                limit: {type: "integer"}
            },
            required: ["query"]
        },
        output-schema: null,
        fn: (query: Str, limit: Int?): Vec<Map> {
            opts if(is-null(limit), {}, {limit: limit})
            hits cond {
                not(is-null(resolver-skills)) => { search-skills-of(resolver-skills, query, opts) }
                => { search-fn(query, opts) }
            }

            list-skills-of(hits)
        }
    })
}

builtin-list-skill-resources-r
meta {
    doc: """
    Built-in `list_skill_resources` tool. Only constructed when the
    resolver declares a `list-resources-fn`. Lists bundled files
    (as `{path, size}` maps) inside a skill's `resource-root`.
    """
}
fn (resolver: SkillResolver): ::tool/Tool {
    list-res-fn resolver.list-resources-fn
    ::tool/Tool({
        name: "list_skill_resources",
        description: "List bundled files (references, examples, assets) inside a skill directory as {path, size} maps.",
        input-schema: {
            type: "object",
            properties: {name: {type: "string"}},
            required: ["name"]
        },
        output-schema: null,
        fn: (name: Str): Any {
            s resolver.read-fn(name)
            cond {
                is-null(s) => { `Unknown skill: ${name}` }
                => { list-res-fn(s) }
            }
        }
    })
}

builtin-read-skill-resource-r
meta {
    doc: """
    Built-in `read_skill_resource` tool. Only constructed when the
    resolver declares a `read-resource-fn`. Reads a bundled text file
    relative to the named skill's `resource-root`, with an optional
    character `offset` for large files.
    """
}
fn (resolver: SkillResolver): ::tool/Tool {
    read-res-fn resolver.read-resource-fn
    ::tool/Tool({
        name: "read_skill_resource",
        description: "Read a bundled file relative to a skill directory (for example references/spec.md). Pass offset to continue reading a large file.",
        input-schema: {
            type: "object",
            properties: {
                name: {type: "string"},
                path: {type: "string"},
                offset: {type: "integer"}
            },
            required: ["name", "path"]
        },
        output-schema: null,
        fn: (name: Str, path: Str, offset: Int?): Str {
            s resolver.read-fn(name)
            cond {
                is-null(s) => { `Unknown skill: ${name}` }
                => { read-res-fn(s, path, offset) }
            }
        }
    })
}

builtins-with-resolver
meta {
    doc: """
    Build the per-turn skill toolset from a `SkillResolver`. Always
    emits `list_skills`, `read_skill`, and `apply_skill`; appends
    `search_skills` when `search-fn` is set, `list_skill_resources`
    when `list-resources-fn` is set, and `read_skill_resource` when
    `read-resource-fn` is set.

    The arity-2 form forwards `skill-context` to `builtin-apply-skill-r`
    so per-turn harness data flows into skill activation. See
    `ChatOptions.skill-context` for the conventional usage.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    map(::skill/builtins-with-resolver(::skill/searchable-resolver(skills, {})), %.name)
    // ["list_skills", "read_skill", "apply_skill", "search_skills"]
    ```
    """
}
fn
(resolver: SkillResolver): Vec<::tool/Tool> { builtins-with-resolver(resolver, null) },
(resolver: SkillResolver, skill-context: Map?): Vec<::tool/Tool> {
    base [
        builtin-list-skills-r(resolver),
        builtin-read-skill-r(resolver),
        builtin-apply-skill-r(resolver, skill-context)
    ]
    with-search if(is-null(resolver.search-fn), base, concat(base, [builtin-search-skills-r(resolver)]))
    with-list-res if(is-null(resolver.list-resources-fn), with-search, concat(with-search, [builtin-list-skill-resources-r(resolver)]))
    if(is-null(resolver.read-resource-fn), with-list-res, concat(with-list-res, [builtin-read-skill-resource-r(resolver)]))
}

// ----------------------------------------------------------------------------
// Resolver helper for run-loop integration
// ----------------------------------------------------------------------------

effective-resolver
meta {
    doc: """
    Resolve which `SkillResolver` `::ai::chat/run-loop` should use on
    a given call. Precedence:

    1. `opts.skill-resolver` (when non-null) wins outright.
    2. Otherwise `opts.skills` is materialized via `for-agent` and
       wrapped in `in-memory-resolver`.
    3. When neither is set, returns `null` — `run-loop` skips the
       skill index and skill builtins entirely.

    **Example**

    ```hot
    ::skill ::ai::skill
    skills [::skill/Skill({name: "tone", description: "Customer voice", when: ["reply"], body: "Be warm."})]
    ::skill/effective-resolver(null, null)  // null
    resolver ::skill/effective-resolver(null, skills)
    map(resolver.list-fn({}), %.name)  // ["tone"]
    ```
    """
}
fn (skill-resolver: SkillResolver?, skills: Vec<Any>?): SkillResolver? {
    cond {
        not(is-null(skill-resolver)) => { skill-resolver }
        is-null(skills) => { null }
        is-empty(skills) => { null }
        => { in-memory-resolver(for-agent(skills)) }
    }
}

// ============================================================================
// SKILL.md parsing, validation, and resource loading
// ============================================================================

DEFAULT_MAX_RESOURCE_CHARS 250000

SPEC_FRONTMATTER_KEYS ["name", "description", "license", "allowed-tools", "metadata", "compatibility"]
KNOWN_FRONTMATTER_KEYS ["name", "description", "when", "modalities", "requires", "license", "compatibility", "metadata", "allowed-tools"]
VALID_SKILL_NAME_CHARS "abcdefghijklmnopqrstuvwxyz0123456789-"

is-ws-char
meta { no-doc: true }
fn (ch: Str): Bool {
    or(eq(ch, " "), eq(ch, "\t"), eq(ch, "\n"), eq(ch, "\r"))
}

parse-allowed-tools
meta {
    doc: """
    Parse an `allowed-tools` value (`Str | Vec<Str> | Null`) into a
    `Vec<Str>`. Space-separated strings are split outside parentheses
    so entries like `"Read Glob Bash(git add:*)"` remain intact as
    `["Read", "Glob", "Bash(git add:*)"]`.
    """
}
fn (raw: Str | Vec<Str> | Null): Vec<Str> {
    cond {
        is-null(raw) => { [] }
        is-vec(raw) => { raw }
        => {
            n length(raw)
            state reduce(range(0, n), (acc, i) {
                ch slice(raw, i, add(i, 1))
                depth acc.depth
                buf acc.buf
                items acc.items
                cond {
                    eq(ch, "(") => { {depth: add(depth, 1), buf: `${buf}${ch}`, items} }
                    eq(ch, ")") => { {depth: max(0, sub(depth, 1)), buf: `${buf}${ch}`, items} }
                    and(eq(depth, 0), is-ws-char(ch)) => {
                        if(is-empty(buf), acc, {depth: 0, buf: "", items: concat(items, [buf])})
                    }
                    => { {depth, buf: `${buf}${ch}`, items} }
                }
            }, {depth: 0, buf: "", items: []})
            if(is-empty(state.buf), state.items, concat(state.items, [state.buf]))
        }
    }
}

allowed-tools-of
meta {
    doc: """
    Return a skill's normalized `allowed-tools` list (`Vec<Str>`),
    accepting either the agentskills.io space-separated string form
    or a `Vec<Str>`. Returns `[]` when unset.
    """
}
fn (skill: Skill): Vec<Str> {
    parse-allowed-tools(skill.allowed-tools)
}

parse-meta-str-list
meta { no-doc: true }
fn (val: Any): Vec<Str>? {
    cond {
        is-null(val) => { null }
        is-vec(val) => { val }
        is-str(val) => {
            parts split(val, ",")
                |> map(trim(%))
                |> filter((s) { not(is-empty(s)) })
            if(is-empty(parts), null, parts)
        }
        => { null }
    }
}

extract-hot-list
meta { no-doc: true }
fn (front: Map, meta-map: Map?, top-key: Str, meta-key: Str): Vec<Str>? {
    top get(front, top-key)
    cond {
        is-some(top) => { top }
        is-null(meta-map) => { null }
        => { parse-meta-str-list(get(meta-map, meta-key)) }
    }
}

extract-extra-frontmatter
meta { no-doc: true }
fn (front: Map): Map? {
    ks filter(keys(front), (k) { not(in(k, KNOWN_FRONTMATTER_KEYS)) })
    cond {
        is-empty(ks) => { null }
        => {
            reduce(ks, (acc, k) { assoc(acc, k, get(front, k)) }, {})
        }
    }
}

is-valid-skill-name-chars
meta { no-doc: true }
fn (name: Str): Bool {
    n length(name)
    all(range(0, n), (i) { contains(VALID_SKILL_NAME_CHARS, slice(name, i, add(i, 1))) })
}

validate-skill-md
meta {
    doc: """
    Validate a `Skill` against the agentskills.io specification.
    Returns a `Vec<Str>` of human-readable problems (empty when valid):

    - `name`: 1–64 chars of `[a-z0-9-]`, no leading, trailing, or
      consecutive hyphens, and equal to `dir-name` when provided.
    - `description`: 1–1024 chars (non-empty).
    - `compatibility`: when set, 1–500 chars.
    - `metadata`: when set, all values must be strings.
    """
}
fn
(skill: Skill): Vec<Str> { validate-skill-md(skill, null) },
(skill: Skill, dir-name: Str?): Vec<Str> {
    name skill.name
    desc skill.description
    compat skill.compatibility
    meta-map skill.metadata

    p1 cond {
        is-empty(name) => { ["name must not be empty"] }
        gt(length(name), 64) => { ["name must be at most 64 characters"] }
        not(is-valid-skill-name-chars(name)) => { ["name must use only lowercase ASCII letters, digits, and hyphens"] }
        or(starts-with(name, "-"), ends-with(name, "-")) => { ["name must not start or end with a hyphen"] }
        contains(name, "--") => { ["name must not contain consecutive hyphens"] }
        => { [] }
    }

    p2 cond {
        and(is-some(dir-name), ne(name, dir-name)) => { [`name '${name}' must match parent directory '${dir-name}'`] }
        => { [] }
    }

    p3 cond {
        is-blank(desc) => { ["description must not be empty"] }
        gt(length(desc), 1024) => { ["description must be at most 1024 characters"] }
        => { [] }
    }

    p4 cond {
        is-null(compat) => { [] }
        is-blank(compat) => { ["compatibility must not be empty when set"] }
        gt(length(compat), 500) => { ["compatibility must be at most 500 characters"] }
        => { [] }
    }

    p5 cond {
        is-null(meta-map) => { [] }
        not(all(vals(meta-map), is-str)) => { ["metadata values must all be strings"] }
        => { [] }
    }
    [...p1, ...p2, ...p3, ...p4, ...p5]
}

frontmatter-portability-notes
meta {
    doc: """
    Return advisory notes for top-level frontmatter keys outside the
    agentskills.io six-field schema (`name`, `description`, `license`,
    `allowed-tools`, `metadata`, `compatibility`). Never an error.
    """
}
fn (front: Map): Vec<Str> {
    keys(front)
        |> filter((k) { not(in(k, SPEC_FRONTMATTER_KEYS)) })
        |> map((k) { `Top-level frontmatter key '${k}' is outside the agentskills.io six-field schema.` })
}

from-markdown
meta {
    doc: """
    Parse a `SKILL.md` (or `*.skill.md`) Markdown string with YAML
    frontmatter into a `Skill`.

    Reads Hot extension fields (`when`, `modalities`, `requires`) from
    the top level first, falling back to `metadata.hot-when`,
    `metadata.hot-modalities`, and `metadata.hot-requires` (each
    accepted as a comma-separated string or a YAML list). Leaves
    `parsed.body` verbatim and puts any unrecognized top-level keys in
    `extra` rather than `metadata`.

    Options (`opts`):
    - `default-name: Str` — fallback when frontmatter omits `name`.
    - `dir-name: Str` — expected directory name for `strict` validation.
    - `resource-root: Str` — relative resource directory for Tier-3 files.
    - `strict: Bool` — when `true`, validates via `validate-skill-md`
      and returns `Err` on any problem (including missing `description`).
    """
}
fn
(raw: Str): Skill { from-markdown(raw, {}) },
(raw: Str, opts: Map): Skill {
    parsed ::md/parse-frontmatter(raw)
    front parsed.frontmatter
    strict or(get(opts, "strict"), false)
    raw-meta get(front, "metadata")
    meta-map if(is-map(raw-meta), raw-meta, null)

    raw-name or(get(front, "name"), get(opts, "default-name"))
    cond {
        or(is-null(raw-name), not(is-str(raw-name)), is-blank(raw-name)) => {
            err("Skill frontmatter must include a non-empty 'name'")
        }
        => {
            raw-desc get(front, "description")
            cond {
                and(strict, or(is-null(raw-desc), not(is-str(raw-desc)), is-blank(raw-desc))) => {
                    err("Skill frontmatter must include a non-empty 'description'")
                }
                => {
                    desc or(raw-desc, "")
                    when-val extract-hot-list(front, meta-map, "when", "hot-when")
                    mods-val extract-hot-list(front, meta-map, "modalities", "hot-modalities")
                    reqs-val extract-hot-list(front, meta-map, "requires", "hot-requires")
                    raw-allowed get(front, "allowed-tools")
                    allowed-val cond {
                        is-null(raw-allowed) => { null }
                        is-vec(raw-allowed) => { raw-allowed }
                        is-str(raw-allowed) => { parse-allowed-tools(raw-allowed) }
                        => { raw-allowed }
                    }

                    extra-val extract-extra-frontmatter(front)

                    fields {
                        name: raw-name,
                        description: desc
                    }
                        |> assoc-some("when", when-val)
                        |> assoc-some("modalities", mods-val)
                        |> assoc("body", parsed.body)
                        |> assoc-some("requires", reqs-val)
                        |> assoc-some("license", get(front, "license"))
                        |> assoc-some("compatibility", get(front, "compatibility"))
                        |> assoc-some("metadata", raw-meta)
                        |> assoc-some("allowed-tools", allowed-val)
                        |> assoc-some("resource-root", get(opts, "resource-root"))
                        |> assoc-some("extra", extra-val)

                    skill Skill(fields)
                    cond {
                        strict => {
                            problems validate-skill-md(skill, get(opts, "dir-name"))
                            if(is-empty(problems), skill, err(join(problems, "; ")))
                        }
                        => { skill }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Bundled-file access (Tier-3 progressive disclosure)
// ============================================================================

normalize-skill-rel-path
meta {
    doc: """
    Validate and normalize a relative path inside a skill directory.
    Rejects empty paths, leading `/`, backslashes, `.` / `..` segments,
    dot-prefixed segments, empty segments (`//`), and `SKILL.md`.
    """
}
fn (rel-path: Str): Result<Str, Str> {
    cond {
        is-empty(rel-path) => { err("path must not be empty") }
        starts-with(rel-path, "/") => { err("path must be relative") }
        contains(rel-path, "\\") => { err("path must use forward slashes") }
        eq(rel-path, "SKILL.md") => { err("use read_skill to read SKILL.md") }
        => {
            segs split(rel-path, "/")
            bad some(segs, (seg) {
                or(is-empty(seg), eq(seg, "."), eq(seg, ".."), starts-with(seg, "."))
            })
            if(bad, err("path contains invalid or hidden segment"), ok(rel-path))
        }
    }
}

join-resource-path
meta { no-doc: true }
fn (root: Str, rel: Str): Str {
    if(is-empty(root), rel, `${root}/${rel}`)
}

is-in-nested-skill
meta { no-doc: true }
fn (root: Str, rel-path: Str): Bool {
    segs split(rel-path, "/")
    n length(segs)
    cond {
        lte(n, 1) => { false }
        => {
            some(range(1, n), (i) {
                sub-dir join(slice(segs, 0, i), "/")
                ::res/exists(join-resource-path(root, `${sub-dir}/SKILL.md`))
            })
        }
    }
}

list-skill-resources-of
meta {
    doc: """
    List bundled files inside `skill.resource-root` as `{path, size}`
    maps sorted by `path`. Excludes `SKILL.md`, dot-prefixed segments,
    files inside nested skill directories, and anything rejected by
    the optional `filter-fn(skill, rel-path)`. Returns `[]` when
    `skill.resource-root` is `null` or empty.
    """
}
fn
(skill: Skill): Vec<Map> { list-skill-resources-of(skill, null) },
(skill: Skill, filter-fn: Fn?): Vec<Map> {
    root skill.resource-root
    cond {
        // An empty root would match every resource in the project.
        or(is-null(root), is-empty(root)) => { [] }
        => {
            prefix `${root}/`
            prefix-len length(prefix)
            all-refs ::res/list()
            all-refs
                |> filter((ref) { starts-with(ref.path, prefix) })
                |> map((ref) {
                    {path: slice(ref.path, prefix-len, length(ref.path)), size: ref.size}
                })
                |> filter((item) {
                    norm normalize-skill-rel-path(item.path)
                    and(
                        is-ok(norm),
                        not(is-in-nested-skill(root, item.path)),
                        if(is-null(filter-fn), true, filter-fn(skill, item.path))
                    )
                })
                |> sort-by(%.path)
        }
    }
}

read-skill-resource-of
meta {
    doc: """
    Read a bundled text file relative to `skill.resource-root` via
    `::hot::resource`. Returns a plain error message string (not a
    halt) when the skill has no `resource-root`, the path is invalid,
    filtered, missing, or non-UTF-8.

    Options (`opts`):
    - `offset: Int` — starting character index (default `0`).
    - `max-resource-chars: Int` — max characters per read (default
      `250000`). When text remains, ends at the last newline in the
      window (or cuts at `max-resource-chars` if no newline exists)
      and appends a continuation line naming the next `offset`.
    - `resource-filter: Fn` — optional `(skill, rel-path) -> Bool`
      predicate; rejected paths report `"Resource not found"`.
    """
}
fn
(skill: Skill, rel-path: Str): Str { read-skill-resource-of(skill, rel-path, {}) },
(skill: Skill, rel-path: Str, opts: Map): Str {
    root skill.resource-root
    cond {
        or(is-null(root), is-empty(root)) => { `Skill '${skill.name}' has no bundled resources.` }
        => {
            norm normalize-skill-rel-path(rel-path)
            cond {
                is-err(norm) => { `Invalid resource path '${rel-path}': ${err-message(norm)}.` }
                => {
                    rel ok-value(norm)
                    filter-fn get(opts, "resource-filter")
                    blocked or(
                        is-in-nested-skill(root, rel),
                        and(is-some(filter-fn), not(filter-fn(skill, rel)))
                    )
                    full-path join-resource-path(root, rel)
                    cond {
                        or(blocked, not(::res/exists(full-path))) => { `Resource not found: ${rel-path}` }
                        => {
                            loaded ::res/load-str(full-path)
                            cond {
                                is-err(loaded) => { `Resource is not valid UTF-8 text: ${rel-path}` }
                                => {
                                    text ok-value(loaded)
                                    offset or(get(opts, "offset"), 0)
                                    max-chars or(get(opts, "max-resource-chars"), DEFAULT_MAX_RESOURCE_CHARS)
                                    total length(text)
                                    cond {
                                        lt(offset, 0) => { "Invalid offset: must be >= 0." }
                                        lte(max-chars, 0) => { "Invalid max-resource-chars: must be > 0." }
                                        and(gt(offset, 0), gte(offset, total)) => {
                                            `Offset ${offset} is past end of resource (${total} characters).`
                                        }

                                        and(eq(offset, 0), lte(total, max-chars)) => { text }
                                        => {
                                            end-limit min(add(offset, max-chars), total)
                                            cond {
                                                gte(end-limit, total) => { slice(text, offset, total) }
                                                => {
                                                    window slice(text, offset, end-limit)
                                                    parts split(window, "\n")
                                                    cut cond {
                                                        gt(length(parts), 1) => {
                                                            sub(length(window), length(last(parts)))
                                                        }
                                                        => { length(window) }
                                                    }

                                                    next-offset add(offset, cut)
                                                    chunk slice(window, 0, cut)
                                                    note `[Characters ${offset} to ${next-offset} of ${total}. For the rest, call read_skill_resource with offset ${next-offset}.]`
                                                    if(ends-with(chunk, "\n"), `${chunk}${note}`, `${chunk}\n${note}`)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// ============================================================================
// Resource loaders & resource-resolver
// ============================================================================

path-parent
meta { no-doc: true }
fn (p: Str): Str {
    segs split(p, "/")
    if(lte(length(segs), 1), "", join(slice(segs, 0, sub(length(segs), 1)), "/"))
}

path-basename
meta { no-doc: true }
fn (p: Str): Str {
    segs split(p, "/")
    if(is-empty(segs), "", last(segs))
}

trim-trailing-slashes
meta { no-doc: true }
fn (p: Str): Str {
    cond {
        and(not(is-empty(p)), ends-with(p, "/")) => {
            trim-trailing-slashes(slice(p, 0, sub(length(p), 1)))
        }
        => { p }
    }
}

has-dot-segment
meta { no-doc: true }
fn (p: Str): Bool {
    some(split(p, "/"), (seg) { and(not(is-empty(seg)), starts-with(seg, ".")) })
}

from-resource
meta {
    doc: """
    Load a single `Skill` from `::hot::resource` at `rel-path`.

    - For `<dir>/SKILL.md`, sets `resource-root` to the parent
      directory (unless `opts.expose-resources` is `false`) and uses
      the directory basename as `default-name` and `dir-name`.
    - A `SKILL.md` at the top of a resource root has no directory of
      its own: its siblings are every other resource in the project.
      It loads as a skill with no `resource-root`, so it exposes no
      bundled files, unless `opts.resource-root` names a directory.
    - For `*.skill.md`, derives `default-name` from the filename stem
      and leaves `resource-root` unset unless provided in `opts`.
    """
}
fn
(rel-path: Str): Skill { from-resource(rel-path, {}) },
(rel-path: Str, opts: Map): Skill {
    raw ::res/load-str(rel-path)
    expose-res ne(get(opts, "expose-resources"), false)
    base path-basename(rel-path)
    is-skill-md eq(base, "SKILL.md")
    merged-opts cond {
        is-skill-md => {
            parent path-parent(rel-path)
            dir-name if(is-empty(parent), null, path-basename(parent))
            // An empty parent is the top of the resource roots, not a
            // directory this skill owns, so it is never a resource root.
            own-dir if(is-empty(parent), null, parent)
            opts
                |> assoc-some("default-name", or(get(opts, "default-name"), dir-name))
                |> assoc-some("dir-name", or(get(opts, "dir-name"), dir-name))
                |> assoc-some("resource-root", if(expose-res, or(get(opts, "resource-root"), own-dir), null))
        }

        ends-with(base, ".skill.md") => {
            stem slice(base, 0, sub(length(base), 9))
            opts
                |> assoc-some("default-name", or(get(opts, "default-name"), stem))
        }
        => { opts }
    }

    from-markdown(raw, merged-opts)
}

from-resources
meta {
    doc: """
    Discover and load all `SKILL.md` (and optionally `*.skill.md`)
    skills under `prefix` from `::hot::resource`.

    `prefix` is required; pass `""` to scan every resource root
    (including dependency resources). Paths with dot-prefixed segments
    under `prefix` are skipped. Results are sorted by resource path.
    Duplicate skill names return `Err` unless `opts.on-duplicate` is
    `"first"`.

    Options (`opts`):
    - `include-legacy-ext: Bool` — include `*.skill.md` files (default `true`).
    - `on-duplicate: Str` — `"error"` (default) or `"first"`.
    - `expose-resources: Bool` — set `resource-root` on `SKILL.md` skills (default `true`).
    - `strict: Bool` — validate every loaded skill via `validate-skill-md`.
    """
}
fn
(prefix: Str): Vec<Skill> { from-resources(prefix, {}) },
(prefix: Str, opts: Map): Vec<Skill> {
    clean-prefix trim-trailing-slashes(prefix)
    match-prefix if(is-empty(clean-prefix), "", `${clean-prefix}/`)
    match-len length(match-prefix)
    include-legacy ne(get(opts, "include-legacy-ext"), false)
    on-dup or(get(opts, "on-duplicate"), "error")

    paths ::res/list()
        |> map(%.path)
        |> filter((p) {
            under cond {
                is-empty(match-prefix) => { true }
                => { starts-with(p, match-prefix) }
            }

            cond {
                not(under) => { false }
                => {
                    tail if(is-empty(match-prefix), p, slice(p, match-len, length(p)))
                    base path-basename(tail)
                    is-match or(
                        eq(base, "SKILL.md"),
                        and(include-legacy, ends-with(base, ".skill.md"))
                    )
                    and(is-match, not(has-dot-segment(tail)))
                }
            }
        })
        |> sort()

    loaded reduce(paths, (acc, p) {
        cond {
            is-some(acc.error) => { acc }
            => {
                s from-resource(p, opts)
                cond {
                    is-err(s) => { assoc(acc, "error", err-value(s)) }
                    => {
                        skill ok-value(s)
                        dup in(skill.name, acc.seen)
                        cond {
                            and(dup, eq(on-dup, "first")) => { acc }
                            dup => { assoc(acc, "error", `Duplicate skill name '${skill.name}' found at '${p}'`) }
                            => {
                                {
                                    seen: concat(acc.seen, [skill.name]),
                                    skills: concat(acc.skills, [skill]),
                                    error: null
                                }
                            }
                        }
                    }
                }
            }
        }
    }, {seen: [], skills: [], error: null})

    cond {
        is-some(loaded.error) => { err(loaded.error) }
        => { loaded.skills }
    }
}

resource-resolver
meta {
    doc: """
    Build a `SkillResolver` backed by resource-loaded `SKILL.md` skills
    (either a `prefix: Str` loaded via `from-resources` or a pre-loaded
    `Vec<Skill>`).

    Options (`opts`):
    - `always-on: Vec<Skill>` — skills returned from `list-fn` every turn
      (defaults to `[]` when `searchable` is `true`, else all `skills`).
    - `searchable: Bool` — when `true`, wires `search-fn` so `run-loop`
      exposes `search_skills`.
    - `expose-resources: Bool` — when `false`, omits `list-resources-fn`
      and `read-resource-fn` (default `true`).
    - `resource-filter: Fn` — optional `(skill, rel-path) -> Bool` gate.
    - `max-resource-chars: Int` — per-read character cap (default `250000`).
    """
}
fn
(skills-or-prefix: Str | Vec<Skill>): SkillResolver { resource-resolver(skills-or-prefix, {}) },
(skills-or-prefix: Str | Vec<Skill>, opts: Map): SkillResolver {
    skills cond {
        is-str(skills-or-prefix) => { from-resources(skills-or-prefix, opts) }
        => { skills-or-prefix }
    }

    searchable or(get(opts, "searchable"), false)
    has-always-on is-some(get(opts, "always-on"))
    listed cond {
        has-always-on => { get(opts, "always-on") }
        searchable => { [] }
        => { skills }
    }

    expose-res ne(get(opts, "expose-resources"), false)
    filter-fn get(opts, "resource-filter")
    max-chars get(opts, "max-resource-chars")

    base {
        list-fn: (ctx: Map): Vec<Skill> { listed },
        read-fn: (name: Str): Skill? { find-skill(skills, name) },
        skills: skills
    }

    with-search cond {
        searchable => {
            assoc(base, "search-fn", (query: Str, search-opts: Map): Vec<Skill> {
                search-skills-of(skills, query, or(search-opts, {}))
            })
        }
        => { assoc(base, "search-fn", null) }
    }

    with-resources cond {
        expose-res => {
            with-search
                |> assoc("list-resources-fn", (s: Skill): Vec<Map> {
                    list-skill-resources-of(s, filter-fn)
                })
                |> assoc("read-resource-fn", (s: Skill, rel-path: Str, offset: Int?): Str {
                    read-opts {}
                        |> assoc-some("resource-filter", filter-fn)
                        |> assoc-some("max-resource-chars", max-chars)
                        |> assoc-some("offset", offset)
                    read-skill-resource-of(s, rel-path, read-opts)
                })
        }
        => { with-search }
    }

    SkillResolver(with-resources)
}

// ============================================================================
// Dynamic skill activation helpers (used by ::ai::chat/run-loop)
// ============================================================================

append-unique-tools
meta { no-doc: true }
fn (existing: Vec<::tool/Tool>, additions: Vec<::tool/Tool>): Map {
    existing-names map(existing, %.name)
    reduce(additions, (acc, t) {
        cond {
            in(t.name, acc.names) => { acc }
            => {
                {
                    names: concat(acc.names, [t.name]),
                    tools: concat(acc.tools, [t]),
                    added: concat(acc.added, [t.name])
                }
            }
        }
    }, {names: existing-names, tools: existing, added: []})
}

activate-skill-graph
meta { no-doc: true }
fn (resolver: SkillResolver, queue: Vec<Str>, visited: Vec<Str>, tools: Vec<::tool/Tool>): Map {
    cond {
        is-empty(queue) => { {visited, tools, added: []} }
        => {
            name first(queue)
            rest slice(queue, 1, length(queue))
            cond {
                in(name, visited) => { activate-skill-graph(resolver, rest, visited, tools) }
                => {
                    next-visited concat(visited, [name])
                    s resolver.read-fn(name)
                    cond {
                        is-null(s) => { activate-skill-graph(resolver, rest, next-visited, tools) }
                        => {
                            bundled or(s.tools, [])
                            merged append-unique-tools(tools, bundled)
                            reqs or(s.requires, [])
                            next-queue concat(rest, reqs)
                            tail activate-skill-graph(resolver, next-queue, next-visited, merged.tools)
                            {
                                visited: tail.visited,
                                tools: tail.tools,
                                added: concat(merged.added, tail.added)
                            }
                        }
                    }
                }
            }
        }
    }
}

extract-skill-call-names
meta { no-doc: true }
fn (calls: Vec<Any>): Vec<Str> {
    calls
        |> filter((c) { or(eq(c.name, "read_skill"), eq(c.name, "apply_skill")) })
        |> map((c) { if(is-map(c.input), get(c.input, "name"), null) })
        |> filter((n) { and(is-str(n), not(is-empty(n))) })
}

activate-skills-from-calls
meta {
    no-doc: true,
    doc: """
    Internal: given a round's tool calls, resolve any newly read/applied
    skills (and their transitive `requires`), appending bundled `tools`
    without overriding existing tools. Returns `{tools, active, activations}`.
    """
}
fn (resolver: SkillResolver?, calls: Vec<Any>, current-tools: Vec<::tool/Tool>, active: Vec<Str>): Map {
    cond {
        or(is-null(resolver), is-empty(calls)) => {
            {tools: current-tools, active, activations: []}
        }
        => {
            names extract-skill-call-names(calls)
            reduce(names, (acc, name) {
                cond {
                    in(name, acc.active) => { acc }
                    => {
                        s resolver.read-fn(name)
                        cond {
                            is-null(s) => { acc }
                            => {
                                res activate-skill-graph(resolver, [name], acc.active, acc.tools)
                                act {
                                    skill: s.name,
                                    tools-added: res.added,
                                    requires: or(s.requires, [])
                                }
                                {
                                    tools: res.tools,
                                    active: res.visited,
                                    activations: concat(acc.activations, [act])
                                }
                            }
                        }
                    }
                }
            }, {tools: current-tools, active, activations: []})
        }
    }
}

seed-active-skills
meta {
    no-doc: true,
    doc: """
    Internal: scan prior assistant messages in `messages` for `read_skill`
    or `apply_skill` tool calls and pre-activate their bundled tools so
    resumed `run-loop-messages` turns retain previously activated tools.
    """
}
fn (resolver: SkillResolver?, messages: Vec<Any>, initial-tools: Vec<::tool/Tool>): Map {
    cond {
        is-null(resolver) => { {tools: initial-tools, active: []} }
        => {
            hist-calls reduce(messages, (acc, msg) {
                tcs get(msg, "tool-calls")
                cond {
                    and(eq(get(msg, "role"), "assistant"), is-vec(tcs)) => { concat(acc, tcs) }
                    => { acc }
                }
            }, [])
            res activate-skills-from-calls(resolver, hist-calls, initial-tools, [])
            {tools: res.tools, active: res.active}
        }
    }
}
