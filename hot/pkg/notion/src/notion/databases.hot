::notion::databases ns

::api ::notion::api

get-database
meta {
    doc: """
    GET /databases/{id} - The database schema: property names, types, and
    options.

    **Example**

    ```hot
    db ::notion::databases/get-database("d9824bdc-8445-4327-be8b-5b47500af6ce")
    keys(db.properties)
    ```
    """
}
fn
(database-id: Str): Map {
  get-database(database-id, {})
},
(database-id: Str, opts: Map): Map {
  ::api/json("GET", `/databases/${database-id}`, {}, "", opts)
}

query-database
meta {
    doc: """
    POST /databases/{id}/query - Query rows. `options` supports `filter`
    (https://developers.notion.com/reference/post-database-query-filter),
    `sorts`, `page_size`, `start_cursor`. Returns
    `{results, has_more, next_cursor}`.

    **Example**

    ```hot
    open ::notion::databases/query-database("d9824bdc-8445-4327-be8b-5b47500af6ce", {
      filter: {property: "Status", status: {does_not_equal: "Done"}},
      sorts: [{property: "Priority", direction: "ascending"}]
    })
    length(open.results)
    ```
    """
}
fn
(database-id: Str): Map {
  query-database(database-id, {})
},
(database-id: Str, options: Map): Map {
  query-database(database-id, options, {})
},
(database-id: Str, options: Map, opts: Map): Map {
  ::api/json("POST", `/databases/${database-id}/query`, {}, options, opts)
}

create-database
meta {
    doc: """
    POST /databases - Create a database under a parent page. `properties` is
    the schema, e.g. `{Name: {title: {}}, Status: {select: {options: [{name:
    "Todo"}]}}}`.

    **Example**

    ```hot
    db ::notion::databases/create-database("59833787-2cf9-4fdf-8782-e53db20768a5", "Roadmap", {
      Name: {title: {}},
      Status: {select: {options: [{name: "Todo"}, {name: "Done"}]}}
    })
    db.id
    ```
    """
}
fn
(parent-page-id: Str, title: Str, properties: Map): Map {
  create-database(parent-page-id, title, properties, {})
},
(parent-page-id: Str, title: Str, properties: Map, opts: Map): Map {
  ::api/json("POST", "/databases", {}, {
    parent: {type: "page_id", page_id: parent-page-id},
    title: ::notion/rich-text(title),
    properties: properties
  }, opts)
}
