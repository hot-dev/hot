update-call-body
meta {
    doc: """The form parameters `update-call` sends (the request without its path `sid`). Exposed for testing."""
}
fn (request: UpdateCallRequest): Map {
  filter-vals(delete(untype(request), "sid"), is-some)
}

update-call
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
POST /Accounts/{AccountSid}/Calls/{Sid}.json - Modify a live call. Set `Status: "completed"` to hang up (or `"canceled"` for a queued/ringing call), or provide a new `Url`/`Twiml` to redirect it.

**Example**

```hot
::calls ::twilio::calls

::calls/update-call(::calls/UpdateCallRequest({sid: "CA123", Status: "completed"}))
```
"""
}
fn
(request: UpdateCallRequest): Call {
  update-call(request, {})
},
(request: UpdateCallRequest, opts: Map): Call {
  resolve(opts) |> if-ok((client) { update-call(client, request) })
},
(client: Client, request: UpdateCallRequest): Call {
  response api-request(client, "POST", `${account-url(client)}/Calls/${::uri/encode(request.sid)}.json`, {}, update-call-body(request))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { Call(response.body) }
    => { err(HttpError(response)) }
  }
}

