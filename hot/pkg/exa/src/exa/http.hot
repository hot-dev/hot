::exa::http ns
meta {
    doc: """HTTP plumbing for Exa: one `HttpError` shape with a readable message, and `send`."""
}

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError
meta {
    doc: """A non-2xx Exa response. `message` is readable text such as `Exa API error 400: Invalid request`; `body` keeps the raw response."""
}
type {
    status: Int,
    message: Str,
    headers: Map,
    body: Any
}

error-detail
meta {
    doc: """
    Exa's error text from a response body, or null. Understands `{error}`,
    and plain `{message}` or string bodies. Exposed for testing.

    **Example**

    ```hot
    ::exa::http/error-detail({error: "Invalid request"})  // "Invalid request"
    ::exa::http/error-detail("Bad gateway")  // "Bad gateway"
    ::exa::http/error-detail([])  // null
    ```
    """
}
fn (body: Any): Any {
  cond {
    is-str(body) => { text-or-null(body) }
    not(is-map(body)) => { null }
    => { or(text-or-null(get(body, "error")), text-or-null(get(body, "message"))) }
  }
}

text-or-null
meta {no-doc: true}
fn (value: Any): Any {
  if(and(is-str(value), not(is-blank(value))), value, null)
}

error-message
meta {
    doc: """
    `Exa API error <status>: <detail>`, or without the detail when the body
    has none. Exposed for testing.

    **Example**

    ```hot
    ::exa::http/error-message(400, {error: "Invalid request"})  // "Exa API error 400: Invalid request"
    ::exa::http/error-message(500, null)  // "Exa API error 500"
    ```
    """
}
fn (status: Int, body: Any): Str {
  detail error-detail(body)
  if(is-some(detail), `Exa API error ${status}: ${detail}`, `Exa API error ${status}`)
}

http-error
meta {
    doc: """
    Build the `HttpError` for a non-2xx response. Exposed for testing.

    **Example**

    ```hot
    response {status: 401, headers: {}, body: {message: "Bad key"}}
    e ::exa::http/http-error(response)
    e.status  // 401
    e.message  // "Exa API error 401: Bad key"
    ```
    """
}
fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    message: error-message(response.status, response.body),
    headers: or(response.headers, {}),
    body: response.body
  })
}

send
meta {
    doc: """
    Send `request` and unwrap: the decoded JSON body on 2xx, an Err carrying
    `HttpError` otherwise, or the transport Err.

    **Example**

    ```hot
    key ::hot::ctx/get("exa.api.key")
    body ::exa::http/send(::exa/build-request("/search", {query: "hot language", numResults: 3}, key))
    length(body.results)
    ```
    """
}
fn (request: HttpRequest): Any {
  response ::hot::http/request(request)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body }
    => { err(http-error(response)) }
  }
}
