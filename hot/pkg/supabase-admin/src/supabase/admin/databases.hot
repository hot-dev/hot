list-read-replicas
meta {
    doc: """
    List read replicas for a project.

    **Example**

    ```hot
    ::databases ::supabase::admin::databases

    replicas ::databases/list-read-replicas("my-project-ref")
    length(replicas)
    ```
    """
}
fn
(project-ref: Str): Vec<Map> {
  list-read-replicas(project-ref, {})
},
(project-ref: Str, opts: Map): Vec<Map> {
  ::api/request("GET", `/projects/${project-ref}/read-replicas`, {}, {}, opts)
}

get-readonly-mode
meta {
    doc: """
    Check if the project database is in read-only mode.

    **Example**

    ```hot
    ::databases ::supabase::admin::databases

    mode ::databases/get-readonly-mode("my-project-ref")
    mode.enabled
    ```
    """
}
fn
(project-ref: Str): Map {
  get-readonly-mode(project-ref, {})
},
(project-ref: Str, opts: Map): Map {
  ::api/request("GET", `/projects/${project-ref}/readonly`, {}, {}, opts)
}

