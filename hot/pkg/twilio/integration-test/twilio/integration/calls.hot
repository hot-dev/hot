::twilio::integration::calls ns
meta ["test"]

::ctx ::twilio::integration::ctx

test-list-calls
meta ["test"]
fn () {
  cond {
    not(::ctx/configured()) => { ::ctx/skip(::ctx/UNCONFIGURED) }
    => {
      response ::twilio::calls/list-calls(::twilio::calls/ListCallsRequest({
        PageSize: 5
      }))

      assert(is-vec(response.calls), "list-calls should return calls array")
    }
  }
}
