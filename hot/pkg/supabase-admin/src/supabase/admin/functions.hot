::supabase::admin::functions ns

::api ::supabase::admin::api

EdgeFunction type {
  id: Str?,
  slug: Str,
  name: Str?,
  status: Str?,
  verify_jwt: Bool?,
  created_at: Str?,
  updated_at: Str?
}

// ============================================================================
// Edge Functions Management
// ============================================================================

list-functions
meta {
    doc: """
List all edge functions for a project.

**Example**

```hot
::functions ::supabase::admin::functions

fns ::functions/list-functions("my-project-ref")
// => [{id: "...", slug: "hello-world", name: "hello-world", status: "ACTIVE", ...}, ...]
```
"""
}
fn
(project-ref: Str): Vec<EdgeFunction> {
  list-functions(project-ref, {})
},
(project-ref: Str, opts: Map): Vec<EdgeFunction> {
  ::api/request("GET", `/projects/${project-ref}/functions`, {}, {}, opts)
}

get-function
meta {
    doc: """
    Get details for a specific edge function by slug.

    **Example**

    ```hot
    ::functions ::supabase::admin::functions

    edge ::functions/get-function("my-project-ref", "hello-world")
    edge.status

    // Per-call credentials
    other ::functions/get-function("my-project-ref", "hello-world", {access-token: ::hot::ctx/get("tenant_b.supabase.token")})
    ```
    """
}
fn
(project-ref: Str, function-slug: Str): EdgeFunction {
  get-function(project-ref, function-slug, {})
},
(project-ref: Str, function-slug: Str, opts: Map): EdgeFunction {
  ::api/request("GET", `/projects/${project-ref}/functions/${function-slug}`, {}, {}, opts)
}

CreateFunctionRequest type {
  project_ref: Str,
  slug: Str,
  name: Str,
  body: Str,
  verify_jwt: Bool?,
  import_map: Bool?,
  entrypoint_path: Str?,
  import_map_path: Str?
}

create-function
meta {
    doc: """
Create and deploy a new edge function. `body` is the function source code. `slug` is the URL path segment.

**Example**

```hot
::functions ::supabase::admin::functions

fn-result ::functions/create-function(::functions/CreateFunctionRequest({
  project_ref: "my-project-ref",
  slug: "hello-world",
  name: "hello-world",
  body: "Deno.serve(() => new Response('Hello from Hot!'))",
  verify_jwt: true
}))
```
"""
}
fn
(request: CreateFunctionRequest): EdgeFunction {
  create-function(request, {})
},
(request: CreateFunctionRequest, opts: Map): EdgeFunction {
  body {
    slug: request.slug,
    name: request.name,
    body: request.body
  }
    |> assoc-some("verify_jwt", request.verify_jwt)
    |> assoc-some("import_map", request.import_map)
    |> assoc-some("entrypoint_path", request.entrypoint_path)
    |> assoc-some("import_map_path", request.import_map_path)

  ::api/request("POST", `/projects/${request.project_ref}/functions`, {}, body, opts)
}

UpdateFunctionRequest type {
  project_ref: Str,
  function_slug: Str,
  body: Str?,
  name: Str?,
  verify_jwt: Bool?,
  import_map: Bool?,
  entrypoint_path: Str?,
  import_map_path: Str?
}

update-function
meta {
    doc: """
    Update an existing edge function. Only provided fields are updated.

    **Example**

    ```hot
    ::functions ::supabase::admin::functions

    ::functions/update-function(::functions/UpdateFunctionRequest({
      project_ref: "my-project-ref",
      function_slug: "hello-world",
      verify_jwt: false
    }))
    ```
    """
}
fn
(request: UpdateFunctionRequest): Map {
  update-function(request, {})
},
(request: UpdateFunctionRequest, opts: Map): Map {
  body {}
    |> assoc-some("body", request.body)
    |> assoc-some("name", request.name)
    |> assoc-some("verify_jwt", request.verify_jwt)
    |> assoc-some("import_map", request.import_map)
    |> assoc-some("entrypoint_path", request.entrypoint_path)
    |> assoc-some("import_map_path", request.import_map_path)

  ::api/request("PATCH", `/projects/${request.project_ref}/functions/${request.function_slug}`, {}, body, opts)
}

deploy-function
meta {
    doc: """
    Deploy a function bundle through the Management API deploy endpoint.

    **Example**

    ```hot
    ::functions ::supabase::admin::functions

    // The body is sent as JSON.
    bundle {slug: "hello-world", name: "hello-world", entrypoint_path: "index.ts"}
    deployed ::functions/deploy-function("my-project-ref", bundle)
    deployed.version
    ```
    """
}
fn
(project-ref: Str, body: Any): Map {
  deploy-function(project-ref, body, {})
},
(project-ref: Str, body: Any, opts: Map): Map {
  ::api/request("POST", `/projects/${project-ref}/functions/deploy`, {}, body, opts)
}

bulk-update-functions
meta {
    doc: """
    Bulk update edge functions for a project.

    **Example**

    ```hot
    ::functions ::supabase::admin::functions

    ::functions/bulk-update-functions("my-project-ref", [
      {id: "fn-id-1", slug: "hello-world", name: "hello-world", status: "ACTIVE", version: 2}
    ])
    ```
    """
}
fn
(project-ref: Str, body: Any): Map {
  bulk-update-functions(project-ref, body, {})
},
(project-ref: Str, body: Any, opts: Map): Map {
  ::api/request("PUT", `/projects/${project-ref}/functions`, {}, body, opts)
}

delete-function
meta {
    doc: """
    Delete an edge function by slug.

    **Example**

    ```hot
    ::functions ::supabase::admin::functions

    ::functions/delete-function("my-project-ref", "hello-world")
    ```
    """
}
fn
(project-ref: Str, function-slug: Str): Map {
  delete-function(project-ref, function-slug, {})
},
(project-ref: Str, function-slug: Str, opts: Map): Map {
  ::api/request("DELETE", `/projects/${project-ref}/functions/${function-slug}`, {}, {}, opts)
}

get-function-body
meta {
    doc: """
    Get the source code of an edge function.

    **Example**

    ```hot
    ::functions ::supabase::admin::functions

    source ::functions/get-function-body("my-project-ref", "hello-world")
    ```
    """
}
fn
(project-ref: Str, function-slug: Str): Any {
  get-function-body(project-ref, function-slug, {})
},
(project-ref: Str, function-slug: Str, opts: Map): Any {
  ::api/request("GET", `/projects/${project-ref}/functions/${function-slug}/body`, {}, {}, opts)
}
