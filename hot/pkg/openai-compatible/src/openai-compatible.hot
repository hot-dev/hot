::openai-compatible ns
meta {
    doc: """
    Presets for OpenAI-compatible APIs, built on `hot.dev/openai`.

    Each preset knows a provider's base URL, routing prefix, ctx key name
    and request quirks. The ctx-reading functions (`ollama()`, `groq()`,
    `openrouter()`, ...) return an `::openai::compatible/CompatibleProvider`;
    `provider(...)` turns that into an `::ai::chat/ProviderRegistration`
    for `::ai::chat/run-loop`, using OpenAI's chat-tools adapter.

    **Example**

    ```hot
    ::oc ::openai-compatible

    registry ::ai::chat/with-providers([
        ::oc/provider(::oc/ollama()),
        ::oc/provider(::oc/groq())
    ])
    opts ::ai::chat/ChatOptions({model: "groq/llama-3.3-70b-versatile", providers: registry})
    ::ai::chat/run-loop(opts, "Hello!")
    ```
    """
}

::ctx    ::hot::ctx
::compat ::openai::compatible
::api    ::openai::api

CompatibleProvider ::compat/CompatibleProvider

DEFAULT_MAX_TOKENS 4096

// ============================================================================
// Presets
// ============================================================================

Preset
meta {
    doc: """
    Static description of an OpenAI-compatible provider.

    - `name`: display name.
    - `base-url`: default OpenAI-compatible base URL.
    - `model-prefix`: routing prefix for `::ai::chat` registries.
    - `key-ctx`: ctx variable the named preset function reads the key from
      (null for keyless servers).
    - `key-env`: the provider's conventional env var, for your ctx file.
    - `max-tokens-param`: body field for the output ceiling
      (`max_tokens` or `max_completion_tokens`).
    - `stream-usage`: whether to send `stream_options.include_usage`.
    - `capabilities`: advertised on the registration.
    - `docs-url`: the provider's OpenAI-compatibility docs.
    """
}
type {
    name: Str,
    base-url: Str,
    model-prefix: Str,
    key-ctx: Str?,
    key-env: Str?,
    max-tokens-param: Str,
    stream-usage: Bool,
    capabilities: Vec<Str>,
    docs-url: Str
}

OLLAMA
meta {
    doc: "Ollama (local). Keyless; the key is only for Ollama's hosted API or an authenticating proxy."
}

Preset({
    name: "Ollama",
    base-url: "http://localhost:11434/v1",
    model-prefix: "ollama/",
    key-ctx: "ollama.api.key",
    key-env: "OLLAMA_API_KEY",
    max-tokens-param: "max_tokens",
    stream-usage: true,
    capabilities: ["tools", "streaming", "vision", "json-mode"],
    docs-url: "https://docs.ollama.com/api/openai-compatibility"
})

VLLM
meta {
    doc: "vLLM's OpenAI-compatible server (local or self-hosted). The key is only needed when the server runs with `--api-key`."
}

Preset({
    name: "vLLM",
    base-url: "http://localhost:8000/v1",
    model-prefix: "vllm/",
    key-ctx: "vllm.api.key",
    key-env: "VLLM_API_KEY",
    max-tokens-param: "max_tokens",
    stream-usage: true,
    capabilities: ["tools", "streaming", "json-mode"],
    docs-url: "https://docs.vllm.ai/en/latest/serving/openai_compatible_server.html"
})

LM_STUDIO
meta {doc: "LM Studio's local server. Keyless."}
Preset({
    name: "LM Studio",
    base-url: "http://localhost:1234/v1",
    model-prefix: "lmstudio/",
    key-ctx: null,
    key-env: null,
    max-tokens-param: "max_tokens",
    stream-usage: false,
    capabilities: ["tools", "streaming", "json-mode"],
    docs-url: "https://lmstudio.ai/docs/app/api/endpoints/openai"
})

GROQ
meta {
    doc: "Groq. Rejects `logprobs`, `logit_bias`, `top_logprobs`, `messages[].name` and `n` other than 1."
}

Preset({
    name: "Groq",
    base-url: "https://api.groq.com/openai/v1",
    model-prefix: "groq/",
    key-ctx: "groq.api.key",
    key-env: "GROQ_API_KEY",
    max-tokens-param: "max_completion_tokens",
    stream-usage: true,
    capabilities: ["tools", "streaming", "json-mode"],
    docs-url: "https://console.groq.com/docs/openai"
})

OPENROUTER
meta {
    doc: "OpenRouter: one key for hundreds of models. Model ids keep their vendor prefix (`anthropic/claude-sonnet-4.5`), so route them as `openrouter/anthropic/claude-sonnet-4.5`."
}

Preset({
    name: "OpenRouter",
    base-url: "https://openrouter.ai/api/v1",
    model-prefix: "openrouter/",
    key-ctx: "openrouter.api.key",
    key-env: "OPENROUTER_API_KEY",
    max-tokens-param: "max_tokens",
    stream-usage: true,
    capabilities: ["tools", "streaming", "vision", "json-mode"],
    docs-url: "https://openrouter.ai/docs/api/reference/overview"
})

DEEPSEEK
