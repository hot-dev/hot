::slack::admin::conversations ns
meta {
    doc: """
    `admin.conversations.*`: create, archive, delete, rename, invite,
    search and look up channels across an Enterprise organization; bulk
    archive/delete/move; sharing between workspaces; posting preferences;
    custom retention; IDP-group access restrictions; and EKM channel info.

    Scopes: `admin.conversations:read` for reads, `admin.conversations:write`
    for changes (plus Channel Management rights for the installing admin).

    **Example**

    ```hot
    ::conversations ::slack::admin::conversations

    hits ::conversations/search(::conversations/SearchRequest({query: "incident", limit: 20}))
    ::conversations/archive(::conversations/ArchiveRequest({channel_id: first(hits.conversations).id}))
    ```
    """
}

::api ::slack::admin::api

ArchiveRequest type {
  channel_id: Str
}

archive
meta {
    doc: """
    admin.conversations.archive - Archive a public or private channel.

    Scope: `admin.conversations:write`. Returns Slack's response body; `ok: false` comes back as an `Err(SlackError)`.
    """
}
fn (request: ArchiveRequest): Map {
  ::api/call("admin.conversations.archive", request)
}

