::shopify::webhooks ns
meta {
    doc: """
    Shopify webhooks: verify deliveries (base64 HMAC-SHA256 of the raw
    body in `X-Shopify-Hmac-Sha256`), read the topic, shop and
    delivery-id headers for routing and dedupe, and manage webhook
    subscriptions over the Admin API. See
    https://shopify.dev/docs/apps/build/webhooks/subscribe/https.
    """
}

::ctx ::hot::ctx
::hmac ::hot::hmac
::api ::shopify::api

// ---------------------------------------------------------------------------
// Verification
// ---------------------------------------------------------------------------

verify-request
meta {
    ctx: {"shopify.webhook.secret": {required: false}},
    doc: """
    Verify a Shopify webhook: base64 HMAC-SHA256 of the raw body in
    `X-Shopify-Hmac-Sha256`, keyed by your app's client secret (or the
    shop's webhook signing secret for admin-created webhooks). Uses the
    `shopify.webhook.secret` context variable by default (failing when it
    is unset), or an explicit secret; an empty explicit secret never
    verifies. Shopify signs no timestamp, so dedupe on `webhook-id`.

    **Example**

    ```hot
    shopify-webhook
    meta {webhook: {service: "shopify", path: "/shopify/webhook"}}
    fn (request) {
      if(not(::shopify::webhooks/verify-request(request)),
        ::hot::http/HttpResponse({status: 401, body: "invalid signature"}),
        ::hot::http/HttpResponse({status: 200, body: ::shopify::webhooks/topic(request)}))
    }
    ```
    """
}
fn
(request: Map): Bool {
  secret or(::ctx/get("shopify.webhook.secret"), "")
  if(is-empty(secret),
    fail("shopify.webhook.secret is not set. Add it in Context Variables to verify webhook requests.")
  )
  verify-request(request, secret)
},
(request: Map, secret: Str): Bool {
  signature header(request, "x-shopify-hmac-sha256")
  cond {
    // An empty key would make every signature forgeable: fail closed.
    is-empty(secret) => { false }
    is-empty(signature) => { false }
    => {
      raw-body ::hot::http/raw-body(request)
      ::hmac/hmac-verify-base64(::ctx/mark-secret(secret), raw-body, signature, "sha256")
    }
  }
}

// ---------------------------------------------------------------------------
// Delivery headers
// ---------------------------------------------------------------------------

header
meta {
    doc: """
    A request header by name, case-insensitively (inbound header keys are
    lowercase; this also accepts maps with other casing). Returns `""` when
    absent.

    **Example**

    ```hot
    ::shopify::webhooks/header({headers: {"X-Shopify-Topic": "orders/create"}}, "x-shopify-topic")  // "orders/create"
    ::shopify::webhooks/header({headers: {}}, "x-shopify-topic")  // ""
    ```
    """
}
fn (request: Map, name: Str): Str {
  headers or(get(request, "headers"), {})
  wanted lowercase(name)
  direct get(headers, wanted)
  cond {
    is-some(direct) => { Str(direct) }
    => {
      match-key find-first(keys(headers), (k) { eq(lowercase(Str(k)), wanted) })
      if(is-null(match-key), "", Str(get(headers, match-key)))
    }
  }
}

topic
meta {
    doc: """
    The delivery's topic from `X-Shopify-Topic`, e.g. `"orders/create"`.

    **Example**

    ```hot
    ::shopify::webhooks/topic({headers: {"x-shopify-topic": "orders/create"}})  // "orders/create"
    ```
    """
}
fn (request: Map): Str {
  header(request, "x-shopify-topic")
}

shop-domain
meta {
    doc: """
    The sending shop from `X-Shopify-Shop-Domain`, e.g.
    `"acme.myshopify.com"`.

    **Example**

    ```hot
    ::shopify::webhooks/shop-domain({headers: {"x-shopify-shop-domain": "acme.myshopify.com"}})  // "acme.myshopify.com"
    ```
    """
}
fn (request: Map): Str {
  header(request, "x-shopify-shop-domain")
}

webhook-id
meta {
    doc: """
    The per-delivery id from `X-Shopify-Webhook-Id`. Shopify retries failed
    deliveries with the same id, so record it to skip duplicates.

    **Example**

    ```hot
    ::shopify::webhooks/webhook-id({headers: {"x-shopify-webhook-id": "b54557e4"}})  // "b54557e4"
    ```
    """
}
fn (request: Map): Str {
  header(request, "x-shopify-webhook-id")
}

event-id
meta {
    doc: """
    `X-Shopify-Event-Id`: shared by deliveries that came from the same
    merchant action across several subscriptions. For correlation, not
    dedupe.

    **Example**

    ```hot
    ::shopify::webhooks/event-id({headers: {"x-shopify-event-id": "98880550"}})  // "98880550"
    ```
    """
}
fn (request: Map): Str {
  header(request, "x-shopify-event-id")
}

delivery
meta {
    doc: """
    All the routing headers at once: `{topic, shop-domain, webhook-id,
    event-id, api-version, triggered-at, name}` (`""` for absent ones).

    **Example**

    ```hot
    info ::shopify::webhooks/delivery({headers: {"x-shopify-topic": "orders/create", "x-shopify-webhook-id": "b54557e4"}})
    info.topic  // "orders/create"
    info.webhook-id  // "b54557e4"
    info.event-id  // ""
    ```
    """
}
fn (request: Map): Map {
  {
    topic: topic(request),
    shop-domain: shop-domain(request),
    webhook-id: webhook-id(request),
    event-id: event-id(request),
    api-version: header(request, "x-shopify-api-version"),
    triggered-at: header(request, "x-shopify-triggered-at"),
    name: header(request, "x-shopify-name")
  }
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

SUBSCRIPTION_FIELDS "id topic uri filter includeFields metafieldNamespaces format name createdAt updatedAt"

build-subscription-input
meta {
    doc: """
    `WebhookSubscriptionInput` from a delivery `uri` (HTTPS URL, or a
    Pub/Sub / EventBridge URI) and options `filter`, `includeFields`,
    `metafieldNamespaces`, `format` (`JSON` or `XML`), `name`. Unset options
    are omitted. Exposed for testing.

    **Example**

    ```hot
    ::shopify::webhooks/build-subscription-input("https://example.com/shopify/webhook", {format: "JSON", name: null})  // {uri: "https://example.com/shopify/webhook", format: "JSON"}
    ```
    """
}
fn (uri: Str, options: Map): Map {
  filter-vals({
    uri: uri,
    filter: get(options, "filter"),
    includeFields: get(options, "includeFields"),
    metafieldNamespaces: get(options, "metafieldNamespaces"),
    format: get(options, "format"),
    name: get(options, "name")
  }, is-some)
}

create-subscription
meta {
    doc: """
    Subscribe the app to a topic (`webhookSubscriptionCreate`). `topic`
    is a `WebhookSubscriptionTopic` enum value such as `ORDERS_CREATE`
    or `PRODUCTS_UPDATE`. Returns the subscription.

    **Example**

    ```hot
    ::shopify::webhooks/create-subscription("ORDERS_CREATE", "https://example.com/shopify/webhook", {
      includeFields: ["id", "name", "total_price"]
    })
    ```
    """
}
fn
(topic: Str, uri: Str): Map {
  create-subscription(topic, uri, {})
},
(topic: Str, uri: Str, options: Map): Map {
  create-subscription(topic, uri, options, {})
},
(topic: Str, uri: Str, options: Map, opts: Map): Map {
  mutation ```
  mutation WebhookSubscriptionCreate($topic: WebhookSubscriptionTopic!, $webhookSubscription: WebhookSubscriptionInput!) {
    webhookSubscriptionCreate(topic: $topic, webhookSubscription: $webhookSubscription) {
      webhookSubscription { ${SUBSCRIPTION_FIELDS} }
      userErrors { field message }
    }
  }
  ```
  payload ::api/mutate(mutation, {
    topic: topic,
    webhookSubscription: build-subscription-input(uri, options)
  }, "webhookSubscriptionCreate", opts)
  if-ok(payload, %(%.webhookSubscription))
}

list-subscriptions
meta {
    doc: """
    One page of the app's webhook subscriptions. Options: `first`, `after`,
    `topics` (Vec of topic enum values), `uri`. Returns `{nodes, pageInfo}`.

    **Example**

    ```hot
    page ::shopify::webhooks/list-subscriptions({topics: ["ORDERS_CREATE"]})
    map(page.nodes, %.uri)
    ```
    """
}
fn
(): Map {
  list-subscriptions({})
},
(options: Map): Map {
  list-subscriptions(options, {})
},
(options: Map, opts: Map): Map {
  query ```
  query WebhookSubscriptions($first: Int!, $after: String, $topics: [WebhookSubscriptionTopic!], $uri: String) {
    webhookSubscriptions(first: $first, after: $after, topics: $topics, uri: $uri) {
      nodes { ${SUBSCRIPTION_FIELDS} }
      pageInfo { hasNextPage endCursor }
    }
  }
  ```
  vars ::api/connection-variables(options)
  data ::api/graphql(query, filter-vals({...vars, topics: get(options, "topics"), uri: get(options, "uri")}, is-some), opts)
  if-ok(data, %(%.webhookSubscriptions))
}

delete-subscription
meta {
    doc: """
    Delete a webhook subscription by id (`webhookSubscriptionDelete`).
    Returns the deleted id.

    **Example**

    ```hot
    ::shopify::webhooks/delete-subscription("gid://shopify/WebhookSubscription/3")
    ```
    """
}
fn
(id: Str): Str {
  delete-subscription(id, {})
},
(id: Str, opts: Map): Str {
  mutation """
  mutation WebhookSubscriptionDelete($id: ID!) {
    webhookSubscriptionDelete(id: $id) {
      deletedWebhookSubscriptionId
      userErrors { field message }
    }
  }
  """
  payload ::api/mutate(mutation, {id: id}, "webhookSubscriptionDelete", opts)
  if-ok(payload, %(%.deletedWebhookSubscriptionId))
}
