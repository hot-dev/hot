::cloudflare::cache ns
meta {
    doc: """
    Cloudflare cache purge (POST /zones/{zone_id}/purge_cache). Send one
    kind of target per call. Success means Cloudflare accepted the purge;
    per-request item limits and rate limits depend on the plan (see
    https://developers.cloudflare.com/cache/how-to/purge-cache/). The
    token needs the Zone → Cache Purge permission.
    """,
    ctx: {"cloudflare.token": {required: true}}
}

::api ::cloudflare::api

purge
meta {
    doc: """
    POST /zones/{zone_id}/purge_cache with an explicit body: one of
    `{files}`, `{tags}`, `{hosts}`, `{prefixes}`, or `{purge_everything: true}`.
    Returns `{id}`.
    """
}
fn (zone-id: Str, body: Map): Map {
  ::api/json("POST", `/zones/${::api/seg(zone-id)}/purge_cache`, body)
}

purge-urls
meta {
    doc: """
    Purge specific URLs. Each entry is a URL string, or
    `{url, headers}` when the cache key varies on request headers
    (`CF-Device-Type`, `CF-IPCountry`, `Accept-Language`, `Origin`).

    **Example**

    ```hot
    ::cloudflare::cache/purge-urls(zone-id, ["https://example.com/", "https://example.com/pricing"])
    ```
    """
}
fn (zone-id: Str, urls: Vec): Map {
  purge(zone-id, {files: urls})
}

purge-tags
meta {
    doc: """Purge everything whose `Cache-Tag` response header carries any of `tags`."""
}
fn (zone-id: Str, tags: Vec<Str>): Map {
  purge(zone-id, {tags: tags})
}

purge-hosts
meta {
    doc: """Purge everything cached for the given hostnames (e.g. `["www.example.com"]`)."""
}
fn (zone-id: Str, hosts: Vec<Str>): Map {
  purge(zone-id, {hosts: hosts})
}

purge-prefixes
meta {
    doc: """Purge by URL prefix: hostname plus path, no scheme, query, or fragment (e.g. `["www.example.com/blog/"]`)."""
}
fn (zone-id: Str, prefixes: Vec<Str>): Map {
  purge(zone-id, {prefixes: prefixes})
}

purge-everything
meta {
    doc: """Purge the zone's entire cache. Expect a burst of origin traffic afterwards."""
}
fn (zone-id: Str): Map {
  purge(zone-id, {purge_everything: true})
}
