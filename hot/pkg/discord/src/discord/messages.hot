// ============================================================================
// Pins (current /channels/{id}/messages/pins endpoints; the older
// /channels/{id}/pins routes are deprecated)
// ============================================================================

GetChannelPinsRequest type {
  channel_id: Str,
  before: Str?,
  limit: Int?
}

get-channel-pins
meta {
    doc: """
    GET /channels/{channel_id}/messages/pins - Pinned messages, newest pin
    first. Returns `{items: [{pinned_at, message}], has_more}`. `limit`
    is 1-50 (default 50); page with `before` set to the last item's
    `pinned_at` timestamp, or use `get-all-pins`.

    **Example**

    ```hot
    ::messages ::discord::messages

    pins ::messages/get-channel-pins(::messages/GetChannelPinsRequest({
      channel_id: "1100000000000000000"
    }))
    map(pins.items, (p) { p.message.content })
    ```
    """
}
fn (request: GetChannelPinsRequest): Map {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/messages/pins`, {
    query: {before: request.before, limit: request.limit}
  })
}

get-all-pins-loop fn (channel-id: Str, max-items: Int, before: Str?, acc: Vec): Vec<Map> {
  page get-channel-pins(GetChannelPinsRequest({channel_id: channel-id, before: before, limit: 50}))
  all concat(acc, page.items)
  cond {
    or(not(page.has_more), is-empty(page.items)) => { slice(all, 0, min(length(all), max-items)) }
    gte(length(all), max-items) => { slice(all, 0, max-items) }
    => { get-all-pins-loop(channel-id, max-items, last(page.items).pinned_at, all) }
  }
}

get-all-pins
meta {
    doc: """Every pin in a channel (up to `max-items`, default 1000) as `[{pinned_at, message}]`, following `has_more`."""
}
fn
(channel-id: Str): Vec<Map> {
  get-all-pins-loop(channel-id, 1000, null, [])
},
(channel-id: Str, max-items: Int): Vec<Map> {
  get-all-pins-loop(channel-id, max-items, null, [])
}

