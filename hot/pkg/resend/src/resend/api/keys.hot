::resend::api::keys ns

api-request ::resend::api/request
HttpError ::resend::api/HttpError
is-ok-response ::hot::http/is-ok-response

ApiKey type {
    id: Str?,
    name: Str?,
    created_at: Str?
}

CreateApiKeyRequest type {
    name: Str,
    permission: "full_access" | "sending_access"?,
    domain_id: Str?
}

ListApiKeysResponse type {
    data: Vec<ApiKey>?
}

CreateApiKeyResponse type {
    id: Str?,
    token: Str?
}

// No parameters required for this GET request
GETApiKeysRequest type Map

GETApiKeysResponse type {
    data: Vec<ApiKey>?
}


retrieve-list-api-keys
meta {
    doc: """
    Retrieve all API keys in your Resend account.

    **Example**

    ```hot
    keys ::resend::api::keys/retrieve-list-api-keys(::resend::api::keys/GETApiKeysRequest({}))
    keys.data // => [{id: "...", name: "Production Key", created_at: "..."}]
    ```
    """
}
fn
(request: GETApiKeysRequest): GETApiKeysResponse {
  retrieve-list-api-keys(request, {})
},
(request: GETApiKeysRequest, opts: Map): GETApiKeysResponse {
  response api-request("GET", `${::resend/BASE_URL}/api-keys`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { GETApiKeysResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

POSTApiKeysRequest type {
    name: Str,
    permission: "full_access" | "sending_access"?,
    domain_id: Str?
}

POSTApiKeysResponse type {
    id: Str?,
    token: Str?
}


create-new-api-key
meta {
    doc: """
    Create a new API key with specified name, permission level, and optional
    domain restriction. The new key is masked in the run's call records.

    **Example**

    ```hot
    created ::resend::api::keys/create-new-api-key(::resend::api::keys/POSTApiKeysRequest({
        name: "Production",
        permission: "sending_access"
    }))
    created.id
    ```
    """
}
fn
(request: POSTApiKeysRequest): POSTApiKeysResponse {
  create-new-api-key(request, {})
},
(request: POSTApiKeysRequest, opts: Map): POSTApiKeysResponse {
  response api-request("POST", `${::resend/BASE_URL}/api-keys`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => {
      ::hot::ctx/mark-secret(response.body.token)
      POSTApiKeysResponse(response.body)
    }
    => { err(HttpError(response)) }
  }
}

DELETEApiKeysApiKeyIdRequest type {
  api-key-id: Str
}

// Empty response from successful API key deletion
DELETEApiKeysApiKeyIdResponse type Map


remove-existing-api-key
meta {
    doc: """
    Permanently delete an API key. This cannot be undone.

    **Example**

    ```hot
    ::resend::api::keys/remove-existing-api-key(::resend::api::keys/DELETEApiKeysApiKeyIdRequest({api-key-id: "b6d24b8e-af0b-4c3c-be0c-359bbd97381e"}))
    ```
    """
}
fn
(request: DELETEApiKeysApiKeyIdRequest): DELETEApiKeysApiKeyIdResponse {
  remove-existing-api-key(request, {})
},
(request: DELETEApiKeysApiKeyIdRequest, opts: Map): DELETEApiKeysApiKeyIdResponse {
  response api-request("DELETE", `${::resend/BASE_URL}/api-keys/${request.api-key-id}`, {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ok(response.body) }
    => { err(HttpError(response)) }
  }
}
