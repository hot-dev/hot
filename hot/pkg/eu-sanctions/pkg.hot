::hot::pkg ns

hot.pkg.eu-sanctions {
  name: "hot.dev/eu-sanctions",
  version: "0.1.0",
  hot-min-version: "3.0.2",
  description: "The EU Consolidated Financial Sanctions List for hot.dev/name-screening: downloads the free FSF XML file, parses it into normalized Entry records and refreshes it into the screening cache, skipping an unchanged file by Last-Modified. Needs http.max-response-bytes of at least 32 MiB.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["sanctions", "eu", "compliance", "kyc", "aml", "screening"],
  deps: {
    "hot.dev/name-screening": "0.1.0"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
