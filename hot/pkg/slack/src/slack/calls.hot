::slack::calls ns

api-request ::slack::api/request
HttpError ::slack::api/HttpError
is-ok-response ::hot::http/is-ok-response

// ============================================================================
// Calls
// ============================================================================

CallsAddRequest type {
  external_unique_id: Str,
  join_url: Str,
  created_by: Str?,
  date_start: Int?,
  desktop_app_join_url: Str?,
  external_display_id: Str?,
  title: Str?,
  users: Vec<Map>?
}

CallsAddResponse type {
  ok: Bool?,
  error: Str?,
  call: Map?
}


calls-add
meta {
    doc: """
    POST /calls.add - Register a new call. Requires an `external_unique_id`
    and `join_url`. Optionally include a title, participants, and start
    time.

    **Example**

    ```hot
    response ::slack::calls/calls-add(::slack::calls/CallsAddRequest({
      external_unique_id: "call-2025-0042",
      join_url: "https://example.com/join/42",
      title: "Weekly sync",
      users: [{slack_id: "U1234567"}, {external_id: "guest-1", display_name: "Sam"}]
    }))
    response.call.id
    ```
    """
}
fn
(request: CallsAddRequest): CallsAddResponse {
  calls-add(request, {})
},
(request: CallsAddRequest, opts: Map): CallsAddResponse {
  response api-request("POST", `${::slack::core/BASE_URL}/calls.add`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { CallsAddResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

CallsEndRequest type {
  id: Str,
  duration: Int?
}

CallsEndResponse type {
  ok: Bool?,
  error: Str?
}


calls-end
meta {
    doc: """
    POST /calls.end - End a call. Pass the call `id` and optionally a
    `duration` in seconds.

    **Example**

    ```hot
    response ::slack::calls/calls-end(::slack::calls/CallsEndRequest({
      id: "R1234567",
      duration: 1800
    }))
    response.ok
    ```
    """
}
fn
(request: CallsEndRequest): CallsEndResponse {
  calls-end(request, {})
},
(request: CallsEndRequest, opts: Map): CallsEndResponse {
  response api-request("POST", `${::slack::core/BASE_URL}/calls.end`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { CallsEndResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

CallsInfoRequest type {
  id: Str
}

CallsInfoResponse type {
  ok: Bool?,
  error: Str?,
  call: Map?
}


calls-info
meta {
    doc: """
    GET /calls.info - Get information about a call. Returns the call object
    with title, participants, and status.

    **Example**

    ```hot
    response ::slack::calls/calls-info(::slack::calls/CallsInfoRequest({
      id: "R1234567"
    }))
    response.call.title
    ```
    """
}
fn
(request: CallsInfoRequest): CallsInfoResponse {
  calls-info(request, {})
},
(request: CallsInfoRequest, opts: Map): CallsInfoResponse {
  response api-request("GET", ::slack::api/with-query(`${::slack::core/BASE_URL}/calls.info`, {id: request.id}), {}, "", opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { CallsInfoResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

