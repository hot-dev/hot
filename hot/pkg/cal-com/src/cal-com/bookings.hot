::cal-com::bookings ns
meta {
    ctx: {"cal-com.api.key": {required: false}},
    doc: """Bookings (`cal-api-version: 2024-08-13`): create, list with filters and take/skip paging, get, confirm, decline, cancel, reschedule, and mark absences (no-shows)."""
}

::api ::cal-com::api

// Cal.com caps `take` at 250 on most lists; 100 is its documented
// default for bookings and keeps responses small.
DEFAULT_PAGE_SIZE 100

v
meta {no-doc: true}
fn (): Str { ::cal-com/VERSION_BOOKINGS }

create-booking
meta {
    doc: """
    POST /bookings - Book a slot. `booking`: `start` (UTC ISO 8601 from
    `get-slots`), `attendee` (`{name, email, timeZone, phoneNumber?,
    language?}`), and either `eventTypeId` or `eventTypeSlug` with
    `username`/`teamSlug`. Optional: `guests` (emails), `metadata`,
    `bookingFieldsResponses`, `lengthInMinutes`, `location`. Booking a
    recurring event type takes `recurrenceCount`. Unset fields are
    omitted.

    **Example**

    ```hot
    ::cal-com::bookings/create-booking({
      eventTypeId: 123,
      start: "2026-07-10T15:00:00Z",
      attendee: {name: "Ada Lovelace", email: "ada@example.com", timeZone: "America/Chicago"}
    })
    ```
    """
}
fn
(booking: Map): Any {
  create-booking(booking, {})
},
(booking: Map, opts: Map): Any {
  ::api/request("POST", "/bookings", ::api/compact(booking), v(), opts)
}

build-list-query
meta {
    doc: """
    Build the GET /bookings query string. `options` takes the API's own
    filter names: `status` (Str or Vec of "upcoming", "recurring",
    "past", "cancelled", "unconfirmed"), `attendeeEmail`,
    `attendeeName`, `eventTypeId`, `eventTypeIds` (Vec), `afterStart`,
    `beforeEnd`, `afterCreatedAt`, `beforeCreatedAt`, `afterUpdatedAt`,
    `beforeUpdatedAt` (ISO 8601), `sortStart`/`sortEnd`/`sortCreated`
    ("asc"/"desc"), `take` and `skip`. Nulls are dropped and Vecs are
    comma-joined. Exposed for testing.

    **Example**

    ```hot
    ::cal-com::bookings/build-list-query({take: 50, attendeeName: null})  // "?take=50"
    ```
    """
}
fn (options: Map): Str {
  ::api/query-string(options)
}

list-bookings
meta {
    doc: """
    GET /bookings - One page of the API key owner's bookings. Returns
    the envelope `{status, data, pagination}`; `pagination` carries
    `totalItems`, `remainingItems`, `hasNextPage` and friends. Page with
    `take` (default 100) and `skip`. See `build-list-query` for filters,
    or `list-all-bookings` to collect several pages.

    **Example**

    ```hot
    page ::cal-com::bookings/list-bookings({status: ["upcoming", "unconfirmed"], afterStart: "2026-07-01T00:00:00Z", take: 50})
    page.data
    page.pagination.hasNextPage
    ```
    """
}
fn
(): Any {
  list-bookings({})
},
(options: Map): Any {
  list-bookings(options, {})
},
(options: Map, opts: Map): Any {
  ::api/request-envelope("GET", `/bookings${build-list-query(options)}`, "", v(), opts)
}

collect-pages
meta {
    doc: """
    Collect take/skip pages from `fetch` (a Fn taking the options Map,
    returning a `{data, pagination}` envelope) until `limit` items, an
    empty page, or `pagination.hasNextPage` false. Each request asks for
    at most the remaining count. Exposed for testing; `list-all-bookings`
    uses it.

    **Example**

    ```hot
    ::cal-com::bookings/collect-pages((options) { {data: [1, 2], pagination: {hasNextPage: false}} }, {}, 0, 10, [])  // [1, 2]
    ::cal-com::bookings/collect-pages((options) { {data: [1, 2], pagination: {hasNextPage: true}} }, {}, 0, 1, [])  // [1]
    ```
    """
}
fn (fetch: Fn, options: Map, skip: Int, limit: Int, acc: Vec): Vec {
  remaining sub(limit, length(acc))
  page fetch({...options, take: min(DEFAULT_PAGE_SIZE, remaining), skip: skip})
  cond {
    is-err(page) => { page }
    => {
      items or(get(page, "data"), [])
      combined concat(acc, items)
      has-next get(or(get(page, "pagination"), {}), "hasNextPage", false)
      cond {
        is-empty(items) => { combined }
        gte(length(combined), limit) => { slice(combined, 0, limit) }
        not(eq(has-next, true)) => { combined }
        => { collect-pages(fetch, options, add(skip, length(items)), limit, combined) }
      }
    }
  }
}

list-all-bookings
meta {
    doc: """
    Collect bookings across pages (take/skip) until `limit` bookings or
    the last page. `options` takes the same filters as `list-bookings`
    (any `take`/`skip` in it are overridden). Returns a Vec of bookings.

    **Example**

    ```hot
    past ::cal-com::bookings/list-all-bookings({status: "past", afterStart: "2026-06-01T00:00:00Z"}, 500)
    ```
    """
}
fn
(options: Map, limit: Int): Vec {
  list-all-bookings(options, limit, {})
},
(options: Map, limit: Int, opts: Map): Vec {
  cond {
    lte(limit, 0) => { [] }
    => { collect-pages((page-options) { list-bookings(page-options, opts) }, options, or(get(options, "skip"), 0), limit, []) }
  }
}

get-booking
meta {
    doc: """
    GET /bookings/{uid} - One booking by uid.

    **Example**

    ```hot
    booking ::cal-com::bookings/get-booking(::cal-com::usersID)
    booking.status
    ```
    """
}
fn
(uid: Str): Any {
  get-booking(uid, {})
},
(uid: Str, opts: Map): Any {
  ::api/request("GET", `/bookings/${::api/path-segment(uid)}`, "", v(), opts)
}

confirm-booking
meta {
    doc: """
    POST /bookings/{uid}/confirm - Confirm a booking that is waiting for
    approval (event types that require confirmation). Must be called by the
    booking's owner.

    **Example**

    ```hot
    ::cal-com::bookings/confirm-booking(::cal-com::usersID)
    ```
    """
}
fn
(uid: Str): Any {
  confirm-booking(uid, {})
},
(uid: Str, opts: Map): Any {
  ::api/request("POST", `/bookings/${::api/path-segment(uid)}/confirm`, "", v(), opts)
}

decline-booking
meta {
    doc: """
    POST /bookings/{uid}/decline - Decline a booking that is waiting for
    approval, optionally with a `reason` the attendee sees.

    **Example**

    ```hot
    ::cal-com::bookings/decline-booking(::cal-com::usersID, "Outside our service area.")
    ```
    """
}
fn
(uid: Str): Any {
  decline-booking(uid, {})
},
(uid: Str, opts: Map): Any {
  ::api/request("POST", `/bookings/${::api/path-segment(uid)}/decline`, {}, v(), opts)
},
(uid: Str, reason: Str): Any {
  decline-booking(uid, reason, {})
},
(uid: Str, reason: Str, opts: Map): Any {
  ::api/request("POST", `/bookings/${::api/path-segment(uid)}/decline`, {reason: reason}, v(), opts)
}

cancel-booking
meta {
    doc: """
    POST /bookings/{uid}/cancel - Cancel a booking. The 2-arity form
    takes a reason; the Map form takes the API's body: `cancellationReason`,
    `cancelSubsequentBookings` (recurring), or `seatUid` (cancel one seat
    of a seated booking).

    **Example**

    ```hot
    ::cal-com::bookings/cancel-booking(::cal-com::usersID, "The customer asked to cancel.")

    // One seat of a seated booking
    ::cal-com::bookings/cancel-booking(::cal-com::usersID, {seatUid: "seat_1"})
    ```
    """
}
fn
(uid: Str, reason: Str): Any {
  cancel-booking(uid, {cancellationReason: reason})
},
(uid: Str, options: Map): Any {
  cancel-booking(uid, options, {})
},
(uid: Str, options: Map, opts: Map): Any {
  ::api/request("POST", `/bookings/${::api/path-segment(uid)}/cancel`, ::api/compact(options), v(), opts)
}

reschedule-booking
meta {
    doc: """
    POST /bookings/{uid}/reschedule - Move a booking to a new `start`
    (UTC ISO 8601). `options`: `reschedulingReason`, `rescheduledBy`
    (email), `seatUid` (seated bookings). Returns the new booking; the old
    uid is cancelled.

    **Example**

    ```hot
    moved ::cal-com::bookings/reschedule-booking(::cal-com::usersID, "2026-07-11T15:00:00Z", {reschedulingReason: "Conflict on the original day."})
    moved.uid
    ```
    """
}
fn
(uid: Str, new-start: Str): Any {
  reschedule-booking(uid, new-start, {})
},
(uid: Str, new-start: Str, options: Map): Any {
  reschedule-booking(uid, new-start, options, {})
},
(uid: Str, new-start: Str, options: Map, opts: Map): Any {
  ::api/request("POST", `/bookings/${::api/path-segment(uid)}/reschedule`, ::api/compact({...options, start: new-start}), v(), opts)
}

build-absent-body
meta {
    doc: """
    Build the mark-absent body: `host` (Bool, optional) and `attendees` as
    `[{email, absent}]` from a list of absent attendee emails. Unset parts
    are omitted. Exposed for testing.

    **Example**

    ```hot
    ::cal-com::bookings/build-absent-body(true, ["ada@example.com"])  // {host: true, attendees: [{email: "ada@example.com", absent: true}]}
    ::cal-com::bookings/build-absent-body(null, [])  // {}
    ```
    """
}
fn (host: Bool?, absent-emails: Vec): Map {
  attendees map(absent-emails, (email) { {email: email, absent: true} })
  ::api/compact({
    host: host,
    attendees: if(is-empty(attendees), null, attendees)
  })
}

mark-absent
meta {
    doc: """
    POST /bookings/{uid}/mark-absent - Record no-shows after a meeting.
    The Map form takes the API's body directly: `host` (Bool) and
    `attendees` (`[{email, absent}]`, `absent: false` to undo). The
    2-arity form marks the listed attendee emails absent. Must be called
    by the booking's owner.

    **Example**

    ```hot
    ::cal-com::bookings/mark-absent("bk_abc123", ["ada@example.com"])
    ::cal-com::bookings/mark-absent("bk_abc123", {host: true})
    ```
    """
}
fn
(uid: Str, absent-emails: Vec): Any {
  mark-absent(uid, build-absent-body(null, absent-emails))
},
(uid: Str, body: Map): Any {
  mark-absent(uid, body, {})
},
(uid: Str, body: Map, opts: Map): Any {
  ::api/request("POST", `/bookings/${::api/path-segment(uid)}/mark-absent`, ::api/compact(body), v(), opts)
}
