test-chat-with-tools-opts-arity
meta ["test"] fn () {
    msgs [::ai-chat/user-message("hi")]
    assert-reached-offline-url(() { ::ct/chat-with-tools("m", msgs, null, null, OFFLINE) }, "chat-with-tools")
    assert-reached-offline-url(() { ::ct/chat-with-tools-options("m", msgs, null, null, ::ct/DEFAULT_REQUEST_OPTIONS, OFFLINE) }, "chat-with-tools-options")
    assert-reached-offline-url(() { ::ct/chat-with-tools-stream("m", msgs, null, null, (d) { null }, OFFLINE) }, "chat-with-tools-stream")
    assert-reached-offline-url(() { ::ct/chat-with-tools-stream-options("m", msgs, null, null, (d) { null }, ::ct/DEFAULT_REQUEST_OPTIONS, OFFLINE) }, "chat-with-tools-stream-options")
}

test-run-loop-provider-opts-reach-the-request
meta ["test"] fn () {
    opts ::ai-chat/ChatOptions({chat-opts-fn: ::ct/chat-with-tools, model: "m", provider-opts: OFFLINE})
    assert-reached-offline-url(() { ::ai-chat/run-loop(opts, "hi") }, "run-loop")
    stream ::ai-chat/ChatOptions({chat-stream-opts-fn: ::ct/chat-with-tools-stream, model: "m", provider-opts: OFFLINE})
    assert-reached-offline-url(() { ::ai-chat/run-loop-stream(stream, "hi") }, "run-loop-stream")
}

test-run-loop-reaches-a-keyless-endpoint-through-provider-opts
meta ["test"] fn () {
    opts ::ai-chat/ChatOptions({chat-opts-fn: ::ct/chat-with-tools, model: "m", provider-opts: {endpoint: ::api/endpoint("http://127.0.0.1:1/v1")}})
    assert-reached-offline-url(() { with-ctx-key(null, () { ::ai-chat/run-loop(opts, "hi") }) }, "a keyless local server")
}

test-registration-routes-provider-opts
meta ["test"] fn () {
    groq ::compat/provider("Groq", "https://api.groq.com/openai/v1", "sk-configured", "groq/")
    opts ::ai-chat/ChatOptions({model: "groq/m", providers: ::ai-chat/with-providers([groq]), provider-opts: OFFLINE})
    assert-reached-offline-url(() { ::ai-chat/run-loop(opts, "hi") }, "registry run-loop")
    assert-reached-offline-url(() { ::ai-chat/run-loop-stream(opts, "hi") }, "registry run-loop-stream")
}

// ============================================================================
// Compatible providers
// ============================================================================

test-compat-identity-survives-a-typed-field-and-the-registry
meta ["test"] fn () {
    reg ::compat/provider("Ollama", "http://localhost:11434/v1", null, "ollama/")
    registry ::ai-chat/with-providers([reg])
    found ::ai-chat/resolve-registration(::ai-chat/ChatOptions({model: "ollama/llama3.2", providers: registry}))
    assert(is-type(found.variant, ::ai-chat/Provider), "still a Provider")
    assert(is-type(found.variant, ::ai-chat/Provider.Compat), "and its own variant")
    assert-eq("Ollama", found.variant.name)
    assert-eq(::ai-chat/Provider.Compat({name: "Ollama"}), found.variant)
    assert(ne(::ai-chat/Provider.Compat({name: "Groq"}), found.variant), "names tell servers apart")
    openai ::ai-chat/resolve-registration(::ai-chat/ChatOptions({model: "gpt-4o", providers: registry}))
    assert-eq(::ai-chat/Provider.OpenAi, openai.variant, "OpenAI itself is untouched")
}

test-compat-custom-variant-wins
meta ["test"] fn () {
    cfg ::compat/CompatibleProvider({
        name: "Mine",
        endpoint: ::api/endpoint("http://localhost:1/v1"),
        variant: ::ai-chat/Provider.Compat({name: "Other"})
    })
    assert-eq("Other", ::compat/provider(cfg).variant.name)
}

test-compat-resolve
meta ["test"] fn () {
    keyed ::compat/config("Groq", ::api/endpoint("https://api.groq.com/openai/v1", "sk-configured"), "groq/")
    assert-eq("sk-configured", ::compat/resolve(keyed).api-key)
    assert-eq("sk-tenant", ::compat/resolve(keyed, {api-key: "sk-tenant"}).api-key)
    assert(is-err(::compat/resolve(keyed, {api-key: ""})), "blank is an Err")
    assert(is-err(::compat/resolve(keyed, {base-url: "https://x.example.com/v1"})), "the configured key never goes to a per-call URL")

    needs-key ::compat/CompatibleProvider({name: "Groq", endpoint: ::api/endpoint("https://api.groq.com/openai/v1"), key-name: "groq.api.key"})
    missing ::compat/resolve(needs-key)
    assert(is-err(missing), "a server that needs a key says so")
    assert(contains(err-value(missing), "groq.api.key"))
    assert(contains(err-value(missing), "api-key"))
    assert-eq("sk-tenant", ::compat/resolve(needs-key, {api-key: "sk-tenant"}).api-key)
}

test-compat-functions-take-opts
meta ["test"] fn () {
    p ::compat/config("Groq", ::api/endpoint("https://api.groq.com/openai/v1", "sk-configured"), "groq/")
    assert-reached-offline-url(() { ::compat/list-models(p, OFFLINE) }, "list-models")
    assert-reached-offline-url(() { ::compat/create-embeddings(p, {model: "m", input: "a"}, OFFLINE) }, "create-embeddings")
    msgs [::ai-chat/user-message("hi")]
    chat ::compat/chat-opts-fn(p)
    stream ::compat/chat-stream-opts-fn(p)
    assert-reached-offline-url(() { chat("m", msgs, null, null, OFFLINE) }, "chat-opts-fn")
    assert-reached-offline-url(() { stream("m", msgs, null, null, (d) { null }, OFFLINE) }, "chat-stream-opts-fn")
    refused ::compat/list-models(p, {base-url: "http://127.0.0.1:1/v1"})
    assert(is-err(refused), "no key, no per-call URL")
    assert(contains(err-value(refused), "base-url"))
}

test-compat-chat-fn-returns-the-missing-key-error
meta ["test"] fn () {
    needs-key ::compat/CompatibleProvider({name: "Groq", endpoint: ::api/endpoint("https://api.groq.com/openai/v1"), key-name: "groq.api.key"})
    chat ::compat/chat-fn(needs-key)
    result chat("m", [::ai-chat/user-message("hi")], null, null)
    assert(is-err(result))
    assert(contains(err-value(result), "groq.api.key"))
}
