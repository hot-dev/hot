::whatsapp::api ns
meta {
    doc: """Low-level Graph API client for the WhatsApp Business Cloud API: authenticated JSON, multipart, and binary requests, response unwrapping, and URL building."""
}

::ctx ::hot::ctx

http-request ::hot::http/request
is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

// Meta's spec documents an optional User-Agent of the form name/x.y.z.
USER_AGENT "hot-whatsapp/1.1.0"

HttpError
meta {
    doc: """A non-2xx Graph API response. Meta's error object is in `body.error` (`message`, `type`, `code`, `error_subcode`, `fbtrace_id`); `error-message` extracts the message safely."""
}
type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: or(response.headers, {}),
    body: response.body
  })
}

handle-response
meta {
    doc: """Unwrap an HTTP response: the decoded body on 2xx, an Err carrying `HttpError` otherwise. Callers return transport Errs before calling it. Exposed for testing."""
}
fn (response: HttpResponse): Any {
  cond {
    is-ok-response(response) => { response.body }
    => { err(HttpError(response)) }
  }
}

error-message
meta {
    doc: """
    The human-readable message from a failed call's error value: Meta's
    `body.error.message` when the body is a Graph error object, otherwise
    the stringified body. Returns null for a non-error value.

    **Example**

    ```hot
    sent ::whatsapp::messages/send-text(::whatsapp::messages/SendTextRequest({
      phone_number_id: "109876543210", to: "15551234567", text: "Hi"
    }))
    if-err(sent, (e) { println(::whatsapp::api/error-message(e)) })
    ```
    """
}
fn (error: Any): Str? {
  body if(is-map(error), get(error, "body"), null)
  graph if(is-map(body), get(body, "error"), null)
  cond {
    and(is-map(graph), is-some(get(graph, "message"))) => { Str(graph.message) }
    is-some(body) => { Str(body) }
    is-some(error) => { Str(error) }
    => { null }
  }
}

auth-headers fn (access-token: Str): Map {
  {Authorization: `Bearer ${access-token}`, User-Agent: USER_AGENT}
}

request
meta {
    ctx: {"whatsapp.access.token": {required: true}},
    doc: """
    Call the Graph API with a JSON body. The access token is read from the `whatsapp.access.token` context variable (or passed explicitly in the 5-arity form) and sent as a Bearer token. Null fields in `body` are not sent. Returns the decoded body on 2xx, or an Err carrying `HttpError`.

    **Example**

    ```hot
    ::api ::whatsapp::api

    // GET request
    profile ::api/request("GET", ::api/url("109876543210/whatsapp_business_profile"))

    // POST request with JSON body
    sent ::api/request("POST", ::api/url("109876543210/messages"), {}, {messaging_product: "whatsapp", to: "15551234567", type: "text", text: {body: "Hello"}})
    ```
    """
}
fn
(method: Str, url: Str): Any {
  request(method, url, {}, {}, ::ctx/get("whatsapp.access.token"))
},
(method: Str, url: Str, additional-headers: Map, body: Map): Any {
  request(method, url, additional-headers, body, ::ctx/get("whatsapp.access.token"))
},
(method: Str, url: Str, additional-headers: Map, body: Map, access-token: Str): Any {
  payload filter-vals(untype(body), is-some)
  has-body not(is-empty(payload))
  base auth-headers(access-token)
  headers if(has-body, {...base, Content-Type: "application/json"}, base)

  response http-request(HttpRequest({
    method,
    url,
    headers: {...headers, ...additional-headers},
    body: if(has-body, to-json(payload), "")
  }))
  cond {
    is-err(response) => { response }
    => { handle-response(response) }
  }
}

request-bytes
meta {
    ctx: {"whatsapp.access.token": {required: true}},
    doc: """Send a raw body (e.g. a multipart upload built as `Bytes`) with an explicit `Content-Type`. Returns the decoded JSON body on 2xx, or an Err carrying `HttpError`."""
}
fn
(method: Str, url: Str, content-type: Str, body: Bytes): Any {
  request-bytes(method, url, content-type, body, ::ctx/get("whatsapp.access.token"))
},
(method: Str, url: Str, content-type: Str, body: Bytes, access-token: Str): Any {
  response http-request(HttpRequest({
    method,
    url,
    headers: {...auth-headers(access-token), Content-Type: content-type},
    body: body
  }))
  cond {
    is-err(response) => { response }
    => { handle-response(response) }
  }
}

download
meta {
    ctx: {"whatsapp.access.token": {required: true}},
    doc: """Authenticated GET returning the raw response bytes (`Bytes`) on 2xx, or an Err carrying `HttpError`. Used for media downloads."""
}
fn
(url: Str): Bytes {
  download(url, ::ctx/get("whatsapp.access.token"))
},
(url: Str, access-token: Str): Bytes {
  response http-request(HttpRequest({
    method: "GET",
    url,
    headers: auth-headers(access-token)
  }))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body-bytes }
    => { err(HttpError(response)) }
  }
}

url
meta {
    doc: """Build a Graph API URL from a path relative to the versioned base, e.g. `url("123/messages")` gives `https://graph.facebook.com/v26.0/123/messages`. The version follows `::whatsapp::core/api-version`."""
}
fn (path: Str): Str {
  `${::whatsapp::core/base-url()}/${path}`
}

segment
meta {
    doc: """Percent-encode one path segment (an id or name). Exposed for testing."""
}
fn (value: Any): Str {
  ::hot::uri/encode(Str(value))
}
