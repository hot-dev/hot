::notion::api ns
meta {
    ctx: {"notion.token": {required: false}},
    doc: """
    Transport for the Notion API.

    **Per-call credentials.** Every API-calling function in this package
    takes an optional trailing `opts` Map, resolved by `resolve`: `opts`
    first, then the `notion.token` context variable, then the defaults.
    Nothing from `opts` is written to ctx, so one run can act for many
    workspaces and parallel flows don't share credentials. A `token`
    present but blank or null is an error, never a fallback to context.

    - `token`: the integration secret or OAuth access token for this call
    - `api-version`: the `Notion-Version` for this call
    - `base-url`: another API root, such as a proxy. It needs a `token` in
      the same `opts`: `notion.token` is never sent to a per-call URL.
    """
}

::ctx ::hot::ctx
::re ::hot::regex

http-request ::hot::http/request
is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

HttpError type {
    status: Int,
    headers: Map,
    body: Any
}

HttpResponse -> HttpError fn (response: HttpResponse): HttpError {
  HttpError({
    status: response.status,
    headers: response.headers,
    body: response.body
  })
}

non-blank
meta {no-doc: true}
fn (value: Any): Str? {
  if(is-str(value), if(is-empty(trim(value)), null, trim(value)), null)
}

blank-credential
meta {
    doc: """
    The first of `names` that `opts` has but with a blank or null value,
    else null. Such a key is an error, never a fallback to context: a tenant
    whose key is missing must not run on the project's credentials.

    **Example**

    ```hot
    ::notion::api/blank-credential({token: "  "}, ["token"])  // "token"
    ::notion::api/blank-credential({token: "ntn_test"}, ["token"])  // null
    ```
    """
}
fn (opts: Map, names: Vec): Str? {
  find-first(names, (name) { and(in(name, keys(opts)), is-null(non-blank(get(opts, name)))) })
}

settings-from
meta {
    doc: """
    The non-credential settings of a call (pure): `{base-url, api-version}`
    from `opts`, else the package defaults.

    **Example**

    ```hot
    ::notion::api/settings-from({api-version: "2025-09-03"}).api-version  // "2025-09-03"
    ::notion::api/settings-from({base-url: "https://proxy.example.com/v1/"}).base-url  // "https://proxy.example.com/v1"
    ```
    """
}
fn (opts: Map): Map {
  base-url or(non-blank(get(opts, "base-url")), ::notion/BASE_URL)
  {
    base-url: ::re/replace-all(base-url, "/+$", ""),
    api-version: or(non-blank(get(opts, "api-version")), ::notion/NOTION_VERSION)
  }
}

resolve-from
meta {
    doc: """
    The one resolver, pure: `{token, base-url, api-version}` for a call from
    `opts` first, then `ctx-values` (a Map of context variables), then
    defaults. An Err when no token is set, when `token` is in `opts` but
    blank or null (that never falls back to context), or when `opts` has
    `base-url` without `token`. Exposed for testing; `resolve` feeds it the
    context.

    **Example**

    ```hot
    ctx-values {"notion.token": "ctx-token"}
    ::notion::api/resolve-from({}, ctx-values).token  // "ctx-token"
    ::notion::api/resolve-from({token: "call-token"}, ctx-values).token  // "call-token"
    is-err(::notion::api/resolve-from({token: ""}, ctx-values))  // true
    ```
    """
}
fn (opts: Map, ctx-values: Map): Map {
  token or(non-blank(get(opts, "token")), non-blank(get(ctx-values, "notion.token")))
  blank blank-credential(opts, ["token"])
  cond {
    is-some(blank) => {
      err(`notion: ${blank} is in the call's opts but is blank or null. Pass a value, or leave ${blank} out to use notion.token.`)
    }

    and(is-some(non-blank(get(opts, "base-url"))), is-null(non-blank(get(opts, "token")))) => {
      err("notion: base-url is in the call's opts without token. Pass token with it. Context credentials are never sent to a per-call URL.")
    }

    is-null(token) => { err("notion: notion.token is not set. Add it in Context Variables, or pass {token: ...} in the call's opts.") }
    => { {...settings-from(opts), token: token} }
  }
}

resolve
meta {
    ctx: {"notion.token": {required: false}},
    doc: """
    Credentials and settings for one call (see `resolve-from`). `opts`
    values are never written to ctx.
    A credential from `opts` is masked in the run's call records.

    **Example**

    ```hot
    ::notion::api/resolve({token: "ntn_tenant_b"}).api-version  // "2022-06-28"
    ```
    """
}
fn (opts: Map): Map {
  ::ctx/mark-secret(opts.token)
  resolve-from(opts, {"notion.token": ::ctx/get("notion.token")})
}

build-request
meta {
    doc: """
    The outgoing `HttpRequest` from resolved settings (see `resolve`).
    `additional-headers` win over the defaults, and a `""` body sends no
    `Content-Type`. Pure; exposed for testing.

    **Example**

    ```hot
    resolved {token: "test-token", base-url: "https://api.notion.com/v1", api-version: "2022-06-28"}
    req ::notion::api/build-request("POST", "/search", {}, {query: "roadmap"}, resolved)
    req.url  // "https://api.notion.com/v1/search"
    req.headers.Authorization  // "Bearer test-token"
    ```
    """
}
fn (method: Str, path: Str, additional-headers: Map, body: Any, resolved: Map): HttpRequest {
  default-headers {
    Authorization: `Bearer ${resolved.token}`,
    Notion-Version: resolved.api-version
  }

  headers if(eq(body, ""), default-headers, {...default-headers, Content-Type: "application/json"})
  final-headers {...headers, ...additional-headers}

  encoded-body if(eq(body, ""), "", to-json(untype(body)))
  HttpRequest({
    method,
    url: `${resolved.base-url}${path}`,
    headers: final-headers,
    body: encoded-body
  })
}

request
meta {
    doc: """
    Make an authenticated request to the Notion API. `path` is relative to
    api.notion.com/v1. Sends the required `Notion-Version` header.

    **Example**

    ```hot
    response ::notion::api/request("GET", "/users/me")
    response.status

    // Per-call credentials
    ::notion::api/request("POST", "/search", {}, {query: "roadmap"}, {
      token: ::hot::ctx/get("tenant.notion.token")
    })
    ```
    """
}
fn
(method: Str, path: Str): HttpResponse {
  request(method, path, {}, "")
},
(method: Str, path: Str, additional-headers: Map, body: Any): HttpResponse {
  request(method, path, additional-headers, body, {})
},
// 5-arity: explicit token override
(method: Str, path: Str, additional-headers: Map, body: Any, token: Str): HttpResponse {
  ::ctx/mark-secret(token)
  ::hot::http/request(build-request(method, path, additional-headers, body, {...settings-from({}), token: token}))
},
// 5-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): HttpResponse {
  resolved resolve(opts)
  cond {
    is-err(resolved) => { resolved }
    => { ::hot::http/request(build-request(method, path, additional-headers, body, resolved)) }
  }
}

json
meta {
    doc: """
    Like `request`, but unwraps: the decoded JSON body on 2xx, or an Err
    carrying `HttpError` (Notion's error `code`/`message` are in `body`).

    **Example**

    ```hot
    me ::notion::api/json("GET", "/users/me")
    me.name

    // Per-call credentials
    found ::notion::api/json("POST", "/search", {}, {query: "roadmap"}, {
      token: ::hot::ctx/get("tenant.notion.token")
    })
    found.results
    ```
    """
}
fn
(method: Str, path: Str): Any {
  json(method, path, {}, "")
},
(method: Str, path: Str, additional-headers: Map, body: Any): Any {
  response request(method, path, additional-headers, body)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body }
    => { err(HttpError(response)) }
  }
},
// 5-arity: explicit token override
(method: Str, path: Str, additional-headers: Map, body: Any, token: Str): Any {
  response request(method, path, additional-headers, body, token)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body }
    => { err(HttpError(response)) }
  }
},
// 5-arity: per-call credentials and settings (see `resolve`)
(method: Str, path: Str, additional-headers: Map, body: Any, opts: Map): Any {
  response request(method, path, additional-headers, body, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response.body }
    => { err(HttpError(response)) }
  }
}
