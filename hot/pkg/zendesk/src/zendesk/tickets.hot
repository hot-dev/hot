list-ticket-fields
meta {
    doc: """
    GET /ticket_fields - System and custom ticket fields
    (`{ticket_fields}`), with the `id`s that `custom_fields` entries use
    and, for dropdowns, `custom_field_options`. `options`: `locale`,
    `creator`.

    **Example**

    ```hot
    out ::zendesk::tickets/list-ticket-fields({locale: "en-US"})
    map(out.ticket_fields, %.title)
    ```
    """
}
fn
(): Any {
  list-ticket-fields({})
},
(options: Map): Any {
  list-ticket-fields(options, {})
},
(options: Map, opts: Map): Any {
  ::api/request("GET", `/ticket_fields${::api/query-string(options)}`, "", opts)
}

list-satisfaction-ratings
meta {
    doc: """
    GET /satisfaction_ratings - One cursor page of CSAT ratings (admins
    only): `{satisfaction_ratings, meta, links}`. `options`: `score`
    ("good", "bad", "received", "bad_with_comment", ...),
    `start_time`/`end_time` (Unix seconds), `page_size`, `after`.

    **Example**

    ```hot
    page ::zendesk::tickets/list-satisfaction-ratings({score: "bad_with_comment", page_size: 50})
    map(page.satisfaction_ratings, %.comment)
    ```
    """
}
fn
(): Any {
  list-satisfaction-ratings({})
},
(options: Map): Any {
  list-satisfaction-ratings(options, {})
},
(options: Map, opts: Map): Any {
  ::api/list-page("/satisfaction_ratings", options, opts)
}

// ---------------------------------------------------------------------------
// Incremental export (cursor-based)
// ---------------------------------------------------------------------------

export-tickets
meta {
    doc: """
    GET /incremental/tickets/cursor?start_time= - Start a cursor-based
    incremental export of every ticket changed since `start-time` (Unix
    seconds, at least a minute in the past). Returns `{tickets,
    after_cursor, end_of_stream}`; continue with `export-tickets-next`
    until `end_of_stream` is true, then keep the last `after_cursor` for
    the next sync. Admins only; rate-limited to 10 requests a minute.
    `options`: `include` (e.g. "users,groups"), `exclude_deleted`.

    **Example**

    ```hot
    batch ::zendesk::tickets/export-tickets(sub(::hot::time/epoch-seconds(), 86400))
    next ::zendesk::tickets/export-tickets-next(batch.after_cursor)
    ```
    """
}
fn
(start-time: Int): Any {
  export-tickets(start-time, {})
},
(start-time: Int, options: Map): Any {
  export-tickets(start-time, options, {})
},
(start-time: Int, options: Map, opts: Map): Any {
  ::api/request("GET", `/incremental/tickets/cursor${::api/query-string({...options, start_time: start-time})}`, "", opts)
}

export-tickets-next
meta {
    doc: """
    GET /incremental/tickets/cursor?cursor= - The next batch of an
    incremental ticket export, from the previous batch's `after_cursor`.

    **Example**

    ```hot
    batch ::zendesk::tickets/export-tickets(1780000000, {exclude_deleted: true})
    following if(batch.end_of_stream, null, ::zendesk::tickets/export-tickets-next(batch.after_cursor))
    ```
    """
}
fn
(cursor: Str): Any {
  export-tickets-next(cursor, {})
},
(cursor: Str, options: Map): Any {
  export-tickets-next(cursor, options, {})
},
(cursor: Str, options: Map, opts: Map): Any {
  ::api/request("GET", `/incremental/tickets/cursor${::api/query-string({...options, cursor: cursor})}`, "", opts)
}
