        cond {
            is-err(response) => { response }
            is-ok-response(response) => { { success: true } }
            => { AwsError(response) }
        }
    })
},
(topic_arn: Str, attribute_name: Str, attribute_value: Str): Map | AwsError {
    set-topic-attributes(topic_arn, attribute_name, attribute_value, {})
}

// Tag a topic
tag-resource
meta {
    doc: """
    Add tags to an SNS topic.

    **Example**

    ```hot
    ::aws::sns::topics/tag-resource(topic-arn, [
        {Key: "Environment", Value: "production"},
        {Key: "Application", Value: "my-app"}
    ])
    ```
    """
}
fn
(resource_arn: Str, tags: Vec<Map>, opts: Map): Map | AwsError {
    if-ok(resolve(opts), (resolved) {
        body to-json({
            ResourceArn: resource_arn,
            Tags: tags
        })

        url `${service-url(resolved, "sns")}/`

        headers {
            "Content-Type": "application/x-amz-json-1.0",
            "X-Amz-Target": "AmazonSimpleNotificationService.TagResource"
        }

        response send-signed("POST", url, "sns", resolved, headers, body)

        cond {
            is-err(response) => { response }
            is-ok-response(response) => { { success: true } }
            => { AwsError(response) }
        }
    })
},
(resource_arn: Str, tags: Vec<Map>): Map | AwsError {
    tag-resource(resource_arn, tags, {})
}

