// The parsed entries of all four excerpts.
all-entries fn (): Vec {
  concat(
    ::sanctions::ofac/parse("ofac-sdn", OFAC_SDN, OFAC_ALT, OFAC_ADD, OFAC_COMMENTS),
    ::sanctions::uk/parse(UK_XML),
    ::sanctions::eu/parse(EU_XML),
    ::sanctions::un/parse(UN_XML)
  )
}

// In-memory indexes per source, as the cache stores them.
indexes fn (): Map {
  {
    ofac-sdn: ::sanctions::index/build(::sanctions::ofac/parse("ofac-sdn", OFAC_SDN, OFAC_ALT, OFAC_ADD, OFAC_COMMENTS)),
    uk: ::sanctions::index/build(::sanctions::uk/parse(UK_XML)),
    eu: ::sanctions::index/build(::sanctions::eu/parse(EU_XML)),
    un: ::sanctions::index/build(::sanctions::un/parse(UN_XML))
  }
}
