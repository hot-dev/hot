::shopify ns
meta {
    doc: """
    Shopify Admin bindings over the GraphQL Admin API (Shopify's current
    surface; the REST Admin API is legacy for new apps).

    Curated functions cover orders, fulfillments, inventory, products,
    customers, draft orders, metafields and webhook subscriptions, with
    cursor pagination, throttle reporting and `userErrors` surfaced as
    errs. `::shopify::api/graphql` runs anything else.

    **Setup**: context variables
    - `shopify.shop`: the shop, as `acme` or `acme.myshopify.com`
    - `shopify.access.token`: an Admin API access token (`shpat_...`)
    - `shopify.api.version`: optional, overrides the pinned `API_VERSION`
    - `shopify.webhook.secret`: for webhook verification

    **Quick start**

    ```hot
    ::orders ::shopify::orders
    ::products ::shopify::products

    page ::orders/list-orders({first: 10, query: "financial_status:paid"})
    every ::orders/collect-orders({query: "created_at:>=2026-10-01"}, 500)
    hits ::products/search-products("title:*sticker* status:active")

    // Anything else via raw GraphQL
    shop ::shopify::api/graphql("{ shop { name currencyCode } }")
    ```
    """
}

// The Admin API version every request targets unless the
// `shopify.api.version` context variable overrides it. Shopify supports
// each quarterly version for 12 months; 2026-10 is supported until
// October 2027 (https://shopify.dev/docs/api/usage/versioning).
API_VERSION "2026-10"

// Connection page size bounds: Shopify caps `first` at 250.
DEFAULT_PAGE_SIZE 50
MAX_PAGE_SIZE 250
