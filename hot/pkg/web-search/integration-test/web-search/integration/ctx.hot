::web-search::integration::ctx ns

::env ::hot::env

// Credentials for the web-search integration suite. Unset environment
// variables are skipped entirely, so absent credentials behave exactly as
// if never configured; a provider without a key is skipped, and with no
// keys at all every test skips (passes with a "skipped" note).
::hot::ctx/set(filter-vals({
    "tavily.api.key": ::env/get("TAVILY_API_KEY", ""),
    "brave.api.key": ::env/get("BRAVE_API_KEY", ""),
    "exa.api.key": ::env/get("EXA_API_KEY", ""),
    "firecrawl.api.key": ::env/get("FIRECRAWL_API_KEY", ""),
}, (v) { not(is-empty(v)) }))

skip
meta {
    doc: """Record a skipped test: prints why and passes one assertion so the runner reports it cleanly."""
}
fn (reason: Str): Bool {
    println(`skipped: ${reason}`)
    assert(true, reason)
}

UNCONFIGURED "set at least one of TAVILY_API_KEY, BRAVE_API_KEY, EXA_API_KEY, FIRECRAWL_API_KEY"
