modify-thread
meta {
    doc: """
    POST /threads/{thread_id} - Update a thread's tool resources or
    metadata.

    **Example**

    ```hot
    thread ::openai::modify/modify-thread("thread_abc123", ::openai::modify/ModifyThreadRequest({
      metadata: {user: "u_123"}
    }))
    thread.metadata
    ```
    """
}
fn
(thread-id: Str, request: ModifyThreadRequest): ModifyThreadResponse {
  modify-thread(thread-id, request, {})
},
(thread-id: Str, request: ModifyThreadRequest, opts: Map): ModifyThreadResponse {
  response api-request("POST", `/threads/${thread-id}`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ModifyThreadResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

