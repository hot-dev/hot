::plaid::items ns
meta {
    doc: """Items (one user's login at one institution): status, webhook URL, and removal."""
}

::api ::plaid::api

get-item
meta {
    doc: """
    POST /item/get: the Item's institution, products, consent expiry,
    webhook and `error` (e.g. `ITEM_LOGIN_REQUIRED` when the user must
    re-authenticate through Link update mode). Returns `{item, status,
    request_id}`.

    **Example**

    ```hot
    access-token ::hot::ctx/get("plaid.access-token")
    out ::plaid::items/get-item(access-token)
    out.item.institution_id
    ```
    """
}
fn
(access-token: Str): Map {
  get-item(access-token, {})
},
(access-token: Str, opts: Map): Map {
  ::api/post("/item/get", {access_token: access-token}, opts)
}

remove-item
meta {
    doc: """
    POST /item/remove: invalidate the access token and stop billing for
    the Item. Irreversible. Options: `reason_code` (e.g.
    `"USER_REQUEST"`, `"FRAUD_FIRST_PARTY"`), `reason_note`.

    **Example**

    ```hot
    access-token ::hot::ctx/get("plaid.access-token")
    ::plaid::items/remove-item(access-token, {reason_code: "USER_REQUEST"})
    ```
    """
}
fn
(access-token: Str): Map {
  remove-item(access-token, {})
},
(access-token: Str, options: Map): Map {
  remove-item(access-token, options, {})
},
(access-token: Str, options: Map, opts: Map): Map {
  ::api/post("/item/remove", {
    access_token: access-token,
    reason_code: get(options, "reason_code"),
    reason_note: get(options, "reason_note")
  }, opts)
}

update-item-webhook
meta {
    doc: """
    POST /item/webhook/update: point the Item's webhooks at a new URL (Plaid
    then sends `WEBHOOK_UPDATE_ACKNOWLEDGED`). Returns `{item, request_id}`.

    **Example**

    ```hot
    access-token ::hot::ctx/get("plaid.access-token")
    ::plaid::items/update-item-webhook(access-token, "https://example.com/plaid/webhook")
    ```
    """
}
fn
(access-token: Str, webhook: Str): Map {
  update-item-webhook(access-token, webhook, {})
},
(access-token: Str, webhook: Str, opts: Map): Map {
  ::api/post("/item/webhook/update", {access_token: access-token, webhook: webhook}, opts)
}
