::hot::pkg ns

hot.pkg.documents {
  name: "hot.dev/documents",
  version: "0.1.0",
  hot-min-version: "3.0.2",
  description: "Provider-neutral document access for workflows and AI agents: one Document record, source descriptors, list/search/get/download, read-text with native export or extraction (Google Docs to Markdown, Dropbox Paper export, Box extracted text, OneDrive conversion), uploads, change feeds with opaque cursors, webhook normalising and per-provider capabilities over Google Drive, OneDrive and SharePoint, Dropbox, Box and Amazon S3.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["documents", "files", "storage", "rag", "google-drive", "onedrive", "sharepoint", "dropbox", "box", "s3"],
  deps: {
    "hot.dev/google-drive": {
      local: "../google-drive",
      git: "https://github.com/hot-dev/hot",
      path: "hot/pkg/google-drive"
    },
    "hot.dev/microsoft-onedrive": {
      local: "../microsoft-onedrive",
      git: "https://github.com/hot-dev/hot",
      path: "hot/pkg/microsoft-onedrive"
    },
    "hot.dev/dropbox": {
      local: "../dropbox",
      git: "https://github.com/hot-dev/hot",
      path: "hot/pkg/dropbox"
    },
    "hot.dev/box": {
      local: "../box",
      git: "https://github.com/hot-dev/hot",
      path: "hot/pkg/box"
    },
    "hot.dev/aws-core": {
      local: "../aws-core",
      git: "https://github.com/hot-dev/hot",
      path: "hot/pkg/aws-core"
    }
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
