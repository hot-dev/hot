// ---------------------------------------------------------------------------
// Flattening (pure)
// ---------------------------------------------------------------------------

column-meta fn (column: Map, name: Str): Str? {
  hit find-first(or(get(column, "MetaData"), []), (m) { eq(get(m, "Name"), name) })
  if(is-map(hit), get(hit, "Value"), null)
}

column-keys
meta {
    doc: """
    The key for each report column: its `ColTitle`, else its `ColKey`
    metadata, else its `ColType`, else `col{i}`. Repeated keys get
    `_{i}` appended, so every key is unique.
    """
}
fn (report: Map): Vec {
  columns or(get(or(get(report, "Columns"), {}), "Column"), [])
  raw map-indexed(columns, (i, c) {
    title get(c, "ColTitle")
    col-key column-meta(c, "ColKey")
    col-type get(c, "ColType")
    cond {
      and(is-str(title), not(is-empty(trim(title)))) => { trim(title) }
      is-some(col-key) => { col-key }
      and(is-str(col-type), not(is-empty(col-type))) => { col-type }
      => { `col${i}` }
    }
  })
  map-indexed(raw, (i, k) {
    earlier slice(raw, 0, i)
    if(in(k, earlier), `${k}_${i}`, k)
  })
}

cell-values fn (col-data: Any): Vec {
  map(or(col-data, []), (c) { or(get(c, "value"), "") })
}

record fn (kind: Str, path: Vec, group: Str?, col-data: Any, col-keys: Vec, depth: Int): Map {
  cells cell-values(col-data)
  first-cell if(is-empty(or(col-data, [])), {}, first(col-data))
  values reduce(range(0, min(length(col-keys), length(cells))), (acc, i) { assoc(acc, col-keys[i], cells[i]) }, {})
  filter-vals({
    type: kind,
    path: path,
    group: group,
    depth: depth,
    label: if(is-empty(cells), null, first(cells)),
    id: get(first-cell, "id"),
    values: values,
    cells: cells
  }, is-some)
}

flatten-rows fn (rows: Vec, col-keys: Vec, path: Vec, group: Str?, depth: Int): Vec {
  mapcat(rows, (row) {
    row-group or(get(row, "group"), group)
    header-cells get(or(get(row, "Header"), {}), "ColData")
    header-label if(is-vec(header-cells), if(is-empty(header-cells), null, get(first(header-cells), "value")), null)
    child-path if(is-null(header-label), path, concat(path, [header-label]))
    children or(get(or(get(row, "Rows"), {}), "Row"), [])
    summary get(or(get(row, "Summary"), {}), "ColData")
    data get(row, "ColData")
    own if(is-vec(data), [record("Data", path, row-group, data, col-keys, depth)], [])
    nested flatten-rows(children, col-keys, child-path, row-group, add(depth, 1))
    totals if(is-vec(summary), [record("Summary", child-path, row-group, summary, col-keys, depth)], [])
    concat(own, nested, totals)
  })
}

flatten-report
meta {
    doc: """
    Flatten a report into records, in report order:

    - `type` - `"Data"` for detail rows, `"Summary"` for section totals
    - `label` - the first column (account, customer or transaction name)
    - `id` - the first column's entity id, when the report links one
    - `values` - every column by `column-keys` (`{"Total": "1200.00"}`)
    - `cells` - the column values as a Vec of Str
    - `path` - the section headers above the row (`["Income", "Services"]`)
    - `group` - the nearest section's `group` (`"Income"`, `"NetIncome"`, ...)
    - `depth` - nesting level, 0 at the top

    Amounts stay as the Strs QuickBooks sends; `parse-amount` converts one.
    """
}
fn (report: Map): Vec {
  flatten-rows(or(get(or(get(report, "Rows"), {}), "Row"), []), column-keys(report), [], null, 0)
}

parse-amount
meta {
    doc: """A report amount Str (`"1200.00"`, `"-35.5"`) as a Dec; null for blanks and non-numbers."""
}
fn (value: Any): Dec? {
  cond {
    is-int(value) => { Dec(value) }
    is-dec(value) => { value }
    and(is-str(value), ::re/is-match(trim(Str(value)), "^-?[0-9]{1,18}(\\.[0-9]{1,10})?$")) => { Dec(trim(value)) }
    => { null }
  }
}
