::hot::pkg ns

hot.pkg.google-calendar {
  name: "hot.dev/google-calendar",
  version: "0.1.0",
  hot-min-version: "3.0.2",
  description: "Google Calendar API v3 bindings for Hot: events with every filter, Google Meet links and attendee notifications, recurring instances, quick add and move, incremental sync with sync tokens, push-notification webhooks, free/busy, calendars and sharing.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["google", "google-calendar", "calendar", "scheduling"],
  deps: {
    "hot.dev/google-core": {
      local: "../google-core",
      git: "https://github.com/hot-dev/hot",
      path: "hot/pkg/google-core"
    }
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
