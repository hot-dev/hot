::crm::test ns
meta ["test"]

::hs ::crm::hubspot
::sf ::crm::salesforce
::at ::crm::attio
::ctx ::hot::ctx

clear-ctx fn (): Any {
  ::ctx/set({
    "crm.provider": null,
    "hubspot.token": null,
    "attio.api.key": null,
    "salesforce.access.token": null,
    "salesforce.instance.url": null,
    "salesforce.client-id": null,
    "salesforce.client-secret": null,
    "salesforce.my-domain.url": null,
    "crm.salesforce.domain-field": null,
    "crm.attio.deal-owner": null
  })
}

// ============================================================================
// Provider selection
// ============================================================================

test-no-provider-errors
meta ["test"] fn () {
    clear-ctx()
    assert(is-err(::crm/upsert-contact({email: "a@b.c"})), "no configured CRM is a clear error")
    assert(is-err(::crm/find-deals({})), "every entry point checks")
}

test-provider-selection
meta ["test"] fn () {
    none {hubspot: false, salesforce: false, attio: false}
    all {hubspot: true, salesforce: true, attio: true}
    assert(is-null(::crm/select-provider(null, none)), "nothing configured selects nothing")
    assert-eq("hubspot", ::crm/select-provider(null, all), "hubspot first")
    assert-eq("salesforce", ::crm/select-provider(null, {...none, salesforce: true, attio: true}))
    assert-eq("attio", ::crm/select-provider(null, {...none, attio: true}))
}

test-preferred-provider-wins
meta ["test"] fn () {
    all {hubspot: true, salesforce: true, attio: true}
    assert-eq("attio", ::crm/select-provider("attio", all), "crm.provider / options.provider overrides the order")
    assert-eq("salesforce", ::crm/select-provider(" Salesforce ", all), "case and whitespace tolerant")
    assert-eq("hubspot", ::crm/select-provider("", all), "blank preference falls back to the order")
    assert(is-err(::crm/select-provider("pipedrive", all)), "unknown provider is an Err")
}

test-ctx-provider-and-per-call-option
meta ["test"] fn () {
    clear-ctx()
    ::ctx/set({"hubspot.token": "pat-x", "attio.api.key": "attio-x"})
    assert-eq("hubspot", ::crm/configured-provider(), "first configured")
    assert-eq("attio", ::crm/resolve-provider({provider: "attio"}), "per-call option")
    ::ctx/set("crm.provider", "attio")
    assert-eq("attio", ::crm/configured-provider(), "crm.provider")
    assert-eq("hubspot", ::crm/resolve-provider({provider: "hubspot"}), "per-call option beats crm.provider")
    clear-ctx()
}

test-salesforce-needs-a-complete-flow
meta ["test"] fn () {
    clear-ctx()
    ::ctx/set({"salesforce.client-id": "c", "attio.api.key": "attio-x"})
    assert-eq("attio", ::crm/configured-provider(), "a bare salesforce.client-id does not select salesforce")
    ::ctx/set({"salesforce.client-secret": "s"})
    assert-eq("attio", ::crm/configured-provider(), "client credentials without My Domain are incomplete")
    ::ctx/set({"salesforce.my-domain.url": "https://acme.my.salesforce.com"})
    assert-eq("salesforce", ::crm/configured-provider(), "complete client-credentials flow")
    clear-ctx()
}

test-required-fields
meta ["test"] fn () {
    clear-ctx()
    ::ctx/set("hubspot.token", "pat-x")
    assert(is-err(::crm/upsert-contact({first-name: "Ada"})), "email required, no request made")
    assert(is-err(::crm/upsert-company({name: "Acme"})), "domain required")
    assert(is-err(::crm/upsert-deal({stage: "x"})), "id or name required")
    clear-ctx()
}

// ============================================================================
// Shared helpers
// ============================================================================

test-normalize-domain
meta ["test"] fn () {
    assert-eq("acme.com", ::crm/normalize-domain("acme.com"))
    assert-eq("acme.com", ::crm/normalize-domain("https://www.Acme.com/about?x=1"))
    assert-eq("acme.com", ::crm/normalize-domain("http://acme.com:8080/"))
    assert-eq("acme.com", ::crm/normalize-domain("WWW.ACME.COM."))
    assert-eq("eu.acme.co.uk", ::crm/normalize-domain("eu.acme.co.uk/"))
    assert(is-null(::crm/normalize-domain("")))
    assert(is-null(::crm/normalize-domain(null)))
}

test-full-name
meta ["test"] fn () {
    assert-eq("Ada Lovelace", ::crm/full-name("Ada", "Lovelace"))
    assert-eq("Ada", ::crm/full-name("Ada", null))
    assert-eq("Lovelace", ::crm/full-name("", "Lovelace"))
}

// ============================================================================
// Salesforce mapping
// ============================================================================

test-salesforce-last-name-defaults-only-on-create
meta ["test"] fn () {
    create ::sf/contact-fields({email: "ada@example.com", first-name: "Ada"}, true, null)
    assert-eq("Unknown", create.LastName, "Salesforce requires LastName on insert")
    update ::sf/contact-fields({email: "ada@example.com", first-name: "Ada"}, false, null)
    assert(not(in("LastName", keys(update))), "an update without last-name must not touch LastName")
    given ::sf/contact-fields({email: "ada@example.com", last-name: "Lovelace"}, false, null)
    assert-eq("Lovelace", given.LastName)
}

test-salesforce-contact-fields-omit-unset
meta ["test"] fn () {
    f ::sf/contact-fields({email: "ada@example.com"}, false, null)
    assert-eq({Email: "ada@example.com"}, f, "no nulls, no AccountId")
    linked ::sf/contact-fields({email: "ada@example.com"}, false, "001xx")
    assert-eq("001xx", linked.AccountId, "company maps to AccountId")
}

test-salesforce-normalize-contact
meta ["test"] fn () {
    c ::sf/normalize-contact({Id: "003xx", Email: "ada@example.com", FirstName: "Ada", LastName: "Lovelace", Phone: "+1 555", AccountId: "001xx"})
    assert-eq("003xx", c.id)
    assert-eq("Lovelace", c.last-name)
    assert-eq("+1 555", c.phone)
    assert-eq("001xx", c.company-id)
    assert-eq("salesforce", c.provider)
}

test-salesforce-company-matching
meta ["test"] fn () {
    q ::sf/build-company-soql("acme.com", null)
    assert(contains(q, "WHERE Website LIKE '%acme.com%'"), "candidate query on Website")
    assert(contains(::sf/build-company-soql("o'hara_co.com", null), "LIKE '%o\\'hara\\_co.com%'"), "escaped for LIKE")
    assert(contains(::sf/build-company-soql("acme.com", "Domain__c"), "WHERE Domain__c = 'acme.com'"), "exact match on a domain field")
    assert(::sf/matches-domain({Website: "https://www.acme.com/"}, "acme.com", null))
    assert(::sf/matches-domain({Website: "acme.com"}, "acme.com", null))
    assert(not(::sf/matches-domain({Website: "notacme.com"}, "acme.com", null)), "LIKE candidates are filtered exactly")
    assert(not(::sf/matches-domain({Website: null}, "acme.com", null)))
}

test-salesforce-domain-field-validation
meta ["test"] fn () {
    clear-ctx()
    assert(is-null(::sf/domain-field()))
    ::ctx/set("crm.salesforce.domain-field", "Domain__c")
    assert-eq("Domain__c", ::sf/domain-field())
    ::ctx/set("crm.salesforce.domain-field", "Name = 'x' OR Id")
    assert(is-err(::sf/domain-field()), "not an API name: refused rather than interpolated")
    clear-ctx()
}

test-salesforce-normalize-company
meta ["test"] fn () {
    c ::sf/normalize-company({Id: "001xx", Name: "Acme", Website: "https://www.acme.com/"}, null)
    assert-eq("acme.com", c.domain)
    d ::sf/normalize-company({Id: "001xx", Name: "Acme", Website: "x", Domain__c: "acme.io"}, "Domain__c")
    assert-eq("acme.io", d.domain)
}

test-salesforce-deals
meta ["test"] fn () {
    f ::sf/deal-fields({name: "Acme expansion", stage: "Prospecting", amount: 24000, close-date: "2026-12-31", company-id: "001xx"})
    assert-eq({Name: "Acme expansion", StageName: "Prospecting", Amount: 24000, CloseDate: "2026-12-31", AccountId: "001xx"}, f)
    assert-eq({StageName: "Closed Won"}, ::sf/deal-fields({stage: "Closed Won"}), "unset omitted")
    assert-eq(["close-date"], ::sf/missing-deal-fields({name: "x", stage: "y"}))
    q ::sf/build-deals-soql({name: "O'Brien deal", company-id: "001xx", contact-id: "003yy", limit: 2})
    assert(contains(q, "Name = 'O\\'Brien deal'"))
    assert(contains(q, "AccountId = '001xx'"))
    assert(contains(q, "SELECT OpportunityId FROM OpportunityContactRole WHERE ContactId = '003yy'"))
    assert(ends-with(q, "LIMIT 2"))
    assert(not(contains(::sf/build-deals-soql({}), "WHERE")), "no filter, no WHERE")
    d ::sf/normalize-deal({Id: "006xx", Name: "Acme expansion", StageName: "Prospecting", Amount: 24000, CloseDate: "2026-12-31", AccountId: "001xx"})
    assert-eq("Prospecting", d.stage)
    assert-eq("001xx", d.company-id)
}

test-salesforce-activities
meta ["test"] fn () {
    t ::sf/build-task-body("003xx", "Called; wants pricing.", {})
    assert-eq({Subject: "Note", Description: "Called; wants pricing.", Status: "Completed", WhoId: "003xx"}, t)
    assert-eq("Demo", ::sf/build-task-body("003xx", "b", {subject: "Demo"}).Subject)
    a ::sf/normalize-activity({Id: "00Txx", Subject: "Demo", Description: "b", CreatedDate: "2026-11-01T10:00:00.000+0000"})
    assert-eq("Demo", a.subject)
    assert-eq("b", a.body)
}

// ============================================================================
// HubSpot mapping
// ============================================================================

test-hubspot-normalize-contact
meta ["test"] fn () {
    c ::hs/normalize-contact({id: "1234", properties: {email: "ada@example.com", firstname: "Ada", lastname: "Lovelace", associatedcompanyid: 987}})
    assert-eq("1234", c.id)
    assert-eq("ada@example.com", c.email)
    assert-eq("Ada", c.first-name)
    assert-eq("987", c.company-id)
    assert-eq("hubspot", c.provider)
}

test-hubspot-contact-upsert-body
meta ["test"] fn () {
    r ::hs/build-contact-upsert({email: "ada@example.com", first-name: "Ada", company: "Acme"})
    assert-eq("ada@example.com", r.id, "keyed on email")
    assert-eq({email: "ada@example.com", firstname: "Ada", company: "Acme"}, r.properties, "unset properties omitted")
}

test-hubspot-deals
meta ["test"] fn () {
    p ::hs/deal-properties({name: "Acme expansion", stage: "appointmentscheduled", amount: 24000, close-date: "2026-12-31"})
    assert-eq({dealname: "Acme expansion", dealstage: "appointmentscheduled", amount: "24000", closedate: "2026-12-31"}, p)
    s ::hs/build-deal-search({name: "Acme expansion", company-id: "987", limit: 2})
    assert-eq(2, s.limit)
    assert-eq([
        {propertyName: "dealname", operator: "EQ", value: "Acme expansion"},
        {propertyName: "associations.company", operator: "EQ", value: "987"}
    ], s.filters)
    assert(not(in("filters", keys(::hs/build-deal-search({})))), "no filter keys, no filters")
    d ::hs/normalize-deal({id: "55", properties: {dealname: "Acme expansion", dealstage: "closedwon", amount: "24000", closedate: "2026-12-31T00:00:00Z"}}, null)
    assert-eq("2026-12-31", d.close-date)
    assert-eq("closedwon", d.stage)
}

test-hubspot-activities
meta ["test"] fn () {
    assert-eq("plain", ::hs/note-text("plain", null))
    assert-eq("<strong>Demo</strong><br>went well", ::hs/note-text("went well", "Demo"))
    s ::hs/build-note-search("1234", 5)
    assert-eq("associations.contact", first(s.filters).propertyName)
    assert-eq(5, s.limit)
    a ::hs/normalize-activity({id: "77", properties: {hs_note_body: "hi", hs_timestamp: "2026-11-01T10:00:00Z"}}, null)
    assert-eq("77", a.id)
    assert-eq("hi", a.body)
}

// ============================================================================
// Attio mapping
// ============================================================================

test-attio-normalize-contact
meta ["test"] fn () {
    c ::at/normalize-contact({
        id: {record_id: "rec-9"},
        values: {
            email_addresses: [{email_address: "ada@example.com"}],
            name: [{first_name: "Ada", last_name: "Lovelace", full_name: "Ada Lovelace"}],
            company: [{target_object: "companies", target_record_id: "co-1"}]
        }
    })
    assert-eq("rec-9", c.id)
    assert-eq("ada@example.com", c.email)
    assert-eq("Ada", c.first-name)
    assert-eq("co-1", c.company-id)
    assert-eq("attio", c.provider)
}

test-attio-normalize-contact-missing-name
meta ["test"] fn () {
    c ::at/normalize-contact({id: {record_id: "rec-2"}, values: {email_addresses: [{email_address: "x@y.z"}]}})
    assert(is-null(c.first-name), "missing name attribute normalizes to null")
}

test-attio-person-values
meta ["test"] fn () {
    v ::at/build-person-values({email: "ada@example.com", first-name: "Ada", last-name: "Lovelace"})
    assert-eq("ada@example.com", first(v.email_addresses).email_address)
    assert-eq("Ada Lovelace", first(v.name).full_name)

    no-name ::at/build-person-values({email: "x@y.z"})
    assert-eq(["email_addresses"], keys(no-name), "only what was provided")
}

test-attio-first-name-only-keeps-last-name
meta ["test"] fn () {
    assert(::at/needs-existing-name({email: "a@b.c", first-name: "Ada"}), "one part given: look up the record")
    assert(not(::at/needs-existing-name({email: "a@b.c", first-name: "Ada", last-name: "L"})))
    assert(not(::at/needs-existing-name({email: "a@b.c"})))
    existing {id: "rec-9", first-name: "Augusta", last-name: "Lovelace", provider: "attio"}
    v ::at/build-person-values({email: "ada@example.com", first-name: "Ada"}, existing, null)
    n first(v.name)
    assert-eq("Ada", n.first_name)
    assert-eq("Lovelace", n.last_name, "the stored last name is kept, not blanked")
    assert-eq("Ada Lovelace", n.full_name)
    new-person ::at/build-person-values({email: "ada@example.com", first-name: "Ada"}, null, null)
    assert-eq("", first(new-person.name).last_name, "a new person has no last name to keep")
}

test-attio-person-company-and-phone
meta ["test"] fn () {
    v ::at/build-person-values({email: "ada@example.com", phone: "+15555550100"}, null, "co-1")
    assert-eq([{target_object: "companies", target_record_id: "co-1"}], v.company)
    assert-eq("+15555550100", first(v.phone_numbers).original_phone_number)
}

test-attio-company-values
meta ["test"] fn () {
    assert-eq({domains: [{domain: "acme.com"}]}, ::at/build-company-values({domain: "acme.com"}))
    assert-eq([{value: "Acme"}], ::at/build-company-values({domain: "acme.com", name: "Acme"}).name)
}

test-attio-deals
meta ["test"] fn () {
    v ::at/build-deal-values({name: "Acme expansion", stage: "In Progress", amount: 24000, company-id: "co-1", contact-id: "rec-9"}, "owner@acme.com")
    assert-eq([{value: "Acme expansion"}], v.name)
    assert-eq([{status: "In Progress"}], v.stage)
    assert-eq([{currency_value: 24000}], v.value)
    assert-eq([{workspace_member_email_address: "owner@acme.com"}], v.owner)
    assert-eq([{target_object: "companies", target_record_id: "co-1"}], v.associated_company)
    assert-eq([{target_object: "people", target_record_id: "rec-9"}], v.associated_people)
    assert-eq({stage: [{status: "Won"}]}, ::at/build-deal-values({stage: "Won"}, null), "a stage move writes only the stage")
    q ::at/build-deal-filter({name: "Acme expansion", company-id: "co-1"})
    assert-eq([{name: "Acme expansion"}, {associated_company: {target_object: "companies", target_record_id: "co-1"}}], get(q.filter, "$and"))
    assert(not(in("filter", keys(::at/build-deal-filter({})))), "no criteria, no filter")
    d ::at/normalize-deal({id: {record_id: "deal-1"}, values: {
        name: [{value: "Acme expansion"}],
        stage: [{status: {title: "In Progress"}}],
        value: [{currency_value: 24000}],
        associated_company: [{target_record_id: "co-1"}]
    }})
    assert-eq("In Progress", d.stage)
    assert-eq(24000, d.amount)
    assert-eq("co-1", d.company-id)
    assert(is-null(d.close-date))
}

test-attio-deal-needs-owner
meta ["test"] fn () {
    clear-ctx()
    assert(is-err(::at/create-deal({name: "x", stage: "Lead"})), "no owner: an Err before any request")
    assert(is-err(::at/create-deal({name: "x", owner: "o@acme.com"})), "no stage")
    clear-ctx()
}

test-attio-activities
meta ["test"] fn () {
    a ::at/normalize-activity({id: {note_id: "n-1"}, title: "Demo", content_plaintext: "went well", created_at: "2026-11-01T10:00:00Z"})
    assert-eq("n-1", a.id)
    assert-eq("Demo", a.subject)
    assert-eq("went well", a.body)
}
