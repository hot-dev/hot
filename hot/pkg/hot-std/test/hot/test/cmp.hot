::hot::test::cmp ns
meta ["test"]

test-cmp
meta ["test"] fn () {
    assert-eq ::hot::test/assert-eq
    assert ::hot::test/assert

    // Test eq function
    assert(eq(1, 1), "eq(1, 1) returns true")
    assert-eq(false, eq(1, 2), "eq(1, 2) returns false")
    assert(eq("hello", "hello"), "eq string equality")

    assert(ne(1, 2), "ne(1, 2) returns true")
    assert-eq(false, ne(1, 1), "ne(1, 1) returns false")
    assert(ne("hello", "world"), "ne(hello, world) returns true")

    // Test gt function
    assert-eq(false, gt(1, 2), "gt(1, 2) returns false")
    assert(gt(2, 1), "gt(2, 1) returns true")
    assert-eq(false, gt(1, 1), "gt(1, 1) returns false")
    // Test gte function
    assert(gte(1, 1), "gte(1, 1) returns true")
    assert(gte(2, 1), "gte(2, 1) returns true")
    assert-eq(false, gte(1, 2), "gte(1, 2) returns false")

    // Test lt function
    assert(lt(1, 2), "lt(1, 2) returns true")
    assert-eq(false, lt(2, 1), "lt(2, 1) returns false")
    assert-eq(false, lt(1, 1), "lt(1, 1) returns false")
    // Test lte function
    assert(lte(1, 1), "lte(1, 1) returns true")
    assert(lte(1, 2), "lte(1, 2) returns true")
    assert-eq(false, lte(2, 1), "lte(2, 1) returns false")
    assert-eq(false, lte(1, 0), "lte(1, 0) returns false")

}


test-between
meta ["test"] fn () {
    // Basic inclusive range checks
    assert(between(5, 1, 10), "between(5, 1, 10) is true")
    assert(between(1, 1, 10), "between: low bound inclusive")
    assert(between(10, 1, 10), "between: high bound inclusive")
    assert-eq(false, between(0, 1, 10), "between: below range")
    assert-eq(false, between(11, 1, 10), "between: above range")

    // Dec values
    assert(between(3.14, 3.0, 4.0), "between with decimals")
    assert-eq(false, between(2.99, 3.0, 4.0), "between: dec below range")

    // Negative ranges
    assert(between(-5, -10, 0), "between with negatives")
    assert-eq(false, between(-11, -10, 0), "between: negative below range")

    // Single point range
    assert(between(5, 5, 5), "between: x equals low equals high")
}


test-in
meta ["test"] fn () {
    // Basic membership
    assert(in(2, [1, 2, 3]), "in: element present")
    assert-eq(false, in(4, [1, 2, 3]), "in: element absent")

    // String elements
    assert(in("a", ["a", "b", "c"]), "in: string present")
    assert-eq(false, in("d", ["a", "b", "c"]), "in: string absent")

    // Empty collection
    assert-eq(false, in(1, []), "in: empty vec always false")

    // Mixed types
    assert(in(1, [1, "two", true]), "in: mixed type vec")
    assert(in(true, [1, "two", true]), "in: bool in mixed vec")
    assert-eq(false, in(null, [1, 2, 3]), "in: null not in int vec")
}


Money type Dec
Count type Int
Code type Str
Temperature enum { Celsius(Dec), Fahrenheit(Dec) }

// `Any` hides the type from the checker, as data from outside does.
gt-any fn (a: Any, b: Any): Any { gt(a, b) }
gte-any fn (a: Any, b: Any): Any { gte(a, b) }
lt-any fn (a: Any, b: Any): Any { lt(a, b) }
lte-any fn (a: Any, b: Any): Any { lte(a, b) }

test-named-dec-compares-as-its-number
meta ["test"] fn () {
    assert-eq ::hot::test/assert-eq

    assert-eq(false, gt-any(Money(80.0), 100), "80 is not above 100")
    assert-eq(true, lt-any(Money(80.0), 100), "80 is below 100")
    assert-eq(true, gt-any(Money(200.0), 100), "200 is above 100")
    assert-eq(false, lt-any(Money(200.0), 100), "200 is not below 100")
    assert-eq(false, gte-any(Money(80.0), 100), "80 is not at or above 100")
    assert-eq(true, lte-any(Money(80.0), 100), "80 is at or below 100")
    assert-eq(true, gt-any(100, Money(80.0)), "100 is above 80")
    assert-eq(true, gt-any(Money(200.0), Money(80.0)), "200 is above 80, unlike as text")
    assert-eq(true, gte-any(Money(80.0), 80), "80 is at 80")
    assert-eq(true, lte-any(Money(80.0), 80), "80 is at 80")
    assert-eq(false, gt(Money(80.0), 100), "no helper needed to reach it")
}

test-named-int-compares-as-its-number
meta ["test"] fn () {
    assert-eq ::hot::test/assert-eq

    assert-eq(false, gt-any(Count(80), 100), "80 is not above 100")
    assert-eq(true, lt-any(Count(80), 100), "80 is below 100")
    assert-eq(true, gt-any(Count(200), 100), "200 is above 100")
    assert-eq(false, lt-any(Count(200), 100), "200 is not below 100")
    assert-eq(false, gte-any(Count(80), 100), "80 is not at or above 100")
    assert-eq(true, lte-any(Count(80), 100), "80 is at or below 100")
    assert-eq(true, gt-any(100, Count(80)), "100 is above 80")
    assert-eq(true, gt-any(Count(200), Count(80)), "200 is above 80, unlike as text")
    assert-eq(false, gt(Count(80), 100), "no helper needed to reach it")
}

test-named-number-decides-a-branch
meta ["test"] fn () {
    assert-eq ::hot::test/assert-eq

    assert-eq("over", if(gt-any(Money(200.0), 100), "over", "within"), "if takes the over arm")
    assert-eq("within", if(gt-any(Money(80.0), 100), "over", "within"), "if takes the within arm")
    assert-eq(true, between(Money(80.0), 1, 100), "between reads the number")
    assert-eq(false, between(Count(200), 1, 100), "between reads the number")
    assert-eq(1, length(filter([Money(80.0), Money(200.0)], gt(%, 100))), "filter keeps the one over")
}

test-comparison-with-no-order-is-an-err
meta ["test"] fn () {
    assert ::hot::test/assert

    assert(is-err(gt-any(Money(80.0), null)), "a named number and null")
    assert(is-err(lt-any(null, Count(80))), "null and a named number")
    assert(is-err(gt-any(Money(80.0), "100")), "a named number and a string")
    assert(is-err(gt-any(null, 1)), "null and a number")
    assert(is-err(lte-any("b", 1)), "a string and a number")
    assert(is-err(gte-any([10], [9])), "two vectors")
    assert(is-err(lt-any({a: 1}, {a: 2})), "two maps")
    assert(is-err(gt-any(Temperature.Celsius(30.0), Temperature.Fahrenheit(80.0))), "a variant is a case, not a number")
}

test-strings-keep-their-order
meta ["test"] fn () {
    assert-eq ::hot::test/assert-eq

    assert-eq(true, gt-any("b", "a"), "strings order as before")
    assert-eq(true, lt-any(Code("a"), Code("b")), "a named string reads as its string")
}

test-sort-agrees-with-lt
meta ["test"] fn () {
    assert-eq ::hot::test/assert-eq

    shown map(sort([Money(200), Money(80.5), Money(100.0)]), (value) { Str(untype(value)) })
    assert-eq(["80.5", "100.0", "200"], shown, "by number, whichever kind holds it")

    mixed map(sort([Money(200.0), 100, Money(80.0), 90.5]), (value) { Str(untype(value)) })
    assert-eq(["80.0", "90.5", "100", "200.0"], mixed, "named among plain numbers")

    assert-eq([[1.5], [2]], sort([[2], [1.5]]), "numbers inside other values")
}
