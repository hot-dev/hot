::whatsapp::business ns
meta {
    doc: """Business profile and phone number information."""
}

::api ::whatsapp::api

// ============================================================================
// Business Profile
// ============================================================================

get-business-profile
meta {
    doc: """
Get the WhatsApp Business Profile for a phone number. Returns about text, address, description, email, websites, and profile picture URL.

**Example**

```hot
::business ::whatsapp::business

response ::business/get-business-profile("109876543210")
response.data[0].about        // => "Hot Dev official support"
response.data[0].description  // => "We build tools for developers"
```
"""
}
fn
(phone-number-id: Str?): Map {
  get-business-profile(phone-number-id, {})
},
(phone-number-id: Str?, opts: Map): Map {
  ::api/with-phone-number(phone-number-id, opts, (id) {
    ::api/request("GET", ::api/url(`${id}/whatsapp_business_profile?fields=about,address,description,email,profile_picture_url,websites,vertical`, opts), opts)
  })
}

UpdateBusinessProfileRequest type {
  phone_number_id: Str?,
  about: Str?,
  address: Str?,
  description: Str?,
  email: Str?,
  websites: Vec<Str>?,
  vertical: Str?,
  profile_picture_handle: Str?
}

update-business-profile
meta {
    doc: """
Update the WhatsApp Business Profile. All fields are optional -- only provided fields are updated.

`vertical` is the business category: "OTHER", "AUTO", "BEAUTY", "APPAREL", "EDU", "ENTERTAIN", "EVENT_PLAN", "FINANCE", "GROCERY", "GOVT", "HOTEL", "HEALTH", "NONPROFIT", "PROF_SERVICES", "RETAIL", "TRAVEL", "RESTAURANT", "ALCOHOL", "ONLINE_GAMBLING", "PHYSICAL_GAMBLING", "OTC_DRUGS". `about` is max 139 characters, `description` max 512, `websites` max 2. `profile_picture_handle` is an upload handle from Meta's Resumable Upload API (not a media id).

**Example**

```hot
::business ::whatsapp::business

::business/update-business-profile(::business/UpdateBusinessProfileRequest({
  phone_number_id: "109876543210",
  about: "Hot Dev - Build faster",
  description: "We build tools for developers",
  websites: ["https://hot.dev"]
}))
```
"""
}
fn
(request: UpdateBusinessProfileRequest): Map {
  update-business-profile(request, {})
},
(request: UpdateBusinessProfileRequest, opts: Map): Map {
  body {messaging_product: "whatsapp"}
    |> assoc-some("about", request.about)
    |> assoc-some("address", request.address)
    |> assoc-some("description", request.description)
    |> assoc-some("email", request.email)
    |> assoc-some("websites", request.websites)
    |> assoc-some("vertical", request.vertical)
    |> assoc-some("profile_picture_handle", request.profile_picture_handle)

  ::api/with-phone-number(request.phone_number_id, opts, (id) {
    ::api/request("POST", ::api/url(`${id}/whatsapp_business_profile`, opts), {}, body, opts)
  })
}

// ============================================================================
// Phone Numbers
// ============================================================================

get-phone-number
meta {
    doc: """
Get information about a specific phone number. Returns the display phone number, verified name, quality rating, and status.

**Example**

```hot
::business ::whatsapp::business

response ::business/get-phone-number("109876543210")
response.display_phone_number // => "+1 555 123 4567"
response.verified_name        // => "Hot Dev"
response.quality_rating       // => "GREEN"
```
"""
}
fn
(phone-number-id: Str?): Map {
  get-phone-number(phone-number-id, {})
},
(phone-number-id: Str?, opts: Map): Map {
  ::api/with-phone-number(phone-number-id, opts, (id) {
    ::api/request("GET", ::api/url(`${id}?fields=display_phone_number,verified_name,quality_rating,platform_type,status,name_status,code_verification_status`, opts), opts)
  })
}

ListPhoneNumbersRequest type {
  waba_id: Str
}

list-phone-numbers
meta {
    doc: """
    GET /{waba-id}/phone_numbers - List the phone numbers registered to a
    WhatsApp Business Account (`data: [{id, display_phone_number,
    verified_name, quality_rating, status}]`). The `id` is the
    `phone_number_id` the send functions take.

    **Example**

    ```hot
    ::business ::whatsapp::business

    numbers ::business/list-phone-numbers(::business/ListPhoneNumbersRequest({waba_id: "102938475610"}))
    map(numbers.data, %.display_phone_number)
    ```
    """
}
fn
(request: ListPhoneNumbersRequest): Map {
  list-phone-numbers(request, {})
},
(request: ListPhoneNumbersRequest, opts: Map): Map {
  ::api/request("GET", ::api/url(`${::api/segment(request.waba_id)}/phone_numbers?fields=display_phone_number,verified_name,quality_rating,status`, opts), opts)
}
