::twilio::messages ns

::uri ::hot::uri

api-request ::twilio::api/request
account-url ::twilio::api/account-url
resolve ::twilio::api/resolve
Client ::twilio::api/Client
HttpError ::twilio::api/HttpError
is-ok-response ::hot::http/is-ok-response

// ============================================================================
// Send Messages (SMS / MMS / WhatsApp / RCS)
// ============================================================================

CreateMessageRequest
meta {
    doc: """
    Parameters of POST /Messages.json. `To` is required, plus a sender
    (`From` or `MessagingServiceSid`) and content (`Body`, `MediaUrl`, or
    `ContentSid`). `MediaUrl` takes up to 10 public URLs and is sent as
    repeated parameters. Booleans are sent as `true`/`false`.
    """
}
type {
  To: Str,
  From: Str?,
  MessagingServiceSid: Str?,
  Body: Str?,
  MediaUrl: Vec<Str>?,
  ContentSid: Str?,
  ContentVariables: Str?,
  StatusCallback: Str?,
  ApplicationSid: Str?,
  ValidityPeriod: Int?,
  SendAt: Str?,
  ScheduleType: Str?,
  SendAsMms: Bool?,
  ShortenUrls: Bool?,
  SmartEncoded: Bool?,
  ProvideFeedback: Bool?,
  Attempt: Int?,
  PersistentAction: Vec<Str>?,
  FallbackFrom: Str?,
  MessageIntent: Str?,
  RiskCheck: Str?
}

Message
meta {
    doc: """A Message resource. `error_code`/`error_message` are set when delivery failed."""
}
type {
  sid: Str?,
  account_sid: Str?,
  messaging_service_sid: Str?,
  to: Str?,
  from: Str?,
  body: Str?,
  status: Str?,
  num_segments: Str?,
  num_media: Str?,
  direction: Str?,
  price: Str?,
  price_unit: Str?,
  error_code: Int?,
  error_message: Str?,
  api_version: Str?,
  uri: Str?,
  subresource_uris: Map?,
  date_created: Str?,
  date_updated: Str?,
  date_sent: Str?
}

create-message-body
meta {
    doc: """The form parameters `create-message` sends: every set field of the request, unset ones omitted. Exposed for testing."""
}
fn (request: CreateMessageRequest): Map {
  filter-vals(untype(request), is-some)
}

create-message
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}, "twilio.auth.token": {required: false}},
    doc: """
POST /Accounts/{AccountSid}/Messages.json - Send an SMS, MMS, WhatsApp, or RCS message.

Provide `From` (your Twilio number or sender) or `MessagingServiceSid`. For MMS, include `MediaUrl`. For WhatsApp, prefix numbers with `whatsapp:` (e.g. `whatsapp:+15551234567`). Pass a `Client` first to send from another account.

**Example: Send SMS**

```hot
::messages ::twilio::messages

response ::messages/create-message(::messages/CreateMessageRequest({
  To: "+15558675310",
  From: "+15017122661",
  Body: "Hello from Hot!"
}))
response.sid     // => "SM..."
response.status  // => "queued"
```

**Example: Send MMS**

```hot
::messages ::twilio::messages

response ::messages/create-message(::messages/CreateMessageRequest({
  To: "+15558675310",
  From: "+15017122661",
  Body: "Check out this image!",
  MediaUrl: ["https://example.com/image.jpg"]
}))
```

**Example: Send WhatsApp**

```hot
::messages ::twilio::messages

response ::messages/create-message(::messages/CreateMessageRequest({
  To: "whatsapp:+15558675310",
  From: "whatsapp:+15017122661",
  Body: "Hello from Hot via WhatsApp!"
}))
```
"""
}
fn
(request: CreateMessageRequest): Message {
  create-message(request, {})
},
(request: CreateMessageRequest, opts: Map): Message {
  resolve(opts) |> if-ok((client) { create-message(client, request) })
},
(client: Client, request: CreateMessageRequest): Message {
  response api-request(client, "POST", `${account-url(client)}/Messages.json`, {}, create-message-body(request))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { Message(response.body) }
    => { err(HttpError(response)) }
  }
}

GetMessageRequest type {
  sid: Str
}

get-message
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
GET /Accounts/{AccountSid}/Messages/{Sid}.json - Get details of a specific message by SID. Returns delivery status, price, error info, and timestamps.

**Example**

```hot
::messages ::twilio::messages

response ::messages/get-message(::messages/GetMessageRequest({
  sid: "SM1234567890abcdef1234567890abcdef"
}))
response.status  // => "delivered"
response.price   // => "-0.0075"
```
"""
}
fn
(request: GetMessageRequest): Message {
  get-message(request, {})
},
(request: GetMessageRequest, opts: Map): Message {
  resolve(opts) |> if-ok((client) { get-message(client, request) })
},
(client: Client, request: GetMessageRequest): Message {
  response api-request(client, "GET", `${account-url(client)}/Messages/${::uri/encode(request.sid)}.json`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { Message(response.body) }
    => { err(HttpError(response)) }
  }
}

ListMessagesRequest
meta {
    doc: """
    Filters for GET /Messages.json. `DateSent` matches one day
    (`YYYY-MM-DD`); `DateSentBefore`/`DateSentAfter` send Twilio's
    inclusive `DateSent<`/`DateSent>` range filters. `PageToken` comes from
    a previous page; prefer `::twilio::api/next-page` or
    `list-all-messages` to page.
    """
}
type {
  To: Str?,
  From: Str?,
  DateSent: Str?,
  DateSentBefore: Str?,
  DateSentAfter: Str?,
  PageSize: Int?,
  Page: Int?,
  PageToken: Str?
}

ListMessagesResponse type {
  messages: Vec<Map>?,
  end: Int?,
  first_page_uri: Str?,
  next_page_uri: Str?,
  page: Int?,
  page_size: Int?,
  previous_page_uri: Str?,
  start: Int?,
  uri: Str?
}

list-messages-query
meta {
    doc: """The query string `list-messages` sends. Exposed for testing."""
}
fn (request: ListMessagesRequest): Str {
  ::twilio::api/query-string({
    To: request.To,
    From: request.From,
    DateSent: request.DateSent,
    "DateSent<": request.DateSentBefore,
    "DateSent>": request.DateSentAfter,
    PageSize: request.PageSize,
    Page: request.Page,
    PageToken: request.PageToken
  })
}

list-messages
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
GET /Accounts/{AccountSid}/Messages.json - List messages, newest first. Filter by `To`, `From`, or send date. Returns one page; follow `next_page_uri` with `::twilio::api/next-page`, or use `list-all-messages`.

**Example**

```hot
::messages ::twilio::messages

response ::messages/list-messages(::messages/ListMessagesRequest({
  PageSize: 20
}))
response.messages  // => [{sid: "SM...", body: "Hello", status: "delivered", ...}, ...]
```
"""
}
fn
(request: ListMessagesRequest): ListMessagesResponse {
  list-messages(request, {})
},
(request: ListMessagesRequest, opts: Map): ListMessagesResponse {
  resolve(opts) |> if-ok((client) { list-messages(client, request) })
},
(client: Client, request: ListMessagesRequest): ListMessagesResponse {
  response api-request(client, "GET", `${account-url(client)}/Messages.json${list-messages-query(request)}`, {}, {})
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ListMessagesResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

list-all-messages
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """
Collect up to `limit` messages matching `request`, following Twilio's page links (PageToken) as needed.

**Example**

```hot
::messages ::twilio::messages

recent ::messages/list-all-messages(::messages/ListMessagesRequest({To: "+15558675310", PageSize: 100}), 250)
length(recent)  // => up to 250
```
"""
}
fn
(request: ListMessagesRequest, limit: Int): Vec<Map> {
  list-all-messages(request, limit, {})
},
(request: ListMessagesRequest, limit: Int, opts: Map): Vec<Map> {
  resolve(opts) |> if-ok((client) { list-all-messages(client, request, limit) })
},
(client: Client, request: ListMessagesRequest, limit: Int): Vec<Map> {
  if-ok(list-messages(client, request), (page) { ::twilio::api/collect-pages(client, untype(page), "messages", limit) })
}

UpdateMessageRequest type {
  sid: Str,
  Body: Str?,
  Status: Str?
}

update-message
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """POST /Accounts/{AccountSid}/Messages/{Sid}.json - Update a message. Set `Body: ""` to redact message content. Set `Status: "canceled"` to cancel a scheduled message."""
}
fn
(request: UpdateMessageRequest): Message {
  update-message(request, {})
},
(request: UpdateMessageRequest, opts: Map): Message {
  resolve(opts) |> if-ok((client) { update-message(client, request) })
},
(client: Client, request: UpdateMessageRequest): Message {
  body {
    Body: request.Body,
    Status: request.Status
  }

  response api-request(client, "POST", `${account-url(client)}/Messages/${::uri/encode(request.sid)}.json`, {}, body)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { Message(response.body) }
    => { err(HttpError(response)) }
  }
}

DeleteMessageRequest type {
  sid: Str
}

delete-message
meta {
    ctx: {"twilio.account.sid": {required: false, secret: false}},
    doc: """DELETE /Accounts/{AccountSid}/Messages/{Sid}.json - Delete a message record. The message content is permanently removed."""
}
fn
(request: DeleteMessageRequest): Bool {
  delete-message(request, {})
},
(request: DeleteMessageRequest, opts: Map): Bool {
  resolve(opts) |> if-ok((client) { delete-message(client, request) })
},
(client: Client, request: DeleteMessageRequest): Bool {
  ::twilio::api/delete-request(client, `${account-url(client)}/Messages/${::uri/encode(request.sid)}.json`)
}

