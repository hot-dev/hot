::qwen::integration::ctx ns

::env ::hot::env

// Credentials for the qwen integration suite. Unset environment variables
// are skipped entirely, so absent credentials behave exactly as if never
// configured (and every test skips). DashScope calls the API key
// DASHSCOPE_API_KEY. QWEN_REGION (intl, us, cn, hk, eu, jp) must match the
// region the key was created in; QWEN_WORKSPACE_ID selects the workspace
// domain; QWEN_BASE_URL overrides both.
::hot::ctx/set(filter-vals({
    "qwen.api.key": ::env/get("DASHSCOPE_API_KEY", ""),
    "qwen.region": ::env/get("QWEN_REGION", ""),
    "qwen.workspace.id": ::env/get("QWEN_WORKSPACE_ID", ""),
    "qwen.base.url": ::env/get("QWEN_BASE_URL", ""),
}, (v) { not(is-empty(v)) }))
