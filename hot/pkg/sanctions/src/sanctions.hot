::sanctions ns
meta {
    doc: """
    Sanctions screening against the official, free lists: US OFAC (SDN
    and Consolidated), the UK Sanctions List, the EU Consolidated
    Financial Sanctions List and the UN Security Council Consolidated
    List, plus an optional bring-your-own-key OpenSanctions backend.

    **Never an automatic decision.** `screen` returns
    `"possible-match"` or `"no-match"` with scored, explained matches.
    A person must review every possible match before acting on it.

    **Setup**: the lists are downloaded, parsed and indexed into
    `::hot::store` by `::sanctions::cache/refresh-lists`, which should
    run from a daily schedule. Screening reads only that cache.

    - `::sanctions::cache` refreshes and inspects the cache
    - `::sanctions::screen` holds the scoring and the result types
    - `::sanctions::ofac`, `::sanctions::uk`, `::sanctions::eu`,
      `::sanctions::un` parse each list into `Entry` records
    - `::sanctions::text` and `::sanctions::similarity` normalize names
      and compare them
    - `::sanctions::opensanctions` calls the OpenSanctions `/match` API

    **Quick start**

    ```hot
    // Once, and then daily from a schedule (EU needs http.max-response-bytes >= 32 MiB)
    ::sanctions::cache/refresh-lists()

    result ::sanctions/screen("Ayman al-Zawahiri", {dob: "1951", kind: "individual"})
    result.status            // "possible-match"
    result.matches[0].score  // e.g. 0.98
    result.matches[0].explanation
    ```
    """
}

::screen ::sanctions::screen
::cache ::sanctions::cache
::store ::hot::store

ScreenResult ::sanctions::screen/ScreenResult

screen
meta {
    doc: """
    Screen one name against the cached lists.

    **Options**
    - `dob` — date of birth or year (`"1951-06-19"`, `"1951"`), individuals
    - `country` — nationality or country, as an ISO code or a name
    - `kind` — `"individual"`, `"entity"`, `"vessel"`, `"aircraft"`, or a
      Vec of them; other kinds are skipped
    - `threshold` — minimum score, default 0.85
    - `sources` — lists to search: any of `"ofac-sdn"`, `"ofac-cons"`,
      `"uk"`, `"eu"`, `"un"` (default all)
    - `limit` — most matches returned, default 10
    - `max-candidates` — candidates scored per list, default 50
    - `allow-missing` — true to skip lists that were never refreshed
      instead of failing
    - `store` — the cache store name (default from `sanctions.store`)

    Returns a `::sanctions::screen/ScreenResult`. It fails when a
    requested list has never been refreshed, so an empty cache can't
    pass as `"no-match"`.

    **Example**

    ```hot
    r ::sanctions/screen("Banco Nacional de Cuba", {kind: "entity", sources: ["ofac-sdn"]})
    r.status
    ```
    """
}
fn
(name: Str): ScreenResult {
  screen(name, {})
},
(name: Str, opts: Map): ScreenResult {
  opened ::cache/open-sources(opts)
  cond {
    is-err(opened) => { opened }
    => {
      query ::screen/query-of(name, opts)
      max-c or(get(opts, "max-candidates"), ::screen/DEFAULT_MAX_CANDIDATES)
      records mapcat(opened.lists, (l) {
        data ::store/Map({name: l.store})
        ::screen/candidates-for(query, (b) { ::store/get(data, b) }, (k) { ::store/get(data, k) }, max-c)
      })
      ::screen/result(query, records, opts, opened.sources, opened.warnings)
    }
  }
}
