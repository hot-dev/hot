::hot::base64 ns
meta {doc: """Base64 encoding and decoding functions."""}

encode
meta {
    doc: """
    Encode `data` to a base64 string. A `Str` is encoded as its UTF-8 bytes.

    **Example**

    ```hot
    ::hot::base64/encode("Hello")  // "SGVsbG8="
    ::hot::base64/encode(Bytes([72, 101, 108, 108, 111]))  // "SGVsbG8=" ("Hello" as bytes)
    ```
    """
}
fn (data: Str | Bytes): Str {
    call-lib(::hot::base64/encode, [data])
}


decode
meta {
    doc: """
    Decode `s` base64 string to a byte array.

    **Example**

    ```hot
    encoded "SGVsbG8="
    bytes ::hot::base64/decode(encoded)
    // bytes = Bytes([72, 101, 108, 108, 111])
    ```
    """
}
fn (s: Str): Bytes {
    call-lib(::hot::base64/decode, [s])
}


is-valid
meta {
    doc: """
    Check if string `s` is valid base64.

    **Example**

    ```hot
    ::hot::base64/is-valid("SGVsbG8=")   // true
    ::hot::base64/is-valid("not valid!") // false
    ```
    """
}
fn (s: Str): Bool {
    call-lib(::hot::base64/is-valid, [s])
}


encode-url
meta {
    doc: """
    Encode `data` to URL-safe base64 string (no padding).
    Uses `-` and `_` instead of `+` and `/`. Safe for URLs and filenames.
    A `Str` is encoded as its UTF-8 bytes.

    **Example**

    ```hot
    ::hot::base64/encode-url("Hello+World/Test")
    // "SGVsbG8rV29ybGQvVGVzdA"  (no = padding, - and _ chars)
    ```
    """
}
fn (data: Str | Bytes): Str {
    call-lib(::hot::base64/encode-url, [data])
}


decode-url
meta {
    doc: """
    Decode URL-safe base64 string (with or without padding) to bytes.

    **Example**

    ```hot
    ::hot::base64/decode-url("SGVsbG8")
    // Bytes([72, 101, 108, 108, 111])
    ```
    """
}
fn (s: Str): Bytes {
    call-lib(::hot::base64/decode-url, [s])
}
