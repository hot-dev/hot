::hot::pkg ns

hot.pkg.openai-compatible {
  name: "hot.dev/openai-compatible",
  version: "0.1.0",
  hot-min-version: "3.0.0",
  description: "Presets for OpenAI-compatible APIs built on hot.dev/openai: Ollama, vLLM, LM Studio, Groq, OpenRouter, DeepSeek, Together, Fireworks, Mistral, Cerebras, Perplexity, or any custom gateway. Returns hot-ai providers for the run loop, plus chat (with streaming), models and embeddings helpers.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["ai", "llm", "openai", "ollama", "openrouter"],
  deps: {
    "hot.dev/openai": "1.3.0",
    "hot.dev/hot-ai": "1.8.1"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
