// ============================================================================
// Invites
// ============================================================================

CreateChatInviteLinkRequest type {
  chat_id: Any,
  name: Str?,
  expire_date: Int?,
  member_limit: Int?,
  creates_join_request: Bool?
}

create-chat-invite-link
meta {
    doc: """
    createChatInviteLink - Create an additional invite link. `member_limit`
    (1-99999) limits joins. `expire_date` is a Unix timestamp. Set
    `creates_join_request: true` to require admin approval.

    **Example**

    ```hot
    ::chat ::telegram::chat

    invite ::chat/create-chat-invite-link(::chat/CreateChatInviteLinkRequest({
      chat_id: -1001234567890,
      name: "Beta testers",
      member_limit: 25
    }))
    invite.invite_link
    ```
    """
}
fn
(request: CreateChatInviteLinkRequest): Map {
  create-chat-invite-link(request, {})
},
(request: CreateChatInviteLinkRequest, opts: Map): Map {
  api-request("createChatInviteLink", untype(request), opts)
}

RevokeChatInviteLinkRequest type {
  chat_id: Any,
  invite_link: Str
}

revoke-chat-invite-link
meta {
    doc: """
    revokeChatInviteLink - Revoke an invite link created by the bot. The
    link will no longer work.

    **Example**

    ```hot
    ::chat ::telegram::chat

    ::chat/revoke-chat-invite-link(::chat/RevokeChatInviteLinkRequest({
      chat_id: -1001234567890,
      invite_link: "https://t.me/+AbCdEf123456"
    }))
    ```
    """
}
fn
(request: RevokeChatInviteLinkRequest): Map {
  revoke-chat-invite-link(request, {})
},
(request: RevokeChatInviteLinkRequest, opts: Map): Map {
  api-request("revokeChatInviteLink", untype(request), opts)
}

