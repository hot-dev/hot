::github::users ns

::api ::github::api

get-authenticated
meta {
    doc: """
    GET /user - The authenticated user (login, id, plan). The cheapest way
    to smoke-test a token.

    **Example**

    ```hot
    me ::github::users/get-authenticated()
    me.login
    ```
    """
}
fn
(): Map {
  get-authenticated({})
},
(opts: Map): Map {
  ::api/json("GET", "/user", {}, "", opts)
}

get-user
meta {
    doc: """
    GET /users/{username} - A user's public profile.

    **Example**

    ```hot
    user ::github::users/get-user("octocat")
    user.public_repos
    ```
    """
}
fn
(username: Str): Map {
  get-user(username, {})
},
(username: Str, opts: Map): Map {
  ::api/json("GET", `/users/${username}`, {}, "", opts)
}
