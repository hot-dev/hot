::supabase::core ns

::ctx ::hot::ctx
::env ::hot::env

secret-value fn (value: Any): Str? {
  s Str(or(value, ""))
  if(is-empty(s), null, s)
}

first-secret fn (values: Vec<Any>): Str? {
  values
    |> map(secret-value(%))
    |> filter(is-some(%))
    |> first()
}

required-secret fn (values: Vec<Any>, label: Str, sources: Str): Str {
  value first-secret(values)
  if(is-empty(value),
    fail(`${label} is not set. Add one of: ${sources}.`)
  )
  value
}

sources-from
meta {
    doc: """
    The values every Supabase call starts from, without per-call options
    (pure), from `values`, a Map of context and environment variables by
    name. The precedence is:

    - URL: `supabase.url`, `SUPABASE_URL`
    - anon key: `supabase.anon.key`, `supabase.api.key`,
      `SUPABASE_ANON_KEY`, `SUPABASE_API_KEY`
    - service key: `supabase.service.key`, `supabase.service.role.key`,
      `SUPABASE_SERVICE_KEY`, `SUPABASE_SERVICE_ROLE_KEY`

    Returns `{url, anon-key, service-key}`, each null when unset.
    """
}
fn (values: Map): Map {
  {
    url: first-secret([get(values, "supabase.url"), get(values, "SUPABASE_URL")]),
    anon-key: first-secret([
      get(values, "supabase.anon.key"),
      get(values, "supabase.api.key"),
      get(values, "SUPABASE_ANON_KEY"),
      get(values, "SUPABASE_API_KEY")
    ]),
    service-key: first-secret([
      get(values, "supabase.service.key"),
      get(values, "supabase.service.role.key"),
      get(values, "SUPABASE_SERVICE_KEY"),
      get(values, "SUPABASE_SERVICE_ROLE_KEY")
    ])
  }
}

sources
meta {
    ctx: {
        "supabase.url": {required: false, secret: false},
        "supabase.anon.key": {required: false},
        "supabase.api.key": {required: false},
        "supabase.service.key": {required: false},
        "supabase.service.role.key": {required: false}
    },
    doc: """The live context and environment values, by `sources-from`."""
}
fn (): Map {
  sources-from({
    "supabase.url": ::ctx/get("supabase.url"),
    "supabase.anon.key": ::ctx/get("supabase.anon.key"),
    "supabase.api.key": ::ctx/get("supabase.api.key"),
    "supabase.service.key": ::ctx/get("supabase.service.key"),
    "supabase.service.role.key": ::ctx/get("supabase.service.role.key"),
    "SUPABASE_URL": ::env/get("SUPABASE_URL", ""),
    "SUPABASE_ANON_KEY": ::env/get("SUPABASE_ANON_KEY", ""),
    "SUPABASE_API_KEY": ::env/get("SUPABASE_API_KEY", ""),
    "SUPABASE_SERVICE_KEY": ::env/get("SUPABASE_SERVICE_KEY", ""),
    "SUPABASE_SERVICE_ROLE_KEY": ::env/get("SUPABASE_SERVICE_ROLE_KEY", "")
  })
}

project-url
meta {
    ctx: {"supabase.url": {required: false, secret: false}},
    doc: """Return the Supabase project URL from context. Example: `https://xxxx.supabase.co`."""
}
fn (): Str {
  required-secret([
    ::ctx/get("supabase.url"),
    ::env/get("SUPABASE_URL", "")
  ], "supabase.url", "supabase.url or SUPABASE_URL")
}

anon-key
meta {
    ctx: {"supabase.anon.key": {required: false}},
    doc: """Return the Supabase anon/public key from context."""
}
fn (): Str {
  required-secret([
    ::ctx/get("supabase.anon.key"),
    ::ctx/get("supabase.api.key"),
    ::env/get("SUPABASE_ANON_KEY", ""),
    ::env/get("SUPABASE_API_KEY", "")
  ], "supabase.anon.key", "supabase.anon.key, supabase.api.key, SUPABASE_ANON_KEY, or SUPABASE_API_KEY")
}

service-key
meta {
    ctx: {"supabase.service.key": {required: false}},
    doc: """Return the Supabase service role key from context. Required for admin operations."""
}
fn (): Str {
  key first-secret([
    ::ctx/get("supabase.service.key"),
    ::ctx/get("supabase.service.role.key"),
    ::env/get("SUPABASE_SERVICE_KEY", ""),
    ::env/get("SUPABASE_SERVICE_ROLE_KEY", "")
  ])
  if(is-empty(key),
    fail("supabase.service.key is not set. Add one of: supabase.service.key, supabase.service.role.key, SUPABASE_SERVICE_KEY, or SUPABASE_SERVICE_ROLE_KEY.")
  )
  key
}
