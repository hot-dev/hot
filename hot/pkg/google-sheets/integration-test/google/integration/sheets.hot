::google::integration::sheets ns
meta ["test"]

// Live Sheets roundtrip. Requires GOOGLE_SERVICE_ACCOUNT (set
// GOOGLE_IMPERSONATE too for domain-wide delegation). Self-cleaning: the
// spreadsheet it creates is deleted with a direct Drive REST call through
// google-core, so this suite needs no google-drive dependency.

::values ::google::sheets::values
::books ::google::sheets::spreadsheets

delete-spreadsheet fn (id: Str): Any {
  ::google::api/json("drive.file", "DELETE", `https://www.googleapis.com/drive/v3/files/${::hot::uri/encode(id)}?supportsAllDrives=true`, {}, "")
}

test-spreadsheet-roundtrip
meta ["test"] fn () {
    if(is-empty(::hot::env/get("GOOGLE_SERVICE_ACCOUNT", "")),
        fail("Set GOOGLE_SERVICE_ACCOUNT in .env")
    )

    book ::books/create-spreadsheet(`hot-it-${Uuid()}`, {sheets: ["Data"]})
    assert(not(is-err(book)), `create-spreadsheet: ${if-err(book, (e) { err-message(e) })}`)
    id book.spreadsheetId

    written ::values/write-records(id, "Data!A1", [{name: "alpha", n: 1}, {name: "beta", n: 2}], ["name", "n"])
    assert(not(is-err(written)), `write-records: ${if-err(written, (e) { err-message(e) })}`)

    records ::values/read-records(id, "Data!A:B")
    assert-eq([{name: "alpha", n: 1}, {name: "beta", n: 2}], records, "records read back")

    appended ::values/append-records(id, "Data!A:B", [{name: "gamma", n: 3}], ["name", "n"])
    assert(not(is-err(appended)), `append-records: ${if-err(appended, (e) { err-message(e) })}`)
    assert-eq(3, length(::values/read-records(id, "Data!A:B")), "append adds a row")

    sheet-id ::books/sheet-id(id, "Data")
    formatted ::books/format-header(id, sheet-id)
    assert(not(is-err(formatted)), `format-header: ${if-err(formatted, (e) { err-message(e) })}`)

    cleaned delete-spreadsheet(id)
    assert(not(is-err(cleaned)), "cleanup should succeed")
}
