::openai::deactivate ns

api-request ::openai::api/request
HttpError ::openai::api/HttpError
is-ok-response ::hot::http/is-ok-response

ToggleCertificatesRequest type {
    certificate_ids: Vec<Str>
}

CertificateObjectType type open "certificate" | "organization.certificate" | "organization.project.certificate"

Certificate type {
    object: CertificateObjectType,
    id: Str,
    name: Str?,
    created_at: Int,
    certificate_details: Map,
    active: Bool?
}

ListCertificatesResponse type {
    data: Vec<Certificate>,
    first_id: Str?,
    last_id: Str?,
    has_more: Bool,
    object: "list"
}

DeactivateOrganizationCertificatesRequest type {
    certificate_ids: Vec<Str>
}

DeactivateOrganizationCertificatesResponse type {
    data: Vec<Certificate>,
    first_id: Str?,
    last_id: Str?,
    has_more: Bool,
    object: "list"
}


deactivate-certificates-organization
meta {
    doc: """
    POST /organization/certificates/deactivate - Deactivate certificates for
    organization

    **Example**

    ```hot
    result ::openai::deactivate/deactivate-certificates-organization(::openai::deactivate/DeactivateOrganizationCertificatesRequest({
      certificate_ids: ["cert_abc123"]
    }))
    map(result.data, %.active)
    ```
    """
}
fn
(request: DeactivateOrganizationCertificatesRequest): DeactivateOrganizationCertificatesResponse {
  deactivate-certificates-organization(request, {})
},
(request: DeactivateOrganizationCertificatesRequest, opts: Map): DeactivateOrganizationCertificatesResponse {
  response api-request("POST", "/organization/certificates/deactivate", {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { DeactivateOrganizationCertificatesResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

DeactivateProjectCertificatesRequest type {
    certificate_ids: Vec<Str>
}

DeactivateProjectCertificatesResponse type {
    data: Vec<Certificate>,
    first_id: Str?,
    last_id: Str?,
    has_more: Bool,
    object: "list"
}


deactivate-certificates-project
meta {
    doc: """
    POST /organization/projects/{project_id}/certificates/deactivate -
    Deactivate certificates for project

    **Example**

    ```hot
    result ::openai::deactivate/deactivate-certificates-project("proj_abc123", ::openai::deactivate/DeactivateProjectCertificatesRequest({
      certificate_ids: ["cert_abc123"]
    }))
    map(result.data, %.id)
    ```
    """
}
fn
(project-id: Str, request: DeactivateProjectCertificatesRequest): DeactivateProjectCertificatesResponse {
  deactivate-certificates-project(project-id, request, {})
},
(project-id: Str, request: DeactivateProjectCertificatesRequest, opts: Map): DeactivateProjectCertificatesResponse {
  response api-request("POST", `/organization/projects/${project-id}/certificates/deactivate`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { DeactivateProjectCertificatesResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
