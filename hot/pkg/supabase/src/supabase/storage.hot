ListObjectsRequest type {
  bucket: Str,
  prefix: Str?,
  limit: Int?,
  offset: Int?,
  search: Str?,
  sort_by: Map?
}

list-objects
meta {
    doc: """
List objects in a bucket. Filter by `prefix` (folder path), `search` (filename pattern). `sort_by` is `{column: "name", order: "asc"}`.

**Example**

```hot
::storage ::supabase::storage

objects ::storage/list-objects(::storage/ListObjectsRequest({
  bucket: "avatars",
  prefix: "users/",
  limit: 100
}))
// => [{name: "alice.jpg", id: "...", metadata: {...}}, ...]
```
"""
}
fn
(request: ListObjectsRequest): Vec<StorageObject> {
  list-objects(request, {})
},
(request: ListObjectsRequest, opts: Map): Vec<StorageObject> {
  body {}
    |> assoc-some("prefix", request.prefix)
    |> assoc-some("limit", request.limit)
    |> assoc-some("offset", request.offset)
    |> assoc-some("search", request.search)
    |> assoc-some("sortBy", request.sort_by)

  ::api/request("POST", `/storage/v1/object/list/${bucket-path(request.bucket)}`, {}, body, opts)
}

list-objects-as
meta {
    doc: """
    Like `list-objects`, but as a signed-in user. `access-token` is the
    Bearer token, so row level security applies as that user.

    **Example**

    ```hot
    ::storage ::supabase::storage

    token ::hot::ctx/get("supabase.user.token")
    objects ::storage/list-objects-as(::storage/ListObjectsRequest({bucket: "avatars", prefix: "users/", limit: 100}), token)
    map(objects, %.name)
    ```
    """
}
fn
(request: ListObjectsRequest, access-token: Str): Vec<StorageObject> {
  list-objects-as(request, access-token, {})
},
(request: ListObjectsRequest, access-token: Str, opts: Map): Vec<StorageObject> {
  body {}
    |> assoc-some("prefix", request.prefix)
    |> assoc-some("limit", request.limit)
    |> assoc-some("offset", request.offset)
    |> assoc-some("search", request.search)
    |> assoc-some("sortBy", request.sort_by)

  ::api/request-as("POST", `/storage/v1/object/list/${bucket-path(request.bucket)}`, {}, body, access-token, opts)
}

list-objects-service
meta {
    doc: """
    Like `list-objects`, with the service role key, which bypasses row level
    security. Server-side only.

    **Example**

    ```hot
    ::storage ::supabase::storage

    objects ::storage/list-objects-service(::storage/ListObjectsRequest({bucket: "avatars", prefix: "users/", limit: 100}))
    map(objects, %.name)
    ```
    """
}
fn
(request: ListObjectsRequest): Vec<StorageObject> {
  list-objects-service(request, {})
},
(request: ListObjectsRequest, opts: Map): Vec<StorageObject> {
  body {}
    |> assoc-some("prefix", request.prefix)
    |> assoc-some("limit", request.limit)
    |> assoc-some("offset", request.offset)
    |> assoc-some("search", request.search)
    |> assoc-some("sortBy", request.sort_by)

  ::api/request-service("POST", `/storage/v1/object/list/${bucket-path(request.bucket)}`, {}, body, opts)
}

MoveObjectRequest type {
  bucket_id: Str,
  source_key: Str,
  destination_key: Str,
  destination_bucket: Str?
}

move-object
meta {
    doc: """
    Move an object within or between buckets.

    **Example**

    ```hot
    ::storage ::supabase::storage

    ::storage/move-object(::storage/MoveObjectRequest({
      bucket_id: "avatars",
      source_key: "tmp/alice.jpg",
      destination_key: "users/alice.jpg"
    }))

    // To another bucket
    ::storage/move-object(::storage/MoveObjectRequest({
      bucket_id: "avatars",
      source_key: "users/alice.jpg",
      destination_key: "alice.jpg",
      destination_bucket: "archive"
    }))
    ```
    """
}
fn
(request: MoveObjectRequest): Map {
  move-object(request, {})
},
(request: MoveObjectRequest, opts: Map): Map {
  body {
    bucketId: request.bucket_id,
    sourceKey: request.source_key,
    destinationKey: request.destination_key
  } |> assoc-some("destinationBucket", request.destination_bucket)

  ::api/request("POST", "/storage/v1/object/move", {}, body, opts)
}

CopyObjectRequest type {
  bucket_id: Str,
  source_key: Str,
  destination_key: Str,
  destination_bucket: Str?
}

copy-object
meta {
    doc: """
    Copy an object within or between buckets.

    **Example**

    ```hot
    ::storage ::supabase::storage

    ::storage/copy-object(::storage/CopyObjectRequest({
      bucket_id: "avatars",
      source_key: "users/alice.jpg",
      destination_key: "backup/alice.jpg"
    }))
    ```
    """
}
fn
(request: CopyObjectRequest): Map {
  copy-object(request, {})
},
(request: CopyObjectRequest, opts: Map): Map {
  body {
    bucketId: request.bucket_id,
    sourceKey: request.source_key,
    destinationKey: request.destination_key
  } |> assoc-some("destinationBucket", request.destination_bucket)

  ::api/request("POST", "/storage/v1/object/copy", {}, body, opts)
}

