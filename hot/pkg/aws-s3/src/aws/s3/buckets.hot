::aws::s3::buckets ns

// S3 Bucket operations

::ctx ::hot::ctx

HttpResponse ::hot::http/HttpResponse
is-ok-response ::hot::http/is-ok-response
eq ::hot::cmp/eq

::api ::aws::s3::api
::xml ::hot::xml

resolve ::aws::core/resolve
send-signed ::aws::core/send-signed
uri-encode ::aws::core/uri-encode
get-region ::aws::core/get-region
AwsError ::aws::core/AwsError

// S3 Bucket type
S3Bucket type {
    name: Str,
    creation_date: Str?
}

// List buckets response
ListBucketsResponse type {
    owner: Map?,
    buckets: Vec<S3Bucket>?
}

// Create bucket response
CreateBucketResponse type {
    location: Str?
}

// Head bucket response (just checks existence)
HeadBucketResponse type {
    exists: Bool,
    region: Str?
}

// Text of a child element, or null when it's absent
child-text fn (elem: Any, name: Str): Str? {
    child ::xml/child(elem, name)
    if(is-null(child), null, ::xml/text(child))
}

// Parse the ListAllMyBucketsResult XML
parse-list-buckets-response fn (xml-str: Str): ListBucketsResponse {
    root ::xml/from-xml(xml-str)
    owner ::xml/child(root, "Owner")
    buckets ::xml/child(root, "Buckets")

    ListBucketsResponse({
        owner: if(is-null(owner), null, {id: child-text(owner, "ID"), display_name: child-text(owner, "DisplayName")}),
        buckets: if(is-null(buckets), [], map(::xml/children(buckets, "Bucket"), (elem) {
            S3Bucket({name: child-text(elem, "Name"), creation_date: child-text(elem, "CreationDate")})
        }))
    })
}

// List all buckets
list-buckets
meta {
    doc: """
    List all S3 buckets in the account.

    **Example**

    ```hot
    result ::aws::s3::buckets/list-buckets()
    result.buckets
    // => [{name: "my-bucket", creation_date: "2024-01-01T00:00:00Z"}, ...]
    ```
    """
}
fn
(opts: Map): ListBucketsResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        // The regional endpoint: the global one only accepts us-east-1 signatures
        url `${::api/base-url(resolved)}/`

        response send-signed("GET", url, "s3", resolved, {}, "")

        cond {
            is-ok-response(response) => { parse-list-buckets-response(::api/body-text(response.body)) }
            => { err(AwsError(response)) }
        }
    })
},
(): ListBucketsResponse | AwsError {
    list-buckets({})
}

// Create a bucket
create-bucket
meta {
    doc: """
    Create a new S3 bucket.

    **Example**

    ```hot
    result ::aws::s3::buckets/create-bucket("my-new-bucket", "us-east-1")
    result.location  // => "http://my-new-bucket.s3.amazonaws.com/"

    // Use default region from context
    result ::aws::s3::buckets/create-bucket("my-new-bucket")
    ```
    """
}
fn
(bucket: Str, region: Str, opts: Map): CreateBucketResponse | AwsError {
    if-ok(resolve({...opts, region: region}), (resolved) {
        url `${::api/base-url(resolved)}/${uri-encode(bucket)}`

        // Create bucket configuration for non-us-east-1 regions
        body cond {
            eq(region, "us-east-1") => { "" }
            => { `<CreateBucketConfiguration xmlns="http://s3.amazonaws.com/doc/2006-03-01/">
            <LocationConstraint>${region}</LocationConstraint>
        </CreateBucketConfiguration>` }
        }

        response send-signed("PUT", url, "s3", resolved, {}, body)

        cond {
            is-ok-response(response) => { CreateBucketResponse({
                location: ::aws::core/response-header(response, "Location")
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(bucket: Str, opts: Map): CreateBucketResponse | AwsError {
    if-ok(resolve(opts), (resolved) { create-bucket(bucket, resolved.region, opts) })
},
(bucket: Str, region: Str): CreateBucketResponse | AwsError {
    create-bucket(bucket, region, {})
},
(bucket: Str): CreateBucketResponse | AwsError {
    create-bucket(bucket, get-region())
}

// Delete a bucket
delete-bucket
meta {
    doc: """
    Delete an S3 bucket. The bucket must be empty before it can be deleted.

    **Example**

    ```hot
    ::aws::s3::buckets/delete-bucket("my-bucket")
    // => true
    ```
    """
}
fn
(bucket: Str, opts: Map): Bool | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${::api/base-url(resolved)}/${uri-encode(bucket)}`

        response send-signed("DELETE", url, "s3", resolved, {}, "")

        cond {
            is-ok-response(response) => { true }
            => { AwsError(response) }
        }
    })
},
(bucket: Str): Bool | AwsError {
    delete-bucket(bucket, {})
}

// Head a bucket (check if exists)
head-bucket
meta {
    doc: """
    HEAD a bucket to check if it exists and get its region.

    **Example**

    ```hot
    result ::aws::s3::buckets/head-bucket("my-bucket")
    result.exists  // => true
    ```
    """
}
fn
(bucket: Str, opts: Map): HeadBucketResponse | AwsError {
    if-ok(resolve(opts), (resolved) {
        url `${::api/base-url(resolved)}/${uri-encode(bucket)}`

        response send-signed("HEAD", url, "s3", resolved, {}, "")

        cond {
            is-ok-response(response) => { HeadBucketResponse({
                exists: true,
                region: ::aws::core/response-header(response, "x-amz-bucket-region")
            }) }
            => { err(AwsError(response)) }
        }
    })
},
(bucket: Str): HeadBucketResponse | AwsError {
    head-bucket(bucket, {})
}
