::github::test::opts ns
meta ["test"]

// Hermetic: no network and no github.* context.

::api ::github::api
::app ::github::app
::actions ::github::actions
::artifacts ::github::artifacts
::checks ::github::checks
::commits ::github::commits
::issues ::github::issues
::pulls ::github::pulls
::rate-limit ::github::rate-limit
::repos ::github::repos
::search ::github::search
::users ::github::users
GitHubResponse ::github::api/GitHubResponse

OFFLINE {token: "ghp_tenant", base-url: "http://127.0.0.1:1"}

