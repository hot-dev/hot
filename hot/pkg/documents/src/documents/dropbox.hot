::documents::dropbox ns
meta {
    doc: """
    The Dropbox implementation of the `::documents` verbs, over
    `hot.dev/dropbox`. Source: `{provider: "dropbox", root?, opts}`:
    `root` is a folder path (default the whole account) that listing,
    search, uploads and changes stay under. Team apps put `select-user`
    and `path-root` in `opts`.

    Dropbox reports deletions by path only, so `changes` returns
    lower-cased paths in `deleted-ids` (and `deleted-paths`); a deleted
    folder removes everything under it.
    """
}

::source ::documents::source
::cursor ::documents::cursor
::adapters ::documents::adapters
::text ::documents::text
::dbx ::dropbox
::dapi ::dropbox::api
::files ::dropbox::files
::content ::dropbox::content
::up ::dropbox::upload
::sync ::dropbox::sync
Page ::documents/Page
ChangeSet ::documents/ChangeSet

PROVIDER "dropbox"
MAX_PAGE_SIZE 2000

to-document fn (source: Map, entry: Map): Any {
  ::adapters/from-dropbox(source, ::dbx/to-doc-file(entry))
}

root-of
meta {
    doc: """The source's root as a Dropbox path (pure): `""` for the whole account."""
}
fn (source: Map): Str {
  ::dbx/normalize-path(get(source, "root"))
}

child-path
meta {
    doc: """The Dropbox path for `name` under `parent` (pure): `parent` (or the source root) joined with `name`."""
}
fn (source: Map, parent: Str?, name: Str): Str {
  base ::dbx/normalize-path(or(parent, root-of(source)))
  `${base}/${name}`
}

// ---------------------------------------------------------------------------
// Pure builders
// ---------------------------------------------------------------------------

to-page
meta {
    doc: """A `list_folder` page as a `::documents/Page` (pure). Dropbox always returns a cursor; it becomes the page cursor only when `has_more`."""
}
fn (source: Map, folder: Str, page: Map): Page {
  docs map(or(page.entries, []), (e) { to-document(source, e) })
  c if(eq(page.has_more, true), ::cursor/list-cursor(PROVIDER, page.cursor, folder), null)
  Page({documents: docs, cursor: c, has-more: is-some(c)})
}

to-change-set
meta {
    doc: """A dropbox `ChangeSet` as a `::documents/ChangeSet` (pure). `reset: true` (the cursor was invalidated and the root relisted) sets `reset-required`; `documents` is then a full listing."""
}
fn (source: Map, set: Map): ChangeSet {
  next ::cursor/change-cursor(PROVIDER, set.cursor)
  paths ::sync/deleted-paths(set)
  cond {
    is-err(next) => { next }
    => {
      ChangeSet({
        documents: map(::sync/changed-files(set), (f) { ::adapters/from-dropbox(source, f) }),
        deleted-ids: paths,
        deleted-paths: paths,
        next-cursor: next,
        reset-required: eq(set.reset, true),
        has-more: false
      })
    }
  }
}

// ---------------------------------------------------------------------------
// Verbs
// ---------------------------------------------------------------------------

list fn (source: Map, folder: Str?, opts: Map): Page {
  popts ::source/provider-opts(source, opts)
  given get(opts, "cursor")
  c if(is-null(given), null, ::cursor/decode-for(given, PROVIDER, "list"))
  cond {
    is-err(c) => { c }
    is-map(c) => {
      page ::files/list-folder-continue(Str(c.v), ::dapi/credential-opts(popts))
      if(is-err(page), page, to-page(source, Str(or(c.f, "")), page))
    }
    => {
      target ::dbx/normalize-path(or(folder, root-of(source)))
      size ::source/page-size(opts, ::documents/DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE)
      page ::files/list-folder(target, {...popts, limit: size})
      if(is-err(page), page, to-page(source, target, page))
    }
  }
}

search fn (source: Map, query: Str, limit: Int, opts: Map): Vec {
  root root-of(source)
  popts ::source/provider-opts(source, opts)
  scoped if(or(eq(root, ""), is-some(get(popts, "path"))), popts, {...popts, path: root})
  found ::files/search-all(query, scoped, limit)
  if(is-err(found), found, map(filter(found, is-map), (e) { to-document(source, e) }))
}

get-doc fn (source: Map, id: Str, opts: Map): Any {
  entry ::files/get-metadata(id, ::source/provider-opts(source, opts))
  if(is-err(entry), entry, to-document(source, entry))
}

download fn (source: Map, id: Str, opts: Map): Any {
  content ::content/download(id, ::source/provider-opts(source, opts))
  if(is-err(content), content, ::adapters/to-content(source, content, ::adapters/from-dropbox, null))
}

read-text fn (source: Map, id: Str, format: Str, opts: Map): Any {
  popts ::source/provider-opts(source, opts)
  entry ::files/get-metadata(id, popts)
  doc if(is-err(entry), entry, to-document(source, entry))
  cond {
    is-err(doc) => { doc }
    => {
      plan ::text/plan(doc, format)
      cond {
        eq(plan.action, "error") => { ::text/plan-error(plan) }
        eq(plan.action, "unsupported") => { ::text/not-ok-result(doc, "unsupported", plan.reason) }
        eq(plan.action, "export") => {
          content ::content/export(doc.id, plan.export, {...popts, entry: entry})
          if(is-err(content), content, ::text/ok-result(doc, content.bytes, plan.format, content.mime-type, "export"))
        }
        => {
          content ::content/download(doc.id, {...popts, rev: entry.rev})
          if(is-err(content), content, ::text/ok-result(doc, content.bytes, plan.format, or(content.mime-type, doc.mime-type), "download"))
        }
      }
    }
  }
}

upload fn (source: Map, parent: Str?, name: Str, bytes: Bytes, mime-type: Str, opts: Map): Any {
  meta-data ::up/upload(child-path(source, parent, name), bytes, ::source/provider-opts(source, opts))
  if(is-err(meta-data), meta-data, to-document(source, meta-data))
}

start-cursor fn (source: Map, opts: Map): Any {
  c ::sync/get-latest-cursor(root-of(source), {...::source/provider-opts(source, opts), recursive: true})
  if(is-err(c), c, ::cursor/change-cursor(PROVIDER, c))
}

changes fn (source: Map, cursor: Str, opts: Map): Any {
  c ::cursor/decode-for(cursor, PROVIDER, "changes")
  cond {
    is-err(c) => { c }
    => {
      set ::sync/sync-changes(Str(c.v), {...::source/provider-opts(source, opts), path: root-of(source), recursive: true})
      if(is-err(set), set, to-change-set(source, set))
    }
  }
}
