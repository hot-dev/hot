}

get-guild-role
meta {
    doc: """GET /guilds/{guild_id}/roles/{role_id} - One role."""
}
fn (request: GetGuildRoleRequest): Map {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/roles/${seg(request.role_id)}`)
