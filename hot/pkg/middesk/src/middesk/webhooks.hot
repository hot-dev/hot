::middesk::webhooks ns
meta {
    doc: """
    Middesk webhooks: `X-Middesk-Signature-256` verification, event
    parsing, and webhook endpoint management.

    Middesk signs each delivery with HMAC-SHA256 of the raw request body,
    keyed by the `secret` you set on the webhook, and sends the lowercase
    hex digest in `X-Middesk-Signature-256`. Only SHA-256 is supported
    here (an older Middesk doc described a SHA-1 `X-Middesk-Signature`
    header; the current docs don't).

    **No signed timestamp.** The signature covers only the body, so a
    captured delivery can be replayed. Record each event `id` once
    (e.g. in a store) and ignore repeats; Middesk also retries
    deliveries (up to 10 times over about 3 days), so dedupe is needed
    anyway. Sandbox and production need separate webhook endpoints.

    See https://docs.middesk.com/build/secure-webhooks.
    """
}

::api ::middesk::api
RequestOptions ::middesk::api/RequestOptions

::ctx ::hot::ctx
::hmac ::hot::hmac

seg ::middesk::api/seg

// ---------------------------------------------------------------------------
// Signature verification
// ---------------------------------------------------------------------------

verify-signature
meta {
    doc: """Verify an `X-Middesk-Signature-256` value against a raw body: lowercase hex HMAC-SHA256 of the body with `secret`, compared in constant time. Fails closed on an empty secret or signature. Exposed for testing; `verify-request` reads them from the request."""
}
fn (signature: Str, raw-body: Str | Bytes, secret: Str): Bool {
  sig lowercase(trim(signature))
  cond {
    // An empty key would make every signature forgeable: fail closed.
    is-empty(secret) => { false }
    is-empty(sig) => { false }
    => { secure-compare(::hmac/hmac-sha256(secret, raw-body), sig) }
  }
}

verify-request
meta {
    ctx: {"middesk.webhook.secret": {required: false}},
    doc: """
    Verify an inbound Middesk webhook over `::hot::http/raw-body`. Uses
    `middesk.webhook.secret` by default and fails when it is unset; an
    empty explicit secret never verifies. There is no timestamp to check:
    dedupe on the event id (see the namespace doc).

    **Example**

    ```hot
    middesk-webhook
    meta {webhook: {service: "middesk", path: "/middesk/webhook"}, secret-headers: ["x-middesk-signature-256"]}
    fn (request) {
      if(not(::middesk::webhooks/verify-request(request)),
        ::hot::http/HttpResponse({status: 401, body: "invalid signature"}),
        ::hot::http/HttpResponse({status: 200, body: {received: true}}))
    }
    ```
    """
}
fn
(request: Map): Bool {
  secret or(::ctx/get("middesk.webhook.secret"), "")
  if(is-empty(secret),
    fail("middesk.webhook.secret is not set. Add the secret you set on the Middesk webhook in Context Variables to verify webhook requests.")
  )
  verify-request(request, secret)
},
(request: Map, secret: Str): Bool {
  headers or(get(request, "headers"), {})
  sig or(get(headers, "x-middesk-signature-256"), or(get(headers, "X-Middesk-Signature-256"), ""))
  verify-signature(Str(sig), ::hot::http/raw-body(request), secret)
}

parse-event
meta {
    doc: """
    Flatten a webhook body into `{id, type, created-at, account-id,
    object-type, object-id, object}`. `type` is e.g. `"business.updated"`
    or `"order.updated"`; `object` is `data.object` (for business events,
    the business with its status). Dedupe on `id`.
    """
}
fn (body: Any): Map {
  b if(is-map(body), body, {})
  data or(get(b, "data"), {})
  object if(is-map(data), get(data, "object"), null)
  {
    id: get(b, "id"),
    type: get(b, "type"),
    created-at: get(b, "created_at"),
    account-id: get(b, "account_id"),
    object-type: if(is-map(object), get(object, "object"), null),
    object-id: if(is-map(object), get(object, "id"), null),
    object: object
  }
}

construct-event
meta {
    ctx: {"middesk.webhook.secret": {required: false}},
    doc: """
    Verify a webhook request (see `verify-request`) and return the parsed
    event (see `parse-event`), or an Err when the signature is invalid.

    **Example**

    ```hot
    middesk-webhook
    meta {webhook: {service: "middesk", path: "/middesk/webhook"}, secret-headers: ["x-middesk-signature-256"]}
    fn (request) {
      event ::middesk::webhooks/construct-event(request)
      cond {
        is-err(event) => { ::hot::http/HttpResponse({status: 401, body: "invalid signature"}) }
        => {
          // Dedupe on event.id; when event.type is "business.updated", fetch
          // the business and summarize it for the reviewer agent.
          ::hot::http/HttpResponse({status: 200, body: {received: true}})
        }
      }
    }
    ```
    """
}
fn
(request: Map): Map {
  secret or(::ctx/get("middesk.webhook.secret"), "")
  if(is-empty(secret),
    fail("middesk.webhook.secret is not set. Add the secret you set on the Middesk webhook in Context Variables to verify webhook requests.")
  )
  construct-event(request, secret)
},
(request: Map, secret: Str): Map {
  cond {
    not(verify-request(request, secret)) => { err("Middesk webhook signature verification failed") }
    is-map(get(request, "body")) => { parse-event(request.body) }
    => {
      raw ::hot::http/raw-body(request)
      parsed from-json(if(is-bytes(raw), Str(raw), raw))
      if(is-err(parsed), err("Middesk webhook body is not JSON"), parse-event(parsed))
    }
  }
}

// ---------------------------------------------------------------------------
// Webhook endpoints
// ---------------------------------------------------------------------------

list-webhooks
meta {
    doc: """GET /webhooks - Your webhook endpoints. `params`: `page`, `per_page`."""
}
fn
(): Map {
  list-webhooks({}, RequestOptions({}))
},
(params: Map): Map {
  list-webhooks(params, RequestOptions({}))
},
(params: Map, options: RequestOptions): Map {
  ::api/list-page("/webhooks", params, options)
}

create-webhook
meta {
    doc: """
    POST /webhooks - Register an endpoint. `enabled-events` lists event
    types (`["*"]` for all), e.g. `["business.updated", "order.updated"]`.
    `opts.secret` sets the signing secret: without one Middesk sends no
    signature and `verify-request` can't pass, so always set it (store
    the same value as `middesk.webhook.secret`). Other `opts`: `include`,
    `event_schemas` and the `oidc_*` fields.

    **Example**

    ```hot
    secret ::hot::random/random-string(40)
    ::middesk::webhooks/create-webhook("https://myapp.hot.dev/middesk/webhook", ["business.updated"], {secret: secret})
    ```
    """
}
fn
(url: Str, enabled-events: Vec<Str>, opts: Map): Map {
  create-webhook(url, enabled-events, opts, RequestOptions({}))
},
(url: Str, enabled-events: Vec<Str>, opts: Map, options: RequestOptions): Map {
  ::api/send("POST", "/webhooks", {}, ::api/compact({...untype(opts), url: url, enabled_events: enabled-events}), options)
}

get-webhook
meta {
    doc: """GET /webhooks/{id} - Retrieve an endpoint (the secret is not returned)."""
}
fn
(webhook-id: Str): Map {
  get-webhook(webhook-id, RequestOptions({}))
},
(webhook-id: Str, options: RequestOptions): Map {
  ::api/send("GET", `/webhooks/${seg(webhook-id)}`, {}, null, options)
}

update-webhook
meta {
    doc: """PUT /webhooks/{id} - Update `url`, `secret`, `enabled_events` or `disabled_at` (a timestamp pauses deliveries)."""
}
fn
(webhook-id: Str, params: Map): Map {
  update-webhook(webhook-id, params, RequestOptions({}))
},
(webhook-id: Str, params: Map, options: RequestOptions): Map {
  ::api/send("PUT", `/webhooks/${seg(webhook-id)}`, {}, ::api/compact(untype(params)), options)
}

delete-webhook
meta {
    doc: """DELETE /webhooks/{id} - Remove an endpoint."""
}
fn
(webhook-id: Str): Any {
  delete-webhook(webhook-id, RequestOptions({}))
},
(webhook-id: Str, options: RequestOptions): Any {
  ::api/send("DELETE", `/webhooks/${seg(webhook-id)}`, {}, null, options)
}
