::supabase::test::filters ns
meta ["test"]

::f ::supabase::filters

test-basic-filters
meta ["test"]
fn () {
  assert-eq("status=eq.active", ::f/eq("status", "active"))
  assert-eq("age=gte.18", ::f/gte("age", 18))
  assert-eq("deleted_at=is.null", ::f/is_("deleted_at", "null"))
}

test-quoted-and-encoded-values
meta ["test"]
fn () {
  // A single-value filter is never quoted: PostgREST would match the quotes.
  assert-eq("email=eq.a%40b.com", ::f/eq("email", "a@b.com"))
  assert-eq("name=eq.Alice%20Smith", ::f/eq("name", "Alice Smith"))
  assert-eq("created_at=gte.2026-01-01T00%3A00%3A00Z", ::f/gte("created_at", "2026-01-01T00:00:00Z"))
  assert-eq("tags=cs.%7Ba%2Cb%7D", ::f/cs("tags", "{a,b}"))
  assert-eq("note=eq.say%20%22hi%22", ::f/eq("note", "say \"hi\""))
  assert-eq("deleted_at=isdistinct.null", ::f/filter("deleted_at", "isdistinct", null))
  // List items with reserved characters are quoted.
  assert-eq("status=in.(active,pending)", ::f/in_("status", ["active", "pending"]))
  assert-eq("tag=in.(%22a%2Cb%22,%22c%20d%22)", ::f/in_("tag", ["a,b", "c d"]))
}

test-logical-groups
meta ["test"]
fn () {
  assert-eq("or=%28age.lt.18%2Cage.gt.65%29", ::f/or_(["age.lt.18", "age.gt.65"]))
  assert-eq("and=%28age.gte.18%2Cage.lte.65%29", ::f/and_(["age.gte.18", "age.lte.65"]))
}
