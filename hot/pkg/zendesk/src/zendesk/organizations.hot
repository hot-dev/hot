::api ::zendesk::api

list-organizations
meta {
    doc: """
    GET /organizations - One cursor page: `{organizations, meta, links}`.
    `options`: `page_size`, `after`, `sort`.

    **Example**

    ```hot
    page ::zendesk::organizations/list-organizations({page_size: 50, sort: "-created_at"})
    map(page.organizations, %.name)
    ```
    """
}
fn
(): Any {
  list-organizations({})
},
(options: Map): Any {
  list-organizations(options, {})
},
(options: Map, opts: Map): Any {
  ::api/list-page("/organizations", options, opts)
}

get-organization
meta {
    doc: """
    GET /organizations/{id} - One organization: `{organization}`.

    **Example**

    ```hot
    out ::zendesk::organizations/get-organization(360001)
    out.organization.name
    ```
    """
}
fn
(id: Any): Any {
  get-organization(id, {})
},
(id: Any, opts: Map): Any {
  ::api/request("GET", `/organizations/${::api/path-segment(id)}`, "", opts)
}

create-organization
meta {
    doc: """
    POST /organizations - Create an organization. `fields`: `name`
    (required, unique), `external_id`, `domain_names` (Vec), `details`,
    `notes`, `group_id`, `shared_tickets`, `tags`, `organization_fields`.
    Unset fields are omitted.

    **Example**

    ```hot
    out ::zendesk::organizations/create-organization({name: "Acme", external_id: "acme-42", domain_names: ["acme.example"]})
    out.organization.id
    ```
    """
}
fn
(fields: Map): Any {
  create-organization(fields, {})
},
(fields: Map, opts: Map): Any {
  ::api/request("POST", "/organizations", {organization: ::api/compact(fields)}, opts)
}

update-organization
meta {
    doc: """
    PUT /organizations/{id} - Update an organization's fields. Unset fields
    are omitted.

    **Example**

    ```hot
    out ::zendesk::organizations/update-organization(360001, {notes: "Renewal in March"})
    out.organization.notes
    ```
    """
}
fn
(id: Any, fields: Map): Any {
  update-organization(id, fields, {})
},
(id: Any, fields: Map, opts: Map): Any {
  ::api/request("PUT", `/organizations/${::api/path-segment(id)}`, {organization: ::api/compact(fields)}, opts)
}

