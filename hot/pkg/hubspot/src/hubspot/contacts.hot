::hubspot::contacts ns

::objects ::hubspot::objects

create-contact
meta {
    doc: """
    Create a contact from a properties Map (`email`, `firstname`,
    `lastname`, `phone`, `company`, plus any custom properties).

    **Example**

    ```hot
    contact ::hubspot::contacts/create-contact({
      email: "ada@example.com",
      firstname: "Ada"
    })
    contact.id
    ```
    """
}
fn (properties: Map): Map {
  ::objects/create-object("contacts", properties)
}

get-contact
meta {
    doc: """Fetch a contact by id; the 2-arity form selects `properties` to return."""
}
fn
(id: Str): Map {
  ::objects/get-object("contacts", id)
},
(id: Str, properties: Vec): Map {
  ::objects/get-object("contacts", id, properties)
}

update-contact
meta {
    doc: """Update a contact's properties."""
}
fn (id: Str, properties: Map): Map {
  ::objects/update-object("contacts", id, properties)
}

find-by-email
meta {
    doc: """Search for a contact by exact email. Returns the contact or null."""
}
fn (email: Str): Any {
  out ::objects/search-objects("contacts", {
    filters: [{propertyName: "email", operator: "EQ", value: email}],
    limit: 1
  })
  cond {
    is-err(out) => { out }
    is-empty(out.results) => { null }
    => { first(out.results) }
  }
}

search-contacts
meta {
    doc: """Search contacts — see `::hubspot::objects/build-search-body` for the options."""
}
fn (options: Map): Map {
  ::objects/search-objects("contacts", options)
}

upsert-by-email
meta {
    doc: """
    Create or update contacts keyed by email in one batch call (max 100):
    `records` is a Vec of properties Maps that each include `email`.
    Returns `{status, results}`; each result's `new` says whether it was
    created. Unlike search-then-write, this is not affected by search
    indexing delay.

    **Example**

    ```hot
    ::hubspot::contacts/upsert-by-email([
      {email: "ada@example.com", firstname: "Ada", lifecyclestage: "lead"}
    ])
    ```
    """
}
fn (records: Vec): Map {
  ::objects/batch-upsert("contacts", "email", map(records, (r) { {id: r.email, properties: r} }))
}

archive-contact
meta {
    doc: """Archive a contact (recycle bin, restorable for 90 days)."""
}
fn (id: Str): Any {
  ::objects/archive-object("contacts", id)
}
