::microsoft::excel::worksheets ns
meta {
    doc: """Worksheets: list, get, add, rename, update and delete. A worksheet is addressed by name or id."""
}

::excel ::microsoft::excel

list-worksheets
meta {
    doc: """
    GET /workbook/worksheets. Returns a Vec of `{id, name, position,
    visibility}`.

    **Example**

    ```hot
    sheets ::microsoft::excel::worksheets/list-worksheets("/Reports/Q3.xlsx")
    map(sheets, %.name)

    // A workbook in another drive
    ::microsoft::excel::worksheets/list-worksheets("01ABC", {drive: "b1"})
    ```
    """
}
fn
(item: Any): Vec {
  list-worksheets(item, {})
},
(item: Any, opts: Map): Vec {
  ::excel/collection(::excel/fetch(`${::excel/workbook-path(item, opts)}/worksheets`, {}, opts))
}

get-worksheet
meta {
    doc: """
    GET /workbook/worksheets/{sheet}.

    **Example**

    ```hot
    sheet ::microsoft::excel::worksheets/get-worksheet("/Reports/Q3.xlsx", "Data")
    sheet.visibility
    ```
    """
}
fn
(item: Any, sheet: Str): Map {
  get-worksheet(item, sheet, {})
},
(item: Any, sheet: Str, opts: Map): Map {
  ::excel/fetch(::excel/worksheet-path(item, sheet, opts), {}, opts)
}

add-worksheet
meta {
    doc: """
    POST /workbook/worksheets/add. Returns the new worksheet.

    **Example**

    ```hot
    sheet ::microsoft::excel::worksheets/add-worksheet("/Reports/Q3.xlsx", "Pipeline")
    sheet.id
    ```
    """
}
fn
(item: Any, name: Str): Map {
  add-worksheet(item, name, {})
},
(item: Any, name: Str, opts: Map): Map {
  ::excel/call("POST", `${::excel/workbook-path(item, opts)}/worksheets/add`, {name: name}, opts)
}

update-worksheet
meta {
    doc: """
    PATCH /workbook/worksheets/{sheet}. `changes` holds `name`, `position`
    or `visibility` (`Visible`, `Hidden`, `VeryHidden`).

    **Example**

    ```hot
    ::microsoft::excel::worksheets/update-worksheet("/Reports/Q3.xlsx", "Scratch", {position: 0, visibility: "Hidden"})
    ```
    """
}
fn
(item: Any, sheet: Str, changes: Map): Map {
  update-worksheet(item, sheet, changes, {})
},
(item: Any, sheet: Str, changes: Map, opts: Map): Map {
  ::excel/call("PATCH", ::excel/worksheet-path(item, sheet, opts), changes, opts)
}

rename-worksheet
meta {
    doc: """
    Rename a worksheet.

    **Example**

    ```hot
    ::microsoft::excel::worksheets/rename-worksheet("/Reports/Q3.xlsx", "Sheet1", "Data")
    ```
    """
}
fn
(item: Any, sheet: Str, name: Str): Map {
  update-worksheet(item, sheet, {name: name}, {})
},
(item: Any, sheet: Str, name: Str, opts: Map): Map {
  update-worksheet(item, sheet, {name: name}, opts)
}

delete-worksheet
meta {
    doc: """
    DELETE /workbook/worksheets/{sheet}. Returns `{}`.

    **Example**

    ```hot
    ::microsoft::excel::worksheets/delete-worksheet("/Reports/Q3.xlsx", "Scratch")
    ```
    """
}
fn
(item: Any, sheet: Str): Map {
  delete-worksheet(item, sheet, {})
},
(item: Any, sheet: Str, opts: Map): Map {
  ::excel/call("DELETE", ::excel/worksheet-path(item, sheet, opts), "", opts)
}
