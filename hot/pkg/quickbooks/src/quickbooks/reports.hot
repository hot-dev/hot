::quickbooks::reports ns
meta {
    doc: """
    QuickBooks Online reports, plus `flatten-report`, which turns a report's
    nested sections into flat records an agent or a spreadsheet can use.

    Every report takes a params Map with Intuit's own parameter names;
    common ones are `start_date` / `end_date` (`YYYY-MM-DD`),
    `date_macro` (`"This Fiscal Year-to-date"`, `"Last Month"`, ...),
    `accounting_method` (`Cash` / `Accrual`), `summarize_column_by`
    (`Total`, `Month`, `Quarter`, `Customers`, `Classes`, ...),
    `customer`, `vendor`, `class`, `department`, `report_date` and
    `aging_period` / `num_periods` (aged reports), and `columns`
    (TransactionList, GeneralLedger; a Vec is comma-joined). Null values
    are dropped.

    ```hot
    ::r ::quickbooks::reports

    pnl ::r/profit-and-loss({start_date: "2026-01-01", end_date: "2026-09-30", accounting_method: "Accrual"})
    rows ::r/flatten-report(pnl)
    revenue find-first(rows, (row) { eq(row.label, "Total Income") })
    revenue.values.Total
    ```

    Reports are read calls: under the Intuit App Partner Program they are
    metered CorePlus calls.
    """
}

::api ::quickbooks::api
::re ::hot::regex

REPORTS [
  "ProfitAndLoss",
  "ProfitAndLossDetail",
  "BalanceSheet",
  "CashFlow",
  "TrialBalance",
  "GeneralLedger",
  "TransactionList",
  "AgedReceivables",
  "AgedReceivableDetail",
  "AgedPayables",
  "AgedPayableDetail",
  "CustomerBalance",
  "VendorBalance",
  "AccountList",
  "JournalReport"
]

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

check-name
meta {
    doc: """A report name (letters only, e.g. `ProfitAndLoss`), or an Err. Names outside `REPORTS` are allowed for reports this package does not list."""
}
fn (name: Str): Str {
  cond {
    ::re/is-match(name, "^[A-Za-z]{2,64}$") => { name }
    => { err(`quickbooks: invalid report name '${name}'`) }
  }
}

run-report
meta {
    doc: """GET /reports/{name} with `params`. Returns the report (`Header`, `Columns`, `Rows`). Use `flatten-report` for records."""
}
fn
(name: Str): Map {
  run-report(name, {}, {})
},
(name: Str, params: Map): Map {
  run-report(name, params, {})
},
(name: Str, params: Map, opts: Map): Map {
  checked check-name(name)
  cond {
    is-err(checked) => { checked }
    => { ::api/json("GET", `/reports/${checked}`, untype(params), "", opts) }
  }
}

profit-and-loss
meta {doc: """The ProfitAndLoss report (income statement)."""}
fn
(params: Map): Map {
  run-report("ProfitAndLoss", params, {})
},
(params: Map, opts: Map): Map {
  run-report("ProfitAndLoss", params, opts)
}

