::discord::messages ns
meta {
    doc: """
    Messages, reactions and pins: send (with embeds, components, polls
    and file uploads), read, edit, delete, crosspost, react, and pin.
    """
}

::api ::discord::api

seg ::discord::api/seg

// ============================================================================
// Reading messages
// ============================================================================

GetChannelMessagesRequest type {
  channel_id: Str,
  around: Str?,
  before: Str?,
  after: Str?,
  limit: Int?
}

get-channel-messages
meta {
    doc: """
    GET /channels/{channel_id}/messages - Up to `limit` (1-100, default 50)
    messages, newest first. Page with one of `before`, `after` or `around`
    (a message id). Needs VIEW_CHANNEL and READ_MESSAGE_HISTORY; message
    `content` is empty unless the app has the Message Content intent.

    **Example**

    ```hot
    ::messages ::discord::messages

    recent ::messages/get-channel-messages(::messages/GetChannelMessagesRequest({
      channel_id: "1100000000000000000",
      limit: 10
    }))
    // => [{id: "...", content: "Hello", author: {...}}, ...]
    ```
    """
}
fn (request: GetChannelMessagesRequest): Vec<Map> {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/messages`, {
    query: {around: request.around, before: request.before, after: request.after, limit: request.limit}
  })
}

get-message-history
meta {
    doc: """
    Page backwards through a channel's history with `before`, newest
    first, collecting up to `max-items` messages (100 per request). The
    3-arity form starts before a given message id.

    **Example**

    ```hot
    last-500 ::discord::messages/get-message-history("1100000000000000000", 500)
    ```
    """
}
fn
(channel-id: Str, max-items: Int): Vec<Map> {
  get-message-history(channel-id, max-items, null)
},
(channel-id: Str, max-items: Int, before: Str?): Vec<Map> {
  ::api/paginate(
    (cursor) {
      get-channel-messages(GetChannelMessagesRequest({
        channel_id: channel-id,
        before: or(cursor, before),
        limit: min(100, max-items)
      }))
    },
    (page) { last(page).id },
    min(100, max-items),
    max-items
  )
}

GetMessageRequest type {
  channel_id: Str,
  message_id: Str
}

get-message
meta {
    doc: """GET /channels/{channel_id}/messages/{message_id} - One message by id."""
}
fn (request: GetMessageRequest): Map {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/messages/${seg(request.message_id)}`)
}

// ============================================================================
// Sending and editing
// ============================================================================

CreateMessageRequest type {
  channel_id: Str,
  content: Str?,
  nonce: Any?,
  enforce_nonce: Bool?,
  tts: Bool?,
  embeds: Vec<Map>?,
  allowed_mentions: Map?,
  message_reference: Map?,
  components: Vec<Map>?,
  sticker_ids: Vec<Str>?,
  attachments: Vec<Map>?,
  flags: Int?,
  poll: Map?,
  files: Vec<::discord::api/FileUpload>?
}

create-message
meta {
    doc: """
    POST /channels/{channel_id}/messages - Send a message. Provide at
    least one of `content`, `embeds`, `components`, `sticker_ids`, `poll`
    or `files`. Unset fields are omitted from the request.

    - `message_reference: {message_id}` replies to a message
      (`{type: 1, message_id, channel_id}` forwards one).
    - `allowed_mentions: {parse: []}` suppresses pings from user text.
    - `files` uploads attachments as multipart/form-data; reference one in
      an embed as `attachment://<filename>`. `attachments` is generated from
      `files` when you don't pass it.
    - `nonce` with `enforce_nonce: true` deduplicates retries.
    - `flags`: 4 = SUPPRESS_EMBEDS, 4096 = SUPPRESS_NOTIFICATIONS,
      32768 = IS_COMPONENTS_V2.

    **Example**

    ```hot
    ::messages ::discord::messages

    sent ::messages/create-message(::messages/CreateMessageRequest({
      channel_id: "1100000000000000000",
      content: "Nightly report attached",
      files: [{filename: "report.csv", content: "date,count\n2026-11-01,42\n"}]
    }))
    sent.id
    ```
    """
}
fn (request: CreateMessageRequest): Map {
  files or(request.files, [])
  payload ::api/body(request, ["channel_id"])
  final cond {
    and(not(is-empty(files)), is-null(request.attachments)) => { assoc(payload, "attachments", ::api/attachments-for(files)) }
    => { payload }
  }

  ::api/call("POST", `/channels/${seg(request.channel_id)}/messages`, {body: final, files: files})
}

EditMessageRequest type {
  channel_id: Str,
  message_id: Str,
  content: Str?,
  embeds: Vec<Map>?,
  flags: Int?,
  allowed_mentions: Map?,
  components: Vec<Map>?,
  attachments: Vec<Map>?,
  files: Vec<::discord::api/FileUpload>?,
  clear: Vec<Str>?
}

edit-message
meta {
    doc: """
    PATCH /channels/{channel_id}/messages/{message_id} - Edit a message.
    Only the fields you set change; unset fields are left alone. Set an
    empty value to remove content (`embeds: []`, `components: []`), or
    list fields in `clear` to send them as null.

    `attachments` is the full list to keep: existing attachments not in it
    are removed. New `files` are appended as `files[n]`; include
    `{id: n}` entries for them in `attachments` when you also pass it.

    **Example**

    ```hot
    ::messages ::discord::messages

    ::messages/edit-message(::messages/EditMessageRequest({
      channel_id: "1100000000000000000",
      message_id: "1200000000000000000",
      content: "Deploy finished (edited)"
    }))
    ```
    """
}
fn (request: EditMessageRequest): Map {
  ::api/call("PATCH", `/channels/${seg(request.channel_id)}/messages/${seg(request.message_id)}`, {
    body: ::api/body(request, ["channel_id", "message_id"]),
    files: or(request.files, [])
  })
}

DeleteMessageRequest type {
  channel_id: Str,
  message_id: Str
}

delete-message
meta {
    doc: """DELETE /channels/{channel_id}/messages/{message_id} - Delete a message. Deleting another user's message needs MANAGE_MESSAGES."""
}
fn (request: DeleteMessageRequest): Bool {
  ::api/call-ok("DELETE", `/channels/${seg(request.channel_id)}/messages/${seg(request.message_id)}`)
}

BulkDeleteMessagesRequest type {
  channel_id: Str,
  messages: Vec<Str>,
  reason: Str?
}

bulk-delete-messages
meta {
    doc: """POST /channels/{channel_id}/messages/bulk-delete - Delete 2-100 messages at once. Messages older than 14 days are rejected. Needs MANAGE_MESSAGES. `reason` goes to the audit log."""
}
fn (request: BulkDeleteMessagesRequest): Bool {
  ::api/call-ok("POST", `/channels/${seg(request.channel_id)}/messages/bulk-delete`, {
    body: {messages: request.messages},
    reason: request.reason
  })
}

CrosspostMessageRequest type {
  channel_id: Str,
  message_id: Str
}

crosspost-message
meta {
    doc: """POST /channels/{channel_id}/messages/{message_id}/crosspost - Publish a message in an Announcement channel to every following channel."""
}
fn (request: CrosspostMessageRequest): Map {
  ::api/call("POST", `/channels/${seg(request.channel_id)}/messages/${seg(request.message_id)}/crosspost`)
}

// ============================================================================
// Reactions
// ============================================================================
// `emoji` is a Unicode emoji ("👍") or a custom emoji as `name:id`. It is
// URL-encoded for you; already-encoded input is passed through.

reaction-path fn (channel-id: Str, message-id: Str, emoji: Str): Str {
  `/channels/${seg(channel-id)}/messages/${seg(message-id)}/reactions/${::api/emoji-segment(emoji)}`
}

CreateReactionRequest type {
  channel_id: Str,
  message_id: Str,
  emoji: Str
}

create-reaction
meta {
    doc: """
    PUT /channels/{channel_id}/messages/{message_id}/reactions/{emoji}/@me - React to a message.

    **Example**

    ```hot
    ::messages ::discord::messages

    ::messages/create-reaction(::messages/CreateReactionRequest({
      channel_id: "1100000000000000000",
      message_id: "1200000000000000000",
      emoji: "👍"
    }))
    ```
    """
}
fn (request: CreateReactionRequest): Bool {
  ::api/call-ok("PUT", `${reaction-path(request.channel_id, request.message_id, request.emoji)}/@me`)
}

DeleteOwnReactionRequest type {
  channel_id: Str,
  message_id: Str,
  emoji: Str
}

delete-own-reaction
meta {
    doc: """DELETE /channels/{channel_id}/messages/{message_id}/reactions/{emoji}/@me - Remove the bot's own reaction."""
}
fn (request: DeleteOwnReactionRequest): Bool {
  ::api/call-ok("DELETE", `${reaction-path(request.channel_id, request.message_id, request.emoji)}/@me`)
}

DeleteUserReactionRequest type {
  channel_id: Str,
  message_id: Str,
  emoji: Str,
  user_id: Str
}

delete-user-reaction
meta {
    doc: """DELETE /channels/{channel_id}/messages/{message_id}/reactions/{emoji}/{user_id} - Remove another user's reaction. Needs MANAGE_MESSAGES."""
}
fn (request: DeleteUserReactionRequest): Bool {
  ::api/call-ok("DELETE", `${reaction-path(request.channel_id, request.message_id, request.emoji)}/${seg(request.user_id)}`)
}

GetReactionsRequest type {
  channel_id: Str,
  message_id: Str,
  emoji: Str,
  type: Int?,
  after: Str?,
  limit: Int?
}

get-reactions
meta {
    doc: """GET /channels/{channel_id}/messages/{message_id}/reactions/{emoji} - Users who reacted with `emoji` (up to `limit`, 1-100). `type` 0 = normal, 1 = super reactions. Page with `after` (a user id)."""
}
fn (request: GetReactionsRequest): Vec<Map> {
  ::api/call("GET", reaction-path(request.channel_id, request.message_id, request.emoji), {
    query: {type: request.type, after: request.after, limit: request.limit}
  })
}

