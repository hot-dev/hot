::modern-treasury::ledgers ns
meta {
    doc: """
    Modern Treasury Ledgers: a double-entry ledger for your own
    accounting. A ledger holds ledger accounts (each with a currency and a
    `normal_balance` of `"credit"` or `"debit"`); a ledger transaction is
    a set of ledger entries whose credits and debits balance. Balances
    come back as `pending_balance`, `posted_balance` and
    `available_balance`, each `{credits, debits, amount, currency}`.
    """
}

::api ::modern-treasury::api
seg ::modern-treasury::api/seg

// ---------------------------------------------------------------------------
// Ledgers
// ---------------------------------------------------------------------------

create-ledger
meta {
    doc: """
    POST /api/ledgers: create a ledger. `params` needs `name`; optional
    `description`, `metadata`.

    **Example**

    ```hot
    ledger ::modern-treasury::ledgers/create-ledger({name: "Wallets", metadata: {team: "payments"}})
    ledger.id
    ```
    """
}
fn
(params: Map): Map {
  create-ledger(params, {})
},
(params: Map, opts: Map): Map {
  ::api/create("/api/ledgers", params, ["name"], opts, "create-ledger")
}

get-ledger
meta {
    doc: """
    GET /api/ledgers/{id}: retrieve a ledger.

    **Example**

    ```hot
    ledger ::modern-treasury::ledgers/get-ledger("89c8bd30-e06a-4a79-b396-e6c7e13e7a12")
    ledger.name
    ```
    """
}
fn
(ledger-id: Str): Map {
  get-ledger(ledger-id, {})
},
(ledger-id: Str, opts: Map): Map {
  ::api/call("GET", `/api/ledgers/${seg(ledger-id)}`, {}, opts)
}

list-ledgers
meta {
    doc: """
    GET /api/ledgers: one page. Filters: `id: [...]` (sent as `id[]`),
    `metadata`, `updated_at: {gte, lte}`, `per_page`, `after_cursor`.

    **Example**

    ```hot
    page ::modern-treasury::ledgers/list-ledgers({per_page: 25})
    map(page.items, %.name)
    ```
    """
}
fn
(): Map {
  list-ledgers({})
},
(params: Map): Map {
  list-ledgers(params, {})
},
(params: Map, opts: Map): Map {
  ::api/list-page("/api/ledgers", params, opts)
}

update-ledger
meta {
    doc: """
    PATCH /api/ledgers/{id}: change `name`, `description` or `metadata`.

    **Example**

    ```hot
    ::modern-treasury::ledgers/update-ledger("89c8bd30-e06a-4a79-b396-e6c7e13e7a12", {description: "Customer wallets"})
    ```
    """
}
fn
(ledger-id: Str, params: Map): Map {
  update-ledger(ledger-id, params, {})
},
(ledger-id: Str, params: Map, opts: Map): Map {
  ::api/call("PATCH", `/api/ledgers/${seg(ledger-id)}`, params, opts)
}

// ---------------------------------------------------------------------------
// Ledger accounts
// ---------------------------------------------------------------------------

create-ledger-account
meta {
    doc: """
    POST /api/ledger_accounts: create a ledger account. `params` needs
    `ledger_id`, `name`, `currency` and `normal_balance` (`"credit"` for
    liabilities and revenue, `"debit"` for assets and expenses); optional
    `currency_exponent`, `description`, `external_id`, `metadata`,
    `ledger_account_category_ids`, `ledgerable_id`, `ledgerable_type`.

    **Example**

    ```hot
    ::modern-treasury::ledgers/create-ledger-account({
      ledger_id: "89c8bd30-e06a-4a79-b396-e6c7e13e7a12",
      name: "User 42 wallet",
      currency: "USD",
      normal_balance: "credit"
    }, {idempotency-key: "wallet-user-42"})
    ```
    """
}
fn
(params: Map): Map {
  create-ledger-account(params, {})
},
(params: Map, opts: Map): Map {
  ::api/create("/api/ledger_accounts", params, ["ledger_id", "name", "currency", "normal_balance"], opts, "create-ledger-account")
}

get-ledger-account
meta {
    doc: """
    GET /api/ledger_accounts/{id}: retrieve a ledger account (by id or
    `external_id`) with its balances. `balances` options: `as_of_date`,
    `effective_at`, `effective_at_lower_bound`, `effective_at_upper_bound`,
    `as_of_lock_version`.

    **Example**

    ```hot
    account ::modern-treasury::ledgers/get-ledger-account("f1c7e474-e6d5-4741-9f76-04510c8b6d7a")
    account.balances.posted_balance.amount

    // Balances at a point in time
    ::modern-treasury::ledgers/get-ledger-account("f1c7e474-e6d5-4741-9f76-04510c8b6d7a", {effective_at: "2026-11-01T00:00:00Z"})
    ```
    """
}
fn
(ledger-account-id: Str): Map {
  get-ledger-account(ledger-account-id, {})
},
(ledger-account-id: Str, balances: Map): Map {
  get-ledger-account(ledger-account-id, balances, {})
},
(ledger-account-id: Str, balances: Map, opts: Map): Map {
  ::api/call("GET", `/api/ledger_accounts/${seg(ledger-account-id)}`, if(is-empty(balances), {}, {balances: balances}), opts)
}

get-ledger-account-balances
meta {
    doc: """
    Just the balances of a ledger account: `{pending_balance,
    posted_balance, available_balance}`. `as-of` options as for
    `get-ledger-account` (e.g. `{effective_at: "2026-11-01T00:00:00Z"}`).

    **Example**

    ```hot
    b ::modern-treasury::ledgers/get-ledger-account-balances("f1c7e474-e6d5-4741-9f76-04510c8b6d7a", {})
    b.posted_balance.amount
    ```
    """
}
fn
(ledger-account-id: Str, as-of: Map): Map {
  get-ledger-account-balances(ledger-account-id, as-of, {})
},
(ledger-account-id: Str, as-of: Map, opts: Map): Map {
  account get-ledger-account(ledger-account-id, as-of, opts)
  if(is-err(account), account, or(get(account, "balances"), {}))
}

