::whatsapp::templates ns

::api ::whatsapp::api

// ============================================================================
// Message Templates
// ============================================================================

ListTemplatesRequest type {
  waba_id: Str,
  limit: Int?,
  after: Str?,
  before: Str?,
  status: Str?,
  name: Str?,
  category: Str?,
  language: Str?,
  fields: Vec<Str>?
}

list-templates-url
meta {
    doc: """The list URL with only the set filters, each URL-encoded; `fields` is comma-joined. Exposed for testing."""
}
fn (request: ListTemplatesRequest): Str {
  params {
    limit: request.limit,
    after: request.after,
    before: request.before,
    status: request.status,
    name: request.name,
    category: request.category,
    language: request.language,
    fields: if(is-some(request.fields), join(request.fields, ","), null)
  }

  ::api/url(`${::api/segment(request.waba_id)}/message_templates${::hot::uri/query-string(params)}`)
}

list-templates
meta {
    doc: """
GET /{waba-id}/message_templates - List message templates for a WhatsApp Business Account, one page at a time. Filters: `status` ("APPROVED", "PENDING", "REJECTED", ...), `name`, `category` ("UTILITY", "MARKETING", "AUTHENTICATION"), `language` (e.g. "en_US"). Page with `limit` and the cursor from `next-cursor(response)` as `after` (or `paging.cursors.before` as `before`). `fields` selects the returned fields, e.g. `["name", "status", "language", "components"]`.

**Example**

```hot
::templates ::whatsapp::templates

page ::templates/list-templates(::templates/ListTemplatesRequest({
  waba_id: "102938475610",
  status: "APPROVED",
  limit: 20
}))
page.data  // => [{name: "hello_world", status: "APPROVED", ...}, ...]

cursor ::templates/next-cursor(page)
next-page if(is-some(cursor),
  ::templates/list-templates(::templates/ListTemplatesRequest({waba_id: "102938475610", status: "APPROVED", limit: 20, after: cursor})),
  null)
```
"""
}
fn (request: ListTemplatesRequest): Map {
  ::api/request("GET", list-templates-url(request))
}

next-cursor
meta {
    doc: """The `after` cursor for the next page of a Graph API list response, or null on the last page (Graph omits `paging.next` there)."""
}
fn (response: Map): Str? {
  paging get(response, "paging")
  cond {
    not(is-map(paging)) => { null }
    is-null(get(paging, "next")) => { null }
    => {
      cursors get(paging, "cursors")
      if(is-map(cursors), get(cursors, "after"), null)
    }
  }
}

GetTemplateRequest type {
  template_id: Str
}

get-template
meta {
    doc: """GET /{template-id} - Get one message template by id."""
}
fn (request: GetTemplateRequest): Map {
  ::api/request("GET", ::api/url(::api/segment(request.template_id)))
}

CreateTemplateRequest type {
  waba_id: Str,
  name: Str,
  language: Str,
  category: Str,
  components: Vec<Map>,
  allow_category_change: Bool?,
  parameter_format: Str?
}

create-template
meta {
    doc: """
POST /{waba-id}/message_templates - Create a message template. Templates must be approved by Meta before they can be sent. `category` must be "UTILITY", "MARKETING", or "AUTHENTICATION". `parameter_format` is "POSITIONAL" (`{{1}}`, the default) or "NAMED" (`{{order_id}}`). `allow_category_change: true` lets Meta reassign the category instead of rejecting the template. Returns `{id, status, category}`.

**Example**

```hot
::templates ::whatsapp::templates

response ::templates/create-template(::templates/CreateTemplateRequest({
  waba_id: "102938475610",
  name: "order_update",
  language: "en_US",
  category: "UTILITY",
  components: [
    {type: "BODY", text: "Your order {{1}} has been shipped. Track: {{2}}"}
  ]
}))
response.id     // => "template-id-123"
response.status // => "PENDING"
```
"""
}
fn (request: CreateTemplateRequest): Map {
  body {
    name: request.name,
    language: request.language,
    category: request.category,
    components: request.components
  }
    |> assoc-some("allow_category_change", request.allow_category_change)
    |> assoc-some("parameter_format", request.parameter_format)

  ::api/request("POST", ::api/url(`${::api/segment(request.waba_id)}/message_templates`), {}, body)
}

EditTemplateRequest type {
  template_id: Str,
  components: Vec<Map>?,
  category: Str?
}

edit-template
meta {
    doc: """POST /{template-id} - Edit an existing message template. Only approved or rejected templates can be edited. Editing resubmits for approval."""
}
fn (request: EditTemplateRequest): Map {
  body {}
    |> assoc-some("components", request.components)
    |> assoc-some("category", request.category)

  ::api/request("POST", ::api/url(::api/segment(request.template_id)), {}, body)
}

DeleteTemplateRequest type {
  waba_id: Str,
  name: Str,
  hsm_id: Str?
}

delete-templates-url
meta {
    doc: """The delete URL: `name` always, `hsm_id` when set, both URL-encoded. Exposed for testing."""
}
fn (request: DeleteTemplateRequest): Str {
  params {name: request.name, hsm_id: request.hsm_id}
  ::api/url(`${::api/segment(request.waba_id)}/message_templates${::hot::uri/query-string(params)}`)
}

delete-template
meta {
    doc: """DELETE /{waba-id}/message_templates - Delete a message template by name. If `hsm_id` (the template id) is provided, only that template is deleted; otherwise every template with that name (all languages) is deleted. Returns `{success: true}`."""
}
fn (request: DeleteTemplateRequest): Map {
  ::api/request("DELETE", delete-templates-url(request))
}
