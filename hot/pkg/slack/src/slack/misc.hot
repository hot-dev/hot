views-open
meta {
    doc: """
    POST /views.open - Open a modal view for a user. Requires a valid
    `trigger_id` from an interactive event and a JSON-encoded view payload.

    **Example**

    ```hot
    view to-json({
      type: "modal",
      title: {type: "plain_text", text: "Feedback"},
      blocks: [{type: "section", text: {type: "mrkdwn", text: "How did it go?"}}]
    })

    response ::slack::misc/views-open(::slack::misc/ViewsOpenRequest({
      trigger_id: "13345224609.738474920.8088930838d88f008e0",
      view: view
    }))
    response.view.id
    ```
    """
}
fn
(request: ViewsOpenRequest): ViewsOpenResponse {
  views-open(request, {})
},
(request: ViewsOpenRequest, opts: Map): ViewsOpenResponse {
  response api-request("POST", `${::slack::core/BASE_URL}/views.open`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ViewsOpenResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

