::microsoft::graph::oauth ns
meta {
    doc: """
    Entra ID (Microsoft identity platform v2) OAuth helpers: the
    delegated authorization-code flow with PKCE and `offline_access`,
    refresh-token redemption (with rotation), and app-only client
    credentials. Built on `hot.dev/oauth2`.

    **Delegated flow**

    1. Make a PKCE verifier, store it with your `state`, and redirect the
       user to `authorize-url(...)`. `offline_access` is added for you,
       so Entra returns a refresh token.
    2. In your callback, `exchange-code(...)` turns `?code=` into tokens.
    3. Store `refresh_token` per user, then pass it per call as
       `{refresh-token, client-id}` opts (plus `client-secret` for a web
       app), or set `microsoft.oauth.refresh-token` for a single-user app.
    4. Entra rotates refresh tokens: every redemption returns a new one.
       After a run, persist `::microsoft::graph::auth/latest-refresh-token(opts)`.

    ```hot
    ::oauth ::microsoft::graph::oauth

    verifier ::oauth/pkce-verifier()
    url ::oauth/authorize-url(client-id, "https://app.example.com/oauth/microsoft",
      ["Files.Read.All", "Sites.Read.All"], state, {code-verifier: verifier})

    // callback handler:
    tokens ::oauth/exchange-code(client-id, null, request.query.code,
      "https://app.example.com/oauth/microsoft", {code-verifier: verifier})
    tokens.refresh_token
    ```

    **Consent.** `Files.Read`, `Files.ReadWrite`, `Sites.Read.All` and
    `User.Read` delegated permissions are user-consentable in most
    tenants; `*.All` application permissions and `Sites.Selected` always
    need a tenant admin. `admin-consent-url` builds the admin-consent
    link for app-only permissions.
    """
}

::graph ::microsoft::graph
::auth ::microsoft::graph::auth
::oauth2 ::oauth2
::uri ::hot::uri

pkce-verifier ::oauth2/pkce-verifier
pkce-challenge ::oauth2/pkce-challenge

// Both read through the package's one resolver (`::auth/merge-sources` over
// `::auth/ctx-source`), so per-call opts win and nothing is written to ctx.
endpoints fn (opts: Map): Map {
  ::auth/cloud-config(::auth/merge-sources(::auth/pick(opts, ::auth/IDENTITY_KEYS), ::auth/ctx-source()))
}

tenant-of fn (opts: Map): Str {
  t get(::auth/merge-sources(::auth/pick(opts, ::auth/IDENTITY_KEYS), ::auth/ctx-source()), "tenant-id")
  if(::auth/is-blank-value(t), ::graph/DEFAULT_TENANT, trim(Str(t)))
}

authorize-scopes
meta {
    doc: """The `scope` value `authorize-url` sends (pure): the normalised scopes plus `offline_access` (unless `offline` is false), space-separated."""
}
fn (scopes: Any, graph: Str, offline: Bool): Str {
  base ::auth/normalize-scopes(scopes, graph)
  all if(and(offline, not(in("offline_access", base))), concat(base, ["offline_access"]), base)
  join(all, " ")
}

build-authorize-params
meta {
    doc: """
    The Entra-specific authorization parameters for `authorize-url`
    (pure). Options (all optional):

    - `code-verifier` - a PKCE verifier; its S256 challenge is sent
    - `code-challenge` - a precomputed S256 challenge (instead)
    - `prompt` - `"select_account"`, `"consent"`, `"login"`, `"none"`
    - `login-hint` - pre-fill the account (UPN or email)
    - `domain-hint` - skip home-realm discovery (`"consumers"`, `"organizations"`, or a domain)
    - `response-mode` - `"query"` (default) or `"form_post"`
    - `extra` - any other parameters, merged last
    """
}
fn (opts: Map): Map {
  verifier get(opts, "code-verifier")
  challenge or(get(opts, "code-challenge"), if(::auth/is-blank-value(verifier), null, pkce-challenge(verifier)))
  {
    params: filter-vals({
      prompt: get(opts, "prompt"),
      login_hint: get(opts, "login-hint"),
      domain_hint: get(opts, "domain-hint"),
      response_mode: get(opts, "response-mode"),
      ...or(get(opts, "extra"), {})
    }, is-some),
    code-challenge: challenge
  }
}

authorize-url
meta {
    doc: """
    Build the Entra sign-in URL for the delegated authorization-code
    flow. `scopes` is a Vec or space/comma-separated Str of delegated
    permissions (`"Files.Read.All Sites.Read.All"`); `offline_access` is
    added unless `opts.offline` is false. `opts.tenant-id` (default the
    `microsoft.tenant.id` context variable, else `common`) and
    `opts.cloud` pick the authority. Use PKCE (`code-verifier`) for
    every client; it is required for public and single-page apps.

    ```hot
    verifier ::microsoft::graph::oauth/pkce-verifier()
    url ::microsoft::graph::oauth/authorize-url("11111111-2222-3333-4444-555555555555",
      "https://app.example.com/oauth/microsoft", "Files.Read.All User.Read", "csrf-123",
      {code-verifier: verifier, prompt: "select_account"})
    ```
    """
}
fn
(client-id: Str, redirect-uri: Str, scopes: Str | Vec, state: Str): Str {
  authorize-url(client-id, redirect-uri, scopes, state, {})
},
(client-id: Str, redirect-uri: Str, scopes: Str | Vec, state: Str, opts: Map): Str {
  cloud endpoints(opts)
  cond {
    is-err(cloud) => { cloud }
    => {
      built build-authorize-params(opts)
      ::oauth2/authorize-url(filter-vals({
        authorize-url: ::auth/authorize-endpoint(cloud.login, tenant-of(opts)),
        client-id: client-id,
        redirect-uri: redirect-uri,
        scope: authorize-scopes(scopes, cloud.graph, ne(get(opts, "offline"), false)),
        state: if(::auth/is-blank-value(state), null, state),
        code-challenge: built.code-challenge,
        extra: built.params
      }, is-some))
    }
  }
}

admin-consent-url
meta {
    doc: """
    The admin-consent URL for an app's configured application
    permissions (`{login}/{tenant}/v2.0/adminconsent`, scope
    `{graph}/.default`). A tenant admin opens it once per tenant;
    Entra then redirects to `redirect-uri` with `admin_consent=True` and
    `tenant`. `opts.tenant-id` defaults to `organizations`.
    """
}
fn
(client-id: Str, redirect-uri: Str, state: Str): Str {
  admin-consent-url(client-id, redirect-uri, state, {})
},
(client-id: Str, redirect-uri: Str, state: Str, opts: Map): Str {
  cloud endpoints(opts)
  tenant or(get(opts, "tenant-id"), "organizations")
  cond {
    is-err(cloud) => { cloud }
    => {
      qs ::uri/encode-query(filter-vals({
        client_id: client-id,
        redirect_uri: redirect-uri,
        scope: `${cloud.graph}/.default`,
        state: if(::auth/is-blank-value(state), null, state)
      }, is-some))
      `${cloud.login}/${::uri/encode(tenant)}/v2.0/adminconsent?${qs}`
    }
  }
}

exchange-code
meta {
    doc: """
    Exchange an authorization code for tokens. Returns Entra's token
    response (`access_token`, `expires_in`, `refresh_token`, `scope`,
    `token_type`, `id_token` when `openid` was requested; the tokens are
    marked as secrets), or a `::microsoft::graph::auth/TokenError`. `opts.code-verifier`
    completes a PKCE flow; `opts.tenant-id` / `opts.cloud` must match
    `authorize-url`. Pass a null `client-secret` for public clients;
    `opts.private-key` + `opts.certificate` authenticate a confidential
    client with a certificate instead of a secret.
    """
}
fn
(client-id: Str, client-secret: Str?, code: Str, redirect-uri: Str): Map {
  exchange-code(client-id, client-secret, code, redirect-uri, {})
},
(client-id: Str, client-secret: Str?, code: Str, redirect-uri: Str, opts: Map): Map {
  ::auth/mark-values([client-secret, code, get(opts, "private-key")])
  cloud endpoints(opts)
  auth ::auth/client-auth-from(::auth/compact({
    client-secret: client-secret,
    private-key: get(opts, "private-key"),
    certificate: get(opts, "certificate"),
    thumbprint: get(opts, "thumbprint"),
    thumbprint-sha256: get(opts, "thumbprint-sha256")
  }))
  cond {
    is-err(cloud) => { cloud }
    is-err(auth) => { auth }
    => {
      url ::auth/token-url(cloud.login, tenant-of(opts))
      client ::auth/client-auth-params(auth, client-id, url)
      cond {
        is-err(client) => { client }
        => {
          body filter-vals({
            grant_type: "authorization_code",
            client_id: client-id,
            code: code,
            redirect_uri: redirect-uri,
            code_verifier: get(opts, "code-verifier"),
            scope: if(is-some(get(opts, "scopes")), join(::auth/normalize-scopes(get(opts, "scopes"), cloud.graph), " "), null),
            ...client
          }, is-some)
          ::auth/token-request(url, body, "microsoft-graph: token exchange failed")
        }
      }
    }
  }
}

refresh-access-token
meta {
    doc: """
    Redeem a refresh token (no cache) and return Entra's token response:
    `access_token`, `expires_in`, `scope`, and the **rotated**
    `refresh_token`; store the new one, it replaces the old. `opts` takes
    `client-secret` (or `private-key` + `certificate`) for confidential
    apps, `scopes`, `tenant-id` and `cloud`. A revoked or expired refresh
    token yields `error-code: "invalid_grant"`: send the user through
    consent again.

    ```hot
    tokens ::microsoft::graph::oauth/refresh-access-token(client-id, stored-refresh-token, {client-secret: secret})
    ::hot::store/put(tokens-store, user-id, tokens.refresh_token)
    ```
    """
}
fn
(client-id: Str, refresh-token: Str): Map {
  refresh-access-token(client-id, refresh-token, {})
},
(client-id: Str, refresh-token: Str, opts: Map): Map {
  ::auth/mark-secrets(opts, ::auth/SECRET_KEYS)
  ::auth/mark-values([refresh-token])
  source {...::auth/compact(::auth/pick(opts, ::auth/CREDENTIAL_KEYS)), client-id: client-id, refresh-token: refresh-token, token: null}
  creds ::auth/credentials-from(::auth/compact(source))
  cond {
    is-err(creds) => { creds }
    => { ::auth/redeem-refresh-token(creds, refresh-token, ::auth/delegated-scopes(opts, creds.cloud.graph)) }
  }
}

client-credentials
meta {
    doc: """
    Mint an app-only token (client credentials grant, no cache) for
    `{graph}/.default`. `opts` needs `client-secret`, or `private-key`
    plus `certificate` (or `thumbprint`), and takes `cloud`. Returns the
    token response or a `TokenError`. Usually you let
    `::microsoft::graph::api/request` do this for you.
    """
}
fn (tenant-id: Str, client-id: Str, opts: Map): Map {
  ::auth/mark-secrets(opts, ::auth/SECRET_KEYS)
  source ::auth/compact({...::auth/pick(opts, ::auth/CREDENTIAL_KEYS), tenant-id: tenant-id, client-id: client-id, token: null, refresh-token: null})
  creds ::auth/credentials-from(source)
  cond {
    is-err(creds) => { creds }
    => { ::auth/client-credentials-token(creds, ::auth/app-scopes(creds.cloud.graph)) }
  }
}

granted-scopes
meta {
    doc: """The scopes a token response says were granted (`scope` split on spaces). Check it after consent: users and admins can decline permissions."""
}
fn (tokens: Map): Vec {
  ::auth/normalize-scopes(or(tokens.scope, ""))
}

missing-scopes
meta {
    doc: """The `required` scopes (Vec or Str) a token response did not grant, compared case-insensitively and ignoring a `https://graph.microsoft.com/` prefix. Empty when everything was granted."""
}
fn (tokens: Map, required: Str | Vec): Vec {
  strip (s) { lowercase(replace(s, "https://graph.microsoft.com/", "")) }
  granted map(granted-scopes(tokens), strip)
  filter(::auth/normalize-scopes(required), (s) { not(in(strip(s), granted)) })
}
