// ============================================================================
// Prune
// ============================================================================

GetGuildPruneCountRequest type {
  guild_id: Str,
  days: Int?,
  include_roles: Vec<Str>?
}

get-guild-prune-count
meta {
    doc: """
    GET /guilds/{guild_id}/prune - How many members a prune of inactive
    (`days`, 1-30, default 7) members would remove. Needs MANAGE_GUILD and
    KICK_MEMBERS.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    estimate ::guilds/get-guild-prune-count(::guilds/GetGuildPruneCountRequest({
      guild_id: "1000000000000000000",
      days: 30
    }))
    estimate.pruned
    ```
    """
}
fn
(request: GetGuildPruneCountRequest): Map {
  get-guild-prune-count(request, {})
},
(request: GetGuildPruneCountRequest, opts: Map): Map {
  roles if(is-null(request.include_roles), null, join(request.include_roles, ","))
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/prune`, {query: {days: request.days, include_roles: roles}}, opts)
}

BeginGuildPruneRequest type {
  guild_id: Str,
  days: Int?,
  compute_prune_count: Bool?,
  include_roles: Vec<Str>?,
  reason: Str?
}

begin-guild-prune
meta {
    doc: """
    POST /guilds/{guild_id}/prune - Kick members inactive for `days`. Set
    `compute_prune_count: false` on large guilds. Returns `{pruned}`. Needs
    MANAGE_GUILD and KICK_MEMBERS.

    **Example**

    ```hot
    ::guilds ::discord::guilds

    ::guilds/begin-guild-prune(::guilds/BeginGuildPruneRequest({
      guild_id: "1000000000000000000",
      days: 30,
      compute_prune_count: false,
      reason: "Quarterly cleanup"
    }))
    ```
    """
}
fn
(request: BeginGuildPruneRequest): Map {
  begin-guild-prune(request, {})
},
(request: BeginGuildPruneRequest, opts: Map): Map {
  ::api/call("POST", `/guilds/${seg(request.guild_id)}/prune`, {
    body: ::api/body(request, ["guild_id"]),
    reason: request.reason
  }, opts)
}

