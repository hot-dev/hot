::companies-house::api ns
meta {
    ctx: {
        "companies-house.api-key": {required: false},
        "companies-house.base-url": {required: false, secret: false},
        "companies-house.document-base-url": {required: false, secret: false}
    },
    doc: """
    Transport for Companies House: the settings resolver (per-call
    `opts` first, then context variables, then defaults), a typed
    `HttpError`, JSON GETs, and query-string building that drops unset
    values.

    | opts key | Context variable | Default |
    |---|---|---|
    | `api-key` | `companies-house.api-key` | none: calls fail without it |
    | `base-url` | `companies-house.base-url` | `https://api.company-information.service.gov.uk` |
    | `document-base-url` | `companies-house.document-base-url` | `https://document-api.company-information.service.gov.uk` |

    **Per-call credentials.** `api-key` in `opts` is masked in call
    records and never written to context, so parallel flows and tenants
    in one run don't see each other's keys. Present but blank or null, it
    is an error, never a fallback to context. A per-call `base-url` or
    `document-base-url` needs an `api-key` in the same `opts`: the
    context key is never sent to a per-call URL.
    """
}

::ctx ::hot::ctx
::uri ::hot::uri
::re ::hot::regex

is-ok-response ::hot::http/is-ok-response
HttpRequest ::hot::http/HttpRequest
HttpResponse ::hot::http/HttpResponse

SOURCE "companies-house"
BASE_URL "https://api.company-information.service.gov.uk"
DOCUMENT_BASE_URL "https://document-api.company-information.service.gov.uk"
PACKAGE_AGENT "hot-dev-companies-house-pkg/0.1 (+https://hot.dev)"

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

given
meta {
    doc: """
    True for a non-null value that is not a blank string.

    **Example**

    ```hot
    ::companies-house::api/given("x")  // true
    ::companies-house::api/given("  ")  // false
    ::companies-house::api/given(null)  // false
    ```
    """
}
fn (v: Any): Bool {
  match v {
    Null => { false }
    Str => { not(is-empty(trim(v))) }
    _ => { true }
  }
}

pick
meta {no-doc: true}
fn (opts: Map, key: Str, ctx-key: Str, default: Any): Any {
  from-opts get(opts, key)
  from-ctx ::ctx/get(ctx-key)
  cond {
    given(from-opts) => { from-opts }
    given(from-ctx) => { from-ctx }
    => { default }
  }
}

// Per-call URLs that receive the API key.
KEYED_URL_KEYS ["base-url", "document-base-url"]

strip-slash
meta {no-doc: true}
fn (url: Str): Str {
  ::re/replace-all(url, "/+$", "")
}

resolve
meta {
    doc: """
    Resolve settings for one call: `{api-key, base-url,
    document-base-url}`. Values in `opts` win over context; an `api-key`
    in `opts` is used for that call only and comes back unchanged. An
    Err when `api-key` is in `opts` but blank or null, or when `opts`
    has a URL without `api-key`.

    **Example**

    ```hot
    cfg ::companies-house::api/resolve({api-key: ::hot::ctx/get("tenant.companies-house-key")})
    cfg.base-url
    ```
    """
}
fn (opts: Map): Map {
  from-opts get(opts, "api-key")
  ::ctx/mark-secret(filter([from-opts], given))
  keyed-url find-first(KEYED_URL_KEYS, (k) { given(get(opts, k)) })
  cond {
    and(in("api-key", keys(opts)), not(given(from-opts))) => {
      err("companies-house: api-key is in the call's opts but is blank or null. Pass a value, or leave api-key out to use the context variable.")
    }

    and(is-some(keyed-url), not(given(from-opts))) => {
      err(`companies-house: ${keyed-url} is in the call's opts without api-key. Pass api-key with it. The context key is never sent to a per-call URL.`)
    }
    => {
      {
        api-key: pick(opts, "api-key", "companies-house.api-key", null),
        base-url: strip-slash(pick(opts, "base-url", "companies-house.base-url", BASE_URL)),
        document-base-url: strip-slash(pick(opts, "document-base-url", "companies-house.document-base-url", DOCUMENT_BASE_URL))
      }
    }
  }
}

require-api-key
meta {
    doc: """
    The API key from resolved settings, or an Err naming where to set it.

    **Example**

    ```hot
    cfg ::companies-house::api/resolve({})
    key ::companies-house::api/require-api-key(cfg)
    ```
    """
}
fn (cfg: Map): Str {
  cond {
    given(cfg.api-key) => { cfg.api-key }
    => { err("companies-house: no API key; set companies-house.api-key or pass {api-key: ...}") }
  }
}

// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------

HttpError
meta {
    doc: """
    A non-2xx Companies House response. `source` is `"companies-house"`; `url` the
    requested URL (Companies House takes no credentials in URLs); `retry-after`
    the parsed `Retry-After` seconds on 429s; `message` a one-line
    summary that never includes credentials.
    """
}
type {
    source: Str,
    status: Int,
    url: Str,
    headers: Map,
    body: Any,
    retry-after: Int?,
    message: Str
}

body-detail
meta {no-doc: true}
fn (body: Any): Str? {
  cond {
    is-str(body) => { if(gt(length(body), 200), `${slice(body, 0, 200)}…`, body) }
    is-map(body) => {
      // Companies House: {errors: [{error}]} or {error}
      first-error if(is-vec(get(body, "errors")), first(get(body, "errors")), null)
      or(
        get(or(first-error, {}), "detail"),
        get(or(first-error, {}), "title"),
        get(or(first-error, {}), "error"),
        get(body, "error"),
        get(body, "message")
      )
    }
    => { null }
  }
}

retry-after
meta {no-doc: true}
fn (headers: Map): Int? {
  v get(headers, "retry-after")
  cond {
    is-null(v) => { null }
    ::re/is-match(trim(Str(v)), "^\\d+$") => { Int(trim(Str(v))) }
    => { null }
  }
}

http-error
meta {
    doc: """
    Build an `HttpError` from a non-2xx response. Exposed for testing; every
    request uses it.

    **Example**

    ```hot
    e ::companies-house::api/http-error({status: 404, headers: {}, body: {errors: [{error: "company-profile-not-found"}]}}, "https://api.company-information.service.gov.uk/company/00000000")
    e.message  // "companies-house: HTTP 404: company-profile-not-found"
    ```
    """
}
fn (response: HttpResponse, url: Str): HttpError {
  headers or(response.headers, {})
  detail body-detail(response.body)
  HttpError({
    source: SOURCE,
    status: response.status,
    url: url,
    headers: headers,
    body: response.body,
    retry-after: retry-after(headers),
    message: if(is-some(detail), `${SOURCE}: HTTP ${response.status}: ${detail}`, `${SOURCE}: HTTP ${response.status} for ${url}`)
  })
}

is-not-found
meta {
    doc: """
    True when `e` is an `HttpError` with status 404.

    **Example**

    ```hot
    ::companies-house::api/is-not-found({status: 404})  // true
    ::companies-house::api/is-not-found({status: 429})  // false
    ```
    """
}
fn (e: Any): Bool {
  and(is-map(e), eq(get(e, "status"), 404))
}

// ---------------------------------------------------------------------------
// Requests
// ---------------------------------------------------------------------------

query-string
meta {
    doc: """
    Build a `?a=1&b=2` suffix from a Map, dropping null and blank values
    (pure); `""` when nothing remains.

    **Example**

    ```hot
    ::companies-house::api/query-string({q: "tesco", start_index: null})  // "?q=tesco"
    ::companies-house::api/query-string({q: ""})  // ""
    ```
    """
}
fn (params: Map): Str {
  ::uri/query-string(filter-vals(params, given))
}

path-segment
meta {
    doc: """
    Percent-encode one path segment.

    **Example**

    ```hot
    ::companies-house::api/path-segment("a b")  // "a%20b"
    ```
    """
}
fn (value: Any): Str {
  ::uri/encode(Str(value))
}

request
meta {
    doc: """
    GET (or another method) a Companies House URL with `headers`, returning
    the `HttpResponse` on 2xx or an Err carrying `HttpError`. A
    transport failure passes through as its own Err.

    **Example**

    ```hot
    key ::hot::ctx/get("companies-house.api-key")
    headers {Authorization: ::companies-house/auth-header(key)}
    response ::companies-house::api/request("GET", "https://api.company-information.service.gov.uk/company/00445790", headers)
    response.status
    ```
    """
}
fn (method: Str, url: Str, headers: Map): HttpResponse {
  response ::hot::http/request(HttpRequest({
    method,
    url,
    headers: {User-Agent: PACKAGE_AGENT, ...headers},
    body: ""
  }))
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { response }
    => { err(http-error(response, url)) }
  }
}

get-json
meta {
    doc: """
    GET a JSON resource and return the decoded body, or an Err carrying
    `HttpError`.

    **Example**

    ```hot
    key ::hot::ctx/get("companies-house.api-key")
    headers {Authorization: ::companies-house/auth-header(key)}
    profile ::companies-house::api/get-json("https://api.company-information.service.gov.uk/company/00445790", headers)
    profile.company_name
    ```
    """
}
fn (url: Str, headers: Map): Any {
  response request("GET", url, {Accept: "application/json", ...headers})
  cond {
    is-err(response) => { response }
    is-str(response.body) => {
      text trim(response.body)
      if(or(::hot::str/starts-with(text, "{"), ::hot::str/starts-with(text, "[")), from-json(text), response.body)
    }
    => { response.body }
  }
}

get-json-or-null
meta {
    doc: """
    `get-json`, but a 404 gives null (a missing company) instead of an Err.

    **Example**

    ```hot
    key ::hot::ctx/get("companies-house.api-key")
    headers {Authorization: ::companies-house/auth-header(key)}
    profile ::companies-house::api/get-json-or-null("https://api.company-information.service.gov.uk/company/00000000", headers)
    is-null(profile)
    ```
    """
}
fn (url: Str, headers: Map): Any {
  out get-json(url, headers)
  cond {
    and(is-err(out), is-not-found(err-value(out))) => { null }
    => { out }
  }
}
