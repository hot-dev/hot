::hot::pkg ns

hot.pkg.cal-com {
  name: "hot.dev/cal-com",
  version: "0.1.0",
  hot-min-version: "3.0.0",
  description: "Cal.com API v2 bindings for Hot. Event types, availability schedules and slots, bookings (paged lists, confirm, decline, cancel, reschedule, no-shows), profile, and webhooks with X-Cal-Signature-256 verification.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["cal-com", "scheduling", "calendar"],
  deps: {},
  src-paths: ["src/"],
  test-paths: ["test/"]
}
