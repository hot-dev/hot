::hot::pkg ns

hot.pkg.crm {
  name: "hot.dev/crm",
  version: "0.1.0",
  hot-min-version: "3.0.2",
  description: "CRM-agnostic contacts, companies, deals, and activities for Hot agents and workflows: one normalized surface over HubSpot, Salesforce, and Attio, with the provider chosen per call, by crm.provider, or by whichever credentials are configured.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["crm", "agents", "hubspot", "salesforce", "attio"],
  deps: {
    "hot.dev/hubspot": "0.1.0",
    "hot.dev/salesforce": "0.1.0",
    "hot.dev/attio": "0.2.0"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
