::sentry ns
meta {
    doc: """
    Sentry API bindings.

    - `::sentry::issues` — search, read, update (single and bulk), events, comments
    - `::sentry::releases` — releases, commits, finalize, and deploys (the CI path)
    - `::sentry::projects` — projects and teams
    - `::sentry::webhooks` — integration-platform webhook verification
    - `::sentry::api` — base URL, auth, errors, cursor pagination, raw calls

    **Setup** — context variables:
    - `sentry.token` — an organization auth token (`sntrys_...`) or a user auth token
    - `sentry.org` — the organization slug
    - `sentry.base.url` — optional: self-hosted or explicit region host (default `https://sentry.io`)
    - `sentry.region` — optional: `us` or `de`, to call `https://{region}.sentry.io`
    - `sentry.webhook.secret` — an integration's client secret, for `::sentry::webhooks`

    The token, organization, and host can also come per call, in the
    trailing `opts` Map of any API-calling function (see `::sentry::api`).

    **Quick start**

    ```hot
    ::issues ::sentry::issues

    fresh ::issues/list-issues({project: "my-api", query: "is:unresolved firstSeen:-24h", statsPeriod: "24h"})
    latest ::issues/get-latest-event(first(fresh.items).id)
    ::issues/resolve-issue(first(fresh.items).id)
    ```
    """
}

DEFAULT_BASE_URL "https://sentry.io"
