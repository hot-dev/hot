(request: GetTeamsRequest, opts: Map): Map {
  ::api/call("admin.conversations.getTeams", request, opts)
}

get-teams-all
meta {
    doc: """
    Every `team_ids` entry from `admin.conversations.getTeams`, following
    `next_cursor` until the last page or `max-items` (default 1000).
    `request` sets the filters; its `cursor` is the starting point.

    **Example**

    ```hot
    ::conversations ::slack::admin::conversations

    teams ::conversations/get-teams-all(::conversations/GetTeamsRequest({channel_id: "C0123ABCDEF"}))
    length(teams)
    ```
    """
}
fn
(request: GetTeamsRequest): Vec {
  get-teams-all(request, 1000)
},
(request: GetTeamsRequest, max-items: Int): Vec {
  get-teams-all(request, max-items, {})
},
(request: GetTeamsRequest, max-items: Int, opts: Map): Vec {
  ::api/paginate("admin.conversations.getTeams", request, "team_ids", max-items, opts)
}

