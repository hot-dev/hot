::cloudflare::cache ns
meta {
    doc: """
    Cloudflare cache purge (POST /zones/{zone_id}/purge_cache). Send one
    kind of target per call. Success means Cloudflare accepted the purge;
    per-request item limits and rate limits depend on the plan (see
    https://developers.cloudflare.com/cache/how-to/purge-cache/). The
    token needs the Zone → Cache Purge permission.
    """,
    ctx: {"cloudflare.token": {required: false}}
}

::api ::cloudflare::api

purge
meta {
    doc: """
    POST /zones/{zone_id}/purge_cache with an explicit body: one of
    `{files}`, `{tags}`, `{hosts}`, `{prefixes}`, or `{purge_everything: true}`.
    Returns `{id}`.

    **Example**

    ```hot
    ::cloudflare::cache/purge("023e105f4ecef8ad9ca31a8372d0c353", {tags: ["pricing"]})

    // Act for another account
    ::cloudflare::cache/purge("023e105f4ecef8ad9ca31a8372d0c353", {hosts: ["www.example.com"]}, {token: ::hot::ctx/get("tenant-b.cloudflare.token")})
    ```
    """
}
fn
(zone-id: Str, body: Map): Map {
  purge(zone-id, body, {})
},
(zone-id: Str, body: Map, opts: Map): Map {
  ::api/json("POST", `/zones/${::api/seg(zone-id)}/purge_cache`, body, opts)
}

purge-urls
meta {
    doc: """
    Purge specific URLs. Each entry is a URL string, or
    `{url, headers}` when the cache key varies on request headers
    (`CF-Device-Type`, `CF-IPCountry`, `Accept-Language`, `Origin`).

    **Example**

    ```hot
    zone-id "023e105f4ecef8ad9ca31a8372d0c353"
    ::cloudflare::cache/purge-urls(zone-id, ["https://example.com/", "https://example.com/pricing"])
    ```
    """
}
fn
(zone-id: Str, urls: Vec): Map {
  purge-urls(zone-id, urls, {})
},
(zone-id: Str, urls: Vec, opts: Map): Map {
  purge(zone-id, {files: urls}, opts)
}

purge-tags
meta {
    doc: """
    Purge everything whose `Cache-Tag` response header carries any of
    `tags`.

    **Example**

    ```hot
    ::cloudflare::cache/purge-tags("023e105f4ecef8ad9ca31a8372d0c353", ["pricing", "homepage"])
    ```
    """
}
fn
(zone-id: Str, tags: Vec<Str>): Map {
  purge-tags(zone-id, tags, {})
},
(zone-id: Str, tags: Vec<Str>, opts: Map): Map {
  purge(zone-id, {tags: tags}, opts)
}

purge-hosts
meta {
    doc: """
    Purge everything cached for the given hostnames (e.g.
    `["www.example.com"]`).

    **Example**

    ```hot
    ::cloudflare::cache/purge-hosts("023e105f4ecef8ad9ca31a8372d0c353", ["www.example.com"])
    ```
    """
}
fn
(zone-id: Str, hosts: Vec<Str>): Map {
  purge-hosts(zone-id, hosts, {})
},
(zone-id: Str, hosts: Vec<Str>, opts: Map): Map {
  purge(zone-id, {hosts: hosts}, opts)
}

purge-prefixes
meta {
    doc: """
    Purge by URL prefix: hostname plus path, no scheme, query, or fragment
    (e.g. `["www.example.com/blog/"]`).

    **Example**

    ```hot
    ::cloudflare::cache/purge-prefixes("023e105f4ecef8ad9ca31a8372d0c353", ["www.example.com/blog/"])
    ```
    """
}
fn
(zone-id: Str, prefixes: Vec<Str>): Map {
  purge-prefixes(zone-id, prefixes, {})
},
(zone-id: Str, prefixes: Vec<Str>, opts: Map): Map {
  purge(zone-id, {prefixes: prefixes}, opts)
}

purge-everything
meta {
    doc: """
    Purge the zone's entire cache. Expect a burst of origin traffic
    afterwards.

    **Example**

    ```hot
    ::cloudflare::cache/purge-everything("023e105f4ecef8ad9ca31a8372d0c353")
    ```
    """
}
fn
(zone-id: Str): Map {
  purge-everything(zone-id, {})
},
(zone-id: Str, opts: Map): Map {
  purge(zone-id, {purge_everything: true}, opts)
}
