::stripe::checkout ns
meta {
    doc: """Checkout Sessions: Stripe-hosted (or embedded) payment, subscription, and setup pages. See https://docs.stripe.com/api/checkout/sessions."""
}

api-call ::stripe::api/call
seg ::stripe::api/encode-id
RequestOptions ::stripe::api/RequestOptions

// ============================================================================
// Checkout Sessions
// ============================================================================
// Checkout Sessions power Stripe-hosted payment pages. Create a session,
// redirect the customer to `session.url`, and listen for the
// `checkout.session.completed` webhook.

CreateCheckoutSessionRequest type {
  mode: Str,
  line_items: Vec<Map>?,
  success_url: Str?,
  cancel_url: Str?,
  return_url: Str?,
  ui_mode: Str?,
  customer: Str?,
  customer_email: Str?,
  customer_creation: Str?,
  customer_update: Map?,
  client_reference_id: Str?,
  currency: Str?,
  locale: Str?,
  metadata: Map?,
  allowed_payment_method_types: Vec<Str>?,
  excluded_payment_method_types: Vec<Str>?,
  payment_method_collection: Str?,
  subscription_data: Map?,
  payment_intent_data: Map?,
  setup_intent_data: Map?,
  allow_promotion_codes: Bool?,
  discounts: Vec<Map>?,
  automatic_tax: Map?,
  tax_id_collection: Map?,
  billing_address_collection: Str?,
  shipping_address_collection: Map?,
  phone_number_collection: Map?,
  invoice_creation: Map?,
  submit_type: Str?,
  expires_at: Int?,
  expand: Vec<Str>?
}

create-checkout-session
meta {
    doc: """
POST /v1/checkout/sessions - Create a Checkout Session. `mode` is "payment", "subscription", or "setup". Redirect the customer to the returned `url`, then fulfil on the `checkout.session.completed` webhook. `ui_mode` is "hosted_page" (default), "embedded_page", "elements", or "form"; embedded and elements modes use `return_url` instead of `success_url`/`cancel_url`. To restrict methods use `allowed_payment_method_types` (the API removed `payment_method_types` in 2026-09-30.endive).

**Example**

```hot
::checkout ::stripe::checkout

session ::checkout/create-checkout-session(::checkout/CreateCheckoutSessionRequest({
  mode: "payment",
  line_items: [{price: "price_...", quantity: 1}],
  success_url: "https://example.com/success?session_id={CHECKOUT_SESSION_ID}",
  cancel_url: "https://example.com/cancel"
}))
session.url  // => "https://checkout.stripe.com/c/pay/cs_..."
```
"""
}
fn
(request: CreateCheckoutSessionRequest): Map {
  create-checkout-session(request, RequestOptions({}))
},
(request: CreateCheckoutSessionRequest, options: RequestOptions | Map): Map {
  api-call("POST", "/v1/checkout/sessions", request, options)
}

get-checkout-session
meta {
    doc: """
    GET /v1/checkout/sessions/{session} - Retrieve a Checkout Session by ID.
    Check `payment_status` ("paid", "unpaid", "no_payment_required") after
    redirect. Optional `params` such as `{expand: ["line_items",
    "subscription"]}`.

    **Example**

    ```hot
    ::checkout ::stripe::checkout

    session ::checkout/get-checkout-session("cs_test_123", {expand: ["line_items"]})
    is-paid eq(session.payment_status, "paid")
    ```
    """
}
fn
(session: Str): Map {
  get-checkout-session(session, {})
},
(session: Str, params: Map): Map {
  get-checkout-session(session, params, {})
},
(session: Str, params: Map, opts: Map): Map {
  api-call("GET", `/v1/checkout/sessions/${seg(session)}`, params, opts)
}

update-checkout-session
meta {
    doc: """
    POST /v1/checkout/sessions/{session} - Update an open Checkout Session.
    `params` takes the API's fields directly: `metadata`, `line_items`,
    `shipping_options`, `collected_information`.

    **Example**

    ```hot
    ::checkout ::stripe::checkout

    ::checkout/update-checkout-session("cs_test_123", {metadata: {order_id: "42"}})
    ```
    """
}
fn
(session: Str, params: Map): Map {
  update-checkout-session(session, params, {})
},
(session: Str, params: Map, opts: Map): Map {
  api-call("POST", `/v1/checkout/sessions/${seg(session)}`, params, opts)
}

expire-checkout-session
meta {
    doc: """
    POST /v1/checkout/sessions/{session}/expire - Expire an open Checkout
    Session so it can no longer be used.

    **Example**

    ```hot
    ::checkout ::stripe::checkout

    expired ::checkout/expire-checkout-session("cs_test_123")
    expired.status
    ```
    """
}
fn
(session: Str): Map {
  expire-checkout-session(session, {})
},
(session: Str, opts: Map): Map {
  api-call("POST", `/v1/checkout/sessions/${seg(session)}/expire`, {}, opts)
}

ListCheckoutSessionsRequest type {
  customer: Str?,
  customer_details: Map?,
  payment_intent: Str?,
  payment_link: Str?,
  subscription: Str?,
  status: Str?,
  created: Any?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-checkout-sessions
meta {
    doc: """
    GET /v1/checkout/sessions - List Checkout Sessions. Filter by
    `customer`, `payment_intent`, `subscription`, or `status` ("open",
    "complete", "expired").

    **Example**

    ```hot
    ::checkout ::stripe::checkout

    page ::checkout/list-checkout-sessions(::checkout/ListCheckoutSessionsRequest({customer: "cus_123", status: "complete", limit: 10}))
    ids map(page.data, %.id)
    ```
    """
}
fn
(): Map {
  list-checkout-sessions(ListCheckoutSessionsRequest({}))
},
(request: ListCheckoutSessionsRequest): Map {
  list-checkout-sessions(request, {})
},
(request: ListCheckoutSessionsRequest, opts: Map): Map {
  api-call("GET", "/v1/checkout/sessions", request, opts)
}

list-checkout-session-line-items
meta {
    doc: """
    GET /v1/checkout/sessions/{session}/line_items - List the line items of
    a Checkout Session. Optional `params`: `limit`, `starting_after`,
    `expand`.

    **Example**

    ```hot
    ::checkout ::stripe::checkout

    items ::checkout/list-checkout-session-line-items("cs_test_123", {limit: 100})
    quantities map(items.data, %.quantity)
    ```
    """
}
fn
(session: Str): Map {
  list-checkout-session-line-items(session, {})
},
(session: Str, params: Map): Map {
  list-checkout-session-line-items(session, params, {})
},
(session: Str, params: Map, opts: Map): Map {
  api-call("GET", `/v1/checkout/sessions/${seg(session)}/line_items`, params, opts)
}
