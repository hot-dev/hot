::github::app ns
meta {
    doc: """
    GitHub App authentication: sign an app JWT with the App's RSA private
    key, then mint short-lived installation tokens with it. Built on
    `hot.dev/jwt` and the `::hot::crypto` RS256 natives.

    **Example**

    ```hot
    ::app ::github::app

    app-id 12345
    private-key-pem ::hot::ctx/get("acme.github-app-key")
    installation-id 678

    token ::app/installation-token(app-id, private-key-pem, installation-id)
    // Tokens live ~1 hour. Set the runtime-minted secret for this run;
    // every ::github wrapper then authenticates with it.
    ::hot::ctx/set-secret("github.token", token.token)
    issues ::github::issues/list-issues("acme", "api")

    // Or act for one installation on one call. The token is minted once
    // and cached for the run, keyed by a hash of the identity.
    tenant {app-id: app-id, private-key: private-key-pem, installation-id: installation-id}
    issues ::github::issues/list-issues("acme", "api", {}, tenant)
    ```
    """
}

::jwt ::jwt
::ctx ::hot::ctx
::hash ::hot::hash
::time ::hot::time

TOKEN_CACHE_PREFIX "github.app-token."

// GitHub installation tokens last one hour; stop using a cached one 5 minutes early.
TOKEN_TTL_MS 3300000

build-app-claims
meta {
    doc: """
    Build the app JWT claims per GitHub's spec: `iat` 60s in the past (clock
    drift), `exp` at most 10 minutes out, `iss` = the App id.

    **Example**

    ```hot
    ::github::app/build-app-claims(12345).iss  // "12345"
    ```
    """
}
fn (app-id: Any): Map {
  now ::jwt/now-seconds()
  {
    iat: sub(now, 60),
    exp: add(now, 540),
    iss: Str(app-id)
  }
}

app-jwt
meta {
    doc: """
    Sign a GitHub App JWT (RS256) from the App id and its PEM private key
    (the `.pem` GitHub generates — PKCS#1 `BEGIN RSA PRIVATE KEY` — or a
    PKCS#8 conversion).

    **Example**

    ```hot
    jwt ::github::app/app-jwt(12345, ::hot::ctx/get("acme.github-app-key"))
    ::github::api/json("GET", "/app", {}, "", jwt).slug
    ```
    """
}
fn (app-id: Any, private-key-pem: Str): Str {
  ::ctx/mark-secret(private-key-pem)
  signed ::jwt/sign(build-app-claims(app-id), private-key-pem, "RS256")
  if(is-err(signed), signed, ::ctx/mark-secret(signed))
}

// Authenticate an App-level call with its JWT, keeping only the settings
// of `opts`: an App call never uses a tenant's token.
bearer-opts
meta {no-doc: true}
fn (bearer: Str, opts: Map): Map {
  {token: bearer, base-url: get(opts, "base-url"), api-version: get(opts, "api-version")}
}

installation-token
meta {
    doc: """
    POST /app/installations/{id}/access_tokens - Mint an installation
    access token (~1 hour). Returns `{token, expires_at, permissions}`.
    Set `token.token` as the `github.token` context variable
    (`::hot::ctx/set-secret("github.token", token.token)` for
    runtime-minted tokens) so the endpoint wrappers pick it up, or pass
    it explicitly via the final arity of `::github::api/request`/`json`.
    To act for many installations in one run, pass `app-id`, `private-key`
    and `installation-id` in any function's `opts` instead. `opts` here
    takes `base-url` and `api-version`. The minted token is masked in the
    run's call records.

    **Example**

    ```hot
    minted ::github::app/installation-token(12345, ::hot::ctx/get("acme.github-app-key"), 678)
    ::hot::ctx/set-secret("github.token", minted.token)
    minted.expires_at
    ```
    """
}
fn
(app-id: Any, private-key-pem: Str, installation-id: Any): Map {
  installation-token(app-id, private-key-pem, installation-id, {})
},
(app-id: Any, private-key-pem: Str, installation-id: Any, opts: Map): Map {
  bearer app-jwt(app-id, private-key-pem)
  match bearer {
    Result.Err => { err(bearer) }

    _ => {
      minted ::github::api/json("POST", `/app/installations/${installation-id}/access_tokens`, {}, {}, bearer-opts(bearer, opts))
      cond {
        is-err(minted) => { minted }
        => {
          ::ctx/mark-secret(minted.token)
          minted
        }
      }
    }
  }
}

token-cache-key
meta {
    doc: """
    The context key an installation token is cached under: a SHA-256 of the
    App id, installation id, private key and API root, so neither the key
    nor any id appears in it.

    **Example**

    ```hot
    identity {app-id: 12345, installation-id: 678, private-key: "sample-key"}
    key ::github::app/token-cache-key(identity, "https://api.github.com")
    starts-with(key, "github.app-token.")  // true
    ```
    """
}
fn (identity: Map, base-url: Str): Str {
  material join([Str(identity.app-id), Str(identity.installation-id), identity.private-key, base-url], "\n")
  `${TOKEN_CACHE_PREFIX}${::hash/sha256(material)}`
}

is-fresh
meta {
    doc: """
    True when a cache entry holds a token that has not reached its expiry.

    **Example**

    ```hot
    ::github::app/is-fresh({token: "test-token", expires-at: 2000}, 1000)  // true
    ::github::app/is-fresh({token: "test-token", expires-at: 2000}, 3000)  // false
    ```
    """
}
fn (entry: Any, now: Int): Bool {
  and(is-map(entry), is-some(get(entry, "token")), lt(now, or(get(entry, "expires-at"), 0)))
}

cached-installation-token
meta {
    doc: """
    An installation token for `identity` (`{app-id, private-key,
    installation-id}`), minted once and cached with
    `::hot::ctx/set-secret` under `token-cache-key` until 5 minutes before
    it expires. Each identity has its own entry, so tenants and parallel
    flows can't pick up each other's token, and `github.token` is left
    alone. `settings` carries `base-url` and `api-version`. Returns the
    token, or the Err from signing or minting.

    **Example**

    ```hot
    identity {
      app-id: 12345,
      private-key: ::hot::ctx/get("acme.github-app-key"),
      installation-id: 678
    }
    token ::github::app/cached-installation-token(identity, ::github::api/settings-from({}))
    ::github::users/get-user("octocat", {token: token}).login
    ```
    """
}
fn (identity: Map, settings: Map): Str {
  key token-cache-key(identity, settings.base-url)
  now ::time/epoch-millis(::time/now())
  hit ::ctx/get(key)
  cond {
    is-fresh(hit, now) => { hit.token }
    => {
      minted installation-token(identity.app-id, identity.private-key, identity.installation-id, settings)
      cond {
        is-err(minted) => { minted }
        => {
          ::ctx/set-secret(key, {token: minted.token, expires-at: add(now, TOKEN_TTL_MS)})
          minted.token
        }
      }
    }
  }
}

list-installations
meta {
    doc: """
    GET /app/installations - The installations of your App (authenticated
    with the app JWT).

    **Example**

    ```hot
    installations ::github::app/list-installations(12345, ::hot::ctx/get("acme.github-app-key"))
    map(installations, %.account.login)
    ```
    """
}
fn
(app-id: Any, private-key-pem: Str): Any {
  list-installations(app-id, private-key-pem, {})
},
(app-id: Any, private-key-pem: Str, opts: Map): Any {
  bearer app-jwt(app-id, private-key-pem)
  match bearer {
    Result.Err => { err(bearer) }

    _ => { ::github::api/json("GET", "/app/installations", {}, "", bearer-opts(bearer, opts)) }
  }
}
