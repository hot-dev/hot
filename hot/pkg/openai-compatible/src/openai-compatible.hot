PERPLEXITY
meta {
    doc: """
    Perplexity Sonar through its OpenAI-compatible `/chat/completions`
    alias. No tool calling. Perplexity ended Sonar Chat Completions
    support on 2026-09-27 and now translates these requests to its Agent
    API; prefer Perplexity's native API for new work.
    """
}

Preset({
    name: "Perplexity",
    base-url: "https://api.perplexity.ai",
    model-prefix: "perplexity/",
    key-ctx: "perplexity.api.key",
    key-env: "PERPLEXITY_API_KEY",
    max-tokens-param: "max_tokens",
    stream-usage: false,
    capabilities: ["streaming"],
    docs-url: "https://docs.perplexity.ai/docs/sonar/openai-compatibility"
})

PRESETS
meta {doc: "Every built-in preset."}
[OLLAMA, VLLM, LM_STUDIO, GROQ, OPENROUTER, DEEPSEEK, TOGETHER, FIREWORKS, MISTRAL, CEREBRAS, PERPLEXITY]

// ============================================================================
// Building providers
// ============================================================================

configure
meta {
    doc: """
    Turn a `Preset` into an `::openai::compatible/CompatibleProvider` with
    an explicit key (null for keyless servers). Reads no ctx.

    `overrides` may set `base-url`, `model-prefix`, `name`, `headers`,
    `max-tokens` (output ceiling, default 4096) and `extra-body`
    (provider-specific request fields).

    **Example**

    ```hot
    ::oc ::openai-compatible

    groq ::oc/configure(::oc/GROQ, "gsk_...")
    remote-ollama ::oc/configure(::oc/OLLAMA, null, {base-url: "http://gpu-box.internal:11434/v1"})
    routed ::oc/configure(::oc/OPENROUTER, "sk-or-...", {
        headers: {"HTTP-Referer": "https://example.com", "X-OpenRouter-Title": "Example"},
        extra-body: {provider: {sort: "throughput"}}
    })
    ```
    """
}
fn
(preset: Preset, api-key: Str?): CompatibleProvider {
    configure(preset, api-key, {})
},
(preset: Preset, api-key: Str?, overrides: Map): CompatibleProvider {
    options ::openai::chat-tools/ChatRequestOptions({
        max-completion-tokens: or(get(overrides, "max-tokens"), DEFAULT_MAX_TOKENS),
        reasoning-effort: get(overrides, "reasoning-effort"),
        max-tokens-param: preset.max-tokens-param,
        stream-usage: preset.stream-usage,
        extra-body: get(overrides, "extra-body")
    })
    headers get(overrides, "headers")
    ep ::api/endpoint(or(get(overrides, "base-url"), preset.base-url), api-key, if(is-empty(or(headers, {})), null, headers))

    CompatibleProvider({
        name: or(get(overrides, "name"), preset.name),
        endpoint: ep,
        model-prefix: or(get(overrides, "model-prefix"), preset.model-prefix),
        options: options,
        capabilities: preset.capabilities
    })
}

provider
meta {
    doc: """
    Build an `::ai::chat/ProviderRegistration` from a configured provider,
    via `::openai::compatible/provider`. Models starting with the preset's
    prefix route to it; the prefix is stripped before the request.

    **Example**

    ```hot
    registry ::ai::chat/with-providers([::openai-compatible/provider(::openai-compatible/ollama())])
    ```
    """
}
fn (p: CompatibleProvider): ::ai::chat/ProviderRegistration {
    ::compat/provider(p)
}

chat-fn
meta {
    doc: "The `::ai::chat/run-loop` chat function bound to `p` (for `ChatOptions.chat-fn`)."
}
fn (p: CompatibleProvider): Fn {
    ::compat/chat-fn(p)
}

chat-stream-fn
meta {
    doc: "The `::ai::chat/run-loop-stream` chat function bound to `p` (for `ChatOptions.chat-stream-fn`)."
}
fn (p: CompatibleProvider): Fn {
    ::compat/chat-stream-fn(p)
}

// ============================================================================
// Named presets (read keys from ctx)
// ============================================================================

ollama
meta {
    doc: """
    Local Ollama. `ollama.base.url` overrides the default
    `http://localhost:11434/v1` (e.g. `https://ollama.com/v1` for Ollama's
    hosted API, with `ollama.api.key`). Keyless by default.
    """,
    ctx: {
        "ollama.base.url": {required: false, default: "http://localhost:11434/v1", secret: false},
        "ollama.api.key": {required: false}
    }
}
fn (): CompatibleProvider {
    configure(OLLAMA, ::ctx/get("ollama.api.key"), {base-url: ::ctx/get("ollama.base.url", OLLAMA.base-url)})
}

vllm
meta {
    doc: """vLLM server at `vllm.base.url` (default `http://localhost:8000/v1`). `vllm.api.key` only when the server runs with `--api-key`.""",
    ctx: {
        "vllm.base.url": {required: false, default: "http://localhost:8000/v1", secret: false},
        "vllm.api.key": {required: false}
    }
}
fn (): CompatibleProvider {
    configure(VLLM, ::ctx/get("vllm.api.key"), {base-url: ::ctx/get("vllm.base.url", VLLM.base-url)})
}

lm-studio
meta {
    doc: """LM Studio server at `lm-studio.base.url` (default `http://localhost:1234/v1`). Keyless.""",
    ctx: {"lm-studio.base.url": {required: false, default: "http://localhost:1234/v1", secret: false}}
}
fn (): CompatibleProvider {
    configure(LM_STUDIO, null, {base-url: ::ctx/get("lm-studio.base.url", LM_STUDIO.base-url)})
}

groq
meta {
    doc: "Groq with the `groq.api.key` ctx key.",
    ctx: {"groq.api.key": {}}
}
fn (): CompatibleProvider {
    configure(GROQ, ::ctx/get("groq.api.key"))
}

openrouter
meta {
    doc: """
    OpenRouter with the `openrouter.api.key` ctx key. Optional
    `openrouter.app.url` and `openrouter.app.title` are sent as the
    `HTTP-Referer` and `X-OpenRouter-Title` attribution headers.
    """,
    ctx: {
        "openrouter.api.key": {},
        "openrouter.app.url": {required: false, secret: false},
        "openrouter.app.title": {required: false, secret: false}
    }
}
fn (): CompatibleProvider {
    headers openrouter-headers(::ctx/get("openrouter.app.url"), ::ctx/get("openrouter.app.title"))
    configure(OPENROUTER, ::ctx/get("openrouter.api.key"), {headers: headers})
}

openrouter-headers
meta {
    doc: """
    OpenRouter app-attribution headers. Unset values are omitted.

    **Example**

    ```hot
    ::openai-compatible/openrouter-headers("https://example.com", "Example")
    // => {"HTTP-Referer": "https://example.com", "X-OpenRouter-Title": "Example"}
    ```
    """
}
fn (app-url: Str?, app-title: Str?): Map {
    {}
    |> assoc-some("HTTP-Referer", if(is-empty(or(app-url, "")), null, app-url))
    |> assoc-some("X-OpenRouter-Title", if(is-empty(or(app-title, "")), null, app-title))
}

deepseek
meta {
    doc: "DeepSeek with the `deepseek.api.key` ctx key.",
    ctx: {"deepseek.api.key": {}}
}
fn (): CompatibleProvider {
    configure(DEEPSEEK, ::ctx/get("deepseek.api.key"))
}

together
meta {
    doc: "Together AI with the `together.api.key` ctx key.",
    ctx: {"together.api.key": {}}
}
fn (): CompatibleProvider {
    configure(TOGETHER, ::ctx/get("together.api.key"))
}

fireworks
meta {
    doc: "Fireworks AI with the `fireworks.api.key` ctx key.",
    ctx: {"fireworks.api.key": {}}
}
fn (): CompatibleProvider {
    configure(FIREWORKS, ::ctx/get("fireworks.api.key"))
}

mistral
meta {
    doc: "Mistral with the `mistral.api.key` ctx key.",
    ctx: {"mistral.api.key": {}}
}
fn (): CompatibleProvider {
    configure(MISTRAL, ::ctx/get("mistral.api.key"))
}

cerebras
meta {
    doc: "Cerebras with the `cerebras.api.key` ctx key.",
    ctx: {"cerebras.api.key": {}}
}
fn (): CompatibleProvider {
    configure(CEREBRAS, ::ctx/get("cerebras.api.key"))
}

perplexity
meta {
    doc: "Perplexity Sonar with the `perplexity.api.key` ctx key. No tool calling.",
    ctx: {"perplexity.api.key": {}}
}
fn (): CompatibleProvider {
    configure(PERPLEXITY, ::ctx/get("perplexity.api.key"))
}

custom
meta {
    doc: """
    Any other OpenAI-compatible server or private gateway:
    `openai-compatible.url` (required) and optional
    `openai-compatible.api.key`. Routing prefix `custom/`; sends
    `max_tokens` and no `stream_options`, the most widely accepted shape.
    """,
    ctx: {
        "openai-compatible.url": {secret: false},
        "openai-compatible.api.key": {required: false}
    }
}
fn (): CompatibleProvider {
    custom-preset ::openai-compatible/Preset({
        name: "OpenAI-compatible",
        base-url: ::ctx/get("openai-compatible.url"),
        model-prefix: "custom/",
        key-ctx: "openai-compatible.api.key",
        key-env: "OPENAI_COMPATIBLE_API_KEY",
        max-tokens-param: "max_tokens",
        stream-usage: false,
        capabilities: ["tools", "streaming"],
        docs-url: "https://platform.openai.com/docs/api-reference/chat"
    })
    configure(custom-preset, ::ctx/get("openai-compatible.api.key"))
}
