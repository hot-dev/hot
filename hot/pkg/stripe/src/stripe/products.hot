::stripe::products ns
meta {
    doc: """Products and Prices: the catalog that Checkout, subscriptions, and invoices bill against. See https://docs.stripe.com/api/products and https://docs.stripe.com/api/prices."""
}

api-call ::stripe::api/call
seg ::stripe::api/encode-id
RequestOptions ::stripe::api/RequestOptions

// ============================================================================
// Products
// ============================================================================

CreateProductRequest type {
  name: Str,
  description: Str?,
  id: Str?,
  active: Bool?,
  metadata: Map?,
  images: Vec<Str>?,
  marketing_features: Vec<Map>?,
  url: Str?,
  shippable: Bool?,
  statement_descriptor: Str?,
  unit_label: Str?,
  tax_code: Str?,
  default_price_data: Map?,
  expand: Vec<Str>?
}

create-product
meta {
    doc: """
POST /v1/products - Create a product. Provide `default_price_data` to create a price in the same call.

**Example**

```hot
::products ::stripe::products

product ::products/create-product(::products/CreateProductRequest({
  name: "Pro Plan",
  default_price_data: {currency: "usd", unit_amount: 1500, recurring: {interval: "month"}}
}))
product.default_price  // => "price_..."
```
"""
}
fn
(request: CreateProductRequest): Map {
  create-product(request, RequestOptions({}))
},
(request: CreateProductRequest, options: RequestOptions | Map): Map {
  api-call("POST", "/v1/products", request, options)
}

get-product
meta {
    doc: """GET /v1/products/{id} - Retrieve a product by ID."""
}
fn
(product: Str): Map {
  get-product(product, {})
},
(product: Str, params: Map): Map {
  get-product(product, params, {})
},
(product: Str, params: Map, opts: Map): Map {
  api-call("GET", `/v1/products/${seg(product)}`, params, opts)
}

UpdateProductRequest type {
  name: Str?,
  description: Str?,
  active: Bool?,
  metadata: Map?,
  images: Vec<Str>?,
  marketing_features: Vec<Map>?,
  url: Str?,
  shippable: Bool?,
  statement_descriptor: Str?,
  unit_label: Str?,
  default_price: Str?,
  tax_code: Str?,
  expand: Vec<Str>?
}

update-product
meta {
    doc: """POST /v1/products/{id} - Update a product."""
}
fn
(product: Str, request: UpdateProductRequest): Map {
  update-product(product, request, RequestOptions({}))
},
(product: Str, request: UpdateProductRequest, options: RequestOptions | Map): Map {
  api-call("POST", `/v1/products/${seg(product)}`, request, options)
}

delete-product
meta {
    doc: """DELETE /v1/products/{id} - Delete a product. Only possible if it has no prices attached; otherwise set `active: false` via `update-product`."""
}
fn
(product: Str): Map {
  delete-product(product, {})
},
(product: Str, opts: Map): Map {
  api-call("DELETE", `/v1/products/${seg(product)}`, "", opts)
}

ListProductsRequest type {
  active: Bool?,
  ids: Vec<Str>?,
  shippable: Bool?,
  url: Str?,
  created: Any?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-products
meta {
    doc: """GET /v1/products - List products, most recent first. Filter by `active` or specific `ids`."""
}
fn
(): Map {
  list-products(ListProductsRequest({}))
},
(request: ListProductsRequest): Map {
  list-products(request, {})
},
(request: ListProductsRequest, opts: Map): Map {
  api-call("GET", "/v1/products", request, opts)
}

search-products
meta {
    doc: """GET /v1/products/search - Search products with Stripe's search query language, e.g. `active:"true" AND name~"plan"`. Pass `next_page` back as `page` in `params` to continue."""
}
fn
(query: Str): Map {
  search-products(query, {})
},
(query: Str, params: Map): Map {
  search-products(query, params, {})
},
(query: Str, params: Map, opts: Map): Map {
  api-call("GET", "/v1/products/search", {...params, query: query}, opts)
}

// ============================================================================
// Prices
// ============================================================================

CreatePriceRequest type {
  currency: Str,
  product: Str?,
  product_data: Map?,
  unit_amount: Int?,
  unit_amount_decimal: Str?,
  custom_unit_amount: Map?,
  currency_options: Map?,
  recurring: Map?,
  billing_scheme: Str?,
  tiers: Vec<Map>?,
  tiers_mode: Str?,
  transform_quantity: Map?,
  lookup_key: Str?,
  transfer_lookup_key: Bool?,
  nickname: Str?,
  metadata: Map?,
  active: Bool?,
  tax_behavior: Str?,
  expand: Vec<Str>?
}

create-price
meta {
    doc: """
POST /v1/prices - Create a price for a product. `unit_amount` is in the smallest currency unit. For subscriptions, set `recurring: {interval: "month"}` (add `meter: "mtr_..."` and `usage_type: "metered"` for usage-based billing).

**Example**

```hot
::products ::stripe::products

price ::products/create-price(::products/CreatePriceRequest({
  product: "prod_...",
  currency: "usd",
  unit_amount: 1500,
  recurring: {interval: "month"},
  lookup_key: "pro_monthly"
}))
```
"""
}
fn
(request: CreatePriceRequest): Map {
  create-price(request, RequestOptions({}))
},
(request: CreatePriceRequest, options: RequestOptions | Map): Map {
  api-call("POST", "/v1/prices", request, options)
}

get-price
meta {
    doc: """GET /v1/prices/{price} - Retrieve a price by ID."""
}
fn
(price: Str): Map {
  get-price(price, {})
},
(price: Str, params: Map): Map {
  get-price(price, params, {})
},
(price: Str, params: Map, opts: Map): Map {
  api-call("GET", `/v1/prices/${seg(price)}`, params, opts)
}

UpdatePriceRequest type {
  active: Bool?,
  nickname: Str?,
  lookup_key: Str?,
  transfer_lookup_key: Bool?,
  currency_options: Map?,
  metadata: Map?,
  tax_behavior: Str?,
  expand: Vec<Str>?
}

update-price
meta {
    doc: """POST /v1/prices/{price} - Update a price. Amounts are immutable — create a new price and deactivate the old one to change pricing."""
}
fn
(price: Str, request: UpdatePriceRequest): Map {
  update-price(price, request, RequestOptions({}))
},
(price: Str, request: UpdatePriceRequest, options: RequestOptions | Map): Map {
  api-call("POST", `/v1/prices/${seg(price)}`, request, options)
}

ListPricesRequest type {
  product: Str?,
  active: Bool?,
  currency: Str?,
  type: Str?,
  recurring: Map?,
  lookup_keys: Vec<Str>?,
  created: Any?,
  limit: Int?,
  starting_after: Str?,
  ending_before: Str?,
  expand: Vec<Str>?
}

list-prices
meta {
    doc: """GET /v1/prices - List prices. Filter by `product`, `active`, `currency`, `type` ("one_time" or "recurring"), or `lookup_keys`."""
}
fn
(): Map {
  list-prices(ListPricesRequest({}))
},
(request: ListPricesRequest): Map {
  list-prices(request, {})
},
(request: ListPricesRequest, opts: Map): Map {
  api-call("GET", "/v1/prices", request, opts)
}

search-prices
meta {
    doc: """GET /v1/prices/search - Search prices with Stripe's search query language, e.g. `active:"true" AND product:"prod_..."`. Pass `next_page` back as `page` in `params` to continue."""
}
fn
(query: Str): Map {
  search-prices(query, {})
},
(query: Str, params: Map): Map {
  search-prices(query, params, {})
},
(query: Str, params: Map, opts: Map): Map {
  api-call("GET", "/v1/prices/search", {...params, query: query}, opts)
}
