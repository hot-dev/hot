::google::docs::requests ns
meta {
    doc: """
    Pure builders for `documents.batchUpdate` requests. Each returns one
    request Map; pass a Vec of them to
    `::google::docs::documents/batch-update`, which applies them
    atomically in order.

    Indexes count UTF-16 code units from 1 at the start of the body.
    Ranges are `start` inclusive to `end` exclusive. Every builder's
    `opts` takes `tabId` and `segmentId` (a header, footer or footnote)
    to address something other than the first tab's body.

    ```hot
    ::req ::google::docs::requests

    ::google::docs::documents/batch-update("1AbCdEf", [
      ::req/insert-text("Status\nAll green\n", 1),
      ::req/heading(1, 8, 1),
      ::req/bold(8, 17)
    ])
    ```
    """
}

::docs ::google::docs

BULLET_DISC "BULLET_DISC_CIRCLE_SQUARE"
NUMBERED "NUMBERED_DECIMAL_ALPHA_ROMAN"

// ---------------------------------------------------------------------------
// Locations, ranges and values
// ---------------------------------------------------------------------------

location
meta {
    doc: """
    A `Location` at a UTF-16 index.

    **Example**

    ```hot
    ::google::docs::requests/location(5)  // {index: 5}
    ::google::docs::requests/location(5, {tabId: "t.1"})  // {index: 5, tabId: "t.1"}
    ```
    """
}
fn
(index: Int): Map {
  location(index, {})
},
(index: Int, opts: Map): Map {
  ::docs/compact({index: index, segmentId: get(opts, "segmentId"), tabId: get(opts, "tabId")})
}

end-of-segment
meta {
    doc: """
    An `EndOfSegmentLocation`: the end of the body, or of `opts.segmentId`,
    in the first tab or `opts.tabId`.

    **Example**

    ```hot
    ::google::docs::requests/end-of-segment()  // {}
    ::google::docs::requests/end-of-segment({segmentId: "kix.header"})  // {segmentId: "kix.header"}
    ```
    """
}
fn
(): Map {
  end-of-segment({})
},
(opts: Map): Map {
  ::docs/compact({segmentId: get(opts, "segmentId"), tabId: get(opts, "tabId")})
}

text-range
meta {
    doc: """
    A `Range`: `start` inclusive to `end` exclusive.

    **Example**

    ```hot
    ::google::docs::requests/text-range(1, 8)  // {startIndex: 1, endIndex: 8}
    ```
    """
}
fn
(start: Int, end: Int): Map {
  text-range(start, end, {})
},
(start: Int, end: Int, opts: Map): Map {
  ::docs/compact({startIndex: start, endIndex: end, segmentId: get(opts, "segmentId"), tabId: get(opts, "tabId")})
}

points
meta {
    doc: """
    A `Dimension` in points.

    **Example**

    ```hot
    ::google::docs::requests/points(12)  // {magnitude: 12, unit: "PT"}
    ```
    """
}
fn (value: Int | Dec): Map {
  {magnitude: value, unit: "PT"}
}

rgb
meta {
    doc: """
    A Docs `RgbColor` from 0-255 channels.

    **Example**

    ```hot
    ::google::docs::requests/rgb(255, 0, 0)  // {red: 1.0, green: 0.0, blue: 0.0}
    ```
    """
}
fn (red: Int, green: Int, blue: Int): Map {
  {red: div(Dec(red), 255), green: div(Dec(green), 255), blue: div(Dec(blue), 255)}
}

hex-color
meta {
    doc: """
    A Docs `RgbColor` from a hex string (`"#1a73e8"` or `"1a73e8"`); an Err
    for anything else.

    **Example**

    ```hot
    ::google::docs::requests/hex-color("#ff0000")  // {red: 1.0, green: 0.0, blue: 0.0}
    ```
    """
}
fn (hex: Str): Map {
  trimmed trim(hex)
  h lowercase(if(starts-with(trimmed, "#"), slice(trimmed, 1), trimmed))
  cond {
    not(::hot::regex/is-match(h, "^[0-9a-f]{6}$")) => { err(`google-docs: invalid hex color ${to-json(hex)}`) }
    => {
      channels ::hot::bytes/to-vec(::hot::hex/decode(h))
      rgb(first(channels), get(channels, 1), last(channels))
    }
  }
}

optional-color
meta {
    doc: """
    An `OptionalColor` wrapping an `RgbColor`, for `foregroundColor` and
    `backgroundColor`.

    **Example**

    ```hot
    ::google::docs::requests/optional-color(::google::docs::requests/rgb(255, 0, 0))
    // {color: {rgbColor: {red: 1.0, green: 0.0, blue: 0.0}}}
    ```
    """
}
fn (color: Map): Map {
  {color: {rgbColor: color}}
}

field-mask
meta {
    doc: """
    A style's top-level keys as a field mask, so only the fields you pass
    change.

    **Example**

    ```hot
    ::google::docs::requests/field-mask({bold: true, italic: false})  // "bold,italic"
    ```
    """
}
fn (style: Map): Str {
  join(map(keys(style), Str), ",")
}

// ---------------------------------------------------------------------------
// Text
// ---------------------------------------------------------------------------

insert-text
meta {
    doc: """
    `insertText` at a UTF-16 index, which must fall inside an existing
    paragraph.

    **Example**

    ```hot
    ::google::docs::requests/insert-text("Hello", 1)
    // {insertText: {text: "Hello", location: {index: 1}}}
    ```
    """
}
fn
(text: Str, index: Int): Map {
  insert-text(text, index, {})
},
(text: Str, index: Int, opts: Map): Map {
  {insertText: {text: text, location: location(index, opts)}}
}

append-text
meta {
    doc: """
    `insertText` at the end of the body or segment.

    **Example**

    ```hot
    ::google::docs::requests/append-text("Hello\n")
    // {insertText: {text: "Hello\n", endOfSegmentLocation: {}}}
    ```
    """
}
fn
(text: Str): Map {
  append-text(text, {})
},
(text: Str, opts: Map): Map {
  {insertText: {text: text, endOfSegmentLocation: end-of-segment(opts)}}
}

delete-range
meta {
    doc: """
    `deleteContentRange`. A range cannot include a segment's final newline
    or split a table or surrogate pair.

    **Example**

    ```hot
    ::google::docs::requests/delete-range(1, 8)
    // {deleteContentRange: {range: {startIndex: 1, endIndex: 8}}}
    ```
    """
}
fn
(start: Int, end: Int): Map {
  delete-range(start, end, {})
},
(start: Int, end: Int, opts: Map): Map {
  {deleteContentRange: {range: text-range(start, end, opts)}}
}

tabs-criteria
meta {no-doc: true}
fn (opts: Map): Map? {
  ids get(opts, "tabIds")
  if(is-null(ids), null, {tabIds: ids})
}

replace-all-text
meta {
    doc: """
    `replaceAllText`: every occurrence, in every tab unless `opts.tabIds`.
    Case-sensitive unless `opts.matchCase` is false; `opts.searchByRegex`
    treats `search` as a regular expression.

    **Example**

    ```hot
    req ::google::docs::requests/replace-all-text("2025", "2026", {matchCase: false})
    req.replaceAllText.containsText  // {text: "2025", matchCase: false}
    ```
    """
}
fn
(search: Str, replacement: Str): Map {
  replace-all-text(search, replacement, {})
},
(search: Str, replacement: Str, opts: Map): Map {
  {replaceAllText: ::docs/compact({
    replaceText: replacement,
    containsText: ::docs/compact({
      text: search,
      matchCase: get(opts, "matchCase", true),
      searchByRegex: get(opts, "searchByRegex")
    }),
    tabsCriteria: tabs-criteria(opts)
  })}
}

fill-template
meta {
    doc: """
    One `replaceAllText` per entry of `values`, replacing `{{key}}` with the
    value as text. Null values are skipped.

    **Example**

    ```hot
    reqs ::google::docs::requests/fill-template({name: "Ada"})
    reqs[0].replaceAllText.containsText.text  // "{{name}}"
    reqs[0].replaceAllText.replaceText  // "Ada"
    ```
    """
}
fn
(values: Map): Vec {
  fill-template(values, {})
},
(values: Map, opts: Map): Vec {
  present filter-vals(values, is-some)
  map(keys(present), (k) { replace-all-text(`{{${Str(k)}}}`, Str(get(present, k)), opts) })
}

// ---------------------------------------------------------------------------
// Styles
// ---------------------------------------------------------------------------

text-style
meta {
    doc: """
    `updateTextStyle` with any `TextStyle` (`bold`, `italic`, `underline`,
    `strikethrough`, `fontSize`, `foregroundColor`, `backgroundColor`,
    `link`, `weightedFontFamily`, ...). The field mask is the keys you pass.

    **Example**

    ```hot
    ::google::docs::requests/text-style(1, 8, {bold: true, underline: true}).updateTextStyle.fields  // "bold,underline"
    ```
    """
}
fn
(start: Int, end: Int, style: Map): Map {
  text-style(start, end, style, {})
},
(start: Int, end: Int, style: Map, opts: Map): Map {
  {updateTextStyle: {range: text-range(start, end, opts), textStyle: style, fields: field-mask(style)}}
}

bold
meta {
    doc: """
    Make a range bold.

    **Example**

    ```hot
    ::google::docs::requests/bold(1, 8).updateTextStyle.textStyle  // {bold: true}
    ```
    """
}
fn
(start: Int, end: Int): Map {
  text-style(start, end, {bold: true})
},
(start: Int, end: Int, opts: Map): Map {
  text-style(start, end, {bold: true}, opts)
}

italic
meta {
    doc: """
    Make a range italic.

    **Example**

    ```hot
    ::google::docs::requests/italic(1, 8).updateTextStyle.textStyle  // {italic: true}
    ```
    """
}
fn
(start: Int, end: Int): Map {
  text-style(start, end, {italic: true})
},
(start: Int, end: Int, opts: Map): Map {
  text-style(start, end, {italic: true}, opts)
}

link
meta {
    doc: """
    Link a range to `url`.

    **Example**

    ```hot
    ::google::docs::requests/link(1, 8, "https://hot.dev").updateTextStyle.textStyle
    // {link: {url: "https://hot.dev"}}
    ```
    """
}
fn
(start: Int, end: Int, url: Str): Map {
  text-style(start, end, {link: {url: url}})
},
(start: Int, end: Int, url: Str, opts: Map): Map {
  text-style(start, end, {link: {url: url}}, opts)
}

font-size
meta {
    doc: """
    Set a range's font size in points.

    **Example**

    ```hot
    ::google::docs::requests/font-size(1, 8, 14).updateTextStyle.textStyle
    // {fontSize: {magnitude: 14, unit: "PT"}}
    ```
    """
}
fn
(start: Int, end: Int, size: Int | Dec): Map {
  text-style(start, end, {fontSize: points(size)})
},
(start: Int, end: Int, size: Int | Dec, opts: Map): Map {
  text-style(start, end, {fontSize: points(size)}, opts)
}

text-color
meta {
    doc: """
    Set a range's text color from an `RgbColor` (`rgb` or `hex-color`).

    **Example**

    ```hot
    ::google::docs::requests/text-color(1, 8, ::google::docs::requests/hex-color("#ff0000")).updateTextStyle.fields  // "foregroundColor"
    ```
    """
}
fn
(start: Int, end: Int, color: Map): Map {
  text-style(start, end, {foregroundColor: optional-color(color)})
},
(start: Int, end: Int, color: Map, opts: Map): Map {
  text-style(start, end, {foregroundColor: optional-color(color)}, opts)
}

paragraph-style
meta {
    doc: """
    `updateParagraphStyle` with any `ParagraphStyle` (`namedStyleType`,
    `alignment`, `lineSpacing`, `spaceAbove`, `indentStart`, ...) on every
    paragraph the range touches. The field mask is the keys you pass.

    **Example**

    ```hot
    ::google::docs::requests/paragraph-style(1, 8, {alignment: "CENTER"}).updateParagraphStyle.fields  // "alignment"
    ```
    """
}
fn
(start: Int, end: Int, style: Map): Map {
  paragraph-style(start, end, style, {})
},
(start: Int, end: Int, style: Map, opts: Map): Map {
  {updateParagraphStyle: {range: text-range(start, end, opts), paragraphStyle: style, fields: field-mask(style)}}
}

named-style
meta {
    doc: """
    Apply a named style: `NORMAL_TEXT`, `TITLE`, `SUBTITLE` or `HEADING_1`
    to `HEADING_6`.

    **Example**

    ```hot
    ::google::docs::requests/named-style(1, 8, "TITLE").updateParagraphStyle.paragraphStyle
    // {namedStyleType: "TITLE"}
    ```
    """
}
fn
(start: Int, end: Int, name: Str): Map {
  paragraph-style(start, end, {namedStyleType: name})
},
(start: Int, end: Int, name: Str, opts: Map): Map {
  paragraph-style(start, end, {namedStyleType: name}, opts)
}

heading
meta {
    doc: """
    Make the paragraphs in a range a heading of `level` 1 to 6; an Err for
    any other level.

    **Example**

    ```hot
    ::google::docs::requests/heading(1, 8, 2).updateParagraphStyle.paragraphStyle
    // {namedStyleType: "HEADING_2"}
    ```
    """
}
fn
(start: Int, end: Int, level: Int): Map {
  heading(start, end, level, {})
},
(start: Int, end: Int, level: Int, opts: Map): Map {
  cond {
    between(level, 1, 6) => { named-style(start, end, `HEADING_${level}`, opts) }
    => { err(`google-docs: heading level must be 1 to 6, got ${level}`) }
  }
}

align
meta {
    doc: """
    Set paragraph alignment: `START`, `CENTER`, `END` or `JUSTIFIED`.

    **Example**

    ```hot
    ::google::docs::requests/align(1, 8, "CENTER").updateParagraphStyle.paragraphStyle  // {alignment: "CENTER"}
    ```
    """
}
fn
(start: Int, end: Int, alignment: Str): Map {
  paragraph-style(start, end, {alignment: alignment})
},
(start: Int, end: Int, alignment: Str, opts: Map): Map {
  paragraph-style(start, end, {alignment: alignment}, opts)
}

bullets
meta {
    doc: """
    `createParagraphBullets` on the paragraphs in a range. `preset` defaults
    to `BULLET_DISC_CIRCLE_SQUARE`; `NUMBERED` holds the usual numbered
    preset.

    **Example**

    ```hot
    ::google::docs::requests/bullets(1, 20).createParagraphBullets.bulletPreset  // "BULLET_DISC_CIRCLE_SQUARE"
    ::google::docs::requests/bullets(1, 20, ::google::docs::requests/NUMBERED).createParagraphBullets.bulletPreset  // "NUMBERED_DECIMAL_ALPHA_ROMAN"
    ```
    """
}
fn
(start: Int, end: Int): Map {
  bullets(start, end, BULLET_DISC, {})
},
(start: Int, end: Int, preset: Str): Map {
  bullets(start, end, preset, {})
},
(start: Int, end: Int, preset: Str, opts: Map): Map {
  {createParagraphBullets: {range: text-range(start, end, opts), bulletPreset: preset}}
}

delete-bullets
meta {
    doc: """
    `deleteParagraphBullets` on the paragraphs in a range.

    **Example**

    ```hot
    ::google::docs::requests/delete-bullets(1, 20)
    // {deleteParagraphBullets: {range: {startIndex: 1, endIndex: 20}}}
    ```
    """
}
fn
(start: Int, end: Int): Map {
  delete-bullets(start, end, {})
},
(start: Int, end: Int, opts: Map): Map {
  {deleteParagraphBullets: {range: text-range(start, end, opts)}}
}

// ---------------------------------------------------------------------------
// Tables, images and breaks
// ---------------------------------------------------------------------------

insert-table
meta {
    doc: """
    `insertTable` at an index. Docs adds a newline before the table, so its
    start index is `add(index, 1)`.

    **Example**

    ```hot
    ::google::docs::requests/insert-table(2, 3, 1)
    // {insertTable: {rows: 2, columns: 3, location: {index: 1}}}
    ```
    """
}
fn
(rows: Int, columns: Int, index: Int): Map {
  insert-table(rows, columns, index, {})
},
(rows: Int, columns: Int, index: Int, opts: Map): Map {
  {insertTable: {rows: rows, columns: columns, location: location(index, opts)}}
}

append-table
meta {
    doc: """
    `insertTable` at the end of the body or segment.

    **Example**

    ```hot
    ::google::docs::requests/append-table(2, 3)
    // {insertTable: {rows: 2, columns: 3, endOfSegmentLocation: {}}}
    ```
    """
}
fn
(rows: Int, columns: Int): Map {
  append-table(rows, columns, {})
},
(rows: Int, columns: Int, opts: Map): Map {
  {insertTable: {rows: rows, columns: columns, endOfSegmentLocation: end-of-segment(opts)}}
}

table-cell
meta {
    doc: """
    A `TableCellLocation`: 0-based row and column of the table starting at
    `table-start` (see `::google::docs::content/tables`).

    **Example**

    ```hot
    ::google::docs::requests/table-cell(2, 0, 1)
    // {tableStartLocation: {index: 2}, rowIndex: 0, columnIndex: 1}
    ```
    """
}
fn
(table-start: Int, row: Int, column: Int): Map {
  table-cell(table-start, row, column, {})
},
(table-start: Int, row: Int, column: Int, opts: Map): Map {
  {tableStartLocation: location(table-start, opts), rowIndex: row, columnIndex: column}
}

insert-table-row
meta {
    doc: """
    `insertTableRow` below (or, with `below` false, above) a row.

    **Example**

    ```hot
    ::google::docs::requests/insert-table-row(2, 0, true).insertTableRow.insertBelow  // true
    ```
    """
}
fn
(table-start: Int, row: Int, below: Bool): Map {
  insert-table-row(table-start, row, below, {})
},
(table-start: Int, row: Int, below: Bool, opts: Map): Map {
  {insertTableRow: {tableCellLocation: table-cell(table-start, row, 0, opts), insertBelow: below}}
}

insert-table-column
meta {
    doc: """
    `insertTableColumn` to the right of (or, with `right` false, to the left
    of) a column.

    **Example**

    ```hot
    ::google::docs::requests/insert-table-column(2, 0, false).insertTableColumn.insertRight  // false
    ```
    """
}
fn
(table-start: Int, column: Int, right: Bool): Map {
  insert-table-column(table-start, column, right, {})
},
(table-start: Int, column: Int, right: Bool, opts: Map): Map {
  {insertTableColumn: {tableCellLocation: table-cell(table-start, 0, column, opts), insertRight: right}}
}

delete-table-row
meta {
    doc: """
    `deleteTableRow`.

    **Example**

    ```hot
    ::google::docs::requests/delete-table-row(2, 1).deleteTableRow.tableCellLocation.rowIndex  // 1
    ```
    """
}
fn
(table-start: Int, row: Int): Map {
  delete-table-row(table-start, row, {})
},
(table-start: Int, row: Int, opts: Map): Map {
  {deleteTableRow: {tableCellLocation: table-cell(table-start, row, 0, opts)}}
}

delete-table-column
meta {
    doc: """
    `deleteTableColumn`.

    **Example**

    ```hot
    ::google::docs::requests/delete-table-column(2, 1).deleteTableColumn.tableCellLocation.columnIndex  // 1
    ```
    """
}
fn
(table-start: Int, column: Int): Map {
  delete-table-column(table-start, column, {})
},
(table-start: Int, column: Int, opts: Map): Map {
  {deleteTableColumn: {tableCellLocation: table-cell(table-start, 0, column, opts)}}
}

object-size
meta {no-doc: true}
fn (opts: Map): Map? {
  width get(opts, "width")
  height get(opts, "height")
  size ::docs/compact({
    width: if(is-null(width), null, points(width)),
    height: if(is-null(height), null, points(height))
  })
  if(is-empty(size), null, size)
}

insert-image
meta {
    doc: """
    `insertInlineImage` from a public URL (PNG, JPEG or GIF under 50 MB).
    `opts.width` and `opts.height` are in points.

    **Example**

    ```hot
    ::google::docs::requests/insert-image("https://hot.dev/logo.png", 1, {width: 120})
    // {insertInlineImage: {uri: "https://hot.dev/logo.png", location: {index: 1}, objectSize: {width: {magnitude: 120, unit: "PT"}}}}
    ```
    """
}
fn
(uri: Str, index: Int): Map {
  insert-image(uri, index, {})
},
(uri: Str, index: Int, opts: Map): Map {
  {insertInlineImage: ::docs/compact({uri: uri, location: location(index, opts), objectSize: object-size(opts)})}
}

append-image
meta {
    doc: """
    `insertInlineImage` at the end of the body or segment.

    **Example**

    ```hot
    ::google::docs::requests/append-image("https://hot.dev/logo.png").insertInlineImage.uri  // "https://hot.dev/logo.png"
    ```
    """
}
fn
(uri: Str): Map {
  append-image(uri, {})
},
(uri: Str, opts: Map): Map {
  {insertInlineImage: ::docs/compact({uri: uri, endOfSegmentLocation: end-of-segment(opts), objectSize: object-size(opts)})}
}

insert-page-break
meta {
    doc: """
    `insertPageBreak` at an index in the body.

    **Example**

    ```hot
    ::google::docs::requests/insert-page-break(12)  // {insertPageBreak: {location: {index: 12}}}
    ```
    """
}
fn
(index: Int): Map {
  insert-page-break(index, {})
},
(index: Int, opts: Map): Map {
  {insertPageBreak: {location: location(index, opts)}}
}

append-page-break
meta {
    doc: """
    `insertPageBreak` at the end of the body.

    **Example**

    ```hot
    ::google::docs::requests/append-page-break()  // {insertPageBreak: {endOfSegmentLocation: {}}}
    ```
