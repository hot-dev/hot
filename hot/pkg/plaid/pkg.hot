::hot::pkg ns

hot.pkg.plaid {
  name: "hot.dev/plaid",
  version: "0.1.1",
  hot-min-version: "3.0.2",
  description: "Plaid bindings for Hot: the Link token flow, Items, accounts, real-time balance, Auth, Identity, transactions sync with the has_more loop, institutions, investments, liabilities, sandbox helpers, and ES256 webhook verification.",
  author: "Hot Dev",
  email: "support@hot.dev",
  license: "Apache-2.0",
  tags: ["finance"],
  deps: {
    "hot.dev/jwt": "0.2.1"
  },
  src-paths: ["src/"],
  test-paths: ["test/"]
}
