modify-vector-store
meta {
    doc: """
    POST /vector_stores/{vector_store_id} - Update a vector store's name,
    expiration, or metadata.

    **Example**

    ```hot
    store ::openai::modify/modify-vector-store("vs_abc123", ::openai::modify/ModifyVectorStoreRequest({
      name: "Support docs v2",
      expires_after: {anchor: "last_active_at", days: 30}
    }))
    store.name
    ```
    """
}
fn
(vector-store-id: Str, request: ModifyVectorStoreRequest): ModifyVectorStoreResponse {
  modify-vector-store(vector-store-id, request, {})
},
(vector-store-id: Str, request: ModifyVectorStoreRequest, opts: Map): ModifyVectorStoreResponse {
  response api-request("POST", `/vector_stores/${vector-store-id}`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { ModifyVectorStoreResponse(response.body) }
    => { err(HttpError(response)) }
  }
}
