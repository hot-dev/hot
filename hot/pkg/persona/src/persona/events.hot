::persona::events ns
meta {
    doc: """Events: the record behind every webhook (kept 30 days). Use `list-events` to backfill after downtime or to reconcile missed deliveries."""
}

::api ::persona::api

seg ::persona::api/seg

list-events
meta {
    doc: """
    GET /events - One page of events, newest first. Filters: `name` (e.g.
    `["inquiry.approved", "inquiry.declined"]`), `object-id`, `id`.
    `opts` takes `page-size`, `after`, `before`.

    **Example**

    ```hot
    ::persona::events/list-events({object-id: "inq_..."}, {page-size: 20})
    ```
    """
}
fn
(filters: Map): Map {
  list-events(filters, {}, {})
},
(filters: Map, opts: Map): Map {
  list-events(filters, opts, opts)
},
(filters: Map, opts: Map, options: Map): Map {
  ::api/list-page("/events", filters, opts, options)
}

get-event
meta {
    doc: """
    GET /events/{id} - Retrieve one event (`evt_...`).

    **Example**

    ```hot
    event ::persona::events/get-event("evt_123")
    ::persona::api/attr(event, "name")
    ```
    """
}
fn
(event-id: Str): Map {
  get-event(event-id, {})
},
(event-id: Str, options: Map): Map {
  ::api/send("GET", `/events/${seg(event-id)}`, {}, null, options)
}
