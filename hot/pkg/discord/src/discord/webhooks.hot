::discord::webhooks ns
meta {
    doc: """
    Webhooks: manage channel webhooks with the bot token, send and edit
    messages through a webhook's own token (no bot token needed), and
    verify Discord's Ed25519-signed interaction and event requests.
    """
}

::api ::discord::api

seg ::discord::api/seg

// ============================================================================
// Webhook management (bot token)
// ============================================================================

CreateWebhookRequest type {
  channel_id: Str,
  name: Str,
  avatar: Str?,
  reason: Str?
}

create-webhook
meta {
    doc: """
    POST /channels/{channel_id}/webhooks - Create a webhook (name 1-80
    characters; `avatar` is a data URI). The result carries the `token`
    used by `execute-webhook`. Needs MANAGE_WEBHOOKS.

    **Example**

    ```hot
    ::webhooks ::discord::webhooks

    hook ::webhooks/create-webhook(::webhooks/CreateWebhookRequest({
      channel_id: "1100000000000000000",
      name: "Hot Notifications"
    }))
    hook.token
    ```
    """
}
fn (request: CreateWebhookRequest): Map {
  ::api/call("POST", `/channels/${seg(request.channel_id)}/webhooks`, {
    body: ::api/body(request, ["channel_id"]),
    reason: request.reason
  })
}

GetChannelWebhooksRequest type {
  channel_id: Str
}

get-channel-webhooks
meta {
    doc: """GET /channels/{channel_id}/webhooks - Webhooks in a channel. Needs MANAGE_WEBHOOKS."""
}
fn (request: GetChannelWebhooksRequest): Vec<Map> {
  ::api/call("GET", `/channels/${seg(request.channel_id)}/webhooks`)
}

GetGuildWebhooksRequest type {
  guild_id: Str
}

get-guild-webhooks
meta {
    doc: """GET /guilds/{guild_id}/webhooks - Webhooks in a guild. Needs MANAGE_WEBHOOKS."""
}
fn (request: GetGuildWebhooksRequest): Vec<Map> {
  ::api/call("GET", `/guilds/${seg(request.guild_id)}/webhooks`)
}

GetWebhookRequest type {
  webhook_id: Str
}

get-webhook
meta {
    doc: """GET /webhooks/{webhook_id} - A webhook by id. Needs MANAGE_WEBHOOKS."""
}
fn (request: GetWebhookRequest): Map {
  ::api/call("GET", `/webhooks/${seg(request.webhook_id)}`)
}

ModifyWebhookRequest type {
  webhook_id: Str,
  name: Str?,
  avatar: Str?,
  channel_id: Str?,
  reason: Str?,
  clear: Vec<Str>?
}

modify-webhook
meta {
    doc: """
    PATCH /webhooks/{webhook_id} - Rename a webhook, change its avatar, or
    move it to `channel_id`. Only fields you set are sent;
    `clear: ["avatar"]` removes the avatar. Needs MANAGE_WEBHOOKS.

    **Example**

    ```hot
    ::webhooks ::discord::webhooks

    ::webhooks/modify-webhook(::webhooks/ModifyWebhookRequest({
      webhook_id: "1600000000000000000",
      channel_id: "1100000000000000001"
    }))
    ```
    """
}
fn (request: ModifyWebhookRequest): Map {
  ::api/call("PATCH", `/webhooks/${seg(request.webhook_id)}`, {
    body: ::api/body(request, ["webhook_id"]),
    reason: request.reason
  })
}

DeleteWebhookRequest type {
  webhook_id: Str,
  reason: Str?
}

delete-webhook
meta {
    doc: """DELETE /webhooks/{webhook_id} - Delete a webhook. Needs MANAGE_WEBHOOKS."""
}
fn (request: DeleteWebhookRequest): Bool {
  ::api/call-ok("DELETE", `/webhooks/${seg(request.webhook_id)}`, {reason: request.reason})
}

// ============================================================================
// Webhook-token routes (no bot token)
// ============================================================================

token-path fn (webhook-id: Str, webhook-token: Str): Str {
  `/webhooks/${seg(webhook-id)}/${seg(webhook-token)}`
}

GetWebhookWithTokenRequest type {
  webhook_id: Str,
  webhook_token: Str
}

get-webhook-with-token
meta {
    doc: """GET /webhooks/{webhook_id}/{webhook_token} - A webhook, authenticated by its token (no bot token, no `user` field)."""
}
fn (request: GetWebhookWithTokenRequest): Map {
  ::api/call("GET", token-path(request.webhook_id, request.webhook_token), {auth: false})
}

ModifyWebhookWithTokenRequest type {
  webhook_id: Str,
  webhook_token: Str,
  name: Str?,
  avatar: Str?,
  clear: Vec<Str>?
}

modify-webhook-with-token
meta {
    doc: """PATCH /webhooks/{webhook_id}/{webhook_token} - Rename a webhook or change its avatar using its token. Cannot move channels."""
}
fn (request: ModifyWebhookWithTokenRequest): Map {
  ::api/call("PATCH", token-path(request.webhook_id, request.webhook_token), {
    body: ::api/body(request, ["webhook_id", "webhook_token"]),
    auth: false
  })
}

DeleteWebhookWithTokenRequest type {
  webhook_id: Str,
  webhook_token: Str
}

delete-webhook-with-token
meta {
    doc: """DELETE /webhooks/{webhook_id}/{webhook_token} - Delete a webhook using its token."""
}
fn (request: DeleteWebhookWithTokenRequest): Bool {
  ::api/call-ok("DELETE", token-path(request.webhook_id, request.webhook_token), {auth: false})
}

ExecuteWebhookRequest type {
  webhook_id: Str,
  webhook_token: Str,
  wait: Bool?,
  thread_id: Str?,
  with_components: Bool?,
  content: Str?,
  username: Str?,
  avatar_url: Str?,
  tts: Bool?,
  embeds: Vec<Map>?,
  allowed_mentions: Map?,
  components: Vec<Map>?,
  attachments: Vec<Map>?,
  flags: Int?,
  thread_name: Str?,
  applied_tags: Vec<Str>?,
  poll: Map?,
  files: Vec<::discord::api/FileUpload>?
}

execute-webhook
meta {
    doc: """
    POST /webhooks/{webhook_id}/{webhook_token} - Send a message through a
    webhook. No bot token needed. Returns the message when `wait: true`,
    otherwise `null` (204). Provide at least one of `content`, `embeds`,
    `components`, `poll` or `files`.

    - `thread_id` posts into a thread; in a forum or media channel pass
      `thread_name` (and optional `applied_tags`) to create a post instead.
    - `username` / `avatar_url` override the webhook's identity per message.
    - `with_components: true` is needed for components on a webhook your
      app doesn't own (non-interactive components only).
    - `files` uploads attachments (multipart); refer to one in an embed as
      `attachment://<filename>`.

    **Example**

    ```hot
    ::webhooks ::discord::webhooks

    msg ::webhooks/execute-webhook(::webhooks/ExecuteWebhookRequest({
      webhook_id: "1600000000000000000",
      webhook_token: "webhook-token",
      content: "Deploy complete",
      embeds: [{title: "v2.1.0", color: 3066993}],
      wait: true
    }))
    msg.id
    ```
    """
}
fn (request: ExecuteWebhookRequest): Map? {
  files or(request.files, [])
  payload ::api/body(request, ["webhook_id", "webhook_token", "wait", "thread_id", "with_components"])
  final cond {
    and(not(is-empty(files)), is-null(request.attachments)) => { assoc(payload, "attachments", ::api/attachments-for(files)) }
    => { payload }
  }

  ::api/call("POST", token-path(request.webhook_id, request.webhook_token), {
    query: {wait: request.wait, thread_id: request.thread_id, with_components: request.with_components},
    body: final,
    files: files,
    auth: false
  })
}

GetWebhookMessageRequest type {
  webhook_id: Str,
  webhook_token: Str,
  message_id: Str,
  thread_id: Str?
}

get-webhook-message
meta {
    doc: """GET /webhooks/{webhook_id}/{webhook_token}/messages/{message_id} - A message this webhook sent. Pass `thread_id` for messages in a thread."""
}
fn (request: GetWebhookMessageRequest): Map {
  ::api/call("GET", `${token-path(request.webhook_id, request.webhook_token)}/messages/${seg(request.message_id)}`, {
    query: {thread_id: request.thread_id},
    auth: false
  })
}

EditWebhookMessageRequest type {
  webhook_id: Str,
  webhook_token: Str,
  message_id: Str,
  thread_id: Str?,
  with_components: Bool?,
  content: Str?,
  embeds: Vec<Map>?,
  flags: Int?,
  allowed_mentions: Map?,
  components: Vec<Map>?,
  attachments: Vec<Map>?,
  poll: Map?,
  files: Vec<::discord::api/FileUpload>?,
  clear: Vec<Str>?
}

edit-webhook-message
meta {
    doc: """
    PATCH /webhooks/{webhook_id}/{webhook_token}/messages/{message_id} -
    Edit a message this webhook sent. Only fields you set are sent.
    `attachments` is the full list to keep; new `files` are appended.
    """
}
fn (request: EditWebhookMessageRequest): Map {
  ::api/call("PATCH", `${token-path(request.webhook_id, request.webhook_token)}/messages/${seg(request.message_id)}`, {
    query: {thread_id: request.thread_id, with_components: request.with_components},
    body: ::api/body(request, ["webhook_id", "webhook_token", "message_id", "thread_id", "with_components"]),
    files: or(request.files, []),
    auth: false
  })
}

DeleteWebhookMessageRequest type {
  webhook_id: Str,
  webhook_token: Str,
  message_id: Str,
  thread_id: Str?
}

delete-webhook-message
meta {
    doc: """DELETE /webhooks/{webhook_id}/{webhook_token}/messages/{message_id} - Delete a message this webhook sent."""
}
fn (request: DeleteWebhookMessageRequest): Bool {
  ::api/call-ok("DELETE", `${token-path(request.webhook_id, request.webhook_token)}/messages/${seg(request.message_id)}`, {
    query: {thread_id: request.thread_id},
    auth: false
  })
}

// ============================================================================
// Request signature verification (Ed25519)
// ============================================================================
// Discord signs interaction callbacks (and webhook events) with Ed25519
// over `${X-Signature-Timestamp}${raw body}`, using the application's
// public key from the Developer Portal. Discord sends a signed PING when
// you save the endpoint URL and periodically sends invalid signatures to
// check that you reject them: answer 401 on failure.
//
// See: https://discord.com/developers/docs/interactions/receiving-and-responding#security-and-authorization

signed-message fn (timestamp: Str, raw: Str | Bytes): Str | Bytes {
  if(is-bytes(raw), concat(Bytes(timestamp), raw), `${timestamp}${raw}`)
}

verify-request
meta {
    ctx: {"discord.public.key": {required: false}},
    doc: """
    Verify a Discord interaction (or webhook event) request: the Ed25519
    signature in `X-Signature-Ed25519` over `X-Signature-Timestamp` plus
    the raw body (`::hot::http/raw-body`), and a replay window on the
    timestamp (default 300 seconds; pass 0 as the third argument to
    disable). Returns false for missing headers, a bad signature, a stale
    or non-numeric timestamp, or an invalid public key.

    The 1-arity form reads `discord.public.key` and fails when it is not
    set. The replay window is stricter than Discord requires: on a host
    whose clock is more than 5 minutes off, every request (including
    Discord's endpoint-verification PING) fails, so pass 0 there.

    **Example**

    ```hot
    on-interaction
    meta {webhook: {service: "discord", path: "/interactions", method: "POST"}}
    fn (request: ::hot::http/HttpRequest): ::hot::http/HttpResponse {
      // Uses discord.public.key; pass the hex key as a second argument instead
      cond {
        not(::discord::webhooks/verify-request(request)) => { ::hot::http/HttpResponse({status: 401, body: "invalid request signature"}) }
        => { ::hot::http/HttpResponse({status: 200, body: {type: 1}}) }
      }
    }
    ```
    """
}
fn
(request: Map): Bool {
  public-key or(::hot::ctx/get("discord.public.key"), "")
  if(is-empty(public-key),
    fail("discord.public.key is not set. Add it in Context Variables to verify interaction requests.")
  )
  verify-request(request, public-key)
},
(request: Map, public-key: Str): Bool {
  verify-request(request, public-key, 300)
},
// 3-arity: explicit replay tolerance in seconds (0 disables the check)
(request: Map, public-key: Str, tolerance-seconds: Int): Bool {
  headers or(get(request, "headers"), {})
  signature or(get(headers, "x-signature-ed25519"), "")
  timestamp or(get(headers, "x-signature-timestamp"), "")

  cond {
    is-empty(public-key) => { false }
    is-empty(signature) => { false }
    is-empty(timestamp) => { false }
    => {
      // Replay window first: cheap, and skips the Ed25519 check for stale
      // or non-numeric timestamps (fail closed).
      fresh cond {
        eq(tolerance-seconds, 0) => { true }
        => { ::hot::time/within-seconds-of-now(timestamp, tolerance-seconds) }
      }

      cond {
        not(fresh) => { false }
        => {
          valid ::hot::hash/ed25519-verify(public-key, signed-message(timestamp, ::hot::http/raw-body(request)), signature)
          // A malformed public key is an Err: fail closed.
          if(is-err(valid), false, valid)
        }
      }
    }
  }
}
