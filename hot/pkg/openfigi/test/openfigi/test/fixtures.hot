// POST /search {} answers 200 with an error body
EMPTY_SEARCH {error: "query must contain at least one parameter"}

// POST /mapping with 11 jobs and no key: 413, text body
TOO_MANY_JOBS_BODY "Request may only contain 10 mapping jobs."

// POST /mapping with a bad key: 401, text body
BAD_KEY_BODY "Invalid API key."

// FIGIs seen in the responses above (composite, share class and option)
KNOWN_FIGIS ["BBG000B9XRY4", "BBG001S5N8V8", "BBG000BLNNH6", "BBG001S5S399", "BBG000TKJLW1", "BBG0002LH0C8", "BBG000B9XVV8"]
