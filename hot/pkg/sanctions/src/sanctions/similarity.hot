::sanctions::similarity ns
meta {
    doc: """
    String and token similarity implemented in Hot: Jaro, Jaro-Winkler,
    Levenshtein distance and ratio, and a soft token-set score. Every
    result is a Dec in [0, 1] rounded to four places, so scores are
    deterministic across runs and platforms.
    """
}

::text ::sanctions::text

round4
meta {
    doc: """Round a number to four decimal places."""
}
fn (x: Any): Dec {
  div(Dec(round(mul(x, 10000))), 10000)
}

// ---------------------------------------------------------------------------
// Jaro / Jaro-Winkler
// ---------------------------------------------------------------------------

// Find the first unused position j in [lo, hi] of `b` holding `ch`.
jaro-find fn (b: Vec<Str>, used: Map, ch: Str, j: Int, hi: Int): Int {
  cond {
    gt(j, hi) => { -1 }
    and(eq(b[j], ch), not(get(used, j, false))) => { j }
    => { jaro-find(b, used, ch, add(j, 1), hi) }
  }
}

jaro-chars fn (a: Vec<Str>, b: Vec<Str>): Dec {
  la length(a)
  lb length(b)
  cond {
    and(eq(la, 0), eq(lb, 0)) => { 1.0 }
    or(eq(la, 0), eq(lb, 0)) => { 0.0 }
    => {
      window max(0, sub(floor(div(max(la, lb), 2)), 1))
      state reduce(range(0, la), (acc, i) {
        lo max(0, sub(i, window))
        hi min(sub(lb, 1), add(i, window))
        j jaro-find(b, acc.used, a[i], lo, hi)
        if(lt(j, 0), acc, {used: assoc(acc.used, j, true), ma: concat(acc.ma, [a[i]])})
      }, {used: {}, ma: []})
      m length(state.ma)
      cond {
        eq(m, 0) => { 0.0 }
        => {
          mb map(filter(range(0, lb), (j) { get(state.used, j, false) }), (j) { b[j] })
          half-t reduce(range(0, m), (n, k) { if(eq(state.ma[k], mb[k]), n, add(n, 1)) }, 0)
          t div(half-t, 2)
          div(add(add(div(m, la), div(m, lb)), div(sub(m, t), m)), 3)
        }
      }
    }
  }
}

common-prefix fn (a: Vec<Str>, b: Vec<Str>, i: Int, cap: Int): Int {
  cond {
    gte(i, cap) => { i }
    gte(i, length(a)) => { i }
    gte(i, length(b)) => { i }
    eq(a[i], b[i]) => { common-prefix(a, b, add(i, 1), cap) }
    => { i }
  }
}

jaro
meta {
    doc: """
    Jaro similarity of two strings (by character).

    **Example**

    ```hot
    ::sanctions::similarity/jaro("martha", "marhta")  // 0.9444
    ```
    """
}
fn (a: Str, b: Str): Dec {
  round4(jaro-chars(::text/chars(a), ::text/chars(b)))
}

jaro-winkler
meta {
    doc: """
    Jaro-Winkler similarity: Jaro plus a bonus of 0.1 per shared
    leading character (up to four) when the Jaro score is above 0.7.

    **Example**

    ```hot
    ::sanctions::similarity/jaro-winkler("martha", "marhta")  // 0.9611
    ::sanctions::similarity/jaro-winkler("dixon", "dicksonx") // 0.8133
    ```
    """
}
fn (a: Str, b: Str): Dec {
  cond {
    eq(a, b) => { 1.0 }
    => {
      ca ::text/chars(a)
      cb ::text/chars(b)
      j jaro-chars(ca, cb)
      cond {
        lte(j, 0.7) => { round4(j) }
        => {
          l common-prefix(ca, cb, 0, 4)
          round4(add(j, mul(mul(l, 0.1), sub(1, j))))
        }
      }
    }
  }
}

// ---------------------------------------------------------------------------
// Levenshtein
// ---------------------------------------------------------------------------

lev-row fn (a: Vec<Str>, ch: Str, prev: Vec<Int>, row-index: Int): Vec<Int> {
  // prev is the previous DP row (length |a|+1); build the next one.
  reduce(range(0, length(a)), (row, i) {
    cost if(eq(a[i], ch), 0, 1)
    best min(min(add(get(prev, add(i, 1)), 1), add(last(row), 1)), add(prev[i], cost))
    concat(row, [best])
  }, [row-index])
}

levenshtein
meta {
    doc: """
    Levenshtein edit distance (insertions, deletions and substitutions
    each cost 1), by character.

    **Example**

    ```hot
    ::sanctions::similarity/levenshtein("kitten", "sitting")  // 3
    ```
    """
}
fn (a: Str, b: Str): Int {
  ca ::text/chars(a)
  cb ::text/chars(b)
  first-row range(0, add(length(ca), 1))
  final reduce(range(0, length(cb)), (prev, j) { lev-row(ca, cb[j], prev, add(j, 1)) }, first-row)
  last(final)
}

levenshtein-ratio
meta {
    doc: """
    `1 - distance / max(length)`: 1.0 for equal strings, 0.0 for
    nothing in common.

    **Example**

    ```hot
    ::sanctions::similarity/levenshtein-ratio("kitten", "sitting")  // 0.5714
    ```
    """
}
fn (a: Str, b: Str): Dec {
  longest max(length(a), length(b))
  cond {
    eq(longest, 0) => { 1.0 }
    => { round4(sub(1, div(levenshtein(a, b), longest))) }
  }
}

// ---------------------------------------------------------------------------
// Token-set similarity
// ---------------------------------------------------------------------------

SOFT_TOKEN_FLOOR 0.8

token-sim
meta {
    doc: """Similarity of two tokens: 1.0 when equal, 0 when the first letters differ, otherwise Jaro-Winkler, and 0 below 0.8 (so unrelated tokens never add partial credit)."""
}
fn (a: Str, b: Str): Dec {
  cond {
    eq(a, b) => { 1.0 }
    // Typos rarely change the first letter; skipping those pairs avoids
    // most Jaro-Winkler calls.
    ne(slice(a, 0, 1), slice(b, 0, 1)) => { 0.0 }
    => {
      s jaro-winkler(a, b)
      if(lt(s, SOFT_TOKEN_FLOOR), 0.0, s)
    }
  }
}

counted fn (toks: Vec<Str>, bests: Vec): Vec {
  // Unmatched name particles ("al", "bin", "van") neither add nor cost.
  filter(map-indexed(toks, (i, t) { {t: t, best: get(bests, i)} }), (x) {
    or(gt(x.best, 0), not(::text/is-particle(x.t)))
  })
}

token-set
meta {
    doc: """
    Soft token-set (Dice) similarity of two token lists: every token on
    either side takes its best `token-sim` against the other side, and
    the sum is divided by the number of tokens counted. Order-insensitive;
    extra tokens on either side lower the score, except name particles
    (`al`, `bin`, `van`, ...) that match nothing, which are not counted.

    **Example**

    ```hot
    ::sanctions::similarity/token-set(["abu", "abbas"], ["abbas", "abu"])  // 1.0
    ::sanctions::similarity/token-set(["john", "smith"], ["jon", "smith", "jr"])
    ```
    """
}
fn (a: Vec<Str>, b: Vec<Str>): Dec {
  cond {
    and(is-empty(a), is-empty(b)) => { 1.0 }
    or(is-empty(a), is-empty(b)) => { 0.0 }
    => {
      matrix map(a, (x) { map(b, (y) { token-sim(x, y) }) })
      row-best map(matrix, (row) { reduce(row, max, 0.0) })
      col-best map(range(0, length(b)), (j) { reduce(matrix, (m, row) { max(m, get(row, j)) }, 0.0) })
      kept concat(counted(a, row-best), counted(b, col-best))
      total length(kept)
      cond {
        eq(total, 0) => { 0.0 }
        => { round4(div(reduce(kept, (acc, x) { add(acc, x.best) }, 0.0), total)) }
      }
    }
  }
}

name-similarity
meta {
    doc: """
    The name score used by screening, for two normalized token lists:
    the soft `token-set` score, or the same with name particles merged
    into the next token (`al zawahiri` against `alzawahiri`, see
    `::sanctions::text/merge-particles`) when that is higher. Token
    order does not matter; extra or missing tokens lower the score.

    **Example**

    ```hot
    ::sanctions::similarity/name-similarity(["ayman", "al", "zawahiri"], ["al", "zawahiri", "ayman"])  // 1.0
    ::sanctions::similarity/name-similarity(["ayman", "alzawahiri"], ["al", "zawahiri", "ayman"])        // 1.0
    ```
    """
}
fn (q: Vec<Str>, c: Vec<Str>): Dec {
  cond {
    eq(q, c) => { 1.0 }
    => {
      direct token-set(q, c)
      mq ::text/merge-particles(q)
      mc ::text/merge-particles(c)
      merged if(and(eq(mq, q), eq(mc, c)), 0.0, token-set(mq, mc))
      max(direct, merged)
    }
  }
}
