// Relationships
// ---------------------------------------------------------------------------

direct-parent
meta {
    doc: """The direct accounting-consolidation parent's LEI record, or null when none is reported (check `direct-parent-exception` for the reason)."""
}
fn
(lei: Str): Map? {
  direct-parent(lei, {})
},
(lei: Str, opts: Map): Map? {
