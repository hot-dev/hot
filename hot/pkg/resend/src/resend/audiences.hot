update-single-contact-by-id
meta {
    doc: """
    Update a contact's email, name, or subscription status by their contact
    ID.

    **Example**

    ```hot
    updated ::resend::audiences/update-single-contact-by-id("e169aa45-1ecf-4183-9955-b1499d5701d3", "78261eea-8f8b-4381-83c6-79fa7120f1cf", ::resend::audiences/PATCHAudiencesAudienceIdContactsIdRequest({
        unsubscribed: true
    }))
    updated.id
    ```
    """
}
fn
(id: Str, audience-id: Str, request: PATCHAudiencesAudienceIdContactsIdRequest): PATCHAudiencesAudienceIdContactsIdResponse {
  update-single-contact-by-id(id, audience-id, request, {})
},
(id: Str, audience-id: Str, request: PATCHAudiencesAudienceIdContactsIdRequest, opts: Map): PATCHAudiencesAudienceIdContactsIdResponse {
  response api-request("PATCH", `${::resend/BASE_URL}/audiences/${audience-id}/contacts/${id}`, {}, request, opts)
  cond {
    is-err(response) => { response }
    is-ok-response(response) => { PATCHAudiencesAudienceIdContactsIdResponse(response.body) }
    => { err(HttpError(response)) }
  }
}

