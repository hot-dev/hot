::attio::notes ns

::api ::attio::api

build-note-payload
meta {
    doc: """
    Build the create-note payload (plaintext format). Exposed for testing;
    `create-note` uses it.

    **Example**

    ```hot
    ::attio::notes/build-note-payload("people", "record-1", "Intro call", "Wants a demo.").data.format  // "plaintext"
    ```
    """
}
fn (parent-object: Str, parent-record-id: Str, title: Str, content: Str): Map {
  {
    data: {
      parent_object: parent-object,
      parent_record_id: parent-record-id,
      title: title,
      format: "plaintext",
      content: content
    }
  }
}

create-note
meta {
    doc: """
    POST /notes - Attach a note to a record.

    **Example**

    ```hot
    ::attio::notes/create-note("people", "7f4e2a10-3b9c-4d2a-8f1e-6a5c9d0b1e23", "Demo call", "Positive; follow up Friday.")
    ```
    """
}
fn
(parent-object: Str, parent-record-id: Str, title: Str, content: Str): Map {
  create-note(parent-object, parent-record-id, title, content, {})
},
(parent-object: Str, parent-record-id: Str, title: Str, content: Str, opts: Map): Map {
  out ::api/json("POST", "/notes", build-note-payload(parent-object, parent-record-id, title, content), opts)
  match out {
    Result.Err => { err(out) }

    _ => { out.data }
  }
}

list-notes
meta {
    doc: """
    GET /notes?parent_object=&parent_record_id= - The notes on a record.

    **Example**

    ```hot
    notes ::attio::notes/list-notes("people", ::attio::recordsEC)
    map(notes.data, %.title)
    ```
    """
}
fn
(parent-object: Str, parent-record-id: Str): Map {
  list-notes(parent-object, parent-record-id, {})
},
(parent-object: Str, parent-record-id: Str, opts: Map): Map {
  ::api/json("GET", `/notes?parent_object=${parent-object}&parent_record_id=${parent-record-id}`, "", opts)
}

delete-note
meta {
    doc: """
    DELETE /notes/{id} - Delete a note.

    **Example**

    ```hot
    ::attio::notes/delete-note("c2d8e4f1-5a6b-47c9-b0d3-1e2f3a4b5c6d")
    ```
    """
}
fn
(note-id: Str): Any {
  delete-note(note-id, {})
},
(note-id: Str, opts: Map): Any {
  ::api/json("DELETE", `/notes/${note-id}`, "", opts)
}

