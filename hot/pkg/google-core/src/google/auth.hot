::google::auth ns
meta {
    doc: """
    Google credential resolution, scopes, and the per-run token cache.
    Usually used indirectly through `::google::api/request`.

    **Credential sources.** Per-call `opts` win over context. When `opts`
    carries a primary credential (`token`, `refresh-token`,
    `service-account` or `api-key`), context is ignored for that call;
    otherwise context is used, with `opts.subject` and `opts.scopes`
    still applied on top. Within one source the order is: access token,
    refresh token, service account, API key.

    **Per-call safety.** A credential key present in `opts` but blank or
    null is an Err naming the key, never a fallback to context: a tenant
    whose credential is missing must not run on the project's. Per-call
    credentials and every token Google returns are masked in call records
    (`::hot::ctx/mark-secret`), and nothing from `opts` is written to
    context.

    | Credential | `opts` keys | Context variables |
    |---|---|---|
    | Access token | `token` | `google.access.token` |
    | User refresh token | `refresh-token`, `client-id`, `client-secret` | `google.oauth.refresh-token`, `google.oauth.client-id`, `google.oauth.client-secret` |
    | Service account | `service-account` (JSON Str or Map), `subject` | `google.service.account`, `google.impersonate` |
    | API key (public data) | `api-key` | `google.api.key` |

    A service-account key may also be an `authorized_user` JSON file
    (what `gcloud auth application-default login` writes); it is treated
    as a refresh token.

    **Scopes.** Service-account tokens are minted for the scopes the call
    asks for: `opts.scopes`, else the `google.scopes` context variable,
    else the scope the service function passes. Scopes are a Vec or a
    space/comma-separated Str; short names such as `"drive.readonly"`
    are expanded to `https://www.googleapis.com/auth/drive.readonly`.
    Access and refresh tokens carry whatever scopes the user granted at
    consent time, so the requested scope is not sent for them.

    **Token cache.** Minted tokens are cached in the run's execution
    context (`::hot::ctx`, stored as secrets) under a key derived from the
    credential identity, the sorted scope set and the subject, until
    `expires_in` minus 60 seconds. The cache lives for one run: a run that
    makes 200 Drive calls mints one token, and the next run mints again.
    Explicit access tokens are never cached.
    """
}

::ctx ::hot::ctx
::hash ::hot::hash
::time ::hot::time
::jwt ::jwt
::oauth2 ::oauth2

CACHE_PREFIX "google.token-cache."
EXPIRY_MARGIN_SECONDS 60

// Keys an `opts` Map may carry that belong to google-core (credentials,
// scopes, the immediate-retry switch) rather than to the API being called. Service
// packages strip these before building query strings.
CREDENTIAL_KEYS ["token", "api-key", "refresh-token", "client-id", "client-secret", "service-account", "subject", "scopes", "retry"]

// Keys that say who a call acts as: in `opts`, each must have a value.
IDENTITY_KEYS ["token", "api-key", "refresh-token", "client-id", "client-secret", "service-account", "subject"]

// Secret values, masked in call records. A service-account key is handled by
// `parse-service-account`: its client_email and project_id stay readable.
SECRET_KEYS ["token", "api-key", "refresh-token", "client-secret"]
SERVICE_ACCOUNT_SECRET_FIELDS ["private_key", "client_secret", "refresh_token"]
TOKEN_RESPONSE_SECRET_FIELDS ["access_token", "refresh_token", "id_token"]

TokenError
meta {
    doc: """
    A credential or token-endpoint failure. `message` is readable, e.g.
    `"google: token exchange failed: invalid_grant (Token has been expired
    or revoked.)"`; `error-code` and `error-description` carry Google's
    OAuth `error` / `error_description` when the token endpoint answered.
    """
}
type {
    message: Str,
    status: Int?,
    error-code: Str?,
    error-description: Str?,
    body: Any?
}

token-error
meta {
    doc: """
    Build a `TokenError`. The 1-arity form wraps a plain message; the
    2-arity form prefixes the payload of a failed `::oauth2` call (`{status,
    body}` or a transport error).

    **Example**

    ```hot
    ::google::auth/token-error("google: no key").message  // "google: no key"

    failure ::google::auth/token-error("google: token exchange failed", {
      status: 400,
      body: {error: "invalid_grant", error_description: "Token expired"}
    })
    failure.message  // "google: token exchange failed: invalid_grant (Token expired)"
    failure.error-code  // "invalid_grant"
    ```
    """
}
fn
(message: Str): TokenError {
  TokenError({message: message})
},
(prefix: Str, payload: Any): TokenError {
  body if(is-map(payload), payload.body, null)
  status if(is-map(payload), payload.status, null)
  code if(is-map(body), body.error, null)
  desc if(is-map(body), body.error_description, null)
  detail cond {
    and(is-some(code), is-some(desc)) => { `${code} (${desc})` }
    is-some(code) => { Str(code) }
    is-str(body) => { body }
    is-some(status) => { `HTTP ${status}` }
    => { err-message(payload) }
  }

  TokenError({
    message: `${prefix}: ${detail}`,
    status: status,
    error-code: code,
    error-description: desc,
    body: body
  })
}

// ---------------------------------------------------------------------------
// Small helpers
// ---------------------------------------------------------------------------

is-blank-value
meta {
    doc: """
    True for null, `""`, and whitespace-only strings (context placeholders
    wire `""` for unset env vars).

    **Example**

    ```hot
    ::google::auth/is-blank-value("  ")  // true
    ::google::auth/is-blank-value(null)  // true
    ::google::auth/is-blank-value("drive.file")  // false
    ```
    """
}
fn (value: Any): Bool {
  or(is-null(value), and(is-str(value), is-empty(trim(value))))
}

now-ms
meta {no-doc: true}
fn (): Int {
  ::time/epoch-millis(::time/now())
}

mark-fields
meta {
    doc: """
    Mask the non-blank values of `names` in `source` in this run's call
    records, and return `source` unchanged.

    **Example**

    ```hot
    source {token: ::hot::ctx/get("tenant.google.token"), q: "reports"}

    // Masks the token in this run's call records. The Map comes back as it was.
    ::google::auth/mark-fields(source, ["token"])
    ```
    """
}
fn (source: Map, names: Vec): Map {
  ::ctx/mark-secret(filter-keys(filter-vals(source, (v) { not(is-blank-value(v)) }), (k) { in(k, names) }))
  source
}

mark-token-response
meta {
    doc: """
    Mask a token response's `access_token`, `refresh_token` and `id_token`
    in call records, and return it unchanged. Call it before a token leaves
    the function that obtained it.

    **Example**

    ```hot
    response ::hot::http/post("https://oauth2.example.com/token", {grant_type: "client_credentials"})
    tokens ::google::auth/mark-token-response(response.body)
    tokens.expires_in
    ```
    """
}
fn (tokens: Map): Map {
  mark-fields(tokens, TOKEN_RESPONSE_SECRET_FIELDS)
}

// ---------------------------------------------------------------------------
// Scopes
// ---------------------------------------------------------------------------

expand-scope
meta {
    doc: """
    Expand a short scope name to its full URL: `"drive.file"` becomes
    `"https://www.googleapis.com/auth/drive.file"`. Full URLs and the
    OpenID scopes (`openid`, `email`, `profile`) pass through.

    **Example**

    ```hot
    ::google::auth/expand-scope("drive.file")  // "https://www.googleapis.com/auth/drive.file"
    ::google::auth/expand-scope("openid")  // "openid"
    ```
    """
}
fn (scope: Str): Str {
  s trim(scope)
  cond {
    starts-with(s, "https://") => { s }
    in(s, ["openid", "email", "profile"]) => { s }
    => { `${::google/SCOPE_PREFIX}${s}` }
  }
}

normalize-scopes
meta {
    doc: """
    Normalise a scope value to a de-duplicated Vec of full scope URLs.
    Accepts null (empty), a Vec, or a Str separated by spaces or commas.

    ```hot
    ::google::auth/normalize-scopes("drive.readonly, gmail.readonly")
    // ["https://www.googleapis.com/auth/drive.readonly",
    //  "https://www.googleapis.com/auth/gmail.readonly"]
    ```
    """
}
fn (scopes: Any): Vec {
  raw cond {
    is-null(scopes) => { [] }
    is-vec(scopes) => { scopes }
    => { split(replace(Str(scopes), ",", " "), " ") }
  }

  distinct(map(filter(raw, (s) { not(is-blank-value(s)) }), (s) { expand-scope(Str(s)) }))
}

effective-scopes
meta {
    ctx: {"google.scopes": {required: false, secret: false}},
    doc: """
    The scopes a call requests: `opts.scopes` when set, else the
    `google.scopes` context variable, else `default-scopes` (what the
    service function asked for). Returns a normalised Vec.

    Set `google.scopes` when a service account's domain-wide delegation
    grant lists different scopes than the package defaults (for example
    only `drive.readonly`); it then applies to every call in the run, so
    include every scope those calls need.

    **Example**

    ```hot
    ::google::auth/effective-scopes("drive.readonly", {scopes: "drive.file"})  // ["https://www.googleapis.com/auth/drive.file"]
    ```
    """
}
fn (default-scopes: Any, opts: Map): Vec {
  ctx-scopes ::ctx/get("google.scopes")
  cond {
    not(is-blank-value(opts.scopes)) => { normalize-scopes(opts.scopes) }
    and(not(is-blank-value(ctx-scopes)), not(is-empty(normalize-scopes(ctx-scopes)))) => { normalize-scopes(ctx-scopes) }
    => { normalize-scopes(default-scopes) }
  }
}

// ---------------------------------------------------------------------------
// Credential resolution
// ---------------------------------------------------------------------------

has-primary-credential
meta {
    doc: """
    True when `source` carries a primary credential: `token`,
    `refresh-token`, `service-account` or `api-key`.

    **Example**

    ```hot
    ::google::auth/has-primary-credential({subject: "ada@example.com"})  // false
    ::google::auth/has-primary-credential({token: ""})  // false
    ```
    """
}
fn (source: Map): Bool {
  or(
    not(is-blank-value(source.token)),
    not(is-blank-value(get(source, "refresh-token"))),
    not(is-blank-value(get(source, "service-account"))),
    not(is-blank-value(get(source, "api-key")))
  )
}

ctx-source
meta {
    ctx: {
        "google.access.token": {required: false},
        "google.oauth.client-id": {required: false, secret: false},
        "google.oauth.client-secret": {required: false},
        "google.oauth.refresh-token": {required: false},
        "google.service.account": {required: false},
        "google.impersonate": {required: false, secret: false},
        "google.api.key": {required: false}
    },
    doc: """
    The credential source read from context, in the same shape as `opts`.

    **Example**

    ```hot
    source ::google::auth/ctx-source()
    ::google::auth/has-primary-credential(source)
    ```
    """
}
fn (): Map {
  {
    token: ::ctx/get("google.access.token"),
    refresh-token: ::ctx/get("google.oauth.refresh-token"),
    client-id: ::ctx/get("google.oauth.client-id"),
    client-secret: ::ctx/get("google.oauth.client-secret"),
    service-account: ::ctx/get("google.service.account"),
    subject: ::ctx/get("google.impersonate"),
    api-key: ::ctx/get("google.api.key")
  }
}

merge-sources
meta {
    doc: """
    Pick the credential source for a call: `opts` alone when it carries a
    primary credential, otherwise `ctx` with `opts.subject` layered on top.
    Pure; `resolve-credentials` passes the live context.

    **Example**

    ```hot
    context {service-account: "key-from-context"}
    ::google::auth/merge-sources({subject: "ada@example.com"}, context)  // {service-account: "key-from-context", subject: "ada@example.com"}
    ::google::auth/merge-sources({}, context)  // {service-account: "key-from-context"}
    ```
    """
}
fn (opts: Map, ctx: Map): Map {
  cond {
    has-primary-credential(opts) => { opts }
    not(is-blank-value(opts.subject)) => { {...ctx, subject: opts.subject} }
    => { ctx }
  }
}

parse-service-account
meta {
    doc: """
    Parse a service-account key (JSON Str or Map) and check it has
    `client_email` and `private_key`. An `authorized_user` key (from
    `gcloud auth application-default login`) is returned as-is with
    `type: "authorized_user"`. Returns the Map or a `TokenError`. Its
    secret fields are masked in call records from here on, whichever
    source the key came from.

    **Example**

    ```hot
    key ::google::auth/parse-service-account(::hot::ctx/get("google.service.account"))
    key.client_email
    ```
    """
}
fn (key: Any): Map {
  parsed if(is-str(key), from-json(key), key)
  cond {
    is-err(parsed) => { err(token-error("google: the service-account key is not valid JSON")) }
    not(is-map(parsed)) => { err(token-error("google: the service-account key must be a JSON object")) }
    => {
      mark-fields(parsed, SERVICE_ACCOUNT_SECRET_FIELDS)
      cond {
        eq(parsed.type, "authorized_user") => { parsed }
        or(is-blank-value(parsed.client_email), is-blank-value(parsed.private_key)) => {
          err(token-error("google: the service-account key has no client_email or private_key"))
        }
        => { parsed }
      }
    }
  }
}

refresh-credentials
meta {no-doc: true}
fn (client-id: Any, client-secret: Any, refresh-token: Str): Map {
  cond {
    is-blank-value(client-id) => {
      err(token-error("google: a refresh token is set but the OAuth client-id is missing. Set google.oauth.client-id (and google.oauth.client-secret) or pass client-id in opts."))
    }
    => {
      {
        kind: "refresh",
        refresh-token: refresh-token,
        client-id: Str(client-id),
        client-secret: if(is-blank-value(client-secret), null, Str(client-secret))
      }
    }
  }
}

credentials-from
meta {
    doc: """
    Turn a credential source Map (the `opts` shape) into resolved
    credentials: `{kind: "token" | "refresh" | "service-account" |
    "api-key", ...}`. Returns a `TokenError` when nothing usable is set or
    a refresh token lacks its client-id. Pure; no network.

    **Example**

    ```hot
    creds ::google::auth/credentials-from({token: ::hot::ctx/get("tenant.google.token")})

    // One of token, refresh, service-account or api-key
    creds.kind
    ```
    """
}
fn (source: Map): Map {
  cond {
    not(is-blank-value(source.token)) => { {kind: "token", token: Str(source.token)} }

    not(is-blank-value(get(source, "refresh-token"))) => {
      refresh-credentials(get(source, "client-id"), get(source, "client-secret"), Str(get(source, "refresh-token")))
    }

    not(is-blank-value(get(source, "service-account"))) => {
      sa parse-service-account(get(source, "service-account"))
      cond {
        is-err(sa) => { sa }
        eq(sa.type, "authorized_user") => {
          refresh-credentials(sa.client_id, sa.client_secret, Str(or(sa.refresh_token, "")))
        }
        => {
          {
            kind: "service-account",
            service-account: sa,
            subject: if(is-blank-value(source.subject), null, Str(source.subject))
          }
        }
      }
    }

    not(is-blank-value(get(source, "api-key"))) => { {kind: "api-key", api-key: Str(get(source, "api-key"))} }

    => {
      err(token-error("google: no credentials configured. Set google.access.token, the google.oauth.* refresh trio, google.service.account, or google.api.key in Context Variables, or pass credentials in opts."))
    }
  }
}

blank-credential
meta {
    doc: """
    The first credential key `opts` has with a blank or null value, else
    null (pure). Such a key is an error, never a fallback to context.

    **Example**

    ```hot
    ::google::auth/blank-credential({token: ""})  // "token"
    ::google::auth/blank-credential({scopes: "drive.file"})  // null
    ```
    """
}
fn (opts: Map): Str? {
  find-first(IDENTITY_KEYS, (key) { and(in(key, keys(opts)), is-blank-value(get(opts, key))) })
}

mark-credentials
meta {
    doc: """
    Mask every credential in `opts` in this run's call records, and return
    `opts` unchanged. A service-account key that is a JSON Str is masked
    whole, and its secret fields separately once parsed.

    **Example**

    ```hot
    opts {refresh-token: ::hot::ctx/get("tenant.google.refresh-token"), client-id: "123.apps.googleusercontent.com"}

    // Masks the refresh token in this run's call records
    ::google::auth/mark-credentials(opts)
    ```
    """
}
fn (opts: Map): Map {
  service-account get(opts, "service-account")
  mark-fields(opts, SECRET_KEYS)
  if(is-str(service-account), ::ctx/mark-secret(service-account))
  if(is-some(service-account), parse-service-account(service-account))
  opts
}

resolve-credentials
meta {
    doc: """
    Resolve the credentials for a call from `opts` and context (see the
    namespace doc for precedence). A credential key in `opts` that is
    blank or null is a `TokenError` naming the key. Credentials from
    `opts` are masked in call records before any request is made.

    **Example**

    ```hot
    creds ::google::auth/resolve-credentials({token: "ya29.tenant-access-token"})
    creds.kind   // "token"
    ```
    """
}
fn
(): Map {
  resolve-credentials({})
},
(opts: Map): Map {
  blank blank-credential(opts)
  cond {
    is-some(blank) => {
      err(token-error(`google: ${blank} is in the call's opts but is blank or null. Pass a value, or leave ${blank} out to use context credentials.`))
    }
    => {
      mark-credentials(opts)
      credentials-from(merge-sources(opts, ctx-source()))
    }
  }
}

// ---------------------------------------------------------------------------
// Token cache (per run, in the execution context)
// ---------------------------------------------------------------------------

token-cache-key
meta {
    doc: """
    The context key a minted token is cached under, or null for
    credentials that are never cached (access tokens, API keys). Keyed by
    credential identity, sorted scope set and subject. Refresh tokens
    ignore scopes (the refresh grant always returns every granted scope).

    **Example**

    ```hot
    // Explicit access tokens and API keys are never cached
    ::google::auth/token-cache-key({kind: "api-key"}, [])  // null
    ```
    """
}
fn (creds: Map, scopes: Vec): Str? {
  cond {
    eq(creds.kind, "refresh") => {
      identity join(["refresh", creds.client-id, get(creds, "refresh-token")], "|")
      concat(CACHE_PREFIX, ::hash/sha256(identity))
    }

    eq(creds.kind, "service-account") => {
      sa get(creds, "service-account")
      key-id or(sa.private_key_id, ::hash/sha256(sa.private_key))
      identity join(["sa", sa.client_email, key-id, join(sort(scopes), " "), or(creds.subject, "")], "|")
      concat(CACHE_PREFIX, ::hash/sha256(identity))
    }
    => { null }
  }
}

cache-entry
meta {
    doc: """
    The cached form of a token response: `{access-token, expires-at}` (epoch
    ms), expiring `EXPIRY_MARGIN_SECONDS` early.

    **Example**

    ```hot
    // expires_in 3600, less the 60 second margin, from now = 1000 ms
    ::google::auth/cache-entry({expires_in: 3600}, 1000).expires-at  // 3541000
    ```
    """
}
fn (tokens: Map, now: Int): Map {
  expires-in Int(or(tokens.expires_in, 3600))
  {
    access-token: tokens.access_token,
    expires-at: add(now, mul(sub(expires-in, EXPIRY_MARGIN_SECONDS), 1000))
  }
}

is-fresh
meta {
    doc: """
    True when a cache entry exists and has not reached its (margin-adjusted)
    expiry.

    **Example**

    ```hot
    entry {access-token: "cached", expires-at: 2000}
    ::google::auth/is-fresh(entry, 1000)  // true
    ::google::auth/is-fresh(entry, 2000)  // false
    ::google::auth/is-fresh(null, 1000)  // false
    ```
    """
}
fn (entry: Any, now: Int): Bool {
  and(is-map(entry), is-some(get(entry, "access-token")), lt(now, or(get(entry, "expires-at"), 0)))
}

evict-token
meta {
    doc: """
    Drop a cached token (e.g. after a 401). No-op for a null key.

    **Example**

    ```hot
    creds ::google::auth/resolve-credentials({})
    auth ::google::auth/bearer(creds, ::google::auth/normalize-scopes("drive.readonly"))

    // Google answered 401: the next call mints a new token
    ::google::auth/evict-token(auth.cache-key)
    ```
    """
}
fn (cache-key: Str?): Bool {
  cond {
    is-null(cache-key) => { false }
    => {
      ::ctx/set-secret(cache-key, null)
      true
    }
  }
}

// ---------------------------------------------------------------------------
// Minting
// ---------------------------------------------------------------------------

build-service-account-claims
meta {
    doc: """
    Build the RFC 7523 assertion claims for a service-account token request.
    `scope` is space-separated; `subject` (optional) enables domain-wide
    delegation, the user to impersonate.

    **Example**

    ```hot
    claims ::google::auth/build-service-account-claims("bot@project.iam.gserviceaccount.com", "https://www.googleapis.com/auth/drive.readonly", "ada@example.com")
    claims.iss  // "bot@project.iam.gserviceaccount.com"
    claims.sub  // "ada@example.com"
    sub(claims.exp, claims.iat)  // 3600
    ```
    """
}
fn (client-email: Str, scope: Str, subject: Any): Map {
  now ::jwt/now-seconds()
  base {
    iss: client-email,
    scope: scope,
    aud: ::google/TOKEN_URL,
    iat: now,
    exp: add(now, 3600)
  }

  // Empty string counts as absent (ctx placeholders wire "" for unset
  // env vars); a literal sub: "" would make Google reject the assertion.
  if(is-blank-value(subject), base, {...base, sub: subject})
}

service-account-token
meta {
    doc: """
    Exchange a service-account key (parsed Map) for an access token with the
    given space-separated `scope`. Returns the token response
    (`access_token`, `expires_in`), masked in call records, or a
    `TokenError`.

    **Example**

    ```hot
    key ::google::auth/parse-service-account(::hot::ctx/get("google.service.account"))
    tokens ::google::auth/service-account-token(key, "https://www.googleapis.com/auth/drive.readonly", "ada@example.com")
    tokens.expires_in
    ```
    """
}
fn (service-account: Map, scope: Str, subject: Any): Map {
  claims build-service-account-claims(service-account.client_email, scope, subject)
  assertion ::jwt/sign(claims, service-account.private_key, "RS256")
  cond {
    is-err(assertion) => { err(token-error("google: could not sign the service-account assertion", err-value(assertion))) }
    => {
      tokens ::oauth2/jwt-bearer(::google/TOKEN_URL, assertion)
      if(is-err(tokens), err(token-error("google: service-account token exchange failed", err-value(tokens))), mark-token-response(tokens))
    }
  }
}

refresh-token-grant
meta {
    doc: """
    Exchange a refresh token for an access token. Returns the token response
    or a `TokenError` such as `"google: token exchange failed: invalid_grant
    (Token has been expired or revoked.)"`. The refresh token, client secret
    and response tokens are masked in call records.

    **Example**

    ```hot
    tokens ::google::auth/refresh-token-grant(
      "123.apps.googleusercontent.com",
      ::hot::ctx/get("google.oauth.client-secret"),
      ::hot::ctx/get("tenant.google.refresh-token")
    )
    tokens.expires_in
    ```
    """
}
fn (client-id: Str, client-secret: Str?, refresh-token: Str): Map {
  mark-fields({client-secret: client-secret, refresh-token: refresh-token}, SECRET_KEYS)
  tokens ::oauth2/refresh(::google/TOKEN_URL, filter-vals({
    client-id: client-id,
    client-secret: client-secret,
    refresh-token: refresh-token
  }, is-some))
  if(is-err(tokens), err(token-error("google: token exchange failed", err-value(tokens))), mark-token-response(tokens))
}

mint-token
meta {
    doc: """
    Mint a fresh token response for resolved credentials (no cache).

    **Example**

    ```hot
    creds ::google::auth/resolve-credentials({})
    tokens ::google::auth/mint-token(creds, ::google::auth/normalize-scopes("drive.readonly"))
    tokens.expires_in
    ```
    """
}
fn (creds: Map, scopes: Vec): Map {
  cond {
    eq(creds.kind, "refresh") => {
      refresh-token-grant(creds.client-id, creds.client-secret, get(creds, "refresh-token"))
    }

    eq(creds.kind, "service-account") => {
      cond {
        is-empty(scopes) => { err(token-error("google: no scopes requested for the service-account token")) }
        => { service-account-token(get(creds, "service-account"), join(scopes, " "), creds.subject) }
      }
    }
    => { err(token-error(`google: cannot mint a token for ${creds.kind} credentials`)) }
  }
}

bearer
meta {
    doc: """
    Resolve a bearer token for resolved credentials and scopes, using the
    per-run cache. Returns `{token, cache-key, cached}` (`cached` is true
    when the token came from the cache, so a 401 should evict and retry),
    or a `TokenError`. API-key credentials have no bearer token.

    **Example**

    ```hot
    creds ::google::auth/resolve-credentials({})
    auth ::google::auth/bearer(creds, ::google::auth/normalize-scopes("drive.readonly"))
    auth.cached
    ::hot::http/request(::hot::http/HttpRequest({
      method: "GET",
      url: "https://www.googleapis.com/drive/v3/about?fields=user",
      headers: {Authorization: `Bearer ${auth.token}`}
    }))
    ```
    """
}
fn (creds: Map, scopes: Vec): Map {
  cond {
    eq(creds.kind, "token") => { {token: creds.token, cache-key: null, cached: false} }
    eq(creds.kind, "api-key") => { err(token-error("google: an API key cannot be used as an OAuth access token")) }
    => {
      key token-cache-key(creds, scopes)
      now now-ms()
      hit ::ctx/get(key)
      cond {
        is-fresh(hit, now) => { {token: hit.access-token, cache-key: key, cached: true} }
        => {
          tokens mint-token(creds, scopes)
          cond {
            is-err(tokens) => { tokens }
            => {
              ::ctx/set-secret(key, cache-entry(tokens, now))
              {token: tokens.access_token, cache-key: key, cached: false}
            }
          }
        }
      }
    }
  }
}

access-token
meta {
    doc: """
    Resolve an access token for `scope` (Str or Vec) from `opts` and
    context. Returns the bearer token string, masked in call records, or a
    `TokenError` when no credentials are configured or the exchange
    fails. Service-account and refresh-token tokens are cached for the
    run.

    **Example**

    ```hot
    token ::google::auth/access-token("drive.readonly")

    // Per call: act as one tenant's user with their stored refresh token
    token2 ::google::auth/access-token("drive.readonly", {
      refresh-token: "1//0g-tenant-refresh-token",
      client-id: "123.apps.googleusercontent.com",
      client-secret: "GOCSPX-secret"
    })
    ```
    """
}
fn
(scope: Str | Vec): Str {
  access-token(scope, {})
},
(scope: Str | Vec, opts: Map): Str {
  creds resolve-credentials(opts)
  cond {
    is-err(creds) => { creds }
    => {
      auth bearer(creds, effective-scopes(scope, opts))
      if(is-err(auth), auth, auth.token)
    }
  }
}
